//============================================================================
// 任务UI系统 - FDF定义
// 包含：入口图标、主面板、标签页、列表容器、滚动条、关闭按钮
// 全部使用Human风格纹理
//============================================================================

//---------------------------------------------------------------------------
// 入口图标（常驻屏幕右下角F9任务栏下方）
// 独立存在，不依赖于主面板
//---------------------------------------------------------------------------
Frame "BACKDROP" "TaskEntryIcon" {
    BackdropBackground "UI\Widgets\EscMenu\Human\human-options-menu-background.blp",  // 背景纹理
    BackdropCornerFlags "UL|UR|BL|BR|T|L|B|R",  // 绘制所有边和角
    BackdropCornerSize 0.0128,                    // 边框厚度（*1.6）
    BackdropBackgroundInsets 0.004 0.004 0.004 0.004,  // 背景内边距（左/下/右/上）
    BackdropEdgeFile "UI\Widgets\EscMenu\Human\human-options-menu-border.blp",  // 边框纹理
    Width 0.088,                                  // 宽度（与顶部菜单按钮一致）
    Height 0.0227,                                  // 高度（与顶部菜单按钮一致）
    SetPoint BOTTOMLEFT, "GameUI", BOTTOMLEFT, 0.01, 0.15  // 放在F9任务栏下方
}

//---------------------------------------------------------------------------
// 主任务面板（点击入口图标后显示）
// 这是最大的容器，承载所有任务UI元素
//---------------------------------------------------------------------------
Frame "BACKDROP" "TaskMainPanel" {
    BackdropBackground "UI\Widgets\EscMenu\Human\human-options-menu-background.blp",
    BackdropCornerFlags "UL|UR|BL|BR|T|L|B|R",
    BackdropCornerSize 0.04,                    // 主面板边框更粗
    // 背景内边距按原始比例对齐：CornerSize 0.015 -> Insets 0.005 (约 1/3)
    BackdropBackgroundInsets 0.013 0.013 0.013 0.013,
    BackdropEdgeFile "UI\Widgets\EscMenu\Human\human-options-menu-border.blp",
    Width 0.35,
    Height 0.5,
    // 与 TS 中 PANEL_REL_TO_ENTRY_* 一致；运行时 ClearAllPoints + setFramePointRelative 覆盖
    SetPoint TOPLEFT, "TaskEntryIcon", TOPLEFT, 0, -0.02
}

//---------------------------------------------------------------------------
// 任务列表容器：仅布局/裁剪层级，无背景无边框（避免与 TaskMainPanel 形成「双层框」）
// 最终位置由 TS setFramePointRelative 覆盖；此处尺寸供 FDF 预览
//---------------------------------------------------------------------------
Frame "FRAME" "TaskListContainer" {
    Width 0.32,
    Height 0.4,
    SetPoint TOPLEFT, "TaskMainPanel", TOPLEFT, 0.015, -0.10
}

//---------------------------------------------------------------------------
// 任务滚动条轨道/滑块（用于 TS 精准 9-slice 参数）
// 你的反馈“黄色竖线重复/纹理错位”，典型原因是 BACKDROP 的
// BackdropCornerSize / BackdropBackgroundInsets 与 slider 纹理分割比例不匹配。
//---------------------------------------------------------------------------
Frame "BACKDROP" "TaskScrollBar" {
    BackdropBackground "UI\Widgets\EscMenu\Human\slider-background.blp",
    BackdropCornerFlags "UL|UR|BL|BR|T|L|B|R",
    // slider-border.blp 在原生 UI 中是 EdgeFile（边缘切片），而不是 Background。
    BackdropEdgeFile "UI\Widgets\EscMenu\Human\slider-border.blp",
    // 原生推荐值：避免 border/背景被错误切片导致重复竖线
    BackdropCornerSize 0.008,
    BackdropBackgroundInsets 0.004 0.004 0.004 0.004,
    Width 0.015,
    Height 0.35,
    SetPoint CENTER, "GameUI", CENTER, 0, 0
}

Frame "BACKDROP" "TaskScrollBarBorder" {
    // slider-border.blp 在原生 UI 中是 EdgeFile（边缘切片），而不是 Background。
    BackdropEdgeFile "UI\Widgets\EscMenu\Human\slider-border.blp",
    BackdropCornerFlags "UL|UR|BL|BR|T|L|B|R",
    BackdropCornerSize 0.008,
    BackdropBackgroundInsets 0.004 0.004 0.004 0.004,
    Width 0.015,
    Height 0.35,
    SetPoint CENTER, "GameUI", CENTER, 0, 0
}

//---------------------------------------------------------------------------
// 任务滚动条滑块（圆形 knob）
// 为了规避 1.27e 下 BACKDROP 直接承载纹理时的潜在崩溃，
// 这里用 GLUETEXTBUTTON + ControlBackdrop 包一层。
//---------------------------------------------------------------------------
Frame "BACKDROP" "TaskScrollThumbBackdrop" {
    BackdropBackground "UI\Widgets\EscMenu\Human\slider-knob.blp",
    BackdropCornerFlags "UL|UR|BL|BR",
    BackdropCornerSize 0.008,
    BackdropBackgroundInsets 0.002 0.002 0.002 0.002,
    Width 0.02,
    Height 0.02
}

Frame "GLUETEXTBUTTON" "TaskScrollThumb" {
    ControlBackdrop "TaskScrollThumbBackdrop",
    Width 0.02,
    Height 0.02,
    SetPoint CENTER, "GameUI", CENTER, 0, 0
}

// thumb 由 TS 根据 scrollOffset 同步位置

//---------------------------------------------------------------------------
// 任务按钮的共用背景模板
// 所有标签按钮共享同一个背景样式
//---------------------------------------------------------------------------
Frame "BACKDROP" "TaskButtonBackdrop" {
    BackdropBackground "UI\Widgets\EscMenu\Human\human-options-menu-background.blp",
    BackdropCornerFlags "UL|UR|BL|BR|T|L|B|R",
    BackdropCornerSize 0.0096,                    // 按钮边框更粗（*1.6）
    BackdropEdgeFile "UI\Widgets\EscMenu\Human\human-options-menu-border.blp",
    Width 0.1,
    Height 0.03
}

Frame "BACKDROP" "TaskTabMainBg" {
    BackdropBackground "UI\Widgets\EscMenu\Human\human-options-menu-background.blp",
    BackdropCornerFlags "UL|UR|BL|BR|T|L|B|R",
    BackdropCornerSize 0.0096,
    BackdropEdgeFile "UI\Widgets\EscMenu\Human\human-options-menu-border.blp",
    Width 0.1,
    Height 0.03
}

Frame "BACKDROP" "TaskTabSideBg" {
    BackdropBackground "UI\Widgets\EscMenu\Human\human-options-menu-background.blp",
    BackdropCornerFlags "UL|UR|BL|BR|T|L|B|R",
    BackdropCornerSize 0.0096,
    BackdropEdgeFile "UI\Widgets\EscMenu\Human\human-options-menu-border.blp",
    Width 0.1,
    Height 0.03
}

Frame "BACKDROP" "TaskTabDailyBg" {
    BackdropBackground "UI\Widgets\EscMenu\Human\human-options-menu-background.blp",
    BackdropCornerFlags "UL|UR|BL|BR|T|L|B|R",
    BackdropCornerSize 0.0096,
    BackdropEdgeFile "UI\Widgets\EscMenu\Human\human-options-menu-border.blp",
    Width 0.1,
    Height 0.03
}

//---------------------------------------------------------------------------
// 主线任务标签按钮
// 使用 TaskButtonBackdrop 作为背景
//---------------------------------------------------------------------------
Frame "GLUETEXTBUTTON" "TaskTabMain" {
    ControlBackdrop "TaskButtonBackdrop",         // 引用背景模板
    Width 0.1,
    Height 0.03,
    SetPoint TOPLEFT, "TaskMainPanel", TOPLEFT, 0.015, -0.015  // 面板左上角
}

//---------------------------------------------------------------------------
// 支线任务标签按钮
//---------------------------------------------------------------------------
Frame "GLUETEXTBUTTON" "TaskTabSide" {
    ControlBackdrop "TaskButtonBackdrop",
    Width 0.1,
    Height 0.03,
    SetPoint LEFT, "TaskTabMain", RIGHT, 0.01, 0  // 主线按钮右侧
}

//---------------------------------------------------------------------------
// 小任务标签按钮
//---------------------------------------------------------------------------
Frame "GLUETEXTBUTTON" "TaskTabDaily" {
    ControlBackdrop "TaskButtonBackdrop",
    Width 0.1,
    Height 0.03,
    SetPoint LEFT, "TaskTabSide", RIGHT, 0.01, 0  // 支线按钮右侧
}

//---------------------------------------------------------------------------
// 关闭按钮（通常在面板右上角）
//---------------------------------------------------------------------------
Frame "GLUETEXTBUTTON" "TaskCloseButton" {
    ControlBackdrop "TaskButtonBackdrop",
    Width 0.06,
    Height 0.03,
    SetPoint TOPRIGHT, "TaskMainPanel", TOPRIGHT, -0.015, -0.015
}

