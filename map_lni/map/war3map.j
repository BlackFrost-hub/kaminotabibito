				call SaveReal(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x2D345649, GS_AngleBetweenPoints(Location(LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xA99320FA), LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xFDF65382)) , Location(GetUnitX(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xD84480C3)), GetUnitY(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xD84480C3)))))
				call SaveUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x5B7DF14B, CreateUnit(GetOwningPlayer(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xC303079D)), LoadInteger(YDHT, StringHash("弹道马甲"), 0x86D47FF3), LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xA99320FA), LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xFDF65382), LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x2D345649)))
				call DzSetUnitModel(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x5B7DF14B), "war3mapImported\\OrbDarknessX.mdl")
				call SetUnitScale(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x5B7DF14B), 3.50, 3.50, 3.50)
				call SaveUnitHandle(YDHT, GetHandleId(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x5B7DF14B)), 0x50654F3C, LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xC303079D))
				call SaveReal(YDHT, GetHandleId(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x5B7DF14B)), 0x6FC38F0F, 0.00)
				call SaveReal(YDHT, GetHandleId(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x5B7DF14B)), 0x12C352F2, 15.00)
				call SaveReal(YDHT, GetHandleId(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x5B7DF14B)), 0x694DB03E, 1000.00)
				call SetUnitFlyHeight(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x5B7DF14B), ( ( GetUnitDefaultFlyHeight(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x5B7DF14B)) ) + ( GetUnitFlyHeight(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xC303079D)) ) ), 0.00)
				call SetUnitPathing(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x5B7DF14B), false)
				call GroupAddUnit(LoadGroupHandle(YDHT, StringHash("弹幕系统"), 0x0A4A1F64), LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x5B7DF14B))
				if ( ( IsTriggerEnabled(gg_trg_____________DMXT) == true ) ) then
				else
					call EnableTrigger(gg_trg_____________DMXT)
				endif
				//在弹幕系统之外的附加效果
				call SaveGroupHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x7B2D08E8, CreateGroup())
				set ydl_timer=CreateTimer()
				call SaveGroupHandle(YDLOC, GetHandleId(ydl_timer), 0x7B2D08E8, LoadGroupHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x7B2D08E8))
				call SaveUnitHandle(YDLOC, GetHandleId(ydl_timer), 0x5B7DF14B, LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x5B7DF14B))
				call SaveUnitHandle(YDLOC, GetHandleId(ydl_timer), 0xC303079D, LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xC303079D))
				call SaveUnitHandle(YDLOC, GetHandleId(ydl_timer), 0xB3542E15, LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xB3542E15))
				call TimerStart(ydl_timer, 0.04, true, function Trig_DMboss____________02Func004Func016Func003Func017T)
				set ydul_A=ydul_A + 1
			endloop
		else
		endif
	else
	endif
	call FlushChildHashtable(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step)
	set ydl_timer=null
	set ydl_group=null
	set ydl_unit=null
endfunction
//===========================================================================
function InitTrig_DMboss____________02 takes nothing returns nothing
	set gg_trg_DMboss____________02=CreateTrigger()
	call TriggerAddAction(gg_trg_DMboss____________02, function Trig_DMboss____________02Actions)
endfunction
//===========================================================================
// Trigger: DMboss技能提示03
//===========================================================================
function Trig_DMboss____________03Conditions takes nothing returns boolean
	return ( ( IsUnitType(GetTriggerUnit(), UNIT_TYPE_HERO) == true ) ) and ( ( IsUnitRace(GetTriggerUnit(), RACE_ORC) == true ) )
endfunction
function Trig_DMboss____________03Func004Func004Func003Func011T takes nothing returns nothing
	if ( ( IsUnitSpelling(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9)) == false ) ) then
		call RemoveUnit(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x248ED1E3))
		call FlushChildHashtable(YDLOC, GetHandleId(GetExpiredTimer()))
		call DestroyTimer(GetExpiredTimer())
	else
	endif
endfunction
function Trig_DMboss____________03Func004Func004Func012Func003T takes nothing returns nothing
	if ( ( LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xCEA5D211) >= 2.00 ) ) then
		call FlushChildHashtable(YDLOC, GetHandleId(GetExpiredTimer()))
		call DestroyTimer(GetExpiredTimer())
	else
		call SaveReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xCEA5D211, ( ( LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xCEA5D211) ) + ( 1.00 ) ))
		//让Boss和特效锁定目标玩家
		call SaveEffectHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x66F185C5, EC_CreateEffect("war3mapImported\\bossjinggaoh.mdl" , GetUnitX(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9)) , GetUnitY(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9)) , 50.00 , ( LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xB9A583B8) ) , LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xD92E3573) , 1.0 , 0.50))
		//闪光蓄力特效
		call YDWETimerDestroyEffect(1.00 , AddSpecialEffectTarget("war3mapImported\\a.mdx", LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9), "origin"))
		//符咒音效
		call SaveEffectHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x3D91B70E, EC_CreateEffect("Abilities\\Spells\\Other\\Charm\\CharmTarget.mdl" , GetUnitX(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9)) , GetUnitY(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9)) , 50.00 , 0.00 , 0.00 , 1.0 , 0.50))
	endif
endfunction
function Trig_DMboss____________03Func004Func008Func006Func012Func003T takes nothing returns nothing
	call EXSetEffectSize(LoadEffectHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x42E28B61), 0.00)
	call FlushChildHashtable(YDLOC, GetHandleId(GetExpiredTimer()))
	call DestroyTimer(GetExpiredTimer())
endfunction
function Trig_DMboss____________03Func004Func008Func016Func003T takes nothing returns nothing
	if ( ( LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xCEA5D211) >= 3.00 ) ) then
		call FlushChildHashtable(YDLOC, GetHandleId(GetExpiredTimer()))
		call DestroyTimer(GetExpiredTimer())
	else
		call SaveReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xCEA5D211, ( ( LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xCEA5D211) ) + ( 1.00 ) ))
		//让Boss和特效锁定目标玩家
		call SaveReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xB9A583B8, YDWEAngleBetweenUnits(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9) , LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xD84480C3)))
		call SetUnitFacing(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9), LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xB9A583B8))
		call SaveEffectHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x66F185C5, EC_CreateEffect("war3mapImported\\bossjinggaoh.mdl" , GetUnitX(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9)) , GetUnitY(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9)) , 50.00 , ( LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xB9A583B8) ) , LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xD92E3573) , 1.0 , 0.50))
		//闪光蓄力特效
		call YDWETimerDestroyEffect(1.00 , AddSpecialEffectTarget("war3mapImported\\a.mdx", LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9), "origin"))
		//符咒音效
		call SaveEffectHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x3D91B70E, EC_CreateEffect("Abilities\\Spells\\Other\\Charm\\CharmTarget.mdl" , GetUnitX(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9)) , GetUnitY(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9)) , 50.00 , 0.00 , 0.00 , 1.0 , 0.50))
	endif
endfunction
function Trig_DMboss____________03Actions takes nothing returns nothing
 local timer ydl_timer
 local integer ydl_localvar_step= LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xCFDE6C76)
 set ydl_localvar_step=ydl_localvar_step + 3
 call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xCFDE6C76, ydl_localvar_step)
 call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7, ydl_localvar_step)
	call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x2AAC512D, GetSpellAbilityId())
	if ( ( ( ( EVENT_UNIT_SPELL_CAST == GetTriggerEventId() ) == true ) or ( ( EVENT_PLAYER_UNIT_SPELL_CAST == GetTriggerEventId() ) == true ) ) ) then
		if ( ( ( GetSpellAbilityId() == 'A0FM' ) or ( GetSpellAbilityId() == 'A0FH' ) or ( GetSpellAbilityId() == 'A0FD' ) or ( GetSpellAbilityId() == 'A0FI' ) or ( GetSpellAbilityId() == 'A0FM' ) ) ) then
			call YDWETimerDestroyEffect(1.00 , AddSpecialEffectTarget("Abilities\\Spells\\Other\\Charm\\CharmTarget.mdl", GetTriggerUnit(), "origin"))
		else
		endif
		//不无敌，单纯有施法进度条
		if ( ( ( GetUnitTypeId(GetTriggerUnit()) == 'O005' ) ) ) then
			call SaveUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xD84480C3, GetSpellTargetUnit())
			if ( ( 10 >= 10 ) ) then
				call SaveReal(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x9EF7B67E, S2R(EXExecuteScript("(require'jass.slk').ability[" + I2S(LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x2AAC512D)) + "].DataA1")))
