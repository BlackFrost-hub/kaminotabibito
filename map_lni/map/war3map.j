	call FlushChildHashtable(YDLOC, GetHandleId(GetExpiredTimer()))
	call DestroyTimer(GetExpiredTimer())
	set ydl_group=null
	set ydl_unit=null
	set ydl_timer=null
endfunction
function Trig_________________________02Actions takes nothing returns nothing
 local group ydl_group
 local unit ydl_unit
 local timer ydl_timer
 local integer ydl_localvar_step= LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xCFDE6C76)
 set ydl_localvar_step=ydl_localvar_step + 3
 call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xCFDE6C76, ydl_localvar_step)
 call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7, ydl_localvar_step)
	call SaveLocationHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xA296AF2A, GetUnitLoc(GetTriggerUnit()))
	if ( ( RectContainsLoc(gg_rct______________104, LoadLocationHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xA296AF2A)) == true ) ) then
		call RemoveRect(gg_rct______________104)
		call DisplayTimedTextToForce(GetPlayersAll(), 15.00, ( ( "|cffffcc99『" ) + ( GetUnitName(GetTriggerUnit()) ) + ( "』：|r真是片神秘奇妙的沙漠啊！" ) ))
	else
	endif
	if ( ( RectContainsLoc(gg_rct______________070, LoadLocationHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xA296AF2A)) == true ) ) then
		call SaveGroupHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x7B2D08E8, CreateGroup())
		set ydl_group=CreateGroup()
		call GroupEnumUnitsInRange(ydl_group, - 2571.70, 29575.10, 400.00, null)
		loop
			set ydl_unit=FirstOfGroup(ydl_group)
			exitwhen ydl_unit == null
			call GroupRemoveUnit(ydl_group, ydl_unit)
			if ( ( IsUnitType(ydl_unit, UNIT_TYPE_HERO) == true ) ) then
				call GroupAddUnit(LoadGroupHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x7B2D08E8), ydl_unit)
			else
			endif
		endloop
		call DestroyGroup(ydl_group)
		set ydl_timer=CreateTimer()
		call SaveGroupHandle(YDLOC, GetHandleId(ydl_timer), 0x7B2D08E8, LoadGroupHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x7B2D08E8))
		call SaveLocationHandle(YDLOC, GetHandleId(ydl_timer), 0x36544493, LoadLocationHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x36544493))
		call TimerStart(ydl_timer, 0.01, false, function Trig_________________________02Func007Func003T)
	else
	endif
	//↓↓↓剧情用↓↓↓
	if ( ( GetTriggerUnit() == LoadUnitHandle(YDHT, StringHash("支线NPC"), 0x825C4138) ) and ( RectContainsLoc(gg_rct______________069, LoadLocationHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xA296AF2A)) == true ) ) then
		call IssueImmediateOrder(GetTriggerUnit(), "stop")
	else
	endif
	call RemoveLocation(LoadLocationHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xA296AF2A))
	call FlushChildHashtable(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step)
	set ydl_group=null
	set ydl_unit=null
	set ydl_timer=null
endfunction
