	call UnitDamageTarget(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x4363BECC), LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15), ( ( LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0x0BFBB67B) ) + ( 0.00 ) ), false, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_NORMAL, WEAPON_TYPE_WHOKNOWS)
endfunction
