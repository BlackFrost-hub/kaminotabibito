endfunction
//===========================================================================
// Trigger: Z沙漠佣兵团001
//===========================================================================
function Trig_Z_______________001Conditions takes nothing returns boolean
	return ( ( IsUnitInGroup(GetTriggerUnit(), LoadGroupHandle(YDHT, StringHash("玩家英雄"), 0x0A4A1F64)) == true ) )
endfunction
function Trig_Z_______________001Actions takes nothing returns nothing
	if ( ( IsUnitInRange(GetTriggerUnit(), LoadUnitHandle(YDHT, StringHash("支线敌人"), 0x54BBCA4F), 800.00) == true ) ) then
		if ( ( IsQuestItemCompleted(udg_RWXM[16]) == false ) ) then
			call QuestItemSetCompleted(udg_RWXM[16], true)
			call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "蒙面人", null, "有不知好歹的生面孔进来了", bj_TIMETYPE_SET, 5.00, false)
			call IssueTargetOrder(LoadUnitHandle(YDHT, StringHash("支线敌人"), 0x54BBCA4F), "attack", GetTriggerUnit())
			call IssueTargetOrder(LoadUnitHandle(YDHT, StringHash("支线敌人"), 0xA3D545A5), "attack", GetTriggerUnit())
			call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "蒙面人", null, "看来这里就是你们的老巢了", bj_TIMETYPE_SET, 5.00, false)
			call QuestMessageBJ(GetPlayersAll(), bj_QUESTMESSAGE_HINT, "系统提示：深入洞窟探索！")
			call QuestSetDescription(udg_RW[6], "深入洞窟探索！")
			set udg_RWXM[17]=CreateQuestItemBJ(udg_RW[6], "深入洞窟探索！")
		else
		endif
	else
	endif
endfunction
//===========================================================================
function InitTrig_Z_______________001 takes nothing returns nothing
	set gg_trg_Z_______________001=CreateTrigger()
	call TriggerAddCondition(gg_trg_Z_______________001, Condition(function Trig_Z_______________001Conditions))
	call TriggerAddAction(gg_trg_Z_______________001, function Trig_Z_______________001Actions)
endfunction
//===========================================================================
// Trigger: 进入矩形区域闲聊02
//===========================================================================
function Trig_________________________02Conditions takes nothing returns boolean
	return ( ( IsUnitType(GetTriggerUnit(), UNIT_TYPE_HERO) == true ) )
endfunction
function Trig_________________________02Func007Func003Func001Func006Func005Func002Func003T takes nothing returns nothing
	call SetUnitTimeScale(GetEnumUnit(), 0.00)
	call FlushChildHashtable(YDLOC, GetHandleId(GetExpiredTimer()))
	call DestroyTimer(GetExpiredTimer())
endfunction
function Trig_________________________02Func007Func003Func001Func006Func006A takes nothing returns nothing
	call StarOther_PanCameraToTimedForPlayer(GetEnumPlayer() , - 25864.10 , - 11102.50 , 0.10)
endfunction
function Trig_________________________02Func007Func003T takes nothing returns nothing
 local group ydl_group
 local unit ydl_unit
 local timer ydl_timer
	if ( ( CountUnitsInGroup(LoadGroupHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x7B2D08E8)) >= R2I(udg_T) ) ) then
		call RemoveRect(gg_rct______________070)
		call SaveLocationHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x36544493, GetRectCenter(gg_rct______________029))
		set ydl_group=CreateGroup()
		call GroupEnumUnitsInRange(ydl_group, - 2571.70, 29575.10, 1500.00, null)
		loop
			set ydl_unit=FirstOfGroup(ydl_group)
			exitwhen ydl_unit == null
			call GroupRemoveUnit(ydl_group, ydl_unit)
			if ( ( IsUnitType(ydl_unit, UNIT_TYPE_HERO) == true ) ) then
				call SetUnitX(ydl_unit, - 25877.50)
				call SetUnitY(ydl_unit, - 11145.40)
				call SetUnitFacing(ydl_unit, 90.00)
				call IssueImmediateOrder(ydl_unit, "stop")
			else
			endif
		endloop
		call DestroyGroup(ydl_group)
		call RemoveLocation(LoadLocationHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x36544493))
		if ( ( LoadInteger(YDHT, StringHash("背景播放"), 0x53AC1561) == - 3 ) ) then
			call QuestMessageBJ(GetPlayersAll(), bj_QUESTMESSAGE_UPDATED, "|cffffff00『系统提示』：|r|cffff000010秒内按下ESC键|r|cffffffcc可以跳过接下来的剧情|r")
			call ShowUnit(gg_unit_h01K_0251, false)
			call SaveInteger(YDHT, StringHash("背景播放"), 0x53AC1561, - 1)
			set ydl_group=CreateGroup()
			call GroupEnumUnitsInRange(ydl_group, 19512.10, 26967.70, 2500.00, null)
			loop
				set ydl_unit=FirstOfGroup(ydl_group)
				exitwhen ydl_unit == null
				call GroupRemoveUnit(ydl_group, ydl_unit)
				call SaveUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15, ydl_unit)
				if ( ( GetUnitTypeId(ydl_unit) != 'h011' ) and ( GetUnitTypeId(ydl_unit) != 'h01K' ) ) then
					call PauseUnit(ydl_unit, true)
					call SetUnitAnimation(ydl_unit, "death")
					set ydl_timer=CreateTimer()
					call TimerStart(ydl_timer, 1.45, false, function Trig_________________________02Func007Func003Func001Func006Func005Func002Func003T)
				else
				endif
			endloop
			call DestroyGroup(ydl_group)
			call ForForce(LoadForceHandle(YDHT, StringHash("玩家"), 0x7C23C9D2), function Trig_________________________02Func007Func003Func001Func006Func006A)
			call TriggerExecute(gg_trg______________YX)
		else
		endif
	else
		call QuestMessageBJ(GetPlayersAll(), bj_QUESTMESSAGE_SECRET, "|cffffff00『系统提示』：|cffffcc99请所有玩家达到准备点后才能开始游戏|r|r")
	endif
