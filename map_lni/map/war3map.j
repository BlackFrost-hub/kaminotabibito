    call SaveUnitHandle(YDLOC, GetHandleId(ydl_timer), 0x944CCEB0, LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x944CCEB0))
    call SaveRectHandle(YDLOC, GetHandleId(ydl_timer), 0x6CC68D63, LoadRectHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x6CC68D63))
    call TimerStart(ydl_timer, 6.00, true, function Trig____Boss_____________________uFunc033T)
    call FlushChildHashtable(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step)
