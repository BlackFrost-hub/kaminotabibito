    endfunction  //UI封装 -空触发器
    function EC_NilTrig takes nothing returns trigger
        return null
    endfunction  //获取顶部计数
    function EC_GetIndex takes nothing returns integer
        return EC_Index - 1
    endfunction  //设置一个护盾
    function EC_SetShiled takes unit s,real size,trigger trig returns nothing
        set EC_ShiledArray[EC_ShiledIndex]=s
        set EC_ShiledSize[EC_ShiledIndex]=size
        set EC_ShiledCallbackTrig[EC_ShiledIndex]=trig
        set EC_ShiledIndex=EC_ShiledIndex + 1 //Print(GetUnitName(s));
    endfunction  //移除一个护盾
    function EC_RemoveShiled takes unit u returns nothing
        local integer l__EC__i=0
        local integer index=EC_ShiledIndex - 1
        loop
        exitwhen ( l__EC__i >= EC_ShiledIndex )
            if ( EC_ShiledArray[l__EC__i] == u ) then
                set EC_ShiledArray[l__EC__i]=EC_ShiledArray[index] //移除指定的护盾
                set EC_ShiledSize[l__EC__i]=EC_ShiledSize[index]
                set EC_ShiledCallbackTrig[l__EC__i]=EC_ShiledCallbackTrig[index]
                set EC_ShiledIndex=EC_ShiledIndex - 1
                exitwhen true
            endif
            set l__EC__i=l__EC__i + 1
        endloop
    endfunction  //结束本次冲锋
    function EC_FinishCharge takes nothing returns nothing
        set EC_Exit=true
        if ( EC_EventID == 4 ) then
            set EC_ShiledExit=true
        endif
    endfunction
    function EC_FinishChargeByShiled takes nothing returns nothing
        set EC_Exit=true
        set EC_ShiledExit=true
    endfunction  //使弹幕反弹
    function EC_SetEffectRebound takes integer effid returns nothing
        local real x=EXGetEffectX(EC_EffectList[effid])
        local real y=EXGetEffectY(EC_EffectList[effid])
        local real d
        local real a
        local real b
        local real d2
        if ( EC_EventID == 0 or EC_EventID == 4 ) then
            set EC_Hitable=false
            set a=GetUnitX(EC_TargetUnit)
            set b=GetUnitY(EC_TargetUnit) // d2 = Math.GAFC(a,b,x,y);
            set d2=s__Math_GAFC(x , y , a , b)
            set d=180 - EC_GetEffectAngle(effid) - ( d2 + d2 ) // if(! ( (d2>45&& d2 <135) ||(d2>-135&& d2 <-45)) ){
        else //     d = 180 - EC_GetEffectAngle(effid); // } //墙体反弹
            set d=360 - EC_GetEffectAngle(effid)
            set a=x + CosBJ(d) * 31
            set b=y + SinBJ(d) * 31
            if ( ( not ( X_IsTerrainWalkable(a , b) ) ) ) then
                set d=180 - EC_GetEffectAngle(effid)
            endif
        endif
        call EC_ReSetEffectAngle(effid , d)
        call EXEffectMatReset(EC_EffectList[effid])
        call EXEffectMatRotateZ(EC_EffectList[effid], d)
    endfunction  //新建闪电效果
    function EC_AddLighting takes string s,boolean bo,real x,real y,real a,real b returns lightning
        return AddLightning(s, bo, x, y, a, b)
    endfunction  //获取单位的range范围内的随机点
    function GetRandomLocNearUnit takes unit u,real range returns location
        local real sd=GetRandomReal(0, range)
        local real d=GetRandomReal(0, 360)
        local real x=GetUnitX(u)
        local real y=GetUnitY(u)
        return Location(x + CosBJ(d) * sd, y + SinBJ(d) * sd)
    endfunction  //获取与单位在min~max距离之间的随机点
    function GetRandomLocBetween takes unit u,real min,real max returns location
        local real sd=GetRandomReal(min, max)
        local real d=GetRandomReal(0, 360)
        local real x=GetUnitX(u)
        local real y=GetUnitY(u)
        return Location(x + CosBJ(d) * sd, y + SinBJ(d) * sd)
    endfunction  //命令特效e 开始冲锋， 保持相对地面高度为 h 碰撞范围 r 冲锋速度 s 伤害来源单位为 u 伤害值为 damage 冲锋距离 dis 检查碰撞 b 是否穿透单位 b2
    function EC_Charger takes effect e,real h,real r,real s,real d,unit u,real damage,real dis,boolean b,boolean b2 returns nothing
        local integer index=EC_Index
        if ( e == null ) then // Print("特效地址->"+I2S(GetHandleId(e))); // Print("速度->"+R2S(s));
            return
        endif //基本数据
        set EC_DisD[index]=0
        set EC_Distance[index]=dis
        set EC_EffectList[index]=e
        set EC_Height[index]=h
        set EC_Range[index]=r
        set EC_Speed[index]=s
        set EC_D[index]=d
        set EC_DamageTrig[index]=EC_TRIG
        set EC_FinishTrig[index]=EC_TRIG
        set EC_PZTrig[index]=EC_TRIG
        set EC_BrushTrig[index]=EC_TRIG
        set EC_PZTrig[index]=EC_TRIG
        set EC_OwnningPlayer[index]=GetOwningPlayer(u)
        set EC_Mode[index]=0
        set EC_Timed[index]=0
        set EC_TimeMax[index]=0
        set EC_PZ[index]=b
        set EC_Brush[index]=false
        set EC_BrushTime[index]=1
        set EC_FlyMode[index]=0
        set EC_steepsMax[index]=0
        set EC_steeps[index]=0
        set EC_MoveMode[index]=0
        set EC_Index=EC_Index + 1 //保存附加数据  --伤害来源u 伤害值damage
        call SaveReal(EC_HT, GetHandleId(e), EC_K_Damage, damage) //--伤害值 //--伤害来源
        call SaveUnitHandle(EC_HT, GetHandleId(e), EC_K_Unit, u) //--保护组
        call SaveGroupHandle(EC_HT, GetHandleId(e), EC_K_Group, CreateGroup()) //--是否穿透
        call SaveBoolean(EC_HT, GetHandleId(e), EC_K_Penetrate, b2) //Print("特效->"+I2S(GetHandleId(e)));
    endfunction
    function EC__EC_TRIGEVT takes nothing returns nothing
        local effect e=EC_TargetEffect
        local player p=EC_EffectOwnningPlayer
        local integer id=EC_EventID
        local real a
        local real b
        local unit u
        local real damage
        local string str
        local boolean IsPenetrate=LoadBoolean(EC_HT, GetHandleId(e), EC_K_Penetrate)
        set u=LoadUnitHandle(EC_HT, GetHandleId(e), EC_K_Unit)
        set damage=LoadReal(EC_HT, GetHandleId(e), EC_K_Damage)
        set EC_group=LoadGroupHandle(EC_HT, GetHandleId(e), EC_K_Group) //Print("特效->"+I2S(GetHandleId(e)));
        if ( id == 0 ) then //固定流程：对被冲锋的敌人造成伤害一次
            if ( IsUnitEnemy(EC_GetChargedUnit(), EC_GetEffectOwnningPlayer()) ) then //碰撞 //是敌人
                if ( IsUnitAliveBJ(EC_GetChargedUnit()) ) then //非死亡单位
                    if ( not ( IsUnitInGroup(EC_GetChargedUnit(), EC_group) ) ) then //不在单位组中
                        call UnitDamageTarget(u, EC_GetChargedUnit(), damage, true, false, ATTACK_TYPE_MELEE, DAMAGE_TYPE_ENHANCED, WEAPON_TYPE_WHOKNOWS) //造成伤害,添加到单位组
                        call GroupAddUnit(EC_group, EC_GetChargedUnit())
                        if ( not IsPenetrate ) then
                            call EC_FinishCharge() //不穿透就停止冲锋
                        endif
                    endif
                endif
            endif
        elseif ( id == 1 ) then
            call FlushChildHashtable(EC_HT, GetHandleId(e)) //结束  //清除单位组，特效，哈希表数据
            call DestroyGroup(EC_group)
            call DestroyEffect(e)
        elseif ( id == 2 ) then
            if ( HaveSavedString(EC_HT, GetHandleId(e), EC_K_Brush) ) then
                set a=EXGetEffectX(e)
                set b=EXGetEffectY(e)
                set EC_2_ID=EC_GetEffectIdOnSystem(e)
                if ( EC_2_ID != - 1 ) then
                    set str=LoadStr(EC_HT, GetHandleId(e), EC_K_Brush)
                    call EC_DestroyEffect(e)
                    call FlushChildHashtable(EC_HT, GetHandleId(e))
                    set e=AddSpecialEffect(str, a, b) //--伤害值
                    call SaveReal(EC_HT, GetHandleId(e), EC_K_Damage, damage) //--伤害来源
                    call SaveUnitHandle(EC_HT, GetHandleId(e), EC_K_Unit, u) //--保护组
                    call SaveGroupHandle(EC_HT, GetHandleId(e), EC_K_Group, EC_group) //--是否穿透
                    call SaveBoolean(EC_HT, GetHandleId(e), EC_K_Penetrate, IsPenetrate)
                    call SaveStr(EC_HT, GetHandleId(e), EC_K_Brush, str)
                    call EC_ReSetEffect(EC_2_ID , e)
                endif
            endif
        elseif ( id == 3 ) then
            call EC_SetEffectRebound(EC_GetEffectId()) //撞墙
        endif
        set e=null
        set p=null
        set u=null
        set EC_group=null
    endfunction  //固定流程特效
    //public:
    function EC__EC_TriggerInit takes nothing returns nothing
        set EC_TRIG=CreateTrigger()
        call TriggerAddAction(EC_TRIG, function EC__EC_TRIGEVT)
    endfunction
    //public:
    function EC__EC_SE1 takes nothing returns nothing
        local integer l__EC__i=0
        local integer lpi=0
        local integer id=0
        local real x
        local real y
        local real a
        local real b
        local real x1
        local real x2
        local real y1
        local real y2
        local real distance
        local real speed
        local real d
        local real estimateTime
        local real s
        local real dis2
        local unit u
        local unit tu
        local trigger trig
        local timer t=GetExpiredTimer()
        set a=LoadReal(EC_HT, GetHandleId(t), 1)
        set b=LoadReal(EC_HT, GetHandleId(t), 2)
        set speed=LoadReal(EC_HT, GetHandleId(t), 3)
        set estimateTime=LoadReal(EC_HT, GetHandleId(t), 4)
        set u=LoadUnitHandle(EC_HT, GetHandleId(t), 5)
        set tu=LoadUnitHandle(EC_HT, GetHandleId(t), 6)
        set trig=LoadTriggerHandle(EC_HT, GetHandleId(t), 7)
        set id=LoadInteger(EC_HT, GetHandleId(t), 8) //-------------
        set x1=GetUnitX(u)
        set y1=GetUnitY(u)
        set x=GetUnitX(tu)
        set y=GetUnitY(tu)
        set d=X_GAFC(a , b , x , y)
        set distance=X_GDBC(a , b , x , y)
        set s=distance * estimateTime
        set x2=x + CosBJ(d) * s
        set y2=y + SinBJ(d) * s
        set l__EC__i=R2I(estimateTime) / 100
        set l__EC__i=l__EC__i + 3
        loop
        exitwhen ( l__EC__i <= lpi )
            set lpi=lpi + 1
            set dis2=s__Math_GDBC(x1 , y1 , x2 , y2)
            set estimateTime=( dis2 / speed ) * 100
            set s=distance * estimateTime
            set x2=x + CosBJ(d) * s
            set y2=y + SinBJ(d) * s
        endloop //回调
        set EC_CB_X=x2
        set EC_CB_Y=y2
        set EC_CB_angle=X_GAFC(x1 , y1 , x2 , y2)
        set EC_CB_Unit=u
        set EC_CB_TargetUnit=tu
        set EC_CB_ID=id
        if ( TriggerEvaluate(trig) ) then
            call TriggerExecute(trig)
        endif //清理
        call FlushChildHashtable(EC_HT, GetHandleId(t))
        call DestroyTimer(t) //
        set t=null
        set u=null
        set tu=null
        set trig=null
    endfunction  //贝塞尔 获取z轴 t, 最高, 起点, 终点 
    function EC_Get2thBesselZ takes real a,real height,real startz,real finz returns real
        return ( a * a * startz + 2 * a * ( 1 - a ) * height + ( 1 - a ) * ( 1 - a ) * finz )
    endfunction  //平滑追踪角度(起点x,y 终点dx,dy)
    function EC_GetTrackAngle_Effect takes real x,real y,real dx,real dy returns real
        set dx=dx - x
        set dy=dy - y
        return bj_RADTODEG * Atan2(dy, dx)
    endfunction  //创建特效->${特效路径},${x},${y},${z},${朝向},${尺寸},${动画速度},${持续时间}
    function EC_CreateEffect takes string path,real x,real y,real z,real fac,real size,real s,real time returns effect
        set bj_lastCreatedEffect=AddSpecialEffect(path, x, y)
        call EXSetEffectSize(bj_lastCreatedEffect, size)
        call EXSetEffectZ(bj_lastCreatedEffect, EC_GetPointZ(x , y) + z)
        if ( time >= 0 ) then
            call YDWETimerDestroyEffect(time , bj_lastCreatedEffect)
        elseif ( time != - 1 ) then
            call DestroyEffect(bj_lastCreatedEffect)
        endif
        call EXEffectMatRotateZ(bj_lastCreatedEffect, fac)
        call EXSetEffectSpeed(bj_lastCreatedEffect, s)
        return bj_lastCreatedEffect
    endfunction
    function EC__EC_SE2 takes nothing returns nothing
        local integer l__EC__i=0
        local integer lpi=0
        local integer id=0
        local real x
        local real y
        local real a
        local real b
        local real x1
        local real x2
        local real y1
        local real y2
        local real dis
        local real speed
        local real d
        local real bbb
        local real s
        local real dis2
        local effect e
        local unit tu
        local trigger trig
        local timer t=GetExpiredTimer()
        set a=LoadReal(EC_HT, GetHandleId(t), 1)
        set b=LoadReal(EC_HT, GetHandleId(t), 2)
        set speed=LoadReal(EC_HT, GetHandleId(t), 3)
        set bbb=LoadReal(EC_HT, GetHandleId(t), 4)
        set e=LoadEffectHandle(EC_HT, GetHandleId(t), 5)
        set tu=LoadUnitHandle(EC_HT, GetHandleId(t), 6)
        set trig=LoadTriggerHandle(EC_HT, GetHandleId(t), 7)
        set id=LoadInteger(EC_HT, GetHandleId(t), 8)
        if ( e != null ) then
            set x1=EXGetEffectX(e) //-------------
            set y1=EXGetEffectY(e)
            set x=GetUnitX(tu)
            set y=GetUnitY(tu)
            set d=s__Math_GAFC(a , b , x , y)
            set dis=s__Math_GDBC(a , b , x , y)
            set s=dis * bbb
            set x2=x + CosBJ(d) * s
            set y2=y + SinBJ(d) * s
            set l__EC__i=R2I(bbb) / 100 + 3
            loop
            exitwhen ( l__EC__i <= lpi )
                set lpi=lpi + 1
                set s=dis * ( ( s__Math_GDBC(x1 , y1 , x2 , y2) / speed ) * 100 )
                set x2=x + CosBJ(d) * s
                set y2=y + SinBJ(d) * s
            endloop //回调
            set EC_CB_angle=s__Math_GAFC(x1 , y1 , x2 , y2) //EC_CB_degree = EC_GetTrackAngle_Effect(x1,y1,x2,y2);
            set EC_CB_Effect=e
            set EC_CB_TargetUnit=tu
            set EC_CB_ID=id
            if ( TriggerEvaluate(trig) ) then
                call TriggerExecute(trig)
            endif
        endif //清理
        call FlushChildHashtable(EC_HT, GetHandleId(t))
        call DestroyTimer(t) //
        set t=null
        set e=null
        set tu=null
        set trig=null
    endfunction  //xy为原点 扇形方向为d 范围为j 半径为r
    function EC_GetGroup takes real x,real y,real j,real d,real r returns group
        local group l__EC__g=CreateGroup()
        local unit u
        local real x1
        local real y1
        local real d1
        local real a1
        local real a2
        set bj_lastCreatedGroup=CreateGroup()
        call GroupEnumUnitsInRange(l__EC__g, x, y, r, null)
        set u=FirstOfGroup(l__EC__g)
        if ( d < 0 ) then
            set d=360 + d
        elseif ( d > 360 ) then
            set d=d - 360
        endif
        set a1=d - j / 2
        set a2=d + j / 2
        loop
        exitwhen ( u == null )
            set x1=GetUnitX(u)
            set y1=GetUnitY(u)
            set d1=Atan2(y1 - y, x1 - x) * 180 / bj_PI
            if ( d1 < 0 ) then
                set d1=360 + d1
            elseif ( d1 > 360 ) then
                set d1=d1 - 360
            endif
            if ( d1 > a1 and d1 < a2 ) then
                call GroupAddUnit(bj_lastCreatedGroup, u)
            endif
            call GroupRemoveUnit(l__EC__g, u)
            set u=FirstOfGroup(l__EC__g)
        endloop
        call DestroyGroup(l__EC__g)
        set l__EC__g=null
        set u=null
        return bj_lastCreatedGroup
    endfunction
    function EC_ShootReady takes unit u,real speed,unit tu,trigger callBack,integer id returns nothing
        local real x
        local real y
        local real a
        local real b
        local real x1
        local real x2
        local real dis
        local real d
        local real bbb
        local timer t=CreateTimer()
        set x=GetUnitX(u)
        set y=GetUnitY(u)
        set a=GetUnitX(tu)
        set b=GetUnitY(tu)
        set dis=X_GDBC(x , y , a , b)
        set bbb=( dis / speed ) * 100 //保存单位当前位置
        call SaveReal(EC_HT, GetHandleId(t), 1, a)
        call SaveReal(EC_HT, GetHandleId(t), 2, b)
        call SaveReal(EC_HT, GetHandleId(t), 3, speed)
        call SaveReal(EC_HT, GetHandleId(t), 4, bbb)
        call SaveUnitHandle(EC_HT, GetHandleId(t), 5, u)
        call SaveUnitHandle(EC_HT, GetHandleId(t), 6, tu)
        call SaveTriggerHandle(EC_HT, GetHandleId(t), 7, callBack)
        call SaveInteger(EC_HT, GetHandleId(t), 8, id) //运行计算
        call TimerStart(t, 0.01, false, function EC__EC_SE1)
        set t=null
    endfunction  //弹道计算回调-StarWE版本
    function EC__EC_SE1EX takes nothing returns nothing
        local integer l__EC__i=0
        local integer lpi=0
        local integer id=0
        local real x
        local real y
        local real a
        local real b
        local real x1
        local real x2
        local real y1
        local real y2
        local real dis
        local real speed
        local real d
        local real bbb
        local real s
        local real dis2
        local unit u
        local unit tu
        local trigger trig
        local timer t=GetExpiredTimer()
        set a=LoadReal(EC_HT, GetHandleId(t), 1)
        set b=LoadReal(EC_HT, GetHandleId(t), 2)
        set speed=LoadReal(EC_HT, GetHandleId(t), 3)
        set bbb=LoadReal(EC_HT, GetHandleId(t), 4)
        set u=LoadUnitHandle(EC_HT, GetHandleId(t), 5)
        set tu=LoadUnitHandle(EC_HT, GetHandleId(t), 6)
        set trig=LoadTriggerHandle(EC_HT, GetHandleId(t), 7) //-------------
        set x1=GetUnitX(u)
        set y1=GetUnitY(u)
        set x=GetUnitX(tu)
        set y=GetUnitY(tu)
        set d=X_GAFC(a , b , x , y) // printsr("当前速度:",dis*100);
        set dis=X_GDBC(a , b , x , y)
        set s=dis * bbb //初步计算预瞄点 //精度控制
        set l__EC__i=R2I(bbb) / 100 + 4 //重算——推演出着弹点
        loop
        exitwhen ( l__EC__i <= lpi )
            set lpi=lpi + 1
            set x2=x + CosBJ(d) * s
            set y2=y + SinBJ(d) * s
            set dis2=s__Math_GDBC(x1 , y1 , x2 , y2)
            set bbb=( dis2 / speed ) * 100
            set s=dis * bbb
        endloop //预计命中位置
        set EC_CB_X=x2
        set EC_CB_Y=y2 //回调
        set EC_CB_angle=X_GAFC(x1 , y1 , x2 , y2)
        set EC_CB_Unit=u
        set EC_CB_TargetUnit=tu
        call TriggerEvaluate(trig) // if(TriggerEvaluate(trig)){}
        call FlushChildHashtable(EC_HT, GetHandleId(t)) //清理 //
        call DestroyTimer(t)
        call DestroyTrigger(trig)
        set t=null
        set u=null
        set tu=null
        set trig=null
    endfunction  //弹道计算-StarWE版本
    function EC_ShootReadyEx takes unit u,real speed,unit tu,trigger trig returns nothing
        local real x
        local real y
        local real a
        local real b
        local real x1
        local real x2
        local real dis
        local real d
        local real bbb
        local timer t
        if ( ( speed <= 0 ) ) then
            return
        endif
        set t=CreateTimer()
        set x=GetUnitX(u)
        set y=GetUnitY(u)
        set a=GetUnitX(tu)
        set b=GetUnitY(tu)
        set dis=X_GDBC(x , y , a , b)
        set bbb=( dis / speed ) * 100 //保存单位当前位置
        call SaveReal(EC_HT, GetHandleId(t), 1, a)
        call SaveReal(EC_HT, GetHandleId(t), 2, b)
        call SaveReal(EC_HT, GetHandleId(t), 3, speed)
        call SaveReal(EC_HT, GetHandleId(t), 4, bbb)
        call SaveUnitHandle(EC_HT, GetHandleId(t), 5, u)
        call SaveUnitHandle(EC_HT, GetHandleId(t), 6, tu)
        call SaveTriggerHandle(EC_HT, GetHandleId(t), 7, trig) //运行计算
        call TimerStart(t, 0.01, false, function EC__EC_SE1EX)
        set t=null
    endfunction
    function EC__EC_SE2EX takes nothing returns nothing
        local integer l__EC__i=0
        local integer lpi=0
        local integer id=0
        local real x
        local real y
        local real a
        local real b
        local real x1
        local real x2
        local real y1
        local real y2
        local real dis
        local real speed
        local real d
        local real bbb
        local real s
        local real dis2
        local effect e
        local unit tu
        local trigger trig
        local timer t=GetExpiredTimer()
        set a=LoadReal(EC_HT, GetHandleId(t), 1)
        set b=LoadReal(EC_HT, GetHandleId(t), 2)
        set speed=LoadReal(EC_HT, GetHandleId(t), 3)
        set bbb=LoadReal(EC_HT, GetHandleId(t), 4)
        set e=LoadEffectHandle(EC_HT, GetHandleId(t), 5)
        set tu=LoadUnitHandle(EC_HT, GetHandleId(t), 6)
        set trig=LoadTriggerHandle(EC_HT, GetHandleId(t), 7)
        if ( e != null ) then
            set x1=EXGetEffectX(e) //------------- //发射位置 //目标位置
            set y1=EXGetEffectY(e)
            set x=GetUnitX(tu) //目标移动方向
            set y=GetUnitY(tu)
            set d=X_GAFC(a , b , x , y) //目标移动距离
            set dis=X_GDBC(a , b , x , y) //
            set l__EC__i=R2I(bbb) / 100 + 4
            loop
            exitwhen ( l__EC__i <= lpi )
                set lpi=lpi + 1
                set s=dis * bbb //猜测可能出现位置
                set x2=x + CosBJ(d) * s //重推算
                set y2=y + SinBJ(d) * s
                set dis2=s__Math_GDBC(x1 , y1 , x2 , y2)
                set bbb=( dis2 / speed ) * 100
            endloop
            set EC_CB_X=x2
            set EC_CB_Y=y2
            set EC_CB_angle=s__Math_GAFC(x1 , y1 , x2 , y2) //EC_CB_degree = EC_GetTrackAngle_Effect(x1,y1,x2,y2);
            set EC_CB_Effect=e
            set EC_CB_TargetUnit=tu
            call TriggerEvaluate(trig) // if(TriggerEvaluate(trig)){}
        endif //清理
        call FlushChildHashtable(EC_HT, GetHandleId(t))
        call DestroyTimer(t) //
        set t=null
        set e=null
        set tu=null
        set trig=null
    endfunction  //弹道计算 特效版
