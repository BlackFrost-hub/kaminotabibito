function InitTrig_________________________RW takes nothing returns nothing
	set gg_trg_________________________RW=CreateTrigger()
	call TriggerRegisterAnyUnitEventBJ(gg_trg_________________________RW, EVENT_PLAYER_UNIT_SELL_ITEM)
	call TriggerRegisterAnyUnitEventBJ(gg_trg_________________________RW, EVENT_PLAYER_UNIT_PICKUP_ITEM)
	call TriggerAddAction(gg_trg_________________________RW, function Trig_________________________RWActions)
endfunction
