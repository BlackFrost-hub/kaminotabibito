			if ( ( LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xAF616D00) > 83 ) and ( LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xAF616D00) <= 93 ) ) then
				if ( ( GetHeroLevel(GetTriggerUnit()) <= 15 ) ) then
					call TransmissionFromUnitWithNameBJ(GetPlayersAll(), GetTriggerUnit(), GetUnitName(GetTriggerUnit()), null, "！！！", bj_TIMETYPE_ADD, 0, true)
					call CreateNUnitsAtLocFacingLocBJ(1, 'n02T', Player(PLAYER_NEUTRAL_AGGRESSIVE), LoadLocationHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x2A829619), LoadLocationHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x5B0D7524))
				else
