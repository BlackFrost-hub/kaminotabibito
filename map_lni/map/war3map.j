function Trig_____________________________zhongFunc008Func039Conditions takes nothing returns nothing
 local timer ydl_timer
	if ( ( IsUnitInRange(GetTriggerUnit(), LoadUnitHandle(YDHT, StringHash("唯一单位"), 0xBD5DCB3F), 300.00) == true ) and ( IsUnitType(GetTriggerUnit(), UNIT_TYPE_HERO) == true ) and ( GetUnitState(GetTriggerUnit(), UNIT_STATE_LIFE) <= ( ( GetUnitState(GetTriggerUnit(), UNIT_STATE_MAX_LIFE) ) * ( 0.60 ) ) ) and ( GetUnitState(GetTriggerUnit(), UNIT_STATE_MANA) <= ( ( GetUnitState(GetTriggerUnit(), UNIT_STATE_MAX_MANA) ) * ( 0.90 ) ) ) ) then
		call SaveLocationHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0x2A829619, GetUnitLoc(GetTriggerUnit()))
		call SaveLocationHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0x4770D41D, PolarProjectionBJ(LoadLocationHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0x2A829619), 100.00, ( ( GetUnitFacing(GetTriggerUnit()) ) + ( 180.00 ) )))
		call SaveUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0x944CCEB0, LoadUnitHandle(YDHT, StringHash("唯一单位"), 0xBD5DCB3F))
		call ShowUnit(LoadUnitHandle(YDHT, StringHash("唯一单位"), 0xBD5DCB3F), true)
		call SetUnitPositionLoc(LoadUnitHandle(YDHT, StringHash("唯一单位"), 0xBD5DCB3F), LoadLocationHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0x4770D41D))
		call GroupAddUnit(LoadGroupHandle(YDHT, StringHash("血条Boss"), 0x0A4A1F64), LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0x944CCEB0))
		call SetUnitInvulnerable(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0x944CCEB0), true)
		call PauseUnit(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0x944CCEB0), true)
		call RemoveLocation(LoadLocationHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0x2A829619))
		call RemoveLocation(LoadLocationHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0x4770D41D))
		set ydl_timer=CreateTimer()
		call SaveUnitHandle(YDLOC, GetHandleId(ydl_timer), 0x944CCEB0, LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0x944CCEB0))
		call SaveUnitHandle(YDLOC, GetHandleId(ydl_timer), 0x458B7DE9, GetTriggerUnit())
		call TimerStart(ydl_timer, 0.10, false, function Trig_____________________________zhongFunc008Func039Func001Func011T)
		call FlushChildHashtable(YDLOC, GetHandleId(GetTriggeringTrigger()))
		call DestroyTrigger(GetTriggeringTrigger())
	else
	endif
	set ydl_timer=null
endfunction
