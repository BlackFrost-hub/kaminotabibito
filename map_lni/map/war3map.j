					call ForGroupBJ(LoadGroupHandle(YDHT, GetHandleId(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7), 0x68B72DFF)), 0x56E86570), function Trig_____________DMXTFunc001Func002Func039Func005Func001Func007Func001A)
				else
					call ForGroupBJ(LoadGroupHandle(YDHT, GetHandleId(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7), 0x68B72DFF)), 0x56E86570), function Trig_____________DMXTFunc001Func002Func039Func005Func001Func007Func002A)
				endif
