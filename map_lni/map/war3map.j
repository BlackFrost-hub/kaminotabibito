function Trig_____________________________changActions takes nothing returns nothing
 local trigger ydl_trigger
 local timer ydl_timer
 local integer ydl_localvar_step= LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xCFDE6C76)
 set ydl_localvar_step=ydl_localvar_step + 3
 call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xCFDE6C76, ydl_localvar_step)
 call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7, ydl_localvar_step)
	call SaveLocationHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x5B0D7524, GetUnitLoc(GetTriggerUnit()))
	//门下情侣
	if ( ( IsQuestDiscovered(udg_RW[3]) == false ) and ( IsUnitInRange(GetTriggerUnit(), LoadUnitHandle(YDHT, StringHash("支线NPC"), 0x8C17FFB0), 200.00) == true ) ) then
		call CreateQuestBJ(bj_QUESTTYPE_OPT_UNDISCOVERED, "门下情侣的身世", "前往地精洞窟，寻找哈米达的情侣琳丽
总任务流程：超长", "ReplaceableTextures\\CommandButtons\\BTNShadowMeld.blp")
		set udg_RW[3]=GetLastCreatedQuestBJ()
		call SaveUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xA8140378, GetTriggerUnit())
		call SaveUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x8C17FFB0, LoadUnitHandle(YDHT, StringHash("支线NPC"), 0x8C17FFB0))
		call SaveUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xBEC1F2B9, LoadUnitHandle(YDHT, StringHash("支线NPC"), 0xBEC1F2B9))
		call QuestSetDiscovered(udg_RW[3], true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "精灵男子", null, "唉，这该如何是好呢..", bj_TIMETYPE_SET, 4.00, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, GetUnitName(GetTriggerUnit()), null, "有什么苦恼吗，我可以帮到你", bj_TIMETYPE_SET, 4.00, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "精灵男子", null, "哦？谢谢你的好意", bj_TIMETYPE_SET, 4.00, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "精灵男子", null, "我叫哈米达，是这个村子的药剂师，昨天我的女友琳丽去精灵森的深处采集草药，到现在都没回来", bj_TIMETYPE_SET, 8.00, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "精灵男子", null, "我担心她出了什么事情..", bj_TIMETYPE_SET, 3.00, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, GetUnitName(GetTriggerUnit()), null, "精灵森深处有什么危险吗？", bj_TIMETYPE_SET, 4.00, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "精灵男子", null, "森林深处主要生活着豺狼人和地精，豺狼人和我们关系甚好，不会有什么危险", bj_TIMETYPE_SET, 4.00, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "精灵男子", null, "但是最主要的就是地精，它们烧杀抢掠，无恶不作，是全森林所有生灵的公敌", bj_TIMETYPE_SET, 4.00, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "精灵男子", null, "我最担心的就是琳丽她被地精抓去了", bj_TIMETYPE_SET, 4.00, true)
		if ( ( IsUnitInGroup(GetTriggerUnit(), LoadGroupHandle(YDHT, StringHash("男性英雄"), 0x0A4A1F64)) == true ) ) then
			call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, GetUnitName(GetTriggerUnit()), null, "呵呵，不用担心，区区地精，我可以帮你去寻找", bj_TIMETYPE_SET, 4.50, true)
		else
			call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, GetUnitName(GetTriggerUnit()), null, "请放心，一群地精而已，我可以帮你去寻找
", bj_TIMETYPE_SET, 4.50, true)
		endif
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "精灵男子", null, "哦？谢谢，地精一族的巢穴就在我们村子左边的出口往前走一段距离的西边，那里有个洞窟", bj_TIMETYPE_SET, 6.00, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "精灵男子", null, "对了，还没问阁下的贵名是何", bj_TIMETYPE_SET, 6.00, true)
		if ( ( IsUnitInGroup(GetTriggerUnit(), LoadGroupHandle(YDHT, StringHash("男性英雄"), 0x0A4A1F64)) == true ) ) then
			call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, GetUnitName(GetTriggerUnit()), null, ( "贵名不至于，我叫" + GetUnitName(GetTriggerUnit()) ), bj_TIMETYPE_SET, 4.50, true)
		else
			call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, GetUnitName(GetTriggerUnit()), null, ( "不用客气，我叫" + GetUnitName(GetTriggerUnit()) ), bj_TIMETYPE_SET, 4.50, true)
		endif
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "精灵男子", null, ( GetUnitName(GetTriggerUnit()) + "阁下，请收下这个" ), bj_TIMETYPE_SET, 6.00, true)
		call CreateItem('I03W', - 29502.70, - 29663.80)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, GetUnitName(GetTriggerUnit()), null, "这是？", bj_TIMETYPE_SET, 2.00, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "精灵男子", null, "这是我们精灵森林极为稀少的一种果实，吃下后对身体有一定的提高", bj_TIMETYPE_SET, 6.00, true)
		call SaveUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xBC6DF889 + ( 3 ), CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE), 'n00A', - 26065.00, - 17831.30, 270.00))
		call SaveUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xA1614B4D, LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xBC6DF889 + ( 3 )))
		call SaveUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xBC6DF889 + ( 4 ), CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE), 'n00A', - 26439.80, - 17863.30, 270.00))
		call SaveUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x9C0F555E, LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xBC6DF889 + ( 4 )))
		call TriggerRegisterUnitEvent(gg_trg_______Boss003, LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xA1614B4D), EVENT_UNIT_SPELL_EFFECT)
		call TriggerRegisterUnitEvent(gg_trg_______Boss003, LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x9C0F555E), EVENT_UNIT_SPELL_EFFECT)
		call SetUnitInvulnerable(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xBC6DF889 + ( 3 )), true)
		call PauseUnit(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xBC6DF889 + ( 3 )), true)
		call SetUnitInvulnerable(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xBC6DF889 + ( 4 )), true)
		call PauseUnit(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xBC6DF889 + ( 4 )), true)
		call SetUnitPosition(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xBEC1F2B9), - 26398.10, - 18007.60)
		call SetUnitInvulnerable(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xBEC1F2B9), true)
		call SetUnitLifePercentBJ(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xBEC1F2B9), 33.33)
		call QuestMessageBJ(GetPlayersAll(), bj_QUESTMESSAGE_ALWAYSHINT, "|cffffff00『系统提示』：|r|cffff0000任务推荐等级12（单人情况下）|r")
		call SaveTriggerHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x38DA9425, CreateTrigger())
		set ydl_trigger=LoadTriggerHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x38DA9425)
		call SavePlayerHandle(YDLOC, GetHandleId(ydl_trigger), 0x5A47F98D, GetTriggerPlayer())
		call SaveUnitHandle(YDLOC, GetHandleId(ydl_trigger), 0xA1614B4D, LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xA1614B4D))
		call SaveUnitHandle(YDLOC, GetHandleId(ydl_trigger), 0x9C0F555E, LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x9C0F555E))
		call SaveGroupHandle(YDLOC, GetHandleId(ydl_trigger), 0xA95CDEE4, LoadGroupHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xA95CDEE4))
		call SaveLocationHandle(YDLOC, GetHandleId(ydl_trigger), 0x5B0D7524, LoadLocationHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x5B0D7524))
		call SaveUnitHandle(YDLOC, GetHandleId(ydl_trigger), 0xBEC1F2B9, LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xBEC1F2B9))
		call SaveUnitHandle(YDLOC, GetHandleId(ydl_trigger), 0xA8140378, LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xA8140378))
		call TriggerRegisterUnitInRangeSimple(ydl_trigger, 800.00, LoadUnitHandle(YDHT, StringHash("支线NPC"), 0xBEC1F2B9))
		call TriggerAddCondition(ydl_trigger, Condition(function Trig_____________________________changFunc003Func040Conditions))
	else
	endif
	if ( ( GetUnitState(LoadUnitHandle(YDHT, StringHash("支线NPC"), 0xBEC1F2B9), UNIT_STATE_MAX_LIFE) >= 1800.00 ) and ( IsUnitInRange(GetTriggerUnit(), LoadUnitHandle(YDHT, StringHash("支线NPC"), 0x8C17FFB0), 200.00) == true ) and ( IsUnitInRange(GetTriggerUnit(), LoadUnitHandle(YDHT, StringHash("支线NPC"), 0xBEC1F2B9), 350.00) == true ) ) then
		call SaveUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xBEC1F2B9, LoadUnitHandle(YDHT, StringHash("支线NPC"), 0xBEC1F2B9))
		call SaveUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x8C17FFB0, LoadUnitHandle(YDHT, StringHash("支线NPC"), 0x8C17FFB0))
		call YDWEGeneralBounsSystemUnitSetBonus(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xBEC1F2B9) , 0 , 1 , 1500)
		call SetUnitFacing(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xBEC1F2B9), YDWEAngleBetweenUnits(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xBEC1F2B9) , LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x310EFEF8)))
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "琳丽", null, "嘻嘻，看看这是谁来了？哈米达", bj_TIMETYPE_SET, 3.00, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "哈米达", null, "哦？这不是帮助了我们的大恩人吗", bj_TIMETYPE_SET, 3.00, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, GetUnitName(GetTriggerUnit()), null, "最近比较闲，来看看你们", bj_TIMETYPE_SET, 5.00, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, GetUnitName(GetTriggerUnit()), null, "我比较好奇，你们俩个是怎么认识的？", bj_TIMETYPE_SET, 5.00, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "哈米达", null, "这其实也没什么好好奇的，我俩曾拜在通一个师傅下学习精灵术", bj_TIMETYPE_SET, 0.00, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "琳丽", null, "对呀，我们就是在那时认识的", bj_TIMETYPE_SET, 0, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, GetUnitName(GetTriggerUnit()), null, "哦？那你们的师傅是？", bj_TIMETYPE_SET, 5.00, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "哈米达", null, "师傅尊名尼古劳，我们都尊称他会古劳大师，他在我们精灵族的地位仅次于族长，听说资历比族长还要高", bj_TIMETYPE_SET, 8.00, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, GetUnitName(GetTriggerUnit()), null, "奇怪，既然你们的师傅那么厉害，那为何你们2个会在精灵族的这种边境村生活，徒弟不该是如今的这种地步", bj_TIMETYPE_SET, 10.00, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "哈米达", null, "......这事希望阁下就不要多问了，唉，师傅如今的地位因为族内的历史渊源原因，已经不如从前了...", bj_TIMETYPE_SET, 10.00, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "哈米达", null, "师傅早已隐居了...但我们就是寻找师傅而来此地的，我能够感受到，师傅就在此地附近", bj_TIMETYPE_SET, 10.00, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, GetUnitName(GetTriggerUnit()), null, "他老人家样貌大概怎么样的？", bj_TIMETYPE_SET, 10.00, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "哈米达", null, "蓝色的眼睛..身穿法师披风，手里拿个精灵权杖，头发是一身银色，留有一身长银胡须...", bj_TIMETYPE_SET, 10.00, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, GetUnitName(GetTriggerUnit()), null, "既然如此，如果我有幸见到了，一定会前来禀告你们二位", bj_TIMETYPE_SET, 10.00, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "哈米达", null, "哈哈...真是谢谢您了..", bj_TIMETYPE_SET, 10.00, true)
		call QuestMessageBJ(GetPlayersAll(), bj_QUESTMESSAGE_UPDATED, "帮助哈米达和琳丽情侣寻找他们的师傅")
		call QuestSetDescription(udg_RW[3], "帮助哈米达和琳丽情侣寻找他们的师傅（后续未制作）
任务要求：找到尼古劳大师
任务提示：隐居在精灵村附近，蓝色的眼睛,身穿法师披风，手里拿个精灵权杖，头发是一身银色，留有一身长银胡须")
		set ydl_timer=CreateTimer()
		call TimerStart(ydl_timer, 2.00, false, function Trig_____________________________changFunc004Func022T)
	else
	endif
	//异教徒
	if ( ( IsUnitInRange(GetTriggerUnit(), LoadUnitHandle(YDHT, StringHash("支线NPC"), 0xB057201D), 200.00) == true ) and ( IsQuestDiscovered(udg_RW[2]) == false ) and ( ( GetTimeOfDay() > 19.00 ) or ( GetTimeOfDay() < 4.00 ) ) ) then
		call CreateQuestBJ(bj_QUESTTYPE_OPT_UNDISCOVERED, "蜥蜴人之谜", "异教徒让你晚上前往沙漠地带寻找只会夜晚出现的生物，击杀它
任务要求：击杀夜晚出现在沙漠的生物（0/1）
总任务流程：略长", "ReplaceableTextures\\CommandButtons\\BTNHornOfCenarius.blp")
		set udg_RW[2]=GetLastCreatedQuestBJ()
		call QuestSetDiscovered(udg_RW[2], true)
		call SaveUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xB057201D, LoadUnitHandle(YDHT, StringHash("支线NPC"), 0xB057201D))
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "异教徒", null, "呵呵，这个时候来到此处，说明你对我说的话感兴趣", bj_TIMETYPE_ADD, 0, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, GetUnitName(GetTriggerUnit()), null, "麻烦还请您长话短说，我还赶时间呢..", bj_TIMETYPE_ADD, 0, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "异教徒", null, "这片沙漠的美妙之处，对各个来到此地的人来说，都有各自的不同，而对我来说...", bj_TIMETYPE_ADD, 0, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "异教徒", null, "就是每天会在夜晚出现在沙漠中的奇异生物了...", bj_TIMETYPE_ADD, 0, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, GetUnitName(GetTriggerUnit()), null, "奇异生物？..", bj_TIMETYPE_ADD, 0, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "异教徒", null, "是的，我对它感兴趣，如果你能找到并且杀死它，带来它的尸体的话，我会付出令你满意的报酬的，如何？", bj_TIMETYPE_SET, 8.00, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, GetUnitName(GetTriggerUnit()), null, "尽力而为吧..", bj_TIMETYPE_ADD, 0, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "异教徒", null, "呵呵，你可以在每天的晚上七点到凌晨4点在沙漠寻找...", bj_TIMETYPE_SET, 8.00, true)
		call QuestMessageBJ(GetPlayersAll(), bj_QUESTMESSAGE_DISCOVERED, "发现新支线任务！")
		set udg_RWXM[0]=CreateQuestItemBJ(udg_RW[2], "击杀夜晚在沙漠中出现的生物")
		set ydl_timer=CreateTimer()
		call TimerStart(ydl_timer, 4.00, false, function Trig_____________________________changFunc006Func019T)
	else
		if ( ( IsUnitInRange(GetTriggerUnit(), LoadUnitHandle(YDHT, StringHash("支线NPC"), 0xB057201D), 200.00) == true ) and ( IsQuestDiscovered(udg_RW[2]) == false ) ) then
			call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "异教徒", null, "呵呵，旅行者，想接受我的委托吗....", bj_TIMETYPE_ADD, 0, true)
			call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, GetUnitName(GetTriggerUnit()), null, "委托？什么？", bj_TIMETYPE_ADD, 0, true)
			call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "异教徒", null, "如果你感兴趣的话，可以晚上过来找我，我带你去一个地方....", bj_TIMETYPE_ADD, 0, true)
			call QuestMessageBJ(GetPlayersAll(), bj_QUESTMESSAGE_ALWAYSHINT, "系统提示：请于晚上找异教徒对话")
		else
		endif
	endif
	if ( ( IsUnitInRange(GetTriggerUnit(), LoadUnitHandle(YDHT, StringHash("支线NPC"), 0xB057201D), 200.00) == true ) and ( YDWEUnitHasItemOfTypeBJNull(GetTriggerUnit() , 'I02U') == true ) and ( IsQuestItemCompleted(udg_RWXM[0]) == true ) ) then
		call SaveUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xB057201D, LoadUnitHandle(YDHT, StringHash("支线NPC"), 0xB057201D))
		call RemoveItem(YDWEGetItemOfTypeFromUnitBJNull(GetTriggerUnit() , 'I02U'))
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, GetUnitName(GetTriggerUnit()), null, "你看看，是不是这个？", bj_TIMETYPE_SET, 2.33, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "异教徒", null, "这个...错不了，就是它了", bj_TIMETYPE_SET, 3.50, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "异教徒", null, "没想到夜晚的沙漠居然会出现这样的生物", bj_TIMETYPE_SET, 5.00, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, GetUnitName(GetTriggerUnit()), null, "这到底是什么东西？", bj_TIMETYPE_ADD, 0, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "异教徒", null, "蜥蜴人...生灵们只知晓沙漠中存在着蛇人，但是他们不知道的是..", bj_TIMETYPE_SET, 5.00, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "异教徒", null, "呵呵...这估计多半是沙漠中的蜥蜴人制作的生物....
", bj_TIMETYPE_SET, 5.00, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "异教徒", null, "这片沙漠还存在着那不为人知的蜥蜴人，它们与蛇人拥有相同的智慧...", bj_TIMETYPE_SET, 5.00, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "异教徒", null, "古籍中写着，自上千年起，蜥蜴人生活在这片沙漠，但古籍上写着的是：存在于『沙漠的另一端』", bj_TIMETYPE_SET, 5.00, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, GetUnitName(GetTriggerUnit()), null, "『沙漠的另一端』？", bj_TIMETYPE_ADD, 0, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "异教徒", null, "是的，古籍上就是这么写的，具体是什么意思也无从得知...", bj_TIMETYPE_SET, 5.00, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, GetUnitName(GetTriggerUnit()), null, "那您又是怎么知道这些事情的呢？", bj_TIMETYPE_ADD, 0, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "异教徒", null, "这就不能告诉你了，见谅...", bj_TIMETYPE_SET, 5.00, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, GetUnitName(GetTriggerUnit()), null, "好吧，毕竟每个人心中都有各自的秘密，我也不便过多过问。", bj_TIMETYPE_SET, 5.00, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "异教徒", null, "呵呵..如果你感兴趣的话，可以收下这个（递出一枚戒指）", bj_TIMETYPE_SET, 5.00, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, GetUnitName(GetTriggerUnit()), null, "这是？", bj_TIMETYPE_SET, 3.00, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "异教徒", null, "这是用来传递信息的戒指，如果你对蜥蜴人感兴趣的话，我会用这个戒指传递给你信息...", bj_TIMETYPE_SET, 6.00, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, GetUnitName(GetTriggerUnit()), null, "好的...我收下了..", bj_TIMETYPE_SET, 3.00, true)
		call CreateItem('I03B', GetUnitX(GetTriggerUnit()), GetUnitY(GetTriggerUnit()))
		call QuestMessageBJ(YDWEGetPlayersMatchingNull(Condition(function Trig_____________________________changFunc007Func024001001)), bj_QUESTMESSAGE_UPDATED, "|cffffff00『系统提示』|r：任务物品掉落在英雄脚下，请注意")
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "异教徒", null, "呵呵...收下就说明你也对此感兴趣..我们同样对未知的事物感到好奇..", bj_TIMETYPE_SET, 6.00, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, GetUnitName(GetTriggerUnit()), null, ".....", bj_TIMETYPE_SET, 3.00, true)
		call QuestMessageBJ(GetPlayersAll(), bj_QUESTMESSAGE_UPDATED, "蜥蜴人之谜：等待神秘异教徒的消息！")
		call QuestSetDescription(udg_RW[2], "神秘的异教徒告诉了我们蜥蜴人的秘密，让我们等待他的消息，那么，就等待吧")
		set udg_RWXM[1]=CreateQuestItemBJ(udg_RW[2], "等待神秘异教徒的消息（未完成）")
