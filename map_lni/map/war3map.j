	if ( ( GetUnitTypeId(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x4BEB78B1)) == LoadInteger(YDHT, StringHash("技能马甲2"), 0x86D47FF3) ) ) then
		if ( ( GetUnitTypeId(LoadUnitHandle(YDHT, GetHandleId(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x4BEB78B1)), 0x50654F3C)) == 'Nbrn' ) ) then
