//声音模型
//
//声音通道
//声音播放速率
//声音移动速度
//声音投射角
//声音衰减
function s__SoundModel_create takes integer ca,integer sv,integer sco,integer sd returns integer
    local integer s
    set s=s__SoundModel__allocate()
    set s__SoundModel_CA[s]=ca
    call s__ConeAngles_Set(s__SoundModel_CA[s],0 , 0 , 127)
    set s__SoundModel_SV[s]=sv
    call s__SoundVelocity_Set(s__SoundModel_SV[s],0 , 0 , 0)
    set s__SoundModel_SCO[s]=sco
    call s__SoundConeOrientation_Set(s__SoundModel_SCO[s],0 , 0 , 0)
    set s__SoundModel_SD[s]=sd
    call s__SoundDistances_Set(s__SoundModel_SD[s],2500 , 2500)
    set s__SoundModel_Pitch[s]=1.00
    set s__SoundModel_Volume[s]=127
    set s__SoundModel_Channel[s]=0
    set s__SoundModel_SoundType[s]="DefaultEAXON"
    set s__SoundModel_fadeInRate[s]=10
    set s__SoundModel_fadeOutRate[s]=10
    return s
endfunction
function Sound3DII__TimeOut takes nothing returns nothing
local sound sou= LoadSoundHandle(Sound3DII__HT, GetHandleId(GetExpiredTimer()), 0x9B7EB41F)
local integer i= LoadInteger(Sound3DII__HT, GetHandleId(sou), 0xB7279243)
call SaveBoolean(Sound3DII__HT, StringHash(LoadStr(Sound3DII__HT, GetHandleId(sou), 0x2D297D87)), i, true)
set sou=null
endfunction
function Sound3DII__Create takes string s,real r,integer i,real x,real y,real z,boolean is3d returns sound
    local timer t= CreateTimer()
    
    set bj_lastPlayedSound=CreateSound(s, false, is3d, false, s__SoundModel_fadeInRate[Sound3DII_soundModel], s__SoundModel_fadeOutRate[Sound3DII_soundModel], s__SoundModel_SoundType[Sound3DII_soundModel])
    call SetSoundDistances(bj_lastPlayedSound, s__SoundDistances_minDis[s__SoundModel_SD[Sound3DII_soundModel]], s__SoundDistances_maxDis[s__SoundModel_SD[Sound3DII_soundModel]])
    call SetSoundDistanceCutoff(bj_lastPlayedSound, r)
    call SetSoundPosition(bj_lastPlayedSound, x, y, z)
    call SetSoundChannel(bj_lastPlayedSound, s__SoundModel_Channel[Sound3DII_soundModel])
    call SetSoundVolume(bj_lastPlayedSound, s__SoundModel_Volume[Sound3DII_soundModel])
    call SetSoundPitch(bj_lastPlayedSound, s__SoundModel_Pitch[Sound3DII_soundModel])
    call SetSoundConeOrientation(bj_lastPlayedSound, s__SoundConeOrientation_x[s__SoundModel_SCO[Sound3DII_soundModel]], s__SoundConeOrientation_y[s__SoundModel_SCO[Sound3DII_soundModel]], s__SoundConeOrientation_z[s__SoundModel_SCO[Sound3DII_soundModel]])
    call SetSoundConeAngles(bj_lastPlayedSound, s__ConeAngles_IN[s__SoundModel_CA[Sound3DII_soundModel]], s__ConeAngles_OUT[s__SoundModel_CA[Sound3DII_soundModel]], s__ConeAngles_Volume[s__SoundModel_CA[Sound3DII_soundModel]])
    call SetSoundVelocity(bj_lastPlayedSound, s__SoundVelocity_x[s__SoundModel_SV[Sound3DII_soundModel]], s__SoundVelocity_y[s__SoundModel_SV[Sound3DII_soundModel]], s__SoundVelocity_z[s__SoundModel_SV[Sound3DII_soundModel]])
    call SaveSoundHandle(Sound3DII__HT, StringHash(s), i, bj_lastPlayedSound)
    call SaveTimerHandle(Sound3DII__HT, GetHandleId(bj_lastPlayedSound), 0x1CA61CEC, t)
    call SaveSoundHandle(Sound3DII__HT, GetHandleId(t), 0x9B7EB41F, bj_lastPlayedSound)
    call SaveBoolean(Sound3DII__HT, StringHash(s), i, false)
    call SaveInteger(Sound3DII__HT, GetHandleId(bj_lastPlayedSound), 0xB7279243, i)
    call SaveStr(Sound3DII__HT, GetHandleId(bj_lastPlayedSound), 0x2D297D87, s)
    call TimerStart(t, GetSoundFileDuration(s) * 0.001, false, function Sound3DII__TimeOut)
    set t=null
    return bj_lastPlayedSound
endfunction
//获取音效
function Sound3DII__Get takes string s,real r,integer i,real x,real y,real z returns sound
    local timer t= LoadTimerHandle(Sound3DII__HT, GetHandleId(LoadSoundHandle(Sound3DII__HT, StringHash(s), i)), 0x1CA61CEC)
    set bj_lastPlayedSound=LoadSoundHandle(Sound3DII__HT, StringHash(s), i)
    call SetSoundDistances(bj_lastPlayedSound, s__SoundDistances_minDis[s__SoundModel_SD[Sound3DII_soundModel]], s__SoundDistances_maxDis[s__SoundModel_SD[Sound3DII_soundModel]])
    call SetSoundDistanceCutoff(bj_lastPlayedSound, r)
    call SetSoundPosition(bj_lastPlayedSound, x, y, z)
    call SetSoundChannel(bj_lastPlayedSound, s__SoundModel_Channel[Sound3DII_soundModel])
    call SetSoundVolume(bj_lastPlayedSound, s__SoundModel_Volume[Sound3DII_soundModel])
    call SetSoundPitch(bj_lastPlayedSound, s__SoundModel_Pitch[Sound3DII_soundModel])
    call SetSoundConeOrientation(bj_lastPlayedSound, s__SoundConeOrientation_x[s__SoundModel_SCO[Sound3DII_soundModel]], s__SoundConeOrientation_y[s__SoundModel_SCO[Sound3DII_soundModel]], s__SoundConeOrientation_z[s__SoundModel_SCO[Sound3DII_soundModel]])
    call SetSoundConeAngles(bj_lastPlayedSound, s__ConeAngles_IN[s__SoundModel_CA[Sound3DII_soundModel]], s__ConeAngles_OUT[s__SoundModel_CA[Sound3DII_soundModel]], s__ConeAngles_Volume[s__SoundModel_CA[Sound3DII_soundModel]])
    call SetSoundVelocity(bj_lastPlayedSound, s__SoundVelocity_x[s__SoundModel_SV[Sound3DII_soundModel]], s__SoundVelocity_y[s__SoundModel_SV[Sound3DII_soundModel]], s__SoundVelocity_z[s__SoundModel_SV[Sound3DII_soundModel]])
    call SaveBoolean(Sound3DII__HT, StringHash(s), i, false)
    call TimerStart(t, GetSoundFileDuration(s) * 0.001, false, function Sound3DII__TimeOut)
    set t=null
    return bj_lastPlayedSound
endfunction
function Sound3DII__TimeOut2 takes nothing returns nothing
    local sound sou= LoadSoundHandle(Sound3DII__HT, GetHandleId(GetExpiredTimer()), 0x9B7EB41F)
    local integer i= LoadInteger(Sound3DII__HT, GetHandleId(sou), Sound3DII__Key_Index)
    local string s= LoadStr(Sound3DII__HT, GetHandleId(sou), 0x2D297D87)
    local integer sh= StringHash(s)
    local integer index= LoadInteger(Sound3DII__HT, sh, Sound3DII__key_Index) - 1
    //call DisplayTextToPlayer(Player(0),0,0,"结束"+"index="+I2S(index)+"this=:"+I2S(i)+","+s)
    //顶部移动到当前
    call SaveInteger(Sound3DII__HT, GetHandleId(LoadSoundHandle(Sound3DII__HT, sh, index)), Sound3DII__Key_Index, i)
    //当前移动到顶部
    call SaveInteger(Sound3DII__HT, GetHandleId(sou), Sound3DII__Key_Index, index)
    call SaveInteger(Sound3DII__HT, sh, Sound3DII__Key_Index, index)
    set sou=null
    endfunction
//获取音效
function Sound3DII__GetRe takes string s,real r,integer i,real x,real y,real z returns sound
    local timer t= LoadTimerHandle(Sound3DII__HT, GetHandleId(LoadSoundHandle(Sound3DII__HT, StringHash(s), i)), 0x1CA61CEC)
    set bj_lastPlayedSound=LoadSoundHandle(Sound3DII__HT, StringHash(s), i)
    call SetSoundDistances(bj_lastPlayedSound, s__SoundDistances_minDis[s__SoundModel_SD[Sound3DII_soundModel]], s__SoundDistances_maxDis[s__SoundModel_SD[Sound3DII_soundModel]])
    call SetSoundDistanceCutoff(bj_lastPlayedSound, r)
    call SetSoundPosition(bj_lastPlayedSound, x, y, z)
    call SetSoundChannel(bj_lastPlayedSound, s__SoundModel_Channel[Sound3DII_soundModel])
    call SetSoundVolume(bj_lastPlayedSound, s__SoundModel_Volume[Sound3DII_soundModel])
    call SetSoundPitch(bj_lastPlayedSound, s__SoundModel_Pitch[Sound3DII_soundModel])
    call SetSoundConeOrientation(bj_lastPlayedSound, s__SoundConeOrientation_x[s__SoundModel_SCO[Sound3DII_soundModel]], s__SoundConeOrientation_y[s__SoundModel_SCO[Sound3DII_soundModel]], s__SoundConeOrientation_z[s__SoundModel_SCO[Sound3DII_soundModel]])
    call SetSoundConeAngles(bj_lastPlayedSound, s__ConeAngles_IN[s__SoundModel_CA[Sound3DII_soundModel]], s__ConeAngles_OUT[s__SoundModel_CA[Sound3DII_soundModel]], s__ConeAngles_Volume[s__SoundModel_CA[Sound3DII_soundModel]])
    call SetSoundVelocity(bj_lastPlayedSound, s__SoundVelocity_x[s__SoundModel_SV[Sound3DII_soundModel]], s__SoundVelocity_y[s__SoundModel_SV[Sound3DII_soundModel]], s__SoundVelocity_z[s__SoundModel_SV[Sound3DII_soundModel]])
    call TimerStart(t, GetSoundFileDuration(s) * 0.001, false, function Sound3DII__TimeOut2)
    set t=null
    return bj_lastPlayedSound
endfunction
function Sound3DII__CreateRe takes string s,real r,integer i,real x,real y,real z,boolean is3d returns sound
    local timer t= CreateTimer()
    
    set bj_lastPlayedSound=CreateSound(s, false, is3d, false, s__SoundModel_fadeInRate[Sound3DII_soundModel], s__SoundModel_fadeOutRate[Sound3DII_soundModel], s__SoundModel_SoundType[Sound3DII_soundModel])
    call SetSoundDistances(bj_lastPlayedSound, s__SoundDistances_minDis[s__SoundModel_SD[Sound3DII_soundModel]], s__SoundDistances_maxDis[s__SoundModel_SD[Sound3DII_soundModel]])
    call SetSoundDistanceCutoff(bj_lastPlayedSound, r)
    call SetSoundPosition(bj_lastPlayedSound, x, y, z)
    call SetSoundChannel(bj_lastPlayedSound, s__SoundModel_Channel[Sound3DII_soundModel])
    call SetSoundVolume(bj_lastPlayedSound, s__SoundModel_Volume[Sound3DII_soundModel])
    call SetSoundPitch(bj_lastPlayedSound, s__SoundModel_Pitch[Sound3DII_soundModel])
    call SetSoundConeOrientation(bj_lastPlayedSound, s__SoundConeOrientation_x[s__SoundModel_SCO[Sound3DII_soundModel]], s__SoundConeOrientation_y[s__SoundModel_SCO[Sound3DII_soundModel]], s__SoundConeOrientation_z[s__SoundModel_SCO[Sound3DII_soundModel]])
    call SetSoundConeAngles(bj_lastPlayedSound, s__ConeAngles_IN[s__SoundModel_CA[Sound3DII_soundModel]], s__ConeAngles_OUT[s__SoundModel_CA[Sound3DII_soundModel]], s__ConeAngles_Volume[s__SoundModel_CA[Sound3DII_soundModel]])
    call SetSoundVelocity(bj_lastPlayedSound, s__SoundVelocity_x[s__SoundModel_SV[Sound3DII_soundModel]], s__SoundVelocity_y[s__SoundModel_SV[Sound3DII_soundModel]], s__SoundVelocity_z[s__SoundModel_SV[Sound3DII_soundModel]])
    call SaveSoundHandle(Sound3DII__HT, StringHash(s), i, bj_lastPlayedSound)
    call SaveTimerHandle(Sound3DII__HT, GetHandleId(bj_lastPlayedSound), 0x1CA61CEC, t)
    call SaveSoundHandle(Sound3DII__HT, GetHandleId(t), 0x9B7EB41F, bj_lastPlayedSound)
    call SaveInteger(Sound3DII__HT, GetHandleId(bj_lastPlayedSound), Sound3DII__Key_Index, i) //记录位置
    call SaveStr(Sound3DII__HT, GetHandleId(bj_lastPlayedSound), 0x2D297D87, s)
    call TimerStart(t, GetSoundFileDuration(s) * 0.001, false, function Sound3DII__TimeOut2)
    set t=null
    return bj_lastPlayedSound
endfunction
//Sound3DII_CooPlay(string,real,real,real,real)用于在坐标处播放音效
//s:音效位置
//xyz 为坐标
//r:裁断距离
function Sound3DII_CooPlay takes string s,real x,real y,real z,real r returns sound
    local integer sh= StringHash(s)
    local integer count= LoadInteger(Sound3DII__HT, sh, Sound3DII__key_Count)
    local integer index= LoadInteger(Sound3DII__HT, sh, Sound3DII__key_Index)
    local boolean Enable
    local integer loopi= 0
    if index == count then
        set bj_lastPlayedSound=Sound3DII__CreateRe(s , r , count , x , y , z , true)
        call StartSound(bj_lastPlayedSound)
        call SaveInteger(Sound3DII__HT, sh, 0xB7279243, count + 1)
        call SaveInteger(Sound3DII__HT, sh, Sound3DII__key_Index, index + 1)
        //call DisplayTextToPlayer(Player(0),0,0,"新建"+"index="+I2S(index)+"count=:"+I2S(count))
    else
        
        set bj_lastPlayedSound=Sound3DII__GetRe(s , r , index , x , y , z)
        call StartSound(bj_lastPlayedSound)
        call SaveInteger(Sound3DII__HT, sh, Sound3DII__key_Index, index + 1)
        //call DisplayTextToPlayer(Player(0),0,0,"读取"+"index="+I2S(index)+"count=:"+I2S(count))     
    endif
    return bj_lastPlayedSound
endfunction 
//Sound3DII_UnitPlay(string,unit,real)用于在单位位置播放音效
function Sound3DII_UnitPlay takes string s,unit u,real r returns sound
    return Sound3DII_CooPlay(s , GetUnitX(u) , GetUnitY(u) , GetUnitFlyHeight(u) , r)
endfunction
//Sound3DII_LocPlay(string,Location,real)用于在点播放音效
function Sound3DII_LocPlay takes string s,location u,real r returns sound
    return Sound3DII_CooPlay(s , GetLocationX(u) , GetLocationY(u) , GetLocationZ(u) , r)
endfunction
//非3D音效播放函数
function Sound3DII_Mp3Play takes string s,player p returns sound
    local integer count= LoadInteger(Sound3DII__HT, StringHash(s), 0xB7279243)
    local boolean Enable
    local integer loopi= 0
    local real r= 4000
    local sound sou= null
    if count != 0 then
        loop
            set Enable=LoadBoolean(Sound3DII__HT, StringHash(s), loopi)
                if Enable then
                    exitwhen true
                    //call DisplayTextToPlayer(Player(0),0,0,"读取到了一个true值，退出了循环" )
                endif
                //call DisplayTextToPlayer(Player(0),0,0,"循环" )
            set loopi=loopi + 1
            exitwhen loopi == count
        endloop
        
        if not Enable then
            set sou=Sound3DII__Create(s , r , count , 0 , 0 , 0 , false)
            set bj_lastPlayedSound=sou
            if p != null then
                if GetLocalPlayer() == p then
                    call StartSound(sou)
                endif
            else
                call StartSound(sou)
            endif
            //建立一个新的音效
            //call StartSound(Create(s,r,count,0,0,0,false))
            call SaveInteger(Sound3DII__HT, StringHash(s), 0xB7279243, count + 1)
            
        else
            //取出一个音效播放
            set sou=Sound3DII__Get(s , r , loopi , 0 , 0 , 0)
            set bj_lastPlayedSound=sou
            if p != null then
                if GetLocalPlayer() == p then
                    call StartSound(sou)
                endif
            else
                call StartSound(sou)
            endif
            
        endif
    else
    //建立一个新的音效
    set sou=Sound3DII__Create(s , r , count , 0 , 0 , 0 , false)
    set bj_lastPlayedSound=sou
    if p != null then
        if GetLocalPlayer() == p then
            call StartSound(sou)
        endif
    else
        call StartSound(sou)
    endif
    call SaveInteger(Sound3DII__HT, StringHash(s), 0xB7279243, count + 1)
    
        
    
    endif
    set Sound3DII_lastCreateSound=sou
    set sou=null
    return Sound3DII_lastCreateSound
endfunction
//声音效果：默认、战斗、战鼓、魔法、投射物、英雄语音、装饰物
function Sound3DII__GetSoundTypeByID takes integer id returns string
if id == 1 then
    return "CombatSoundsEAX"
elseif id == 2 then
    return "KotoDrumsEAX"
elseif id == 3 then
    return "SpellsEAX"
elseif id == 4 then
    return "MissilesEAX"
elseif id == 5 then
    return "HeroAcksEAX"
elseif id == 6 then
    return "DoodadsEAX"
endif
    return "DefaultEAXON"
endfunction
//设置声音效果
function Sound3DII_SetSoundTypeByID takes integer id returns nothing
    set s__SoundModel_SoundType[Sound3DII_soundModel]=Sound3DII__GetSoundTypeByID(id)
endfunction
//设置声音通道
 function Sound3DII_SetChannel takes integer channel returns nothing
if channel > 14 then
    set channel=0
endif
    set s__SoundModel_Channel[Sound3DII_soundModel]=channel
endfunction
//设置音量 范围：0-127
function Sound3DII_SetVolume takes integer v returns nothing
if v > 127 then
    set v=127
elseif v < 0 then
    set v=0
endif
set s__SoundModel_Volume[Sound3DII_soundModel]=v
endfunction
//设置淡入淡出距离
function Sound3DII_SetDistances takes real min,real max returns nothing
    call s__SoundDistances_Set(s__SoundModel_SD[Sound3DII_soundModel],min , max)
endfunction
//设置声音方向
function Sound3DII_SetConeOrientation takes real x,real y,real z returns nothing
    call s__SoundConeOrientation_Set(s__SoundModel_SCO[Sound3DII_soundModel],x , y , z)
endfunction
//设置声音速度
function Sound3DII_SetVelocity takes real x,real y,real z returns nothing
    call s__SoundVelocity_Set(s__SoundModel_SV[Sound3DII_soundModel],x , y , z)
endfunction
//
function Sound3DII_SetConeAngle takes real inside,real outside,integer volume returns nothing
    call s__ConeAngles_Set(s__SoundModel_CA[Sound3DII_soundModel],inside , outside , volume)
endfunction
//设置淡入音量
function Sound3DII_SetFadeInRate takes integer i returns nothing
    set s__SoundModel_fadeInRate[Sound3DII_soundModel]=i
endfunction
//设置淡出音量
function Sound3DII_SetFadeOutRate takes integer i returns nothing
    set s__SoundModel_fadeOutRate[Sound3DII_soundModel]=i
endfunction
//Sound3DII初始化
function Sound3DII__LibInit takes nothing returns nothing
local integer ca= s__ConeAngles__allocate()
local integer sv= s__SoundVelocity__allocate()
local integer sco= s__SoundConeOrientation__allocate()
local integer sd= s__SoundDistances__allocate()
//初始化声音模型
set Sound3DII_soundModel=s__SoundModel_create(ca , sv , sco , sd)
endfunction

