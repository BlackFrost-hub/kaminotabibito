//----------------------------------------------------------------
// 转换StarType1Id到TypeName
//----------------------------------------------------------------
    function YDTriggerSaveLoadSystem___Init takes nothing returns nothing
            set YDHT=InitHashtable()
        set YDLOC=InitHashtable()
    endfunction

