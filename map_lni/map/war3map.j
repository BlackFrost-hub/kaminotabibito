function Trig_DMboss____________01Conditions takes nothing returns boolean
	return ( ( IsUnitType(GetTriggerUnit(), UNIT_TYPE_HERO) == true ) )
endfunction
function Trig_DMboss____________01Func002Func001Func011Func001Func018003003 takes nothing returns boolean
	return ( ( IsUnitInGroup(GetFilterUnit(), LoadGroupHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x56E86570)) == false ) and ( ( IsUnitType(GetFilterUnit(), UNIT_TYPE_MECHANICAL) == false ) and ( ( IsUnitType(GetFilterUnit(), UNIT_TYPE_ANCIENT) == false ) and ( ( IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x4363BECC))) == true ) and ( IsUnitAliveBJ(GetFilterUnit()) == true ) ) ) ) )
endfunction
function Trig_DMboss____________01Func002Func001Func011Func001Func019A takes nothing returns nothing
	call SaveUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15, GetEnumUnit())
	call GroupAddUnit(LoadGroupHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x56E86570), GetEnumUnit())
