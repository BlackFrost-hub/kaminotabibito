	set gg_trg__________ZSW2_5S=CreateTrigger()
	call TriggerRegisterTimerEventSingle(gg_trg__________ZSW2_5S, 2.50)
	call TriggerAddAction(gg_trg__________ZSW2_5S, function Trig__________ZSW2_5SActions)
endfunction
