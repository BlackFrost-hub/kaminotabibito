			//符咒音效
			call SaveEffectHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x3D91B70E, EC_CreateEffect("Abilities\\Spells\\Other\\Charm\\CharmTarget.mdl" , GetUnitX(GetTriggerUnit()) , GetUnitY(GetTriggerUnit()) , 50.00 , 0.00 , 0.00 , 1.0 , 0.50))
			if ( ( ( GetUnitTypeId(GetTriggerUnit()) == 'O005' ) ) ) then
				call SaveReal(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xCEA5D211, 0.00)
				set ydl_timer=CreateTimer()
				call SaveUnitHandle(YDLOC, GetHandleId(ydl_timer), 0x458B7DE9, GetTriggerUnit())
				call SaveReal(YDLOC, GetHandleId(ydl_timer), 0xD92E3573, LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xD92E3573))
				call SaveReal(YDLOC, GetHandleId(ydl_timer), 0xCEA5D211, LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xCEA5D211))
				call SaveReal(YDLOC, GetHandleId(ydl_timer), 0xB9A583B8, LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xB9A583B8))
				call TimerStart(ydl_timer, ( ( LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x9EF7B67E) ) * ( 0.50 ) ), true, function Trig_DMboss____________03Func004Func004Func012Func003T)
			else
			endif
		else
		endif
		//范围提示
		if ( ( ( ( GetUnitTypeId(GetTriggerUnit()) == 'E07X' ) and ( ( YDWEGetUnitAbilityDataString(GetTriggerUnit() , GetSpellAbilityId() , 1 , 216) == "3" ) ) ) ) ) then
			//Boss施法预警和前腰时是无敌的
			call SetUnitInvulnerable(GetTriggerUnit(), true)
