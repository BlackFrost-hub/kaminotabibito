//声音衰减距离
    function s__SoundDistances_Set takes integer this,real mindis,real maxdis returns nothing
    set s__SoundDistances_minDis[this]=mindis
    set s__SoundDistances_maxDis[this]=maxdis
    endfunction
    function s__SoundDistances_GetMin takes integer this returns real
        return s__SoundDistances_minDis[this]
    endfunction
    function s__SoundDistances_GetMax takes integer this returns real
        return s__SoundDistances_maxDis[this]
    endfunction
//声音投射角
    function s__SoundConeOrientation_Set takes integer this,real x,real y,real z returns nothing
        set s__SoundConeOrientation_x[this]=x
        set s__SoundConeOrientation_y[this]=y
        set s__SoundConeOrientation_z[this]=z
    endfunction
    function s__SoundConeOrientation_GetX takes integer this returns real
        return s__SoundConeOrientation_x[this]
    endfunction
    function s__SoundConeOrientation_GetY takes integer this returns real
        return s__SoundConeOrientation_y[this]
    endfunction
    function s__SoundConeOrientation_GetZ takes integer this returns real
        return s__SoundConeOrientation_z[this]
    endfunction
//声音速度
    function s__SoundVelocity_Set takes integer this,real x,real y,real z returns nothing
        set s__SoundVelocity_x[this]=x
        set s__SoundVelocity_y[this]=y
        set s__SoundVelocity_z[this]=z
    endfunction
    function s__SoundVelocity_GetX takes integer this returns real
        return s__SoundVelocity_x[this]
    endfunction
    function s__SoundVelocity_GetY takes integer this returns real
        return s__SoundVelocity_y[this]
    endfunction
    function s__SoundVelocity_GetZ takes integer this returns real
        return s__SoundVelocity_z[this]
    endfunction
//
    function s__ConeAngles_Set takes integer this,real inside,real outside,integer volume returns nothing
        set s__ConeAngles_IN[this]=inside
        set s__ConeAngles_OUT[this]=outside
        set s__ConeAngles_Volume[this]=volume
    endfunction
    function s__ConeAngles_GetInside takes integer this returns real
        return s__ConeAngles_IN[this]
    endfunction
    function s__ConeAngles_GetOutside takes integer this returns real
        return s__ConeAngles_OUT[this]
    endfunction
    function s__ConeAngles_GetVolume takes integer this returns integer
