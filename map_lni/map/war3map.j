					call ForGroupBJ(LoadGroupHandle(YDHT, GetHandleId(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7), 0x68B72DFF)), 0x56E86570), function Trig_____________DMXTFunc001Func002Func039Func005Func001Func001Func001A)
				else
				endif
				if ( ( LoadBoolean(YDHT, GetHandleId(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7), 0x68B72DFF)), 0x9A8D11A6) == true ) ) then
					call ForGroupBJ(LoadGroupHandle(YDHT, GetHandleId(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7), 0x68B72DFF)), 0x56E86570), function Trig_____________DMXTFunc001Func002Func039Func005Func001Func002Func001A)
				else
				endif
				if ( ( LoadBoolean(YDHT, GetHandleId(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7), 0x68B72DFF)), 0xF71C79A0) == true ) ) then
					call ForGroupBJ(LoadGroupHandle(YDHT, GetHandleId(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7), 0x68B72DFF)), 0x56E86570), function Trig_____________DMXTFunc001Func002Func039Func005Func001Func003Func001A)
				else
				endif
				if ( ( LoadBoolean(YDHT, GetHandleId(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7), 0x68B72DFF)), 0x7553EDA1) == true ) ) then
					call ForGroupBJ(LoadGroupHandle(YDHT, GetHandleId(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7), 0x68B72DFF)), 0x56E86570), function Trig_____________DMXTFunc001Func002Func039Func005Func001Func004Func001A)
				else
				endif
				if ( ( LoadBoolean(YDHT, GetHandleId(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7), 0x68B72DFF)), 0x336DA690) == true ) ) then
					call ForGroupBJ(LoadGroupHandle(YDHT, GetHandleId(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7), 0x68B72DFF)), 0x56E86570), function Trig_____________DMXTFunc001Func002Func039Func005Func001Func005Func001A)
				else
				endif
				if ( ( LoadBoolean(YDHT, GetHandleId(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7), 0x68B72DFF)), 0x63E9845E) == true ) ) then
					call ForGroupBJ(LoadGroupHandle(YDHT, GetHandleId(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7), 0x68B72DFF)), 0x56E86570), function Trig_____________DMXTFunc001Func002Func039Func005Func001Func006Func002A)
				else
					if ( ( LoadBoolean(YDHT, GetHandleId(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7), 0x68B72DFF)), 0x7116D3E5) == true ) ) then
						call ForGroupBJ(LoadGroupHandle(YDHT, GetHandleId(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7), 0x68B72DFF)), 0x56E86570), function Trig_____________DMXTFunc001Func002Func039Func005Func001Func006Func001Func002A)
					else
						call ForGroupBJ(LoadGroupHandle(YDHT, GetHandleId(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7), 0x68B72DFF)), 0x56E86570), function Trig_____________DMXTFunc001Func002Func039Func005Func001Func006Func001Func001A)
					endif
				endif
			endif
		endif
		//避免指定目标的弹幕被删除，一定要追踪到目标造成伤害才会被删除
		if ( ( HaveSavedHandle(YDHT, GetHandleId(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7), 0x68B72DFF)), 0x3301E632) == true ) ) then
			if ( ( IsUnitInGroup(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7), 0x3301E632), LoadGroupHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7), 0x39B00380)) == true ) ) then
				call GroupRemoveUnit(LoadGroupHandle(YDHT, StringHash("弹幕系统"), 0x0A4A1F64), LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7), 0x68B72DFF))
				call KillUnit(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7), 0x68B72DFF))
			else
			endif
		else
			//碰撞消失的提前删除，避免弹射飞刀造成一次伤害就被删除
			if ( ( LoadBoolean(YDLOC, GetHandleId(GetTriggeringTrigger()) * LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7), 0x2EAB6C0C) == true ) ) then
				call GroupRemoveUnit(LoadGroupHandle(YDHT, StringHash("弹幕系统"), 0x0A4A1F64), LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7), 0x68B72DFF))
				call KillUnit(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7), 0x68B72DFF))
			else
				if ( ( HaveSavedReal(YDHT, GetHandleId(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7), 0x68B72DFF)), 0x5A6D3950) == true ) ) then
					if ( ( LoadReal(YDHT, GetHandleId(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7), 0x68B72DFF)), 0x8AD7D160) >= LoadReal(YDHT, GetHandleId(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7), 0x68B72DFF)), 0x5A6D3950) ) ) then
						call GroupRemoveUnit(LoadGroupHandle(YDHT, StringHash("弹幕系统"), 0x0A4A1F64), LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7), 0x68B72DFF))
						call KillUnit(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7), 0x68B72DFF))
					else
					endif
				else
				endif
			endif
		endif
		//这里是弹幕的音效
		if ( ( GetUnitTypeId(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7), 0x2289B0A7)) == 'E001' ) ) then
			call UnitDamageTarget(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7), 0x2289B0A7), LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7), 0x9BF586ED), 0.00, false, false, ATTACK_TYPE_HERO, DAMAGE_TYPE_NORMAL, WEAPON_TYPE_METAL_HEAVY_SLICE)
		else
		endif
	else
		if ( ( IsUnitAliveBJ(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7), 0x68B72DFF)) == true ) ) then
		else
			call GroupRemoveUnit(LoadGroupHandle(YDHT, StringHash("弹幕系统"), 0x0A4A1F64), LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7), 0x68B72DFF))
		endif
	endif
	call DestroyGroup(LoadGroupHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7), 0x39B00380))
	set ydl_group=null
	set ydl_unit=null
endfunction
function Trig_____________DMXTActions takes nothing returns nothing
 local integer ydl_localvar_step= LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xCFDE6C76)
 set ydl_localvar_step=ydl_localvar_step + 3
 call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xCFDE6C76, ydl_localvar_step)
 call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7, ydl_localvar_step)
	if ( ( IsUnitGroupEmptyBJ(LoadGroupHandle(YDHT, StringHash("弹幕系统"), 0x0A4A1F64)) == true ) ) then
		call DisableTrigger(GetTriggeringTrigger())
	else
		call ForGroupBJ(LoadGroupHandle(YDHT, StringHash("弹幕系统"), 0x0A4A1F64), function Trig_____________DMXTFunc001Func002A)
	endif
	call FlushChildHashtable(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step)
endfunction
//===========================================================================
function InitTrig_____________DMXT takes nothing returns nothing
	set gg_trg_____________DMXT=CreateTrigger()
	call TriggerRegisterTimerEventPeriodic(gg_trg_____________DMXT, 0.04)
	call TriggerAddAction(gg_trg_____________DMXT, function Trig_____________DMXTActions)
endfunction
//===========================================================================
// Trigger: 弹幕+马甲/单位排泄DMPS
//===========================================================================
function Trig___________________________DMPSFunc012Func001T takes nothing returns nothing
	call FlushChildHashtable(YDHT, GetHandleId(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x911D5DC2)))
	call RemoveUnit(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x911D5DC2))
	call FlushChildHashtable(YDLOC, GetHandleId(GetExpiredTimer()))
	call DestroyTimer(GetExpiredTimer())
endfunction
function Trig___________________________DMPSFunc013Func001Func002T takes nothing returns nothing
	call FlushChildHashtable(YDHT, GetHandleId(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x911D5DC2)))
	call RemoveUnit(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x911D5DC2))
	call FlushChildHashtable(YDLOC, GetHandleId(GetExpiredTimer()))
	call DestroyTimer(GetExpiredTimer())
endfunction
function Trig___________________________DMPSActions takes nothing returns nothing
 local timer ydl_timer
 local integer ydl_localvar_step= LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xCFDE6C76)
 set ydl_localvar_step=ydl_localvar_step + 3
 call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xCFDE6C76, ydl_localvar_step)
 call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7, ydl_localvar_step)
	if ( ( IsUnitType(GetTriggerUnit(), UNIT_TYPE_MECHANICAL) == true ) ) then
		call DestroyGroup(LoadGroupHandle(YDHT, GetHandleId(GetDyingUnit()), 0x56E86570))
		call SaveUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x68B72DFF, GetTriggerUnit())
		call SaveLocationHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x8F3CED6B, GetUnitLoc(GetDyingUnit()))
		call SaveReal(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xB5BFC652, LoadReal(YDHT, GetHandleId(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x68B72DFF)), 0xB5BFC652))
		call SaveUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x2289B0A7, LoadUnitHandle(YDHT, GetHandleId(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x68B72DFF)), 0x50654F3C))
		//下面这个if动作是Debug预防
		if ( ( IsUnitInGroup(GetTriggerUnit(), LoadGroupHandle(YDHT, StringHash("弹幕系统"), 0x0A4A1F64)) == true ) ) then
			call GroupRemoveUnit(LoadGroupHandle(YDHT, StringHash("弹幕系统"), 0x0A4A1F64), LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x68B72DFF))
		else
		endif
		call RemoveLocation(LoadLocationHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x8F3CED6B))
	else
	endif
	//马甲/单位残留清除
	call SaveUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x911D5DC2, GetDyingUnit())
	if ( ( IsUnitType(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x911D5DC2), UNIT_TYPE_ANCIENT) == true ) and ( IsUnitType(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x911D5DC2), UNIT_TYPE_HERO) == false ) ) then
		set ydl_timer=CreateTimer()
		call SaveUnitHandle(YDLOC, GetHandleId(ydl_timer), 0x911D5DC2, LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x911D5DC2))
		call TimerStart(ydl_timer, 2.00, false, function Trig___________________________DMPSFunc012Func001T)
	else
	endif
	if ( ( IsUnitInGroup(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x911D5DC2), LoadGroupHandle(YDHT, StringHash("刷怪"), 0x0A4A1F64)) == false ) and ( IsUnitType(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x911D5DC2), UNIT_TYPE_HERO) == false ) ) then
		set ydl_timer=CreateTimer()
		call SaveUnitHandle(YDLOC, GetHandleId(ydl_timer), 0x911D5DC2, LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x911D5DC2))
		call TimerStart(ydl_timer, 20.00, false, function Trig___________________________DMPSFunc013Func001Func002T)
	else
	endif
	call FlushChildHashtable(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step)
	set ydl_timer=null
endfunction
//===========================================================================
function InitTrig___________________________DMPS takes nothing returns nothing
	set gg_trg___________________________DMPS=CreateTrigger()
	call TriggerRegisterPlayerUnitEventSimple(gg_trg___________________________DMPS, Player(0), EVENT_PLAYER_UNIT_DEATH)
	call TriggerRegisterPlayerUnitEventSimple(gg_trg___________________________DMPS, Player(1), EVENT_PLAYER_UNIT_DEATH)
	call TriggerRegisterPlayerUnitEventSimple(gg_trg___________________________DMPS, Player(2), EVENT_PLAYER_UNIT_DEATH)
	call TriggerRegisterPlayerUnitEventSimple(gg_trg___________________________DMPS, Player(3), EVENT_PLAYER_UNIT_DEATH)
	call TriggerRegisterPlayerUnitEventSimple(gg_trg___________________________DMPS, Player(5), EVENT_PLAYER_UNIT_DEATH)
	call TriggerRegisterPlayerUnitEventSimple(gg_trg___________________________DMPS, Player(7), EVENT_PLAYER_UNIT_DEATH)
	call TriggerRegisterPlayerUnitEventSimple(gg_trg___________________________DMPS, Player(PLAYER_NEUTRAL_AGGRESSIVE), EVENT_PLAYER_UNIT_DEATH)
	call TriggerRegisterPlayerUnitEventSimple(gg_trg___________________________DMPS, Player(PLAYER_NEUTRAL_PASSIVE), EVENT_PLAYER_UNIT_DEATH)
	call TriggerAddAction(gg_trg___________________________DMPS, function Trig___________________________DMPSActions)
endfunction
//===========================================================================
// Trigger: 各种游戏小技能整合ZH（或许可以TS）
//===========================================================================
function Trig____________________________ZH_______________TS___uFunc002Func002003003 takes nothing returns boolean
	return ( ( IsUnitAlly(GetFilterUnit(), GetTriggerPlayer()) == true ) and ( ( IsUnitOwnedByPlayer(GetFilterUnit(), Player(PLAYER_NEUTRAL_PASSIVE)) == false ) and ( GetUnitTypeId(GetFilterUnit()) != 'ewsp' ) ) )
endfunction
function Trig____________________________ZH_______________TS___uFunc002Func007Func001A takes nothing returns nothing
	call SaveUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7), 0xB3542E15, GetEnumUnit())
endfunction
function Trig____________________________ZH_______________TS___uFunc002Func008Func002Func005Func004A takes nothing returns nothing
	call SaveUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15, GetEnumUnit())
	if ( ( GetUnitTypeId(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15)) == 'n025' ) ) then
		call SaveUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xFE88D7FF, CreateUnitAtLoc(Player(PLAYER_NEUTRAL_PASSIVE), 'e071', LoadLocationHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x2A829619), 0))
	else
		if ( ( GetUnitTypeId(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15)) == 'ndrr' ) ) then
			call SaveUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xFE88D7FF, CreateUnitAtLoc(Player(PLAYER_NEUTRAL_PASSIVE), 'e072', LoadLocationHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x2A829619), 0))
		else
		endif
	endif
endfunction
function Trig____________________________ZH_______________TS___uFunc002Func008Func002Func005T takes nothing returns nothing
	call PauseUnit(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9), false)
	call DestroyEffect(LoadEffectHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB4E808C6))
	call DestroyEffect(LoadEffectHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x542743FD))
	call ForGroupBJ(LoadGroupHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x0A4A1F64), function Trig____________________________ZH_______________TS___uFunc002Func008Func002Func005Func004A)
	call SaveEffectHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xBDA5FE0C, AddSpecialEffectTarget("war3mapImported\\Teleport.mdl", LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9), "origin"))
	call YDWETimerDestroyEffect(2.00 , LoadEffectHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xBDA5FE0C))
	call SetUnitPosition(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9), LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xA99320FA), LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xFDF65382))
	call DestroyGroup(LoadGroupHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x0A4A1F64))
	call FlushChildHashtable(YDLOC, GetHandleId(GetExpiredTimer()))
	call DestroyTimer(GetExpiredTimer())
endfunction
function Trig____________________________ZH_______________TS___uFunc002Func008T takes nothing returns nothing
 local timer ydl_timer
