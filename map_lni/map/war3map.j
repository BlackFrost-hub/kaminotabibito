	//沙漠传说之弓
	if ( ( LoadInteger(YDHT, StringHash("剧情进度"), 0x87DDA352) >= 16 ) and ( IsQuestDiscovered(udg_RW[5]) == false ) and ( ( EXExecuteScript("(require'jass.slk').unit[" + I2S(GetUnitTypeId(GetTriggerUnit())) + "].weapTp1") ) == "missile" ) and ( IsUnitOwnedByPlayer(LoadUnitHandle(YDHT, StringHash("支线NPC"), 0x851E4181), Player(PLAYER_NEUTRAL_PASSIVE)) == true ) and ( IsUnitInRange(GetTriggerUnit(), LoadUnitHandle(YDHT, StringHash("支线NPC"), 0x851E4181), 200.00) == true ) ) then
		call SaveUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x851E4181, LoadUnitHandle(YDHT, StringHash("支线NPC"), 0x851E4181))
		call QuestSetDiscovered(udg_RW[5], true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "？？？", null, "我看女侠手上拿着弓，莫非也是为了寻找沙漠中存在于传说中的弓箭而来？", bj_TIMETYPE_SET, 2.50, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, GetUnitName(GetTriggerUnit()), null, "...抱歉，并不是", bj_TIMETYPE_SET, 3.00, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "？？？", null, "什么？呵呵..这可真是意外..练弓之人基本上来此地的目的无一例外都是为了寻找此弓", bj_TIMETYPE_SET, 6.00, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, GetUnitName(GetTriggerUnit()), null, "可以和我说说吗？", bj_TIMETYPE_SET, 3.00, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "？？？", null, "这不是什么秘密，是大家都知道的事情了..具传说描述，此弓为远古时期活跃于沙漠中的蜥蜴人打造而成...", bj_TIMETYPE_SET, 8.00, true)
		if ( ( IsQuestDiscovered(udg_RW[2]) == true ) ) then
			call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, GetUnitName(GetTriggerUnit()), null, "！（又是蜥蜴人？）", bj_TIMETYPE_SET, 3.00, true)
			call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "？？？", null, "咯嘿嘿...看来你已经知道了有关蜥蜴人的事情了...", bj_TIMETYPE_SET, 4.00, true)
		else
			call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, GetUnitName(GetTriggerUnit()), null, "蜥蜴人？", bj_TIMETYPE_SET, 3.00, true)
			call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "？？？", null, "咯嘿嘿...关于蜥蜴人你可以去问问西边山谷中的穿着神秘的人", bj_TIMETYPE_SET, 4.00, true)
		endif
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "？？？", null, "此弓具体如何打造，花费了多久时间，这就不得而知了，但是根据历史文献记载，此弓可一箭射死沙漠中的任何魔兽..其威力之大，可想而知..", bj_TIMETYPE_SET, 10.00, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "？？？", null, "文献记载，自从此弓打造而成后，弱小的蜥蜴人在沙漠中的范围一步步扩张，到了可以和蛇人硬碰硬的地步，这时沙漠中的最为强大的族群即为蜥蜴人和蛇人..", bj_TIMETYPE_SET, 10.00, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "？？？", null, "可就在蜥蜴人的扩张范围达到鼎盛之时每多久，大概二三百年前，几乎所有蜥蜴人就突然消失在了历史文献之中..", bj_TIMETYPE_SET, 10.00, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, GetUnitName(GetTriggerUnit()), null, "二三百年前突然消失？", bj_TIMETYPE_SET, 3.00, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "？？？", null, "咯嘿嘿..对于我们这些将弓作为生命的生灵来说，这不是重点..", bj_TIMETYPE_SET, 5.00, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "？？？", null, "我刚刚说的是几乎所有...也就是说还剩余蜥蜴人没有消失...最最重要的是，历史文献记载，这支残留的蜥蜴人扔携带着蜥蜴一族打造的弓", bj_TIMETYPE_SET, 10.00, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "？？？", null, "但是对这支蜥蜴人的历史记录，也只有只言片语而已,根据文献，这支蜥蜴人最后消失的地方在.....", bj_TIMETYPE_SET, 8.00, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "？？？", null, "（说着指了指地面）", bj_TIMETYPE_SET, 3.50, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, GetUnitName(GetTriggerUnit()), null, "什么？最后消失的地方在这片绿洲？", bj_TIMETYPE_SET, 3.00, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "？？？", null, "咯嘿嘿..是的...可惜我在此寻找了近五十年，仍旧一无所获", bj_TIMETYPE_SET, 5.00, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, GetUnitName(GetTriggerUnit()), null, "..五十年？忘了，看您的样子，也不是正常生物", bj_TIMETYPE_SET, 3.00, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "？？？", null, "这可很没礼貌啊，像我们这种生物可是对『死』的勇敢挑战", bj_TIMETYPE_SET, 5.00, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, GetUnitName(GetTriggerUnit()), null, "抱歉...您误会了，我的意思是像你们这样的寿命更久而已...", bj_TIMETYPE_SET, 3.00, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "？？？", null, "咯哈哈哈哈，没关系...怎么样？对我说的感兴趣了吗？", bj_TIMETYPE_SET, 5.00, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, GetUnitName(GetTriggerUnit()), null, "你为什么会这么信任我？", bj_TIMETYPE_SET, 3.00, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "？？？", null, "咯嘿嘿..我不会看走眼...", bj_TIMETYPE_SET, 4.00, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, GetUnitName(GetTriggerUnit()), null, "好吧，你打算怎么做？", bj_TIMETYPE_SET, 3.00, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "？？？", null, "首先先要去沙漠中寻找幽魂..其实我的寿命已剩不多，需要幽魂帮我补充生命力", bj_TIMETYPE_SET, 5.00, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "？？？", null, "你可以去沙漠西南角处看看，那里有一片死气沉沉的地方，运气好的话说不定会遇见..", bj_TIMETYPE_SET, 7.50, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "？？？", null, "记住，最好是自身状态不佳的时候去，这种生物就喜欢趁人之危突然出现夺人性命...", bj_TIMETYPE_SET, 7.50, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, GetUnitName(GetTriggerUnit()), null, "好的..我记住了..话说你的名字是？", bj_TIMETYPE_SET, 3.00, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "颅斯丁", null, "咯呵呵...我的名字叫颅斯丁...你快去快回吧", bj_TIMETYPE_SET, 7.50, true)
		call QuestSetDescription(udg_RW[5], "前往沙漠右下角处寻找幽魂")
