    function StarFastBuff__getAngleBetweenUnits takes unit u,unit tu returns real
        return s__Math_GAFC(GetUnitX(u) , GetUnitY(u) , GetUnitX(tu) , GetUnitY(tu))
    endfunction
    function StarFastBuff__onInit takes nothing returns nothing
        set SFB_AblList[0]='ASB0'
        set SFB_AblOrderList[0]="thunderbolt"
        set SFB_AblList[1]='ASB4'
        set SFB_AblOrderList[1]="creepthunderbolt"
        set SFB_AblList[2]='ASB8'
        set SFB_AblOrderList[2]="silence"
        set SFB_AblList[3]='ASBy'
        set SFB_AblOrderList[3]="polymorph"
        set SFB_AblList[4]='ASBX'
        set SFB_AblOrderList[4]="invisibility"
        set SFB_AblList[5]='ASB8'
        set SFB_AblOrderList[5]="silence"
        set SFB_AblList[6]='ASB9'
        set SFB_AblIOrderList[6]=852075 //TODO嗜血术
        set SFB_AblList[7]='ASB9'
        set SFB_AblIOrderList[7]=852075 //TODO驱散
        set SFB_AblList[8]='ASB9'
        set SFB_AblIOrderList[8]=852075
    endfunction  // //设置自定义buff 目标单位 技能id 持续时间
        function StarFastBuff__anon__0 takes nothing returns nothing
            set StarFastBuff__tempTimer=GetExpiredTimer()
            call PauseUnit(LoadUnitHandle(YDHT, GetHandleId(StarFastBuff__tempTimer), 0x62274AD0), false)
            call RemoveSavedHandle(YDHT, GetHandleId(StarFastBuff__tempTimer), 0x62274AD0)
            call DestroyTimer(StarFastBuff__tempTimer)
            set StarFastBuff__tempTimer=null
        endfunction
        function StarFastBuff__anon__1 takes nothing returns nothing
            set StarFastBuff__tempTimer=GetExpiredTimer()
            call EXPauseUnit(LoadUnitHandle(YDHT, GetHandleId(StarFastBuff__tempTimer), 0x62274AD0), false)
            call RemoveSavedHandle(YDHT, GetHandleId(StarFastBuff__tempTimer), 0x62274AD0)
            call DestroyTimer(StarFastBuff__tempTimer)
            set StarFastBuff__tempTimer=null
        endfunction
    function SFB_setBuff takes unit u,integer id,real time returns nothing
        local integer rx=LoadInteger(YDHT, GetHandleId(u), StarFastBuff__key_rx)
        if ( id != 5 ) then
            if ( rx > 100 ) then
                set rx=100
            endif
            if ( rx != 0 ) then
                set time=time * ( 100 - rx ) / 100
            endif
        endif
        if ( time == 0 or IsUnitType(u, UNIT_TYPE_STRUCTURE) or u == SFB_Unit ) then
            return
        endif
        if ( id >= 21 ) then
            if ( id == 21 ) then
                call GS_Suspend(u , time)
            elseif ( id == 22 ) then
                set StarFastBuff__tempTimer=CreateTimer()
                call SaveUnitHandle(YDHT, GetHandleId(StarFastBuff__tempTimer), 0x62274AD0, u)
                call PauseUnit(u, true)
                call TimerStart(StarFastBuff__tempTimer, time, false, function StarFastBuff__anon__0)
                set StarFastBuff__tempTimer=null
            elseif ( id == 23 ) then
                set StarFastBuff__tempTimer=CreateTimer()
                call SaveUnitHandle(YDHT, GetHandleId(StarFastBuff__tempTimer), 0x62274AD0, u)
                call EXPauseUnit(u, true)
                call TimerStart(StarFastBuff__tempTimer, time, false, function StarFastBuff__anon__1)
                set StarFastBuff__tempTimer=null
            endif
        else
            set StarFastBuff__fac=StarFastBuff__getAngleBetweenUnits(SFB_Unit , u)
            call EXSetUnitFacing(SFB_Unit, StarFastBuff__fac)
            call SetUnitFacing(SFB_Unit, StarFastBuff__fac)
            if ( id == 2 ) then
                call YDWESetUnitAbilityDataReal(SFB_Unit , SFB_AblList[id] , 1 , 108 , 8)
            elseif ( id == 5 ) then
                call YDWESetUnitAbilityDataReal(SFB_Unit , SFB_AblList[id] , 1 , 108 , 7)
            endif
            call YDWESetUnitAbilityDataReal(SFB_Unit , SFB_AblList[id] , 1 , 102 , time)
            call YDWESetUnitAbilityDataReal(SFB_Unit , SFB_AblList[id] , 1 , 103 , time)
            call IssueTargetOrder(SFB_Unit, SFB_AblOrderList[id], u)
        endif
    endfunction  //设置单位减速 目标 降低攻速百分比  降低移速百分比  持续时间
    function SFB_setSlow takes unit u,real as,real ms,real time returns nothing
        local integer rx=LoadInteger(YDHT, GetHandleId(u), StarFastBuff__key_rx)
        local real l__StarFastBuff__fac
        if ( rx > 100 ) then
            set rx=100
        endif
        if ( rx != 0 ) then
            set time=time * ( 100 - rx ) / 100
        endif
        if ( time == 0 or IsUnitType(u, UNIT_TYPE_STRUCTURE) or u == SFB_Unit ) then
            return
        endif
        set l__StarFastBuff__fac=StarFastBuff__getAngleBetweenUnits(SFB_Unit , u)
        call EXSetUnitFacing(SFB_Unit, l__StarFastBuff__fac)
        call SetUnitFacing(SFB_Unit, l__StarFastBuff__fac)
        call YDWESetUnitAbilityDataReal(SFB_Unit , 'ASB9' , 1 , 108 , ms)
        call YDWESetUnitAbilityDataReal(SFB_Unit , 'ASB9' , 1 , 109 , as)
        call YDWESetUnitAbilityDataReal(SFB_Unit , 'ASB9' , 1 , 102 , time)
        call YDWESetUnitAbilityDataReal(SFB_Unit , 'ASB9' , 1 , 103 , time)
        call IssueTargetOrderById(SFB_Unit, 852075, u) // if(ms<0){
    endfunction  //     YDWESetUnitAbilityDataString( u, 'Bslo', 1, 213, "该单位被加速了" ) //     YDWESetUnitAbilityDataString( u, 'Bslo', 1, 212, "加速" ) // }

