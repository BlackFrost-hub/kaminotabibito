function Trig_____________________________zhongActions takes nothing returns nothing
 local timer ydl_timer
 local trigger ydl_trigger
 local integer ydl_localvar_step= LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xCFDE6C76)
 set ydl_localvar_step=ydl_localvar_step + 3
 call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xCFDE6C76, ydl_localvar_step)
 call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7, ydl_localvar_step)
	call SaveLocationHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x5B0D7524, GetUnitLoc(GetTriggerUnit()))
	//地精商人
	if ( ( RectContainsLoc(gg_rct______________024, LoadLocationHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x5B0D7524)) == true ) and ( IsUnitType(GetTriggerUnit(), UNIT_TYPE_HERO) == true ) and ( IsUnitInGroup(GetTriggerUnit(), LoadGroupHandle(YDHT, StringHash("玩家英雄"), 0x0A4A1F64)) == true ) and ( GetOwningPlayer(gg_unit_Ntin_0018) != Player(6) ) ) then
		call SetUnitOwner(gg_unit_Ntin_0018, Player(6), true)
		call StopMusic(false)
		if ( ( IsUnitInGroup(GetTriggerUnit(), LoadGroupHandle(YDHT, StringHash("女性英雄"), 0x0A4A1F64)) == true ) ) then
			call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "地精", null, "嗨，小姐", bj_TIMETYPE_SET, 3.00, true)
		else
			call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "地精", null, "嗨，这位人类", bj_TIMETYPE_SET, 3.00, true)
		endif
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, GetUnitName(GetTriggerUnit()), null, "咦？哥布林？还会说话", bj_TIMETYPE_SET, 3.00, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "地精", null, "......（无语）麻烦您称呼我为地精，不要用哥布林这种藐视的叫法来称呼我", bj_TIMETYPE_SET, 3.00, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, GetUnitName(GetTriggerUnit()), null, "......（看来这只哥..地精与其他地精大有不同）不好意思，地精先生，请问你在此处做什么？", bj_TIMETYPE_SET, 3.00, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "地精", null, "我在这里行商", bj_TIMETYPE_SET, 3.00, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, GetUnitName(GetTriggerUnit()), null, "地精先生您都卖些什么？", bj_TIMETYPE_SET, 3.00, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "地精", null, "什么都卖，只要是我有的，药水，装备，材料各种各样的东西物品", bj_TIMETYPE_SET, 3.00, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, GetUnitName(GetTriggerUnit()), null, "哦？既然如此我略感好奇，既然你比其他地精高人一等，为什么却偏偏打算在此处行商？", bj_TIMETYPE_SET, 3.00, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "地精", null, "唉...", bj_TIMETYPE_SET, 3.00, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "地精", null, "您愿意听我的故事吗？", bj_TIMETYPE_SET, 3.00, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, GetUnitName(GetTriggerUnit()), null, "但说无妨", bj_TIMETYPE_SET, 3.00, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "地精", null, "地精中也不都是生来就天生愚笨", bj_TIMETYPE_SET, 3.00, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "地精", null, "而且，像我这样比较聪慧会说话的地精不止我一个，大多充当地精的领导者，统治着地精一族", bj_TIMETYPE_SET, 4.50, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "地精", null, "而我就来自于他们，我与他们不同，不享受于维持现状，希望能改变我们地精一族天生一来低人一等的现状。", bj_TIMETYPE_SET, 3.00, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "地精", null, "经过我的不懈努力，和我持有同样想法的人越来越多", bj_TIMETYPE_SET, 3.00, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "地精", null, "我们地精一族的族长都是由祭祀担任，那万恶的祭祀，在发现我们的所作所为会威胁到自己的统治后，便将我们关押了起来，限制了人生自由", bj_TIMETYPE_SET, 7.50, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "地精", null, "而我，由于在族内声望太高，若杀我会有诸多麻烦，便被赶出了地精一族，一个人什么都没法做，只好在此行商", bj_TIMETYPE_SET, 3.00, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, GetUnitName(GetTriggerUnit()), null, "（没想到眼前的这位地精有这么崇高的理想）", bj_TIMETYPE_SET, 3.00, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "地精", null, "而我，由于在族内声望太高，若杀我会有诸多麻烦，便被赶出了地精一族，只好在此行商", bj_TIMETYPE_SET, 3.00, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, GetUnitName(GetTriggerUnit()), null, "你需要帮助吗？我可以帮到你", bj_TIMETYPE_SET, 3.00, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, GetUnitName(GetTriggerUnit()), null, "若你真有你所说的理想和理念，那么我一定会帮助你", bj_TIMETYPE_SET, 3.00, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "地精", null, "真的吗？谢谢你", bj_TIMETYPE_SET, 3.00, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "地精", null, "你们只需要帮我打败那个只为了自己的祭祀就可以，他下台后，凭借我的声望，一定可以一帆风顺，到时我们地精一族都会谢谢你", bj_TIMETYPE_SET, 8.00, true)
		call ResetToGameCamera(0)
		call SetCameraFieldForPlayer(GetTriggerPlayer(), CAMERA_FIELD_TARGET_DISTANCE, 2000.00, 0)
		call SetMusicVolumeBJ(0.00)
		call CreateQuestBJ(bj_QUESTTYPE_OPT_UNDISCOVERED, "地精一族的命运", "听了地精商人的故事后，你决定前往地精洞窟前去讨伐地精祭祀
任务要求：击杀地精祭祀（0/1）
任务流程：中", "ReplaceableTextures\\CommandButtons\\BTNHeroTinker.blp")
		set udg_RW[1]=GetLastCreatedQuestBJ()
		call QuestSetDiscovered(udg_RW[1], true)
		set udg_RWXM[9]=CreateQuestItemBJ(udg_RW[1], "前往地精洞窟更深处，打败地精祭祀！")
		call QuestMessageBJ(GetPlayersAll(), bj_QUESTMESSAGE_ALWAYSHINT, "|cffffff00『系统提示』：|r|cffff0000如果已经击杀地精祭祀，重新靠近一次此任务NPC即可完成任务|r")
		set ydl_timer=CreateTimer()
		call TimerStart(ydl_timer, 4.00, false, function Trig_____________________________zhongFunc004Func035T)
		call ForForce(LoadForceHandle(YDHT, StringHash("玩家"), 0x7C23C9D2), function Trig_____________________________zhongFunc004Func036A)
	else
	endif
	if ( ( RectContainsLoc(gg_rct______________024, LoadLocationHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x5B0D7524)) == true ) and ( IsUnitType(GetTriggerUnit(), UNIT_TYPE_HERO) == true ) and ( GetOwningPlayer(gg_unit_Ntin_0018) == Player(6) ) and ( IsQuestDiscovered(udg_RW[1]) == true ) and ( ( LoadUnitHandle(YDHT, StringHash("Boss"), 0x836EE4D6) == null ) or ( IsUnitDeadBJ(LoadUnitHandle(YDHT, StringHash("Boss"), 0x836EE4D6)) == true ) ) ) then
		call RemoveRect(gg_rct______________024)
		if ( ( 0 == 0 ) ) then
			call QuestItemSetCompleted(udg_RWXM[9], true)
			call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, GetUnitName(GetTriggerUnit()), null, "我已经帮你击杀地精巫师了..", bj_TIMETYPE_SET, 6.00, true)
			call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "地精商人", null, "最重要的麻烦解决了，我相信我们地精一族会向高级生物进一步进化的", bj_TIMETYPE_SET, 4.00, true)
			call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "地精商人", null, "这边也没有什么可以报答你的，这3000金币还请你收下", bj_TIMETYPE_SET, 4.00, true)
			call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "地精商人", null, "另外我有许多同胞都在这个大陆的世界各地行商，你可以找他们购买一些珍贵的物品", bj_TIMETYPE_SET, 3.00, true)
			call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "地精商人", null, "若是你遇见和我一样的地精，可以用这个|cffffff00『地精勋章』|r打七折
", bj_TIMETYPE_SET, 3.00, true)
			call AdjustPlayerStateBJ(3000, GetOwningPlayer(GetTriggerUnit()), PLAYER_STATE_RESOURCE_GOLD)
			call UnitAddItemByIdSwapped('I09N', GetTriggerUnit())
			call QuestMessageBJ(YDWEGetPlayersMatchingNull(Condition(function Trig_____________________________zhongFunc005Func007Func010001001)), bj_QUESTMESSAGE_HINT, "|cffffff00『系统提示』|r：任务奖励发放在英雄身上，若背包已满则发放在英雄脚下")
			set udg_RWXM[10]=CreateQuestItemBJ(udg_RW[1], "尝试寻找其他地精商人")
			call QuestSetDescription(udg_RW[1], "尝试寻找其他地精商人")
		else
		endif
	else
	endif
	if ( ( IsQuestItemCompleted(udg_RWXM[12]) == false ) and ( IsUnitInRange(GetTriggerUnit(), LoadUnitHandle(YDHT, StringHash("支线NPC"), 0x8A11584C), 500.00) == true ) and ( ( GetItemCharges(YDWEGetItemOfTypeFromUnitBJNull(GetTriggerUnit() , 'I093')) >= 1 ) or ( GetItemCharges(YDWEGetItemOfTypeFromUnitBJNull(GetTriggerUnit() , 'I08Z')) >= 3 ) ) ) then
		call RemoveSavedHandle(YDHT, StringHash("支线NPC"), 0x3497D3B7)
		call QuestItemSetCompleted(udg_RWXM[12], true)
		call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xAF933C64, GetItemCharges(YDWEGetItemOfTypeFromUnitBJNull(GetTriggerUnit() , 'I08Z')))
		call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xDF5FF522, GetItemCharges(YDWEGetItemOfTypeFromUnitBJNull(GetTriggerUnit() , 'I093')))
		call RemoveItem(YDWEGetItemOfTypeFromUnitBJNull(GetTriggerUnit() , 'I08Z'))
		call RemoveItem(YDWEGetItemOfTypeFromUnitBJNull(GetTriggerUnit() , 'I093'))
		if ( ( LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xAF933C64) > 3 ) and ( LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xDF5FF522) > 1 ) ) then
			call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "地精", null, "嘿嘿，材料我就|cffff0000全部收下|r了", bj_TIMETYPE_SET, 4.00, true)
			call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, GetUnitName(GetTriggerUnit()), null, "....（真是个贪心的地精）", bj_TIMETYPE_SET, 4.00, true)
		else
			call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "地精", null, "嘿嘿，材料我就收下了", bj_TIMETYPE_SET, 4.00, true)
		endif
		if ( ( LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xAF933C64) >= 2 ) and ( LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xDF5FF522) >= 6 ) ) then
			call SaveBoolean(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x24C1AB29, true)
		else
		endif
		call AddItemToStockBJ('I09D', LoadUnitHandle(YDHT, StringHash("支线NPC"), 0x8A11584C), 1, 1)
		call AddItemToStockBJ('I09C', LoadUnitHandle(YDHT, StringHash("支线NPC"), 0x8A11584C), 1, 1)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "地精", null, "看看吧，这就是我这里特卖的2件宝物", bj_TIMETYPE_SET, 4.00, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, GetUnitName(GetTriggerUnit()), null, "看起来还确实还不错", bj_TIMETYPE_SET, 4.00, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "地精", null, "那是，如果我在这里行商不讲诚信，早就被这里的恶魔杀了.", bj_TIMETYPE_SET, 4.00, true)
		if ( ( LoadBoolean(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x24C1AB29) == true ) ) then
			call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "地精", null, "嘿嘿，收你的材料还挺多，这样有点过意不去", bj_TIMETYPE_SET, 4.00, true)
