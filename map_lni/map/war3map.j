function Trig___________________PTCFFunc009Func006Func001Func002Func002T takes nothing returns nothing
 local group ydl_group
 local unit ydl_unit
	call EXSetEffectSize(LoadEffectHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x66F185C5), 0.00)
	call EC_CreateEffect("war3mapImported\\superdarkflash.mdl" , LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xA99320FA) , LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xFDF65382) , 35.00 , 270.0 , 1.10 , 1.0 , 1.10)
	call EC_CreateEffect("Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl" , LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xA99320FA) , LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xFDF65382) , 35.00 , 270.0 , 1.10 , 1.0 , 0.10)
	set ydl_group=CreateGroup()
