		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x1A4F8D04), "圣火神 爱尔福林克", null, "..为照亮这漆黑的夜......！", bj_TIMETYPE_SET, 3.00, true)
		call ResetUnitAnimation(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x1A4F8D04))
		call SetUnitTimeScale(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x1A4F8D04), 1.00)
		call Sound3DII_Mp3Play("war3mapImported\\CueSheet_VO_EventSIN010_ja.awb.00035.mp3" , GetFilterPlayer())
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x1A4F8D04), "圣火神 爱尔福林克", null, "还没结束...！（发动『诸神的怒火』）", bj_TIMETYPE_SET, 1.00, true)
		call ForForce(LoadForceHandle(YDHT, StringHash("玩家"), 0x7C23C9D2), function Trig_____________CSJQ_______uFunc001Func098A)
		//战斗
		call SetUnitAnimationByIndex(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x1A4F8D04), 5)
		call SaveReal(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xCEA5D211, 0.00)
		set ydl_timer=CreateTimer()
		call SaveUnitHandle(YDLOC, GetHandleId(ydl_timer), 0xA2FA4C6A, LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xA2FA4C6A))
		call SaveReal(YDLOC, GetHandleId(ydl_timer), 0xCEA5D211, LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xCEA5D211))
		call TimerStart(ydl_timer, 0.50, true, function Trig_____________CSJQ_______uFunc001Func102T)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xA2FA4C6A), "邪神 伍迪", null, ".......", bj_TIMETYPE_SET, 1.50, true)
		call Sound3DII_Mp3Play("war3mapImported\\CueSheet_VO_EventSIN010_ja.awb.00018.wav" , GetFilterPlayer())
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xA2FA4C6A), "邪神 伍迪", null, "..呃..我乃不灭之身...", bj_TIMETYPE_SET, 3.00, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xA2FA4C6A), "邪神 伍迪", null, "自绝望中诞生而来...只要这世上有人仍不相信希望，我就会一直醒来...！", bj_TIMETYPE_SET, 3.00, true)
		call Sound3DII_Mp3Play("war3mapImported\\CueSheet_VO_EventSIN010_ja.awb.00019.wav" , GetFilterPlayer())
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xA2FA4C6A), "邪神 伍迪", null, "终将......吞没整个世界....", bj_TIMETYPE_SET, 3.60, true)
		call EC_CreateEffect("war3mapImported\\apocalypsecowstomp.mdl" , GetUnitX(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xA2FA4C6A)) , GetUnitY(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xA2FA4C6A)) , 0.0 , 270.0 , 2.00 , 1.0 , 1.25)
		call RemoveUnit(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xA2FA4C6A))
		call DestroyEffect(LoadEffectHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xC7C1094D))
		call DestroyEffect(LoadEffectHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xCD1043F3))
		call DestroyEffect(LoadEffectHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xD76E1C1B))
		call Sound3DII_Mp3Play("war3mapImported\\CueSheet_VO_EventSIN010_ja.awb.00020.wav" , GetFilterPlayer())
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xA2FA4C6A), "邪神 伍迪", null, "用人类丑陋的恶意......", bj_TIMETYPE_SET, 3.70, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x1A4F8D04), "圣火神 爱尔福林克", null, ".......", bj_TIMETYPE_SET, 1.50, true)
		call Sound3DII_Mp3Play("war3mapImported\\CueSheet_VO_EventSIN010_ja.awb.00021.wav" , GetFilterPlayer())
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x1A4F8D04), "圣火神 爱尔福林克", null, "圣火啊......照亮吧...！", bj_TIMETYPE_SET, 2.90, true)
		call Sound3DII_Mp3Play("war3mapImported\\CueSheet_VO_EventSIN010_ja.awb.00022.wav" , GetFilterPlayer())
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x1A4F8D04), "圣火神 爱尔福林克", null, "...照亮我们心中的...", bj_TIMETYPE_SET, 1.60, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x1A4F8D04), "圣火神 爱尔福林克", null, "........", bj_TIMETYPE_SET, 2.00, true)
		call CinematicModeBJ(false, GetPlayersAll())
		call StopSoundBJ(gg_snd_JQBGM07, true)
		call StopMusic(false)
		call SaveInteger(YDHT, StringHash("背景播放"), 0x53AC1561, - 2)
		call TriggerExecute(gg_trg______________YX)
		set ydl_group=CreateGroup()
		call GroupEnumUnitsInRange(ydl_group, 19512.10, 26967.70, 2500.00, null)
		loop
			set ydl_unit=FirstOfGroup(ydl_group)
			exitwhen ydl_unit == null
			call GroupRemoveUnit(ydl_group, ydl_unit)
			call SaveUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xB3542E15, ydl_unit)
			call RemoveUnit(ydl_unit)
		endloop
		call DestroyGroup(ydl_group)
		call ForForce(LoadForceHandle(YDHT, StringHash("玩家"), 0x7C23C9D2), function Trig_____________CSJQ_______uFunc001Func128A)
		call FlushChildHashtable(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step)
	set ydl_timer=null
	set ydl_group=null
	set ydl_unit=null
		return
	else
	endif
	call FlushChildHashtable(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step)
	set ydl_timer=null
	set ydl_group=null
	set ydl_unit=null
endfunction
