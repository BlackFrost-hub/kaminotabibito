function Trig_________________________RWActions takes nothing returns nothing
 local timer ydl_timer
 local integer ydl_localvar_step= LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xCFDE6C76)
 set ydl_localvar_step=ydl_localvar_step + 3
 call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xCFDE6C76, ydl_localvar_step)
 call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7, ydl_localvar_step)
	if ( ( ( EVENT_PLAYER_UNIT_SELL_ITEM == GetTriggerEventId() ) == true ) ) then
		if ( ( GetUnitTypeId(GetSellingUnit()) == 'E08G' ) ) then
			call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x482D5996, S2I(EXExecuteScript("(require'jass.slk').item[" + I2S(GetItemTypeId(GetSoldItem())) + "].goldcost")))
			call SaveReal(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x6131E4B8, ( ( 0.20 ) + ( ( ( 0.02 ) * ( I2R(GetUnitAbilityLevel(GetTriggerUnit(), 'A0K9')) ) ) ) ))
			call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x865143B0, R2I(( ( I2R(LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x482D5996)) ) * ( ( ( LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x6131E4B8) ) * ( 0.50 ) ) ) )))
			call AdjustPlayerStateBJ(LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x865143B0), GetTriggerPlayer(), PLAYER_STATE_RESOURCE_GOLD)
			call DisplayTimedTextToPlayer(GetOwningPlayer(GetTriggerUnit()), 0, 0, 15.00, ( ( "|cffffff00『系统消息』：|r|cffffffcc本次交易额外获得了" ) + ( I2S(LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x865143B0)) ) + ( "金钱！|r" ) ))
		else
		endif
		if ( ( ( GetItemTypeId(GetSoldItem()) == 'I05D' ) or ( GetItemTypeId(GetSoldItem()) == 'I04W' ) or ( GetItemTypeId(GetSoldItem()) == 'I053' ) or ( GetItemTypeId(GetSoldItem()) == 'I055' ) or ( GetItemTypeId(GetSoldItem()) == 'I054' ) or ( GetItemTypeId(GetSoldItem()) == 'I056' ) or ( GetItemTypeId(GetSoldItem()) == 'I06K' ) or ( GetItemTypeId(GetSoldItem()) == 'I06T' ) or ( GetItemTypeId(GetSoldItem()) == 'I07S' ) or ( GetItemTypeId(GetSoldItem()) == 'I08N' ) or ( GetItemTypeId(GetSoldItem()) == 'I07O' ) or ( GetItemTypeId(GetSoldItem()) == 'I08V' ) or ( GetItemTypeId(GetSoldItem()) == 'I079' ) or ( GetItemTypeId(GetSoldItem()) == 'I072' ) ) ) then
			if ( ( ( EVENT_PLAYER_UNIT_SELL_ITEM == GetTriggerEventId() ) == false ) ) then
				call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xAE67477F, S2I(EXExecuteScript("(require'jass.slk').item[" + I2S(GetItemTypeId(GetSoldItem())) + "].goldcost")))
				call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x6C2DED4E, ( ( ( ( LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xAE67477F) ) / ( 2 ) ) ) - ( LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xAE67477F) ) ))
				set ydl_timer=CreateTimer()
				call SaveForceHandle(YDLOC, GetHandleId(ydl_timer), 0x437E2A40, LoadForceHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x437E2A40))
				call SaveUnitHandle(YDLOC, GetHandleId(ydl_timer), 0xACA7591B, GetSellingUnit())
				call SaveInteger(YDLOC, GetHandleId(ydl_timer), 0x6C2DED4E, LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x6C2DED4E))
				call TimerStart(ydl_timer, 0.20, false, function Trig_________________________RWFunc003Func003Func001Func004T)
			else
			endif
			if ( ( ( EVENT_PLAYER_UNIT_SELL_ITEM == GetTriggerEventId() ) == true ) and ( ( YDWEUnitHasItemOfTypeBJNull(GetBuyingUnit() , 'I09N') == true ) or ( YDWEUnitHasItemOfTypeBJNull(GetBuyingUnit() , 'I09O') == true ) or ( YDWEUnitHasItemOfTypeBJNull(GetBuyingUnit() , 'I09P') == true ) ) ) then
				call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xAE67477F, S2I(EXExecuteScript("(require'jass.slk').item[" + I2S(GetItemTypeId(GetSoldItem())) + "].goldcost")))
				set ydl_timer=CreateTimer()
				call SaveForceHandle(YDLOC, GetHandleId(ydl_timer), 0x437E2A40, LoadForceHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x437E2A40))
				call SaveUnitHandle(YDLOC, GetHandleId(ydl_timer), 0x867628C3, GetBuyingUnit())
				call SaveInteger(YDLOC, GetHandleId(ydl_timer), 0xAE67477F, LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xAE67477F))
				call TimerStart(ydl_timer, 0.20, false, function Trig_________________________RWFunc003Func003Func002Func004T)
				if ( ( YDWEUnitHasItemOfTypeBJNull(GetBuyingUnit() , 'I09N') == true ) and ( IsQuestItemCompleted(udg_RWXM[10]) == false ) and ( IsUnitInRange(GetTriggerUnit(), LoadUnitHandle(YDHT, StringHash("支线NPC"), 0x3497D3B7), 750.00) == true ) and ( IsUnitInGroup(GetBuyingUnit(), LoadGroupHandle(YDHT, StringHash("玩家英雄"), 0x0A4A1F64)) == true ) ) then
					call QuestItemSetCompleted(udg_RWXM[10], true)
					call RemoveItem(YDWEGetItemOfTypeFromUnitBJNull(GetBuyingUnit() , 'I09N'))
					call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "地精", null, "咦？你这家伙居然有我们这一支的会员勋章？", bj_TIMETYPE_SET, 4.00, true)
					call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, GetUnitName(GetBuyingUnit()), null, "这个勋章是精灵森的地精作为报酬送给我的。", bj_TIMETYPE_SET, 4.00, true)
					call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "地精", null, "报酬？你能做出什么事情才能让特克把这枚勋章送你？", bj_TIMETYPE_SET, 4.00, true)
					call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, GetUnitName(GetBuyingUnit()), null, "特克？你说的是那位在精灵森独自一人卖道具的地精吗", bj_TIMETYPE_SET, 4.00, true)
					call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "地精", null, "没错，整个精灵森只有它有这个权利。", bj_TIMETYPE_SET, 4.00, true)
