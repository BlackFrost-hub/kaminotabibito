		call SaveLocationHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x0729BE59, GetUnitLoc(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x31B1C381)))
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, GetUnitName(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x4F4C6648)), null, "这些人就是团长你们调查的神秘组织？", bj_TIMETYPE_SET, 6.00, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "泰勒团长", null, "应该没错", bj_TIMETYPE_SET, 3.00, true)
