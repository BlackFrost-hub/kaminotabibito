						call SaveReal(YDHT, GetHandleId(bj_lastCreatedUnit), 0x5BCB3607, 0.25)
						call QuestMessageBJ(GetPlayersAll(), bj_QUESTMESSAGE_ALWAYSHINT, "|cffffff00『系统提示』：对此Boss发动|r|cffff9900挑战（FA）|r|cffffff00后即视为|r|cffff0000挑战此boss，会触发Boss战！|r")
					else
