		if ( ( YDWEGetUnitAbilityDataString(GetTriggerUnit() , GetSpellAbilityId() , 1 , 216) == "3" ) ) then
			call SaveUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xD84480C3, LoadUnitHandle(YDHT, GetHandleId(GetTriggerUnit()), 0x70358094))
			call SaveReal(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x0BFBB67B, ( ( GetUnitState(GetTriggerUnit(), ConvertUnitState(0x15)) ) * ( 1.00 ) ))
			set ydul_A=1
			loop
				exitwhen ydul_A > 4
				call SaveReal(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xA99320FA, ( ( GetUnitX(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xD84480C3)) ) + ( ( ( 500.00 ) * ( CosBJ(( ( GetUnitFacing(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xD84480C3)) ) + ( ( ( 90.00 ) * ( I2R(ydul_A) ) ) ) )) ) ) ) ))
