//===========================================================================
// Trigger: 敌对Boss技能提示TS
//===========================================================================
function Trig_______Boss____________TSFunc005Func011T takes nothing returns nothing
	if ( ( IsUnitSpelling(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9)) == false ) ) then
		//解除霸体
		if ( ( LoadBoolean(YDLOC, GetHandleId(GetExpiredTimer()), 0x792F41DB) == true ) ) then
			call SetUnitVertexColor(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9), 255, 0, 0, 255)
			call UnitRemoveAbility(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9), 'A0I6')
		else
		endif
		call RemoveUnit(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x248ED1E3))
		call FlushChildHashtable(YDLOC, GetHandleId(GetExpiredTimer()))
		call DestroyTimer(GetExpiredTimer())
	else
		//霸体Boss
	endif
endfunction
function Trig_______Boss____________TSFunc005Func016T takes nothing returns nothing
	call EXSetEffectSize(LoadEffectHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x66F185C5), 0.00)
	call FlushChildHashtable(YDLOC, GetHandleId(GetExpiredTimer()))
	call DestroyTimer(GetExpiredTimer())
