			call SaveEffectHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x3D91B70E, EC_CreateEffect("Abilities\\Spells\\Other\\Charm\\CharmTarget.mdl" , GetUnitX(GetTriggerUnit()) , GetUnitY(GetTriggerUnit()) , 50.00 , 0.00 , 0.00 , 1.0 , 0.50))
			if ( ( ( ( GetUnitTypeId(GetTriggerUnit()) == 'E07X' ) and ( ( YDWEGetUnitAbilityDataString(GetTriggerUnit() , GetSpellAbilityId() , 1 , 216) == "1" ) or ( YDWEGetUnitAbilityDataString(GetTriggerUnit() , GetSpellAbilityId() , 1 , 216) == "2" ) ) ) ) ) then
				call SaveReal(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xCEA5D211, 0.00)
