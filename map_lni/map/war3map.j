				else
					call SaveReal(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x5D04C6C8, ( ( 1.00 ) / ( LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x9EF7B67E) ) ))
				endif
				call SaveUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x248ED1E3, CreateUnit(Player(0), 'e01O', GetUnitX(GetTriggerUnit()), GetUnitY(GetTriggerUnit()), 0))
				call SetUnitTimeScale(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x248ED1E3), LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x5D04C6C8))
				call SetUnitOwner(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x248ED1E3), Player(4), true)
				call SetUnitFlyHeight(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x248ED1E3), ( ( GetUnitFlyHeight(GetTriggerUnit()) ) + ( 350.00 ) ), 0.00)
				call YDWETimerRemoveUnit(LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x9EF7B67E) , LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x248ED1E3))
				call UnitRemoveBuffsEx(GetTriggerUnit(), false, true, false, false, false, false, true)
				set ydl_timer=CreateTimer()
				call SaveUnitHandle(YDLOC, GetHandleId(ydl_timer), 0x458B7DE9, GetTriggerUnit())
				call SaveUnitHandle(YDLOC, GetHandleId(ydl_timer), 0x248ED1E3, LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x248ED1E3))
				call TimerStart(ydl_timer, 0.10, true, function Trig_DMboss____________03Func004Func004Func003Func011T)
			else
			endif
			//设置特效，单位，技能角度
			call SaveReal(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xB9A583B8, YDWEAngleBetweenUnits(GetTriggerUnit() , LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xD84480C3)))
