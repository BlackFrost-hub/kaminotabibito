    //public:  //删除字符串随机池
        function SSRP_RemovePool takes integer pool returns nothing
            local integer table=pool
            call s__StarTable_destroy(table)
        endfunction  //新建字符串随机池
        function SSRP_CreatePool takes nothing returns integer
            local integer table=s__StarTable__allocate()
            call s__StarTable_SaveInt(table,- 1024 , 0)
            return table
        endfunction  //检查是否在字符串随机池中 返回ID -1等于不存在
        function SSRP_IsInPool takes integer pool,string str returns integer
            local integer table=pool
            local integer count=s__StarTable_LoadInt(table,- 1024)
            local integer i=0
            loop
            exitwhen ( i >= count )
                if ( s__StarTable_LoadString(table,i) == str ) then
                    return i
                endif
                set i=i + 1
            endloop
            return - 1
        endfunction  //字符串随机池添加 字符串 比重为?
        function SSRP_PoolAddString takes integer pool,string str,real v returns nothing
            local integer table=pool
            local integer count=s__StarTable_LoadInt(table,- 1024)
            call s__StarTable_SaveString(table,count , str) //存ID
            call s__StarTable_SaveReal(table,count + 10000 , v)
            set count=count + 1
            call s__StarTable_SaveInt(table,- 1024 , count)
        endfunction  //字符串随机池删除 字符串 
        function SSRP_PoolRemoveString takes integer pool,string str returns nothing
            local integer table=pool
            local integer count=s__StarTable_LoadInt(table,- 1024)
            local integer i=SSRP_IsInPool(pool , str)
            if ( i != - 1 ) then
                set count=count - 1 //重新存名字    
                call s__StarTable_SaveString(table,i , s__StarTable_LoadString(table,count)) //重新存ID
                call s__StarTable_SaveReal(table,i + 10000 , s__StarTable_LoadReal(table,count + 10000))
                call s__StarTable_SaveInt(table,- 1024 , count)
            endif
        endfunction  //字符串随机池取出随机字符串
        function SSRP_PoolGetString takes integer pool returns string
            local integer table=pool
            local string result
            local integer count=s__StarTable_LoadInt(table,- 1024)
            local integer i=0
            local real all=0
            local real r
            local real array ary
            loop
            exitwhen ( i >= count )
                set ary[i]=s__StarTable_LoadReal(table,i + 10000)
                set all=all + ary[i]
                set i=i + 1
            endloop
            if ( all > 0 ) then
                set r=GetRandomReal(0, all)
                set i=0
                set all=0
                loop
                exitwhen ( i >= count )
                    set all=all + ary[i]
                    if ( r <= all ) then
                        set result=s__StarTable_LoadString(table,i)
                        call SSRP_PoolRemoveString(pool , result)
                        return result
                    endif
                    set i=i + 1
                endloop
            endif
            return ""
        endfunction
    function StarStrRPool__onInit takes nothing returns nothing
    endfunction

//library StarStrRPool ends
//library StarString:

    //public:
    function StringBufferLoad takes nothing returns string
        return EXExecuteScript("(require'StarStr').concat3()") // return StringUtil.StrContLoad();
    endfunction  //添加字符串到待连接字符串缓冲池
    function StringBufferAdd takes string str returns nothing
        set SSL_StringBuffer[SSL_StringBufferIndex]=str // Print("添加"); // StringUtil.StrPoolAdd(s);
        set SSL_StringBufferIndex=SSL_StringBufferIndex + 1
    endfunction  //连接字符串lv3EX
    function StringContEX takes string A,string B,string C returns string
        call s__StringUtil_StrPoolAdd(A)
        call s__StringUtil_StrPoolAdd(B)
        call s__StringUtil_StrPoolAdd(C)
        return s__StringUtil_StrContLoad()
    endfunction  ///string.gsub('aaaa','a','z')
    function SS_Stringgsub takes string a,string b,string c returns string
        local string str="string.gsub +('" + a + "'),'" + b + "','" + c + "')"
        local string str2=EXExecuteScript(str)
        if ( str2 != null ) then
            return str2
        endif
        return ""
    endfunction  //连接字符串
    function stradd takes string s1,string s2 returns string
        return s1 + s2
    endfunction  //将实数转为整数后格式化为指定长度的字符串
    function FormatNumToString takes real r,integer max returns string
        local integer i=0
        local string str2=I2S(R2I(r))
        if ( r < 0 ) then
            set max=max - 1
            call StringBufferAdd("-")
            set str2=SubStringBJ(str2, 2, StringLength(str2))
        endif
        set i=0
        loop
        exitwhen ( i >= ( max - StringLength(str2) ) )
            call StringBufferAdd("0")
        set i=i + 1
        endloop
        call StringBufferAdd(str2)
        return StringBufferLoad()
    endfunction
    function FormatIntToString takes integer r,integer max returns string
        local integer i=0
        local string str2=I2S(r)
        if ( r < 0 ) then
            set max=max - 1
            call StringBufferAdd("-")
            set str2=SubStringBJ(str2, 2, StringLength(str2))
        endif
        set i=0
        loop
        exitwhen ( i >= ( max - StringLength(str2) ) )
            call StringBufferAdd("0")
        set i=i + 1
        endloop
        call StringBufferAdd(str2)
        return StringBufferLoad()
    endfunction  //格式化玩家ID为两位字符串
    function GetPlayerIDString takes player p returns string
        local integer id=GetPlayerId(p)
        if ( id < 10 ) then
            set CallBackString="0" + I2S(id)
            return CallBackString
        endif
        set CallBackString=I2S(id)
        return CallBackString
    endfunction  //获取字符串中指定的第一个字符出现的位置
    function GetIndexOfChar takes string str,string tgt returns integer
        local string c=SubStringBJ(tgt, 1, 1)
        local string b
        local integer max=StringLength(str)
        local integer i=0
        loop
        exitwhen ( i >= max )
            set b=SubStringBJ(str, i, i)
            if ( b == c ) then
                return i
            endif
            set i=i + 1
        endloop
        return - 1
    endfunction  //分割字符串str分隔符为tgt 若没有找到分隔符 则返回str
    function strtok takes string str,string tgt returns nothing
        local string c=SubStringBJ(tgt, 1, 1)
        local string b
        local integer max=StringLength(str)
        local integer i=0
        local integer base=1
        set SS_Index=0
        loop
        exitwhen ( i >= max )
            set i=i + 1
            set b=SubStringBJ(str, i, i)
            if ( b == c ) then
                set SS_CallbackString[SS_Index]=SubStringBJ(str, base, i - 1)
                set SS_Index=SS_Index + 1
                set base=i + 1
            endif
        endloop
        set SS_CallbackString[SS_Index]=SubStringBJ(str, base, i)
        set SS_Index=SS_Index + 1
    endfunction
    function StarString__onInit takes nothing returns nothing
    endfunction

//library StarString ends
//library X2:

    //private:
        function s__X2__Point2f_create2 takes real X,real Y returns integer
            local integer p=s__X2__Point2f__allocate()
            set s__X2__Point2f_x[p]=X
            set s__X2__Point2f_y[p]=Y
            return p
        endfunction
        function s__X2__Point2f_reset takes integer this,real X,real Y returns nothing
            set s__X2__Point2f_x[this]=X
            set s__X2__Point2f_y[this]=Y
        endfunction
    function X2__DistanceBetweenUnit takes unit a,unit b returns real
        local real x1=GetUnitX(a)
        local real y1=GetUnitY(a)
        local real x2=GetUnitX(b)
        local real y2=GetUnitY(b)
        return SquareRoot(( y1 - y2 ) * ( y1 - y2 ) + ( x1 - x2 ) * ( x1 - x2 ))
    endfunction  // 已知两点求直线
    function getLinePara takes real x1,real y1,real x2,real y2,integer LP returns nothing
        local real m=0
        set m=x2 - x1
        if ( 0 == m ) then
            set s__X2__LinePara_k[LP]=10000.0
            set s__X2__LinePara_b[LP]=y1 - s__X2__LinePara_k[LP] * x1
        else
            set s__X2__LinePara_k[LP]=( y2 - y1 ) / ( x2 - x1 )
            set s__X2__LinePara_b[LP]=y1 - s__X2__LinePara_k[LP] * x1
        endif // y = kx + b
    endfunction
    function GAFC2 takes real x1,real y1,real x2,real y2 returns real
        return Atan2(y2 - y1, x2 - x1) * bj_RADTODEG
    endfunction
    function GetDistanceUsePoint takes integer p1,integer p2 returns real
        return SquareRoot(( s__X2__Point2f_y[p1] - s__X2__Point2f_y[p2] ) * ( s__X2__Point2f_y[p1] - s__X2__Point2f_y[p2] ) + ( s__X2__Point2f_x[p1] - s__X2__Point2f_x[p2] ) * ( s__X2__Point2f_x[p1] - s__X2__Point2f_x[p2] ))
    endfunction
    function getDistancePointAndLine takes integer p0,integer p1,integer p2 returns real
        local real dis12=GetDistanceUsePoint(p1 , p2)
        local real dis01=GetDistanceUsePoint(p0 , p1)
        local real dis02=GetDistanceUsePoint(p0 , p2)
        local real HalfC=( dis12 + dis01 + dis02 ) / 2
        local real s=SquareRoot(HalfC * ( HalfC - dis12 ) * ( HalfC - dis01 ) * ( HalfC - dis02 ))
        local real dis=2 * s / dis12
        return dis
    endfunction
    function getDistancePointAndLine2 takes integer p0,integer p1,integer p2,real dis12 returns real
        local real dis01=GetDistanceUsePoint(p0 , p1)
        local real dis02=GetDistanceUsePoint(p0 , p2)
        local real HalfC=( dis12 + dis01 + dis02 ) / 2
        local real s=SquareRoot(HalfC * ( HalfC - dis12 ) * ( HalfC - dis01 ) * ( HalfC - dis02 ))
        local real dis=2 * s / dis12
        return dis
    endfunction
    function fabs takes real a returns real
        if ( a >= 0 ) then
            return a
        endif
        return - a
    endfunction
    function getDistancePointAndLine3 takes integer p0,integer p1,integer p2 returns real
        local real x0=s__X2__Point2f_x[p0]
        local real x1=s__X2__Point2f_x[p1]
        local real x2=s__X2__Point2f_x[p2]
        local real y0=s__X2__Point2f_x[p0]
        local real y1=s__X2__Point2f_x[p1]
        local real y2=s__X2__Point2f_x[p2]
        return ( fabs(( y2 - y1 ) * x0 + ( x1 - x2 ) * y0 + ( ( x2 * y1 ) - ( x1 * y2 ) )) ) / ( SquareRoot(Pow(y2 - y1, 2) + Pow(x1 - x2, 2)) )
    endfunction
    //public:
    function X2_GetNearUnitOnGroup takes group gg,unit un returns unit
        local unit u
        local integer index=0
        local integer i=0
        local real j=0
        set X2__ReturnUnit=null
        set X2__tempg=CreateGroup()
        call GroupAddGroup(gg, X2__tempg)
        set u=FirstOfGroup(X2__tempg)
        loop
        exitwhen ( u == null )
            if ( GetUnitState(u, UNIT_STATE_LIFE) > 0.00 ) then
                set X2__arrayU[index]=u
                set X2__arrayI[index]=X2__DistanceBetweenUnit(u , un)
                set index=index + 1
            endif
            call GroupRemoveUnit(X2__tempg, u)
            set u=FirstOfGroup(X2__tempg)
        endloop // GroupClear(tempg);
        call DestroyGroup(X2__tempg)
        if ( index > 0 ) then
            set j=X2__arrayI[i]
            set X2__ReturnUnit=X2__arrayU[i]
            loop
            exitwhen ( i >= index )
                if ( X2__arrayI[i] < j ) then //这个值小于当前记录最小值
                    set j=X2__arrayI[i] //当前记录最小值 = 这个值 //当前记录单位 = 这个单位
                    set X2__ReturnUnit=X2__arrayU[i]
                endif
                set i=i + 1
            endloop
        endif
        set u=null
        return X2__ReturnUnit
    endfunction  //生命值最少的单位
    function X2_GetMinHpOfGroup takes group gg returns unit
        local unit u
        local integer index=0
        local integer i=0
        local real j=0
        set X2__ReturnUnit=null
        set X2__tempg=CreateGroup()
        call GroupAddGroup(gg, X2__tempg)
        set u=FirstOfGroup(X2__tempg)
        loop
        exitwhen ( u == null )
            if ( GetUnitState(u, UNIT_STATE_LIFE) > 0.00 ) then
                set X2__arrayU[index]=u
                set X2__arrayI[index]=GetUnitState(u, UNIT_STATE_LIFE)
                set index=index + 1
            endif
            call GroupRemoveUnit(X2__tempg, u)
            set u=FirstOfGroup(X2__tempg)
        endloop // GroupClear(tempg);
        call DestroyGroup(X2__tempg)
        if ( index > 0 ) then
            set j=X2__arrayI[i]
            set X2__ReturnUnit=X2__arrayU[i]
            loop
            exitwhen ( i >= index )
                if ( X2__arrayI[i] < j ) then //这个值小于当前记录最小值
                    set j=X2__arrayI[i] //当前记录最小值 = 这个值 //当前记录单位 = 这个单位
                    set X2__ReturnUnit=X2__arrayU[i]
                endif
                set i=i + 1
            endloop
        endif
        set u=null
        return X2__ReturnUnit
    endfunction
    function X2_GDBC takes real x1,real y1,real x2,real y2 returns real
        return SquareRoot(( y1 - y2 ) * ( y1 - y2 ) + ( x1 - x2 ) * ( x1 - x2 ))
    endfunction
    function X2_GetNearPointOnGroup takes group gg,real x,real y returns unit
        local unit u
        local integer index=0
        local integer i=0
        local real j=0
        set X2__ReturnUnit=null
        set X2__tempg=CreateGroup()
        call GroupAddGroup(gg, X2__tempg)
        set u=FirstOfGroup(X2__tempg)
        loop
        exitwhen ( u == null )
            if ( GetUnitState(u, UNIT_STATE_LIFE) > 0.00 ) then
                set X2__arrayU[index]=u
                set X2__arrayI[index]=X2_GDBC(GetUnitX(u) , GetUnitY(u) , x , y)
                set index=index + 1
            endif
            call GroupRemoveUnit(X2__tempg, u)
            set u=FirstOfGroup(X2__tempg)
        endloop
        call GroupClear(X2__tempg)
        call DestroyGroup(X2__tempg)
        if ( index > 0 ) then
            set j=X2__arrayI[i]
            set X2__ReturnUnit=X2__arrayU[i]
            loop
            exitwhen ( i >= index )
                if ( X2__arrayI[i] < j ) then
                    set j=X2__arrayI[i]
                    set X2__ReturnUnit=X2__arrayU[i]
                endif
                set i=i + 1
            endloop
        endif
        call DestroyGroup(X2__tempg)
        set u=null
        return X2__ReturnUnit
    endfunction
    function X2_GetNearUnit takes real r,unit un returns unit
        local unit u
        local integer index=0
        local integer i=0
        local real j=0
        local group g=CreateGroup()
        set X2__ReturnUnit=null
        set X2__tempg=CreateGroup()
        call GroupEnumUnitsInRange(g, GetUnitX(un), GetUnitY(un), r, null)
        set u=FirstOfGroup(g)
        loop
        exitwhen ( u == null )
            if ( IsUnitEnemy(u, GetOwningPlayer(un)) ) then
                call GroupAddUnit(X2__tempg, u)
            endif
            call GroupRemoveUnit(g, u)
            set u=FirstOfGroup(g)
        endloop
        call GroupClear(g)
        call DestroyGroup(g)
        set u=FirstOfGroup(X2__tempg)
        loop
        exitwhen ( u == null )
            set X2__arrayU[index]=u
            set X2__arrayI[index]=X2__DistanceBetweenUnit(u , un)
            set index=index + 1
            call GroupRemoveUnit(X2__tempg, u)
            set u=FirstOfGroup(X2__tempg)
        endloop
        call GroupClear(X2__tempg)
        call DestroyGroup(X2__tempg)
        if ( index > 0 ) then
            set j=X2__arrayI[i]
            set X2__ReturnUnit=X2__arrayU[i]
            loop
            exitwhen ( i >= index )
                if ( X2__arrayI[i] < j ) then
                    set j=X2__arrayI[i]
                    set X2__ReturnUnit=X2__arrayU[i]
                endif
                set i=i + 1
            endloop
        endif
        set g=null
        set u=null
        return X2__ReturnUnit
    endfunction
    function GetUnitOnLine takes real x,real y,real a,real b,real r returns group
        local unit u
        local group g=CreateGroup()
        local real c=0
        local real d=0
        local real dis
        local real dd=GAFC2(x , y , a , b)
        set s__X2__Point2f_x[P2]=a
        set s__X2__Point2f_y[P2]=b
        set x=x + Cos(dd * bj_DEGTORAD) * 0.5 * r
        set y=y + Sin(dd * bj_DEGTORAD) * 0.5 * r
        set c=( x + a ) / 2
        set d=( y + b ) / 2
        set s__X2__Point2f_x[P1]=x
        set s__X2__Point2f_y[P1]=y
        set dis=GetDistanceUsePoint(P1 , P2)
        set callBackGroup=CreateGroup()
        call GroupEnumUnitsInRange(g, c, d, ( dis + r ) / 2, null)
        set u=FirstOfGroup(g)
        loop
        exitwhen ( u == null )
            set s__X2__Point2f_x[P0]=GetUnitX(u)
            set s__X2__Point2f_y[P0]=GetUnitY(u)
            if ( getDistancePointAndLine2(P0 , P1 , P2 , dis) < r ) then //if(getDistancePointAndLine3(P0,P1,P2) <r)
                call GroupAddUnit(callBackGroup, u)
            endif
            call GroupRemoveUnit(g, u)
            set u=FirstOfGroup(g)
        endloop
        call GroupClear(g)
        call DestroyGroup(g)
        set g=null
        set u=null
        return callBackGroup
    endfunction  //
    function GetUnitOnRect takes real x,real y,real a,real b,real r returns group
        local unit u
        local group g=CreateGroup()
        local real c=0
        local real d=0
        local real dis
        local real dd=GAFC2(x , y , a , b)
        local real long=s__Math_GDBC(x , y , a , b)
        local real hl=long / 2
        local real hr=r / 2
        set s__X2__Point2f_x[P2]=a
        set s__X2__Point2f_y[P2]=b
        set x=x + Cos(dd * bj_DEGTORAD) * 0.5 * r
        set y=y + Sin(dd * bj_DEGTORAD) * 0.5 * r
        set c=( x + a ) / 2
        set d=( y + b ) / 2
        set s__X2__Point2f_x[P1]=x
        set s__X2__Point2f_y[P1]=y
        set dis=GetDistanceUsePoint(P1 , P2)
        set callBackGroup=CreateGroup()
        call GroupEnumUnitsInRange(g, c, d, ( dis + r ) / 2, null)
        set u=FirstOfGroup(g)
        loop
        exitwhen ( u == null )
            set s__X2__Point2f_x[P0]=GetUnitX(u)
            set s__X2__Point2f_y[P0]=GetUnitY(u)
            if ( getDistancePointAndLine2(P0 , P1 , P2 , dis) < r ) then //if(getDistancePointAndLine3(P0,P1,P2) <r)
                if ( s__Math_GDBC(x , y , s__X2__Point2f_x[P0] , s__X2__Point2f_y[P0]) * SinBJ(s__Math_GAFC(x , y , s__X2__Point2f_x[P0] , s__X2__Point2f_y[P0]) - dd) < hr ) then
                    if ( s__Math_GDBC(a , b , s__X2__Point2f_x[P0] , s__X2__Point2f_y[P0]) * SinBJ(s__Math_GAFC(a , b , s__X2__Point2f_x[P0] , s__X2__Point2f_y[P0]) - dd - 90) < hl ) then
                        call GroupAddUnit(callBackGroup, u)
                    endif
                endif
            endif
            call GroupRemoveUnit(g, u)
            set u=FirstOfGroup(g)
        endloop
        call GroupClear(g)
        call DestroyGroup(g)
        set g=null
        set u=null
        return callBackGroup
    endfunction
    function X2__onInit takes nothing returns nothing
        set P0=s__X2__Point2f__allocate()
        set P1=s__X2__Point2f__allocate()
        set P2=s__X2__Point2f__allocate()
        set LP0=s__X2__LinePara__allocate()
    endfunction

//library X2 ends
//library handySD:
//漂浮文字
function GS_TextTag takes string S,location L,real G,real D,real Red,real Green,real Blue,real Transparency,real Speed,real Angle,real R1,real R2,force F returns texttag
    set bj_lastCreatedTextTag=CreateTextTag()
    call SetTextTagPos(bj_lastCreatedTextTag, GetLocationX(L), GetLocationY(L), G)
    call SetTextTagVelocityBJ(bj_lastCreatedTextTag, Speed, Angle)
    call SetTextTagTextBJ(bj_lastCreatedTextTag, S, D)
    call SetTextTagColorBJ(bj_lastCreatedTextTag, Red, Green, Blue, Transparency)
    call SetTextTagFadepoint(bj_lastCreatedTextTag, R1)
    call SetTextTagLifespan(bj_lastCreatedTextTag, R2)
    call SetTextTagPermanent(bj_lastCreatedTextTag, false)
    call ShowTextTagForceBJ(true, bj_lastCreatedTextTag, GetPlayersAll())
    call RemoveLocation(L)
    return bj_lastCreatedTextTag
endfunction
//移动单位（判定通行）
function GS_moveunit takes unit u,real angle,real dist,pathingtype phe returns nothing
    local real x= GetUnitX(u) + dist * Cos(angle * bj_DEGTORAD)
    local real y= GetUnitY(u) + dist * Sin(angle * bj_DEGTORAD)
    if ( ( IsTerrainPathable(x, y, phe) == false ) ) then
        call SetUnitX(u, x)
        call SetUnitY(u, y)
    endif
endfunction
//移动单位
function GS_moveunitT takes unit u,real angle,real dist returns nothing
    local real x= GetUnitX(u) + dist * Cos(angle * bj_DEGTORAD)
    local real y= GetUnitY(u) + dist * Sin(angle * bj_DEGTORAD)
    call SetUnitX(u, YDWECoordinateX(x))
    call SetUnitY(u, YDWECoordinateY(y))
endfunction
//两点间角度
function GS_AngleBetweenPoints takes location locA,location locB returns real
    local real d= bj_RADTODEG * Atan2(GetLocationY(locB) - GetLocationY(locA), GetLocationX(locB) - GetLocationX(locA))
    call RemoveLocation(locA)
    call RemoveLocation(locB)
    return d
endfunction
//两点间距离
function GS_DistanceBetweenPoints takes location locA,location locB returns real
    local real dx= GetLocationX(locB) - GetLocationX(locA)
    local real dy= GetLocationY(locB) - GetLocationY(locA)
    call RemoveLocation(locA)
    call RemoveLocation(locB)
    return SquareRoot(dx * dx + dy * dy)
endfunction
//极坐标转移
function GS_PolarProjectionBJ takes location source,real dist,real angle returns location
    local real x= GetLocationX(source) + dist * Cos(angle * bj_DEGTORAD)
    local real y= GetLocationY(source) + dist * Sin(angle * bj_DEGTORAD)
    call RemoveLocation(source)
    return Location(x, y)
endfunction
//新建单位点
function GS_CreateUnitAtLoct takes player id,integer unitid,location loc,real face returns unit
    if ( unitid == 'ugol' ) then
        set bj_lastCreatedUnit=CreateBlightedGoldmine(id, GetLocationX(loc), GetLocationY(loc), face)
    else
        set bj_lastCreatedUnit=CreateUnitAtLoc(id, unitid, loc, face)
    endif
    call RemoveLocation(loc)
    return bj_lastCreatedUnit
endfunction
//特效点
function GS_AddSpecialEffectLoc takes string modelName,location where returns effect
    set bj_lastCreatedEffect=AddSpecialEffectLoc(modelName, where)
    call RemoveLocation(where)
    return bj_lastCreatedEffect
endfunction
//移动单位
function GS_SetUnitPositionLoc takes unit u,location loc returns nothing
    call SetUnitPositionLoc(u, loc)
    call RemoveLocation(loc)
endfunction
//平移镜头
function GS_PanCameraToTimedLocForPlayer takes player p,location loc,real r returns nothing
    call PanCameraToTimedLocForPlayer(p, loc, r)
    call RemoveLocation(loc)
endfunction
//条件合集
function GS_IsUnitAliveBJ takes unit whichUnit,unit whichUnittow returns boolean
    return ( ( IsUnitAlly(whichUnit, GetOwningPlayer(whichUnittow)) == false ) and ( IsUnitDeadBJ(whichUnit) == false ) and ( IsUnitType(whichUnit, UNIT_TYPE_STRUCTURE) == false ) and ( IsUnitType(whichUnit, UNIT_TYPE_ANCIENT) == false ) )
endfunction
//移动闪电链
function GS_MoveLightningEx takes lightning whichBolt,boolean B,location l1,real R1,location l2,real R2 returns nothing
    call MoveLightningEx(whichBolt, B, GetLocationX(l1), GetLocationY(l1), R1, GetLocationX(l2), GetLocationY(l2), R2)
    call RemoveLocation(l1)
    call RemoveLocation(l2)
endfunction
//屏幕震动
function handySD__GS_VibrationB takes nothing returns nothing
    local timer T= GetExpiredTimer()
    local player P= LoadPlayerHandle(handySD__HS_H, GetHandleId(T), 1)
    call CameraClearNoiseForPlayer(P)
    call SaveReal(handySD__HS_H, GetHandleId(P), 1, 0)
    call DestroyTimer(T)
    set T=null
endfunction
function GS_VibrationA takes player ply,real R,real time returns nothing
    local timer T
    if ( LoadReal(handySD__HS_H, GetHandleId(ply), 1) == 0.00 ) then
        set T=CreateTimer()
        call SaveTimerHandle(handySD__HS_H, GetHandleId(ply), 1, T)
        call SavePlayerHandle(handySD__HS_H, GetHandleId(T), 1, ply)
    else
        set T=LoadTimerHandle(handySD__HS_H, GetHandleId(ply), 1)
    endif
    call SaveReal(handySD__HS_H, GetHandleId(ply), 1, time)
    call CameraSetEQNoiseForPlayer(ply, R)
    call TimerStart(T, time, false, function handySD__GS_VibrationB)
    set T=null
endfunction
//发送消息
function GS_news takes player P,string S returns nothing
    local force F= CreateForce()
    call ForceAddPlayer(F, P)
    call QuestMessageBJ(F, bj_QUESTMESSAGE_UPDATED, S)
    call DestroyForce(F)
    set F=null
endfunction
function GS_DisplayTimedTextToForcetakes takes player ply,real r,string str returns nothing
    local force fre= CreateForce()
    call ForceAddPlayer(fre, ply)
    call DisplayTimedTextToForce(fre, r, str)
    call DestroyForce(fre)
    set fre=null
endfunction
function GS_UnitSector takes unit u1,unit u2,real r returns boolean
    local real angle1= GetUnitFacing(u1)
    local real angle2= bj_RADTODEG * Atan2(GetUnitY(u1) - GetUnitY(u2), GetUnitX(u1) - GetUnitX(u2))
    return ( RAbsBJ(RAbsBJ(( angle1 - angle2 ) - 180) - 180) > r )
endfunction
function GS_Sector takes real angle1,real angle2 returns real
    return RAbsBJ(RAbsBJ(( angle1 - angle2 ) - 180) - 180)
endfunction
//传送单位
function GS_Delivery takes unit u,location loc returns nothing
    call DestroyEffect(AddSpecialEffectLoc("Abilities\\Spells\\Human\\MassTeleport\\MassTeleportCaster.mdl", loc))
    call SetUnitPositionLoc(u, loc)
    call DestroyEffect(AddSpecialEffectLoc("Abilities\\Spells\\Human\\MassTeleport\\MassTeleportCaster.mdl", loc))
    call PanCameraToTimedLocForPlayer(GetOwningPlayer(u), loc, 0.00)
    call RemoveLocation(loc)
endfunction
//简易伤害
function GS_DataHurt takes real co,integer pty,integer lv,real r returns real
    return co + I2R(pty) * I2R(lv) * r
endfunction
function GS_UnitRangeHurt takes unit u1,location loc,real range,real hurt returns nothing
    local unit u2
    local group g= CreateGroup()
    call GroupEnumUnitsInRange(g, GetLocationX(loc), GetLocationY(loc), range, null)
    loop
        exitwhen CountUnitsInGroup(g) == 0
        set u2=FirstOfGroup(g)
        if ( GS_IsUnitAliveBJ(u2 , u1) == true ) then
            call UnitDamageTarget(u1, u2, hurt, false, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, WEAPON_TYPE_WHOKNOWS)
        endif
        call GroupRemoveUnit(g, u2)
    endloop
    call RemoveLocation(loc)
    call DestroyGroup(g)
    set u2=null
    set g=null
endfunction
//在线玩家
function GS_PlayerNum takes nothing returns integer
    local integer a= 1
    local integer b= 7
    local integer c= 0
    loop
        exitwhen a > b
        if ( ( GetPlayerController(ConvertedPlayer(a)) == MAP_CONTROL_USER ) and ( GetPlayerSlotState(ConvertedPlayer(a)) == PLAYER_SLOT_STATE_PLAYING ) ) then
            set c=c + 1
        endif
        set a=a + 1
    endloop
    return c
endfunction
//位数转换
function GS_N2S takes real i returns string
    local integer strnum= StringLength(R2S(i))
    if strnum <= 8 then
        return R2SW(i, 1, 1)
    elseif strnum <= 12 then
        return R2SW(i / 10000, 1, 1) + "万"
    else
        return R2SW(i / 100000000, 1, 1) + "亿"
    endif
endfunction
//获取地址
function GS_GetPlayerID takes player ply returns string
    return I2S(YDWEH2I(ply))
endfunction
function GS_GetUnitID takes unit u returns string
    return I2S(YDWEH2I(u))
endfunction
function GS_Str2Abil takes string str returns integer
    return YDWES2Id(str)
endfunction
function GS_addZero takes integer num,integer i returns string
    local string str= I2S(num)
    local integer n= StringLength(str)
        loop
            exitwhen n >= i
            set str="0" + str
            set n=n + 1
        endloop
    return str
endfunction

//library handySD ends
//library SUTriggerList:

    function SUTL_UnitAddEventCallBack takes integer abc,handle u,integer c,trigger t returns nothing
        local integer uhd=GetHandleId(u)
        local integer thd=GetHandleId(t)
        local integer uCode=uhd + c
        local integer index=LoadInteger(SUTriggerList__ht, uCode, skey_index)
        call SaveInteger(SUTriggerList__ht, uhd, thd + SUTriggerList__key_Count, LoadInteger(SUTriggerList__ht, uhd, thd + SUTriggerList__key_Count) + 1) //如果没有注册
        if ( not ( HaveSavedInteger(SUTriggerList__ht, GetHandleId(t), uCode) ) ) then
            call SaveTriggerHandle(SUTriggerList__ht, uCode, index, t) //绑定触发器到单位事件队列上 //记录索引在触发器t的uCode上
            call SaveInteger(SUTriggerList__ht, GetHandleId(t), uCode, index) //绑定在该事件下的触发器数量 + 1
            call SaveInteger(SUTriggerList__ht, uCode, skey_index, index + 1)
        endif
    endfunction
    function SUTL_GetUnitEventCount takes unit u,integer c returns integer
        return LoadInteger(SUTriggerList__ht, GetHandleId(u), c + SUTriggerList__key_Count)
    endfunction
    function SUTL_GetObjectEventCount takes integer abc,handle u,trigger t returns integer
        local integer thd=GetHandleId(t)
        return LoadInteger(SUTriggerList__ht, GetHandleId(u), thd + SUTriggerList__key_Count)
    endfunction
    function SUTL_ClearObejctAllEvent takes integer abc,handle u returns nothing
        local integer uhd=GetHandleId(u)
    endfunction  //StarExecuteUnitEvent
    function SUTL_UnitRemoveEventCallBack takes integer abc,handle u,integer c,trigger t returns nothing
        local integer uhd=GetHandleId(u)
        local integer thd=GetHandleId(t)
        local integer uCode=uhd + c
        local integer index=LoadInteger(SUTriggerList__ht, uCode, skey_index) - 1
        local integer i=0
        local trigger trig
        call SaveInteger(SUTriggerList__ht, uhd, thd + SUTriggerList__key_Count, LoadInteger(SUTriggerList__ht, uhd, thd + SUTriggerList__key_Count) - 1) //Print(I2S(thd)+"的计数->"+I2S(LoadInteger(ht,GetHandleId(u),thd+key_Count)));
        if ( LoadInteger(SUTriggerList__ht, uhd, thd + SUTriggerList__key_Count) > 0 ) then
            return
        endif //Print("卸载");
        set i=LoadInteger(SUTriggerList__ht, GetHandleId(t), uCode) //printsi("index =",index); //读取索引//索引减1 得到真实数组顶部 //printsi("index =",LoadInteger(ht, uCode,skey_index));
        call RemoveSavedInteger(SUTriggerList__ht, GetHandleId(t), uCode) //删除索引从t的uCode上
        if ( i != index ) then //printsi(" in index =",LoadInteger(ht, uCode,skey_index));
            set trig=LoadTriggerHandle(SUTriggerList__ht, uCode, index) //读取顶部触发器 //用顶部覆盖当前位置
            call SaveTriggerHandle(SUTriggerList__ht, uCode, i, trig) //更新索引
            call SaveInteger(SUTriggerList__ht, GetHandleId(trig), uCode, index)
        endif //printsi("index =",LoadInteger(ht, uCode,skey_index));
        call SaveInteger(SUTriggerList__ht, uCode, skey_index, index) //更新顶
        set trig=null //printsi("index =",LoadInteger(ht, uCode,skey_index));
    endfunction  // while(i<index){ //     trig = LoadTrigger(ht, uCode,i); //     if(trig == t){ //         //doEvent //     } //     i+=1; // }
    function SUTL_UnitAddEventCallBackEx takes handle a,integer b,trigger c,boolean d returns nothing
        if ( d ) then
            call SUTL_UnitAddEventCallBack(0 , a , b , c)
        else
            call SUTL_UnitRemoveEventCallBack(0 , a , b , c)
        endif
    endfunction
    function SUTriggerList__onInit takes nothing returns nothing
        set SUTL_HT=SUTriggerList__ht
    endfunction  //

