		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "佣兵战士B", null, "对啊,平常都是当天出当天回，最晚不会超过一天，可现在已经快二天没回来了", bj_TIMETYPE_SET, 2.50, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "佣兵战士C", null, "别胡说,要知道队长可是胡特,他可是我们佣兵团的二号人物,一个人可以单挑三到四只蝎子这种畜sheng。", bj_TIMETYPE_SET, 2.50, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "佣兵战士A", null, "但再怎么说..二天没回来一定是出了什么状况...", bj_TIMETYPE_SET, 2.50, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "泰勒", null, "........", bj_TIMETYPE_SET, 2.50, true)
