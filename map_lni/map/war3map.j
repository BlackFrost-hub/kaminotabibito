			loop
				set ydl_unit=FirstOfGroup(ydl_group)
				exitwhen ydl_unit == null
				call GroupRemoveUnit(ydl_group, ydl_unit)
				if ( ( IsUnitEnemy(ydl_unit, GetOwningPlayer(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x4BEB78B1))) == true ) ) then
					call UnitDamageTarget(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x50654F3C), ydl_unit, ( ( ( ( GetUnitState(ydl_unit, UNIT_STATE_MAX_LIFE) ) * ( 0.20 ) ) ) + ( ( ( GetUnitState(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x50654F3C), ConvertUnitState(0x15)) ) * ( 1.80 ) ) ) ), true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_ACID, WEAPON_TYPE_WHOKNOWS)
				else
