//library EG:

    //private:
    //public:
    function EG_GetEnumEffect takes nothing returns effect
        return EG_CallbackEffect
    endfunction  //初始化特效组
    function EG__EG_InitGroup takes integer id returns nothing
        call SaveInteger(EG__HT, id, EG__K_Count, 0)
    endfunction  //创建一个特效组
    function EG_CreateEffectGroup takes nothing returns integer
        local integer id
        set EG__EffectGroups=EG__EffectGroups + 1
        set id=EG__EffectGroups - 1
        call EG__EG_InitGroup(id) //BJDebugMsg("创建了一个特效组");
        return id //新建一个特效组
    endfunction  //移除特效�?
    function EG_RemoveGroup takes integer id returns nothing
        call FlushChildHashtable(EG__HT, id) //BJDebugMsg("移除了一个特效组");
    endfunction  //清空特效�?
    function EG_ClearGroup takes integer id returns nothing
        call SaveInteger(EG__HT, id, EG__K_Count, 0)
        call SaveEffectHandle(EG__HT, id, 0, null)
    endfunction  //遍历特效�?${组} ${目标触发器}
    function EG_ForGroup takes integer id,trigger t returns nothing
        local integer i
        local integer max
        set max=LoadInteger(EG__HT, id, EG__K_Count) //BJDebugMsg("运行-ForGroup，Max ="+I2S(max));
        set i=0
        set EG_IsOnForGroup=true
        loop
        exitwhen ( i >= max )
            set EG_CallbackEffect=LoadEffectHandle(EG__HT, id, i) //BJDebugMsg(I2S(i));
            if ( TriggerEvaluate(t) ) then
                call TriggerExecute(t)
            endif
            if ( EG_RemovedWhenForGroup ) then
                set max=max - 1
                set i=i - 1
            endif
            set EG_RemovedWhenForGroup=false
            set i=i + 1
        endloop
        set EG_IsOnForGroup=false
        set EG_CallbackEffect=null
    endfunction  //获取特效组中第一个特�?
    function EG_ForGroupSW takes integer id returns nothing
        local integer i
        local integer max
        set i=0
        set max=LoadInteger(EG__HT, id, EG__K_Count)
        set EG_IsOnForGroup=true
        loop
        exitwhen ( i >= max )
            set EG_CallbackEffect=LoadEffectHandle(EG__HT, id, i)
            if ( EG_CallbackEffect != null ) then
                call DestroyEffect(EG_CallbackEffect)
            endif
            set i=i + 1
        endloop
        set EG_IsOnForGroup=false
        set EG_CallbackEffect=null
        set EG_RemovedWhenForGroup=false
    endfunction
    function EG_GetFirstOfGroup takes integer id returns effect
        return LoadEffectHandle(EG__HT, id, 0)
    endfunction
    function EG_GetRandomOfGroup takes integer id returns effect
        local integer max=LoadInteger(EG__HT, id, EG__K_Count) - 1
        return LoadEffectHandle(EG__HT, id, GetRandomInt(0, max))
    endfunction  //判断特效是否在指定特效组�?
    function EG_IsEffectOnGroup takes effect e,integer id returns integer
        local integer i
        local integer max
        set max=LoadInteger(EG__HT, id, EG__K_Count)
        set i=0
        loop
        exitwhen ( i >= max )
            if ( e == LoadEffectHandle(EG__HT, id, i) ) then //BJDebugMsg("检查在指定特效组中");
                return i //BJDebugMsg("检�?通过 - i = :"+I2S(i));
            endif
            set i=i + 1
        endloop
        return - 1
    endfunction
    function EG_IsGroupHaveEffect takes effect e,integer id returns boolean
        return EG_IsEffectOnGroup(e , id) != - 1
    endfunction  //从特效组中移除特�?如果移除成功返回true 否则返回false
    function EG_RemoveEffectOfGroup takes effect e,integer id returns boolean
        local integer i
        local integer max
        set max=LoadInteger(EG__HT, id, EG__K_Count) - 1
        if ( max < 0 ) then
            return false
        endif
        set i=EG_IsEffectOnGroup(e , id) //BJDebugMsg("----------EG_RemoveEffectOfGroup---------");
        if ( i != - 1 ) then //BJDebugMsg("EG_RemoveEffectOfGroup - i = :"+I2S(i)); //BJDebugMsg("EG_RemoveEffectOfGroup - max = :"+I2S(max)); //表示特效在特效组�?
            if ( i != max ) then
                call SaveEffectHandle(EG__HT, id, i, LoadEffectHandle(EG__HT, id, max)) //BJDebugMsg("EG_RemoveEffectOfGroup 移除了在位置 :"+I2S(i)+"的特效并�?+I2S(max)+"处的数据填在此处");
            else
                call RemoveSavedHandle(EG__HT, id, i) //SaveEffectHandle(HT,id,i,null);
            endif //BJDebugMsg("EG_RemoveEffectOfGroup 移除了该组中的最后一个特�?);
            set max=max - 1
            call SaveInteger(EG__HT, id, EG__K_Count, max + 1)
            if ( EG_IsOnForGroup ) then
                set EG_RemovedWhenForGroup=true
            endif
            return true
        endif
        return false
    endfunction  //特效组添加特�?如果添加成功 返回true 否则返回false
    function EG_GroupAddEffect takes effect e,integer id returns boolean
        local integer i
        local integer max
        set max=LoadInteger(EG__HT, id, EG__K_Count) // EG_IsEffectOnGroup(e,id);
        set i=- 1
        if ( i == - 1 ) then
            call SaveEffectHandle(EG__HT, id, max, e)
            set max=max + 1
            call SaveInteger(EG__HT, id, EG__K_Count, max)
            return true
        endif
        return false
    endfunction
    function EG_GroupAddEffectEx takes effect e,integer id returns boolean
        local integer i
        local integer max
        set max=LoadInteger(EG__HT, id, EG__K_Count)
        call SaveEffectHandle(EG__HT, id, max, e)
        set max=max + 1
        call SaveInteger(EG__HT, id, EG__K_Count, max)
        return true
    endfunction  //为特效组a添加特效组b内所有成�?
    function EG_GroupAddGroup takes integer sid,integer id returns nothing
        local integer i
        local integer max
        set max=LoadInteger(EG__HT, id, EG__K_Count)
        set i=0
        set EG_IsOnForGroup=true
        loop
        exitwhen ( i >= max )
            set EG_CallbackEffect=LoadEffectHandle(EG__HT, id, i)
            call EG_GroupAddEffect(EG_CallbackEffect , sid)
            set i=i + 1
        endloop
        set EG_IsOnForGroup=false
        set EG_CallbackEffect=null
    endfunction  //特效组是否为�?
    function EG_IsGroupEmpty takes integer id returns boolean
        if ( LoadInteger(EG__HT, id, EG__K_Count) != 0 ) then
            return false
        endif
        return true
    endfunction  //获取特效组中特效数量
    function EG_GetCount takes integer id returns integer
        return LoadInteger(EG__HT, id, EG__K_Count)
    endfunction  //转换整数为特效组
    function EG_I2EG takes integer id returns integer
        return id
    endfunction  //转换特效组为整数
    function EG_EG2I takes integer eg returns integer
        return eg
    endfunction  //获取特效组中第i个成�?
    function EG_GetAt takes integer eg,integer i returns effect
        return LoadEffectHandle(EG__HT, eg, i)
    endfunction
    function EG_GetTable takes nothing returns hashtable
        return EG__HT
    endfunction
    function EG__onInit takes nothing returns nothing
    endfunction

