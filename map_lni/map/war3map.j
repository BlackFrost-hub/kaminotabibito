function Trig_________________________SWCFFunc003Func004003003 takes nothing returns boolean
	return ( ( GetUnitFlyHeight(GetFilterUnit()) <= 500.00 ) and ( ( IsUnitType(GetFilterUnit(), UNIT_TYPE_MECHANICAL) == false ) and ( ( IsUnitType(GetFilterUnit(), UNIT_TYPE_ANCIENT) == false ) and ( ( IsUnitEnemy(GetFilterUnit(), GetTriggerPlayer()) == true ) and ( ( IsUnitAliveBJ(GetFilterUnit()) == true ) and ( 10 >= 10 ) ) ) ) ) )
endfunction
function Trig_________________________SWCFFunc003Func005003003 takes nothing returns boolean
	return ( ( IsUnitAliveBJ(GetFilterUnit()) == true ) and ( GetUnitTypeId(GetFilterUnit()) == 'nssp' ) )
endfunction
function Trig_________________________SWCFFunc003Func006A takes nothing returns nothing
	call UnitDamageTarget(GetTriggerUnit(), GetEnumUnit(), ( ( 600.00 ) + ( ( ( 200.00 ) * ( udg_N ) ) ) ), false, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_ACID, WEAPON_TYPE_WHOKNOWS)
endfunction
function Trig_________________________SWCFFunc003Func007A takes nothing returns nothing
	call SaveLocationHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7), 0x4F9311EA, GetUnitLoc(GetEnumUnit()))
	call KillUnit(GetEnumUnit())
	call SaveUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7), 0x3763D248, CreateUnitAtLoc(GetTriggerPlayer(), 'n02X', LoadLocationHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7), 0x4F9311EA), GetRandomDirectionDeg()))
	call EC_CreateEffect("Abilities\\Spells\\Other\\HowlOfTerror\\HowlCaster.mdl" , GetLocationX(LoadLocationHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7), 0x4F9311EA)) , GetLocationY(LoadLocationHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7), 0x4F9311EA)) , 0.0 , 270.0 , 0.80 , 1.0 , 1.00)
	call RemoveLocation(LoadLocationHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7), 0x4F9311EA))
endfunction
function Trig_________________________SWCFFunc005Func004Func001Func004003003 takes nothing returns boolean
	return ( ( GetUnitFlyHeight(GetEnumUnit()) <= 500.00 ) and ( ( IsUnitType(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9), UNIT_TYPE_MECHANICAL) == false ) and ( ( IsUnitType(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9), UNIT_TYPE_ANCIENT) == false ) and ( ( IsUnitEnemy(GetFilterUnit(), LoadPlayerHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xAC95C7C6)) == true ) and ( IsUnitAliveBJ(GetFilterUnit()) == true ) ) ) ) )
endfunction
function Trig_________________________SWCFFunc005Func004Func001Func005A takes nothing returns nothing
	call UnitDamageTarget(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9), GetEnumUnit(), ( ( 50.00 ) + ( ( ( 15.00 ) * ( udg_N ) ) ) ), false, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_POISON, WEAPON_TYPE_WHOKNOWS)
endfunction
function Trig_________________________SWCFFunc005Func004T takes nothing returns nothing
	if ( ( LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xCEA5D211) >= 25.00 ) ) then
		call RemoveLocation(LoadLocationHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x1ADABF4D))
		call FlushChildHashtable(YDLOC, GetHandleId(GetExpiredTimer()))
		call DestroyTimer(GetExpiredTimer())
	else
		call PlaySoundAtPointBJ(gg_snd_CryptFiendMissileHit1, 100, LoadLocationHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x1ADABF4D), 0)
		call SaveReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xCEA5D211, ( ( LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xCEA5D211) ) + ( 1.00 ) ))
		call SaveGroupHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x0A4A1F64, YDWEGetUnitsInRangeOfLocMatchingNull(550.00 , LoadLocationHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x1ADABF4D) , Condition(function Trig_________________________SWCFFunc005Func004Func001Func004003003)))
		call ForGroupBJ(LoadGroupHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x0A4A1F64), function Trig_________________________SWCFFunc005Func004Func001Func005A)
		call DestroyGroup(LoadGroupHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x0A4A1F64))
	endif
endfunction
function Trig_________________________SWCFActions takes nothing returns nothing
 local timer ydl_timer
 local integer ydl_localvar_step= LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xCFDE6C76)
 set ydl_localvar_step=ydl_localvar_step + 3
 call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xCFDE6C76, ydl_localvar_step)
 call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7, ydl_localvar_step)
	//玩家单位死亡时
	if ( ( GetUnitTypeId(GetTriggerUnit()) == 'e02G' ) ) then
		call SaveLocationHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x8F3CED6B, GetUnitLoc(GetTriggerUnit()))
		call SaveUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x3763D248, CreateUnitAtLoc(GetTriggerPlayer(), 'n02X', LoadLocationHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x8F3CED6B), GetRandomDirectionDeg()))
		call EC_CreateEffect("Objects\\Spawnmodels\\Undead\\UDeathMedium\\UDeath.mdl" , GetUnitX(GetTriggerUnit()) , GetUnitY(GetTriggerUnit()) , 0.0 , 270.0 , 1.25 , 1.0 , 1.00)
		call SaveGroupHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x384B244D, YDWEGetUnitsInRangeOfLocMatchingNull(250.00 , LoadLocationHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x8F3CED6B) , Condition(function Trig_________________________SWCFFunc003Func004003003)))
		call SaveGroupHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x648E332D, YDWEGetUnitsInRangeOfLocMatchingNull(250.00 , LoadLocationHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x8F3CED6B) , Condition(function Trig_________________________SWCFFunc003Func005003003)))
		call ForGroupBJ(LoadGroupHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x384B244D), function Trig_________________________SWCFFunc003Func006A)
		call ForGroupBJ(LoadGroupHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x648E332D), function Trig_________________________SWCFFunc003Func007A)
		call RemoveLocation(LoadLocationHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x8F3CED6B))
		call DestroyGroup(LoadGroupHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x648E332D))
		call DestroyGroup(LoadGroupHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x384B244D))
	else
	endif
	//沙漠死亡毒爆
	if ( ( ( GetUnitTypeId(GetTriggerUnit()) == 'nsbm' ) or ( GetUnitTypeId(GetTriggerUnit()) == 'nano' ) or ( GetUnitTypeId(GetTriggerUnit()) == 'nanc' ) or ( GetUnitTypeId(GetTriggerUnit()) == 'n02V' ) ) ) then
		call SaveLocationHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x1ADABF4D, GetUnitLoc(GetTriggerUnit()))
		call EC_CreateEffect("war3mapImported\\ToxicField.mdl" , GetUnitX(GetTriggerUnit()) , GetUnitY(GetTriggerUnit()) , 50.00 , 270.0 , 1.25 , 1.0 , 3.00)
		call SaveReal(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xCEA5D211, 0.00)
		set ydl_timer=CreateTimer()
		call SavePlayerHandle(YDLOC, GetHandleId(ydl_timer), 0xAC95C7C6, GetTriggerPlayer())
		call SaveUnitHandle(YDLOC, GetHandleId(ydl_timer), 0x458B7DE9, GetTriggerUnit())
		call SaveLocationHandle(YDLOC, GetHandleId(ydl_timer), 0x1ADABF4D, LoadLocationHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x1ADABF4D))
		call SaveGroupHandle(YDLOC, GetHandleId(ydl_timer), 0x0A4A1F64, LoadGroupHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x0A4A1F64))
		call SaveReal(YDLOC, GetHandleId(ydl_timer), 0xCEA5D211, LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xCEA5D211))
		call TimerStart(ydl_timer, 0.10, true, function Trig_________________________SWCFFunc005Func004T)
	else
	endif
	call FlushChildHashtable(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step)
	set ydl_timer=null
endfunction
