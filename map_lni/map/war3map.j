		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "颅斯丁", null, "咯咯..据我几十年的观察，这片沙漠绿洲的下方其实有一片空间.", bj_TIMETYPE_SET, 5.00, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "颅斯丁", null, "我猜最有可能通往那片空间的，很有可能是位于沙漠绿洲中心的『水池』了...", bj_TIMETYPE_SET, 5.00, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "颅斯丁", null, "我想那片水池的下面连接着一处地下通道..你拿着这个，在夜深人静没有生灵的时候去使用...", bj_TIMETYPE_SET, 7.50, true)
