function Trig_____________________________zhongFunc012Func022Func012T takes nothing returns nothing
	call SetStackedSoundBJ(false, gg_snd_shengliBgm, LoadRectHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x6CC68D63))
	call SetStackedSoundBJ(false, gg_snd_shengliBgm2, LoadRectHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x6CC68D63))
	call SetStackedSoundBJ(false, gg_snd_battleBoss001, LoadRectHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x6CC68D63))
	call SetStackedSoundBJ(false, gg_snd_battleBoss2, LoadRectHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x6CC68D63))
	call SetStackedSoundBJ(false, gg_snd_battle002, LoadRectHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x6CC68D63))
	call SetStackedSoundBJ(true, gg_snd_battle002, LoadRectHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x6CC68D63))
	call SetUnitInvulnerable(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x944CCEB0), false)
	call PauseUnit(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x944CCEB0), false)
	call SetUnitOwner(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x944CCEB0), Player(PLAYER_NEUTRAL_AGGRESSIVE), true)
	call FlushChildHashtable(YDLOC, GetHandleId(GetExpiredTimer()))
	call DestroyTimer(GetExpiredTimer())
endfunction
function Trig_____________________________zhongFunc012Func022Func013T takes nothing returns nothing
 local group ydl_group
 local unit ydl_unit
	set ydl_group=CreateGroup()
	call GroupEnumUnitsInRange(ydl_group, GetUnitX(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x944CCEB0)), GetUnitY(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x944CCEB0)), 3000.00, null)
	loop
		set ydl_unit=FirstOfGroup(ydl_group)
		exitwhen ydl_unit == null
		call GroupRemoveUnit(ydl_group, ydl_unit)
		if ( ( IsUnitEnemy(ydl_unit, Player(PLAYER_NEUTRAL_AGGRESSIVE)) == true ) ) then
			call IssueTargetOrder(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x944CCEB0), "patrol", ydl_unit)
		else
		endif
		if ( ( IsUnitDeadBJ(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x944CCEB0)) == true ) ) then
			call FlushChildHashtable(YDLOC, GetHandleId(GetExpiredTimer()))
			call DestroyTimer(GetExpiredTimer())
		else
		endif
	endloop
	call DestroyGroup(ydl_group)
	set ydl_group=null
	set ydl_unit=null
endfunction
function Trig_____________________________zhongFunc012Func022Func014Func001Func010T takes nothing returns nothing
	call SetStackedSoundBJ(false, gg_snd_shengliBgm, LoadRectHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x6CC68D63))
	call FlushChildHashtable(YDLOC, GetHandleId(GetExpiredTimer()))
	call DestroyTimer(GetExpiredTimer())
endfunction
function Trig_____________________________zhongFunc012Func022Func014T takes nothing returns nothing
 local timer ydl_timer
	if ( ( ( IsUnitAliveBJ(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x944CCEB0)) == false ) or ( IsUnitDeadBJ(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x944CCEB0)) == true ) ) ) then
