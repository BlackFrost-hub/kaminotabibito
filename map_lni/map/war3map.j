//library EC ends
//library ItmeProperty:
//获取单位属性
function GS_LoadUintProperty takes unit u,integer i returns real
    if ( i == 0 ) then //生命
return GetUnitState(u, UNIT_STATE_LIFE)
    endif
    if ( i == 1 ) then //魔法
return GetUnitState(u, UNIT_STATE_MAX_MANA)
    endif
    if ( i == 2 ) then //攻击
return GetUnitState(u, ConvertUnitState(0x12))
    endif
    if ( i == 3 ) then //护甲
return GetUnitState(u, ConvertUnitState(0x20))
    endif
    if ( i == 4 ) then //攻速
return GetUnitState(u, ConvertUnitState(0x51))
    endif
    if ( i == 5 ) then //移动
return GetUnitMoveSpeed(u)
    endif
    return LoadReal(ItmeProperty__HS, GetHandleId(u), i)
endfunction
function GS_LoadUintProperty_B takes unit u,integer i returns real
    return GS_LoadUintProperty(u , i)
endfunction
//修改单位属性
function GS_Unit_Pry_change takes unit u,integer i,real r returns nothing
    local real HP
    if ( u == null or r == 0 ) then
        return
    endif
    if ( i == 0 ) then //生命
set HP=GetUnitLifePercent(u)
        call SetUnitState(u, UNIT_STATE_MAX_LIFE, GetUnitState(u, UNIT_STATE_MAX_LIFE) + ( r * ( 1 + LoadReal(ItmeProperty__HS, GetHandleId(u), 15) ) ))
        call SetUnitLifePercentBJ(u, HP)
        return
    endif
    if ( i == 1 ) then //魔法
set HP=GetUnitManaPercent(u)
        call SetUnitState(u, UNIT_STATE_MAX_MANA, GetUnitState(u, UNIT_STATE_MAX_MANA) + r)
        call SetUnitManaPercentBJ(u, HP)
        return
    endif
    if ( i == 2 ) then //攻击
call SetUnitState(u, ConvertUnitState(0x12), GetUnitState(u, ConvertUnitState(0x12)) + ( r * ( 1 + LoadReal(ItmeProperty__HS, GetHandleId(u), 16) ) ))
        return
    endif
    if ( i == 3 ) then //护甲
call SetUnitState(u, ConvertUnitState(0x20), GetUnitState(u, ConvertUnitState(0x20)) + ( r * ( 1 + LoadReal(ItmeProperty__HS, GetHandleId(u), 17) ) ))
        return
    endif
    if ( i == 4 ) then //攻速
call SetUnitState(u, ConvertUnitState(0x51), GetUnitState(u, ConvertUnitState(0x51)) + r)
        return
    endif
    if ( i == 5 ) then //移动
call SaveReal(ItmeProperty__HS, GetHandleId(u), i, LoadReal(ItmeProperty__HS, GetHandleId(u), i) + r)
        call SetUnitMoveSpeed(u, GetUnitDefaultMoveSpeed(u) * ( 1 + LoadReal(ItmeProperty__HS, GetHandleId(u), i) ))
        return
    endif
    if ( i == 13 ) then //百分比生命
set HP=GetUnitLifePercent(u)
        call SetUnitState(u, UNIT_STATE_MAX_LIFE, GetUnitState(u, UNIT_STATE_MAX_LIFE) / ( 1 + LoadReal(ItmeProperty__HS, GetHandleId(u), i) ) * ( 1 + LoadReal(ItmeProperty__HS, GetHandleId(u), i) + r ))
        call SetUnitLifePercentBJ(u, HP)
        call SaveReal(ItmeProperty__HS, GetHandleId(u), i, LoadReal(ItmeProperty__HS, GetHandleId(u), i) + r)
        return
    endif
    if ( i == 14 ) then //百分比攻击
if r < 0 then
            call SetUnitState(u, ConvertUnitState(0x12), GetUnitState(u, ConvertUnitState(0x12)) / ( 1 + LoadReal(ItmeProperty__HS, GetHandleId(u), i) ) * ( 1 + LoadReal(ItmeProperty__HS, GetHandleId(u), i) + r ))
        else
            call SetUnitState(u, ConvertUnitState(0x12), GetUnitState(u, ConvertUnitState(0x12)) / ( 1 + LoadReal(ItmeProperty__HS, GetHandleId(u), i) ) * ( 1 + LoadReal(ItmeProperty__HS, GetHandleId(u), i) + r ) + 1)
        endif
        call SaveReal(ItmeProperty__HS, GetHandleId(u), i, LoadReal(ItmeProperty__HS, GetHandleId(u), i) + r)
        return
    endif
    if ( i == 15 ) then //百分比护甲
call SetUnitState(u, ConvertUnitState(0x20), GetUnitState(u, ConvertUnitState(0x20)) / ( 1 + LoadReal(ItmeProperty__HS, GetHandleId(u), i) ) * ( 1 + LoadReal(ItmeProperty__HS, GetHandleId(u), i) + r ))
        call SaveReal(ItmeProperty__HS, GetHandleId(u), i, LoadReal(ItmeProperty__HS, GetHandleId(u), i) + r)
        return
    endif
    if ( i == 16 ) then
        call ModifyHeroStat(bj_HEROSTAT_STR, u, bj_MODIFYMETHOD_ADD, R2I(r))
        call GS_Unit_Pry_change(u , 0 , r * 5)
        return
    endif
    if ( i == 17 ) then
        call ModifyHeroStat(bj_HEROSTAT_AGI, u, bj_MODIFYMETHOD_ADD, R2I(r))
        call GS_Unit_Pry_change(u , 2 , r * 0.3)
        call GS_Unit_Pry_change(u , 3 , r)
        return
    endif
    if ( i == 18 ) then
        call ModifyHeroStat(bj_HEROSTAT_INT, u, bj_MODIFYMETHOD_ADD, R2I(r))
        call GS_Unit_Pry_change(u , 5 , r * 0.5)
        return
    endif
    call SaveReal(ItmeProperty__HS, GetHandleId(u), i, LoadReal(ItmeProperty__HS, GetHandleId(u), i) + r)
endfunction
function GS_UnitPry takes unit u,integer change,integer ptytype,real r returns nothing
    if change == 1 then
        set r=0 - r
    endif
    call GS_Unit_Pry_change(u , ptytype , r)
endfunction
function GS_UnitPryB takes unit u,integer change,integer ptytype,real r returns nothing
    call GS_UnitPry(u , change , ptytype , r)
endfunction
//初始化增加属性
function GS_UintPty_ini2 takes unit u returns nothing
    if ( IsUnitType(u, UNIT_TYPE_HERO) == false ) then
        return
    endif
    call GS_UnitPry(u , 0 , 0 , I2R(GetHeroStr(u, true)) * 5)
    call GS_UnitPry(u , 0 , 2 , I2R(GetHeroAgi(u, true)) * 1)
    call GS_UnitPry(u , 0 , 3 , I2R(GetHeroAgi(u, true)) * 0.3)
    call GS_UnitPry(u , 0 , 1 , I2R(GetHeroInt(u, true)) * 5)
endfunction
//物品单项属性
function GS_item_Property takes item itm,integer ptytype,integer change,real r returns nothing
    local unit u= LoadUnitHandle(ItmeProperty__HS, 0, GetHandleId(itm))
    if ( change == 0 ) then
        call SaveReal(ItmeProperty__HS, GetHandleId(itm), ptytype, LoadReal(ItmeProperty__HS, GetHandleId(itm), ptytype) + r)
    endif
    if ( change == 1 ) then
        call SaveReal(ItmeProperty__HS, GetHandleId(itm), ptytype, LoadReal(ItmeProperty__HS, GetHandleId(itm), ptytype) - r)
    endif
    if ( change == 2 ) then
        call SaveReal(ItmeProperty__HS, GetHandleId(itm), ptytype, r)
    endif
    call GS_UnitPry(u , change , ptytype , LoadReal(ItmeProperty__HS, GetHandleId(itm), ptytype))
    set u=null
endfunction 
function GS_item_Property_B takes item itm,integer i1,integer i2,real r returns nothing
    call GS_item_Property(itm , i1 , i2 , r)
endfunction
//*获得物品
function item_eve takes nothing returns nothing
    local item itm= GetManipulatedItem()
    local unit u= GetTriggerUnit()
    local integer a= 0
    local integer change= 0
    local real data
    if ( ( IsItemPowerup(GetManipulatedItem()) == true ) ) then
        call RemoveItem(GetManipulatedItem())
        return
    endif
    if ( ( EVENT_PLAYER_UNIT_PICKUP_ITEM == GetTriggerEventId() ) == true ) then
        set change=0
        call SaveUnitHandle(ItmeProperty__HS, 0, GetHandleId(itm), GetTriggerUnit())
    else
        set change=1
        call FlushChildHashtableBJ(0, ItmeProperty__HS)
    endif
    
    set u=null
    set itm=null
endfunction
//初始化
function item_init takes nothing returns nothing
    local trigger t1= CreateTrigger()
    local trigger t2= CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(t1, EVENT_PLAYER_UNIT_PICKUP_ITEM)
    call TriggerAddAction(t1, function item_eve)
    call TriggerRegisterAnyUnitEventBJ(t2, EVENT_PLAYER_UNIT_DROP_ITEM)
    call TriggerAddAction(t2, function item_eve)
endfunction

//library ItmeProperty ends
//library STES:

    //public:
        function STES_GetTable takes nothing returns hashtable
            return STES__HT
        endfunction  //涓鸿Е鍙戝櫒娉ㄥ唽鑷畾涔変簨浠?浜嬩欢鍚?= name
        function STES_Register takes trigger t,string name returns nothing
            local integer hash=StringHash(name)
            local integer hd=GetHandleId(t)
            local integer index=LoadInteger(STES__HT, hash, skey_index)
            local integer index2=LoadInteger(STES__HT, hd, skey_index)
            call SaveTriggerHandle(STES__HT, hash, index, t) //淇濆瓨瑙﹀彂鍣?/index += 1; //淇濆瓨璁℃暟
            call SaveInteger(STES__HT, hash, skey_index, index + 1) //瑙﹀彂鍣ㄤ笂缁戝畾瀵瑰簲浜嬩欢
            call SaveStr(STES__HT, hd, index2, name) //淇濆瓨浜嬩欢 //淇濆瓨浜嬩欢璁℃暟
            call SaveInteger(STES__HT, hd, skey_index, index2 + 1) //SaveInteger(HT,hd,skey_count,index)//淇濆瓨浜嬩欢璁℃暟
        endfunction  ///娉ㄥ唽浜嬩欢Ex
        function STES_RegisterEx takes string funcName,string eventName returns nothing
            local integer hash=StringHash(eventName)
            local integer hd=StringHash(funcName)
            local integer index=LoadInteger(STES__HT, hash, skey_indexEx)
            local integer index2=LoadInteger(STES__HT, hd, skey_indexEx)
            call SaveStr(STES__HT, hash, index, funcName) //淇濆瓨鍑芥暟鍚?/index += 1; //淇濆瓨璁℃暟
            call SaveInteger(STES__HT, hash, skey_indexEx, index + 1) //鍑芥暟涓婄粦瀹氬搴斾簨浠?
            call SaveStr(STES__HT, hd, index2, eventName) //淇濆瓨浜嬩欢 //淇濆瓨浜嬩欢璁℃暟
            call SaveInteger(STES__HT, hd, skey_indexEx, index2 + 1)
        endfunction  //鏃犲弬鐗堟湰 鏈夊弬鐗堟湰鍐欏湪dll閲岄潰
        function STES_Execute takes string name returns nothing
            local integer hash=StringHash(name)
            local integer index=LoadInteger(STES__HT, hash, skey_index)
            local integer i=0
            local trigger t
            loop
            exitwhen ( i >= index )
                set t=LoadTriggerHandle(STES__HT, hash, i) //杩愯瑙﹀彂鍣╰
                if ( TriggerEvaluate(t) ) then
                    call TriggerExecute(t)
                endif
                set i=i + 1
            endloop
            set t=null
        endfunction  //娉ㄥ唽鍗曚綅鑷畾涔変簨浠?
        function STES_GetUnitEvent takes unit u,string name returns string
            return I2S(GetHandleId(u)) + name
        endfunction  //娓呴櫎瑙﹀彂鍣ㄤ笂鐨勬寚瀹氫簨浠?
        function STES_RemoveEvent takes trigger t,string Targetname returns nothing
            local integer hd=GetHandleId(t)
            local integer index=LoadInteger(STES__HT, hd, skey_index)
            local integer i=0
            local integer a=0
            local integer b=0
            local string name
            local integer hash
            local trigger t1
            loop
            exitwhen ( i >= index )
                set name=LoadStr(STES__HT, hd, i) //濡傛灉浜嬩欢鍚嶇О 鐩稿悓 閭ｄ箞娓呴櫎瀹?
                if ( name == Targetname ) then
                    set hash=StringHash(name) //鑾峰彇璁℃暟
                    set a=LoadInteger(STES__HT, hash, skey_index)
                    loop
                    exitwhen ( b >= a )
                        set t1=LoadTriggerHandle(STES__HT, hash, b)
                        if ( t1 == t ) then
                            set a=a - 1
                            set t1=LoadTriggerHandle(STES__HT, hash, a)
                            call SaveTriggerHandle(STES__HT, hash, b, t1)
                            call SaveInteger(STES__HT, hash, skey_index, a)
                            if ( a >= b ) then
                                exitwhen true
                            endif
                        endif
                        set b=b + 1
                    endloop
                    call SaveStr(STES__HT, hd, i, LoadStr(STES__HT, hd, index))
                    set index=index - 1
                    call SaveInteger(STES__HT, hash, skey_index, index)
                    if ( i >= index ) then
                        exitwhen true
                    endif
                endif
                set i=i + 1
            endloop //FlushChildHashtable(HT,hd);
            set t1=null
        endfunction  //娓呴櫎瑙﹀彂鍣ㄤ笂鐨勬墍鏈夎嚜瀹氫箟浜嬩欢
        function STES_Remove takes trigger t returns nothing
            local integer hd=GetHandleId(t)
            local integer index=LoadInteger(STES__HT, hd, skey_index)
            local integer i=0
            local integer a=0
            local integer b=0
            local string name
            local integer hash
            local trigger t1
            loop
            exitwhen ( i >= index )
                set name=LoadStr(STES__HT, hd, i) //浜嬩欢鍚嶇О //浜嬩欢hash
                set hash=StringHash(name) //鑾峰彇璁℃暟
                set a=LoadInteger(STES__HT, hash, skey_index)
                loop
                exitwhen ( b >= a )
                    set t1=LoadTriggerHandle(STES__HT, hash, b) //閬嶅巻浜嬩欢 //鎵惧埌浜嬩欢瀵瑰簲鐨勮Е鍙戝櫒
                    if ( t1 == t ) then
                        set a=a - 1 //瑙﹀彂鍣ㄦ暟閲?1 //灏嗛《閮ㄧ殑瑙﹀彂鍣ㄦ媺杩囨潵)
                        set t1=LoadTriggerHandle(STES__HT, hash, a) //save
                        call SaveTriggerHandle(STES__HT, hash, b, t1) //save index
                        call SaveInteger(STES__HT, hash, skey_index, a)
                        if ( a >= b ) then
                            exitwhen true
                        endif
                    endif
                    set b=b + 1
                endloop
                set i=i + 1
            endloop
            call FlushChildHashtable(STES__HT, hd)
            set t1=null
        endfunction  // StarWE GUI compatibility wrappers.
        function STES_GetCurrentLocalIndex takes trigger whichTrigger returns integer
            local integer step=LoadInteger(YDLOC, GetHandleId(whichTrigger), 0xCFDE6C76)
            if ( step <= 0 ) then
                return GetHandleId(whichTrigger)
            endif
            return GetHandleId(whichTrigger) * step
        endfunction
        function STES_GetNextLocalIndex takes trigger whichTrigger returns integer
            local integer step=LoadInteger(YDLOC, GetHandleId(whichTrigger), 0xCFDE6C76) + 3
            return GetHandleId(whichTrigger) * step
        endfunction
        function STES_CopyReturnLocalU takes integer sourceIndex,integer targetIndex returns nothing
            if ( sourceIndex == 0 or targetIndex == 0 ) then
                return
            endif
            if ( HaveSavedReal(YDLOC, sourceIndex, 0xC303079D) ) then
                call SaveReal(YDLOC, targetIndex, 0xC303079D, LoadReal(YDLOC, sourceIndex, 0xC303079D))
            endif
            if ( HaveSavedInteger(YDLOC, sourceIndex, 0xC303079D) ) then
                call SaveInteger(YDLOC, targetIndex, 0xC303079D, LoadInteger(YDLOC, sourceIndex, 0xC303079D))
            endif
            if ( HaveSavedBoolean(YDLOC, sourceIndex, 0xC303079D) ) then
                call SaveBoolean(YDLOC, targetIndex, 0xC303079D, LoadBoolean(YDLOC, sourceIndex, 0xC303079D))
            endif
            if ( HaveSavedString(YDLOC, sourceIndex, 0xC303079D) ) then
                call SaveStr(YDLOC, targetIndex, 0xC303079D, LoadStr(YDLOC, sourceIndex, 0xC303079D))
            endif
        endfunction
        function StarExecuteEvent takes string name,boolean checkCondition returns nothing
            call STES_Execute(name)
        endfunction
        function StarExecuteEventII takes string name,boolean checkCondition returns nothing
            local integer hash=StringHash(name)
            local integer index=LoadInteger(STES__HT, hash, skey_index)
            local integer i=0
            local integer parentIndex=STES_GetCurrentLocalIndex(GetTriggeringTrigger())
            local integer childIndex
            local trigger t
            loop
            exitwhen ( i >= index )
                set t=LoadTriggerHandle(STES__HT, hash, i)
                set childIndex=STES_GetNextLocalIndex(t)
                call SaveInteger(YDLOC, GetHandleId(t), SKey_PIndex, parentIndex)
                call STES_CopyReturnLocalU(parentIndex , childIndex)
                if ( TriggerEvaluate(t) ) then
                    call TriggerExecute(t)
                endif
                set i=i + 1
            endloop
            set t=null
        endfunction
        function StarExecuteTriggerExReturn takes nothing returns nothing
            local integer parentIndex=LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), SKey_PIndex)
            local integer childIndex=STES_GetCurrentLocalIndex(GetTriggeringTrigger())
            call STES_CopyReturnLocalU(childIndex , parentIndex)
        endfunction
        function STES__onInit takes nothing returns nothing
            set STES_HT=STES__HT
        endfunction

//library STES ends
//library StarCharge:

    function CheakLoc takes real x,real y returns boolean
        return ( x >= GetRectMinX(bj_mapInitialPlayableArea) ) and ( y >= GetRectMinY(bj_mapInitialPlayableArea) ) and ( x <= GetRectMaxX(bj_mapInitialPlayableArea) ) and ( y <= GetRectMaxY(bj_mapInitialPlayableArea) )
    endfunction  //排除死亡的单位
    function SCD1Filter takes nothing returns boolean
        return ( GetUnitState(GetFilterUnit(), UNIT_STATE_LIFE) > 0.405 )
    endfunction  //排除死亡的单位/友军
    function SCD1Filter2 takes nothing returns boolean
        return ( GetUnitState(GetFilterUnit(), UNIT_STATE_LIFE) > 0.405 and ( ( not ( IsUnitInGroup(GetFilterUnit(), SC_tempg2) ) ) ) )
    endfunction  //停止单位所有冲锋
    function StarCharge_StopCharge takes unit u returns nothing
        local integer i=0
        loop
        exitwhen ( i >= s__StarCharge__SCData1_index )
            if ( s__StarCharge__SCData1_u[SCData1List[i]] == u ) then
                set s__StarCharge__SCData1_disd[SCData1List[i]]=s__StarCharge__SCData1_disd[SCData1List[i]] + 999999
            endif
            set i=i + 1
        endloop
    endfunction  //结束本次冲锋
    function SCD_StopCharge takes nothing returns nothing
        set SCD_Exit=true //Print("stop");
    endfunction
    function SCD1ForGroupFunc takes nothing returns nothing
        local integer scd=s__StarCharge__SCData1_tempSCData1
        if ( not SCD_Exit ) then
            set Star_TargetUnit=GetEnumUnit() //Print("call"); // Print("Star_TriggerUnit->"+GetUnitName(Star_TriggerUnit));
            if ( IsUnitEnemy(Star_TargetUnit, GetOwningPlayer(Star_TriggerUnit)) ) then // Print("Star_TargetUnit->"+GetUnitName(Star_TargetUnit));
                if ( s__StarCharge__SCData1_onlyOne[scd] ) then // Print("GetEnumUnit->"+GetUnitName(Star_TargetUnit));
                    call GroupAddUnit(SC_tempg2, GetEnumUnit())
                endif
                if ( TriggerEvaluate(s__StarCharge__SCData1_callback[scd]) ) then
                    call TriggerExecute(s__StarCharge__SCData1_callback[scd])
                endif
            endif
            set Star_TargetUnit=null
        else
        endif //Print("skip");
    endfunction
        function s__StarCharge__SCData1_create takes unit u,real s,real d,real dis,real r,boolean b,trigger t returns integer
            local integer scd=s__StarCharge__SCData1__allocate()
            set s__StarCharge__SCData1_dis[scd]=dis
            set s__StarCharge__SCData1_disd[scd]=0
            set s__StarCharge__SCData1_u[scd]=u
            set s__StarCharge__SCData1_speed[scd]=s
            set s__StarCharge__SCData1_d[scd]=d
            set s__StarCharge__SCData1_range[scd]=r
            set s__StarCharge__SCData1_b[scd]=b
            set s__StarCharge__SCData1_onlyOne[scd]=false
            set s__StarCharge__SCData1_pg[scd]=null //BJDebugMsg("d="+R2S(scd.d));
            set s__StarCharge__SCData1_callback[scd]=t
            set s__StarCharge__SCData1_index=s__StarCharge__SCData1_index + 1
            return scd
        endfunction
        function s__StarCharge__SCData1_enum takes integer this,real x,real y returns nothing
            set s__StarCharge__SCData1_tempSCData1=this //选取单位
            set SC_tempg2=null
            if ( s__StarCharge__SCData1_onlyOne[this] ) then
                set SC_tempg2=s__StarCharge__SCData1_pg[this] //LoadGroupHandle(StarBaseHT,GetHandleId(this.u),Key_One);
                call GroupEnumUnitsInRange(s__StarCharge__SCData1_tempg, x, y, s__StarCharge__SCData1_range[this], Condition(function SCD1Filter2))
            else
                call GroupEnumUnitsInRange(s__StarCharge__SCData1_tempg, x, y, s__StarCharge__SCData1_range[this], Condition(function SCD1Filter))
            endif
            set SCD1EventID=1
            set Star_TriggerUnit=s__StarCharge__SCData1_u[this]
            call ForGroup(s__StarCharge__SCData1_tempg, function SCD1ForGroupFunc)
            call GroupClear(s__StarCharge__SCData1_tempg)
            if ( SCD_Exit ) then
                set s__StarCharge__SCData1_disd[this]=s__StarCharge__SCData1_disd[this] + 999999
                set SCD_Exit=false
            endif
        endfunction
        function s__StarCharge__SCData1_move takes integer this returns nothing
            local real x
            local real y
            set x=GetUnitX(s__StarCharge__SCData1_u[this]) + CosBJ(s__StarCharge__SCData1_d[this]) * s__StarCharge__SCData1_speed[this]
            set y=GetUnitY(s__StarCharge__SCData1_u[this]) + SinBJ(s__StarCharge__SCData1_d[this]) * s__StarCharge__SCData1_speed[this]
            call SetUnitFacing(s__StarCharge__SCData1_u[this], s__StarCharge__SCData1_d[this])
            if ( CheakLoc(x , y) ) then
                set Star_TriggerUnit=s__StarCharge__SCData1_u[this] // //调用回调 //SCD1EventID = 4;//在移动时发生
                if ( TriggerEvaluate(s__StarCharge__SCData1_callback[this]) ) then
                    call TriggerExecute(s__StarCharge__SCData1_callback[this])
                endif
                call SetUnitX(s__StarCharge__SCData1_u[this], x)
                call SetUnitY(s__StarCharge__SCData1_u[this], y)
                set s__StarCharge__SCData1_disd[this]=s__StarCharge__SCData1_disd[this] + s__StarCharge__SCData1_speed[this]
                if ( s__StarCharge__SCData1_callback[this] != null ) then
                    call s__StarCharge__SCData1_enum(this,x , y)
                endif
            else
                set s__StarCharge__SCData1_disd[this]=s__StarCharge__SCData1_disd[this] + 999999
            endif //BJDebugMsg(R2S(this.dis)+"||"+R2S(this.disd));
        endfunction  //检查墙体碰撞
        function s__StarCharge__SCData1_move_b takes integer this returns nothing
            local real x=0
            local real y=0
            local real s1=0
            local integer i=0
            local integer max=0
            if ( s__StarCharge__SCData1_speed[this] > 31 ) then
                set max=R2I(s__StarCharge__SCData1_speed[this] / 31)
                loop
                exitwhen ( i >= max )
                    set x=GetUnitX(s__StarCharge__SCData1_u[this]) + CosBJ(s__StarCharge__SCData1_d[this]) * 31
                    set y=GetUnitY(s__StarCharge__SCData1_u[this]) + SinBJ(s__StarCharge__SCData1_d[this]) * 31
                    if ( X_IsTerrainWalkable(x , y) ) then
                        if ( TriggerEvaluate(s__StarCharge__SCData1_callback[this]) ) then //SCD1EventID = 4;//在移动时发生
                            call TriggerExecute(s__StarCharge__SCData1_callback[this])
                        endif
                        call SetUnitX(s__StarCharge__SCData1_u[this], x)
                        call SetUnitY(s__StarCharge__SCData1_u[this], y)
                        set s__StarCharge__SCData1_disd[this]=s__StarCharge__SCData1_disd[this] + 31
                        if ( s__StarCharge__SCData1_callback[this] != null ) then
                            call s__StarCharge__SCData1_enum(this,x , y)
                        endif
                    else
                        set s__StarCharge__SCData1_disd[this]=s__StarCharge__SCData1_disd[this] + 999999
                        exitwhen true
                    endif
                    set i=i + 1
                endloop
                if ( s__StarCharge__SCData1_dis[this] < s__StarCharge__SCData1_disd[this] ) then
                    set s1=s__Math_Modulo(s__StarCharge__SCData1_speed[this] , 31)
                    set x=GetUnitX(s__StarCharge__SCData1_u[this]) + CosBJ(s__StarCharge__SCData1_d[this]) * s1
                    set y=GetUnitY(s__StarCharge__SCData1_u[this]) + SinBJ(s__StarCharge__SCData1_d[this]) * s1
                    if ( X_IsTerrainWalkable(x , y) ) then
                        if ( TriggerEvaluate(s__StarCharge__SCData1_callback[this]) ) then //SCD1EventID = 4;//在移动时发生
                            call TriggerExecute(s__StarCharge__SCData1_callback[this])
                        endif
                        call SetUnitX(s__StarCharge__SCData1_u[this], x)
                        call SetUnitY(s__StarCharge__SCData1_u[this], y)
                        set s__StarCharge__SCData1_disd[this]=s__StarCharge__SCData1_disd[this] + s1
                        if ( s__StarCharge__SCData1_callback[this] != null ) then
                            call s__StarCharge__SCData1_enum(this,x , y)
                        endif
                    else
                        set s__StarCharge__SCData1_disd[this]=s__StarCharge__SCData1_disd[this] + 999999
                    endif
                endif
            else
                set x=GetUnitX(s__StarCharge__SCData1_u[this]) + CosBJ(s__StarCharge__SCData1_d[this]) * s__StarCharge__SCData1_speed[this]
                set y=GetUnitY(s__StarCharge__SCData1_u[this]) + SinBJ(s__StarCharge__SCData1_d[this]) * s__StarCharge__SCData1_speed[this]
                if ( X_IsTerrainWalkable(x , y) ) then
                    if ( TriggerEvaluate(s__StarCharge__SCData1_callback[this]) ) then //SCD1EventID = 4;//在移动时发生
                        call TriggerExecute(s__StarCharge__SCData1_callback[this])
                    endif
                    call SetUnitX(s__StarCharge__SCData1_u[this], x)
                    call SetUnitY(s__StarCharge__SCData1_u[this], y)
                    set s__StarCharge__SCData1_disd[this]=s__StarCharge__SCData1_disd[this] + s__StarCharge__SCData1_speed[this]
                    if ( s__StarCharge__SCData1_callback[this] != null ) then
                        call s__StarCharge__SCData1_enum(this,x , y)
                    endif
                else
                    set s__StarCharge__SCData1_disd[this]=s__StarCharge__SCData1_disd[this] + 999999
                endif
            endif
        endfunction
        function s__StarCharge__SCData1_onDestroy takes integer this returns nothing
            call DestroyGroup(s__StarCharge__SCData1_pg[this]) // DestroyGroup(LoadGroupHandle(StarBaseHT,GetHandleId(this.u),Key_One)); // RemoveSavedHandle(StarBaseHT,GetHandleId(this.u),Key_One);
            set s__StarCharge__SCData1_u[this]=null
            set s__StarCharge__SCData1_callback[this]=null
        endfunction

//Generated destructor of StarCharge__SCData1
function s__StarCharge__SCData1_deallocate takes integer this returns nothing
    if this==null then
        return
    elseif (si__StarCharge__SCData1_V[this]!=-1) then
        return
    endif
    call s__StarCharge__SCData1_onDestroy(this)
    set si__StarCharge__SCData1_V[this]=si__StarCharge__SCData1_F
    set si__StarCharge__SCData1_F=this
endfunction
    function SCD1TE takes nothing returns nothing
        local integer i=0
        local integer scd
        if ( s__StarCharge__SCData1_index == 0 ) then
            set s__StarCharge__SCData1_Paused=true
            call PauseTimer(GetExpiredTimer())
        endif
        loop
        exitwhen ( i >= s__StarCharge__SCData1_index )
            set scd_now_id=i
            set scd=SCData1List[i]
            if ( s__StarCharge__SCData1_b[scd] ) then
                call s__StarCharge__SCData1_move_b(scd) //BJDebugMsg("2");
            else
                call s__StarCharge__SCData1_move(scd) //BJDebugMsg("3");
            endif
            if ( s__StarCharge__SCData1_disd[scd] >= s__StarCharge__SCData1_dis[scd] ) then
                set SCData1List[i]=SCData1List[s__StarCharge__SCData1_index] //BJDebugMsg("4");
                if ( s__StarCharge__SCData1_callback[scd] != null ) then
                    set Star_TriggerUnit=s__StarCharge__SCData1_u[scd]
                    set Star_TargetUnit=null
                    if ( s__StarCharge__SCData1_disd[scd] > 99999 ) then
                        set SCD1EventID=2
                    else
                        set SCD1EventID=3
                    endif
                    if ( TriggerEvaluate(s__StarCharge__SCData1_callback[scd]) ) then
                        call TriggerExecute(s__StarCharge__SCData1_callback[scd])
                    endif
                endif //BJDebugMsg("摧毁了一个成员");
                set s__StarCharge__SCData1_index=s__StarCharge__SCData1_index - 1
                call s__StarCharge__SCData1_deallocate(scd)
                set i=i - 1
            endif
            set i=i + 1
        endloop
    endfunction
    function StarChargeBase takes unit u,real d,real dis,real time,real r,boolean b,trigger t returns nothing
        local integer scd
        local real s
        set s=dis / ( time / 0.02 )
        set scd=s__StarCharge__SCData1_create(u , s , d , dis , r , b , t)
        set SCData1List[s__StarCharge__SCData1_index - 1]=scd
        set s__StarCharge__SCData1_onlyOne[scd]=true
        if ( s__StarCharge__SCData1_Paused ) then
            call TimerStart(s__StarCharge__SCData1_STimer, 0.02, true, function SCD1TE)
        endif
    endfunction  //命令单位向目标点发起冲锋，冲锋角度为，冲锋距离为，冲锋时间为，碰撞体积 ,检查墙体碰撞->,禁止重复伤害->,回调触发器为->
    function StarChargeII takes unit u,real d,real dis,real time,real r,boolean b,boolean b2,trigger t returns nothing
        local integer scd
        local real s
        set s=dis / ( time / 0.02 )
        set scd=s__StarCharge__SCData1_create(u , s , d , dis , r , b , t)
        if ( b2 ) then
            set s__StarCharge__SCData1_pg[scd]=CreateGroup() // if(!HaveSavedHandle(StarBaseHT,GetHandleId(u),Key_One){SaveGroupHandle(StarBaseHT,GetHandleId(u),Key_One,CreateGroup());}
            set s__StarCharge__SCData1_onlyOne[scd]=true
        endif
        set SCData1List[s__StarCharge__SCData1_index - 1]=scd
        if ( s__StarCharge__SCData1_Paused ) then
            call TimerStart(s__StarCharge__SCData1_STimer, 0.02, true, function SCD1TE)
        endif
    endfunction  //命令单位向目标点发起冲锋，冲锋角度为，冲锋距离为，冲锋时间为，碰撞体积 ,检查墙体碰撞->,禁止重复伤害->,回调触发器为->
    function StarChargeEX takes unit u,real d,real dis,real time,real r,boolean b,boolean b2,trigger t returns nothing
        local integer scd
        local real s
        set s=dis / ( time / 0.02 ) // scd = SCData1List[SCData1.index].create(u,s,d,dis,r,b,t);
        set scd=s__StarCharge__SCData1_create(u , s , d , dis , r , b , t)
        if ( b2 ) then
            set s__StarCharge__SCData1_pg[scd]=CreateGroup() // if(!HaveSavedHandle(StarBaseHT,GetHandleId(u),Key_One){SaveGroupHandle(StarBaseHT,GetHandleId(u),Key_One,CreateGroup());}
            set s__StarCharge__SCData1_onlyOne[scd]=true
        endif
        set SCData1List[s__StarCharge__SCData1_index - 1]=scd
        if ( s__StarCharge__SCData1_Paused ) then
            call TimerStart(s__StarCharge__SCData1_STimer, 0.02, true, function SCD1TE)
        endif
    endfunction  //命令单位向目标点发起冲锋，冲锋角度为，冲锋距离为，冲锋时间为，碰撞体积 ,伤害值 , 检查墙体碰撞-> 
    function StarChargeI takes unit u,real d,real dis,real time,real r,real value,boolean b returns nothing
        local integer scd
        local real s
        set s=dis / ( time / 0.02 )
        set scd=s__StarCharge__SCData1_create(u , s , d , dis , r , b , StarCharge__basetrig)
        set s__StarCharge__SCData1_pg[scd]=CreateGroup() // if(!HaveSavedHandle(StarBaseHT,GetHandleId(u),Key_One))
        if ( not ( HaveSavedReal(StarBaseHT, GetHandleId(u), StarCharge__K_Value) ) ) then // { //     SaveGroupHandle(StarBaseHT,GetHandleId(u),Key_One,CreateGroup()); // }
            call SaveReal(StarBaseHT, GetHandleId(u), StarCharge__K_Value, value)
        endif
        set s__StarCharge__SCData1_onlyOne[scd]=true
        set SCData1List[s__StarCharge__SCData1_index - 1]=scd
        if ( s__StarCharge__SCData1_Paused ) then
            call TimerStart(s__StarCharge__SCData1_STimer, 0.02, true, function SCD1TE)
        endif
    endfunction  //获取触发的事件ID
    function StarCharge_GetEventId takes nothing returns integer
        return SCD1EventID
    endfunction
        function StarCharge__anon__0 takes nothing returns nothing
            local real v=LoadReal(StarBaseHT, GetHandleId(Star_GetTriggerUnit()), StarCharge__K_Value)
            if ( IsUnitEnemy(Star_GetTargetUnit(), GetOwningPlayer(Star_GetTriggerUnit())) ) then
                call UnitDamageTarget(Star_GetTriggerUnit(), Star_GetTargetUnit(), v, false, false, ATTACK_TYPE_MELEE, DAMAGE_TYPE_UNIVERSAL, WEAPON_TYPE_WHOKNOWS)
            endif
        endfunction
    function StarCharge__onInit takes nothing returns nothing
        set s__StarCharge__SCData1_STimer=CreateTimer()
        call TimerStart(s__StarCharge__SCData1_STimer, 0.02, true, function SCD1TE)
        call TriggerAddAction(StarCharge__basetrig, function StarCharge__anon__0)
    endfunction
