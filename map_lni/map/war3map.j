					call CreateNUnitsAtLocFacingLocBJ(1, 'n02R', Player(PLAYER_NEUTRAL_AGGRESSIVE), LoadLocationHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x2A829619), LoadLocationHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x5B0D7524))
				else
