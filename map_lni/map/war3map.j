	if ( ( ( IsUnitAliveBJ(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x55213576)) == false ) or ( LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xCEA5D211) >= 25.00 ) ) ) then
		call RemoveUnit(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x55213576))
