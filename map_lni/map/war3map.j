	return ( ( GetUnitFlyHeight(GetFilterUnit()) <= 600.00 ) and ( ( IsUnitType(GetFilterUnit(), UNIT_TYPE_MECHANICAL) == false ) and ( ( IsUnitType(GetFilterUnit(), UNIT_TYPE_ANCIENT) == false ) and ( ( IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(GetEventDamageSource())) == true ) and ( ( IsUnitAliveBJ(GetFilterUnit()) == true ) and ( 10 >= 10 ) ) ) ) ) )
