//library StarJump:
        function s__StarJump__SJumper_create takes unit u,real d,real mz,real dis,real time,trigger cb returns integer
            local integer this=s__StarJump__SJumper__allocate()
            set s__StarJump__SJumper_u[this]=u //fac
            set s__StarJump__SJumper_d[this]=d //MaxHeight
            set s__StarJump__SJumper_maxheight[this]=mz //s=v/t
            set s__StarJump__SJumper_speed[this]=dis / ( time / 0.02 ) //callback
            set s__StarJump__SJumper_callback[this]=cb //disd
            set s__StarJump__SJumper_dis[this]=dis //清除路程记录
            set s__StarJump__SJumper_disd[this]=0
            set s__StarJump__SJumper_lz[this]=0 //使单位可以设置高度
            call UnitAddAbility(u, 'Amrf')
            call UnitRemoveAbility(u, 'Amrf') //压栈
            set s__StarJump__SJumper_sjlist[s__StarJump__SJumper_count]=this
            set s__StarJump__SJumper_count=s__StarJump__SJumper_count + 1 //运行计时器;
            call sc__StarJump__SJumper_Start() //Print("Created");
            return this
        endfunction
        function s__StarJump__SJumper_move takes integer this,integer i returns nothing
            local real t=s__StarJump__SJumper_disd[this] / s__StarJump__SJumper_dis[this]
            local real x
            local real y
            local real z
            set s__StarJump__SJumper_now=i
            set x=Star_CoordinateX(GetUnitX(s__StarJump__SJumper_u[this]) + CosBJ(s__StarJump__SJumper_d[this]) * s__StarJump__SJumper_speed[this])
            set y=Star_CoordinateY(GetUnitY(s__StarJump__SJumper_u[this]) + SinBJ(s__StarJump__SJumper_d[this]) * s__StarJump__SJumper_speed[this])
            set z=s__Math_Parabola(t , s__StarJump__SJumper_maxheight[this] , 0)
            if ( GetTerrainType(x, y) != 'cOc1' ) then //非深渊即可跳跃
                call SetUnitX(s__StarJump__SJumper_u[this], x)
                call SetUnitY(s__StarJump__SJumper_u[this], y)
                call SetUnitFlyHeight(s__StarJump__SJumper_u[this], GetUnitFlyHeight(s__StarJump__SJumper_u[this]) - s__StarJump__SJumper_lz[this], 0)
                call SetUnitFlyHeight(s__StarJump__SJumper_u[this], GetUnitFlyHeight(s__StarJump__SJumper_u[this]) + z, 0)
                set s__StarJump__SJumper_lz[this]=z
            endif //到距离移除
            set s__StarJump__SJumper_disd[this]=s__StarJump__SJumper_disd[this] + s__StarJump__SJumper_speed[this]
            if ( s__StarJump__SJumper_disd[this] >= s__StarJump__SJumper_dis[this] ) then
                set Star_TriggerUnit=s__StarJump__SJumper_u[this] //Print("disd = "+R2S(this.disd) + "dis = " + R2S(dis)); //调用回调
                if ( TriggerEvaluate(s__StarJump__SJumper_callback[this]) ) then
                    call TriggerExecute(s__StarJump__SJumper_callback[this])
                endif //退栈
                call sc__StarJump__SJumper_deallocate(this)
            endif
        endfunction  //
        function s__StarJump__SJumper_onDestroy takes integer this returns nothing
            call SetUnitFlyHeight(s__StarJump__SJumper_u[this], GetUnitFlyHeight(s__StarJump__SJumper_u[this]) - s__StarJump__SJumper_lz[this], 0) //出栈
            if ( s__StarJump__SJumper_now != s__StarJump__SJumper_count - 1 ) then
                set s__StarJump__SJumper_skip=true
                set s__StarJump__SJumper_sjlist[s__StarJump__SJumper_now]=s__StarJump__SJumper_sjlist[s__StarJump__SJumper_count - 1]
            endif
            set s__StarJump__SJumper_count=s__StarJump__SJumper_count - 1
        endfunction  //开启中心计时器

//Generated destructor of StarJump__SJumper
function s__StarJump__SJumper_deallocate takes integer this returns nothing
    if this==null then
        return
    elseif (si__StarJump__SJumper_V[this]!=-1) then
        return
    endif
    call s__StarJump__SJumper_onDestroy(this)
    set si__StarJump__SJumper_V[this]=si__StarJump__SJumper_F
    set si__StarJump__SJumper_F=this
endfunction
            function s__StarJump__SJumper_anon__0 takes nothing returns nothing
                local integer i=0
                local integer sj
                loop
                exitwhen ( i >= s__StarJump__SJumper_count )
                    set s__StarJump__SJumper_now=i
                    set sj=s__StarJump__SJumper_sjlist[i]
                    call s__StarJump__SJumper_move(sj,i)
                    if ( s__StarJump__SJumper_skip ) then
                        set s__StarJump__SJumper_skip=false
                        set i=i - 1
                    endif
                    set i=i + 1
                endloop //没有子成员,停止计时器
                if ( s__StarJump__SJumper_count == 0 ) then
                    call sc__StarJump__SJumper_Stop()
                endif
            endfunction
        function s__StarJump__SJumper_Start takes nothing returns nothing
            if ( not ( s__StarJump__SJumper_IsRun ) ) then
                call TimerStart(s__StarJump__SJumper_Timer, 0.02, true, function s__StarJump__SJumper_anon__0)
                set s__StarJump__SJumper_IsRun=true
            endif
        endfunction  //停止中心计时器
        function s__StarJump__SJumper_Stop takes nothing returns nothing
            if ( s__StarJump__SJumper_IsRun ) then
                call PauseTimer(s__StarJump__SJumper_Timer) //Print("Stoped");
                set s__StarJump__SJumper_IsRun=false
            endif
        endfunction
        function s__StarJump__SJumper_onInit takes nothing returns nothing
            set s__StarJump__SJumper_Timer=CreateTimer()
        endfunction
    function SJ_JumpBase takes unit u,real d,real mz,real dis,real time,trigger cb returns nothing
        if ( GetUnitDefaultMoveSpeed(u) > 0.1 ) then
            call s__StarJump__SJumper_create(u , d , mz , dis , time , cb)
        endif
    endfunction

