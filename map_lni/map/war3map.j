		call SetUnitX(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9), ( GetUnitX(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9)) + ( 25.00 * CosBJ(LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xB9A583B8)) ) ))
		call SetUnitY(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9), ( GetUnitY(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9)) + ( 25.00 * SinBJ(LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xB9A583B8)) ) ))
		set ydl_group=CreateGroup()
		call GroupEnumUnitsInRange(ydl_group, GetUnitX(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9)), GetUnitY(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9)), 200.00, null)
		loop
			set ydl_unit=FirstOfGroup(ydl_group)
			exitwhen ydl_unit == null
			call GroupRemoveUnit(ydl_group, ydl_unit)
			if ( ( SU_IsUnitInvincible(ydl_unit) == false ) and ( IsUnitDeadBJ(ydl_unit) == false ) and ( IsUnitEnemy(ydl_unit, GetOwningPlayer(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9))) == true ) and ( IsUnitInGroup(ydl_unit, LoadGroupHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x748E7A0E)) == false ) ) then
				call GroupAddUnit(LoadGroupHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x748E7A0E), ydl_unit)
				call UnitDamageTarget(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9), ydl_unit, ( ( GetUnitState(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9), ConvertUnitState(0x15)) ) * ( 2.00 ) ), true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_NORMAL, WEAPON_TYPE_METAL_HEAVY_SLICE)
			else
			endif
		endloop
		call DestroyGroup(ydl_group)
		call EC_CreateEffect("war3mapImported\\[AKE]war3AKE.com - 4290201822266721885371863.mdl" , ( ( GetUnitX(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9)) ) + ( ( ( 100.00 ) * ( CosBJ(LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xB9A583B8)) ) ) ) ) , ( ( GetUnitY(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9)) ) + ( ( ( 100.00 ) * ( SinBJ(LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xB9A583B8)) ) ) ) ) , 0.00 , ( LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xB9A583B8) ) , 3.50 , 1.00 , 2.00)
		call ForGroupBJ(LoadGroupHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x748E7A0E), function Trig_DMboss____________02Func004Func014Func003Func004Func001Func011A)
	endif
	set ydl_group=null
	set ydl_unit=null
	set ydl_timer=null
endfunction
function Trig_DMboss____________02Func004Func014Func003T takes nothing returns nothing
 local timer ydl_timer
	call GS_Suspend(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9) , 0.50)
	call SetUnitAnimationByIndex(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9), 3)
	call SetUnitTimeScale(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9), 2.80)
	set ydl_timer=CreateTimer()
	call SaveUnitHandle(YDLOC, GetHandleId(ydl_timer), 0x458B7DE9, LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9))
	call SaveReal(YDLOC, GetHandleId(ydl_timer), 0xCEA5D211, LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xCEA5D211))
	call SaveGroupHandle(YDLOC, GetHandleId(ydl_timer), 0x748E7A0E, LoadGroupHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x748E7A0E))
	call SaveReal(YDLOC, GetHandleId(ydl_timer), 0xB9A583B8, LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xB9A583B8))
	call TimerStart(ydl_timer, 0.02, true, function Trig_DMboss____________02Func004Func014Func003Func004T)
	call FlushChildHashtable(YDLOC, GetHandleId(GetExpiredTimer()))
	call DestroyTimer(GetExpiredTimer())
	set ydl_timer=null
endfunction
function Trig_DMboss____________02Func004Func016Func003Func017T takes nothing returns nothing
 local group ydl_group
 local unit ydl_unit
	if ( ( IsUnitDeadBJ(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x5B7DF14B)) == true ) ) then
		call FlushChildHashtable(YDLOC, GetHandleId(GetExpiredTimer()))
		call DestroyTimer(GetExpiredTimer())
	else
		set ydl_group=CreateGroup()
		call GroupEnumUnitsInRange(ydl_group, GetUnitX(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x5B7DF14B)), GetUnitY(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x5B7DF14B)), 120.00, null)
		loop
			set ydl_unit=FirstOfGroup(ydl_group)
			exitwhen ydl_unit == null
			call GroupRemoveUnit(ydl_group, ydl_unit)
			if ( ( IsUnitInGroup(ydl_unit, LoadGroupHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x7B2D08E8)) == false ) and ( SU_IsUnitInvincible(ydl_unit) == false ) and ( IsUnitDeadBJ(ydl_unit) == false ) and ( IsUnitEnemy(ydl_unit, GetOwningPlayer(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xC303079D))) == true ) ) then
				call SaveUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15, ydl_unit)
				if ( ( GetUnitMoveSpeed(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15)) <= 250.00 ) ) then
					call SFB_setBuff(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15) , 0 , 1.00)
				else
					call SFB_setSlow(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15) , 0.00 , 0.50 , 1.50)
				endif
				call UnitDamageTarget(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xC303079D), ydl_unit, ( ( GetUnitState(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xC303079D), ConvertUnitState(0x15)) ) * ( 1.30 ) ), false, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_ENHANCED, WEAPON_TYPE_METAL_HEAVY_SLICE)
				call GroupAddUnit(LoadGroupHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x7B2D08E8), ydl_unit)
			else
			endif
		endloop
		call DestroyGroup(ydl_group)
	endif
	set ydl_group=null
	set ydl_unit=null
endfunction
function Trig_DMboss____________02Actions takes nothing returns nothing
 local timer ydl_timer
 local group ydl_group
 local unit ydl_unit
 local integer ydul_A
 local integer ydul_B
 local integer ydl_localvar_step= LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xCFDE6C76)
 set ydl_localvar_step=ydl_localvar_step + 3
 call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xCFDE6C76, ydl_localvar_step)
 call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7, ydl_localvar_step)
	//1
	if ( ( GetUnitTypeId(GetTriggerUnit()) == 'E002' ) ) then
		if ( ( ( EXExecuteScript("(require'jass.slk').ability[" + I2S(GetSpellAbilityId()) + "].race") ) == "orc" ) ) then
			call SaveReal(YDHT, GetHandleId(GetTriggerUnit()), 0x7AFB5C07, ( ( LoadReal(YDHT, GetHandleId(GetTriggerUnit()), 0x7AFB5C07) ) + ( 1.00 ) ))
			set ydl_timer=CreateTimer()
			call SaveUnitHandle(YDLOC, GetHandleId(ydl_timer), 0x458B7DE9, GetTriggerUnit())
			call TimerStart(ydl_timer, 2.00, false, function Trig_DMboss____________02Func002Func001Func002T)
		else
		endif
		if ( ( YDWEGetUnitAbilityDataString(GetTriggerUnit() , GetSpellAbilityId() , 1 , 216) == "1" ) ) then
			call SaveUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xD84480C3, GetSpellTargetUnit())
			call SaveReal(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xB9A583B8, YDWEAngleBetweenUnits(GetTriggerUnit() , LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xD84480C3)))
			call SaveLocationHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xB0FD2C34, GS_PolarProjectionBJ(GetUnitLoc(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xD84480C3)) , 100.00 , ( ( LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xB9A583B8) ) + ( 180.00 ) )))
			call SaveUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xA5ABED14, CreateUnit(GetOwningPlayer(GetTriggerUnit()), 'e03N', GetUnitX(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xD84480C3)), GetUnitY(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xD84480C3)), 0))
			call SaveEffectHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x31838DC3, AddSpecialEffect("Abilities\\Spells\\Other\\Charm\\CharmTarget.mdl", GetUnitX(GetTriggerUnit()), GetUnitY(GetTriggerUnit())))
			call EXSetEffectSpeed(LoadEffectHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x31838DC3), 4.25)
			call YDWETimerDestroyEffect(1.00 , LoadEffectHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x31838DC3))
			set ydl_timer=CreateTimer()
			call SaveLocationHandle(YDLOC, GetHandleId(ydl_timer), 0xB0FD2C34, LoadLocationHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xB0FD2C34))
			call SaveUnitHandle(YDLOC, GetHandleId(ydl_timer), 0x458B7DE9, GetTriggerUnit())
			call SaveUnitHandle(YDLOC, GetHandleId(ydl_timer), 0xA5ABED14, LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xA5ABED14))
			call TimerStart(ydl_timer, 0.01, false, function Trig_DMboss____________02Func002Func002Func009T)
		else
		endif
	else
	endif
	if ( ( GetUnitTypeId(GetTriggerUnit()) == 'E07X' ) ) then
		if ( ( YDWEGetUnitAbilityDataString(GetTriggerUnit() , GetSpellAbilityId() , 1 , 216) == "1" ) ) then
			call SaveReal(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x0BFBB67B, ( ( GetUnitState(GetTriggerUnit(), ConvertUnitState(0x15)) ) * ( 2.30 ) ))
			call SaveUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xD84480C3, GetSpellTargetUnit())
			call SaveReal(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xB9A583B8, GetUnitFacing(GetTriggerUnit()))
			set ydl_timer=CreateTimer()
			call SaveLocationHandle(YDLOC, GetHandleId(ydl_timer), 0x9CD60476, LoadLocationHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x9CD60476))
			call SaveLocationHandle(YDLOC, GetHandleId(ydl_timer), 0xB0FD2C34, LoadLocationHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xB0FD2C34))
			call SaveUnitHandle(YDLOC, GetHandleId(ydl_timer), 0x458B7DE9, GetTriggerUnit())
			call SaveReal(YDLOC, GetHandleId(ydl_timer), 0xB259B269, LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xB259B269))
			call SaveReal(YDLOC, GetHandleId(ydl_timer), 0x0BFBB67B, LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x0BFBB67B))
			call SaveReal(YDLOC, GetHandleId(ydl_timer), 0xCEA5D211, LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xCEA5D211))
			call SaveEffectHandle(YDLOC, GetHandleId(ydl_timer), 0xFE88D7FF, LoadEffectHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xFE88D7FF))
			call SaveDestructableHandle(YDLOC, GetHandleId(ydl_timer), 0xC66BA262, LoadDestructableHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xC66BA262))
			call SaveReal(YDLOC, GetHandleId(ydl_timer), 0xB9A583B8, LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xB9A583B8))
			call SaveUnitHandle(YDLOC, GetHandleId(ydl_timer), 0xB3542E15, LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xB3542E15))
			call SaveGroupHandle(YDLOC, GetHandleId(ydl_timer), 0x56E86570, LoadGroupHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x56E86570))
			call TimerStart(ydl_timer, 0.01, false, function Trig_DMboss____________02Func003Func001Func004T)
		else
		endif
		if ( ( YDWEGetUnitAbilityDataString(GetTriggerUnit() , GetSpellAbilityId() , 1 , 216) == "2" ) ) then
			call GS_Suspend(GetTriggerUnit() , 3.50)
			call ResetUnitAnimation(GetTriggerUnit())
			set ydl_timer=CreateTimer()
			call SaveUnitHandle(YDLOC, GetHandleId(ydl_timer), 0x458B7DE9, GetTriggerUnit())
			call SaveReal(YDLOC, GetHandleId(ydl_timer), 0xA99320FA, LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xA99320FA))
			call SaveReal(YDLOC, GetHandleId(ydl_timer), 0xFDF65382, LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xFDF65382))
			call SaveGroupHandle(YDLOC, GetHandleId(ydl_timer), 0x7B2D08E8, LoadGroupHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x7B2D08E8))
			call SaveReal(YDLOC, GetHandleId(ydl_timer), 0x0BFBB67B, LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x0BFBB67B))
			call SaveReal(YDLOC, GetHandleId(ydl_timer), 0xCEA5D211, LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xCEA5D211))
			call SaveReal(YDLOC, GetHandleId(ydl_timer), 0xA3932093, LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xA3932093))
			call SaveUnitHandle(YDLOC, GetHandleId(ydl_timer), 0xD84480C3, LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xD84480C3))
			call SaveReal(YDLOC, GetHandleId(ydl_timer), 0xB9A583B8, LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xB9A583B8))
			call TimerStart(ydl_timer, 0.05, false, function Trig_DMboss____________02Func003Func002Func003T)
		else
		endif
		if ( ( YDWEGetUnitAbilityDataString(GetTriggerUnit() , GetSpellAbilityId() , 1 , 216) == "3" ) ) then
			//获取XY轴，来源在（技能提示）触发内
			call SaveReal(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x6FE77C3A, LoadReal(YDHT, GetHandleId(GetTriggerUnit()), 0x60E214B9))
			call SaveReal(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x1C8173B7, LoadReal(YDHT, GetHandleId(GetTriggerUnit()), 0x3471D943))
			call SaveDestructableHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xC66BA262, CreateDestructableZ('B00O', LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x6FE77C3A), LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x1C8173B7), 75.00, LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xB9A583B8), 2.20, 1))
			call SaveEffectHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xFE88D7FF, AddSpecialEffect("Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl", LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x6FE77C3A), LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x1C8173B7)))
			call SaveReal(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x0BFBB67B, ( ( ( ( GetUnitState(GetTriggerUnit(), ConvertUnitState(0x15)) ) * ( 2.00 ) ) ) + ( 0.00 ) ))
			call EXSetEffectSize(LoadEffectHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xFE88D7FF), 1.00)
			call YDWETimerDestroyEffect(1.20 , LoadEffectHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xFE88D7FF))
			set ydl_timer=CreateTimer()
			call SaveDestructableHandle(YDLOC, GetHandleId(ydl_timer), 0xC66BA262, LoadDestructableHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xC66BA262))
			call TimerStart(ydl_timer, 30.00, false, function Trig_DMboss____________02Func003Func003Func009T)
			set ydl_group=CreateGroup()
			call GroupEnumUnitsInRange(ydl_group, LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x6FE77C3A), LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x1C8173B7), 375.00, null)
			loop
				set ydl_unit=FirstOfGroup(ydl_group)
				exitwhen ydl_unit == null
				call GroupRemoveUnit(ydl_group, ydl_unit)
				if ( ( IsUnitType(ydl_unit, UNIT_TYPE_ANCIENT) == false ) and ( IsUnitType(ydl_unit, UNIT_TYPE_MECHANICAL) == false ) and ( IsUnitEnemy(ydl_unit, GetOwningPlayer(GetTriggerUnit())) == true ) and ( IsUnitAliveBJ(ydl_unit) == true ) ) then
					call UnitDamageTarget(GetTriggerUnit(), ydl_unit, ( ( LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x0BFBB67B) ) + ( ( ( GetUnitState(ydl_unit, UNIT_STATE_MAX_LIFE) ) * ( 0.12 ) ) ) ), false, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_ACID, WEAPON_TYPE_WHOKNOWS)
					call SFB_setBuff(ydl_unit , 0 , 1.25)
					call SaveUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xB3542E15, ydl_unit)
					call YDWEFlyEnable(ydl_unit)
					call SaveReal(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xB259B269, 0.00)
					set ydl_timer=CreateTimer()
					call SaveReal(YDLOC, GetHandleId(ydl_timer), 0xB259B269, LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xB259B269))
					call SaveUnitHandle(YDLOC, GetHandleId(ydl_timer), 0xB3542E15, LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xB3542E15))
					call TimerStart(ydl_timer, 0.02, true, function Trig_DMboss____________02Func003Func003Func010Func001Func006T)
				else
				endif
			endloop
			call DestroyGroup(ydl_group)
		else
		endif
		if ( ( YDWEGetUnitAbilityDataString(GetTriggerUnit() , GetSpellAbilityId() , 1 , 216) == "4" ) ) then
			call PlaySoundOnUnitBJ(gg_snd_tenshi10, 100, GetTriggerUnit())
			//基础设置
			call SaveReal(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x0BFBB67B, ( ( GetUnitState(GetTriggerUnit(), ConvertUnitState(0x15)) ) * ( 1.40 ) ))
			call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xECB0B24C, EG_CreateEffectGroup())
			//创建预警
			set ydul_A=1
			loop
				exitwhen ydul_A > 6
				set ydul_B=1
				loop
					exitwhen ydul_B > 10
					call SaveLocationHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x9CD60476, GS_PolarProjectionBJ(GetUnitLoc(GetTriggerUnit()) , ( ( GetRandomReal(100.00, 180.00) ) * ( I2R(ydul_B) ) ) , ( ( LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xB9A583B8) ) + ( ( ( ( GetRandomReal(45.00, 60.00) ) ) * ( I2R(ydul_A) ) ) ) )))
					call SaveEffectHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x66F185C5, EC_CreateEffect("war3mapImported\\mr.war3_ring.mdl" , GetLocationX(LoadLocationHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x9CD60476)) , GetLocationY(LoadLocationHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x9CD60476)) , 50.00 , 0.00 , 0.80 , 0.70 , 0.50))
					call EXSetEffectSpeed(LoadEffectHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x62C50DE6), 1.00)
					call EG_GroupAddEffect(LoadEffectHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x66F185C5) , LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xECB0B24C))
					set ydul_B=ydul_B + 1
				endloop
				set ydul_A=ydul_A + 1
			endloop
			//1秒后造成伤害
			set ydl_timer=CreateTimer()
			call SaveUnitHandle(YDLOC, GetHandleId(ydl_timer), 0x458B7DE9, GetTriggerUnit())
			call SaveReal(YDLOC, GetHandleId(ydl_timer), 0xB259B269, LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xB259B269))
			call SaveReal(YDLOC, GetHandleId(ydl_timer), 0xA99320FA, LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xA99320FA))
			call SaveReal(YDLOC, GetHandleId(ydl_timer), 0xFDF65382, LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xFDF65382))
			call SaveInteger(YDLOC, GetHandleId(ydl_timer), 0xECB0B24C, LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xECB0B24C))
			call SaveReal(YDLOC, GetHandleId(ydl_timer), 0x0BFBB67B, LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x0BFBB67B))
			call SaveUnitHandle(YDLOC, GetHandleId(ydl_timer), 0xB3542E15, LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xB3542E15))
			call SaveGroupHandle(YDLOC, GetHandleId(ydl_timer), 0x56E86570, LoadGroupHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x56E86570))
			call TimerStart(ydl_timer, 1.00, false, function Trig_DMboss____________02Func003Func004Func008T)
		else
		endif
		if ( ( YDWEGetUnitAbilityDataString(GetTriggerUnit() , GetSpellAbilityId() , 1 , 216) == "5" ) ) then
			call SetUnitInvulnerable(GetTriggerUnit(), true)
			call PauseUnit(GetTriggerUnit(), true)
			call YDWEFlyEnable(GetTriggerUnit())
			call SaveReal(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xCEA5D211, 0.00)
			//会跳跃5-8次
			call SaveReal(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x49094E40, GetRandomReal(5.00, 8.50))
			set ydl_timer=CreateTimer()
