	call SaveInteger(YDHT, GetHandleId(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x944CCEB0)), 0x5F3881C7, R2I(( 5.00 + ( 3.00 * udg_N ) )))
