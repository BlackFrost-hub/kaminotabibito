		call UnitAddAbility(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x310EFEF8), 'A0KH')
		call UnitAddAbility(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x310EFEF8), 'S00H')
	else
	endif
	if ( ( GetUnitTypeId(GetTriggerUnit()) == 'E08G' ) ) then
		call SaveGroupHandle(YDHT, GetHandleId(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x310EFEF8)), 0xC305F4B7, CreateGroup())
	else
	endif
	call FlushChildHashtable(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step)
endfunction
