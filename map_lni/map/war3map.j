    call SetStackedSoundBJ(false, gg_snd_shengliBgm, LoadRectHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x6CC68D63))
    call SetStackedSoundBJ(false, gg_snd_shengliBgm2, LoadRectHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x6CC68D63))
    call SetStackedSoundBJ(false, gg_snd_battl03, LoadRectHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x6CC68D63))
    call SetStackedSoundBJ(false, gg_snd_battleBoss001, LoadRectHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x6CC68D63))
    call SetStackedSoundBJ(false, gg_snd_battleBoss2, LoadRectHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x6CC68D63))
    call SetStackedSoundBJ(false, gg_snd_battleBoss3, LoadRectHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x6CC68D63))
    call SetStackedSoundBJ(false, gg_snd_battlejieluboss01, LoadRectHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x6CC68D63))
    // 部分Bossbgm不一样
    if ( ( ( GetUnitTypeId(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x944CCEB0)) == 'n05B' ) or ( GetUnitTypeId(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x944CCEB0)) == 'n05C' ) ) ) then
        call SetStackedSoundBJ(true, gg_snd_battle002, LoadRectHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x6CC68D63))
    else
        if ( ( GetUnitTypeId(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x944CCEB0)) == 'N05D' ) ) then
            call SetStackedSoundBJ(true, gg_snd_battl03, LoadRectHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x6CC68D63))
        else
            if ( ( GetUnitTypeId(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x944CCEB0)) == 'n001' ) ) then
                call SetStackedSoundBJ(true, gg_snd_battle01, LoadRectHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x6CC68D63))
            else
            endif
        endif
    endif
    call SetUnitInvulnerable(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x944CCEB0), false)
