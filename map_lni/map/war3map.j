    function EC_IsInShiled takes real x,real y,player p returns unit
        local integer i2=0
        loop
        exitwhen ( i2 >= EC_ShiledIndex )
            if ( not ( IsUnitAlly(EC_ShiledArray[i2], p) ) ) then //友方护盾则不检查
                if ( X_GDBC(x , y , GetUnitX(EC_ShiledArray[i2]) , GetUnitY(EC_ShiledArray[i2])) <= EC_ShiledSize[i2] ) then
                    return EC_ShiledArray[i2] //返回持有这个护盾的单位
                endif
            endif
            set i2=i2 + 1
        endloop
        return null
    endfunction  //正在冲锋的特效
    function EC_GetChargingEffect takes nothing returns effect
        return EC_TargetEffect
    endfunction  //设置特效飞行模式
    function EC_SetFlyMode takes integer effid,integer modeid,real maxHeight returns nothing
        if ( modeid > 1 ) then
            set modeid=0
        endif
        set EC_FlyMode[effid]=modeid
        set EC_Height[effid]=maxHeight
        if ( EC_Mode[effid] == 0 ) then
            set EC_steepsMax[effid]=R2I(EC_Distance[effid] / EC_Speed[effid]) //BJDebugMsg("Max=" + I2S(EC_steepsMax[effid]));
        else
            set EC_steepsMax[effid]=R2I(EC_TimeMax[effid] / 0.02)
        endif
        set EC_steeps[effid]=0
    endfunction  //被冲锋到的单位
