		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "颅斯丁", null, "咯咯咯....看来你找到了，快点拿来吧", bj_TIMETYPE_SET, 3.50, true)
		call YDWETimerDestroyEffect(1.50 , AddSpecialEffectLoc("Abilities\\Spells\\Undead\\DarkRitual\\DarkRitualTarget.mdl", LoadLocationHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xC8A0E463)))
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "颅斯丁", null, ".....", bj_TIMETYPE_SET, 1.50, true)
		call YDWETimerDestroyEffect(1.50 , AddSpecialEffectLoc("Abilities\\Spells\\Undead\\DarkRitual\\DarkRitualTarget.mdl", LoadLocationHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xC8A0E463)))
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "颅斯丁", null, ".....", bj_TIMETYPE_SET, 1.50, true)
