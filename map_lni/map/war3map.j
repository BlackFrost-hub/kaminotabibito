function Trig_DMboss____________02Func004Func010Func001Func003Conditions takes nothing returns nothing
 local timer ydl_timer
	if ( ( ( EVENT_GAME_TIMER_EXPIRED == GetTriggerEventId() ) == true ) ) then
		if ( ( UnitHasBuffBJ(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xC303079D), 'B004') == false ) ) then
