function Trig___________________PTCFActions takes nothing returns nothing
 local timer ydl_timer
 local group ydl_group
 local unit ydl_unit
 local integer ydl_localvar_step= LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xCFDE6C76)
 set ydl_localvar_step=ydl_localvar_step + 3
 call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xCFDE6C76, ydl_localvar_step)
 call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7, ydl_localvar_step)
	if ( ( GetUnitTypeId(GetEventDamageSource()) == 'n02Y' ) ) then
		call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xAF616D00, GetRandomInt(1, 9))
		if ( ( LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xAF616D00) == 1 ) ) then
			call SaveLocationHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xC8A0E463, GetUnitLoc(GetTriggerUnit()))
			call SaveUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xE48FA13E, CreateUnitAtLoc(Player(PLAYER_NEUTRAL_AGGRESSIVE), 'e02K', LoadLocationHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xC8A0E463), 0))
			call EC_CreateEffect("Abilities\\Spells\\Other\\Incinerate\\FireLordDeathExplode.mdl" , GetUnitX(GetTriggerUnit()) , GetUnitY(GetTriggerUnit()) , 0.00 , 270.0 , 1.0 , 1.0 , 2.00)
			call SaveGroupHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x384B244D, YDWEGetUnitsInRangeOfLocMatchingNull(175.00 , LoadLocationHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xC8A0E463) , Condition(function Trig___________________PTCFFunc003Func002Func004003003)))
			call ForGroupBJ(LoadGroupHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x384B244D), function Trig___________________PTCFFunc003Func002Func005A)
			call RemoveLocation(LoadLocationHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xC8A0E463))
			call DestroyGroup(LoadGroupHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x384B244D))
		else
		endif
	else
	endif
	if ( ( YDWEIsEventAttackDamage() == true ) and ( GetUnitAbilityLevel(GetEventDamageSource(), 'A08T') >= 1 ) and ( YDWEIsEventDamageType(DAMAGE_TYPE_NORMAL) == true ) ) then
		call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xAF616D00, GetRandomInt(0, 100))
		call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xAF616D00, ( ( LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xAF616D00) ) - ( LoadInteger(YDHT, GetHandleId(GetOwningPlayer(GetTriggerUnit())), 0xE396BB5C) ) ))
		if ( ( LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xAF616D00) >= 90 ) ) then
			call SFB_setBuff(GetTriggerUnit() , 0 , 0.40)
			call UnitDamageTarget(GetEventDamageSource(), GetTriggerUnit(), ( ( GetUnitState(GetEventDamageSource(), ConvertUnitState(0x15)) ) * ( 0.50 ) ), false, false, ATTACK_TYPE_MELEE, DAMAGE_TYPE_NORMAL, WEAPON_TYPE_WHOKNOWS)
		else
		endif
	else
	endif
	if ( ( YDWEIsEventAttackDamage() == true ) and ( GetUnitTypeId(GetEventDamageSource()) == 'N03O' ) and ( YDWEIsEventDamageType(DAMAGE_TYPE_NORMAL) == true ) ) then
		if ( ( 10 >= 10 ) ) then
			call PauseUnit(GetEventDamageSource(), true)
			call SetUnitAnimationByIndex(GetEventDamageSource(), 4)
			call SetUnitTimeScale(GetEventDamageSource(), 1.75)
			set ydl_timer=CreateTimer()
			call SaveUnitHandle(YDLOC, GetHandleId(ydl_timer), 0xF047C7C9, GetEventDamageSource())
			call SaveUnitHandle(YDLOC, GetHandleId(ydl_timer), 0x458B7DE9, GetTriggerUnit())
			call SaveGroupHandle(YDLOC, GetHandleId(ydl_timer), 0x384B244D, LoadGroupHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x384B244D))
			call SaveLocationHandle(YDLOC, GetHandleId(ydl_timer), 0xC8A0E463, LoadLocationHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xC8A0E463))
			call TimerStart(ydl_timer, 0.65, false, function Trig___________________PTCFFunc005Func001Func005T)
		else
		endif
	else
	endif
	call SaveReal(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x6197EAD9, GetRandomReal(0.01, 1))
	if ( ( LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x6197EAD9) <= 0.66 ) and ( GetUnitTypeId(GetEventDamageSource()) == 'n03T' ) ) then
		call SaveUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x051F7596, GetTriggerUnit())
		call SaveUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x089E63E0, CreateUnit(GetOwningPlayer(GetEventDamageSource()), 'e00D', GetUnitX(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x051F7596)), GetUnitY(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x051F7596)), 0))
		call UnitAddAbility(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x089E63E0), 'A0BE')
		call IssuePointOrder(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x089E63E0), "flamestrike", GetUnitX(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x051F7596)), GetUnitY(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x051F7596)))
	else
	endif
	if ( ( UnitHasBuffBJ(GetEventDamageSource(), 'Bblo') == true ) and ( GetUnitTypeId(GetEventDamageSource()) == 'n01G' ) ) then
		call SaveReal(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xB9A583B8, YDWEAngleBetweenUnits(GetEventDamageSource() , GetTriggerUnit()))
		call UnitRemoveAbility(GetEventDamageSource(), 'Bblo')
		call StarChargeI(GetTriggerUnit() , LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xB9A583B8) , 300.00 , 0.50 , 10.00 , 0.00 , true)
		call SaveUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x089E63E0, CreateUnit(GetOwningPlayer(GetTriggerUnit()), LoadInteger(YDHT, StringHash("辅助马甲"), 0x86D47FF3), GetUnitX(GetTriggerUnit()), GetUnitY(GetTriggerUnit()), 0))
		call UnitAddAbility(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x089E63E0), LoadInteger(YDHT, StringHash("眩晕"), 0x2AAC512D))
		call YDWESetUnitAbilityDataReal(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x089E63E0) , LoadInteger(YDHT, StringHash("眩晕"), 0x2AAC512D) , 1 , 102 , 2.00)
		call YDWESetUnitAbilityDataReal(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x089E63E0) , LoadInteger(YDHT, StringHash("眩晕"), 0x2AAC512D) , 1 , 103 , 2.00)
		call IssueTargetOrder(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x089E63E0), "thunderbolt", GetTriggerUnit())
	else
	endif
	if ( ( ( GetUnitTypeId(GetEventDamageSource()) == 'N05D' ) or ( GetUnitTypeId(GetEventDamageSource()) == 'n05B' ) ) ) then
		call SaveUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x911D5DC2, GetEventDamageSource())
		call SaveUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x944CCEB0, GetEventDamageSource())
		set ydl_group=CreateGroup()
		call GroupEnumUnitsInRange(ydl_group, GetUnitX(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x911D5DC2)), GetUnitY(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x911D5DC2)), 2000.00, null)
		loop
			set ydl_unit=FirstOfGroup(ydl_group)
			exitwhen ydl_unit == null
			call GroupRemoveUnit(ydl_group, ydl_unit)
			if ( ( IsUnitInGroup(ydl_unit, LoadGroupHandle(YDHT, StringHash("玩家英雄"), 0x0A4A1F64)) == true ) and ( IsUnitEnemy(ydl_unit, GetOwningPlayer(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x911D5DC2))) == true ) and ( IsUnitType(ydl_unit, UNIT_TYPE_ANCIENT) == false ) and ( IsUnitAliveBJ(ydl_unit) == true ) ) then
				call SaveUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xB3542E15, ydl_unit)
				call SaveReal(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xA99320FA, GetUnitX(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xB3542E15)))
				call SaveReal(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xFDF65382, GetUnitY(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xB3542E15)))
				exitwhen true
			else
			endif
		endloop
		call DestroyGroup(ydl_group)
		//等待上一个动作选取
		set ydl_timer=CreateTimer()
		call SaveUnitHandle(YDLOC, GetHandleId(ydl_timer), 0x944CCEB0, LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x944CCEB0))
		call SaveUnitHandle(YDLOC, GetHandleId(ydl_timer), 0x911D5DC2, LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x911D5DC2))
		call SaveUnitHandle(YDLOC, GetHandleId(ydl_timer), 0xF047C7C9, GetEventDamageSource())
		call SaveUnitHandle(YDLOC, GetHandleId(ydl_timer), 0x458B7DE9, GetTriggerUnit())
		call SaveReal(YDLOC, GetHandleId(ydl_timer), 0xA99320FA, LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xA99320FA))
		call SaveReal(YDLOC, GetHandleId(ydl_timer), 0xFDF65382, LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xFDF65382))
		call SaveEffectHandle(YDLOC, GetHandleId(ydl_timer), 0x66F185C5, LoadEffectHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x66F185C5))
		call SaveInteger(YDLOC, GetHandleId(ydl_timer), 0xAF616D00, LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xAF616D00))
		call TimerStart(ydl_timer, 0.01, false, function Trig___________________PTCFFunc009Func006T)
	else
	endif
	call FlushChildHashtable(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step)
	set ydl_timer=null
	set ydl_group=null
	set ydl_unit=null
endfunction
