//library ClientRegister ends
//library EC:

    //private:
    //public:
    function EC_DestroyEffect takes effect e returns nothing
        call EXSetEffectXY(e, 99999, 99999)
        call DestroyEffect(e)
    endfunction
    function EC_A1 takes real a,real b,real c,real t returns real
        return Pow(( 1 - t ), 2) * a + 2 * t * ( 1 - t ) * b + Pow(t, 2) * c
    endfunction
    function EC_GetHeight takes integer steeps,integer steepsMax,real heightMax,real fly returns real
        local real dheig=1.0 / steepsMax
        return ( - ( 2 * I2R(steeps) * dheig - 1 ) * ( 2 * I2R(steeps) * dheig - 1 ) + 1 ) * heightMax + fly
    endfunction  //获取坐标位置的Z轴高度
    function EC_GetPointZ takes real x,real y returns real
        if ( Star_Location == null ) then
            set Star_Location=Location(x, y)
        else
            call MoveLocation(Star_Location, x, y)
        endif
        return GetLocationZ(Star_Location)
    endfunction
    function EC__EC_TimerEvent takes nothing returns nothing
        local unit u
        local real x
        local real y
        local real z
        local integer tempi=0
        local integer tempmax=0
        local real tempr=0
        local integer index
        local integer i2=0
        set EC_Running=true
        if ( EC_Index > 0 ) then
            set index=EC_Index - 1 //BJDebugMsg("============================");
            set EC__i=0
            loop //BJDebugMsg("index = " + I2S(index)+"EC_Index = " + I2S(EC_Index)); //BJDebugMsg("===========END==========="); //BJDebugMsg("data at 0 = " + R2S(EC_D[0]));
            exitwhen ( EC__i > index )
                call SaveInteger(EC_HT, GetHandleId(EC_EffectList[EC__i]), 1000, EC__i)
                set EC_Exit=false
                set EC_ShiledExit=false
                set tempi=0
                if ( EC_Speed[EC__i] == 0 ) then
                    set EC_Exit=true
                endif
                if ( EC_Speed[EC__i] > 31 ) then
                    set tempmax=R2I(EC_Speed[EC__i] / 31) //Print("tempmax = " +I2S(tempmax));
                    set tempr=ModuloReal(EC_Speed[EC__i], 31) ////Print("tempr = " +R2S(tempr));
                else //BJDebugMsg("tempmax = "+I2S(tempmax) + "tempi = "+I2S(tempi));
                    set tempmax=0
                    set tempr=EC_Speed[EC__i]
                endif //移动特效 默认的移动模式
                if ( EC_MoveMode[EC__i] == 0 ) then
                    loop //特效移动部分
                    exitwhen ( tempi >= tempmax )
                        set tempi=tempi + 1 ////Print("tempi = " +I2S(tempi));
                        if ( not EC_Exit ) then
                            set x=EXGetEffectX(EC_EffectList[EC__i]) + CosBJ(EC_D[EC__i]) * 31 //移动特效 //Print("tempmax = "+I2S(tempmax) + "tempi = "+I2S(tempi));
                            set y=EXGetEffectY(EC_EffectList[EC__i]) + SinBJ(EC_D[EC__i]) * 31
                            if ( EC_PZ[EC__i] ) then
                                if ( not ( X_IsTerrainWalkable(x , y) ) ) then //Print("PZ");
                                    if ( EC_PZTrig[EC__i] != null ) then
                                        set EC_TargetEffect=EC_EffectList[EC__i] //Print("PZCALL");
                                        set EC_EventID=3
                                        call TriggerExecute(EC_PZTrig[EC__i])
                                    else
                                        set EC_Exit=true //Print("Exit"); //停止移动，运行结束触发器
                                        set tempi=tempmax
                                    endif
                                else
                                    call EXSetEffectXY(EC_EffectList[EC__i], x, y) //Print("Move");
                                endif
                            else
                                call EXSetEffectXY(EC_EffectList[EC__i], x, y) //Print("Move");
                            endif //Print("CheakPoint8");
                            if ( EC_FlyMode[EC__i] != 2 ) then //特效高度设置 // =2为自定义 即 不设置
                                set z=EC_GetPointZ(x , y) //Print("EC_FlyMode"); //保持特效相对地面高度
                                if ( EC_FlyMode[EC__i] == 0 or EC_Height[EC__i] == 0 ) then
                                    call EXSetEffectZ(EC_EffectList[EC__i], z + EC_Height[EC__i]) //Print("CheakPoint6");
                                elseif ( EC_FlyMode[EC__i] == 1 ) then
                                    set EC_steeps[EC__i]=EC_steeps[EC__i] + 1 //Print("CheakPoint7"); //抛物线
                                    if ( EC_DisD[EC__i] > 0 ) then
                                        set EC__ec_temp_t=EC_DisD[EC__i] / EC_Distance[EC__i]
                                    else
                                        set EC__ec_temp_t=1
                                    endif
                                    call EXSetEffectZ(EC_EffectList[EC__i], s__Math_Parabola(EC__ec_temp_t , EC_Height[EC__i] , z)) //BJDebugMsg(R2S(EXGetEffectZ(EC_EffectList[i])));
                                endif
                            endif ////Print("CheakPoint3");
                            set i2=0 //Print("CheakPoint2");
                            loop //检查护盾 //BJDebugMsg("i2 =:"+I2S(i2)+",Index = "+I2S(EC_ShiledIndex));
                            exitwhen ( i2 >= EC_ShiledIndex )
                                if ( not ( IsUnitAlly(EC_ShiledArray[i2], EC_OwnningPlayer[EC__i]) ) ) then //Print("EC_ShiledIndex"); //BJDebugMsg("i2 =:"+I2S(i2)+",Index = "+I2S(EC_ShiledIndex)); //友方护盾则不检查
                                    if ( s__Math_LocInRange(x , y , GetUnitX(EC_ShiledArray[i2]) , GetUnitY(EC_ShiledArray[i2]) , EC_ShiledSize[i2]) ) then //检查弹幕与护盾的距离 小于 护盾尺寸 //特效x,y 与 护盾单位 x y 的距离  <= size
                                        set EC_TargetEffect=EC_EffectList[EC__i] //BJDebugMsg("触碰到护盾了！"); //弹幕处于护盾范围内 运行护盾触碰弹幕回调 //触发特效 //触发特效所有者
                                        set EC_EffectOwnningPlayer=EC_OwnningPlayer[EC__i] //触发护盾
                                        set EC_TargetUnit=EC_ShiledArray[i2] //事件ID
                                        set EC_EventID=4 //运行回调
                                        call TriggerExecute(EC_ShiledCallbackTrig[i2])
                                    endif
                                endif
                                set i2=i2 + 1
                            endloop //Print("CheakPoint");
                            if ( EC_DamageTrig[EC__i] != null ) then //弹幕触碰部分
                                if ( not EC_Exit ) then //Print("Damage");
                                    set EC_Hitable=true //选取单位做动作
                                    call GroupEnumUnitsInRange(EC__g, x, y, EC_Range[EC__i], null)
                                    set u=FirstOfGroup(EC__g)
                                    loop
                                    exitwhen ( u == null )
                                        set EC_TargetUnit=u //触发单位 //触发特效
                                        set EC_TargetEffect=EC_EffectList[EC__i]
                                        set EC_EffectOwnningPlayer=EC_OwnningPlayer[EC__i]
                                        set EC_EventID=0
                                        call TriggerExecute(EC_DamageTrig[EC__i]) //如果结束本次冲锋，则直接结束
                                        if ( EC_Exit or ( not EC_Hitable ) ) then
                                            exitwhen true
                                        endif
                                        call GroupRemoveUnit(EC__g, u)
                                        set u=FirstOfGroup(EC__g)
                                    endloop
                                    call GroupClear(EC__g)
                                endif
                            endif //Print("CheakPoint4");
                            if ( EC_Mode[EC__i] != 0 ) then
                                set EC_DisD[EC__i]=EC_DisD[EC__i] + 31 //Print("Disd++");
                            else
                                set EC_DisD[EC__i]=EC_DisD[EC__i] + 31 //Print("Disd++"); //距离退出模式
                            endif //Print("CheakPoint5");
                            if ( ( EC_Mode[EC__i] != 0 and EC_Timed[EC__i] >= EC_TimeMax[EC__i] ) or ( EC_Mode[EC__i] == 0 and EC_DisD[EC__i] >= EC_Distance[EC__i] ) ) then
                                set EC_Exit=true //Print("Exit");
                            endif
                        endif
                    endloop
                endif //Print("=========== " +R2S(tempr));
                if ( not EC_Exit ) then
                    if ( EC_MoveMode[EC__i] == 0 ) then //移动特效 默认模式
                        set x=EXGetEffectX(EC_EffectList[EC__i]) + CosBJ(EC_D[EC__i]) * tempr
                        set y=EXGetEffectY(EC_EffectList[EC__i]) + SinBJ(EC_D[EC__i]) * tempr
                    endif
                    if ( EC_PZ[EC__i] ) then
                        if ( not ( X_IsTerrainWalkable(x , y) ) ) then
                            if ( EC_PZTrig[EC__i] != null ) then
                                set EC_TargetEffect=EC_EffectList[EC__i]
                                set EC_EventID=3
                                call TriggerExecute(EC_PZTrig[EC__i])
                                if ( EC_Exit ) then
                                    set tempi=tempmax
                                endif
                            else
                                set EC_Exit=true //停止移动，运行结束触发器
                                set tempi=tempmax
                            endif
                        else
                            call EXSetEffectXY(EC_EffectList[EC__i], x, y)
                        endif
                    else
                        call EXSetEffectXY(EC_EffectList[EC__i], x, y)
                    endif
                    if ( EC_FlyMode[EC__i] != 2 ) then //特效高度设置 // =2为自定义 即 不设置
                        set z=EC_GetPointZ(x , y) //保持特效相对地面高度
                        if ( EC_FlyMode[EC__i] == 0 or EC_Height[EC__i] == 0 ) then
                            call EXSetEffectZ(EC_EffectList[EC__i], z + EC_Height[EC__i])
                        elseif ( EC_FlyMode[EC__i] == 1 ) then
                            if ( EC_DisD[EC__i] > 0 ) then //抛物线
                                set EC__ec_temp_t=EC_DisD[EC__i] / EC_Distance[EC__i]
                            else
                                set EC__ec_temp_t=1
                            endif
                            call EXSetEffectZ(EC_EffectList[EC__i], s__Math_Parabola(EC__ec_temp_t , EC_Height[EC__i] , z))
                        endif
                    endif
                    set i2=0 //检查护盾
                    loop
                    exitwhen ( i2 >= EC_ShiledIndex )
                        if ( not ( IsUnitAlly(EC_ShiledArray[i2], EC_OwnningPlayer[EC__i]) ) ) then //友方护盾则不检查
                            if ( s__Math_LocInRange(x , y , GetUnitX(EC_ShiledArray[i2]) , GetUnitY(EC_ShiledArray[i2]) , EC_ShiledSize[i2]) ) then //检查弹幕与护盾的距离 小于 护盾尺寸 //特效x,y 与 护盾单位 x y 的距离  <= size
                                set EC_TargetEffect=EC_EffectList[EC__i] //弹幕处于护盾范围内 运行护盾触碰弹幕回调 //触发特效 //触发特效所有者
                                set EC_EffectOwnningPlayer=EC_OwnningPlayer[EC__i] //触发护盾
                                set EC_TargetUnit=EC_ShiledArray[i2] //事件ID
                                set EC_EventID=4 //运行回调
                                call TriggerExecute(EC_ShiledCallbackTrig[i2])
                            endif
                        endif
                        set i2=i2 + 1
                    endloop //弹幕触碰部分
                    if ( EC_DamageTrig[EC__i] != null ) then
                        if ( not EC_Exit ) then
                            call GroupEnumUnitsInRange(EC__g, x, y, EC_Range[EC__i], null) //选取单位做动作
                            set EC_Hitable=true
                            set u=FirstOfGroup(EC__g)
                            loop
                            exitwhen ( u == null )
                                set EC_TargetUnit=u //触发单位 //触发特效
                                set EC_TargetEffect=EC_EffectList[EC__i]
                                set EC_EffectOwnningPlayer=EC_OwnningPlayer[EC__i]
                                set EC_EventID=0
                                call TriggerExecute(EC_DamageTrig[EC__i]) //如果结束本次冲锋，则直接结束
                                if ( EC_Exit or ( not EC_Hitable ) ) then
                                    exitwhen true
                                endif
                                call GroupRemoveUnit(EC__g, u)
                                set u=FirstOfGroup(EC__g)
                            endloop
                            call GroupClear(EC__g)
                        endif
                    endif //时间退出模式
                    if ( EC_Exit ) then
                        set EC_Timed[EC__i]=EC_Timed[EC__i] + EC_TimeMax[EC__i]
                        set EC_DisD[EC__i]=EC_DisD[EC__i] + EC_Distance[EC__i]
                    elseif ( EC_Mode[EC__i] != 0 ) then
                        set EC_Timed[EC__i]=EC_Timed[EC__i] + 0.02
                        set EC_DisD[EC__i]=EC_DisD[EC__i] + tempr
                    else
                        set EC_DisD[EC__i]=EC_DisD[EC__i] + tempr //距离退出模式
                    endif //刷新特效
                    if ( EC_Brush[EC__i] ) then
                        set EC_BrushTime[EC__i]=EC_BrushTime[EC__i] + 0.02 //计算周期
                        if ( EC_BrushTime[EC__i] >= EC_BrushDis[EC__i] ) then
                            set EC_BrushTime[EC__i]=0
                            set EC_EventID=2
                            set EC_TargetEffect=EC_EffectList[EC__i]
                            if ( EC_BrushTrig[EC__i] != null ) then
                                call TriggerExecute(EC_BrushTrig[EC__i])
                            endif
                        endif
                    endif
                endif
                set index=EC_Index - 1 //检查冲锋是否需要结束
                if ( ( EC_Mode[EC__i] != 0 and EC_Timed[EC__i] >= EC_TimeMax[EC__i] ) or ( EC_Mode[EC__i] == 0 and EC_DisD[EC__i] >= EC_Distance[EC__i] ) or EC_Exit ) then
                    set EC_KeepALive=false //冲锋结束 //检查是否需要调用指定结束触发器
                    if ( EC_FinishTrig[EC__i] != null ) then
                        set EC_TargetUnit=null
                        set EC_EffectOwnningPlayer=EC_OwnningPlayer[EC__i]
                        set EC_TargetEffect=EC_EffectList[EC__i] //清除ID接口
                        set EC_EventID=1
                        call TriggerExecute(EC_FinishTrig[EC__i])
                        call FlushChildHashtable(EC_HT, GetHandleId(EC_TargetEffect))
                        set index=EC_Index - 1
                    else
                        call DestroyEffect(EC_EffectList[EC__i])
                    endif
                    if ( not EC_KeepALive ) then //是否保持特效存在
                        if ( EC__i != index ) then //当前数据不在顶部 //清除特效数据
                            set EC_D[EC__i]=EC_D[index] //移动变量位置
                            set EC_Height[EC__i]=EC_Height[index]
                            set EC_DamageTrig[EC__i]=EC_DamageTrig[index]
                            set EC_FinishTrig[EC__i]=EC_FinishTrig[index]
                            set EC_Mode[EC__i]=EC_Mode[index]
                            set EC_Distance[EC__i]=EC_Distance[index]
                            set EC_DisD[EC__i]=EC_DisD[index]
                            set EC_Timed[EC__i]=EC_Timed[index]
                            set EC_TimeMax[EC__i]=EC_TimeMax[index]
                            set EC_Speed[EC__i]=EC_Speed[index]
                            set EC_OwnningPlayer[EC__i]=EC_OwnningPlayer[index]
                            set EC_EffectList[EC__i]=EC_EffectList[index]
                            set EC_BrushTrig[EC__i]=EC_BrushTrig[index]
                            set EC_Brush[EC__i]=EC_Brush[index]
                            set EC_BrushTime[EC__i]=EC_BrushTime[index]
                            set EC_BrushDis[EC__i]=EC_BrushDis[index]
                            set EC_PZ[EC__i]=EC_PZ[index]
                            set EC_PZTrig[EC__i]=EC_PZTrig[index]
                            set EC_FlyMode[EC__i]=EC_FlyMode[index]
                            set EC_steeps[EC__i]=EC_steeps[index]
                            set EC_steepsMax[EC__i]=EC_steepsMax[index]
                            set EC_MoveMode[EC__i]=EC_MoveMode[index] //顶部计数-1
                            call SaveInteger(EC_HT, GetHandleId(EC_EffectList[EC__i]), 1000, EC__i)
                            set EC_Index=EC_Index - 1 // index = EC_Index - 1;
                            if ( index > 0 ) then
                                set EC__i=EC__i - 1
                            endif
                        else
                            set EC_Index=EC_Index - 1 //在顶部只需要使顶部计数-1 //顶 - 1 // index = EC_Index - 1;
                        endif
                    endif
                endif
                set EC__i=EC__i + 1 //
            endloop
        endif
        set EC_Running=false
        set u=null
    endfunction
