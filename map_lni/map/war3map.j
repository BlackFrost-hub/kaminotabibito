		call SaveInteger(YDLOC, GetHandleId(ydl_timer), 0x4C45E673, LoadInteger(YDLOC, GetHandleId(GetExpiredTimer()), 0x4C45E673))
		call TimerStart(ydl_timer, 0.04, true, function Trig______________YXFunc012Func003Func002Func003T)
		call FlushChildHashtable(YDLOC, GetHandleId(GetExpiredTimer()))
		call DestroyTimer(GetExpiredTimer())
	else
		if ( ( LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xCEA5D211) == 1.00 ) ) then
			call PlaySoundBJ(gg_snd_JQBGM05)
			call DzFrameSetText(LoadInteger(YDLOC, GetHandleId(GetExpiredTimer()), 0x437E2A40), "......")
		else
			if ( ( LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xCEA5D211) == 2.00 ) ) then
				call DzFrameSetText(LoadInteger(YDLOC, GetHandleId(GetExpiredTimer()), 0x437E2A40), "....终于，|n神明们成功封印了动荡的来源...")
			else
				if ( ( LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xCEA5D211) == 3.00 ) ) then
					call DzFrameSetText(LoadInteger(YDLOC, GetHandleId(GetExpiredTimer()), 0xD963A09F), "并且使用强大的秘法将世界的撕裂正常化")
				else
					if ( ( LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xCEA5D211) == 4.00 ) ) then
						call DzFrameSetText(LoadInteger(YDLOC, GetHandleId(GetExpiredTimer()), 0xD963A09F), "并且使用强大的秘法将世界的撕裂正常化|n世界又重回正轨，温柔的圣光照亮大陆的每个角落")
					else
						if ( ( LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xCEA5D211) == 5.00 ) ) then
							call DzFrameSetText(LoadInteger(YDLOC, GetHandleId(GetExpiredTimer()), 0xCD1043F3), "每个种族的生灵都感受到了生活的希望，")
						else
							if ( ( LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xCEA5D211) == 6.00 ) ) then
								call DzFrameSetText(LoadInteger(YDLOC, GetHandleId(GetExpiredTimer()), 0xCD1043F3), "每个种族的生灵都感受到了生活的希望，|n人们心中的黑暗消失了...")
							else
								if ( ( LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xCEA5D211) == 7.00 ) ) then
									call DzFrameSetText(LoadInteger(YDLOC, GetHandleId(GetExpiredTimer()), 0x437E2A40), "")
									call DzFrameSetText(LoadInteger(YDLOC, GetHandleId(GetExpiredTimer()), 0xD963A09F), "")
									call DzFrameSetText(LoadInteger(YDLOC, GetHandleId(GetExpiredTimer()), 0xCD1043F3), "")
									call DzFrameSetText(LoadInteger(YDLOC, GetHandleId(GetExpiredTimer()), 0x437E2A40), "...然而...在不久后..")
