function Trig__________UI______uActions takes nothing returns nothing
 local integer ydul_A
 local integer ydul_B
 local integer ydl_localvar_step= LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xCFDE6C76)
 set ydl_localvar_step=ydl_localvar_step + 3
 call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xCFDE6C76, ydl_localvar_step)
 call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7, ydl_localvar_step)
	call SaveInteger(YDHT, StringHash("背景播放"), 0x53AC1561, - 3)
	if ( ( 0 == 0 ) ) then
		call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x74F5F0E6, DzCreateFrameByTagName("BACKDROP", "name", DzGetGameUI(), "template", 0))
		call DzFrameSetPriority(LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x74F5F0E6), 3)
		call SaveInteger(YDHT, StringHash("BJtietu"), 0x7D515EF5, LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x74F5F0E6))
		call DzFrameShow(LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x74F5F0E6), true)
		call DzFrameShow(LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x74F5F0E6), false)
		set ydul_A=1
		loop
			exitwhen ydul_A > 8
			call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x71359523, DzCreateFrameByTagName("BACKDROP", "name", LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x74F5F0E6), "template", 0))
			if ( ( ydul_A >= 1 ) and ( ydul_A <= 4 ) ) then
				call DzFrameSetTexture(LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x71359523), ( ( "war3mapImported\\BJtietu0" ) + ( I2S(ydul_A) ) + ( ".tga" ) ), 0)
				call DzFrameSetAbsolutePoint(LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x71359523), 4, ( ( - 0.10 ) + ( ( ( 0.20 ) * ( I2R(ydul_A) ) ) ) ), 0.4473138)
			else
				if ( ( ydul_A >= 5 ) and ( ydul_A <= 8 ) ) then
					call DzFrameSetTexture(LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x71359523), ( ( "war3mapImported\\BJtietu0" ) + ( I2S(ydul_A) ) + ( ".tga" ) ), 0)
					call DzFrameSetAbsolutePoint(LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x71359523), 4, ( ( - 0.90 ) + ( ( ( 0.20 ) * ( I2R(ydul_A) ) ) ) ), 0.1526862)
				else
				endif
			endif
			call DzFrameSetSize(LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x71359523), 0.20, 0.3053724)
			set ydul_A=ydul_A + 1
		endloop
		set ydul_B=1
		loop
			exitwhen ydul_B > 4
			call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xAC95309A, DzCreateFrameByTagName("TEXT", "段落", LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x74F5F0E6), "template", 0))
			call DzFrameSetAbsolutePoint(LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xAC95309A), 4, 0.309792, ( 0.5293128 - ( 0.0882192 * I2R(ydul_B) ) ))
			call DzFrameSetSize(LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xAC95309A), 0.3741664, 0.0882186)
			call DzFrameSetFont(LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xAC95309A), "war3mapImported\\uizt.ttf", 1.00, 0)
			if ( ( ydul_B == 1 ) ) then
				call SaveInteger(YDHT, LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x74F5F0E6), 0x7E17E9D2, LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xAC95309A))
			else
				if ( ( ydul_B == 2 ) ) then
					call SaveInteger(YDHT, LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x74F5F0E6), 0xE7AA479F, LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xAC95309A))
				else
					if ( ( ydul_B == 3 ) ) then
						call SaveInteger(YDHT, LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x74F5F0E6), 0x327A9CD9, LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xAC95309A))
					else
						if ( ( ydul_B == 4 ) ) then
							call SaveInteger(YDHT, LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x74F5F0E6), 0x8EFBD967, LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xAC95309A))
						else
						endif
					endif
				endif
			endif
			set ydul_B=ydul_B + 1
		endloop
	else
	endif
	call FlushChildHashtable(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step)
endfunction
