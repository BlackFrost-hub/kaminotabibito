//===========================================================================
function Trig_____________________________duanConditions takes nothing returns boolean
	return ( ( IsUnitType(GetTriggerUnit(), UNIT_TYPE_HERO) == true ) )
endfunction
function Trig_____________________________duanFunc002Func016Conditions takes nothing returns nothing
	if ( ( GetItemTypeId(GetManipulatedItem()) == 'I02I' ) ) then
		call SaveLocationHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0x5B0D7524, GetUnitLoc(GetTriggerUnit()))
		call DisplayTimedTextToForce(GetPlayersAll(), 20.00, "图斯卡：哦？看来你的天赋还可以，以后可以用3个石头+2个木材自己随手搭个篝火来进行烤肉，相逢即是缘，这些材料就送给你吧")
		call CreateItemLoc('I02J', LoadLocationHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0x5B0D7524))
		call CreateItemLoc('I02J', LoadLocationHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0x5B0D7524))
		call CreateItemLoc('I02J', LoadLocationHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0x5B0D7524))
		call CreateItemLoc('I024', LoadLocationHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0x5B0D7524))
		call CreateItemLoc('I024', LoadLocationHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0x5B0D7524))
		call CreateItemLoc('I024', LoadLocationHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0x5B0D7524))
		call CreateItemLoc('I024', LoadLocationHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0x5B0D7524))
		call RemoveLocation(LoadLocationHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0x5B0D7524))
		call FlushChildHashtable(YDLOC, GetHandleId(GetTriggeringTrigger()))
		call DestroyTrigger(GetTriggeringTrigger())
	else
	endif
endfunction
function Trig_____________________________duanFunc004Func017Func002Func001Func002Func003T takes nothing returns nothing
	call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "丽莲", null, "若是有沙漠毒液蜘蛛的护腿，可以找我制作，我可以编制成更高级的，当然，不需要任何费用。", bj_TIMETYPE_SET, 4.00, false)
	call QuestMessageBJ(GetPlayersAll(), bj_QUESTMESSAGE_HINT, ( ( "|cffffff00『系统提示』：|r" ) + ( "丽琳开放了新的制作功能" ) + ( "" ) ))
	call AddItemToStockBJ('I09T', LoadUnitHandle(YDHT, StringHash("支线NPC"), 0x375E1F9B), 1, 4)
	call FlushChildHashtable(YDLOC, GetHandleId(GetExpiredTimer()))
	call DestroyTimer(GetExpiredTimer())
endfunction
function Trig_____________________________duanFunc004Func017Func002Func001Func002Func004T takes nothing returns nothing
	call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, GetUnitName(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x310EFEF8)), null, "不用客气，毕竟本来就是你的物品，现在物归原主罢了", bj_TIMETYPE_SET, 4.00, false)
	call AdjustPlayerStateBJ(1, LoadPlayerHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xAC95C7C6), PLAYER_STATE_RESOURCE_LUMBER)
	call QuestMessageBJ(GetPlayersAll(), bj_QUESTMESSAGE_ITEMACQUIRED, ( ( "|cffffff00『系统提示』：|r" ) + ( GetUnitName(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x310EFEF8)) ) + ( "获得了|cffcc99ff1点『记忆碎片』|r！" ) ))
	call FlushChildHashtable(YDLOC, GetHandleId(GetExpiredTimer()))
	call DestroyTimer(GetExpiredTimer())
endfunction
function Trig_____________________________duanFunc004Func017Func002Func001Func004T takes nothing returns nothing
	call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, GetUnitName(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x310EFEF8)), null, "成交！", bj_TIMETYPE_SET, 4.00, false)
	call FlushChildHashtable(YDLOC, GetHandleId(GetExpiredTimer()))
	call DestroyTimer(GetExpiredTimer())
endfunction
function Trig_____________________________duanFunc004Func017Conditions takes nothing returns nothing
 local timer ydl_timer
	if ( ( GetClickedButtonBJ() == LoadButtonHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0x83CFBD9A) ) ) then
		if ( ( IsUnitInGroup(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0x310EFEF8), LoadGroupHandle(YDHT, StringHash("男性英雄"), 0x0A4A1F64)) == true ) ) then
			call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "丽莲", null, "多谢这位公子..", bj_TIMETYPE_SET, 4.00, false)
		else
			call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "丽莲", null, "多谢姑娘...", bj_TIMETYPE_SET, 4.00, false)
		endif
		call AdjustPlayerStateBJ(10000, GetTriggerPlayer(), PLAYER_STATE_RESOURCE_GOLD)
	else
		if ( ( GetClickedButtonBJ() == LoadButtonHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0x8A160A4B) ) ) then
			call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "丽莲", null, "...好吧，多付5000金币可以吗？", bj_TIMETYPE_SET, 4.00, false)
			set ydl_timer=CreateTimer()
			call SaveUnitHandle(YDLOC, GetHandleId(ydl_timer), 0x310EFEF8, LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0x310EFEF8))
			call TimerStart(ydl_timer, 4.00, false, function Trig_____________________________duanFunc004Func017Func002Func001Func004T)
			call AdjustPlayerStateBJ(15000, GetTriggerPlayer(), PLAYER_STATE_RESOURCE_GOLD)
		else
			if ( ( GetClickedButtonBJ() == LoadButtonHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0x13EDD592) ) ) then
				if ( ( IsUnitInGroup(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0x310EFEF8), LoadGroupHandle(YDHT, StringHash("男性英雄"), 0x0A4A1F64)) == true ) ) then
					call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "丽莲", null, "多谢这位公子..", bj_TIMETYPE_SET, 4.00, false)
				else
					call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "丽莲", null, "多谢姑娘...", bj_TIMETYPE_SET, 4.00, false)
				endif
				set ydl_timer=CreateTimer()
				call TimerStart(ydl_timer, 4.00, false, function Trig_____________________________duanFunc004Func017Func002Func001Func002Func003T)
				set ydl_timer=CreateTimer()
				call SavePlayerHandle(YDLOC, GetHandleId(ydl_timer), 0xAC95C7C6, GetTriggerPlayer())
				call SaveUnitHandle(YDLOC, GetHandleId(ydl_timer), 0x310EFEF8, LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0x310EFEF8))
				call TimerStart(ydl_timer, 8.00, false, function Trig_____________________________duanFunc004Func017Func002Func001Func002Func004T)
			else
			endif
		endif
	endif
	call FlushChildHashtable(YDLOC, GetHandleId(GetTriggeringTrigger()))
	call DestroyTrigger(GetTriggeringTrigger())
	set ydl_timer=null
endfunction
function Trig_____________________________duanFunc005Func009A takes nothing returns nothing
	call AddHeroXP(GetEnumUnit(), 8000, true)
endfunction
function Trig_____________________________duanActions takes nothing returns nothing
 local trigger ydl_trigger
 local integer ydl_localvar_step= LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xCFDE6C76)
 set ydl_localvar_step=ydl_localvar_step + 3
 call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xCFDE6C76, ydl_localvar_step)
 call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7, ydl_localvar_step)
	call SaveLocationHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xA296AF2A, GetUnitLoc(GetTriggerUnit()))
	if ( ( IsUnitType(GetTriggerUnit(), UNIT_TYPE_HERO) == true ) and ( YDWEUnitHasItemOfTypeBJNull(GetTriggerUnit() , 'I02H') == true ) and ( RectContainsLoc(gg_rct______________052, LoadLocationHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xA296AF2A)) == true ) ) then
		call SaveUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x232E2B44, LoadUnitHandle(YDHT, StringHash("支线NPC"), 0x232E2B44))
		call RemoveRect(gg_rct______________052)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "冒险者", null, "哈哈，真香啊", bj_TIMETYPE_SET, 1.50, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "冒险者", null, "是啊，这肉，在外面吃个美味的烧烤真是太爽了", bj_TIMETYPE_SET, 3.00, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, GetUnitName(GetTriggerUnit()), null, "烧烤？请问我这个可以烤吗（拿出螃蟹肉）", bj_TIMETYPE_SET, 3.00, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "冒险者", null, "哦？当然可以，怎么？你想借用我们的篝火吃上一顿烤肉吗", bj_TIMETYPE_SET, 3.00, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, GetUnitName(GetTriggerUnit()), null, "请问要如何烧烤？", bj_TIMETYPE_SET, 3.00, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "冒险者", null, "这个简单，你只需要把食材放进篝火里，然后等时间成熟了就可以了", bj_TIMETYPE_SET, 3.00, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "冒险者", null, "不过要注意的是，一旦煮熟了就要立马拿出来，否则过『一段时间』后变会烧没", bj_TIMETYPE_SET, 3.00, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, GetUnitName(GetTriggerUnit()), null, "这样，我试试", bj_TIMETYPE_SET, 2.00, true)
		call QuestMessageBJ(GetPlayersAll(), bj_QUESTMESSAGE_UPDATED, "系统提示：请将螃蟹肉（生）尝试放入篝火内，在生肉烤熟后，请立马拿出来")
		call SetUnitOwner(gg_unit_h00C_0509, GetOwningPlayer(GetTriggerUnit()), true)
		call SaveTriggerHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xB5A0468E, CreateTrigger())
		set ydl_trigger=LoadTriggerHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xB5A0468E)
		call SaveLocationHandle(YDLOC, GetHandleId(ydl_trigger), 0x5B0D7524, LoadLocationHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x5B0D7524))
		call TriggerRegisterAnyUnitEventBJ(ydl_trigger, EVENT_PLAYER_UNIT_PICKUP_ITEM)
		call TriggerAddCondition(ydl_trigger, Condition(function Trig_____________________________duanFunc002Func016Conditions))
	else
	endif
	if ( ( YDWEUnitHasItemOfTypeBJNull(GetTriggerUnit() , 'I09S') == false ) and ( IsUnitOwnedByPlayer(LoadUnitHandle(YDHT, StringHash("支线NPC"), 0x375E1F9B), Player(PLAYER_NEUTRAL_PASSIVE)) == true ) and ( IsUnitInRange(GetTriggerUnit(), LoadUnitHandle(YDHT, StringHash("支线NPC"), 0x375E1F9B), 499.00) == true ) ) then
		//金光戒指创建在与精灵村长老对话中
		call SaveUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x375E1F9B, LoadUnitHandle(YDHT, StringHash("支线NPC"), 0x375E1F9B))
		call SetUnitOwner(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x375E1F9B), Player(6), true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "丽莲", null, "糟糕，我的|cffffff00戒指|r怎么不见了，不会|cffffff00落在沙漠里|r了吧", bj_TIMETYPE_SET, 4.00, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "丽莲", null, "这可怎么办啊...", bj_TIMETYPE_SET, 4.00, true)
	else
	endif
	if ( ( YDWEUnitHasItemOfTypeBJNull(GetTriggerUnit() , 'I09S') == true ) and ( IsUnitInRange(GetTriggerUnit(), LoadUnitHandle(YDHT, StringHash("支线NPC"), 0x375E1F9B), 499.00) == true ) ) then
		call RemoveItem(YDWEGetItemOfTypeFromUnitBJNull(GetTriggerUnit() , 'I09S'))
		call SaveUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x375E1F9B, LoadUnitHandle(YDHT, StringHash("支线NPC"), 0x375E1F9B))
		if ( ( IsUnitInGroup(GetTriggerUnit(), LoadGroupHandle(YDHT, StringHash("男性英雄"), 0x0A4A1F64)) == true ) ) then
			call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "丽莲", null, "这位公子请留步！", bj_TIMETYPE_SET, 4.00, true)
		else
			call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "丽莲", null, "这位姑娘请留步！", bj_TIMETYPE_SET, 4.00, true)
		endif
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), GetTriggerUnit(), GetUnitName(GetTriggerUnit()), null, "有何事？", bj_TIMETYPE_SET, 4.00, true)
		if ( ( IsUnitInGroup(GetTriggerUnit(), LoadGroupHandle(YDHT, StringHash("男性英雄"), 0x0A4A1F64)) == true ) ) then
			call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "丽莲", null, "公子身上带的戒指是否是前不久在沙漠中拾取的？", bj_TIMETYPE_SET, 4.00, true)
		else
			call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "丽莲", null, "姑娘身上带的戒指是否是前不久在沙漠中拾取的？", bj_TIMETYPE_SET, 4.00, true)
		endif
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, GetUnitName(GetTriggerUnit()), null, "是这样没错，难道这戒指是你的？", bj_TIMETYPE_SET, 4.00, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "丽莲", null, "没错，能否将这枚戒指交还给我？", bj_TIMETYPE_SET, 4.00, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "丽莲", null, "我会用|cffffff0010000金币|r作为报酬交换，如何？", bj_TIMETYPE_SET, 4.00, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, GetUnitName(GetTriggerUnit()), null, ".....（此物不值得此价，看来这枚戒指对此人|cffff0000极为重要|r）", bj_TIMETYPE_SET, 4.00, true)
		call SaveDialogHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x09A665D5, DialogCreate())
		call DialogSetMessage(LoadDialogHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x09A665D5), "做出选择：")
		call SaveButtonHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x83CFBD9A, DialogAddButton(LoadDialogHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x09A665D5), "同意", '1'))
		call SaveButtonHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x8A160A4B, DialogAddButton(LoadDialogHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x09A665D5), "加价", '2'))
		call SaveButtonHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x13EDD592, DialogAddButton(LoadDialogHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x09A665D5), "赠送", '3'))
		call DialogDisplay(GetOwningPlayer(GetTriggerUnit()), LoadDialogHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x09A665D5), true)
		set ydl_trigger=CreateTrigger()
		call SaveUnitHandle(YDLOC, GetHandleId(ydl_trigger), 0x310EFEF8, GetTriggerUnit())
		call SaveButtonHandle(YDLOC, GetHandleId(ydl_trigger), 0x83CFBD9A, LoadButtonHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x83CFBD9A))
		call SaveButtonHandle(YDLOC, GetHandleId(ydl_trigger), 0x8A160A4B, LoadButtonHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x8A160A4B))
		call SaveButtonHandle(YDLOC, GetHandleId(ydl_trigger), 0x13EDD592, LoadButtonHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x13EDD592))
		call TriggerRegisterDialogEvent(ydl_trigger, LoadDialogHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x09A665D5))
		call TriggerAddCondition(ydl_trigger, Condition(function Trig_____________________________duanFunc004Func017Conditions))
	else
	endif
	if ( ( YDWEUnitHasItemOfTypeBJNull(GetTriggerUnit() , 'I0AO') == true ) and ( IsUnitInRange(GetTriggerUnit(), LoadUnitHandle(YDHT, StringHash("支线NPC"), 0x21389993), 200.00) == true ) ) then
		call RemoveItem(YDWEGetItemOfTypeFromUnitBJNull(GetTriggerUnit() , 'I0AO'))
		call SaveUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x21389993, LoadUnitHandle(YDHT, StringHash("支线NPC"), 0x21389993))
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, GetUnitName(GetTriggerUnit()), null, "请问这封信你认识吗？", bj_TIMETYPE_SET, 2.50, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, GetUnitName(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x21389993)), null, "....没错，一眼就认出来了，这确实是我朋友的信，多谢。", bj_TIMETYPE_SET, 2.50, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, GetUnitName(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x21389993)), null, "这是信封上写的报酬，我就替我朋友交付了。", bj_TIMETYPE_SET, 2.50, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, GetUnitName(GetTriggerUnit()), null, "好的。", bj_TIMETYPE_SET, 1.00, true)
		call QuestMessageBJ(GetPlayersAll(), bj_QUESTMESSAGE_COMPLETED, ( ( "|cffffff00『系统提示』：|r" ) + ( GetUnitName(GetTriggerUnit()) ) + ( "完成了|cff808080『送信』|r任务，所有玩家|cffffcc99经验+8000|r" ) ))
		call ForGroupBJ(LoadGroupHandle(YDHT, StringHash("玩家英雄"), 0x0A4A1F64), function Trig_____________________________duanFunc005Func009A)
		call RemoveSavedHandle(YDHT, StringHash("支线NPC"), 0x21389993)
	else
	endif
	call RemoveLocation(LoadLocationHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xA296AF2A))
	call FlushChildHashtable(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step)
	set ydl_trigger=null
endfunction
