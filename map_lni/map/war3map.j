function InitTrig_DMboss____________01 takes nothing returns nothing
	set gg_trg_DMboss____________01=CreateTrigger()
	call TriggerAddCondition(gg_trg_DMboss____________01, Condition(function Trig_DMboss____________01Conditions))
	call TriggerAddAction(gg_trg_DMboss____________01, function Trig_DMboss____________01Actions)
endfunction
