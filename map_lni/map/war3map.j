    function SO_SetSetDayNightModels takes string a,string b returns nothing
        call SetDayNightModels(a, b)
    endfunction  //移动单位u到X,Y 并移动镜头 持续d秒
    function StarOther_MoveUnitAndCamera takes unit whichunit,real x,real y,real duration returns nothing
        call SetUnitX(whichunit, x)
        call SetUnitY(whichunit, y)
        if ( GetLocalPlayer() == GetOwningPlayer(whichunit) ) then
            call PanCameraToTimed(x, y, duration)
        endif
    endfunction  //平移玩家镜头到坐标
    function StarOther_PanCameraToTimedForPlayer takes player whichPlayer,real x,real y,real duration returns nothing
        if ( GetLocalPlayer() == whichPlayer ) then
            call PanCameraToTimed(x, y, duration)
        endif
    endfunction  //平移玩家镜头到单位
    function StarOther_PanCameraToTimedUnitForPlayer takes player whichPlayer,unit u,real duration returns nothing
        if ( GetLocalPlayer() == whichPlayer ) then
            call PanCameraToTimed(GetUnitX(u), GetUnitY(u), duration)
        endif
    endfunction  //移动X坐标 方向 距离
    function MoveX takes real x,real d,real dis returns real
        return x + CosBJ(d) * dis
    endfunction  //移动Y坐标 方向 距离
    function MoveY takes real y,real d,real dis returns real
        return y + SinBJ(d) * dis
    endfunction
    //public:
            function StarOther__anon__0 takes nothing returns nothing
                local integer i=LoadInteger(StarBaseHT, GetHandleId(GetExpiredTimer()), 0xA707D18B)
                local player p=Player(i)
                call PauseTimer(s__CFG_timers[i])
                if ( GetLocalPlayer() == p ) then
                    call DisplayCineFilter(false)
                endif
                set p=null
            endfunction
        function SO_CinematicFilterGenerictakes takes player p,real duration,blendmode bmode,string tex,real red0,real green0,real blue0,real trans0,real red1,real green1,real blue1,real trans1 returns nothing
            local integer pid=GetPlayerId(p)
            call SaveInteger(StarBaseHT, GetHandleId(s__CFG_timers[pid]), 0xA707D18B, pid)
            call TimerStart(s__CFG_timers[pid], duration, false, function StarOther__anon__0)
            if ( GetLocalPlayer() == p ) then
                call SetCineFilterTexture(tex)
                call SetCineFilterBlendMode(bmode)
                call SetCineFilterTexMapFlags(TEXMAP_FLAG_NONE)
                call SetCineFilterStartUV(0, 0, 1, 1)
                call SetCineFilterEndUV(0, 0, 1, 1)
                call SetCineFilterStartColor(PercentTo255(red0), PercentTo255(green0), PercentTo255(blue0), PercentTo255(100 - trans0))
                call SetCineFilterEndColor(PercentTo255(red1), PercentTo255(green1), PercentTo255(blue1), PercentTo255(100 - trans1))
                call SetCineFilterDuration(duration)
                call DisplayCineFilter(true)
            endif
        endfunction  //封装用
