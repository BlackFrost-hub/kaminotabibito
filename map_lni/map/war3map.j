function Trig_____________________________changFunc003Func040Func002Func008Func014T takes nothing returns nothing
 local timer ydl_timer
 local group ydl_group
 local unit ydl_unit
	if ( ( IsUnitDeadBJ(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xA1614B4D)) == true ) and ( IsUnitDeadBJ(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x9C0F555E)) == true ) ) then
		call SetStackedSoundBJ(false, gg_snd_battle01, gg_rct______________111)
		call SetStackedSoundBJ(true, gg_snd_shengliBgm, gg_rct______________111)
		set ydl_timer=CreateTimer()
		call TimerStart(ydl_timer, 20.00, false, function Trig_____________________________changFunc003Func040Func002Func008Func014Func001Func003T)
		call FlushChildHashtable(YDLOC, GetHandleId(GetExpiredTimer()))
		call DestroyTimer(GetExpiredTimer())
	else
	endif
	set ydl_group=CreateGroup()
	call GroupEnumUnitsInRange(ydl_group, GetUnitX(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xBEC1F2B9)), GetUnitY(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xBEC1F2B9)), 4500.00, null)
	loop
		set ydl_unit=FirstOfGroup(ydl_group)
		exitwhen ydl_unit == null
		call GroupRemoveUnit(ydl_group, ydl_unit)
		if ( ( IsUnitAliveBJ(ydl_unit) == true ) and ( GetUnitTypeId(ydl_unit) == 'n00A' ) ) then
			call IssueTargetOrder(ydl_unit, "attackonce", LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xBEC1F2B9))
			call DisplayTimedTextToForce(GetPlayersAll(), 10.00, "|cffffff00『地精大哥』|r：先解决掉这个精灵女人再说！（攻击琳丽）")
			exitwhen true
		else
		endif
	endloop
	call DestroyGroup(ydl_group)
	set ydl_timer=null
	set ydl_group=null
	set ydl_unit=null
endfunction
