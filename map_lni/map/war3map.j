		call TimerStart(ydl_timer, 1200.00, false, function Trig_____________________________changFunc007Func030T)
	else
	endif
	//炼金之术
	if ( ( IsUnitInRange(GetTriggerUnit(), LoadUnitHandle(YDHT, StringHash("支线NPC"), 0x11B3668F), 450.00) == true ) and ( IsQuestDiscovered(udg_RW[4]) == false ) and ( ( YDWEUnitHasItemOfTypeBJNull(GetTriggerUnit() , 'I03M') == true ) ) ) then
		call SaveUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x11B3668F, LoadUnitHandle(YDHT, StringHash("支线NPC"), 0x11B3668F))
		call QuestSetDiscovered(udg_RW[4], true)
		if ( ( IsUnitInGroup(GetTriggerUnit(), LoadGroupHandle(YDHT, StringHash("男性英雄"), 0x0A4A1F64)) == true ) ) then
			call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "炼金商人", null, "这位兄弟对毒感兴趣吗？", bj_TIMETYPE_SET, 3.50, true)
		else
			if ( ( IsUnitInGroup(GetTriggerUnit(), LoadGroupHandle(YDHT, StringHash("女性英雄"), 0x0A4A1F64)) == true ) ) then
				call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "炼金商人", null, "这位姑娘对毒感兴趣吗？", bj_TIMETYPE_SET, 3.50, true)
			else
			endif
		endif
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, GetUnitName(GetTriggerUnit()), null, "...额，我只是因为某些任务原因才携带这些物品", bj_TIMETYPE_SET, 2.50, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "炼金商人", null, "这样吗，那真是有点可惜...本以为好不容易遇到个对炼毒感兴趣的..
", bj_TIMETYPE_SET, 3.50, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, GetUnitName(GetTriggerUnit()), null, "可以的话，能否告知我一点关于毒的知识..", bj_TIMETYPE_SET, 2.50, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "炼金商人", null, "无妨，毒被称为独立于八大魔法元素之外的『第九元素』，其他元素都可以帮助生灵的日常生活，而毒却百害而无利", bj_TIMETYPE_SET, 7.50, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "炼金商人", null, "毒，实在是找不出什么作用来，除了杀人之外就别无他用...听说在远古时期毒是和其他七大元素并列称呼为八大元素的", bj_TIMETYPE_SET, 8.00, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "炼金商人", null, "但就是因为这个原因被踢了出来，从此，学习毒元素的生灵就被其他七大元素所鄙视", bj_TIMETYPE_SET, 5.00, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "炼金商人", null, "呵呵..其实，我就是一名学习探究毒的魔法师，不过与其说是魔法师，不如说是研究者", bj_TIMETYPE_SET, 5.00, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, GetUnitName(GetTriggerUnit()), null, "研究者？研究什么？研究毒吗？", bj_TIMETYPE_SET, 2.50, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "炼金商人", null, "没错，在我的研究下，我发现毒除了杀害生物之外或许还有其他作用...", bj_TIMETYPE_SET, 5.00, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "炼金商人", null, "若我的发现是真的...或许能够直接改成毒元素的地位..", bj_TIMETYPE_SET, 5.00, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, GetUnitName(GetTriggerUnit()), null, "能具体说说嘛？", bj_TIMETYPE_SET, 2.50, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "炼金商人", null, "嘿嘿..好奇了？若真如此的话，就给我带来几份拥有剧毒能量的物品吧", bj_TIMETYPE_SET, 5.00, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, GetUnitName(GetTriggerUnit()), null, "剧毒能量？可以再描述详细点吗？", bj_TIMETYPE_SET, 2.50, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "炼金商人", null, "嘿嘿，只要是你觉得是致命毒物的物品，都可以尝试带来给我看看..至少带来3份我满意的吧", bj_TIMETYPE_SET, 5.00, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, GetUnitName(GetTriggerUnit()), null, "........", bj_TIMETYPE_SET, 2.50, true)
		call QuestMessageBJ(GetPlayersAll(), bj_QUESTMESSAGE_DISCOVERED, "发现新任务
找到3份带有剧毒能量的物品带给沙漠中的毒研究员
（未完待续）")
	else
	endif
	call RemoveLocation(LoadLocationHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x5B0D7524))
	call FlushChildHashtable(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step)
	set ydl_trigger=null
	set ydl_timer=null
endfunction
