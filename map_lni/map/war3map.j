		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "胡特队长", null, ( GetUnitName(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x4F4C6648)) + "阁下..我记住了，我是沙漠泰勒佣兵团的副团长胡特" ), bj_TIMETYPE_SET, 6.00, true)
