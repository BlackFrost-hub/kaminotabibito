            call ForGroupBJ(LoadGroupHandle(YDHT, StringHash("玩家英雄"), 0x0A4A1F64), function Trig____Boss_____________________uFunc016Func001Func006A)
            call StarOther_PanCameraToTimedUnitForPlayer(GetOwningPlayer(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x5FB34C7A)) , LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x5FB34C7A) , 0.10)
        else
        endif
    endif
    call IssueImmediateOrder(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x944CCEB0), "holdposition")
    call SaveBoolean(YDHT, StringHash("普通Boss战"), 0x8D20624B, true)
    call SaveUnitHandle(YDHT, StringHash("普通Boss战"), 0x62274AD0, LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x944CCEB0))
