function Trig____________________002Actions takes nothing returns nothing
 local timer ydl_timer
 local integer ydl_localvar_step= LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xCFDE6C76)
 set ydl_localvar_step=ydl_localvar_step + 3
 call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xCFDE6C76, ydl_localvar_step)
 call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7, ydl_localvar_step)
	if ( ( GetItemTypeId(GetSoldItem()) == 'I0CT' ) ) then
		if ( ( GetHeroLevel(GetBuyingUnit()) >= 10 ) ) then
			call SaveUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x62274AD0, GetBuyingUnit())
			if ( ( ( LoadBoolean(YDHT, StringHash("普通Boss战"), 0x8D20624B) == true ) or ( LoadBoolean(YDHT, StringHash("Boss战"), 0x8D20624B) == true ) ) ) then
				call QuestMessageBJ(GetPlayersAll(), bj_QUESTMESSAGE_ALWAYSHINT, "|cffffff00『系统提示』：其他Boss战正在开启，请结束其他Boss战后再来接受任务！|r")
				call RemoveItemFromStockBJ('I0CT', GetSellingUnit())
				call AddItemToStockBJ('I0CT', GetSellingUnit(), 1, 1)
				call FlushChildHashtable(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step)
	set ydl_timer=null
				return
			else
			endif
			call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, GetUnitName(GetSellingUnit()), null, "拜托了", bj_TIMETYPE_SET, 2.00, true)
			call SetUnitOwner(GetSellingUnit(), Player(6), true)
			call SaveUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x944CCEB0, CreateUnit(Player(PLAYER_NEUTRAL_AGGRESSIVE), 'N05D', 25660.30, 19264.60, GetRandomDirectionDeg()))
			call SaveUnitHandle(YDHT, GetHandleId(gg_trg____Boss_____________________u), 0x944CCEB0, LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x944CCEB0))
			call SaveUnitHandle(YDHT, GetHandleId(gg_trg____Boss_____________________u), 0x5FB34C7A, LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x62274AD0))
			set ydl_timer=CreateTimer()
			call SaveUnitHandle(YDLOC, GetHandleId(ydl_timer), 0xF047C7C9, GetEventDamageSource())
			call SaveUnitHandle(YDLOC, GetHandleId(ydl_timer), 0x458B7DE9, GetTriggerUnit())
			call TimerStart(ydl_timer, 8.00, true, function Trig____________________002Func001Func001Func012T)
			set ydl_timer=CreateTimer()
			call TimerStart(ydl_timer, 4.00, false, function Trig____________________002Func001Func001Func013T)
		else
			call QuestMessageBJ(GetPlayersAll(), bj_QUESTMESSAGE_FAILED, "|cffffff00『系统提示』：|r接受任务等级不达标")
			call RemoveItemFromStockBJ('I0CT', GetSellingUnit())
			call AddItemToStockBJ('I0CT', GetSellingUnit(), 1, 1)
		endif
	else
	endif
	if ( ( GetItemTypeId(GetSoldItem()) == 'I0CM' ) ) then
		if ( ( GetHeroLevel(GetBuyingUnit()) > 10 ) ) then
			call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, GetUnitName(GetSellingUnit()), null, "我已经调查完成了，多谢你的好意", bj_TIMETYPE_ADD, 0, false)
			call FlushChildHashtable(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step)
	set ydl_timer=null
			return
		else
		endif
		call UnitAddItemByIdSwapped('I0CN', GetBuyingUnit())
		call SetUnitOwner(GetSellingUnit(), Player(6), true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, GetUnitName(GetSellingUnit()), null, "敬请期待了", bj_TIMETYPE_ADD, 0, true)
		call QuestMessageBJ(GetPlayersAll(), bj_QUESTMESSAGE_DISCOVERED, "|cffffff00『系统提示』：|r接受任务。")
	else
	endif
	if ( ( GetItemTypeId(GetSoldItem()) == 'I0CJ' ) ) then
		call SaveBoolean(YDHT, StringHash("失踪的精灵村民"), 0xEF4D214E, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, GetUnitName(GetSellingUnit()), null, "感谢你们，有你们的帮助这件事我想一定会有眉目。", bj_TIMETYPE_SET, 3.00, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, GetUnitName(GetBuyingUnit()), null, "长老，可以介绍下具体情况吗", bj_TIMETYPE_SET, 3.00, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, GetUnitName(GetSellingUnit()), null, "嗯..就是精灵村最近1个月开始陆陆续续有村民失踪", bj_TIMETYPE_SET, 3.00, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, GetUnitName(GetSellingUnit()), null, "根据哨手来报，精灵村的空气中混杂着一丝血液，很明显，这件事是人为，不是自然发生的。", bj_TIMETYPE_SET, 3.00, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, GetUnitName(GetBuyingUnit()), null, "居然是血案..", bj_TIMETYPE_SET, 3.00, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, GetUnitName(GetSellingUnit()), null, "来着恐怕不凡，估计是针对我们精灵族而来，目前的踪迹全部指向精灵初始森", bj_TIMETYPE_SET, 3.00, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, GetUnitName(GetSellingUnit()), null, "去哪里调查一下吧，我想会有线索的..", bj_TIMETYPE_SET, 3.00, true)
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, GetUnitName(GetBuyingUnit()), null, "好的，精灵族也是我的朋友..这件事我会当做自己的事情处理..", bj_TIMETYPE_SET, 3.00, true)
		call QuestMessageBJ(GetPlayersAll(), bj_QUESTMESSAGE_WARNING, "|cffffff00『系统提示』：|r|cffff0000此任务难度特别高，推荐等级：17|r")
	else
	endif
	if ( ( GetItemTypeId(GetSoldItem()) == 'I0DH' ) ) then
		if ( ( GetItemCharges(YDWEGetItemOfTypeFromUnitBJNull(GetBuyingUnit() , 'I0A0')) >= 1 ) ) then
			call RemoveItem(YDWEGetItemOfTypeFromUnitBJNull(GetBuyingUnit() , 'I0A0'))
			call UnitAddItemByIdSwapped('I0DF', GetBuyingUnit())
			call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, GetUnitName(GetSellingUnit()), null, "哦？没想到真是聚灵花，不错，这双鞋子就归你了！", bj_TIMETYPE_SET, 3.00, true)
		else
			call RemoveItemFromStockBJ('I0DH', GetSellingUnit())
			call AddItemToStockBJ('I0DH', GetSellingUnit(), 1, 1)
			call DisplayTextToPlayer(GetOwningPlayer(GetBuyingUnit()), 0, 0, "|cffffff00系统提示：交换需求|cffff0000未达成|r")
		endif
	else
	endif
	if ( ( GetItemTypeId(GetSoldItem()) == 'I0DI' ) ) then
		if ( ( YDWEUnitHasItemOfTypeBJNull(GetBuyingUnit() , 'I0DJ') == true ) and ( YDWEUnitHasItemOfTypeBJNull(GetBuyingUnit() , 'I0DK') == true ) ) then
			call RemoveItem(YDWEGetItemOfTypeFromUnitBJNull(GetBuyingUnit() , 'I0DJ'))
			call RemoveItem(YDWEGetItemOfTypeFromUnitBJNull(GetBuyingUnit() , 'I0DK'))
			call UnitAddItemByIdSwapped('I0DG', GetBuyingUnit())
			call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, GetUnitName(GetSellingUnit()), null, "真实实力强大，这枚戒指就归你了！", bj_TIMETYPE_SET, 3.00, true)
		else
			call RemoveItemFromStockBJ('I0DI', GetSellingUnit())
			call AddItemToStockBJ('I0DI', GetSellingUnit(), 1, 1)
			call DisplayTextToPlayer(GetOwningPlayer(GetBuyingUnit()), 0, 0, "|cffffff00系统提示：交换需求|cffff0000未达成|r")
		endif
	else
	endif
	if ( ( GetItemTypeId(GetSoldItem()) == 'I0DM' ) ) then
		call PlaySoundBJ(gg_snd_shengliBgm2)
		call ForForce(LoadForceHandle(YDHT, StringHash("玩家"), 0x7C23C9D2), function Trig____________________002Func006Func002A)
	else
	endif
	call FlushChildHashtable(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step)
	set ydl_timer=null
endfunction
