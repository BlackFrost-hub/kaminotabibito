			call SetUnitFlyHeight(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15), ( ( GetUnitFlyHeight(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15)) ) - ( 37.50 ) ), 0.00)
		endif
	else
		call SaveReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xB259B269, ( ( LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xB259B269) ) + ( 1.00 ) ))
		if ( ( GetUnitFlyHeight(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15)) >= 500.00 ) ) then
			call SaveReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xB259B269, 30.00)
		else
			call SetUnitFlyHeight(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15), ( ( GetUnitFlyHeight(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15)) ) + ( 25.00 ) ), 0.00)
		endif
	endif
endfunction
function Trig_DMboss____________02Func003Func004Func008T takes nothing returns nothing
 local group ydl_group
 local unit ydl_unit
 local timer ydl_timer
	set Star_EG=LoadInteger(YDLOC, GetHandleId(GetExpiredTimer()), 0xECB0B24C)
	set Star_EG_ForValue=0
	set Star_EG_ForIndex=EG_GetCount(Star_EG)
	loop
		set EG_CallbackEffect=EG_GetAt(Star_EG , Star_EG_ForValue)
		call EXSetEffectSize(EG_GetEnumEffect(), 0.00)
		call SaveReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xA99320FA, EXGetEffectX(EG_GetEnumEffect()))
		call SaveReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xFDF65382, EXGetEffectY(EG_GetEnumEffect()))
		call EC_CreateEffect("Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl" , LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xA99320FA) , LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xFDF65382) , 50.00 , 0.00 , 0.80 , 1.0 , 1.00)
		set ydl_group=CreateGroup()
		call GroupEnumUnitsInRange(ydl_group, EXGetEffectX(EG_GetEnumEffect()), EXGetEffectY(EG_GetEnumEffect()), 200.00, null)
		loop
			set ydl_unit=FirstOfGroup(ydl_group)
			exitwhen ydl_unit == null
			call GroupRemoveUnit(ydl_group, ydl_unit)
			if ( ( IsUnitType(ydl_unit, UNIT_TYPE_ANCIENT) == false ) and ( IsUnitType(ydl_unit, UNIT_TYPE_MECHANICAL) == false ) and ( IsUnitEnemy(ydl_unit, GetOwningPlayer(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9))) == true ) and ( IsUnitAliveBJ(ydl_unit) == true ) ) then
				call SaveUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15, ydl_unit)
				call GroupAddUnit(LoadGroupHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x56E86570), ydl_unit)
				call UnitDamageTarget(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9), ydl_unit, ( ( ( ( GetUnitState(ydl_unit, UNIT_STATE_MAX_LIFE) ) * ( 0.10 ) ) ) + ( ( ( LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0x0BFBB67B) ) * ( 2.00 ) ) ) ), false, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_ACID, WEAPON_TYPE_METAL_HEAVY_BASH)
				call SFB_setBuff(ydl_unit , 0 , 0.60)
				call YDWEFlyEnable(ydl_unit)
				call SaveReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xB259B269, 0.00)
				set ydl_timer=CreateTimer()
				call SaveReal(YDLOC, GetHandleId(ydl_timer), 0xB259B269, LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xB259B269))
				call SaveUnitHandle(YDLOC, GetHandleId(ydl_timer), 0xB3542E15, LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15))
				call TimerStart(ydl_timer, 0.02, true, function Trig_DMboss____________02Func003Func004Func008Func001Func005Func001Func007T)
			else
			endif
		endloop
		call DestroyGroup(ydl_group)
		set Star_EG_ForValue=Star_EG_ForValue + 1
		exitwhen Star_EG_ForValue >= Star_EG_ForIndex
	endloop
	set ydl_group=null
	set ydl_unit=null
	set ydl_timer=null
endfunction
function Trig_DMboss____________02Func003Func005Func007Func001Func011Func016T takes nothing returns nothing
	if ( ( LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xB259B269) >= 20.00 ) ) then
		if ( ( ( GetUnitFlyHeight(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9)) <= ( ( GetUnitDefaultFlyHeight(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9)) ) + ( 100.00 ) ) ) ) ) then
			call SetUnitFlyHeight(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9), ( ( GetUnitDefaultFlyHeight(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9)) ) - ( 0.00 ) ), 0.00)
			call FlushChildHashtable(YDLOC, GetHandleId(GetExpiredTimer()))
			call DestroyTimer(GetExpiredTimer())
		else
			call SetUnitFlyHeight(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9), ( ( GetUnitFlyHeight(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9)) ) - ( 32.00 ) ), 0.00)
		endif
	else
		call SaveReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xB259B269, ( ( LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xB259B269) ) + ( 1.00 ) ))
		if ( ( GetUnitFlyHeight(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9)) >= 500.00 ) ) then
			call SaveReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xB259B269, 20.00)
		else
			call SetUnitFlyHeight(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9), ( ( GetUnitFlyHeight(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9)) ) + ( 25.00 ) ), 0.00)
		endif
	endif
endfunction
function Trig_DMboss____________02Func003Func005Func007Func001Func011Func018T takes nothing returns nothing
 local group ydl_group
 local unit ydl_unit
	//特效删除也会有动画残留，因此设置大小为0
	call EXSetEffectSize(LoadEffectHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x66F185C5), 0.00)
	call SaveEffectHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x62C50DE6, EC_CreateEffect("war3mapImported\\helgate.mdl" , LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xA99320FA) , LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xFDF65382) , 50.00 , 0.00 , 1.25 , 1.40 , 2.00))
	call SaveEffectHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x82AE6639, EC_CreateEffect("Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl" , LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xA99320FA) , LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xFDF65382) , 50.00 , 0.00 , 1.25 , 1.0 , 1.00))
	set ydl_group=CreateGroup()
	call GroupEnumUnitsInRange(ydl_group, LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xA99320FA), LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xFDF65382), 225.00, null)
	loop
		set ydl_unit=FirstOfGroup(ydl_group)
		exitwhen ydl_unit == null
		call GroupRemoveUnit(ydl_group, ydl_unit)
		if ( ( IsUnitAliveBJ(ydl_unit) == true ) and ( IsUnitType(ydl_unit, UNIT_TYPE_ANCIENT) == false ) and ( IsUnitType(ydl_unit, UNIT_TYPE_MECHANICAL) == false ) and ( IsUnitType(ydl_unit, UNIT_TYPE_STRUCTURE) == false ) and ( IsUnitEnemy(ydl_unit, GetOwningPlayer(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9))) == true ) ) then
			call SFB_setSlow(ydl_unit , 0.0 , 0.25 , 1.0)
			call UnitDamageTarget(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9), ydl_unit, ( ( GetUnitState(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9), ConvertUnitState(0x15)) ) * ( 2.20 ) ), false, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_ACID, WEAPON_TYPE_WHOKNOWS)
		else
		endif
	endloop
	call DestroyGroup(ydl_group)
	call FlushChildHashtable(YDLOC, GetHandleId(GetExpiredTimer()))
	call DestroyTimer(GetExpiredTimer())
	set ydl_group=null
	set ydl_unit=null
endfunction
function Trig_DMboss____________02Func003Func005Func007T takes nothing returns nothing
 local group ydl_group
 local unit ydl_unit
 local timer ydl_timer
	if ( ( ( UnitHasBuffBJ(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9), udg_MFXG[0]) == true ) or ( UnitHasBuffBJ(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9), udg_MFXG[1]) == true ) or ( UnitHasBuffBJ(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9), udg_MFXG[2]) == true ) or ( UnitHasBuffBJ(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9), udg_MFXG[3]) == true ) or ( UnitHasBuffBJ(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9), udg_MFXG[4]) == true ) or ( UnitHasBuffBJ(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9), udg_MFXG[5]) == true ) or ( UnitHasBuffBJ(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9), udg_MFXG[7]) == true ) or ( UnitHasBuffBJ(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9), udg_MFXG[8]) == true ) or ( UnitHasBuffBJ(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9), udg_MFXG[9]) == true ) or ( IsUnitDeadBJ(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9)) == true ) ) and ( LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xCEA5D211) >= 8.00 ) ) then
		call SetUnitInvulnerable(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9), false)
		call PauseUnit(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9), false)
		call FlushChildHashtable(YDLOC, GetHandleId(GetExpiredTimer()))
		call DestroyTimer(GetExpiredTimer())
	else
		//施法途中持续无敌和暂停
		call SetUnitInvulnerable(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9), true)
		call PauseUnit(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9), true)
		//播放动作和寻找目标
		call SaveReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xCEA5D211, ( ( LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xCEA5D211) ) + ( 1.00 ) ))
		set ydl_group=CreateGroup()
		call GroupEnumUnitsInRange(ydl_group, GetUnitX(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9)), GetUnitY(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9)), 1800.00, null)
		loop
			set ydl_unit=FirstOfGroup(ydl_group)
			exitwhen ydl_unit == null
			call GroupRemoveUnit(ydl_group, ydl_unit)
			if ( ( IsUnitInGroup(ydl_unit, LoadGroupHandle(YDHT, StringHash("玩家英雄"), 0x0A4A1F64)) == true ) and ( IsUnitType(ydl_unit, UNIT_TYPE_ANCIENT) == false ) and ( IsUnitAliveBJ(ydl_unit) == true ) and ( IsUnitEnemy(ydl_unit, GetOwningPlayer(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9))) == true ) ) then
				call SaveUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xD84480C3, ydl_unit)
				call SaveReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xA99320FA, GetUnitX(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xD84480C3)))
				call SaveReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xFDF65382, GetUnitY(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xD84480C3)))
				exitwhen true
			else
			endif
		endloop
		call DestroyGroup(ydl_group)
		if ( ( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xD84480C3) != null ) ) then
			call SaveInteger(YDLOC, GetHandleId(GetExpiredTimer()), 0x437E2A40, GetRandomInt(1, 4))
			if ( ( LoadInteger(YDLOC, GetHandleId(GetExpiredTimer()), 0x437E2A40) == 1 ) ) then
				call PlaySoundOnUnitBJ(gg_snd_tenshi4, 100, LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9))
			else
				if ( ( LoadInteger(YDLOC, GetHandleId(GetExpiredTimer()), 0x437E2A40) == 2 ) ) then
					call PlaySoundOnUnitBJ(gg_snd_tenshi5, 100, LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9))
				else
					if ( ( LoadInteger(YDLOC, GetHandleId(GetExpiredTimer()), 0x437E2A40) >= 3 ) ) then
						call PlaySoundOnUnitBJ(gg_snd_tenshi6, 100, LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9))
					else
					endif
				endif
			endif
			//闪光蓄力特效
			call YDWETimerDestroyEffect(1.00 , AddSpecialEffectTarget("war3mapImported\\a.mdx", LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9), "origin"))
			//符咒音效
			call SaveEffectHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x3D91B70E, EC_CreateEffect("Abilities\\Spells\\Other\\Charm\\CharmTarget.mdl" , GetUnitX(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9)) , GetUnitY(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9)) , 50.00 , 0.00 , 0.00 , 1.0 , 0.50))
			call SetUnitAnimationByIndex(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9), 7)
			//基础设置
			call SaveReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xB9A583B8, YDWEAngleBetweenUnits(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9) , LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xD84480C3)))
			call SaveReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xE978590C, YDWEDistanceBetweenUnits(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9) , LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xD84480C3)))
			call SaveEffectHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x66F185C5, EC_CreateEffect("war3mapImported\\mr.war3_ring.mdl" , GetUnitX(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xD84480C3)) , GetUnitY(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xD84480C3)) , 50.00 , 0.00 , 1.00 , 0.80 , 0.50))
			//跳跃+冲锋
			call StarChargeI(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9) , LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xB9A583B8) , LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xE978590C) , 0.60 , 64.0 , 0.00 , false)
			call SaveReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xB259B269, 0.00)
			set ydl_timer=CreateTimer()
			call SaveUnitHandle(YDLOC, GetHandleId(ydl_timer), 0x458B7DE9, LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9))
			call SaveReal(YDLOC, GetHandleId(ydl_timer), 0xB259B269, LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xB259B269))
			call TimerStart(ydl_timer, 0.02, true, function Trig_DMboss____________02Func003Func005Func007Func001Func011Func016T)
			//造成伤害
			set ydl_timer=CreateTimer()
			call SaveUnitHandle(YDLOC, GetHandleId(ydl_timer), 0x458B7DE9, LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9))
			call SaveReal(YDLOC, GetHandleId(ydl_timer), 0xA99320FA, LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xA99320FA))
			call SaveReal(YDLOC, GetHandleId(ydl_timer), 0xFDF65382, LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xFDF65382))
			call SaveEffectHandle(YDLOC, GetHandleId(ydl_timer), 0x66F185C5, LoadEffectHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x66F185C5))
			call TimerStart(ydl_timer, 0.60, false, function Trig_DMboss____________02Func003Func005Func007Func001Func011Func018T)
		else
			call DoNothing()
		endif
		//全部次数释放完毕后提前结束
		if ( ( LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xCEA5D211) >= LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0x49094E40) ) ) then
			call SetUnitInvulnerable(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9), false)
			call PauseUnit(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9), false)
			call FlushChildHashtable(YDLOC, GetHandleId(GetExpiredTimer()))
			call DestroyTimer(GetExpiredTimer())
		else
		endif
	endif
	set ydl_group=null
	set ydl_unit=null
	set ydl_timer=null
endfunction
function Trig_DMboss____________02Func003Func006Func006T takes nothing returns nothing
 local group ydl_group
 local unit ydl_unit
	call PlaySoundOnUnitBJ(gg_snd_tenshi3, 100, LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9))
	call ShowUnit(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9), true)
	call SetUnitInvulnerable(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9), false)
	call PauseUnit(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9), false)
	//特效删除也会有动画残留，因此设置大小为0
	call EXSetEffectSize(LoadEffectHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x66F185C5), 0.00)
	call SaveEffectHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x62C50DE6, EC_CreateEffect("war3mapImported\\helgate.mdl" , GetUnitX(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9)) , GetUnitY(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9)) , 50.00 , 0.00 , 6.00 , 1.40 , 2.00))
	call SaveEffectHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x82AE6639, EC_CreateEffect("Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl" , GetUnitX(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9)) , GetUnitY(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9)) , 50.00 , 0.00 , 6.00 , 1.0 , 1.00))
	set ydl_group=CreateGroup()
	call GroupEnumUnitsInRange(ydl_group, GetUnitX(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9)), GetUnitY(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9)), 2000.00, null)
	loop
		set ydl_unit=FirstOfGroup(ydl_group)
		exitwhen ydl_unit == null
		call GroupRemoveUnit(ydl_group, ydl_unit)
		if ( ( IsUnitAliveBJ(ydl_unit) == true ) and ( IsUnitType(ydl_unit, UNIT_TYPE_ANCIENT) == false ) and ( IsUnitType(ydl_unit, UNIT_TYPE_MECHANICAL) == false ) and ( IsUnitType(ydl_unit, UNIT_TYPE_STRUCTURE) == false ) and ( IsUnitEnemy(ydl_unit, GetOwningPlayer(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9))) == true ) ) then
			//该技能可以破无敌+消除正面buff
			call SetUnitInvulnerable(ydl_unit, false)
			call UnitRemoveBuffsEx(ydl_unit, true, false, false, false, false, false, true)
			call SaveUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x911D5DC2, ydl_unit)
			call SaveReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xE978590C, YDWEDistanceBetweenUnits(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9) , LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x911D5DC2)))
			//每离开一定距离减少4%伤害
			call SaveReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xEC2E7F98, ( ( ( ( LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xE978590C) ) / ( 100.00 ) ) ) * ( 0.03 ) ))
			call SaveReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xF72F08DF, ( ( GetUnitState(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x911D5DC2), UNIT_STATE_MAX_LIFE) ) * ( ( ( 1.00 ) - ( LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xEC2E7F98) ) ) ) ))
			call UnitDamageTarget(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9), LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x911D5DC2), LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xF72F08DF), false, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_ENHANCED, WEAPON_TYPE_WHOKNOWS)
		else
		endif
	endloop
	call DestroyGroup(ydl_group)
	call FlushChildHashtable(YDLOC, GetHandleId(GetExpiredTimer()))
	call DestroyTimer(GetExpiredTimer())
	set ydl_group=null
	set ydl_unit=null
endfunction
function Trig_DMboss____________02Func003Func007Func007T takes nothing returns nothing
	if ( ( ( IsUnitPausedBJ(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9)) == true ) or ( UnitHasBuffBJ(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9), 'BSTN') == true ) or ( UnitHasBuffBJ(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9), 'BPSE') == true ) or ( LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xCEA5D211) >= 8.00 ) ) ) then
		call SaveReal(YDHT, GetHandleId(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x034BCDB1)), 0x1F1488CA, 0.00)
		call SetUnitTimeScale(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9), 1.00)
		call GS_Suspend(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9) , 0.00)
		call SaveReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xCEA5D211, 8.00)
		call FlushChildHashtable(YDLOC, GetHandleId(GetExpiredTimer()))
		call DestroyTimer(GetExpiredTimer())
	else
		call SetUnitAnimationByIndex(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9), 1)
		call SaveReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xCEA5D211, ( ( LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xCEA5D211) ) + ( 1.00 ) ))
		call SetUnitLifePercentBJ(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9), ( ( GetUnitLifePercent(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9)) ) + ( 9.00 ) ))
		call YDWETimerDestroyEffect(1.00 , AddSpecialEffectTarget("Abilities\\Spells\\NightElf\\Rejuvenation\\RejuvenationTarget.mdl", LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9), "origin"))
		call YDWETimerDestroyEffect(1.00 , AddSpecialEffectTarget("Abilities\\Spells\\Human\\HolyBolt\\HolyBoltSpecialArt.mdl", LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9), "overhead"))
		call YDWETimerDestroyEffect(1.00 , AddSpecialEffectTarget("Abilities\\Spells\\Orc\\HealingWave\\HealingWaveTarget.mdl", LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9), "origin"))
