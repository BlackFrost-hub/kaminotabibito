				call SaveUnitHandle(YDLOC, GetHandleId(ydl_timer), 0x458B7DE9, GetTriggerUnit())
				call SaveReal(YDLOC, GetHandleId(ydl_timer), 0xD92E3573, LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xD92E3573))
