function Trig_____________2_004Func001Func005T takes nothing returns nothing
 local group ydl_group
 local unit ydl_unit
	call EC_CreateEffect("Abilities\\Spells\\NightElf\\EntanglingRoots\\EntanglingRootsTarget.mdl" , LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xA99320FA) , LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xFDF65382) , 0.0 , 270.0 , 2.00 , 1.0 , 1.50)
