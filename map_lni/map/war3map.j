			if ( ( LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xAF616D00) > 73 ) and ( LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xAF616D00) <= 83 ) ) then
				if ( ( GetHeroLevel(GetTriggerUnit()) <= 15 ) ) then
