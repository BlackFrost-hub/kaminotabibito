//===========================================================================
// Trigger: GameTimeEvent
//===========================================================================
function Trig_GameTimeEventFunc005A takes nothing returns nothing
	call SaveUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7), 0xB3542E15, GetEnumUnit())
	if ( ( UnitHasBuffBJ(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7), 0xB3542E15), 'B00M') == true ) ) then
		if ( ( YDWEUnitHasItemOfTypeBJNull(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7), 0xB3542E15) , 'I03J') == true ) ) then
			call SetUnitState(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7), 0xB3542E15), UNIT_STATE_MANA, ( ( GetUnitState(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7), 0xB3542E15), UNIT_STATE_MANA) ) - ( 12.00 ) ))
		else
			call SetUnitState(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7), 0xB3542E15), UNIT_STATE_MANA, ( ( GetUnitState(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7), 0xB3542E15), UNIT_STATE_MANA) ) - ( 24.00 ) ))
		endif
	else
	endif
endfunction
function Trig_GameTimeEventActions takes nothing returns nothing
 local integer ydl_localvar_step= LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xCFDE6C76)
 set ydl_localvar_step=ydl_localvar_step + 3
 call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xCFDE6C76, ydl_localvar_step)
 call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7, ydl_localvar_step)
	//精灵湖
	if ( ( IsUnitAliveBJ(LoadUnitHandle(YDHT, StringHash("植物"), 0xCB31EDE4)) == true ) ) then
		if ( ( GetTimeOfDay() >= 8.00 ) and ( GetTimeOfDay() <= 15.00 ) ) then
			call ShowUnit(LoadUnitHandle(YDHT, StringHash("植物"), 0xCB31EDE4), true)
		else
			call ShowUnit(LoadUnitHandle(YDHT, StringHash("植物"), 0xCB31EDE4), false)
		endif
	else
	endif
	//沙漠
	if ( ( IsQuestCompleted(udg_RW[2]) == false ) and ( IsQuestDiscovered(udg_RW[2]) == true ) and ( IsUnitAliveBJ(LoadUnitHandle(YDHT, StringHash("Boss"), 0x6BDDBD5B)) == true ) and ( ( GetTimeOfDay() >= 19.00 ) or ( GetTimeOfDay() <= 4.00 ) ) ) then
		if ( ( LoadBoolean(YDHT, GetHandleId(LoadUnitHandle(YDHT, StringHash("Boss"), 0x6BDDBD5B)), 0xFE68AB44) == false ) ) then
			call SaveBoolean(YDHT, GetHandleId(LoadUnitHandle(YDHT, StringHash("Boss"), 0x6BDDBD5B)), 0xFE68AB44, true)
			call ShowUnitShow(LoadUnitHandle(YDHT, StringHash("Boss"), 0x6BDDBD5B))
			call SetUnitInvulnerable(LoadUnitHandle(YDHT, StringHash("Boss"), 0x6BDDBD5B), false)
			call SaveLocationHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x5B0D7524, GetRandomLocInRect(gg_rct______________055))
			call SetUnitPositionLoc(LoadUnitHandle(YDHT, StringHash("Boss"), 0x6BDDBD5B), LoadLocationHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x5B0D7524))
			call RemoveLocation(LoadLocationHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x5B0D7524))
		else
		endif
	else
		if ( ( LoadUnitHandle(YDHT, StringHash("Boss战"), 0x62274AD0) == null ) ) then
			call SaveBoolean(YDHT, GetHandleId(LoadUnitHandle(YDHT, StringHash("Boss"), 0x6BDDBD5B)), 0xFE68AB44, false)
			call ShowUnitHide(LoadUnitHandle(YDHT, StringHash("Boss"), 0x6BDDBD5B))
			call SetUnitInvulnerable(LoadUnitHandle(YDHT, StringHash("Boss"), 0x6BDDBD5B), true)
		else
		endif
	endif
	call ForGroupBJ(LoadGroupHandle(YDHT, StringHash("玩家英雄"), 0x0A4A1F64), function Trig_GameTimeEventFunc005A)
	call FlushChildHashtable(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step)
endfunction
//===========================================================================
function InitTrig_GameTimeEvent takes nothing returns nothing
	set gg_trg_GameTimeEvent=CreateTrigger()
	call TriggerRegisterTimerEventPeriodic(gg_trg_GameTimeEvent, 10.00)
	call TriggerAddAction(gg_trg_GameTimeEvent, function Trig_GameTimeEventActions)
endfunction
function Trig_DMboss______01Func002Func009Func001Func019T takes nothing returns nothing
    call ConditionalTriggerExecute(gg_trg_Boss____________u)
    call FlushChildHashtable(YDLOC, GetHandleId(GetExpiredTimer()))
    call DestroyTimer(GetExpiredTimer())
endfunction
function Trig_DMboss______01Func002Func009T takes nothing returns nothing
    local timer ydl_timer
    if ( ( 10 >= 10 ) ) then
        // 获取Boss
        call SaveReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xA99320FA, 26468.00)
        call SaveReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xFDF65382, 20612.50)
        call SaveStr(YDLOC, GetHandleId(GetExpiredTimer()), 0x2D1FF186, SSRP_PoolGetString(LoadInteger(YDHT, StringHash("异界Boss"), 0x040253F0)))
        if ( ( LoadStr(YDLOC, GetHandleId(GetExpiredTimer()), 0x2D1FF186) == "赫萝" ) ) then
            call SaveUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x76ABBC1D, CreateUnit(Player(PLAYER_NEUTRAL_AGGRESSIVE), 'E07E', LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xA99320FA), LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xFDF65382), 270.00))
        else
            if ( ( LoadStr(YDLOC, GetHandleId(GetExpiredTimer()), 0x2D1FF186) == "克洛克达尔" ) ) then
                call SaveUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x76ABBC1D, CreateUnit(Player(PLAYER_NEUTRAL_AGGRESSIVE), 'E079', LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xA99320FA), LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xFDF65382), 270.00))
            else
                if ( ( LoadStr(YDLOC, GetHandleId(GetExpiredTimer()), 0x2D1FF186) == "萨菲罗斯" ) ) then
                    call SaveUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x76ABBC1D, CreateUnit(Player(PLAYER_NEUTRAL_AGGRESSIVE), 'O005', LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xA99320FA), LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xFDF65382), 270.00))
                else
                    if ( ( LoadStr(YDLOC, GetHandleId(GetExpiredTimer()), 0x2D1FF186) == "天子" ) ) then
                        call SaveUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x76ABBC1D, CreateUnit(Player(PLAYER_NEUTRAL_AGGRESSIVE), 'E07X', LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xA99320FA), LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xFDF65382), 270.00))
                    else
                    endif
                endif
            endif
        endif
        call SSRP_PoolRemoveString(LoadInteger(YDHT, StringHash("异界Boss"), 0x040253F0) , LoadStr(YDLOC, GetHandleId(GetExpiredTimer()), 0x2D1FF186))
        call GroupAddUnit(LoadGroupHandle(YDHT, StringHash("血条Boss"), 0x0A4A1F64), LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x76ABBC1D))
        call TriggerRegisterUnitEvent(gg_trg_DM____________PGCF001, LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x76ABBC1D), EVENT_UNIT_DAMAGED)
        call TriggerRegisterUnitEvent(gg_trg_DM__________________SDSH002, LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x76ABBC1D), EVENT_UNIT_DAMAGED)
        call TriggerRegisterUnitEvent(gg_trg_DMboss____________01, LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x76ABBC1D), EVENT_UNIT_SPELL_EFFECT)
        call TriggerRegisterUnitEvent(gg_trg_DMboss____________02, LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x76ABBC1D), EVENT_UNIT_SPELL_FINISH)
        call TriggerRegisterUnitEvent(gg_trg_DMboss____________03, LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x76ABBC1D), EVENT_UNIT_SPELL_CAST)
        call TriggerRegisterUnitEvent(gg_trg_DMboss____________03, LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x76ABBC1D), EVENT_UNIT_SPELL_ENDCAST)
        // 绑定并注册Boss的属性
        call SaveUnitHandle(YDHT, StringHash("Boss战"), 0x5A47F98D, LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xAA8F29DD))
        call SaveUnitHandle(YDHT, StringHash("Boss战"), 0x4F42CF89, LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x76ABBC1D))
        call PauseUnit(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x76ABBC1D), true)
        call SetUnitState(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x76ABBC1D), ConvertUnitState(0x12), LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0x301CC1D8))
        call SaveReal(YDHT, GetHandleId(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x76ABBC1D)), 0xEBBDD513, LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0x057FBEB6))
        // 根据难度设置生命值属性
        if ( ( udg_N <= 1.00 ) ) then
            call SetUnitState(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x76ABBC1D), UNIT_STATE_MAX_LIFE, ( ( LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xABDBC9B6) ) * ( 1.00 ) ))
        else
            if ( ( udg_N == 2.00 ) ) then
                call SetUnitState(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x76ABBC1D), UNIT_STATE_MAX_LIFE, ( ( LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xABDBC9B6) ) * ( 1.20 ) ))
            else
                if ( ( udg_N == 3.00 ) ) then
                    call SetUnitState(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x76ABBC1D), UNIT_STATE_MAX_LIFE, ( ( LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xABDBC9B6) ) * ( 1.50 ) ))
                else
                    if ( ( udg_N == 4.00 ) ) then
                        call SetUnitState(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x76ABBC1D), UNIT_STATE_MAX_LIFE, ( ( LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xABDBC9B6) ) * ( 2.00 ) ))
                    else
                        if ( ( udg_N == 5.00 ) ) then
                            call SetUnitState(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x76ABBC1D), UNIT_STATE_MAX_LIFE, ( ( LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xABDBC9B6) ) * ( 2.60 ) ))
                        else
                            if ( ( udg_N == 6.00 ) ) then
                                call SetUnitState(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x76ABBC1D), UNIT_STATE_MAX_LIFE, ( ( LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xABDBC9B6) ) * ( 3.20 ) ))
                            else
                            endif
                        endif
                    endif
                endif
            endif
            call SetUnitLifePercentBJ(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x76ABBC1D), 100)
        endif
        // 给个延迟记录Boss战的战斗音乐
        set ydl_timer=CreateTimer()
        call TimerStart(ydl_timer, 0.10, false, function Trig_DMboss______01Func002Func009Func001Func019T)
    else
    endif
    call FlushChildHashtable(YDLOC, GetHandleId(GetExpiredTimer()))
    call DestroyTimer(GetExpiredTimer())
    set ydl_timer=null
endfunction
function Trig_DMboss______01Actions takes nothing returns nothing
    local group ydl_group
    local unit ydl_unit
    local timer ydl_timer
    local integer ydl_localvar_step= LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xCFDE6C76)
 set ydl_localvar_step=ydl_localvar_step + 3
 call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xCFDE6C76, ydl_localvar_step)
 call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7, ydl_localvar_step)
    call SaveUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xAA8F29DD, GetTriggerUnit())
    if ( ( ( GetItemTypeId(GetManipulatedItem()) == 'I0BA' ) or ( GetItemTypeId(GetManipulatedItem()) == 'I0BB' ) or ( GetItemTypeId(GetManipulatedItem()) == 'I0B8' ) or ( GetItemTypeId(GetManipulatedItem()) == 'I0B9' ) ) ) then
        call SavePlayerHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x48E3E75F, GetOwningPlayer(GetTriggerUnit()))
        call SaveBoolean(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x21FDBC69, false)
        call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xB0497EE9, GetItemTypeId(GetManipulatedItem()))
        if ( ( LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xB0497EE9) == 'I0BA' ) ) then
            if ( ( GetHeroLevel(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xAA8F29DD)) > 25 ) ) then
                call SaveBoolean(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x21FDBC69, true)
            else
            endif
        else
        endif
        if ( ( LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xB0497EE9) == 'I0BB' ) ) then
            if ( ( GetHeroLevel(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xAA8F29DD)) > 35 ) ) then
                call SaveBoolean(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x21FDBC69, true)
            else
            endif
        else
        endif
        if ( ( LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xB0497EE9) == 'I0B8' ) ) then
            if ( ( GetHeroLevel(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xAA8F29DD)) > 45 ) ) then
                call SaveBoolean(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x21FDBC69, true)
            else
            endif
        else
        endif
        if ( ( LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xB0497EE9) == 'I0B9' ) ) then
            if ( ( GetHeroLevel(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xAA8F29DD)) > 55 ) ) then
                call SaveBoolean(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x21FDBC69, true)
            else
            endif
        else
        endif
        if ( ( LoadBoolean(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x21FDBC69) == true ) ) then
            // 常量：|cffffff00『系统消息』|r：你的等级超过了|cffff0000挑战需求等级|r！无法挑战
            call QuestMessageBJ(GetPlayersAll(), bj_QUESTMESSAGE_WARNING, "|cffffff00『系统消息』|r：你的等级超过了|cffff0000挑战需求等级|r！无法挑战")
            set ydl_group=CreateGroup()
            call GroupEnumUnitsInRange(ydl_group, GetUnitX(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xAA8F29DD)), GetUnitY(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xAA8F29DD)), 1200.00, null)
            loop
                set ydl_unit=FirstOfGroup(ydl_group)
                exitwhen ydl_unit == null
                call GroupRemoveUnit(ydl_group, ydl_unit)
                if ( ( GetUnitTypeId(ydl_unit) == 'hvlt' ) ) then
                    call AddItemToStockBJ(LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xB0497EE9), ydl_unit, 1, 1)
                    // 重新给商店添加物品，并且跳过剩余动作
                    call FlushChildHashtable(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step)
                    set ydl_group=null
                    set ydl_unit=null
                    set ydl_timer=null
                    return
                else
                endif
            endloop
            call DestroyGroup(ydl_group)
        else
        endif
        set ydl_group=CreateGroup()
        call GroupEnumUnitsInRange(ydl_group, GetUnitX(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xAA8F29DD)), GetUnitY(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xAA8F29DD)), 1000.00, null)
        loop
            set ydl_unit=FirstOfGroup(ydl_group)
            exitwhen ydl_unit == null
            call GroupRemoveUnit(ydl_group, ydl_unit)
            if ( ( GetUnitTypeId(ydl_unit) == 'hvlt' ) ) then
                call SetUnitOwner(ydl_unit, Player(6), true)
            else
            endif
        endloop
        call DestroyGroup(ydl_group)
        if ( ( ( LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xB0497EE9) == 'I0BA' ) or ( LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xB0497EE9) == 'I0BB' ) or ( LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xB0497EE9) == 'I0B8' ) or ( LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xB0497EE9) == 'I0B9' ) ) ) then
            if ( ( LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xB0497EE9) == 'I0BA' ) ) then
                call SaveReal(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xB8C06104, 1.00)
                call SaveReal(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xABDBC9B6, 8000.00)
                call SaveReal(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x057FBEB6, 50.00)
                call SaveReal(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x301CC1D8, 250.00)
            else
                if ( ( LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xB0497EE9) == 'I0BB' ) ) then
                    call SaveReal(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xB8C06104, 2.00)
                    call SaveReal(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xABDBC9B6, 13000.00)
                    call SaveReal(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x057FBEB6, 100.00)
                    call SaveReal(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x301CC1D8, 450.00)
                else
                    if ( ( LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xB0497EE9) == 'I0B8' ) ) then
                        call SaveReal(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xB8C06104, 3.00)
                        call SaveReal(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xABDBC9B6, 24000.00)
                        call SaveReal(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x057FBEB6, 200.00)
                        call SaveReal(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x301CC1D8, 750.00)
                    else
                        if ( ( LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xB0497EE9) == 'I0B9' ) ) then
                            call SaveReal(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xB8C06104, 4.00)
                            call SaveReal(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xABDBC9B6, 32000.00)
                            call SaveReal(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x057FBEB6, 250.00)
                            call SaveReal(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x301CC1D8, 950.00)
                        else
                        endif
                    endif
                endif
            endif
        else
        endif
        call StarExecuteEvent("异界Boss背景框" , false)
        // 获取Boss  6.6秒是转场画面时间
        set ydl_timer=CreateTimer()
        call SaveUnitHandle(YDLOC, GetHandleId(ydl_timer), 0x76ABBC1D, LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x76ABBC1D))
        call SaveUnitHandle(YDLOC, GetHandleId(ydl_timer), 0xAA8F29DD, LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xAA8F29DD))
        call SaveReal(YDLOC, GetHandleId(ydl_timer), 0xA99320FA, LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xA99320FA))
        call SaveReal(YDLOC, GetHandleId(ydl_timer), 0xFDF65382, LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xFDF65382))
        call SaveStr(YDLOC, GetHandleId(ydl_timer), 0x2D1FF186, LoadStr(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x2D1FF186))
        call SaveReal(YDLOC, GetHandleId(ydl_timer), 0xABDBC9B6, LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xABDBC9B6))
        call SaveReal(YDLOC, GetHandleId(ydl_timer), 0x057FBEB6, LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x057FBEB6))
        call SaveReal(YDLOC, GetHandleId(ydl_timer), 0x301CC1D8, LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0x301CC1D8))
        call TimerStart(ydl_timer, 6.60, false, function Trig_DMboss______01Func002Func009T)
        call YDWETimerRemoveItem(4.00 , GetManipulatedItem())
    else
        call FlushChildHashtable(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step)
        set ydl_group=null
        set ydl_unit=null
        set ydl_timer=null
        return
    endif
    call FlushChildHashtable(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step)
    set ydl_group=null
    set ydl_unit=null
    set ydl_timer=null
endfunction
