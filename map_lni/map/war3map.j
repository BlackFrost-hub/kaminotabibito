//===========================================================================
// Trigger: 英雄学习技能事件SJ
//===========================================================================
function Trig_________________________SJConditions takes nothing returns boolean
	return ( ( IsUnitType(GetTriggerUnit(), UNIT_TYPE_HERO) == true ) )
endfunction
function Trig_________________________SJActions takes nothing returns nothing
 local integer ydl_localvar_step= LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xCFDE6C76)
 set ydl_localvar_step=ydl_localvar_step + 3
 call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xCFDE6C76, ydl_localvar_step)
 call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7, ydl_localvar_step)
	if ( ( GetLearnedSkill() == 'A004' ) ) then
		call IncUnitAbilityLevel(GetTriggerUnit(), 'A009')
	else
	endif
	if ( ( GetLearnedSkill() == 'A0KB' ) ) then
		call YDWEGeneralBounsSystemUnitSetBonus(GetTriggerUnit() , 3 , 0 , 25)
	else
	endif
	if ( ( GetLearnedSkill() == 'A0JD' ) ) then
		call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xC891AEE2, GetUnitAbilityLevel(GetTriggerUnit(), GetLearnedSkill()))
		if ( ( GetUnitAbilityLevel(GetTriggerUnit(), 'A0JD') <= 1 ) ) then
			call UnitAddAbility(GetTriggerUnit(), 'A0CL')
			call SetPlayerAbilityAvailable(GetOwningPlayer(GetTriggerUnit()), 'A0CL', false)
		else
		endif
		call SetUnitAbilityLevel(GetTriggerUnit(), 'A0CL', ( ( LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step, 0xC891AEE2) ) + ( 1 ) ))
	else
	endif
	if ( ( GetLearnedSkill() == 'A0JE' ) ) then
		call ModifyHeroStat(bj_HEROSTAT_AGI, GetTriggerUnit(), bj_MODIFYMETHOD_ADD, 5)
	else
	endif
	if ( ( GetLearnedSkill() == 'A0JX' ) ) then
		if ( ( GetUnitAbilityLevel(GetTriggerUnit(), 'A0JX') <= 1 ) ) then
			call SaveReal(YDHT, GetHandleId(GetOwningPlayer(GetTriggerUnit())), 0xE63D3789, ( ( LoadReal(YDHT, GetHandleId(GetOwningPlayer(GetTriggerUnit())), 0xE63D3789) ) + ( 0.10 ) ))
		else
		endif
		call SaveReal(YDHT, GetHandleId(GetOwningPlayer(GetTriggerUnit())), 0xE63D3789, ( ( LoadReal(YDHT, GetHandleId(GetOwningPlayer(GetTriggerUnit())), 0xE63D3789) ) + ( 0.03 ) ))
	else
	endif
	if ( ( GetLearnedSkill() == 'A0JY' ) ) then
		call ModifyHeroStat(bj_HEROSTAT_INT, GetTriggerUnit(), bj_MODIFYMETHOD_ADD, 8)
		if ( ( GetUnitAbilityLevel(GetTriggerUnit(), 'A0JY') > 9 ) ) then
			call ModifyHeroStat(bj_HEROSTAT_INT, GetTriggerUnit(), bj_MODIFYMETHOD_ADD, 7)
		else
		endif
		call SaveReal(YDHT, GetHandleId(GetOwningPlayer(GetTriggerUnit())), 0xA6833D44, ( ( LoadReal(YDHT, GetHandleId(GetOwningPlayer(GetTriggerUnit())), 0xA6833D44) ) + ( 0.01 ) ))
	else
	endif
	if ( ( GetLearnedSkill() == 'A0JT' ) and ( GetUnitAbilityLevel(GetTriggerUnit(), 'A0JT') <= 1 ) ) then
		call UnitAddAbility(GetTriggerUnit(), 'A0JR')
		call UnitAddAbility(GetTriggerUnit(), 'A0JQ')
		call UnitAddAbility(GetTriggerUnit(), 'A0JS')
		call SetPlayerAbilityAvailable(GetOwningPlayer(GetTriggerUnit()), 'A0JQ', false)
		call SetPlayerAbilityAvailable(GetOwningPlayer(GetTriggerUnit()), 'A0JR', false)
		call SetPlayerAbilityAvailable(GetOwningPlayer(GetTriggerUnit()), 'A0JS', false)
	else
	endif
	if ( ( GetLearnedSkill() == 'A0JM' ) ) then
		if ( ( GetUnitAbilityLevel(GetTriggerUnit(), 'A0JM') <= 1 ) ) then
			call SaveReal(YDHT, GetHandleId(GetOwningPlayer(GetTriggerUnit())), 0xAF04E5E0, ( ( LoadReal(YDHT, GetHandleId(GetOwningPlayer(GetTriggerUnit())), 0xAF04E5E0) ) + ( 0.03 ) ))
			call SaveReal(YDHT, GetHandleId(GetOwningPlayer(GetTriggerUnit())), 0x9320F403, ( ( LoadReal(YDHT, GetHandleId(GetOwningPlayer(GetTriggerUnit())), 0x9320F403) ) + ( 0.03 ) ))
		else
		endif
		call SaveReal(YDHT, GetHandleId(GetOwningPlayer(GetTriggerUnit())), 0xAF04E5E0, ( ( LoadReal(YDHT, GetHandleId(GetOwningPlayer(GetTriggerUnit())), 0xAF04E5E0) ) + ( 0.01 ) ))
		call SaveReal(YDHT, GetHandleId(GetOwningPlayer(GetTriggerUnit())), 0xA5D6ED7E, ( ( LoadReal(YDHT, GetHandleId(GetOwningPlayer(GetTriggerUnit())), 0xA5D6ED7E) ) + ( 0.01 ) ))
	else
	endif
	if ( ( GetLearnedSkill() == 'A0JH' ) and ( GetUnitAbilityLevel(GetTriggerUnit(), 'A0JH') <= 1 ) ) then
		call UnitAddAbility(GetTriggerUnit(), 'A0JJ')
		call UnitAddAbility(GetTriggerUnit(), 'A0JI')
		call UnitAddAbility(GetTriggerUnit(), 'A0JK')
		call SetPlayerAbilityAvailable(GetOwningPlayer(GetTriggerUnit()), 'A0JJ', false)
		call SetPlayerAbilityAvailable(GetOwningPlayer(GetTriggerUnit()), 'A0JI', false)
		call SetPlayerAbilityAvailable(GetOwningPlayer(GetTriggerUnit()), 'A0JK', false)
	else
	endif
	if ( ( GetUnitTypeId(GetTriggerUnit()) == 'H00I' ) ) then
		call SaveReal(YDHT, GetHandleId(GetOwningPlayer(GetTriggerUnit())), 0x4D696D8F, ( ( LoadReal(YDHT, GetHandleId(GetOwningPlayer(GetTriggerUnit())), 0x4D696D8F) ) + ( 0.01 ) ))
	else
	endif
	call FlushChildHashtable(YDLOC, GetHandleId(GetTriggeringTrigger()) * ydl_localvar_step)
endfunction
//===========================================================================
function InitTrig_________________________SJ takes nothing returns nothing
	set gg_trg_________________________SJ=CreateTrigger()
	call TriggerAddCondition(gg_trg_________________________SJ, Condition(function Trig_________________________SJConditions))
	call TriggerAddAction(gg_trg_________________________SJ, function Trig_________________________SJActions)
endfunction
//===========================================================================
// Trigger: 敌对伤害事件SH
//===========================================================================
function Trig___________________SHConditions takes nothing returns boolean
	return ( ( YDWEIsEventDamageType(DAMAGE_TYPE_MIND) == false ) ) and ( ( GetEventDamage() >= 1.00 ) )
endfunction
function Trig___________________SHFunc003Func003003003 takes nothing returns boolean
	return ( ( GetUnitFlyHeight(GetEnumUnit()) <= 250.00 ) and ( ( IsUnitType(GetTriggerUnit(), UNIT_TYPE_MECHANICAL) == false ) and ( ( IsUnitType(GetTriggerUnit(), UNIT_TYPE_ANCIENT) == false ) and ( ( IsUnitEnemy(GetFilterUnit(), GetTriggerPlayer()) == true ) and ( IsUnitAliveBJ(GetFilterUnit()) == true ) ) ) ) )
endfunction
function Trig___________________SHFunc005Func006Func001T takes nothing returns nothing
	if ( ( ( UnitHasBuffBJ(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9), udg_MFXG[1]) == true ) or ( UnitHasBuffBJ(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9), udg_MFXG[2]) == true ) or ( UnitHasBuffBJ(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9), udg_MFXG[3]) == true ) or ( LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xCEA5D211) >= 30.00 ) ) ) then
		call DestroyEffect(LoadEffectHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xBC260E9E))
		call FlushChildHashtable(YDLOC, GetHandleId(GetExpiredTimer()))
		call DestroyTimer(GetExpiredTimer())
	else
		call SaveReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xCEA5D211, ( ( LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xCEA5D211) ) + ( 1.00 ) ))
		call SaveBoolean(YDHT, GetHandleId(LoadUnitHandle(YDHT, StringHash("Boss"), 0x6BDDBD5B)), 0x5C094260, false)
		call DzSetEffectPos(LoadEffectHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xBC260E9E), GetUnitX(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9)), GetUnitY(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9)), 400.00)
	endif
endfunction
function Trig___________________SHFunc005Func007T takes nothing returns nothing
	call SaveBoolean(YDHT, GetHandleId(LoadUnitHandle(YDHT, StringHash("Boss"), 0x6BDDBD5B)), 0x53B09CD0, true)
	call FlushChildHashtable(YDLOC, GetHandleId(GetExpiredTimer()))
	call DestroyTimer(GetExpiredTimer())
endfunction
function Trig___________________SHFunc007Func002Func016Func002Func001Func009003003 takes nothing returns boolean
	return ( ( GetUnitFlyHeight(GetFilterUnit()) <= 2000.00 ) and ( ( IsUnitType(GetFilterUnit(), UNIT_TYPE_MECHANICAL) == false ) and ( ( IsUnitType(GetFilterUnit(), UNIT_TYPE_ANCIENT) == false ) and ( ( IsUnitEnemy(GetFilterUnit(), LoadPlayerHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xAC95C7C6)) == true ) and ( ( IsUnitAliveBJ(GetFilterUnit()) == true ) and ( ( IsUnitInGroup(GetFilterUnit(), LoadGroupHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x56E86570)) == false ) and ( ( IsUnitInGroup(GetFilterUnit(), LoadGroupHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xCD2F02AD)) == false ) and ( IsUnitInGroup(GetFilterUnit(), LoadGroupHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x05894420)) == false ) ) ) ) ) ) ) )
endfunction
function Trig___________________SHFunc007Func002Func016Func002Func001Func010A takes nothing returns nothing
	call YDWEFlyEnable(GetEnumUnit())
	call SaveUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x38DC8F9A, GetEnumUnit())
	call GroupAddUnit(LoadGroupHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x56E86570), LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x38DC8F9A))
	if ( ( UnitHasBuffBJ(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x38DC8F9A), udg_MFXG[2]) == false ) ) then
		call SFB_setBuff(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x38DC8F9A) , 0 , 3.00)
	else
