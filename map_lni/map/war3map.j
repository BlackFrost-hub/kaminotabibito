// Trigger: 挑战Boss启动QD01
//===========================================================================
function Trig_______Boss______QD01Func001Func017Func007Func003T takes nothing returns nothing
	call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "利尔·伯特", null, "来吧！就让我来看看你们的水平到底如何..以及..究竟是否是你们盗取的至宝", bj_TIMETYPE_SET, 4.00, false)
	call FlushChildHashtable(YDLOC, GetHandleId(GetExpiredTimer()))
	call DestroyTimer(GetExpiredTimer())
endfunction
function Trig_______Boss______QD01Func001Func017Func007Func007T takes nothing returns nothing
 local group ydl_group
 local unit ydl_unit
	set ydl_group=CreateGroup()
	call GroupEnumUnitsInRange(ydl_group, GetUnitX(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x76ABBC1D)), GetUnitY(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x76ABBC1D)), 1500.00, null)
	loop
		set ydl_unit=FirstOfGroup(ydl_group)
		exitwhen ydl_unit == null
		call GroupRemoveUnit(ydl_group, ydl_unit)
		if ( ( IsUnitAliveBJ(ydl_unit) == true ) and ( IsUnitType(ydl_unit, UNIT_TYPE_ANCIENT) == false ) and ( IsUnitType(ydl_unit, UNIT_TYPE_MECHANICAL) == false ) and ( IsUnitType(ydl_unit, UNIT_TYPE_STRUCTURE) == false ) and ( IsUnitEnemy(ydl_unit, GetOwningPlayer(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x76ABBC1D))) == true ) ) then
			call SaveUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x48E3E75F, ydl_unit)
			if ( ( Xcallg(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x76ABBC1D) , LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x48E3E75F)) == true ) ) then
				call UnitDamageTarget(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x76ABBC1D), LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x48E3E75F), ( ( GetUnitState(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x76ABBC1D), ConvertUnitState(0x15)) ) * ( 3.33 ) ), false, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MIND, WEAPON_TYPE_WHOKNOWS)
				call YDWETimerDestroyEffect(1.00 , AddSpecialEffectTarget("Abilities\\Spells\\Other\\SoulBurn\\SoulBurnbuff.mdl", LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x48E3E75F), "origin"))
			else
			endif
		else
		endif
	endloop
	call DestroyGroup(ydl_group)
	call SaveInteger(YDLOC, GetHandleId(GetExpiredTimer()), 0xAF616D00, GetRandomInt(1, 3))
	if ( ( LoadInteger(YDLOC, GetHandleId(GetExpiredTimer()), 0xAF616D00) == 1 ) ) then
		call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "利尔·伯特", null, "看看是谁做贼心虚！", bj_TIMETYPE_SET, 2.00, false)
	else
		if ( ( LoadInteger(YDLOC, GetHandleId(GetExpiredTimer()), 0xAF616D00) == 2 ) ) then
			call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "利尔·伯特", null, "敢胆偷我族至宝的，都没有好下场！", bj_TIMETYPE_SET, 2.00, false)
		else
			if ( ( LoadInteger(YDLOC, GetHandleId(GetExpiredTimer()), 0xAF616D00) == 3 ) ) then
				call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "利尔·伯特", null, "好了，让我好好看看...", bj_TIMETYPE_SET, 2.00, false)
			else
			endif
		endif
	endif
