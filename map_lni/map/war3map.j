//library StarCircle:
    function StarCircle__LoadCircle takes integer id returns region
        return LoadRegionHandle(StarCircle__HT, StarCircle__key_circle, id)
    endfunction  //保存圆形区域
    function StarCircle__SaveCircle takes integer id,region v returns nothing
        call SaveRegionHandle(StarCircle__HT, StarCircle__key_circle, id, v)
    endfunction  //设置圆形区域id
    function StarCircle__SetCircleId takes integer h,integer id returns nothing
        call SaveInteger(StarCircle__HT, StarCircle__key_id, h, id)
    endfunction  //获取圆形区域id
    function StarCircle__GetCircleId takes integer h returns integer
        return LoadInteger(StarCircle__HT, StarCircle__key_id, h)
    endfunction
    //private:  //子函数Y
    function StarCircle__y123 takes real x,real y,real r,region reg,integer len returns nothing
        local integer i=0
        loop
        exitwhen ( i >= len )
            set StarCircle__SY=StarCircle__SY + 32
            if ( s__Math_GDBC(x , y , StarCircle__SX , StarCircle__SY) < r ) then
                call RegionAddCell(reg, StarCircle__SX, StarCircle__SY) //AddSpecialEffect("StarPing\\UI_Select_R.mdx", SX, SY);
            endif
            set i=i + 1
        endloop
    endfunction  //子函数
    function StarCircle__x123 takes real x,real y,real r,region reg,integer len returns nothing
        local integer i=0
        loop
        exitwhen ( i >= len )
            set StarCircle__SX=StarCircle__SX + 32
            set StarCircle__SY=StarCircle__lastY
            call sc___prototype332_evaluate(1,x , y , r , reg , len)
            set i=i + 1
        endloop
    endfunction  //新建圆形区域 起点x y 半径r
    function CreateCircle takes real x,real y,real r returns integer
        local region reg=CreateRegion()
        local integer id=StarCircle__index
        local integer h=GetHandleId(reg)
        local integer len
        local real r2=r + 32
        if ( r > 6400 ) then //设置ID
            set r=6400
        endif
        call StarCircle__SetCircleId(h , id) //保存它
        call StarCircle__SaveCircle(id , reg) //左上角X
        set StarCircle__SX=x - r2 //左上角Y
        set StarCircle__SY=y - r2
        set StarCircle__lastY=StarCircle__SY //获取长度
        set len=R2I(r2 / 16) //添加点
        call sc___prototype332_evaluate(2,x , y , r - 16 , reg , len)
        set StarCircle__index=StarCircle__index + 1
        set reg=null
        return h
    endfunction
    function GetRegionByHandle takes integer i returns region
        call FlushChildHashtable(StarCircle__HT, - 1020)
        call SaveFogStateHandle(StarCircle__HT, - 1020, 1, ConvertFogState(i))
        set StarCircle__cbreg=LoadRegionHandle(StarCircle__HT, - 1020, 1)
        return StarCircle__cbreg
    endfunction  //判断相同
    function IsSameCircle takes integer a,integer b returns boolean
        return a == b
    endfunction  //删除一个圆形区域
    function RemoveCircle takes integer h returns nothing
        local integer id=StarCircle__GetCircleId(h)
        local region reg=StarCircle__LoadCircle(id)
        call RemoveRegion(reg)
        call StarCircle__SaveCircle(id , StarCircle__LoadCircle(StarCircle__index))
        set StarCircle__index=StarCircle__index - 1
        set reg=null
    endfunction  //注册单位进入圆形区域事件
    function RegistUnitEnterCircle takes trigger whichTrigger,integer id returns nothing
        local region reg=StarCircle__LoadCircle(StarCircle__GetCircleId(id))
        call TriggerRegisterEnterRegion(whichTrigger, reg, null)
        set reg=null
    endfunction  //注册单位离开圆形区域事件
    function RegistUnitLeaveCircle takes trigger whichTrigger,integer id returns nothing
        local region reg=StarCircle__LoadCircle(StarCircle__GetCircleId(id))
        call TriggerRegisterLeaveRegion(whichTrigger, reg, null)
        set reg=null
    endfunction  //获取圆形区域
    function GetTriggerCircle takes nothing returns integer
        return GetHandleId(GetTriggeringRegion())
    endfunction

