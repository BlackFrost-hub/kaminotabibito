// -- INCLUDE FILES 引用控件模板文件---------------------------------------------------------
IncludeFile "UI\FrameDef\Glue\StandardTemplates.fdf",

//******************************
//*
//* MAIN MENU BUTTONS
//*
//******
    //    类型      名字  ---> 背景  BACKDROP无法响应，但可以设计背景图
Frame "BACKDROP" "Item_Backdrop" {
    BackdropTileBackground, //平铺模式
    BackdropBackground "UI\Widgets\ToolTips\Human\human-tooltip-background.blp", //背景
    BackdropCornerFlags "UL|UR|BL|BR|T|L|B|R", // Flags
    BackdropCornerSize  0.012, //边界大小
    BackdropEdgeFile "UI\Widgets\BattleNet\bnet-inputbox-border.blp", //背景边缘文件
    BackdropBlendAll, //Blend，开启透明通道
}

    

//                类型    名字  --> //设置按钮，用于响应鼠标移动事件、点击事件等等
Frame "GLUETEXTBUTTON" "Item_Button" INHERITS WITHCHILDREN "BlankButtonTemplate" {
	SetAllPoints, //尺寸与锚点全部附加在父控件上
}