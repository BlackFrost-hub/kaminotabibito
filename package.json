{
  "name": "map5",
  "version": "1.0.0",
  "description": "TS source for TSTL round-trip",
  "scripts": {
    "build": "tstl && node scripts/fix-lua-for-pack.js && node scripts/sync-lua-from-ts.js",
    "build:full": "tstl && node scripts/fix-lua-for-pack.js && node scripts/sync-lua-from-ts.js",
    "build:files": "node scripts/build-files.js",
    "build:lua": "tstl",
    "fix:pack": "node scripts/fix-lua-for-pack.js",
    "check:boss-sfx-mono": "node scripts/check-boss-sfx-mono.js",
    "fix:boss-sfx-mono": "node scripts/check-boss-sfx-mono.js --fix"
  },
  "devDependencies": {
    "typescript": "^6.0.2",
    "typescript-to-lua": "^1.36.0"
  }
}
