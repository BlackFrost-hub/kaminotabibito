//===========================================================================
// Trigger: main
//===========================================================================
function Trig_mainActions takes nothing returns nothing
	local integer ydul_i
	local integer ydul_y
	local integer ydul_x
	YDLocalInitialize()
	set udg_UI[0] = DzCreateFrameByTagName( "BACKDROP", "提示背景", DzGetGameUI(), "template", 0)
	set udg_UI[1] = DzCreateFrameByTagName( "TEXT", "物品描述", udg_UI[0], "template", 0)
	set udg_UI[2] = DzCreateFrameByTagName( "TEXT", "物品属性", udg_UI[0], "template", 0)
	set udg_UI[3] = DzCreateFrameByTagName( "TEXT", "物品名字", udg_UI[0], "template", 0)
	set udg_UI[4] = DzCreateFrameByTagName( "BACKDROP", "物品贴图", udg_UI[0], "template", 0)
	call DzFrameSetSize( udg_UI[0], 0.20, 0.20)
	call DzFrameSetSize( udg_UI[1], 0.21, 0.00)
	call DzFrameSetSize( udg_UI[2], 0.21, 0.00)
	call DzFrameSetSize( udg_UI[4], 0.032, 0.032)
	call DzFrameSetTexture( udg_UI[0], "UI\\Widgets\\ToolTips\\Human\\human-tooltip-background.blp", 0)
	call DzFrameSetTexture( udg_UI[4], "UI\\Widgets\\ToolTips\\Human\\human-tooltip-background.blp", 0)
	call DzFrameSetText( udg_UI[1], "这里显示物品的说明")
	call DzFrameSetText( udg_UI[2], "物品属性这里显示物品的属性")
	call DzFrameSetText( udg_UI[3], "物品名字")
	call DzFrameSetPoint( udg_UI[1], 7, DzFrameGetCommandBarButton( 0, 1), 1, 0.01, 0.04)
	call DzFrameSetPoint( udg_UI[2], 6, udg_UI[1], 0, 0, 0.01)
	call DzFrameSetPoint( udg_UI[3], 0, udg_UI[2], 0, 0.037, 0.042)
	call DzFrameSetPoint( udg_UI[4], 6, udg_UI[2], 0, 0, 0.01)
	call DzFrameSetPoint( udg_UI[0], 1, udg_UI[3], 1, 0, 0.005)
	call DzFrameSetPoint( udg_UI[0], 3, udg_UI[2], 3, -0.005, 0)
	call DzFrameSetPoint( udg_UI[0], 5, udg_UI[2], 5, 0.005, 0)
	call DzFrameSetPoint( udg_UI[0], 7, udg_UI[1], 7, 0, -0.005)
	call DzFrameShow( udg_UI[0], false)
	set udg_Unit[0] = gg_unit_Hpal_0000
	set ydul_i = 0
	loop
		exitwhen ydul_i > 5
		call DzFrameSetScript( DzFrameGetItemBarButton( ydul_i), 2, "Trig_call_FrameOvActions", false)
		call DzFrameSetScript( DzFrameGetItemBarButton( ydul_i), 3, "Trig_call_FrameOutActions", false)
		call YDUserDataSet(integer, DzF2I( DzFrameGetItemBarButton( ydul_i)),"id", integer, ydul_i)
		set ydul_i = ydul_i + 1
	endloop
	set ydul_y = 0
	loop
		exitwhen ydul_y > 2
		set ydul_x = 0
		loop
			exitwhen ydul_x > 3
			call YDLocal1Set(frame, "ui", DzFrameGetCommandBarButton( ydul_y, ydul_x))
			call DzFrameSetScript( YDLocal1Get(frame, "ui"), 2, "Trig_call_SkillFrameOvActions", false)
			call DzFrameSetScript( YDLocal1Get(frame, "ui"), 3, "Trig_call_FrameOutActions", false)
			call YDUserDataSet(integer, DzF2I( YDLocal1Get(frame, "ui")),"x", integer, ydul_x)
			call YDUserDataSet(integer, DzF2I( YDLocal1Get(frame, "ui")),"y", integer, ydul_y)
			set ydul_x = ydul_x + 1
		endloop
		set ydul_y = ydul_y + 1
	endloop
	call YDLocal1Release()
endfunction

//===========================================================================
function InitTrig_main takes nothing returns nothing
	set gg_trg_main = CreateTrigger()
#ifdef DEBUG
	call YDWESaveTriggerName(gg_trg_main,"main")
#endif
	call TriggerRegisterTimerEventSingle(gg_trg_main, 0.01)
	call TriggerAddAction(gg_trg_main, function Trig_mainActions)
endfunction

//===========================================================================
// Trigger: call_FrameOv
//===========================================================================
function Trig_call_FrameOvActions takes nothing returns nothing
	YDLocalInitialize()
	call YDLocal1Set(frame, "f", DzGetTriggerUIEventFrame())
	call YDLocal1Set(player, "p", DzGetTriggerUIEventPlayer())
	call YDLocal1Set(item, "it", UnitItemInSlot( udg_Unit[GetPlayerId( YDLocal1Get(player, "p"))], YDUserDataGet(integer, DzF2I( YDLocal1Get(frame, "f")),"id", integer)))
	if ((YDLocal1Get(item, "it") != null)) then
		call DzFrameShow( udg_UI[0], true)
		call DzFrameSetText( udg_UI[1], "这里显示的是作者设置的物品描述")
		call DzFrameSetText( udg_UI[2], YDWEGetItemDataString( GetItemTypeId( YDLocal1Get(item, "it")), 3))
		call DzFrameSetText( udg_UI[3], GetItemName( YDLocal1Get(item, "it")))
		call DzFrameSetTexture( udg_UI[4], YDWEGetItemDataString( GetItemTypeId( YDLocal1Get(item, "it")), 1), 0)
		call DzFrameClearAllPoints( DzFrameGetTooltip())
		call DzFrameSetPoint( DzFrameGetTooltip(), 7, DzGetGameUI(), 7, 0, -0.60)
		call YDLocal1Release()
		return
	else
	endif
	call YDLocal1Release()
endfunction

