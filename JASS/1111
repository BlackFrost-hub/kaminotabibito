//===========================================================================
// Trigger: call_SkillFrameOv
//===========================================================================
function Trig_call_SkillFrameOvActions takes nothing returns nothing
	YDLocalInitialize()
	call YDLocal1Set(frame, "f", DzGetTriggerUIEventFrame())
	call YDLocal1Set(player, "p", DzGetTriggerUIEventPlayer())
	call KKAPISetLocalVariables( 1, x, YDUserDataGet(integer, DzF2I( YDLocal1Get(frame, "f")),"x", Null))
	call KKAPISetLocalVariables( 1, y, YDUserDataGet(integer, DzF2I( YDLocal1Get(frame, "f")),"y", Null))
	call YDLocal1Set(integer, "orderID", S2I(EXExecuteScript("(function() local _, o = require 'jass.message'.button(" + I2S(x) + "," + I2S(y) + ") return o end)()")))
	call YDLocal1Set(abilcode, "skillID",          ( S2I(EXExecuteScript("require 'jass.message'.button(" + I2S(x) + "," + I2S(y) + ")"))))
	//技能文本提示
	if ((YDWEGetAbilityTypeID( YDLocal1Get(abilcode, "skillID")) != 0)) then
		call DzFrameShow( udg_UI[0], true)
		call DzFrameSetText( udg_UI[2], "")
		call DzFrameSetTexture( udg_UI[4], YDWEGetUnitAbilityDataString( DzGetSelectedLeaderUnit(), YDLocal1Get(abilcode, "skillID"), 1, 204), 0)
		call DzFrameSetText( udg_UI[3], YDWEGetUnitAbilityDataString( DzGetSelectedLeaderUnit(), YDLocal1Get(abilcode, "skillID"), 1, 215))
		call DzFrameSetText( udg_UI[1], YDWEGetUnitAbilityDataString( DzGetSelectedLeaderUnit(), YDLocal1Get(abilcode, "skillID"), 1, 218))
		call DzFrameClearAllPoints( DzFrameGetTooltip())
		call DzFrameSetPoint( DzFrameGetTooltip(), 7, DzGetGameUI(), 7, 0, -0.60)
		call YDLocal1Release()
		return
	else
	endif
	//攻击命令按钮示例
	if ((YDWEGetAbilityTypeID( YDLocal1Get(abilcode, "orderID")) == 851986)) then
		call DisplayTextToPlayer( Player(0), 0, 0, I2S( YDLocal1Get(integer, "orderID")))
		call DzFrameShow( udg_UI[0], true)
		call DzFrameSetText( udg_UI[2], GetItemName( YDLocal1Get(item, "it")))
		call DzFrameSetTexture( udg_UI[4], YDWEGetUnitAbilityDataString( DzGetSelectedLeaderUnit(), YDLocal1Get(abilcode, "skillID"), 1, 204), 0)
		call DzFrameSetText( udg_UI[3], YDWEGetUnitAbilityDataString( DzGetSelectedLeaderUnit(), YDLocal1Get(abilcode, "skillID"), 1, 215))
		call DzFrameSetText( udg_UI[1], YDWEGetUnitAbilityDataString( DzGetSelectedLeaderUnit(), YDLocal1Get(abilcode, "skillID"), 1, 218))
		call DzFrameClearAllPoints( DzFrameGetTooltip())
		call DzFrameSetPoint( DzFrameGetTooltip(), 7, DzGetGameUI(), 7, 0, -0.60)
		call YDLocal1Release()
		return
	else
	endif
	call YDLocal1Release()
endfunction

