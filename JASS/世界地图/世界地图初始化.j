//===========================================================================
function InitTrig_worldmap takes nothing returns nothing
	set gg_trg_worldmap = CreateTrigger()
#ifdef DEBUG
	call YDWESaveTriggerName(gg_trg_worldmap,"worldmap")
#endif
	call TriggerRegisterTimerEventSingle(gg_trg_worldmap, 0.00)
	call TriggerAddAction(gg_trg_worldmap, function Trig_worldmapActions)
endfunction

