function Trig_worldmapActions takes nothing returns nothing
	local integer ydul_A
	local integer ydul_B
	YDLocalInitialize()
	call YDLocal1Set(frame, "worldbutton", DzCreateFrameByTagName( "BACKDROP", "name", DzGetGameUI(), "template", 0))
	call DzFrameSetTexture( YDLocal1Get(frame, "worldbutton"), "war3mapImported\\worldmap.tga", 0)
	call DzFrameSetAbsolutePoint( YDLocal1Get(frame, "worldbutton"), 4, 0.562708, 0.1552308)
	call DzFrameSetSize( YDLocal1Get(frame, "worldbutton"), 0.04, 0.025)
	call DzFrameShow( YDLocal1Get(frame, "worldbutton"), true)
	call YDLocal1Set(frame, "提示文本", DzCreateFrameByTagName( "TEXT", "主线任务提示文本", YDLocal1Get(frame, "worldbutton"), "template", 0))
	call DzFrameSetAbsolutePoint( YDLocal1Get(frame, "提示文本"), 4, 0.5463336, 0.1555134)
	call DzFrameSetText( YDLocal1Get(frame, "提示文本"), "M")
	call YDLocal1Set(frame, "worldbig", DzCreateFrameByTagName( "BACKDROP", "name", DzGetGameUI(), "template", 0))
	call DzFrameSetTexture( YDLocal1Get(frame, "worldbig"), "war3mapImported\\worldmap.tga", 0)
	call DzFrameSetAbsolutePoint( YDLocal1Get(frame, "worldbig"), 4, 0.562708, 0.1552308)
	call DzFrameSetSize( YDLocal1Get(frame, "worldbig"), 0.05, 0.03125)
	call DzFrameShow( YDLocal1Get(frame, "worldbig"), false)
	call YDLocal1Set(frame, "worldmap", DzCreateFrameByTagName( "BACKDROP", "name", DzGetGameUI(), "template", 0))
	call YDUserDataSet(string, "worldmap","frame", frame, YDLocal1Get(frame, "worldmap"))
	call YDUserDataSet(string, "worldmap","放大", frame, YDLocal1Get(frame, "worldbig"))
	call DzFrameShow( YDLocal1Get(frame, "worldmap"), true)
	call DzFrameShow( YDLocal1Get(frame, "worldmap"), false)
	call YDLocal1Set(frame, "文本A", DzCreateFrameByTagName( "TEXT", "文本A", YDLocal1Get(frame, "worldmap"), "template", 0))
	call DzFrameSetAbsolutePoint( YDLocal1Get(frame, "文本A"), 4, 0.4, 0.5)
	call DzFrameSetText( YDLocal1Get(frame, "文本A"), "|cffff0000地图提示|r|cff000000：脱战状态下，『双击已激活的城镇』可以快速传送！|r")
	call DzFrameSetPriority( YDLocal1Get(frame, "文本A"), 1)
	call DzFrameSetFont( YDLocal1Get(frame, "文本A"), "war3mapImported\\uizt.ttf", 20.00, 0)
	set ydul_A = 1
	loop
		exitwhen ydul_A > 8
		call YDLocal1Set(frame, "map", DzCreateFrameByTagName( "BACKDROP", "name", YDLocal1Get(frame, "worldmap"), "template", 0))
		if ((ydul_A >= 1) and (ydul_A <= 4)) then
			call DzFrameSetTexture( YDLocal1Get(frame, "map"), YDWEOperatorString3( "war3mapImported\\map0", I2S( ydul_A), ".blp"), 0)
			call DzFrameSetAbsolutePoint( YDLocal1Get(frame, "map"), 4, OperatorRealAdd( -0.10, OperatorRealMultiply( 0.20, I2R( ydul_A))), 0.4249764)
		else
			if ((ydul_A >= 5) and (ydul_A <= 8)) then
				call DzFrameSetTexture( YDLocal1Get(frame, "map"), YDWEOperatorString3( "war3mapImported\\map0", I2S( ydul_A), ".blp"), 0)
				call DzFrameSetAbsolutePoint( YDLocal1Get(frame, "map"), 4, OperatorRealAdd( -0.90, OperatorRealMultiply( 0.20, I2R( ydul_A))), 0.1422246)
			else
			endif
		endif
		call DzFrameSetSize( YDLocal1Get(frame, "map"), 0.20, 0.2844486)
		set ydul_A = ydul_A + 1
	endloop
	if ((0 == 0)) then
		set ydul_B = 1
		loop
			exitwhen ydul_B > 27
			call YDLocal1Set(frame, "按钮", DzCreateFrameByTagName( "GLUETEXTBUTTON", "主线按钮", YDLocal1Get(frame, "worldmap"), "template", 0))
			call DzFrameSetSize( YDLocal1Get(frame, "按钮"), 0.03, 0.03)
			call YDLocal1Set(frame, "文本框", DzCreateFrameByTagName( "BACKDROP", "主线任务文本框", YDLocal1Get(frame, "按钮"), "template", 0))
			call DzFrameSetTexture( YDLocal1Get(frame, "文本框"), "war3mapImported\\wenbenkuang2.blp", 0)
			call DzFrameSetSize( YDLocal1Get(frame, "文本框"), 0.12, 0.20)
			call DzFrameSetPoint( YDLocal1Get(frame, "文本框"), 4, YDLocal1Get(frame, "按钮"), 4, 0.05, 0.05)
			call DzFrameShow( YDLocal1Get(frame, "文本框"), false)
			call DzFrameSetPriority( YDLocal1Get(frame, "文本框"), 1)
			call YDLocal1Set(frame, "提示文本", DzCreateFrameByTagName( "TEXT", "主线任务提示文本", YDLocal1Get(frame, "文本框"), "template", 0))
			call DzFrameSetPoint( YDLocal1Get(frame, "提示文本"), 4, YDLocal1Get(frame, "文本框"), 4, 0.00, 0.02)
			call YDLocal1Set(frame, "map", DzCreateFrameByTagName( "BACKDROP", "name", YDLocal1Get(frame, "文本框"), "template", 0))
			call DzFrameSetTexture( YDLocal1Get(frame, "map"), "war3mapImported\\Bosswenhao.blp", 0)
			call DzFrameSetPoint( YDLocal1Get(frame, "map"), 4, YDLocal1Get(frame, "按钮"), 4, 0.015, 0.12)
			call DzFrameSetSize( YDLocal1Get(frame, "map"), 0.02, 0.02)
			call YDLocal1Set(frame, "worldP", DzCreateFrameByTagName( "BACKDROP", "name", YDLocal1Get(frame, "按钮"), "template", 0))
			call DzFrameSetTexture( YDLocal1Get(frame, "worldP"), "war3mapImported\\TB-jiantouweizhi.tga", 0)
			call DzFrameSetSize( YDLocal1Get(frame, "worldP"), 0.0135, 0.0191)
			call DzFrameShow( YDLocal1Get(frame, "worldP"), false)
			call DzFrameSetPriority( YDLocal1Get(frame, "worldP"), 0)
			call YDUserDataSet(string, ("map" + I2S( ydul_B)),"1", frame, YDLocal1Get(frame, "文本框"))
			call YDUserDataSet(string, ("map" + I2S( ydul_B)),"2", frame, YDLocal1Get(frame, "提示文本"))
			call YDUserDataSet(string, ("map" + I2S( ydul_B)),"3", frame, YDLocal1Get(frame, "map"))
			call YDUserDataSet(string, ("map" + I2S( ydul_B)),"4", frame, YDLocal1Get(frame, "worldP"))
