//===========================================================================
// Trigger: 暴击系统BJ
//===========================================================================
function Trig_____________BJConditions takes nothing returns boolean
	return ((GetEventDamage() >= 1.10))
endfunction

function Trig_____________BJFunc001Func008Func017Func003A takes nothing returns nothing
	call YDLocal2Set(unit, "选取单位", GetEnumUnit())
	if ((GetOwningPlayer( YDLocal2Get(unit, "选取单位")) == GetOwningPlayer( YDLocal2Get(unit, "玩家单位")))) then
		call YDLocal2Set(unit, "玩家单位", YDLocal2Get(unit, "选取单位"))
	else
	endif
endfunction

function Trig_____________BJActions takes nothing returns nothing
	YDLocalInitialize()
	if (((YDWEIsEventDamageType( DAMAGE_TYPE_NORMAL) == true) or (YDWEIsEventDamageType( DAMAGE_TYPE_ENHANCED) == true) or (YDWEIsEventAttackType( ATTACK_TYPE_NORMAL) == true)) and (YDWEIsEventAttackDamage() == true) and ((YDUserDataGet(unit, GetEventDamageSource(),"暴击率", real) > 0.01) or (YDUserDataGet(player, GetOwningPlayer( GetEventDamageSource()),"暴击率", real) > 0.01))) then
		call YDLocal1Set(real, "随机实数", GetRandomReal( 0.01, 1.00))
		if ((IsUnitInForce( GetEventDamageSource(), YDUserDataGet(string, "玩家","玩家组", force)) == false) and (YDUserDataGet(unit, GetEventDamageSource(),"暴击率", real) > 0.01)) then
			call YDLocal1Set(real, "暴击率", YDUserDataGet(unit, GetEventDamageSource(),"暴击率", real))
			call YDLocal1Set(real, "暴击伤害", YDUserDataGet(unit, GetEventDamageSource(),"暴击伤害", real))
			if ((IsUnitInForce( GetTriggerUnit(), YDUserDataGet(string, "玩家","玩家组", force)) == true)) then
				//敌对单位攻击玩家
				call YDLocal1Set(real, "暴击率", OperatorRealSubtract( YDLocal1Get(real, "暴击率"), YDUserDataGet(player, GetOwningPlayer( GetTriggerUnit()),"被暴击率", real)))
			else
				//非玩家单位攻击非玩家单位
				call YDLocal1Set(real, "暴击率", OperatorRealSubtract( YDLocal1Get(real, "暴击率"), YDUserDataGet(unit, GetTriggerUnit(),"被暴击率", real)))
			endif
			//↑↑↑上面为敌对单位，下面为玩家↓↓↓
		else
			if ((IsUnitInForce( GetEventDamageSource(), YDUserDataGet(string, "玩家","玩家组", force)) == true) and (YDUserDataGet(player, GetOwningPlayer( GetEventDamageSource()),"暴击率", real) > 0.01)) then
				call YDLocal1Set(real, "暴击率", YDUserDataGet(player, GetOwningPlayer( GetEventDamageSource()),"暴击率", real))
				call YDLocal1Set(real, "暴击伤害", YDUserDataGet(player, GetOwningPlayer( GetEventDamageSource()),"暴击伤害", real))
				//玩家的暴击伤害加成最多150%也就是最多300%暴击
				if ((YDLocal1Get(real, "暴击伤害") > 1.50)) then
					call YDLocal1Set(real, "暴击伤害", 1.50)
				else
				endif
				if ((IsUnitInForce( GetTriggerUnit(), YDUserDataGet(string, "玩家","玩家组", force)) == true)) then
					//玩家攻击玩家（或许不存在，预设）
					call YDLocal1Set(real, "暴击率", OperatorRealSubtract( YDLocal1Get(real, "暴击率"), YDUserDataGet(player, GetOwningPlayer( GetTriggerUnit()),"被暴击率", real)))
				else
					//玩家攻击敌对单位
					call YDLocal1Set(real, "暴击率", OperatorRealSubtract( YDLocal1Get(real, "暴击率"), YDUserDataGet(unit, GetTriggerUnit(),"被暴击率", real)))
				endif
			else
			endif
		endif
		//一些物品的暴击率效果（最终计算暴击率之前）
		if ((IsUnitType( GetEventDamageSource(), UNIT_TYPE_RANGED_ATTACKER) == true)) then
			if ((UnitHasItemOfTypeBJ( GetEventDamageSource(), 'I0C4') == true)) then
				if ((GetUnitLifePercent( GetTriggerUnit()) >= 80.00)) then
					call YDLocal1Set(real, "暴击率", 1.00)
				else
				endif
			else
			endif
		else
		endif
		if ((UnitHasItemOfTypeBJ( GetEventDamageSource(), 'I0CE') == true)) then
			call YDLocal1Set(real, "暴击率", OperatorRealAdd( YDLocal1Get(real, "暴击率"), YDUserDataGet(player, GetOwningPlayer( GetEventDamageSource()),"命中率", real)))
		else
		endif
		//计算暴击率
		if ((YDLocal1Get(real, "暴击率") >= YDLocal1Get(real, "随机实数"))) then
			//计算暴击伤害
			if ((YDWEIsEventAttackType( ATTACK_TYPE_NORMAL) == true)) then
				call YDLocal1Set(real, "初步暴击伤害", OperatorRealMultiply( 1.00, OperatorRealAdd( 1.25, YDLocal1Get(real, "暴击伤害"))))
			else
				call YDLocal1Set(real, "初步暴击伤害", OperatorRealMultiply( 1.00, OperatorRealAdd( 1.50, YDLocal1Get(real, "暴击伤害"))))
			endif
			//计算暴击伤害减免（单位拥有暴击伤害减免属性优先计算单位）
			//避免单位有暴击伤害和减免时扣自己暴击伤害
			if ((GetEventDamageSource() != GetTriggerUnit())) then
				if ((YDUserDataHas2(unit, GetTriggerUnit(), real,"被暴击伤害") == true)) then
					call YDLocal1Set(real, "暴击伤害减免", YDUserDataGet(unit, GetTriggerUnit(),"被暴击伤害", real))
				else
					if ((IsUnitInForce( GetTriggerUnit(), YDUserDataGet(string, "玩家","玩家组", force)) == true) and (YDUserDataHas2(player, GetOwningPlayer( GetTriggerUnit()), real,"被暴击伤害") == true)) then
						call YDLocal1Set(real, "暴击伤害减免", YDUserDataGet(player, GetOwningPlayer( GetTriggerUnit()),"被暴击伤害", real))
						if ((YDLocal1Get(real, "暴击伤害减免") >= 1.50)) then
							call YDLocal1Set(real, "暴击伤害减免", 1.50)
						else
						endif
					else
					endif
				endif
			else
			endif
			call YDLocal1Set(real, "输出暴击伤害", OperatorRealSubtract( YDLocal1Get(real, "初步暴击伤害"), YDLocal1Get(real, "暴击伤害减免")))
			//最终结算不会小于100%
			if ((YDLocal1Get(real, "输出暴击伤害") <= 1.00)) then
				call YDLocal1Set(real, "输出暴击伤害", 1.00)
			else
			endif
			//伤害值（这里改用数值显示）参数在jass原文都有
			call YDWESetEventDamage( YDLocal1Get(real, "伤害值"))
			call YDLocal1Set(location, "点", GetUnitLoc( GetEventDamageSource()))
			call CreateTextTagLocBJ( (R2S( GetEventDamage()) + YDWEOperatorString3( "！！（", ("×" + R2S( YDLocal1Get(real, "输出暴击伤害"))), "）")), YDLocal1Get(location, "点"), 20.00, 12.50, 100, 1.00, 1.00, 0)
			call SetTextTagVelocity( GetLastCreatedTextTag(), 0.00, 0.07)
			call YDWETimerDestroyTextTag( 0.80, GetLastCreatedTextTag())
			call RemoveLocation( YDLocal1Get(location, "点"))
			//若由马甲触发则将效果转移到英雄，兜底
			if ((IsUnitType( GetEventDamageSource(), UNIT_TYPE_HERO) == false)) then
				call YDLocal1Set(unit, "玩家单位", GetEventDamageSource())
				call ForGroupBJ( YDUserDataGet(string, "玩家英雄","单位组", group),function Trig_____________BJFunc001Func008Func017Func003A)
			else
				call YDLocal1Set(unit, "玩家单位", GetEventDamageSource())
			endif
		else
		endif
	else
	endif
	call YDLocal1Release()
endfunction

//===========================================================================
function InitTrig_____________BJ takes nothing returns nothing
	set gg_trg_____________BJ = CreateTrigger()
#ifdef DEBUG
	call YDWESaveTriggerName(gg_trg_____________BJ,"暴击系统BJ")
#endif
	call MNAnyUnitDamaged(gg_trg_____________BJ, 5.00)
	call TriggerAddCondition(gg_trg_____________BJ, Condition(function Trig_____________BJConditions))
	call TriggerAddAction(gg_trg_____________BJ, function Trig_____________BJActions)
endfunction

