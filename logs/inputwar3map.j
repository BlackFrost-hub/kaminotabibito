                call SaveUnitHandle(YDLOC, GetHandleId(ydl_timer), 0xC303079D, LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xC303079D))
                call SaveUnitHandle(YDLOC, GetHandleId(ydl_timer), 0xB3542E15, LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xB3542E15))
                call TimerStart(ydl_timer, 0.04, true, function Trig_DMboss____________02Func004Func016Func003Func017T)
                set ydul_A = ydul_A + 1
            endloop
        else
