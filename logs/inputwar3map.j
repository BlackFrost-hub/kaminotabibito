        else
            call SetUnitPositionLoc( LoadUnitHandle(YDHT, StringHash( "克劳德"), 0x8A89ED65), LoadLocationHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x8FA91502) )
        endif
        if ((LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xCEA5D211) >= 0.00) and (LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xCEA5D211) <= 10.00)) then
