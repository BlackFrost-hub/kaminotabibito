    //�жϵ�λ���޵еģ���λ�޵��򷵻�true ���򷵻�false
    public function SU_IsUnitInvincible(unit u)->boolean{
        if(GetUnitAbilityLevel(u,'Avul')!=0){
            return true;
        }else{
            if(GetUnitAbilityLevel(u,'Bvul')!=0){
                return true;
            }else{
                if(GetUnitAbilityLevel(u,'BHds')!=0){
                    return true;
                }
            }
        }
        return false;
    }
    public {
