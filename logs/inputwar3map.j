                call SetUnitPosition( GetTriggerUnit(), 21615.20, -29218.30 )
                call TransmissionFromUnitWithNameBJ( GetPlayersAll(), GetTriggerUnit(), GetUnitName(GetTriggerUnit()), null, "TRIGSTR_076", bj_TIMETYPE_ADD, 0, true )
                call TransmissionFromUnitWithNameBJ( GetPlayersAll(), GetTriggerUnit(), GetUnitName(GetTriggerUnit()), null, "TRIGSTR_077", bj_TIMETYPE_ADD, 0, true )
                call QuestMessageBJ( GetPlayersAll(), bj_QUESTMESSAGE_ALWAYSHINT, "TRIGSTR_078" )
            else
            endif
        else
        endif
        call RemoveLocation( LoadLocationHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x2A829619) )
        call RemoveLocation( LoadLocationHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x5B0D7524) )
    else
    endif
    // FF
    if ((GetSpellAbilityId() == 'A0IR')) then
        call SetUnitState( GetTriggerUnit(), ConvertUnitState(0x20), ((GetUnitState(GetTriggerUnit(), ConvertUnitState(0x20)))+( 50.00)) )
        call SaveReal(YDHT, GetHandleId( GetTriggerPlayer()), 0x5BCB3607, ((LoadReal(YDHT, GetHandleId( GetTriggerPlayer()), 0x5BCB3607))+( 0.25)))
        set ydl_timer = CreateTimer()
        call SavePlayerHandle(YDLOC, GetHandleId(ydl_timer), 0xAC95C7C6, GetTriggerPlayer())
        call SaveUnitHandle(YDLOC, GetHandleId(ydl_timer), 0x458B7DE9, GetTriggerUnit())
        call TimerStart(ydl_timer, 5.00, false, function Trig____________________________ZHFunc007Func003T)
    else
    endif
    if ((GetSpellAbilityId() == 'A0IP')) then
        call SaveReal(YDHT, GetHandleId( GetTriggerPlayer()), 0xD7D6B250, ((LoadReal(YDHT, GetHandleId( GetTriggerPlayer()), 0xD7D6B250))+( 0.50)))
        call SaveReal(YDHT, GetHandleId( GetTriggerPlayer()), 0xE0A9DEEE, ((LoadReal(YDHT, GetHandleId( GetTriggerPlayer()), 0xE0A9DEEE))+( 0.25)))
        call YDWETimerDestroyEffect( 5.00, AddSpecialEffectTarget("war3mapImported\\Firechest01.mdx", GetTriggerUnit(), "origin") )
        set ydl_timer = CreateTimer()
        call SavePlayerHandle(YDLOC, GetHandleId(ydl_timer), 0xAC95C7C6, GetTriggerPlayer())
        call TimerStart(ydl_timer, 5.00, false, function Trig____________________________ZHFunc008Func004T)
    else
    endif
    if ((GetSpellAbilityId() == 'A0IN')) then
        call SaveLocationHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xE57793B0, GetUnitLoc(GetTriggerUnit()))
        call SaveReal(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x48DE6A7F, GS_AngleBetweenPoints(GetUnitLoc(GetTriggerUnit()), GetSpellTargetLoc()))
        call SaveReal(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xCEA5D211, 0.00)
        set ydl_timer = CreateTimer()
        call SaveUnitHandle(YDLOC, GetHandleId(ydl_timer), 0x458B7DE9, GetTriggerUnit())
        call SaveReal(YDLOC, GetHandleId(ydl_timer), 0xCEA5D211, LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xCEA5D211))
        call SaveReal(YDLOC, GetHandleId(ydl_timer), 0x48DE6A7F, LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x48DE6A7F))
        call SaveLocationHandle(YDLOC, GetHandleId(ydl_timer), 0x90964E29, LoadLocationHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x90964E29))
        call SaveLocationHandle(YDLOC, GetHandleId(ydl_timer), 0xE57793B0, LoadLocationHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xE57793B0))
        call SaveLocationHandle(YDLOC, GetHandleId(ydl_timer), 0x07C4E77D, LoadLocationHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x07C4E77D))
        call TimerStart(ydl_timer, 0.00, true, function Trig____________________________ZHFunc009Func005T)
    else
    endif
    call FlushChildHashtable(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step)
    set ydl_group = null
    set ydl_unit = null
    set ydl_timer = null
endfunction
