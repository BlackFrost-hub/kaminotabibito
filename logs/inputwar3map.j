    public string SGSS_TypeStr[];
    public integer SGSS_TypeStrHash[];
    //������������ 1= ������ 2= ������ 3=����ֵ 4=����ֵ 5=����ֵ 6=ȫ���� 7= ����ֵ 8 = ����ֵ 9 = �ƶ��ٶ� 10 = �����ٶ�
    public function SGSS_SetState(unit u,integer id,real v)
    {
        if(id==1){
            SGSS_SetUnitAttack(u,v);
        }
        else if(id==2){
            SGSS_SetUnitAmrror(u,v);
        }
        else if(id==3){
            SGSS_SetUnitState(u,v,0,0);
        }
        else if(id==4){
            SGSS_SetUnitState(u,0,v,0);
        }
        else if(id==5){
            SGSS_SetUnitState(u,0,0,v);
        }
        else if(id==6){
            SGSS_SetUnitState(u,v,v,v);
        }
        else if(id==7){
            SGSS_SetUnitHP(u,v);
        }
        else if(id==8){
            SGSS_SetUnitMP(u,v);
        }
        else if(id ==9){
            SGSS_SetUnitMoveSpeed(u,v);
        }
        else if(id ==10){
            SGSS_SetUnitAttackSpeed(u,v);
        }
    }
    //ˢ�µ�λ���ϵĵȼ��ӳ�
    public function SGSS_ReSetUnitState(unit u){
        integer i = 0;
        real newValue,oldValue;
        for(1<=i<6){
            oldValue = LoadReal(YDHT,GetHandleId(u),SGSS_TypeStrHash[200+i]);//��ȡ�ȼ��ӳ�ֵ
            newValue = GetHeroLevel(u) * LoadReal(YDHT,GetHandleId(u),SGSS_TypeStrHash[100+i]);//�����µ�ֵ
            SaveReal(YDHT,GetHandleId(u),SGSS_TypeStrHash[200+i],newValue);//��¼��ֵ
            SGSS_SetState(u,i,newValue-oldValue);//���²���
        }
        for(6<=i<8){
            oldValue = LoadReal(YDHT,GetHandleId(u),SGSS_TypeStrHash[200+i]);//��ȡ�ȼ��ӳ�ֵ
            newValue = GetHeroLevel(u) * LoadReal(YDHT,GetHandleId(u),SGSS_TypeStrHash[100+i]);//�����µ�ֵ
            SaveReal(YDHT,GetHandleId(u),SGSS_TypeStrHash[200+i],newValue);//��¼��ֵ
            SGSS_SetState(u,i+1,newValue-oldValue);//���²���
        }
    }
    //ˢ�¹̶��ӳ�
    public function SGSS_ReSetUnitState2(unit u){
        integer i = 0;
        real newValue,oldValue;
        for(1<=i<6){
            oldValue = LoadReal(YDHT,GetHandleId(u),SGSS_TypeStrHash[400+i]);//��ȡ�ȼ��ӳ�ֵ
            newValue = LoadReal(YDHT,GetHandleId(u),SGSS_TypeStrHash[300+i]);//�����µ�ֵ
            SaveReal(YDHT,GetHandleId(u),SGSS_TypeStrHash[400+i],newValue);//��¼��ֵ
            SGSS_SetState(u,i,newValue-oldValue);//���²���
        }
        for(6<=i<8){
            oldValue = LoadReal(YDHT,GetHandleId(u),SGSS_TypeStrHash[400+i]);//��ȡ�ȼ��ӳ�ֵ
            newValue = LoadReal(YDHT,GetHandleId(u),SGSS_TypeStrHash[300+i]);//�����µ�ֵ
            SaveReal(YDHT,GetHandleId(u),SGSS_TypeStrHash[400+i],newValue);//��¼��ֵ
            SGSS_SetState(u,i+1,newValue-oldValue);//���²���
        }
    }
