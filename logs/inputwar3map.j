        //��������
        if(GetUnitAbilityLevel(u,'Bapl') != 0)
        {
            return 2;
        }
        //��Ȼ֮��
        if(GetUnitAbilityLevel(u,'BEfn') != 0)
        {
            return 3;
        }
        //��������
        if(GetUnitAbilityLevel(u,'Bhwd') != 0)
        {
            return 4;
        }
        //������ʬ
        if(GetUnitAbilityLevel(u,'Brai') != 0)
        {
            return 5;
        }
        //ˮԪ��
        if(GetUnitAbilityLevel(u,'BHwe') != 0)
        {
            return 6;
        }
        //��ʱ������
        if(GetUnitAbilityLevel(u,'BTLF') != 0)
        {
            return 7;
        }
        //ʲôҲ����
        return 0;
    }
