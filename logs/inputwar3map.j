//Base.j require
//! zinc
library StarDebugger requires StarBase
{
    //
    private hashtable ht = InitHashtable();
    // private integer index = 0;
    public hashtable SDR_HT;
    public integer SDR_Index=0;
    private function Print(string text){
        LogPut(text);
    }
    public function SDR_DebugTimer(timer t,real time,boolean isloop,string Target,string trig){
        SaveTimerHandle(ht,SDR_Index,0,t);
        SaveInteger(ht,GetHandleId(t),0,SDR_Index);
        SaveReal(ht,GetHandleId(t),1,time);
        SaveBoolean(ht,GetHandleId(t),2,isloop);
        SaveStr(ht,GetHandleId(t),3,Target);
        SaveStr(ht,GetHandleId(t),4,trig);
        SDR_Index+=1;
    }
    public function SDR_ExTimerStart(timer t,real time,boolean isloop,code c,string str){
        TimerStart(t,time,isloop,c);
        SDR_DebugTimer(t,time,isloop,str,"");
    }
    // public function SDR_DebugTimer2(timer t,real time,boolean isloop,string Target,code c){
    //     SaveTimerHandle(ht,SDR_Index,0,t);
    //     SaveInteger(ht,GetHandleId(t),0,SDR_Index);
    //     SaveReal(ht,GetHandleId(t),1,time);
    //     SaveBoolean(ht,GetHandleId(t),2,isloop);
    //     SaveStr(ht,GetHandleId(t),3,Target);
    //     TimerStart(t,time,isloop,c);
    //     SDR_Index+=1;
    // }
    public function SDR_DebugTimer_Remove(timer t){
        integer id;
        timer tr;
        if( HaveSavedInteger(ht,GetHandleId(t),0) )
        {
            id = LoadInteger(ht,GetHandleId(t),0);
            if(id!=(SDR_Index-1))
            {
                tr = LoadTimerHandle(ht,SDR_Index-1,0);
                //交换数据
                SaveTimerHandle(ht,id,0,tr);
                SaveInteger(ht,GetHandleId(tr),0,id);
                //清除旧计时器引用
                FlushChildHashtable(ht,GetHandleId(t));
            }
            SDR_Index-=1;
        }
        tr = null;
    }
    private function SDR_B2I(boolean b)->string{
        if(b){
            return "循环";
        }else{
            return "不循环";
        }
    }
    
    public function SDR_Print(){
        integer i = 0;
        integer j = 0;
        timer t;
        Print("==========逆天计时器引用检查==========");
        while(i<SDR_Index){
            t = LoadTimerHandle(ht,i,0);
            if(t!=null)
            {
                Print("计时器句柄:"
                +I2S(GetHandleId(t)) 
                +"，周期:"
                +R2S(LoadReal(ht,GetHandleId(t),1))
                +"，"
                + SDR_B2I(LoadBoolean(ht,GetHandleId(t),2)) 
                + "，回调函数:"
                + LoadStr(ht,GetHandleId(t),3)
                + ",在触发器:"
                + LoadStr(ht,GetHandleId(t),4)
                );
                j+=1;
            }
            i+=1;
        }
        Print("逆天计时器数量："+I2S(j));
        t = null;
        Print("==============The  End===============");
    } 
    private function onInit(){
        SDR_HT = ht;
    }
}
