function Trig___________________PTCFFunc011Func003Func026Conditions takes nothing returns nothing
    local group ydl_group
    local unit ydl_unit
    // 玩家击杀则不造成伤害
    if (((EVENT_UNIT_DAMAGED == GetTriggerEventId()) == true)) then
        if (((YDWEIsEventDamageType(DAMAGE_TYPE_DIVINE) == true) or (YDWEIsEventDamageType(DAMAGE_TYPE_LIGHTNING) == true))) then
            call YDWESetEventDamage( ((GetEventDamage())*( 1.30)) )
        else
        endif
    else
    endif
    if (((EVENT_UNIT_DEATH == GetTriggerEventId()) == true)) then
        call SaveReal(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xA99320FA, GetUnitX(GetDyingUnit()))
        call SaveReal(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xFDF65382, GetUnitY(GetDyingUnit()))
        call SaveUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0x2F78B100, GetKillingUnit())
        call SaveReal(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xB81DE3C2, ((GetUnitState(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0x2F78B100), ConvertUnitState(0x15)))*( 1.00)))
        // 判断是否自然死亡
        if ((LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0x2F78B100) == null)) then
            call PlaySoundOnUnitBJ( gg_snd_PossessionMissileLaunch1, 100, LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0x68B72DFF) )
            call Sound3DII_CooPlay( "YX\\DevourMagic.wav", GetUnitX(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0x68B72DFF)), GetUnitY(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0x68B72DFF)), 0.0, 2000.00 )
            call EC_CreateEffect( "war3mapImported\\UltimateDarkFlash.mdl", LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xA99320FA), LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xFDF65382), 0.0, 270.0, 1.30, 1.00, 1.00 )
            set ydl_group = CreateGroup()
            call GroupEnumUnitsInRange(ydl_group, LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xA99320FA), LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xFDF65382), 120.00, null)
            loop
                set ydl_unit = FirstOfGroup(ydl_group)
                exitwhen ydl_unit == null
                call GroupRemoveUnit(ydl_group, ydl_unit)
                if ((IsUnitAliveBJ(ydl_unit) == true) and (IsUnitType(ydl_unit, UNIT_TYPE_ANCIENT) == false) and (IsUnitType(ydl_unit, UNIT_TYPE_MECHANICAL) == false) and (IsUnitType(ydl_unit, UNIT_TYPE_STRUCTURE) == false) and (IsUnitEnemy(ydl_unit, GetOwningPlayer(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0x76ABBC1D))) == true)) then
                    call UnitDamageTarget( LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0x76ABBC1D), ydl_unit, ((((GetUnitState(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0x76ABBC1D), ConvertUnitState(0x15)))*( 1.50)))+( ((GetUnitState(ydl_unit, UNIT_STATE_MAX_LIFE))*( 0.03)))), false, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_SHADOW_STRIKE, WEAPON_TYPE_WHOKNOWS )
                    call SaveUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0x089E63E0, CreateUnit(GetOwningPlayer(GetTriggerUnit()), LoadInteger(YDHT, StringHash( "辅助马甲"), 0x86D47FF3), GetUnitX(ydl_unit), GetUnitY(ydl_unit), 0))
                    call UnitAddAbility( LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0x089E63E0), LoadInteger(YDHT, StringHash( "眩晕"), 0x2AAC512D) )
                    call YDWESetUnitAbilityDataReal( LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0x089E63E0), LoadInteger(YDHT, StringHash( "眩晕"), 0x2AAC512D), 1, 102, 0.40 )
                    call YDWESetUnitAbilityDataReal( LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0x089E63E0), LoadInteger(YDHT, StringHash( "眩晕"), 0x2AAC512D), 1, 103, 0.40 )
                    call IssueTargetOrder( LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0x089E63E0), "thunderbolt", ydl_unit )
                else
                endif
            endloop
            call DestroyGroup(ydl_group)
