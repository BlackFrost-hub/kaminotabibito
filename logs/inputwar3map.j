function Trig_DMboss____________03Actions takes nothing returns nothing
    local timer ydl_timer
    local integer ydl_localvar_step = LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xCFDE6C76) 
 set ydl_localvar_step = ydl_localvar_step + 3 
 call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xCFDE6C76, ydl_localvar_step) 
 call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7, ydl_localvar_step)
    call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x2AAC512D, GetSpellAbilityId())
    if ((((EVENT_UNIT_SPELL_CAST == GetTriggerEventId()) == true) or ((EVENT_PLAYER_UNIT_SPELL_CAST == GetTriggerEventId()) == true))) then
        if (((GetSpellAbilityId() == 'A0FM') or (GetSpellAbilityId() == 'A0FH') or (GetSpellAbilityId() == 'A0FD') or (GetSpellAbilityId() == 'A0FI') or (GetSpellAbilityId() == 'A0FM'))) then
            call YDWETimerDestroyEffect( 1.00, AddSpecialEffectTarget("Abilities\\Spells\\Other\\Charm\\CharmTarget.mdl", GetTriggerUnit(), "origin") )
        else
        endif
        // 不无敌，单纯有施法进度条
        if (((GetUnitTypeId(GetTriggerUnit()) == 'O005'))) then
            call SaveUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xD84480C3, GetSpellTargetUnit())
            if ((10 >= 10)) then
                call SaveReal(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x9EF7B67E, S2R(EXExecuteScript("(require'jass.slk').ability[" + I2S( LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x2AAC512D)) + "]." + "DataA1")))
                // Debug，除0会崩溃
                if ((LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x9EF7B67E) < 0.03)) then
                else
                    call SaveReal(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x5D04C6C8, ((1.00)/( LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x9EF7B67E))))
                endif
                call SaveUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x248ED1E3, CreateUnit(Player(0), 'e01O', GetUnitX(GetTriggerUnit()), GetUnitY(GetTriggerUnit()), 0))
                call SetUnitTimeScale( LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x248ED1E3), LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x5D04C6C8) )
                call SetUnitOwner( LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x248ED1E3), Player(4), true )
                call SetUnitFlyHeight( LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x248ED1E3), ((GetUnitFlyHeight(GetTriggerUnit()))+( 350.00)), 0.00 )
                call YDWETimerRemoveUnit( LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x9EF7B67E), LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x248ED1E3) )
                call UnitRemoveBuffsEx( GetTriggerUnit(), false, true, false, false, false, false, true )
                set ydl_timer = CreateTimer()
                call SaveUnitHandle(YDLOC, GetHandleId(ydl_timer), 0x458B7DE9, GetTriggerUnit())
                call SaveUnitHandle(YDLOC, GetHandleId(ydl_timer), 0x248ED1E3, LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x248ED1E3))
                call TimerStart(ydl_timer, 0.10, true, function Trig_DMboss____________03Func004Func004Func003Func011T)
            else
            endif
            // 设置特效，单位，技能角度
            call SaveReal(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xB9A583B8, YDWEAngleBetweenUnits(GetTriggerUnit(), LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xD84480C3)))
            // 设置提示特效大小
            call SaveEffectHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x66F185C5, EC_CreateEffect("war3mapImported\\bossjinggaoh.mdl", GetUnitX(GetTriggerUnit()), GetUnitY(GetTriggerUnit()), 50.00, (LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xB9A583B8)), LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xD92E3573), 1.0, 0.50))
            // 闪光蓄力特效
            call YDWETimerDestroyEffect( 1.00, AddSpecialEffectTarget("war3mapImported\\a.mdx", GetTriggerUnit(), "origin") )
            // 符咒音效
            call SaveEffectHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x3D91B70E, EC_CreateEffect("Abilities\\Spells\\Other\\Charm\\CharmTarget.mdl", GetUnitX(GetTriggerUnit()), GetUnitY(GetTriggerUnit()), 50.00, 0.00, 0.00, 1.0, 0.50))
            if (((GetUnitTypeId(GetTriggerUnit()) == 'O005'))) then
                call SaveReal(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xCEA5D211, 0.00)
                set ydl_timer = CreateTimer()
                call SaveUnitHandle(YDLOC, GetHandleId(ydl_timer), 0x458B7DE9, GetTriggerUnit())
                call SaveReal(YDLOC, GetHandleId(ydl_timer), 0xD92E3573, LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xD92E3573))
                call SaveReal(YDLOC, GetHandleId(ydl_timer), 0xCEA5D211, LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xCEA5D211))
                call SaveReal(YDLOC, GetHandleId(ydl_timer), 0xB9A583B8, LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xB9A583B8))
                call TimerStart(ydl_timer, ((LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x9EF7B67E))*( 0.50)), true, function Trig_DMboss____________03Func004Func004Func012Func003T)
            else
            endif
        else
        endif
        // 范围提示
        if ((((GetUnitTypeId(GetTriggerUnit()) == 'E07X') and ((YDWEGetUnitAbilityDataString(GetTriggerUnit(), GetSpellAbilityId(), 1, 216) == "3"))))) then
            // Boss施法预警和前腰时是无敌的
            call SetUnitInvulnerable( GetTriggerUnit(), true )
            call SaveUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xD84480C3, GetSpellTargetUnit())
            // 加快技能施法速度
            call SetUnitTimeScale( GetTriggerUnit(), 1.50 )
            // 闪光蓄力特效
            call YDWETimerDestroyEffect( 1.00, AddSpecialEffectTarget("war3mapImported\\a.mdx", GetTriggerUnit(), "origin") )
            // 符咒音效
            call SaveEffectHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x3D91B70E, EC_CreateEffect("Abilities\\Spells\\Other\\Charm\\CharmTarget.mdl", GetUnitX(GetTriggerUnit()), GetUnitY(GetTriggerUnit()), 50.00, 0.00, 0.00, 1.0, 0.50))
            // 设置提示特效大小
            if ((((GetUnitTypeId(GetTriggerUnit()) == 'E07X') and ((YDWEGetUnitAbilityDataString(GetTriggerUnit(), GetSpellAbilityId(), 1, 216) == "3"))))) then
                call SaveReal(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xD92E3573, 1.25)
                call SaveReal(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xEDDD9784, 0.60)
                // 捕捉目标位置
                call SaveReal(YDHT, GetHandleId( GetTriggerUnit()), 0x60E214B9, GetUnitX(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xD84480C3)))
                call SaveReal(YDHT, GetHandleId( GetTriggerUnit()), 0x3471D943, GetUnitY(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xD84480C3)))
            else
            endif
            call SaveEffectHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x66F185C5, EC_CreateEffect("war3mapImported\\mr.war3_ring.mdl", GetUnitX(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xD84480C3)), GetUnitY(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xD84480C3)), 50.00, (LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xB9A583B8)), LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xD92E3573), 1.0, LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xEDDD9784)))
        else
        endif
        // 直线范围提示
        if (((GetUnitTypeId(GetTriggerUnit()) == 'E07X'))) then
            if ((GetUnitTypeId(GetTriggerUnit()) == 'E07X')) then
                if ((YDWEGetUnitAbilityDataString(GetTriggerUnit(), GetSpellAbilityId(), 1, 216) == "2")) then
                    call PlaySoundOnUnitBJ( gg_snd_tenshi7, 100, GetTriggerUnit() )
                else
                    if ((YDWEGetUnitAbilityDataString(GetTriggerUnit(), GetSpellAbilityId(), 1, 216) == "5")) then
                        call PlaySoundOnUnitBJ( gg_snd_tenshi1, 100, GetTriggerUnit() )
                    else
                        if ((YDWEGetUnitAbilityDataString(GetTriggerUnit(), GetSpellAbilityId(), 1, 216) == "3")) then
                            call PlaySoundOnUnitBJ( gg_snd_tenshi2, 100, GetTriggerUnit() )
                        else
                            if ((YDWEGetUnitAbilityDataString(GetTriggerUnit(), GetSpellAbilityId(), 1, 216) == "1")) then
                                call PlaySoundOnUnitBJ( gg_snd_tenshi8, 100, GetTriggerUnit() )
                            else
                            endif
                        endif
                    endif
                endif
            else
            endif
            // Boss施法预警和前腰时是无敌的
            call SaveUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xD84480C3, GetSpellTargetUnit())
            call SetUnitInvulnerable( GetTriggerUnit(), true )
            if ((10 >= 10)) then
                call SaveReal(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x9EF7B67E, S2R(EXExecuteScript("(require'jass.slk').ability[" + I2S( LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x2AAC512D)) + "]." + "DataA1")))
                // Debug，除0会崩溃
                if ((LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x9EF7B67E) <= 0.01)) then
                else
                    call SaveReal(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x5D04C6C8, ((1.00)/( LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x9EF7B67E))))
                endif
                call SaveUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x248ED1E3, CreateUnit(Player(0), 'e01O', GetUnitX(GetTriggerUnit()), GetUnitY(GetTriggerUnit()), 0))
                call SetUnitTimeScale( LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x248ED1E3), LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x5D04C6C8) )
                call SetUnitOwner( LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x248ED1E3), Player(4), true )
                call SetUnitFlyHeight( LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x248ED1E3), ((GetUnitFlyHeight(GetTriggerUnit()))+( 350.00)), 0.00 )
                call YDWETimerRemoveUnit( LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x9EF7B67E), LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x248ED1E3) )
                call UnitRemoveBuffsEx( GetTriggerUnit(), false, true, false, false, false, false, true )
                // 大招特有的魔法阵特效
                if ((((GetUnitTypeId(GetTriggerUnit()) == 'E07X') and ((YDWEGetUnitAbilityDataString(GetTriggerUnit(), GetSpellAbilityId(), 1, 216) == "2") or (YDWEGetUnitAbilityDataString(GetTriggerUnit(), GetSpellAbilityId(), 1, 216) == "6"))))) then
                    call SaveEffectHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x42E28B61, EC_CreateEffect("war3mapImported\\fate.mdl", GetUnitX(GetTriggerUnit()), GetUnitY(GetTriggerUnit()), 50.00, 0.00, 3.00, 1.00, LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x9EF7B67E)))
                    set ydl_timer = CreateTimer()
                    call SaveEffectHandle(YDLOC, GetHandleId(ydl_timer), 0x42E28B61, LoadEffectHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x42E28B61))
                    call TimerStart(ydl_timer, LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x9EF7B67E), false, function Trig_DMboss____________03Func004Func008Func006Func012Func003T)
                else
                endif
                if ((((GetUnitTypeId(GetTriggerUnit()) == 'E07X') and ((YDWEGetUnitAbilityDataString(GetTriggerUnit(), GetSpellAbilityId(), 1, 216) == "3") or (YDWEGetUnitAbilityDataString(GetTriggerUnit(), GetSpellAbilityId(), 1, 216) == "4") or (YDWEGetUnitAbilityDataString(GetTriggerUnit(), GetSpellAbilityId(), 1, 216) == "5") or (YDWEGetUnitAbilityDataString(GetTriggerUnit(), GetSpellAbilityId(), 1, 216) == "6") or (YDWEGetUnitAbilityDataString(GetTriggerUnit(), GetSpellAbilityId(), 1, 216) == "7"))))) then
                    call FlushChildHashtable(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step)
                    set ydl_timer = null
                    return
                else
                endif
            else
            endif
            // 设置特效，单位，技能角度
            call SaveReal(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xB9A583B8, YDWEAngleBetweenUnits(GetTriggerUnit(), LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xD84480C3)))
            // 设置提示特效大小
            if ((((GetUnitTypeId(GetTriggerUnit()) == 'E07X') and ((YDWEGetUnitAbilityDataString(GetTriggerUnit(), GetSpellAbilityId(), 1, 216) == "1"))))) then
                call SaveReal(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xD92E3573, 3.00)
            else
                call SaveReal(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xD92E3573, 4.00)
            endif
            call SaveEffectHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x66F185C5, EC_CreateEffect("war3mapImported\\bossjinggaoh.mdl", GetUnitX(GetTriggerUnit()), GetUnitY(GetTriggerUnit()), 50.00, (LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xB9A583B8)), LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xD92E3573), 1.0, 0.50))
            // 闪光蓄力特效
            call YDWETimerDestroyEffect( 1.00, AddSpecialEffectTarget("war3mapImported\\a.mdx", GetTriggerUnit(), "origin") )
            // 符咒音效
            call SaveEffectHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x3D91B70E, EC_CreateEffect("Abilities\\Spells\\Other\\Charm\\CharmTarget.mdl", GetUnitX(GetTriggerUnit()), GetUnitY(GetTriggerUnit()), 50.00, 0.00, 0.00, 1.0, 0.50))
            if ((((GetUnitTypeId(GetTriggerUnit()) == 'E07X') and ((YDWEGetUnitAbilityDataString(GetTriggerUnit(), GetSpellAbilityId(), 1, 216) == "1") or (YDWEGetUnitAbilityDataString(GetTriggerUnit(), GetSpellAbilityId(), 1, 216) == "2"))))) then
                call SaveReal(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xCEA5D211, 0.00)
                set ydl_timer = CreateTimer()
                call SaveUnitHandle(YDLOC, GetHandleId(ydl_timer), 0x458B7DE9, GetTriggerUnit())
                call SaveReal(YDLOC, GetHandleId(ydl_timer), 0xD92E3573, LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xD92E3573))
                call SaveReal(YDLOC, GetHandleId(ydl_timer), 0xCEA5D211, LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xCEA5D211))
                call SaveUnitHandle(YDLOC, GetHandleId(ydl_timer), 0xD84480C3, LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xD84480C3))
                call SaveReal(YDLOC, GetHandleId(ydl_timer), 0xB9A583B8, LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xB9A583B8))
                call TimerStart(ydl_timer, 0.40, true, function Trig_DMboss____________03Func004Func008Func016Func003T)
            else
            endif
        else
        endif
    else
    endif
    if ((((EVENT_PLAYER_UNIT_SPELL_ENDCAST == GetTriggerEventId()) == true) or ((EVENT_UNIT_SPELL_ENDCAST == GetTriggerEventId()) == true))) then
        if ((((GetUnitTypeId(GetTriggerUnit()) == 'E07X') and ((YDWEGetUnitAbilityDataString(GetTriggerUnit(), GetSpellAbilityId(), 1, 216) == "1") or (YDWEGetUnitAbilityDataString(GetTriggerUnit(), GetSpellAbilityId(), 1, 216) == "2") or (YDWEGetUnitAbilityDataString(GetTriggerUnit(), GetSpellAbilityId(), 1, 216) == "4") or (YDWEGetUnitAbilityDataString(GetTriggerUnit(), GetSpellAbilityId(), 1, 216) == "5") or (YDWEGetUnitAbilityDataString(GetTriggerUnit(), GetSpellAbilityId(), 1, 216) == "6") or (YDWEGetUnitAbilityDataString(GetTriggerUnit(), GetSpellAbilityId(), 1, 216) == "7"))))) then
            // Boss施法结束后取消无敌
            call SetUnitInvulnerable( GetTriggerUnit(), false )
        else
        endif
        if ((((GetUnitTypeId(GetTriggerUnit()) == 'E07X') and ((YDWEGetUnitAbilityDataString(GetTriggerUnit(), GetSpellAbilityId(), 1, 216) == "3"))))) then
            call SetUnitTimeScale( GetTriggerUnit(), 1.00 )
            call SetUnitInvulnerable( GetTriggerUnit(), false )
        else
        endif
    else
    endif
    if ((GetUnitTypeId(GetTriggerUnit()) == 'O005') and (YDWEGetUnitAbilityDataString(GetTriggerUnit(), GetSpellAbilityId(), 1, 216) == "3")) then
        call SaveUnitHandle(YDHT, GetHandleId( GetTriggerUnit()), 0x70358094, GetSpellTargetUnit())
    else
    endif
    call FlushChildHashtable(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step)
    set ydl_timer = null
endfunction
