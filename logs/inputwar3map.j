            endif
            call TransmissionFromUnitWithNameBJ( GetPlayersAll(), null, GetUnitName(GetSellingUnit()), null, "TRIGSTR_814", bj_TIMETYPE_SET, 2.00, true )
            call SetUnitOwner( GetSellingUnit(), Player(6), true )
