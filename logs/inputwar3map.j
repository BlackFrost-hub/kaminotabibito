function Trig_NHSLY____________Q___uFunc003Func002Func025Func001Func004Func001Func017A takes nothing returns nothing
    call SaveUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15, GetEnumUnit())
    call SaveLocationHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x5BAD7525, GetUnitLoc(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15)))
    call SaveLocationHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xAF487022, PolarProjectionBJ(LoadLocationHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x5BAD7525), 20.00, LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xB9A583B8)))
