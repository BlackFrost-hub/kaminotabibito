    call SaveUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15, GetEnumUnit())
    call SetUnitPathing( GetEnumUnit(), false )
    call SaveLocationHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x30520E37, GetUnitLoc(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15)))
    call SaveLocationHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x389B6519, PolarProjectionBJ(LoadLocationHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x30520E37), 25.00, ((GetUnitFacing(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15)))+( 180.00))))
