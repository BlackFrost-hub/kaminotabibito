function Trig_L______ResenFunc006Func017Func005Func002A takes nothing returns nothing
    local group ydl_group
    local unit ydl_unit
    call SaveUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x68B72DFF, GetEnumUnit())
    if ((IsUnitPausedBJ(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x68B72DFF)) == true)) then
    else
        call SaveLocationHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x5E86E850, GetUnitLoc(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x68B72DFF)))
        call SaveLocationHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x1AF7BCBB, PolarProjectionBJ(LoadLocationHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x5E86E850), 30.00, GetUnitFacing(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x68B72DFF))))
        call SetUnitX( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x68B72DFF), GetLocationX(LoadLocationHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x1AF7BCBB)) )
        call SetUnitY( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x68B72DFF), GetLocationY(LoadLocationHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x1AF7BCBB)) )
        call RemoveLocation( LoadLocationHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x5E86E850) )
        call RemoveLocation( LoadLocationHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x1AF7BCBB) )
        set ydl_group = CreateGroup()
        call GroupEnumUnitsInRange(ydl_group, GetUnitX(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x68B72DFF)), GetUnitY(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x68B72DFF)), 127.00, null)
        loop
            set ydl_unit = FirstOfGroup(ydl_group)
            exitwhen ydl_unit == null
            call GroupRemoveUnit(ydl_group, ydl_unit)
            if ((IsUnitType(ydl_unit, UNIT_TYPE_ANCIENT) == false) and (IsUnitAliveBJ(ydl_unit) == true) and (IsUnitType(ydl_unit, UNIT_TYPE_STRUCTURE) == false) and (IsUnitEnemy(ydl_unit, GetOwningPlayer(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xE97D6160))) == true)) then
                if ((IsUnitInGroup(ydl_unit, LoadGroupHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x56E86570)) == true)) then
                    call UnitDamageTarget( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xE97D6160), ydl_unit, ((LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0x9375D887))*( 0.10)), false, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, WEAPON_TYPE_WHOKNOWS )
                else
                    call GroupAddUnit( LoadGroupHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x56E86570), ydl_unit )
                    call UnitDamageTarget( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xE97D6160), ydl_unit, LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0x9375D887), false, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, WEAPON_TYPE_WHOKNOWS )
                endif
                call RemoveUnit( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x68B72DFF) )
            else
            endif
        endloop
        call DestroyGroup(ydl_group)
    endif
    set ydl_group = null
    set ydl_unit = null
endfunction
