        if ((LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xB9A583B8) >= 450.00)) then
            call SaveReal(YDLOC, GetHandleId(GetTriggeringTrigger()), 0x4C2AEFA3, GetUnitFacing(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xE97D6160)))
            call ShowUnit( LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xE97D6160), false )
            call SetUnitPositionLocFacingBJ( LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xDB988C32), LoadLocationHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xA1F2FC21), LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger()), 0x4C2AEFA3) )
