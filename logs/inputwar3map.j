//! zinc
library StarEvent{
    public{
        trigger StarTrig_ItemPickUP = CreateTrigger();
        trigger StarTrig_UnitOrder = CreateTrigger();
        trigger StarTrig_UnitSell = CreateTrigger();
    }
    public function SE_Filter()->boolean{
        //Print(GetUnitName(GetFilterUnit()));
        return IsHeroUnitId(GetUnitTypeId(GetFilterUnit()));
    }
    public {
        trigger StarTrig_OnDie = CreateTrigger();
        trigger StarTrig_EnterMap = CreateTrigger();
    }
    private function onInit()
    {
        integer i = 0;
        TriggerRegisterAnyUnitEventBJ(StarTrig_OnDie, EVENT_PLAYER_UNIT_DEATH);
        while(i<=4)
        {
            TriggerRegisterPlayerUnitEvent(StarTrig_UnitOrder,Player(i),EVENT_PLAYER_UNIT_ISSUED_TARGET_ORDER,function SE_Filter);
            TriggerRegisterPlayerUnitEvent(StarTrig_ItemPickUP,Player(i),EVENT_PLAYER_UNIT_PICKUP_ITEM,function SE_Filter);
            TriggerRegisterPlayerUnitEvent(StarTrig_UnitSell,Player(i),EVENT_PLAYER_UNIT_SELL_ITEM,function SE_Filter);
            i+=1;
        }
        // TimerStart(CreateTimer(),0,false,function(){
        //     DestroyTimer(GetExpiredTimer());
        // });
    }
}
