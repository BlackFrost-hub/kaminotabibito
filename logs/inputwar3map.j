function Trig_L______ResenFunc002Func008Func006Conditions takes nothing returns nothing
    local timer ydl_timer
    if (((EVENT_GAME_TIMER_EXPIRED == GetTriggerEventId()) == true)) then
        call RemoveLocation( LoadLocationHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xA1F2FC21) )
        call FlushChildHashtable(YDLOC, GetHandleId(GetTriggeringTrigger()))
