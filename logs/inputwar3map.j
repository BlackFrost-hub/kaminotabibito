 set ydl_localvar_step = ydl_localvar_step + 3 
 call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xCFDE6C76, ydl_localvar_step) 
 call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7, ydl_localvar_step)
    call SaveReal(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x581208AD, ((LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xF415B620))/( LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x6B54C545))))
    call SaveReal(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xD3894E59, ((LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xF415B620))/( 2.00)))
    call SaveUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x76ABBC1D, GetTriggerUnit())
    if ((GetSpellAbilityId() == LoadInteger(YDHT, GetHandleId( GetTriggerUnit()), 0x2FC9F415))) then
        call StringBufferAdd( udg_String/*常量字符串*/[0] )
        call StringBufferAdd( udg_String/*常量字符串*/[22] )
