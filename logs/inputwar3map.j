//===========================================================================
// Trigger: “Deflation World（收缩的世界）“（RD）
//===========================================================================
function Trig____Deflation_World___________________________RD___uConditions takes nothing returns boolean
    return ((GetSpellAbilityId() == 'A0CS'))
endfunction
function Trig____Deflation_World___________________________RD___uFunc025Func001Func014Func001Func001003003 takes nothing returns boolean
    return ((((IsUnitType(GetFilterUnit(), UNIT_TYPE_ANCIENT) == false) and (IsUnitType(GetFilterUnit(), UNIT_TYPE_MECHANICAL) == false)) and (((IsUnitAliveBJ(GetFilterUnit()) == true) and (IsUnitInGroup(GetFilterUnit(), LoadGroupHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x28F9922D)) == false)) and (IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9))) == true))))
endfunction
function Trig____Deflation_World___________________________RD___uFunc025Func001Func014Func001Func002A takes nothing returns nothing
    call PauseUnitBJ( true, GetEnumUnit() )
    call SetUnitTimeScale( GetEnumUnit(), 0.00 )
    call GroupAddUnit( LoadGroupHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x28F9922D), GetEnumUnit() )
endfunction
function Trig____Deflation_World___________________________RD___uFunc025Func001Func014Func001Func004Func002Func001Func007A takes nothing returns nothing
    call EXSetUnitCollisionType( true, GetEnumUnit(), 1 )
    call PauseUnitBJ( false, GetEnumUnit() )
    call SetUnitTimeScale( GetEnumUnit(), 1.00 )
    call SetUnitPathing( GetEnumUnit(), true )
endfunction
function Trig____Deflation_World___________________________RD___uFunc025Func001Func014Func001Func004Func002Func001Func008A takes nothing returns nothing
    call SetUnitTimeScale( GetEnumUnit(), 1.00 )
endfunction
function Trig____Deflation_World___________________________RD___uFunc025Func001Func014Func001Func004Func002Func001Func011003003 takes nothing returns boolean
    return (((IsUnitType(GetFilterUnit(), UNIT_TYPE_TAUREN) == false) and (((IsUnitAliveBJ(GetFilterUnit()) == true) and (10 >= 10)) and (IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9))) == true))))
endfunction
