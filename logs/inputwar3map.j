    public function SGSS_SetUnitAllPercentum(unit u,real v){
        SGSS_SetUnitStrPercentum(u,v);
        SGSS_SetUnitAgiPercentum(u,v);
        SGSS_SetUnitIntPercentum(u,v);
    }
    //���ӵ�λ����-�ٷֱ� 1= ������ 2= ������ 3=����ֵ 4=����ֵ 5=����ֵ 6=ȫ���� 7= ����ֵ 8 = ����ֵ
    public function SGSS_SetStatePercentum(unit u,integer id,real v)
    {
        if(id==1){
            SGSS_SetUnitAttackPercentum(u,v);
        }
        else if(id==2){
            SGSS_SetUnitAmrrorPercentum(u,v);
        }
        else if(id==3){
            SGSS_SetUnitStrPercentum(u,v);
        }
        else if(id==4){
            SGSS_SetUnitAgiPercentum(u,v);
        }
        else if(id==5){
            SGSS_SetUnitIntPercentum(u,v);
        }
        else if(id==6){
            SGSS_SetUnitStrPercentum(u,v);
            SGSS_SetUnitAgiPercentum(u,v);
            SGSS_SetUnitIntPercentum(u,v);
        }
        else if(id==7){
            SGSS_SetUnitHPPercentum(u,v);
        }
        else if(id==8){
            SGSS_SetUnitMPPercentum(u,v);
        }
    }
    
    //#ifdef Map_traveller
    private timer t = CreateTimer();
    private integer index =0;
    private unit list[];
    private real xiaolv = 1;
    public function SGSS_UnitStateListener(unit u){
        real temp = 0;
        if(HaveSavedInteger(StarBaseHT,GetHandleId(u),0x268A0CFC))
        {
            //Print("�ظ����أ�");
            return;
        }
        SaveInteger(StarBaseHT,GetHandleId(u),0x268A0CFC,index);
        list[index] = u;
        index = index + 1;
        TimerStart(t,1,true,function (){
            integer i =0;
            real temp = 0;
            integer hd= 0;
            while(i<index){
                hd = GetHandleId(list[i]);
                SGSS_SetUnitAttackPercentum(list[i],0);
                SGSS_SetUnitAmrrorPercentum(list[i],0);
                SGSS_SetUnitStrPercentum(list[i],0);
                SGSS_SetUnitAgiPercentum(list[i],0);
                SGSS_SetUnitIntPercentum(list[i],0);
                SGSS_SetUnitAllPercentum(list[i],0);
                SGSS_SetUnitHPPercentum(list[i],0);
                SGSS_SetUnitMPPercentum(list[i],0);
                temp = LoadReal(StarBaseHT,hd,key_rhp);
                if(temp!=0){
                    SetWidgetLife(list[i],RMaxBJ(.5,GetWidgetLife(list[i])+temp*xiaolv));
                }
                temp = LoadReal(StarBaseHT,hd,key_rmp);
                if(temp!=0){
                    SetUnitState(list[i],UNIT_STATE_MANA,GetUnitState(list[i],UNIT_STATE_MANA)+temp*xiaolv);
                }
                temp = GetUnitDefaultMoveSpeed(list[i]) + LoadReal(YDHT,GetHandleId(list[i]),0x1C729898);
                if(temp>=400){
                    SOS_SetUnitSpeed(list[i],temp,true);
                }
                else{
                    SOS_UnSetUnitSpeed(list[i]);
                }
                i= i + 1;
            }
        });
    }
    public function SGSS_UnitRegStateListener(unit u){
        if(HaveSavedInteger(StarBaseHT,GetHandleId(u),0x268A0CFC))
        {
            //Print("�ظ����أ�");
            return;
        }
        SaveInteger(StarBaseHT,GetHandleId(u),0x268A0CFC,index);
        list[index] = u;
        index = index + 1;
        TimerStart(t,1,true,function (){
            integer i =0;
            while(i<index){
                //Print("i="+I2S(i));
                SGSS_SetUnitAttackPercentum(list[i],0);
                SGSS_SetUnitAmrrorPercentum(list[i],0);
                SGSS_SetUnitStrPercentum(list[i],0);
                SGSS_SetUnitAgiPercentum(list[i],0);
                SGSS_SetUnitIntPercentum(list[i],0);
                SGSS_SetUnitAllPercentum(list[i],0);
                SGSS_SetUnitHPPercentum(list[i],0);
                SGSS_SetUnitMPPercentum(list[i],0);
                i= i + 1;
            }
        });
    }
    public function SGSS_UnitUnRegStateListener(unit u){
        integer i;
        if(HaveSavedInteger(StarBaseHT,GetHandleId(u),0x268A0CFC) )
        {
            i = LoadInteger(StarBaseHT,GetHandleId(u),0x268A0CFC);
            list[i] = list[index];
            index = index - 1;
            RemoveSavedInteger(StarBaseHT,GetHandleId(u),0x268A0CFC);
        }
    }
