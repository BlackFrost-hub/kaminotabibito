library X initializer Init
//X_GDBC : 坐标间距离 x1 y1 x2 y2
//X_GAFC : 坐标间角度 x1 y1 x2 y2
//X_SetUnitMovable 设置单位是否可以移动
//X_GetAbleX 在检测可通行性之后 获取可通行的X坐标
//X_GetAbleY 在检测可通行性之后 获取可通行的Y坐标
//R2I2 转换实数为整数[四舍五入]
//X_IsTerrainWalkable x y  坐标可通行
//========================
globals
    public hashtable ht = InitHashtable()
    private constant real MAX_RANGE = 10.
    private constant integer DUMMY_ITEM_ID = 'wolg'
endglobals
globals
    private item Item = null
    private rect Find = null
    private item array Hid
    private integer HidMax = 0
    public real X = 0.
    public real Y = 0.
endglobals
public function IsTerrainDeepWater takes real x, real y returns boolean
    return not IsTerrainPathable(x, y, PATHING_TYPE_FLOATABILITY) and IsTerrainPathable(x, y, PATHING_TYPE_WALKABILITY)
endfunction
public function IsTerrainShallowWater takes real x, real y returns boolean
    return not IsTerrainPathable(x, y, PATHING_TYPE_FLOATABILITY) and not IsTerrainPathable(x, y, PATHING_TYPE_WALKABILITY) and IsTerrainPathable(x, y, PATHING_TYPE_BUILDABILITY)
endfunction
public function IsTerrainLand takes real x, real y returns boolean
    return IsTerrainPathable(x, y, PATHING_TYPE_FLOATABILITY)
endfunction
public function IsTerrainPlatform takes real x, real y returns boolean
    return not IsTerrainPathable(x, y, PATHING_TYPE_FLOATABILITY) and not IsTerrainPathable(x, y, PATHING_TYPE_WALKABILITY) and not IsTerrainPathable(x, y, PATHING_TYPE_BUILDABILITY)
endfunction
private function HideItem takes nothing returns nothing
    if IsItemVisible(GetEnumItem()) then
        set Hid[HidMax] = GetEnumItem()
        call SetItemVisible(Hid[HidMax], false)
        set HidMax = HidMax + 1
    endif
endfunction
public function IsTerrainWalkable takes real x, real y returns boolean
    //隐藏这个区域内的其他物品，防止物品间的碰撞导致bug
    call MoveRectTo(Find, x, y)
    call EnumItemsInRect(Find ,null, function HideItem)
    //物品法检测
    call SetItemPosition(Item, x, y) //Unhides the item
set X = GetItemX(Item)
    set Y = GetItemY(Item)
    static if LIBRARY_X then
        set X_X = X
        set X_Y = Y
    endif
    call SetItemVisible(Item, false)//隐藏用来检测的物品 （怀特的另一条腿）
    //显示这个区域的物品
    loop
        exitwhen HidMax <= 0
        set HidMax = HidMax - 1
        call SetItemVisible(Hid[HidMax], true)
        set Hid[HidMax] = null
    endloop
    //返回是否可以通行
    return (X-x)*(X-x)+(Y-y)*(Y-y) <= MAX_RANGE*MAX_RANGE and not IsTerrainPathable(x, y, PATHING_TYPE_WALKABILITY)
endfunction
//设置单位可移动性
public function SetUnitMovable takes unit u,boolean b returns nothing
if b then
    call SetUnitPropWindow(u, GetUnitDefaultPropWindow(u))
else
    call SetUnitPropWindow(u, 0)
endif
endfunction
//坐标间距离 x1 y1 x2 y2
public function GDBC takes real x1,real y1,real x2,real y2 returns real
    return SquareRoot((y1-y2)*(y1-y2)+(x1-x2)*(x1-x2))
endfunction
//坐标间角度 x1 y1 x2 y2
public function GAFC takes real x1,real y1,real x2,real y2 returns real
return Rad2Deg(Atan2(y2-y1,x2-x1))
endfunction
//可通行X坐标
public function GetAbleX takes nothing returns real
return X
endfunction
//可通行Y坐标
public function GetAbleY takes nothing returns real
return Y
endfunction
//转换实数为整数(四舍五入)
public function X_R2I2 takes real r returns integer
    return R2I(r+0.5)
endfunction
//转换实数为整数(四舍五入)
function R2I2 takes real r returns integer
    return R2I(r+0.5)
endfunction
//碰撞检测初始化
private function Init takes nothing returns nothing
    set Find = Rect(0., 0., 128., 128.)
    set Item = CreateItem(DUMMY_ITEM_ID, 0, 0)
    call SetItemVisible(Item, false)
endfunction
endlibrary
//为单位注册添加事件响�?参数 单位 事件�?触发�?禁止重复添加
//为单位移除事件响�?参数 单位 事件�?触发�?禁止重复添加
//! zinc
library STES requires StarBase
{
    /*
        自定义事件系统
    */
    private hashtable HT = InitHashtable();
    public hashtable STES_HT;
    //count = skey_count;
    public
    {
        integer STES_Hash;
        integer STES_Index;
        integer STES_LoopA;
        function STES_GetTable()->hashtable{
            return HT;
        }
        //为触发器注册自定义事件 事件名 = name
        function STES_Register(trigger t,string name)
        {
            integer hash = StringHash(name);
            integer hd = GetHandleId(t);
            integer index = LoadInteger(HT,hash,skey_index);//获取计数
            integer index2 = LoadInteger(HT,hd,skey_index);//触发器上的事件计数
            //事件绑定触发器队列
            SaveTriggerHandle(HT,hash,index,t);//保存触发器//index += 1;
            SaveInteger(HT,hash,skey_index,index+1);//保存计数
            //触发器上绑定对应事件
            SaveStr(HT,hd,index2,name);//保存事件
            SaveInteger(HT,hd,skey_index,index2+1);//保存事件计数
            //SaveInteger(HT,hd,skey_count,index)//保存事件计数
        }
        ///注册事件Ex
        function STES_RegisterEx(string funcName,string eventName){
            integer hash = StringHash(eventName);
            integer hd = StringHash(funcName);
            integer index = LoadInteger(HT,hash,skey_indexEx);//获取计数
            integer index2 = LoadInteger(HT,hd,skey_indexEx);//触发器上的事件计数
            //事件绑定触发器队列
            SaveStr(HT,hash,index,funcName);//保存函数名//index += 1;
            SaveInteger(HT,hash,skey_indexEx,index+1);//保存计数
            //函数上绑定对应事件
            SaveStr(HT,hd,index2,eventName);//保存事件
            SaveInteger(HT,hd,skey_indexEx,index2+1);//保存事件计数
        }
        //无参版本 有参版本写在dll里面
        function STES_Execute(string name)
        {
            integer hash = StringHash(name);
            integer index = LoadInteger(HT,hash,skey_index);//获取计数
            integer i = 0;trigger t;
            while(i<index)
            {
                t = LoadTriggerHandle(HT,hash,i);
                //运行触发器t
                if(TriggerEvaluate(t)){TriggerExecute(t);}
                i+=1;
            }
            t = null;
        }
        //注册单位自定义事件
        function STES_GetUnitEvent(unit u,string name)->string{
            return I2S(GetHandleId(u))+name;
        }
        //清除触发器上的指定事件
        function STES_RemoveEvent(trigger t,string Targetname){
            integer hd = GetHandleId(t);
            integer index = LoadInteger(HT,hd,skey_index);//获取触发器上事件计数
            integer i =0,a =0,b=0;
            string name;integer hash;
            trigger t1;
            while(i<index)
            { 
                name = LoadStr(HT,hd,i);//如果事件名称 相同 那么清除它
                if(name == Targetname)
                {
                    hash = StringHash(name);
                    a = LoadInteger(HT,hash,skey_index);//获取计数
                    while(b<a)
                    {
                        t1 = LoadTriggerHandle(HT,hash,b);
                        if(t1==t)
                        {
                            a=a-1;
                            t1 = LoadTriggerHandle(HT,hash,a);
                            SaveTriggerHandle(HT,hash,b,t1);
                            SaveInteger(HT,hash,skey_index,a);
                            if(a>=b){break;}
                        }
                        b+=1;
                    }
                    SaveStr(HT,hd,i,LoadStr(HT,hd,index));
                    index-=1;
                    SaveInteger(HT,hash,skey_index,index);
                    if(i>=index){break;}
                }
                i+=1;
            }
            //FlushChildHashtable(HT,hd);
            t1=null;
        }
        //清除触发器上的所有自定义事件
        function STES_Remove(trigger t)
        {
            integer hd = GetHandleId(t);
            integer index = LoadInteger(HT,hd,skey_index);//获取触发器上事件计数
            integer i =0,a =0,b=0;
            string name;integer hash;
            trigger t1;
            //遍历触发器上所有事件
            while(i<index)
            { 
                name = LoadStr(HT,hd,i);//事件名称
                hash = StringHash(name);//事件hash
                a = LoadInteger(HT,hash,skey_index);//获取计数
                while(b<a)
                {
                    t1 = LoadTriggerHandle(HT,hash,b);//遍历事件
                    if(t1==t)//找到事件对应的触发器
                    {
                        a=a-1;//触发器数量-1
                        t1 = LoadTriggerHandle(HT,hash,a);//将顶部的触发器拉过来)
                        SaveTriggerHandle(HT,hash,b,t1);//save
                        SaveInteger(HT,hash,skey_index,a);//save index
                        if(a>=b){break;}
                    }
                    b+=1;
                }
                i+=1;
            }
            FlushChildHashtable(HT,hd);
            t1=null;
        }
        private function onInit(){
            STES_HT = HT;
        }
    }
}
//! endzinc
//! zinc
library SUTriggerList requires STES,StarBase{
    //运行[单位]${u}身上所有事件名�?{s}的触发器 
    //StarExcuteUnitEvent
    //运行[单位]${u}身上所有事件名�?{s}的触发器 计算返回�?
    //StarExcuteUnitEventII
    private integer key_Count = 0x720A60C0;
    private hashtable ht = InitHashtable();
    public hashtable SUTL_HT;
    //@abc T封装可变类型Key 无效�?
    //@u  绑定的目标对�?
    //@c  事件的整数ID
    //@t  响应事件的触发器
    public function SUTL_GetHashCode(string name)->integer{
        return StringHash(name);
    }
    public function SUTL_UnitAddEventCallBack(integer abc,handle u,integer c,trigger t){
        integer uhd = GetHandleId(u);//单位句柄
        integer thd = GetHandleId(t);//触发器句�?
        integer uCode = uhd+c;//单位的事件索�?单位句柄+事件ID)
        integer index = LoadInteger(ht, uCode,skey_index);//读取绑定在该事件下的触发器数�?
        SaveInteger(ht,uhd,thd+key_Count,LoadInteger(ht,uhd,thd+key_Count)+1);//绑定在单位上的该触发器数�?+ 1
        if(!HaveSavedInteger(ht,GetHandleId(t),uCode))//如果没有注册
        {
            SaveTriggerHandle(ht, uCode,index,t);//绑定触发器到单位事件队列�?
            SaveInteger(ht,GetHandleId(t),uCode,index);//记录索引在触发器t的uCode�?
            SaveInteger(ht, uCode,skey_index,index+1);//绑定在该事件下的触发器数�?+ 1
        }
    }
    public function SUTL_GetUnitEventCount(unit u,integer c)->integer{
        return LoadInteger(ht,GetHandleId(u),c+key_Count);
    }
    public function SUTL_GetObjectEventCount(integer abc,handle u,trigger t)->integer{
        integer thd = GetHandleId(t);
        // Print(I2S(thd)+"||"+I2S(LoadInteger(ht,GetHandleId(u),thd+key_Count)));
        return LoadInteger(ht,GetHandleId(u),thd+key_Count);
    }
    public function SUTL_ClearObejctAllEvent(integer abc,handle u){
        integer uhd = GetHandleId(u);
        //怎么写呢 怎么写呢 怎么写呢
    }
    //StarExecuteUnitEvent
    //如何获取这些触发�?
    //循环 i < (GetHandleId(0)+StringHash(1) 为索�?0xA707D18B 为子�? do 
    //运行触发�?
    public function SUTL_UnitRemoveEventCallBack(integer abc,handle u,integer c,trigger t){
        integer uhd = GetHandleId(u);
        integer thd = GetHandleId(t);
        integer uCode = uhd+c;
        integer index = LoadInteger(ht, uCode,skey_index) - 1;//读取index
        integer i = 0;
        trigger trig;
        SaveInteger(ht,uhd,thd+key_Count,LoadInteger(ht,uhd,thd+key_Count)-1);
        //Print(I2S(thd)+"的计�?>"+I2S(LoadInteger(ht,GetHandleId(u),thd+key_Count)));
        if(LoadInteger(ht,uhd,thd+key_Count)>0)
        {
            return;
        }
        //Print("卸载");
        //printsi("index =",index);
        i = LoadInteger(ht,GetHandleId(t),uCode);//读取索引//索引�? 得到真实数组顶部
        //printsi("index =",LoadInteger(ht, uCode,skey_index));
        RemoveSavedInteger(ht,GetHandleId(t),uCode);//删除索引从t的uCode�?
        if(i!=index) {
            //printsi(" in index =",LoadInteger(ht, uCode,skey_index));
            trig = LoadTriggerHandle(ht, uCode,index);//读取顶部触发�?
            SaveTriggerHandle(ht, uCode,i,trig);//用顶部覆盖当前位�?
            SaveInteger(ht,GetHandleId(trig),uCode,index);//更新索引
        }
        //printsi("index =",LoadInteger(ht, uCode,skey_index));
        SaveInteger(ht, uCode,skey_index,index);//更新�?
        trig = null;
        //printsi("index =",LoadInteger(ht, uCode,skey_index));
        // while(i<index){
        //     trig = LoadTrigger(ht, uCode,i);
        //     if(trig == t){
        //         //doEvent
        //     }
        //     i+=1;
        // }
    }
    public function SUTL_UnitAddEventCallBackEx(handle a,integer b,trigger c,boolean d)
    {
        if(d){
            SUTL_UnitAddEventCallBack(0,a,b,c);
        }else{
            SUTL_UnitRemoveEventCallBack(0,a,b,c);
        }
    }
    
    function onInit(){
        SUTL_HT = ht;
    }
    //
}
