            call KillUnit( GetTriggerUnit() )
            call SetUnitFacing( LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xE97D6160), (LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger()), 0x4745E4A7)) )
            call ShowUnit( LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xE97D6160), true )
            call SetUnitPositionLoc( LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xE97D6160), LoadLocationHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0x2A829619) )
            call DestroyEffect( AddSpecialEffectTarget("war3mapImported\\Whine.mdx", LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xE97D6160), "origin") )
            call SetUnitVertexColorBJ( LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xE97D6160), 100, 100, 100, 0.00 )
            call SelectUnitForPlayerSingle( LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xE97D6160), GetOwningPlayer(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xE97D6160)) )
            call RemoveLocation( LoadLocationHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0x2A829619) )
            call FlushChildHashtable(YDLOC, GetHandleId(GetTriggeringTrigger()))
            call DestroyTrigger(GetTriggeringTrigger())
