    }
    public function SGSS_SetUnitState_Str(unit u,real v){
        SGSS_SetUnitState(u,v,0,0);
    }
    public function SGSS_SetUnitState_Agi(unit u,real v){
        SGSS_SetUnitState(u,0,v,0);
    }
    public function SGSS_SetUnitState_Int(unit u,real v){
