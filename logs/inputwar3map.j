public struct SEffect 
{
    //static SEffect List[];
    static integer TI;//临时变量-整数
    //static integer index = 0;
    effect object;//特效对象
    string path;//路径
    integer id;//在所属区块中的ID
    integer own;//所属区块
    //新建特效在坐标
    static method create(string name,real x,real y)->thistype
    {
        thistype ect = thistype.allocate();
        ect.object = AddSpecialEffect(name,x,y);
        ect.path = name;
        //记录对象
        ect.own = R2I(x/Map.size+0.5)*Map.blockMaxX + R2I(y/Map.size+0.5);
        //区块添加对象
        Block.blocks[ect.own].add(ect);
        //返回
        return ect;
    }
    //获取特效路径
    public method getPath()->string{return this.path;}
    //获取X
    public method x()->real{return EXGetEffectX(this.object);}
    //获取Y
    public method y()->real{return EXGetEffectY(this.object);}
    //获取z
    public method z()->real{return EXGetEffectZ(this.object);}
    //设置XY
    public method setXY(real x, real y){
        EXSetEffectXY(this.object,x,y);
        TI = R2I(x/Map.size+0.5)*Map.blockMaxX + R2I(y/Map.size+0.5);
        if(TI!=this.own)
        {
            //为旧区块移除对象
            Block.blocks[this.own].remove(this);
            this.own = TI;
            //为新区块增加对象
            Block.blocks[this.own].add(this);
        }
    }
    //设置Z
    public method setZ(real z){EXSetEffectZ(this.object,z);}
    //设置朝向
    public method setFacting(real f){thistype.SetRotateZ(this.object,f);}
    //获取尺寸
    public method size()->real{return EXGetEffectSize(this.object);}
    //设置尺寸
    public method setSize(real size){EXSetEffectSize(this.object,size);}
    //获取句柄
    public method getHandle()->integer{return GetHandleId(this.object);}
    //更换特效
    public method replaceEffect(effect e){
        this.setZ(999999);
        DestroyEffect(this.object);
        this.object =e;
    }
    //destroy
    public method onDestroy(){
        //摧毁特效
        DestroyEffect(this.object);
        //为区块移除对象
        Block.blocks[this.own].remove(this);
    }
    //尺寸
    static method Size(effect e)->real{return EXGetEffectSize(e);}
    //设置尺寸
    static method SetSize(effect e,real size){EXSetEffectSize(e,size);}
    //重设Z轴旋转
    static method SetRotateZ(effect e,real z){EXEffectMatReset(e);EXEffectMatRotateZ(e,z);}
    //获取X
    static method GetX(effect e)->real{return EXGetEffectX(e);}
    //获取Y
    static method GetY(effect e)->real{return EXGetEffectY(e);}
    //获取Z
    static method GetZ(effect e)->real{return EXGetEffectZ(e);}
    //设置XY
    static method SetXY(effect e,real x,real y){EXSetEffectXY(e,x,y);}
    //设置Z
    static method SetZ(effect e, real z){EXSetEffectZ(e,z);}
    //设置播放速度
    static method SetSpeed(effect e,real s){EXSetEffectSpeed(e,s);}
}
}
//! endzinc
//List�?
//在自定义代码区顶部输入 #include "Star\\StarList.j" 来引用List
//new List 例如 integer list = SCreateList(location)
//List.Count 例如 integer count = SGetCount(location,1) 读取ID为1的List<location>
//List.Remove 例如 SRemoveAny(location,l,1) 把点 l 从 ID为1 的 List<location> 中移除
//List.Add  例如 SAddAny(location,l,1) 把点 l 从 添加至 ID为1 的 List<location> 中
//List.Destroy 例如 SRemoveList(location,1) 摧毁 ID为1 的List<location>
//List.Clear 例如 SClearList(location,1) 清空 ID为1 的List<location>
//List.First 例如 location p = SFirstOfList(location,1) 获取 ID为1 的List<location>中第一个location
//forlist t = Trigger  
//forlist t = function name
//在ForList中用于获取选取的成员
//! zinc
//! textmacro Star_List takes libname,Type,type
library $libname$$Type$
{
    private{
        hashtable HT = InitHashtable();
        integer $Type$Lists = 0;
        integer K_Count = StringHash("Count");
    }
    public{
        $type$ $libname$$Type$_Callback$Type$ = null;
    }
    //list.get
    public function $libname$$Type$_GetEnum$Type$()->$type$
    {
        return $libname$$Type$_Callback$Type$;
    }
    public function SGetEnum$Type$()->$type$
    {
        return $libname$$Type$_GetEnum$Type$();
    }
    //init list
    private function $libname$$Type$_InitList(integer id)
    {
        SaveInteger(HT,id,K_Count,0);
    }
    //new list
    public function $libname$$Type$_Create$Type$List()->integer
    {
        integer id ;
        $Type$Lists += 1;
        id = $Type$Lists - 1;
        $libname$$Type$_InitList(id);
        return id;
    }
    public function SCreateList$Type$()->integer
    {
        return $libname$$Type$_Create$Type$List();
    }
    //List.Destroy
    public function $libname$$Type$_RemoveList(integer id)
    {
        FlushChildHashtable(HT,id);
    }
    public function SRemoveList$Type$(integer id)
    {
        $libname$$Type$_RemoveList(id);
    }
    //List.Clear
    public function $libname$$Type$_ClearList(integer id)
    {
        SaveInteger(HT,id,K_Count,0);
        Save$Type$Handle(HT,id,0,null);
    }
    public function SClearList$Type$(integer id)
    {
        $libname$$Type$_ClearList(id);
    }
    //ForeachList
    public function $libname$$Type$_ForList(integer id , trigger t)
    {
        integer i,max;
        max = LoadInteger(HT,id,K_Count);
        i = 0;
        while(i<max)
        {
            $libname$$Type$_Callback$Type$ = Load$Type$Handle(HT,id,i);
            if(TriggerEvaluate(t)){
                TriggerExecute(t);
            }
            i+=1;
        }
        $libname$$Type$_Callback$Type$ = null;
    }
    public function SForListByCode$Type$(integer id,string c)
    {
        integer i,max;
        max = LoadInteger(HT,id,K_Count);
        i = 0;
        while(i<max)
        {
            $libname$$Type$_Callback$Type$ = Load$Type$Handle(HT,id,i);
            ExecuteFunc(c);
            i+=1;
        }
        $libname$$Type$_Callback$Type$ = null;
    }
    public function SForList$Type$(integer id ,trigger t)
    {
        $libname$$Type$_ForList(id,t);
    }
    //List.GetIndex
    public function $libname$$Type$_GetFirstOfList(integer id)->$type$
    {
        return Load$Type$Handle(HT,id,0);
    }
    public function SFirstOfList$Type$(integer id)->$type$
    {
        return $libname$$Type$_GetFirstOfList(id);
    }
    //List.XXXIsHave
    public function $libname$$Type$_Is$Type$OnList($type$ e,integer id)->integer
    {
        integer i,max;
        max = LoadInteger(HT,id,K_Count);
        i= 0;
        while(i<max) 
        {
            if(e == Load$Type$Handle(HT,id,i) )
            {
                return i;
            }
            i = i + 1;
        }
        return -1;
    }
    //List.IsHave
    public function $libname$$Type$_IsListHave$Type$($type$ e,integer id)->boolean
    {
        return $libname$$Type$_Is$Type$OnList(e,id) != -1 ;
    }
    //List.Remove
    public function $libname$$Type$_Remove$Type$OfList($type$ e,integer id)->boolean
    {
        integer i,max;
        //有效顶计数
        max = LoadInteger(HT,id,K_Count) -1;
        if(max<0)
        {
            return false;
        }
        i = $libname$$Type$_Is$Type$OnList(e,id);
        if(i != -1)
        {
            if(i!=max)
            {
                Save$Type$Handle(HT,id,i,Load$Type$Handle(HT,id,max) );
            }
            else
            {
                Save$Type$Handle(HT,id,i,null);
            }
            max -=1;
            SaveInteger(HT,id,K_Count,max+1);
            return true;
        }
        return false;
    }
    public function SRemove$Type$($type$ e,integer id)->boolean
    {
        return $libname$$Type$_Remove$Type$OfList(e,id);
    }
    //List.Add
    public function $libname$$Type$_ListAdd$Type$($type$ e,integer id)->boolean
    {
        integer i,max;
        max = LoadInteger(HT,id,K_Count);
        i = $libname$$Type$_Is$Type$OnList(e,id);
        if(i == -1)
        {
            Save$Type$Handle(HT,id,max,e);
            max +=1;
            SaveInteger(HT,id,K_Count,max);
            return true;
        }
        return false;
    }
    public function SAdd$Type$($type$ e,integer id)->boolean
    {
        return $libname$$Type$_ListAdd$Type$(e,id);
    }
    //List.IsEmpty
    public function $libname$$Type$_IsListEmpty(integer id)->boolean
    {
        if(LoadInteger(HT,id,K_Count)!=0)
        {
            return false;
        }
        return true;
    }
    //List.getCount
    public function $libname$$Type$_GetCount(integer id)->integer
    { 
        return LoadInteger(HT,id,K_Count);
    }
    public function SGetCount$Type$(integer id)->integer
    {
        return $libname$$Type$_GetCount(id);
    }
    //整数转List
    public function I2$libname$$Type$(integer id)->integer
    {
        return id;
    }
    //List转整数
    public function $libname$$Type$2I(integer $libname$$Type$)->integer
    {
        return $libname$$Type$;
    }
    //获取成员组的总表
    public function $libname$$Type$_GetTable()->hashtable
    {
        return HT;
    }
    private function onInit()
    {
    }
}
//! endtextmacro
