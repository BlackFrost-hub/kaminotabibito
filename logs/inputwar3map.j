    return (((IsUnitAlly(GetFilterUnit(), GetOwningPlayer(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB6A6EBAA))) != true) and ((IsUnitAliveBJ(GetFilterUnit()) == true) and ((IsUnitType(GetFilterUnit(), UNIT_TYPE_ANCIENT) != true) and ((IsUnitType(GetFilterUnit(), UNIT_TYPE_STRUCTURE) != true) and (IsUnitInGroup(GetFilterUnit(), LoadGroupHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xE00135BF)) == false))))))
endfunction
