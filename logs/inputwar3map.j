    local timer ydl_timer
    if ((LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xCEA5D211) >= 10.00)) then
        call EC_CreateEffect( "war3mapImported\\blackblink.mdx", GetUnitX(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9)), GetUnitY(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9)), 0.0, 270.0, 1.20, 1.0, 1.00 )
        call EXSetUnitMoveType( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9), 0x02 )
        set ydl_timer = CreateTimer()
        call SaveUnitHandle(YDLOC, GetHandleId(ydl_timer), 0x458B7DE9, LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9))
        call TimerStart(ydl_timer, 0.25, false, function Trig_zzm_QFunc002Func030Func001Func003T)
        call FlushChildHashtable(YDLOC, GetHandleId(GetExpiredTimer()))
        call DestroyTimer(GetExpiredTimer())
    else
        call SaveReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xCEA5D211, ((LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xCEA5D211))+( 1.00)))
        call SaveLocationHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB0FD2C34, PolarProjectionBJ(LoadLocationHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x9CD60476), ((42.50)*( LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xCEA5D211))), LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xB9A583B8)))
        if ((IsTerrainPathableBJ(LoadLocationHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB0FD2C34), PATHING_TYPE_WALKABILITY) == true)) then
            call SaveReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xCEA5D211, 10.00)
        else
            call SetUnitX( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9), GetLocationX(LoadLocationHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB0FD2C34)) )
            call SetUnitY( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9), GetLocationY(LoadLocationHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB0FD2C34)) )
        endif
        call RemoveLocation( LoadLocationHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB0FD2C34) )
    endif
    set ydl_timer = null
