            set ydl_timer = CreateTimer()
            call TimerStart(ydl_timer, 4.00, false, function Trig____________________002Func001Func001Func013T)
        else
            call QuestMessageBJ( GetPlayersAll(), bj_QUESTMESSAGE_FAILED, "TRIGSTR_812" )
            call RemoveItemFromStockBJ( 'I0CT', GetSellingUnit() )
            call AddItemToStockBJ( 'I0CT', GetSellingUnit(), 1, 1 )
