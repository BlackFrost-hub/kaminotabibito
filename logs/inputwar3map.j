//===========================================================================
// Trigger: 地图制作过程中发现的小知识XZS
//
// 1.获取自定义值单位类型创建单位可能会使有些动作触发一些问题，如：命令单位施放技能，或者说是这个动作有问题
// 2.自定义值获取实数也要提前设置=0
// 3.设置单位面向角度JAPI需要提前配合一个设置单位角度动作使用（应该是这个动作和单位最大转向角度有关）
// 4.JAPI设置技能冷却设置的冷却时间不能＞施放技能的面板基础CD
// 5.技能过于卡顿可以使用提高逆天计时器的周期时间来降低卡顿
// 6.调整逆天自定义值太过频繁会导致卡顿
// 7.为单位添加眩晕和移除眩晕会使得单位无法被暂停，有玄学bug，以后判断时停的方法就用魔法效果来检测
// 8.单位组移动弹幕太卡可以用马甲移动（移速来移动，虽然每秒最多移动522距离）
// 9.关于生命药剂的回血判定：
// 选项完整时可用”要设为“从不”
// “总是”状态下，能不被打断的只有回血
// 10.法球类效果的物品技能要放在第一个
// 11.一个单位通过科技获得生命值超过他原本的生命上限时，有可能会直接死亡
// 11.物理伤害≠物理伤害，只算普攻，普通伤害才是物理
// 12.触发单位触发事件不要用触发玩家，否则捕捉不到
// 光环检测Buff周期最低0.3秒
//===========================================================================
function Trig________________________________________XZSFunc002Func004Func004Func009T takes nothing returns nothing
    call YDWETimerDestroyEffect( 0.00, LoadEffectHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xC8FBC455) )
    call EXSetEffectSize( LoadEffectHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xC8FBC455), 0.00 )
    call FlushChildHashtable(YDLOC, GetHandleId(GetExpiredTimer()))
    call DestroyTimer(GetExpiredTimer())
endfunction
function Trig________________________________________XZSFunc002Func004Func004Func014T takes nothing returns nothing
    if ((LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xCEA5D211) >= 10)) then
        call EXSetUnitCollisionType( true, GetEnumUnit(), 1 )
        call ResetUnitAnimation( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15) )
        call SetUnitTimeScale( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15), 1.00 )
        call FlushChildHashtable(YDLOC, GetHandleId(GetExpiredTimer()))
        call DestroyTimer(GetExpiredTimer())
    else
        call SaveReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xCEA5D211, ((LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xCEA5D211))+( 1.00)))
        call SaveUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x883E8A15, LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15))
        call SaveLocationHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x30520E37, GetUnitLoc(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15)))
        call SaveLocationHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x389B6519, PolarProjectionBJ(LoadLocationHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x30520E37), 10.00, LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xB9A583B8)))
        call SetUnitPositionLoc( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15), LoadLocationHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x389B6519) )
        call RemoveLocation( LoadLocationHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x30520E37) )
        call RemoveLocation( LoadLocationHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x389B6519) )
    endif
endfunction
function Trig________________________________________XZSFunc002Func004A takes nothing returns nothing
