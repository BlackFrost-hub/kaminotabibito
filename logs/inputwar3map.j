function Trig_ALLT__________________uFunc001Func005Func002Func029T takes nothing returns nothing
    if (((UnitHasBuffBJ(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9), 'B017') == false) or (LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xCEA5D211) >= 20.00))) then
        call UnitRemoveAbility( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9), 'S008' )
        call UnitRemoveBuffBJ( 'B017', LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9) )
        call YDWEGeneralBounsSystemUnitSetBonus( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9), 3, 1, R2I(LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0x79A7DFD7)) )
        call FlushChildHashtable(YDLOC, GetHandleId(GetExpiredTimer()))
        call DestroyTimer(GetExpiredTimer())
    else
        call SaveReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xCEA5D211, ((LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xCEA5D211))+( 1.00)))
    endif
endfunction
