function InitGlobals takes nothing returns nothing
    local integer i = 0
    set i = 0
    loop
        exitwhen (i > 20)
        set udg_JSQ[i] = CreateTimer()
        set i = i + 1
    endloop
    set i = 0
    loop
        exitwhen (i > 10)
        set udg_WYDW/*避免Boss重复刷新*/[i] = 0
        set i = i + 1
    endloop
    set i = 0
    loop
        exitwhen (i > 20)
        set udg_CSZZ/*避免Boss重复刷新*/[i] = false
        set i = i + 1
    endloop
    set udg_T = 0
    set udg_N = 0
    set udg_R/*弱点数量*/= 0
    set i = 0
    loop
        exitwhen (i > 3)
        set udg_Time/*游戏时间*/[i] = 0
        set i = i + 1
    endloop
    set udg_Boss = null
    set i = 0
    loop
        exitwhen (i > 333)
        set udg_String/*常量字符串*/[i] = ""
        set i = i + 1
    endloop
    set xgdg_AA = 0
    set xgdg_zA = 0
    set i = 0
    loop
        exitwhen (i > 10)
        set xgdg_BA[i] = 0
        set i = i + 1
    endloop
    set i = 0
    loop
        exitwhen (i > 60)
        set xgdg_yA[i] = ""
        set i = i + 1
    endloop
    set i = 0
    loop
        exitwhen (i > 10)
        set xgdg_CA[i] = ""
        set i = i + 1
    endloop
    set xgdg_xA = 0
    set xgdg_DA = 0
    set udg_Itmeboolean/*装备限制开关*/= false
endfunction
//***************************************************************************
//*
//*  Destructible Item Tables
//*
//***************************************************************************
function Doodad001049_DropItems takes nothing returns nothing
    local widget trigWidget = null
    local unit trigUnit = null
    local integer itemID = 0
    local boolean canDrop = true
    set trigWidget = bj_lastDyingWidget
    if (trigWidget == null) then
        set trigUnit = GetTriggerUnit()
    endif
    if (trigUnit != null) then
        set canDrop = not IsUnitHidden(trigUnit)
        if (canDrop and GetChangingUnit() != null) then
            set canDrop = (GetChangingUnitPrevOwner() == Player(PLAYER_NEUTRAL_AGGRESSIVE))
        endif
    endif
    if (canDrop) then
        // Item set 0
        call RandomDistReset( )
        call RandomDistAddItem( 'tkno', 10 )
        call RandomDistAddItem( -1, 90 )
        set itemID = RandomDistChoose( )
        if (trigUnit != null) then
            call UnitDropItem( trigUnit, itemID )
        else
            call WidgetDropItem( trigWidget, itemID )
        endif
    endif
    set bj_lastDyingWidget = null
    call DestroyTrigger(GetTriggeringTrigger())
endfunction
function Doodad001050_DropItems takes nothing returns nothing
    local widget trigWidget = null
    local unit trigUnit = null
    local integer itemID = 0
    local boolean canDrop = true
    set trigWidget = bj_lastDyingWidget
    if (trigWidget == null) then
        set trigUnit = GetTriggerUnit()
    endif
    if (trigUnit != null) then
        set canDrop = not IsUnitHidden(trigUnit)
        if (canDrop and GetChangingUnit() != null) then
            set canDrop = (GetChangingUnitPrevOwner() == Player(PLAYER_NEUTRAL_AGGRESSIVE))
        endif
    endif
    if (canDrop) then
        // Item set 0
        call RandomDistReset( )
        call RandomDistAddItem( 'I00P', 30 )
        call RandomDistAddItem( -1, 70 )
        set itemID = RandomDistChoose( )
        if (trigUnit != null) then
            call UnitDropItem( trigUnit, itemID )
        else
            call WidgetDropItem( trigWidget, itemID )
        endif
    endif
    set bj_lastDyingWidget = null
    call DestroyTrigger(GetTriggeringTrigger())
endfunction
