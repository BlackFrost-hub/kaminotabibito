function Trig_worldmapActions takes nothing returns nothing
    local integer ydul_A
    local integer ydul_B
    local integer ydl_localvar_step = LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xCFDE6C76) 
 set ydl_localvar_step = ydl_localvar_step + 3 
 call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xCFDE6C76, ydl_localvar_step) 
 call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7, ydl_localvar_step)
    call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x11BC4B1C, DzCreateFrameByTagName("BACKDROP", "name", DzGetGameUI(), "template", 0))
    call DzFrameSetTexture( LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x11BC4B1C), "war3mapImported\\worldmap.tga", 0 )
    call DzFrameSetAbsolutePoint( LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x11BC4B1C), 4, 0.562708, 0.1552308 )
    call DzFrameSetSize( LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x11BC4B1C), 0.04, 0.025 )
    call DzFrameShow( LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x11BC4B1C), true )
    call DzFrameSetPriority( LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x11BC4B1C), 999999 )
    call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x3C127BBF, DzCreateFrameByTagName("TEXT", "主线任务提示文本", LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x11BC4B1C), "template", 0))
    call DzFrameSetAbsolutePoint( LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x3C127BBF), 4, 0.5463336, 0.1555134 )
    call DzFrameSetText( LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x3C127BBF), "M" )
    call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xDC9B2E73, DzCreateFrameByTagName("BACKDROP", "name", DzGetGameUI(), "template", 0))
    call DzFrameSetTexture( LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xDC9B2E73), "war3mapImported\\worldmap.tga", 0 )
    call DzFrameSetAbsolutePoint( LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xDC9B2E73), 4, 0.562708, 0.1552308 )
    call DzFrameSetSize( LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xDC9B2E73), 0.05, 0.03125 )
    call DzFrameShow( LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xDC9B2E73), false )
    call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x675B6145, DzCreateFrameByTagName("BACKDROP", "name", DzGetGameUI(), "template", 0))
    call SaveInteger(YDHT, StringHash( "worldmap"), 0x7D515EF5, LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x675B6145))
    call SaveInteger(YDHT, StringHash( "worldmap"), 0x2186940F, LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xDC9B2E73))
    call DzFrameShow( LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x675B6145), true )
    call DzFrameShow( LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x675B6145), false )
    call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x674B6ED7, DzCreateFrameByTagName("TEXT", "文本A", LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x675B6145), "template", 0))
    call DzFrameSetAbsolutePoint( LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x674B6ED7), 4, 0.4, 0.5 )
    call DzFrameSetText( LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x674B6ED7), "|cffff0000地图提示|r|cff000000：脱战状态下，『双击已激活的城镇』可以快速传送！|r" )
    call DzFrameSetPriority( LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x674B6ED7), 1 )
    call DzFrameSetFont( LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x674B6ED7), "war3mapImported\\uizt.ttf", 20.00, 0 )
    set ydul_A = 1
    loop
        exitwhen ydul_A > 8
        call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x71359523, DzCreateFrameByTagName("BACKDROP", "name", LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x675B6145), "template", 0))
        if ((ydul_A >= 1) and (ydul_A <= 4)) then
            call DzFrameSetTexture( LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x71359523), (("war3mapImported\\map0")+( I2S(ydul_A))+( ".blp")), 0 )
            call DzFrameSetAbsolutePoint( LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x71359523), 4, ((-0.10)+( ((0.20)*( I2R(ydul_A))))), 0.4249764 )
        else
            if ((ydul_A >= 5) and (ydul_A <= 8)) then
                call DzFrameSetTexture( LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x71359523), (("war3mapImported\\map0")+( I2S(ydul_A))+( ".blp")), 0 )
                call DzFrameSetAbsolutePoint( LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x71359523), 4, ((-0.90)+( ((0.20)*( I2R(ydul_A))))), 0.1422246 )
            else
            endif
        endif
        call DzFrameSetSize( LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x71359523), 0.20, 0.2844486 )
        set ydul_A = ydul_A + 1
    endloop
    if ((0 == 0)) then
        set ydul_B = 1
        loop
            exitwhen ydul_B > 27
            call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x52177E20, DzCreateFrameByTagName("GLUETEXTBUTTON", "主线按钮", LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x675B6145), "template", 0))
            call DzFrameSetSize( LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x52177E20), 0.03, 0.03 )
            call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xBCF0F53A, DzCreateFrameByTagName("BACKDROP", "主线任务文本框", LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x52177E20), "template", 0))
            call DzFrameSetTexture( LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xBCF0F53A), "war3mapImported\\wenbenkuang2.blp", 0 )
            call DzFrameSetSize( LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xBCF0F53A), 0.12, 0.20 )
            call DzFrameSetPoint( LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xBCF0F53A), 4, LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x52177E20), 4, 0.05, 0.05 )
            call DzFrameShow( LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xBCF0F53A), false )
            call DzFrameSetPriority( LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xBCF0F53A), 1 )
            call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x3C127BBF, DzCreateFrameByTagName("TEXT", "主线任务提示文本", LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xBCF0F53A), "template", 0))
            call DzFrameSetPoint( LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x3C127BBF), 4, LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xBCF0F53A), 4, 0.00, 0.02 )
            call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x71359523, DzCreateFrameByTagName("BACKDROP", "name", LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xBCF0F53A), "template", 0))
            call DzFrameSetTexture( LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x71359523), "war3mapImported\\Bosswenhao.blp", 0 )
            call DzFrameSetPoint( LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x71359523), 4, LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x52177E20), 4, 0.015, 0.12 )
