function Trig_zzm_QFunc003Func002Func005Func001Func011T takes nothing returns nothing
    if ((LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xCEA5D211) >= 3.00)) then
        call RemoveLocation( LoadLocationHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xF111A1E2) )
        call RemoveLocation( LoadLocationHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xC8A0E463) )
        call RemoveLocation( LoadLocationHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x141DCAD0) )
        call ResetUnitAnimation( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9) )
        call SetUnitTimeScale( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9), 1.00 )
        call SetUnitInvulnerable( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9), false )
        call YDWEUnitRemoveStun( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9) )
        call FlushChildHashtable(YDLOC, GetHandleId(GetExpiredTimer()))
        call DestroyTimer(GetExpiredTimer())
    else
        // 设置剑气飞行速度
        call SaveReal(YDLOC, GetHandleId(GetExpiredTimer()), 0x717DEF80, 35.00)
        call SaveReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xCEA5D211, ((LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xCEA5D211))+( 1.00)))
        if ((LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xCEA5D211) < 3.00)) then
            call Sound3DII_CooPlay( "YX\\DK6.mp3", GetUnitX(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xBEBE298D)), GetUnitY(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xBEBE298D)), 0.0, 4000.0 )
        else
            call Sound3DII_CooPlay( "YX\\DK52.mp3", GetUnitX(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xBEBE298D)), GetUnitY(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xBEBE298D)), 0.0, 4000.0 )
