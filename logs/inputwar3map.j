    public function SGSS_SetUnitHPPercentum(unit u,real r){
        integer hd = GetHandleId(u);
        //��ȡ�ٷֱȼӳ�ֵ
        real pv = LoadReal(StarBaseHT,hd,StringHash("����ֵ�ٷֱȼӳ�")); //0    0.15
//��ȡ�ٷֱ�������
real av = LoadReal(StarBaseHT,hd,StringHash("����ֵ�ٷֱȼӳ���ֵ"));//0   108.75
        //��������ֵ�仯 
        real v = GetUnitState(u, UNIT_STATE_MAX_LIFE)-av;//�õ�ԭʼֵ  //725  833.750 - 108.75 = 725
        
        real npv = pv+r;//�µİٷֱ�   //0+0.15=0.15  0.15+0 = 0.15
        real nav = v*npv;//�µļӳ�ֵ  //725*0.15 = 108.75 725*0.15 = 108.75
        // Print(R2S(pv)+","+R2S(npv));
        // Print("�ٷֱ�:"+","+R2S(av));
        // Print(R2S(v)+","+R2S(nav));
        if(av==nav){return;}//ͬ�����򲻱�
        SGSS_SetUnitHP(u,-av);//������ֵ
        SaveReal(StarBaseHT,hd,StringHash("����ֵ�ٷֱȼӳ�"),npv); //0.15 0.15 
SaveReal(StarBaseHT,hd,StringHash("����ֵ�ٷֱȼӳ���ֵ"),nav); // 108.75 108.75
SGSS_SetUnitHP(u,nav);//������ֵ
    }
