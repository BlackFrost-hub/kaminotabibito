        call SaveUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x3F7C6DD0, GetTriggerUnit())
        // 自己
        if ((LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x3F7C6DD0) == LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xD84480C3))) then
            call UnitAddAbility( LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xD84480C3), 'S00C' )
            call SaveReal(YDHT, GetHandleId( LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xD84480C3)), 0x1F1488CA, ((LoadReal(YDHT, GetHandleId( LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xD84480C3)), 0x1F1488CA))+( 0.50)))
            call PlaySoundOnUnitBJ( gg_snd_OEBK_D2, 100, GetTriggerUnit() )
            call SaveReal(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xCEA5D211, 0.00)
            set ydl_timer = CreateTimer()
            call SaveReal(YDLOC, GetHandleId(ydl_timer), 0xCEA5D211, LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xCEA5D211))
            call SaveUnitHandle(YDLOC, GetHandleId(ydl_timer), 0xD84480C3, LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xD84480C3))
            call TimerStart(ydl_timer, 0.10, true, function Trig_OEBRFunc001Func005Func006T)
        else
            if ((IsUnitAlly(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xD84480C3), GetOwningPlayer(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xE88322CC))) == true)) then
                call PlaySoundOnUnitBJ( gg_snd_OEBK_D2, 100, GetTriggerUnit() )
                call SaveBoolean(YDHT, GetHandleId( LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xD84480C3)), 0x3A78E0E5, true)
                call SaveUnitHandle(YDHT, GetHandleId( LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xD84480C3)), 0xE88322CC, LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xE88322CC))
                set ydl_timer = CreateTimer()
