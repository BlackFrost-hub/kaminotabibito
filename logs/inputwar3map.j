//其他
library StarOther requires StarBase{
    //获取光效模型路径
    public function SO_GetLightModelPath(integer i)->string
    {
        if(i==1)
        {
            return "Environment\\DNC\\DNCAshenvale\\DNCAshenValeTerrain\\DNCAshenValeTerrain.mdx";
        }
        if(i==2)
        {
            return "Environment\\DNC\\DNCAshenvale\\DNCAshenValeUnit\\DNCAshenValeUnit.mdx";
        }
        if(i==3)
        {
            return "Environment\\DNC\\DNCDalaran\\DNCDalaranTerrain\\DNCDalaranTerrain.mdx";
        }
        if(i==4)
        {
            return "Environment\\DNC\\DNCDalaran\\DNCDalaranUnit\\DNCDalaranUnit.mdx";
        }
        if(i==5)
        {
            return "Environment\\DNC\\DNCDungeon\\DNCDungeonTerrain\\DNCDungeonTerrain.mdx";
        }
        if(i==6)
        {
            return "Environment\\DNC\\DNCDungeon\\DNCDungeonUnit\\DNCDungeonUnit.mdx";
        }
        if(i==7)
        {
            return "Environment\\DNC\\DNCFelwood\\DNCFelWoodTerrain\\DNCFelWoodTerrain.mdx";
        }
        if(i==8)
        {
            return "Environment\\DNC\\DNCFelwood\\DNCFelWoodUnit\\DNCFelWoodUnit.mdx";
        }
        if(i==9)
        {
            return "Environment\\DNC\\DNCLordaeron\\DNCLordaeronTarget\\DNCLordaeronTarget.mdx";
        }
        if(i==10)
        {
            return "Environment\\DNC\\DNCLordaeron\\DNCLordaeronTerrain\\DNCLordaeronTerrain.mdx";
        }
        if(i==11)
        {
            return "Environment\\DNC\\DNCLordaeron\\DNCLordaeronUnit\\DNCLordaeronUnit.mdx";
        }
        if(i==12)
        {
            return "Environment\\DNC\\DNCUnderground\\DNCUndergroundTerrain\\DNCUndergroundTerrain.mdx";
        }
        if(i==13)
        {
            return "Environment\\DNC\\DNCUnderground\\DNCUndergroundUnit\\DNCUndergroundUnit.mdx";
        }
        return "";
    }
    //设置光照模型
    public function SO_SetSetDayNightModels(string a, string b)
    {
        SetDayNightModels(a,b);
    }
    //移动单位u到X,Y 并移动镜头 持续d秒
    public function StarOther_MoveUnitAndCamera(unit whichunit, real x, real y, real duration)
    {
        SetUnitX(whichunit,x);
        SetUnitY(whichunit,y);
        if (GetLocalPlayer() == GetOwningPlayer(whichunit))
        {
            PanCameraToTimed(x,y, duration);
        }
    }
    //平移玩家镜头到坐标
    public function StarOther_PanCameraToTimedForPlayer(player whichPlayer, real x, real y, real duration)
    {
        if (GetLocalPlayer() == whichPlayer)
        {
            PanCameraToTimed(x,y, duration);
        }
    }
    //平移玩家镜头到单位
    public function StarOther_PanCameraToTimedUnitForPlayer(player whichPlayer, unit u, real duration)
    {
        if (GetLocalPlayer() == whichPlayer)
        {
            PanCameraToTimed(GetUnitX(u),GetUnitY(u), duration);
        }
    }
    //移动X坐标 方向 距离
    public function MoveX(real x ,real d,real dis)->real
    {
        return x+CosBJ(d) * dis;
    }
    //移动Y坐标 方向 距离
    public function MoveY(real y ,real d,real dis)->real
    {
        return y+SinBJ(d) * dis;
    }
    public{
        timer CFG_timers[12];
        function SO_CinematicFilterGenerictakes(player p,real duration, blendmode bmode, string tex, real red0, real green0, real blue0, real trans0, real red1, real green1, real blue1, real trans1)
        {
            integer pid = GetPlayerId(p);
            SaveInteger(StarBaseHT,GetHandleId(CFG_timers[pid]),0xA707D18B,pid);
            TimerStart(CFG_timers[pid],duration,false,function(){
                integer i = LoadInteger(StarBaseHT,GetHandleId(GetExpiredTimer()),0xA707D18B);
                player p=Player(i);
                PauseTimer(CFG_timers[i]);
                if(GetLocalPlayer() == p)
                {
                    DisplayCineFilter(false);
                }
                p = null;
            });
            if(GetLocalPlayer() == p)
            {
                SetCineFilterTexture(tex);
                SetCineFilterBlendMode(bmode);
                SetCineFilterTexMapFlags(TEXMAP_FLAG_NONE);
                SetCineFilterStartUV(0, 0, 1, 1);
                SetCineFilterEndUV(0, 0, 1, 1);
                SetCineFilterStartColor(PercentTo255(red0), PercentTo255(green0), PercentTo255(blue0), PercentTo255(100-trans0));
                SetCineFilterEndColor(PercentTo255(red1), PercentTo255(green1), PercentTo255(blue1), PercentTo255(100-trans1));
                SetCineFilterDuration(duration);
                DisplayCineFilter(true);
            }
        }
        //封装用
        function SO_CinematicFilterGenerictakes2(player p,real duration, blendmode bmode, string tex, real red0, real green0, real blue0, real trans0, real red1, real green1, real blue1, real trans1)
        {
            integer pid = GetPlayerId(p);
            SaveInteger(StarBaseHT,GetHandleId(CFG_timers[pid]),0xA707D18B,pid);
            TimerStart(CFG_timers[pid],duration,false,function(){
                integer i = LoadInteger(StarBaseHT,GetHandleId(GetExpiredTimer()),0xA707D18B);
                player p=Player(i);
                PauseTimer(CFG_timers[i]);
                if(GetLocalPlayer() == p)
                {
                    DisplayCineFilter(false);
                }
                p = null;
            });
            if(GetLocalPlayer() == p)
            {
                SetCineFilterTexture(tex);
                SetCineFilterBlendMode(bmode);
                SetCineFilterTexMapFlags(TEXMAP_FLAG_NONE);
                SetCineFilterStartUV(0, 0, 1, 1);
                SetCineFilterEndUV(0, 0, 1, 1);
                SetCineFilterStartColor(PercentTo255(red0), PercentTo255(green0), PercentTo255(blue0), PercentTo255(100-trans0));
                SetCineFilterEndColor(PercentTo255(red1), PercentTo255(green1), PercentTo255(blue1), PercentTo255(100-trans1));
                SetCineFilterDuration(duration);
                DisplayCineFilter(true);
            }
        }
    }
    function onInit()
    {
        integer i = 0;
        while(i<12){
            CFG_timers[i] = CreateTimer();
            i+=1;
        }
    }
}
