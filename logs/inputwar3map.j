    call EXSetUnitCollisionType( false, GetEnumUnit(), 1 )
    call SetUnitTimeScale( GetEnumUnit(), 20.00 )
    call SetUnitAnimation( GetEnumUnit(), "Death" )
    call UnitDamageTarget( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x650A3A3A), GetEnumUnit(), ((GetUnitState(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x650A3A3A), ConvertUnitState(0x15)))*( 1.50)), false, false, ATTACK_TYPE_HERO, DAMAGE_TYPE_NORMAL, WEAPON_TYPE_METAL_HEAVY_SLICE )
    call GroupAddUnit( LoadGroupHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x28F9922D), GetEnumUnit() )
    call RemoveLocation( LoadLocationHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x30520E37) )
    call RemoveLocation( LoadLocationHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x389B6519) )
    // 斩断技能弹道
    if ((IsUnitType(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15), UNIT_TYPE_TAUREN) == false) and (IsUnitType(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15), UNIT_TYPE_MECHANICAL) == true)) then
        call KillUnit( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15) )
    else
    endif
