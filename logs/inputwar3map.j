function Trig_______initialFunc032Conditions takes nothing returns nothing
    local integer ydul_A
    call SaveUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0x3D91B70E, LoadUnitHandle(YDHT, GetHandleId( GetTriggerPlayer()), 0xB06AB615))
    call SaveUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0x4368DDEF, LoadUnitHandle(YDHT, GetHandleId( GetTriggerPlayer()), 0x4368DDEF))
    call SaveUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xD9FDA690, LoadUnitHandle(YDHT, GetHandleId( GetTriggerPlayer()), 0x3BD4963D))
    call SaveReal(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xA99320FA, GetUnitX(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0x3D91B70E)))
    call SaveReal(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xFDF65382, GetUnitY(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0x3D91B70E)))
    call StringBufferAdd( udg_String/*常量字符串*/[0] )
    call StringBufferAdd( udg_String/*常量字符串*/[GetConvertedPlayerId(GetTriggerPlayer())] )
    call StringBufferAdd( "离开了游戏，他的所有物品装备（包括宠物和副背包的）都会丢在该玩家脚下。游戏人数相关难度会自动降低调整。" )
    call QuestMessageBJ( GetPlayersAll(), bj_QUESTMESSAGE_HINT, StringBufferLoad() )
    set udg_T = ((udg_T)-( 1.00))
    call GroupRemoveUnit( LoadGroupHandle(YDHT, StringHash( "玩家英雄"), 0x0A4A1F64), LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0x3D91B70E) )
    set ydul_A = 1
    loop
        exitwhen ydul_A > 6
        call UnitRemoveItemSwapped( UnitItemInSlotBJ(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0x3D91B70E), ydul_A), LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0x3D91B70E) )
        set ydul_A = ydul_A + 1
    endloop
    set ydul_A = 1
    loop
        exitwhen ydul_A > 6
        call SaveItemHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xD14F34A9, UnitItemInSlotBJ(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xD9FDA690), ydul_A))
        call UnitRemoveItemSwapped( LoadItemHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xD14F34A9), LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xD9FDA690) )
        call SetItemPosition( LoadItemHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xD14F34A9), LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xA99320FA), LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xFDF65382) )
        set ydul_A = ydul_A + 1
    endloop
    set ydul_A = 1
    loop
        exitwhen ydul_A > 6
        call SaveItemHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xD14F34A9, UnitItemInSlotBJ(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0x4368DDEF), ydul_A))
        call UnitRemoveItemSwapped( LoadItemHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xD14F34A9), LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xD9FDA690) )
        call SetItemPosition( LoadItemHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xD14F34A9), LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xA99320FA), LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xFDF65382) )
        set ydul_A = ydul_A + 1
    endloop
endfunction
function Trig_______initialFunc033Conditions takes nothing returns nothing
    if (((GetUnitTypeId(GetTriggerUnit()) == 'h00L') or (GetUnitTypeId(GetTriggerUnit()) == 'h00K') or (GetUnitTypeId(GetTriggerUnit()) == 'h00Z'))) then
        call SetUnitX( GetTriggerUnit(), -8700.00 )
        call SetUnitY( GetTriggerUnit(), -8700.00 )
    else
    endif
endfunction
function Trig_______initialActions takes nothing returns nothing
    local integer ydul_A
    local timer ydl_timer
    local trigger ydl_trigger
    local integer ydl_localvar_step = LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xCFDE6C76) 
 set ydl_localvar_step = ydl_localvar_step + 3 
 call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xCFDE6C76, ydl_localvar_step) 
 call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7, ydl_localvar_step)
    call ExecuteFunc("InitTrig_YX________________________7_0_Orig")
    call ExecuteFunc("InitTrig______________1_8S_Orig")
    call ExecuteFunc("InitTrig__________ZSW2_5S_Orig")
    call ExecuteFunc("InitTrig_______NPC______6_0S_Orig")
    call StopMusic( false )
    call SetMusicVolume( 0 )
    set udg_FHD = Location(-25873.50, -11172.80)
    set udg_DXZSW/*剧情*/[21] = DzDoodadCreate('DOkb', 0, 28960.70, -28364.20, 0, 270.00, 1)
    call ShowUnit( gg_unit_n00G_0489, false )
    call ShowUnit( gg_unit_e03D_0491, false )
    call SetDestructableInvulnerable( gg_dest_ZTsg_5903, true )
    call SetDestructableInvulnerable( gg_dest_B00X_0013, true )
    call SetDestructableInvulnerable( gg_dest_B00M_13602, true )
    call SetDestructableInvulnerable( gg_dest_LTe3_0298, true )
    call CreateTextTagLocBJ( "TRIGSTR_036", GetRectCenter(gg_rct______________070), 15.00, 17.50, 100.00, 85.00, 0.00, 0 )
    call SetDoodadAnimationRect( gg_rct_____________u, 'D0AX', "Stand-35", false )
    call SaveGroupHandle(YDHT, StringHash( "弹幕系统"), 0x0A4A1F64, CreateGroup())
    call SetCreepCampFilterState( false )
    call CinematicModeBJ( true, GetPlayersAll() )
    call StopMusic( false )
    call TransmissionFromUnitWithNameBJ( GetPlayersAll(), null, "TRIGSTR_037", null, "TRIGSTR_038", bj_TIMETYPE_ADD, 10.00, true )
    call StopMusic( false )
    call CinematicModeBJ( false, GetPlayersAll() )
    call DisplayTimedTextToForce( GetPlayersAll(), 50.00, "TRIGSTR_039" )
    call StopMusic( false )
    call SaveUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x55253747, CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE), 'ncop', -2499.80, 29606.00, 0))
    // 剧情进度
    call SaveInteger(YDHT, StringHash( "剧情进度"), 0x87DDA352, 0)
    call SaveForceHandle(YDHT, StringHash( "玩家"), 0x7C23C9D2, CreateForce())
    call SaveInteger(YDHT, StringHash( "玩家数量"), 0x87DDA352, 0)
    set ydul_A = 1
    loop
        exitwhen ydul_A > 4
        if ((GetPlayerSlotState(ConvertedPlayer(ydul_A)) == PLAYER_SLOT_STATE_PLAYING)) then
            call ForceAddPlayer( LoadForceHandle(YDHT, StringHash( "玩家"), 0x7C23C9D2), ConvertedPlayer(ydul_A) )
            call SaveInteger(YDHT, StringHash( "玩家数量"), 0x87DDA352, ((LoadInteger(YDHT, StringHash( "玩家数量"), 0x87DDA352))+( 1)))
            call SaveUnitHandle(YDHT, GetHandleId( ConvertedPlayer(ydul_A)), 0x3BD4963D, CreateUnit(ConvertedPlayer(ydul_A), 'hrdh', 29124.40, 29575.10, 0))
            set udg_T = ((udg_T)+( 1.00))
        else
        endif
        set ydul_A = ydul_A + 1
    endloop
    // 玩家选择注册
    call ForForce( LoadForceHandle(YDHT, StringHash( "玩家"), 0x7C23C9D2), function Trig_______initialFunc023A )
    call QuestMessageBJ( GetPlayersAll(), bj_QUESTMESSAGE_UPDATED, ( "根据游戏人数,当前的经验倍率为：" + ( R2S(((((0.40)+( ((0.60)*( udg_T)))))*( 100.00))) + "%" ) ) )
    call CreateQuestBJ( bj_QUESTTYPE_REQ_DISCOVERED, "TRIGSTR_040", "TRIGSTR_041", "ReplaceableTextures\\CommandButtons\\BTNHeroTinker.blp" )
    call ForForce( LoadForceHandle(YDHT, StringHash( "玩家"), 0x7C23C9D2), function Trig_______initialFunc026A )
    // 英雄出生地创建特效
    set ydl_timer = CreateTimer()
    call TimerStart(ydl_timer, 1.50, false, function Trig_______initialFunc028T)
    set ydl_trigger = CreateTrigger()
    call YDWESyStemItemCombineRegistTrigger( ydl_trigger )
    call TriggerAddCondition(ydl_trigger, Condition(function Trig_______initialFunc029Conditions))
    set ydl_trigger = CreateTrigger()
    call TriggerRegisterPlayerEventEndCinematic( ydl_trigger, Player(0) )
    call TriggerRegisterPlayerEventEndCinematic( ydl_trigger, Player(1) )
    call TriggerRegisterPlayerEventEndCinematic( ydl_trigger, Player(2) )
    call TriggerRegisterPlayerEventEndCinematic( ydl_trigger, Player(3) )
    call TriggerAddCondition(ydl_trigger, Condition(function Trig_______initialFunc030Conditions))
    // 创建全部地图单位
    set ydl_trigger = CreateTrigger()
    call SaveUnitHandle(YDLOC, GetHandleId(ydl_trigger), 0x4368DDEF, LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x4368DDEF))
    call SaveUnitHandle(YDLOC, GetHandleId(ydl_trigger), 0x3D91B70E, LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x3D91B70E))
    call SaveItemHandle(YDLOC, GetHandleId(ydl_trigger), 0xD14F34A9, LoadItemHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xD14F34A9))
    call SaveReal(YDLOC, GetHandleId(ydl_trigger), 0xA99320FA, LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xA99320FA))
    call SaveReal(YDLOC, GetHandleId(ydl_trigger), 0xFDF65382, LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xFDF65382))
    call SaveUnitHandle(YDLOC, GetHandleId(ydl_trigger), 0x3D91B70E, LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x3D91B70E))
    call SaveUnitHandle(YDLOC, GetHandleId(ydl_trigger), 0xD9FDA690, LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xD9FDA690))
    call TriggerRegisterPlayerEventLeave( ydl_trigger, Player(0) )
    call TriggerRegisterPlayerEventLeave( ydl_trigger, Player(1) )
    call TriggerRegisterPlayerEventLeave( ydl_trigger, Player(2) )
    call TriggerRegisterPlayerEventLeave( ydl_trigger, Player(3) )
    call TriggerAddCondition(ydl_trigger, Condition(function Trig_______initialFunc032Conditions))
    set ydl_trigger = CreateTrigger()
    call RegistUnitLeaveCircle( ydl_trigger, CreateCircle(-8700.00, -8700.00, 3500.00) )
    call TriggerAddCondition(ydl_trigger, Condition(function Trig_______initialFunc033Conditions))
    call DestroyTrigger( GetTriggeringTrigger() )
    call FlushChildHashtable(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step)
    set ydl_timer = null
    set ydl_trigger = null
endfunction
