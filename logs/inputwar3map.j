function Trig_zzm_QFunc002Func026Conditions takes nothing returns nothing
    local group ydl_group
    local unit ydl_unit
    local timer ydl_timer
    if ((GetUnitTypeId(GetSummonedUnit()) == GetUnitTypeId(GetTriggerUnit()))) then
        call YDWEUnitAddStun( GetSummonedUnit() )
        call EXSetUnitCollisionType( false, GetSummonedUnit(), 1 )
        call SetUnitX( GetSummonedUnit(), GetLocationX(LoadLocationHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0x9CD60476)) )
        call SetUnitY( GetSummonedUnit(), GetLocationY(LoadLocationHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0x9CD60476)) )
        call SetUnitAnimationByIndex( GetSummonedUnit(), 9 )
        call SetUnitTimeScale( GetSummonedUnit(), 1.20 )
        call SaveReal(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xE98CDB04, GetUnitFacing(GetTriggerUnit()))
        call SaveReal(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xDB16DB7A, ((LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xE98CDB04))+( 135.00)))
        call SaveReal(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xF80A4248, ((LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xE98CDB04))+( -135.00)))
        set ydl_group = CreateGroup()
        call GroupEnumUnitsInRange(ydl_group, GetUnitX(GetSummonedUnit()), GetUnitY(GetSummoningUnit()), 425.00, null)
        loop
            set ydl_unit = FirstOfGroup(ydl_group)
            exitwhen ydl_unit == null
            call GroupRemoveUnit(ydl_group, ydl_unit)
            if ((IsUnitAliveBJ(ydl_unit) == true) and (IsUnitType(ydl_unit, UNIT_TYPE_ANCIENT) == false) and (IsUnitType(ydl_unit, UNIT_TYPE_MECHANICAL) == false) and (IsUnitType(ydl_unit, UNIT_TYPE_STRUCTURE) == false) and (IsUnitEnemy(ydl_unit, GetOwningPlayer(GetTriggerUnit())) == true)) then
                call SaveUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xB3542E15, ydl_unit)
                call SaveReal(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xC5A7DF74, YDWEAngleBetweenUnits(GetTriggerUnit(), LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xB3542E15)))
                if ((LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xC5A7DF74) < 0.00)) then
                    call SaveReal(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xC5A7DF74, ((LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xC5A7DF74))+( 360.00)))
                else
                endif
                if ((LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xC5A7DF74) > LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xF80A4248)) and (LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xC5A7DF74) <= LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xDB16DB7A))) then
                    call UnitDamageTarget( GetTriggerUnit(), LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xB3542E15), ((GetUnitState(GetTriggerUnit(), ConvertUnitState(0x15)))*( 1.70)), true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_NORMAL, WEAPON_TYPE_WHOKNOWS )
                    call EC_CreateEffect( "war3mapImported\\coarse slash blue.mdx", GetUnitX(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xB3542E15)), GetUnitY(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xB3542E15)), 0.00, 270.0, 0.80, 1.0, 1.00 )
                else
                endif
            else
            endif
        endloop
        call DestroyGroup(ydl_group)
        set ydl_timer = CreateTimer()
        call SaveUnitHandle(YDLOC, GetHandleId(ydl_timer), 0x072B6ED9, GetSummonedUnit())
        call TimerStart(ydl_timer, 1.00, false, function Trig_zzm_QFunc002Func026Func001Func011T)
        // 音效
        call Sound3DII_CooPlay( "YX\\DK6.mp3", GetUnitX(GetTriggerUnit()), GetUnitY(GetTriggerUnit()), 0.0, 4000.0 )
    else
    endif
    call FlushChildHashtable(YDLOC, GetHandleId(GetTriggeringTrigger()))
    call DestroyTrigger(GetTriggeringTrigger())
    set ydl_group = null
    set ydl_unit = null
    set ydl_timer = null
endfunction
