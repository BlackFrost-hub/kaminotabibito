function Trig_L______ResenFunc001Func012Func002Func002Func006T takes nothing returns nothing
    call SetUnitAnimationByIndex( GetEnumUnit(), 2 )
    call YDWEUnitRemoveStun( GetEnumUnit() )
    call FlushChildHashtable(YDLOC, GetHandleId(GetExpiredTimer()))
    call DestroyTimer(GetExpiredTimer())
endfunction
function Trig_L______ResenFunc001Func012Func002Func002Func013T takes nothing returns nothing
    call EXSetEffectSize( LoadEffectHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xFCACDC17), 0.00 )
    call FlushChildHashtable(YDLOC, GetHandleId(GetExpiredTimer()))
    call DestroyTimer(GetExpiredTimer())
endfunction
function Trig_L______ResenFunc001Func012Func002A takes nothing returns nothing
    local timer ydl_timer
    call SaveUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15, GetEnumUnit())
    if ((IsUnitAliveBJ(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15)) == true)) then
        call SetUnitTimeScale( GetEnumUnit(), 1.80 )
        call SetUnitFacing( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15), LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0x2D345649) )
        // 为分身添加施法硬直
        call YDWEUnitAddStun( GetEnumUnit() )
        set ydl_timer = CreateTimer()
        call TimerStart(ydl_timer, 0.35, false, function Trig_L______ResenFunc001Func012Func002Func002Func006T)
        call SaveEffectHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xFCACDC17, AddSpecialEffect("war3mapImported\\pinkredlaser.mdl", GetUnitX(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15)), GetUnitY(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15))))
        call EXSetEffectSize( LoadEffectHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xFCACDC17), 0.30 )
        call EXSetEffectZ( LoadEffectHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xFCACDC17), 175.00 )
        call YDWETimerDestroyEffect( 1.00, LoadEffectHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xFCACDC17) )
        call EXEffectMatRotateZ( LoadEffectHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xFCACDC17), LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0x2D345649) )
        call EXSetEffectSpeed( LoadEffectHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xFCACDC17), 3.00 )
        set ydl_timer = CreateTimer()
        call SaveEffectHandle(YDLOC, GetHandleId(ydl_timer), 0xFCACDC17, LoadEffectHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xFCACDC17))
        call TimerStart(ydl_timer, 1.00, false, function Trig_L______ResenFunc001Func012Func002Func002Func013T)
        call SetUnitTimeScale( GetEnumUnit(), 1.00 )
    else
        call GroupRemoveUnit( LoadGroupHandle(YDHT, GetHandleId( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB6A6EBAA)), 0xBF671381), LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15) )
    endif
    set ydl_timer = null
endfunction
