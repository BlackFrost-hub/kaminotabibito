function Trig_YX________________________7_0Func025Func001003002 takes nothing returns boolean
    return ((IsUnitType(GetFilterUnit(), UNIT_TYPE_HERO) == true))
endfunction
function Trig_YX________________________7_0Func025Func002Func005Conditions takes nothing returns nothing
    if ((GetOwningPlayer(GetTriggerUnit()) == Player(PLAYER_NEUTRAL_PASSIVE)) and (RectContainsUnit(gg_rct___________________YXXZ, GetTriggerUnit()) == true)) then
        call IssueImmediateOrder( GetTriggerUnit(), "stop" )
        call SelectUnitRemoveForPlayer( GetTriggerUnit(), GetTriggerPlayer() )
    else
    endif
    if (((EVENT_GAME_TIMER_EXPIRED == GetTriggerEventId()) == true)) then
        call FlushChildHashtable(YDLOC, GetHandleId(GetTriggeringTrigger()))
        call DestroyTrigger(GetTriggeringTrigger())
    else
    endif
endfunction
function Trig_YX________________________7_0Func025Func002A takes nothing returns nothing
    local trigger ydl_trigger
    call SaveUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15, GetEnumUnit())
    call SaveStr(YDHT, GetHandleId( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15)), 0x7AB70EC9, (EXExecuteScript("(require'jass.slk').unit[" + I2S( GetUnitTypeId(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15))) + "]." + "file")))
    call UnitAddAbility( GetEnumUnit(), 'Ane2' )
    call ModifyHeroSkillPoints( GetEnumUnit(), bj_MODIFYMETHOD_SUB, 1 )
    set ydl_trigger = LoadTriggerHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xA10A3DDC)
    call TriggerRegisterTimerEventSingle( ydl_trigger, 300.00 )
    call TriggerRegisterUnitEvent( ydl_trigger, LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15), EVENT_UNIT_SPELL_CHANNEL )
    call TriggerAddCondition(ydl_trigger, Condition(function Trig_YX________________________7_0Func025Func002Func005Conditions))
    set ydl_trigger = null
endfunction
function Trig_YX________________________7_0Func025T takes nothing returns nothing
    local group ydl_group
    local unit ydl_unit
    local trigger ydl_trigger
    call SaveGroupHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x437E2A40, YDWEGetUnitsInRectMatchingNull(gg_rct___________________YXXZ, Condition(function Trig_YX________________________7_0Func025Func001003002)))
    call ForGroupBJ( LoadGroupHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x437E2A40), function Trig_YX________________________7_0Func025Func002A )
    call DestroyGroup( LoadGroupHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x437E2A40) )
    call FlushChildHashtable(YDLOC, GetHandleId(GetExpiredTimer()))
    call DestroyTimer(GetExpiredTimer())
    set ydl_group = null
    set ydl_unit = null
