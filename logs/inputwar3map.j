function Trig_____________DMXTActions takes nothing returns nothing
    local group ydl_group
    local unit ydl_unit
    local integer ydl_localvar_step = LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xCFDE6C76) 
 set ydl_localvar_step = ydl_localvar_step + 3 
 call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xCFDE6C76, ydl_localvar_step) 
 call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7, ydl_localvar_step)
    if ((IsUnitGroupEmptyBJ(LoadGroupHandle(YDHT, StringHash( "弹幕系统"), 0x0A4A1F64)) == true)) then
        call DisableTrigger( GetTriggeringTrigger() )
    else
        call ForGroupBJ( LoadGroupHandle(YDHT, StringHash( "弹幕系统"), 0x0A4A1F64), function Trig_____________DMXTFunc001Func002A )
    endif
    call FlushChildHashtable(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step)
    set ydl_group = null
    set ydl_unit = null
endfunction
//===========================================================================
function InitTrig_____________DMXT takes nothing returns nothing
    set gg_trg_____________DMXT = CreateTrigger()
    call TriggerRegisterTimerEventPeriodic( gg_trg_____________DMXT, 0.04 )
    call TriggerAddAction(gg_trg_____________DMXT, function Trig_____________DMXTActions)
endfunction
//===========================================================================
// Trigger: 弹幕+马甲/单位排泄DMPS
//===========================================================================
function Trig___________________________DMPSFunc012Func001T takes nothing returns nothing
    call FlushChildHashtable(YDHT, GetHandleId( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x911D5DC2)))
    call RemoveUnit( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x911D5DC2) )
    call FlushChildHashtable(YDLOC, GetHandleId(GetExpiredTimer()))
    call DestroyTimer(GetExpiredTimer())
endfunction
function Trig___________________________DMPSFunc013Func001Func002T takes nothing returns nothing
    call FlushChildHashtable(YDHT, GetHandleId( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x911D5DC2)))
    call RemoveUnit( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x911D5DC2) )
    call FlushChildHashtable(YDLOC, GetHandleId(GetExpiredTimer()))
    call DestroyTimer(GetExpiredTimer())
endfunction
function Trig___________________________DMPSActions takes nothing returns nothing
    local timer ydl_timer
    local integer ydl_localvar_step = LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xCFDE6C76) 
 set ydl_localvar_step = ydl_localvar_step + 3 
 call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xCFDE6C76, ydl_localvar_step) 
 call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7, ydl_localvar_step)
    if ((IsUnitType(GetTriggerUnit(), UNIT_TYPE_MECHANICAL) == true)) then
        call DestroyGroup( LoadGroupHandle(YDHT, GetHandleId( GetDyingUnit()), 0x56E86570) )
        call SaveUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x68B72DFF, GetTriggerUnit())
        call SaveLocationHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x8F3CED6B, GetUnitLoc(GetDyingUnit()))
        call SaveReal(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xB5BFC652, LoadReal(YDHT, GetHandleId( LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x68B72DFF)), 0xB5BFC652))
        call SaveUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x2289B0A7, LoadUnitHandle(YDHT, GetHandleId( LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x68B72DFF)), 0x50654F3C))
        // 下面这个if动作是Debug预防
        if ((IsUnitInGroup(GetTriggerUnit(), LoadGroupHandle(YDHT, StringHash( "弹幕系统"), 0x0A4A1F64)) == true)) then
            call GroupRemoveUnit( LoadGroupHandle(YDHT, StringHash( "弹幕系统"), 0x0A4A1F64), LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x68B72DFF) )
        else
        endif
        call RemoveLocation( LoadLocationHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x8F3CED6B) )
    else
    endif
    // 马甲/单位残留清除
    call SaveUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x911D5DC2, GetDyingUnit())
