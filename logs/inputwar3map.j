        call TransmissionFromUnitWithNameBJ( GetPlayersAll(), null, GetUnitName(GetBuyingUnit()), null, "TRIGSTR_819", bj_TIMETYPE_SET, 3.00, true )
        call TransmissionFromUnitWithNameBJ( GetPlayersAll(), null, GetUnitName(GetSellingUnit()), null, "TRIGSTR_820", bj_TIMETYPE_SET, 3.00, true )
        call TransmissionFromUnitWithNameBJ( GetPlayersAll(), null, GetUnitName(GetSellingUnit()), null, "TRIGSTR_821", bj_TIMETYPE_SET, 3.00, true )
        call TransmissionFromUnitWithNameBJ( GetPlayersAll(), null, GetUnitName(GetBuyingUnit()), null, "TRIGSTR_822", bj_TIMETYPE_SET, 3.00, true )
        call TransmissionFromUnitWithNameBJ( GetPlayersAll(), null, GetUnitName(GetSellingUnit()), null, "TRIGSTR_823", bj_TIMETYPE_SET, 3.00, true )
        call TransmissionFromUnitWithNameBJ( GetPlayersAll(), null, GetUnitName(GetSellingUnit()), null, "TRIGSTR_824", bj_TIMETYPE_SET, 3.00, true )
        call TransmissionFromUnitWithNameBJ( GetPlayersAll(), null, GetUnitName(GetBuyingUnit()), null, "TRIGSTR_825", bj_TIMETYPE_SET, 3.00, true )
