    else
        call SaveReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xCEA5D211, ((LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xCEA5D211))+( 1.00)))
        call SaveLocationHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x2A829619, GetUnitLoc(LoadUnitHandle(YDHT, StringHash( "克劳德"), 0x8A89ED65)))
        call SaveLocationHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x8FA91502, PolarProjectionBJ(LoadLocationHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x2A829619), 15.00, LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0x8EF2E8DF)))
