    public function SGSS_SetUnitAttackPercentum(unit u,real r){
        integer hd = GetHandleId(u);
        //��ȡ�ٷֱȼӳ�ֵ
        real pv = LoadReal(StarBaseHT,hd,StringHash("�������ٷֱȼӳ�"));
        //��ȡ�ٷֱ�������
        real av = LoadReal(StarBaseHT,hd,StringHash("�������ٷֱȼӳ���ֵ"));
        //��������ֵ�仯
        //��ȡ��λ������
        real v = GetUnitState(u, ConvertUnitState(0x12))
                + (GetUnitState(u, ConvertUnitState(0x10))* (GetUnitState(u, ConvertUnitState(0x11))+1) /2);
        real npv = pv+r;//�µİٷֱ�
        real nav = v*npv;//�µļӳ�ֵ
        if(av==nav){return;}//ͬ�����򲻱�
        SGSS_SetUnitAttack(u,-av);
        SaveReal(StarBaseHT,hd,StringHash("�������ٷֱȼӳ�"),npv);
        SaveReal(StarBaseHT,hd,StringHash("�������ٷֱȼӳ���ֵ"),nav);
        SGSS_SetUnitAttack(u,nav);//������ֵ
    }
