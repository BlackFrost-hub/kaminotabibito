    else
    endif
    if ((GetUnitTypeId(GetSummonedUnit()) == 'E07R')) then
        call SaveUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xDB988C32, GetSummonedUnit())
        call GroupAddUnit( LoadGroupHandle(YDHT, GetHandleId( LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xE97D6160)), 0xBF671381), LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xDB988C32) )
