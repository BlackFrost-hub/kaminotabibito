                call GroupAddUnit( LoadGroupHandle(YDHT, StringHash( "弹幕系统"), 0x0A4A1F64), LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x5B7DF14B) )
