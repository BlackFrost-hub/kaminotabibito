function Trig______________________01Conditions takes nothing returns boolean
    return (((IsUnitType(GetTriggerUnit(), UNIT_TYPE_HERO) == true) or (IsUnitRace(GetTriggerUnit(), RACE_DEMON) == true)) and (IsUnitInGroup(GetTriggerUnit(), LoadGroupHandle(YDHT, StringHash( "玩家英雄"), 0x0A4A1F64)) == false))
endfunction
function Trig______________________01Func007Func008T takes nothing returns nothing
    if (((IsUnitDeadBJ(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9)) == true) or (IsUnitSpelling(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9)) == false))) then
        call RemoveUnit( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x248ED1E3) )
        call FlushChildHashtable(YDLOC, GetHandleId(GetExpiredTimer()))
        call DestroyTimer(GetExpiredTimer())
    else
        call SetUnitX( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x248ED1E3), GetUnitX(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9)) )
        call SetUnitY( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x248ED1E3), GetUnitY(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9)) )
    endif
endfunction
function Trig______________________01Actions takes nothing returns nothing
    local timer ydl_timer
    local integer ydl_localvar_step = LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xCFDE6C76) 
 set ydl_localvar_step = ydl_localvar_step + 3 
 call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xCFDE6C76, ydl_localvar_step) 
 call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7, ydl_localvar_step)
    call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x2AAC512D, GetSpellAbilityId())
    call SaveUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xD84480C3, GetSpellTargetUnit())
    if (((YDWEGetUnitAbilityDataString(GetTriggerUnit(), GetSpellAbilityId(), 1, 216) == "1") or (YDWEGetUnitAbilityDataString(GetTriggerUnit(), GetSpellAbilityId(), 1, 216) == "2") or (YDWEGetUnitAbilityDataString(GetTriggerUnit(), GetSpellAbilityId(), 1, 216) == "3") or (YDWEGetUnitAbilityDataString(GetTriggerUnit(), GetSpellAbilityId(), 1, 216) == "4") or (YDWEGetUnitAbilityDataString(GetTriggerUnit(), GetSpellAbilityId(), 1, 216) == "5"))) then
        if ((GetTriggerUnit() == LoadUnitHandle(YDHT, StringHash( "Boss战"), 0x62274AD0)) and ((S2I(EXExecuteScript("(require'jass.slk').ability[" + I2S( LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x2AAC512D)) + "]." + "DataB1")) == 3) or (S2I(EXExecuteScript("(require'jass.slk').ability[" + I2S( LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x2AAC512D)) + "]." + "DataB1")) == 1))) then
            call SaveUnitHandle(YDHT, GetHandleId( GetTriggerUnit()), 0x9BF1033F, GetSpellTargetUnit())
        else
        endif
        call SaveReal(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x9EF7B67E, S2R(EXExecuteScript("(require'jass.slk').ability[" + I2S( LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x2AAC512D)) + "]." + "DataA1")))
    else
        call SaveReal(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x9EF7B67E, S2R(EXExecuteScript("(require'jass.slk').ability[" + I2S( LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x2AAC512D)) + "]." + "Cast1")))
    endif
    // Debug，除0会崩溃
    if ((LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x9EF7B67E) < 0.03)) then
    else
        call SaveReal(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x5D04C6C8, ((1.00)/( LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x9EF7B67E))))
        call SaveUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x248ED1E3, CreateUnit(Player(4), 'e01O', GetUnitX(GetTriggerUnit()), GetUnitY(GetTriggerUnit()), 0))
        call SetUnitTimeScale( LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x248ED1E3), LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x5D04C6C8) )
        call SetUnitOwner( LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x248ED1E3), Player(4), true )
        call SetUnitFlyHeight( LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x248ED1E3), ((GetUnitFlyHeight(GetTriggerUnit()))+( 350.00)), 0.00 )
        call YDWETimerRemoveUnit( LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x9EF7B67E), LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x248ED1E3) )
        call SetUnitScale( LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x248ED1E3), 2.00, 2.00, 2.00 )
        set ydl_timer = CreateTimer()
        call SaveUnitHandle(YDLOC, GetHandleId(ydl_timer), 0x458B7DE9, GetTriggerUnit())
        call SaveUnitHandle(YDLOC, GetHandleId(ydl_timer), 0x248ED1E3, LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x248ED1E3))
        call TimerStart(ydl_timer, 0.05, true, function Trig______________________01Func007Func008T)
    endif
    // 单纯的技能台词
    if ((GetUnitTypeId(GetTriggerUnit()) == 'N05M') and (YDWEGetUnitAbilityDataString(GetTriggerUnit(), LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x2AAC512D), 1, 216) == "1")) then
        call TransmissionFromUnitWithNameBJ( GetPlayersAll(), null, "TRIGSTR_1731", null, (("可不敢逃跑啊？|cffff0000(")+( GetUnitName(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xD84480C3)))+( ")|r")), bj_TIMETYPE_SET, 2.00, false )
    else
