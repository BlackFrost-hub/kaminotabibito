        call GroupAddUnit( LoadGroupHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xCD2F02AD), LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15) )
        call GroupRemoveUnit( LoadGroupHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x56E86570), LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15) )
    else
        call SetUnitPositionLocFacingBJ( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15), LoadLocationHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xAF487022), LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xB9A583B8) )
