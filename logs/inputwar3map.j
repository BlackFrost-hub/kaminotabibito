function Trig___________________ZLActions takes nothing returns nothing
    local group ydl_group
    local unit ydl_unit
    local integer ydl_localvar_step = LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xCFDE6C76) 
 set ydl_localvar_step = ydl_localvar_step + 3 
 call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xCFDE6C76, ydl_localvar_step) 
 call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7, ydl_localvar_step)
    if ((GetEventPlayerChatString() == "使者精神魔杖")) then
        call ForGroupBJ( LoadGroupHandle(YDHT, StringHash( "玩家英雄"), 0x0A4A1F64), function Trig___________________ZLFunc001Func001A )
    else
    endif
    if ((GetEventPlayerChatString() == "+")) then
        call SetCameraFieldForPlayer( GetTriggerPlayer(), CAMERA_FIELD_ZOFFSET, ((GetCameraField(CAMERA_FIELD_ZOFFSET))+( 200.00)), 0 )
    else
    endif
    if ((GetEventPlayerChatString() == "-")) then
        call SetCameraFieldForPlayer( GetTriggerPlayer(), CAMERA_FIELD_TARGET_DISTANCE, ((GetCameraField(CAMERA_FIELD_ZOFFSET))+( 200.00)), 0 )
    else
    endif
    if ((GetEventPlayerChatString() == "-1")) then
        call SaveInteger(YDHT, GetHandleId( GetTriggerPlayer()), 0x0B8B3F52, 'A0IM')
    else
        if ((GetEventPlayerChatString() == "-2")) then
            call SaveInteger(YDHT, GetHandleId( GetTriggerPlayer()), 0x0B8B3F52, 'A0IN')
        else
            if ((GetEventPlayerChatString() == "-3")) then
                call SaveInteger(YDHT, GetHandleId( GetTriggerPlayer()), 0x0B8B3F52, 'A0IP')
            else
                if ((GetEventPlayerChatString() == "-4")) then
                    call SaveInteger(YDHT, GetHandleId( GetTriggerPlayer()), 0x0B8B3F52, 'A0IR')
                else
                endif
            endif
        endif
    endif
    if ((GetEventPlayerChatString() == "-6")) then
        call QuestMessageBJ( GetPlayersAll(), bj_QUESTMESSAGE_UPDATED, GetUnitName(LoadUnitHandle(YDHT, StringHash( "Boss战"), 0x62274AD0)) )
    else
    endif
    if ((GetEventPlayerChatString() == "-7")) then
        call QuestMessageBJ( GetPlayersAll(), bj_QUESTMESSAGE_UPDATED, R2S(LoadReal(YDHT, GetHandleId( GetTriggerPlayer()), 0x70F59D3B)) )
    else
    endif
    if ((GetEventPlayerChatString() == "-坐标")) then
        call ForGroupBJ( LoadGroupHandle(YDHT, StringHash( "玩家英雄"), 0x0A4A1F64), function Trig___________________ZLFunc008Func001A )
    else
    endif
    if ((GetEventPlayerChatString() == "boss")) then
        call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x6C2DED4E, CountUnitsInGroup(LoadGroupHandle(YDHT, StringHash( "血条Boss"), 0x0A4A1F64)))
        call QuestMessageBJ( GetPlayersAll(), bj_QUESTMESSAGE_UPDATED, I2S(LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x6C2DED4E)) )
    else
    endif
    if ((GetEventPlayerChatString() == "ycb")) then
        call StarExecuteEvent( "注册吟唱条", false )
    else
    endif
    if ((GetEventPlayerChatString() == "-zs")) then
        call ForGroupBJ( LoadGroupHandle(YDHT, StringHash( "玩家英雄"), 0x0A4A1F64), function Trig___________________ZLFunc011Func001A )
    else
    endif
    call FlushChildHashtable(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step)
    set ydl_group = null
    set ydl_unit = null
endfunction
