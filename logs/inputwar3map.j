function Trig_xuetiaoFunc002Func041T takes nothing returns nothing
    call SaveReal(YDLOC, GetHandleId(GetExpiredTimer()), 0x253C8FB9, I2R(LoadInteger(YDHT, GetHandleId( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x944CCEB0)), 0x5F3881C7)))
    call SaveReal(YDLOC, GetHandleId(GetExpiredTimer()), 0x97C68798, I2R(LoadInteger(YDHT, GetHandleId( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x944CCEB0)), 0x3D06152D)))
    if ((LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0x253C8FB9) <= 0.00)) then
        call DzFrameShow( udg_UI[56], false )
    else
        call DzFrameSetSize( udg_UI[56], ( 0.273 * ( ( LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0x253C8FB9) / LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0x97C68798) ) * 1.00 ) ), 0.00115 )
        call DzFrameSetAbsolutePoint( udg_UI[56], 4, ((0.401) -( 0.1375) *( ( 1.00 - ( LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0x253C8FB9) / LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0x97C68798) ) ))), 0.52846 )
        call DzFrameShow( udg_UI[56], true )
    endif
    call DzFrameSetText( udg_UI[54], (("")+( "")+( ((" [HP] ：")+( I2S(R2I(GetUnitLifePercent(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x944CCEB0)))))+( "%")))) )
    if ((GetUnitLifePercent(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x944CCEB0)) == 100.00)) then
        call DzFrameSetAnimateOffset( udg_UI[52], 0.9999 )
    else
        call DzFrameSetAnimateOffset( udg_UI[52], ( GetUnitLifePercent(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x944CCEB0)) / 100.00 ) )
        if (((IsUnitAliveBJ(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x944CCEB0)) == false) or (IsUnitDeadBJ(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x944CCEB0)) == true))) then
            call DzFrameShow( udg_UI[51], false )
            call DzFrameShow( udg_UI[54], false )
            call FlushChildHashtable(YDLOC, GetHandleId(GetExpiredTimer()))
            call DestroyTimer(GetExpiredTimer())
        else
        endif
    endif
endfunction
function Trig_xuetiaoActions takes nothing returns nothing
    local timer ydl_timer
    local integer ydl_localvar_step = LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xCFDE6C76) 
 set ydl_localvar_step = ydl_localvar_step + 3 
 call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xCFDE6C76, ydl_localvar_step) 
 call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7, ydl_localvar_step)
    call SaveUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x944CCEB0, LoadUnitHandle(YDHT, StringHash( "Boss战"), 0x4F42CF89))
    // 血条
    set udg_UI[51] = DzCreateFrameByTagName("SPRITE", "51", DzGetGameUI(), "template", 0)
    call DzFrameSetModel( udg_UI[51], "war3mapImported\\Bar_Red.mdx", 0, 0 )
    call DzFrameSetAnimate( udg_UI[51], 0, true )
    call DzFrameSetPoint( udg_UI[51], 4, DzGetGameUI(), 4, 0.117, 0.26 )
    // 血条已损失贴图
    set udg_UI[52] = DzCreateFrameByTagName("SPRITE", "52", udg_UI[51], "template", 0)
    call DzFrameSetModel( udg_UI[52], "war3mapImported\\Bar_Unit_Black.mdx", 0, 0 )
    call DzFrameSetAnimate( udg_UI[52], 0, false )
    call DzFrameSetPoint( udg_UI[52], 4, DzGetGameUI(), 4, 0.117, 0.26 )
    call DzFrameSetPriority( udg_UI[52], 2 )
    // 头像
    set udg_UI[53] = DzCreateFrameByTagName("BACKDROP", "Q53", udg_UI[51], "UI_BACKDROP_5", 0)
    call DzFrameSetTexture( udg_UI[53], (EXExecuteScript("(require'jass.slk').unit[" + I2S( GetUnitTypeId(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x944CCEB0))) + "]." + "Art")), 0 )
    call DzFrameSetPoint( udg_UI[53], 8, udg_UI[51], 6, 0.00, -0.023 )
    call DzFrameSetSize( udg_UI[53], 0.043, 0.043 )
    // 具体血量文字
    set udg_UI[54] = DzCreateFrameByTagName("TEXT", "T54", DzGetGameUI(), "UI_TEXT_10", 0)
    call DzFrameSetAbsolutePoint( udg_UI[54], 4, 0.305, 0.5423 )
    // 护盾血条框
    set udg_UI[55] = DzCreateFrameByTagName("BACKDROP", "10", udg_UI[51], "template", 0)
    call DzFrameSetAlpha( udg_UI[55], 155 )
    call DzFrameSetTexture( udg_UI[55], "war3mapImported\\UIY.tga", 0 )
    call DzFrameSetAbsolutePoint( udg_UI[55], 4, 0.4028, 0.5394 )
    call DzFrameSetSize( udg_UI[55], 0.2842, 0.0293 )
    // 护盾血条
    set udg_UI[56] = DzCreateFrameByTagName("BACKDROP", "10", udg_UI[55], "template", 0)
    call DzFrameSetTexture( udg_UI[56], "war3mapImported\\UI3.tga", 0 )
    call DzFrameSetAbsolutePoint( udg_UI[56], 4, 0.401, 0.52846 )
    call DzFrameSetSize( udg_UI[56], 0.275, 0.00115 )
    // ------------
    call DzFrameShow( udg_UI[51], true )
    call DzFrameShow( udg_UI[52], true )
    call DzFrameShow( udg_UI[53], true )
    call DzFrameShow( udg_UI[54], true )
    call DzFrameShow( udg_UI[55], true )
    call DzFrameShow( udg_UI[56], true )
    call TriggerExecute( gg_trg_Bossruodian1 )
    call SaveTimerHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xB0F1A4E5, CreateTimer())
    set ydl_timer = LoadTimerHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xB0F1A4E5)
    call SaveUnitHandle(YDLOC, GetHandleId(ydl_timer), 0x944CCEB0, LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x944CCEB0))
    call SaveReal(YDLOC, GetHandleId(ydl_timer), 0x253C8FB9, LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x253C8FB9))
    call SaveReal(YDLOC, GetHandleId(ydl_timer), 0x97C68798, LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x97C68798))
    call TimerStart(ydl_timer, 0.05, true, function Trig_xuetiaoFunc002Func041T)
    call FlushChildHashtable(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step)
    set ydl_timer = null
endfunction
