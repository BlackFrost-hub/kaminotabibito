        endif
        call UnitAddItemByIdSwapped( 'I0CN', GetBuyingUnit() )
        call SetUnitOwner( GetSellingUnit(), Player(6), true )
        call TransmissionFromUnitWithNameBJ( GetPlayersAll(), null, GetUnitName(GetSellingUnit()), null, "TRIGSTR_816", bj_TIMETYPE_ADD, 0, true )
        call QuestMessageBJ( GetPlayersAll(), bj_QUESTMESSAGE_DISCOVERED, "TRIGSTR_817" )
    else
    endif
    if ((GetItemTypeId(GetSoldItem()) == 'I0CJ')) then
        call SaveBoolean(YDHT, StringHash( "失踪的精灵村民"), 0xEF4D214E, true)
