    else
        if ((GetOwningPlayer(GetTriggerUnit()) == GetTriggerPlayer()) and (LoadBoolean(YDHT, GetHandleId( LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xE97D6160)), 0x68984D67) == false) and (GetUnitTypeId(GetTriggerUnit()) == 'E07R') and (GetTriggerUnit() != LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xE97D6160))) then
            call SaveBoolean(YDHT, GetHandleId( LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xE97D6160)), 0x68984D67, true)
            // 添加点迷惑特效
            call ForGroupBJ( LoadGroupHandle(YDHT, GetHandleId( LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xE97D6160)), 0xBF671381), function Trig_L______ResenFunc002Func008Func009Func002Func001Func003A )
            call SaveLocationHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0x2A829619, Location(GetUnitX(GetTriggerUnit()), GetUnitY(GetTriggerUnit())))
