    call SaveUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15, GetEnumUnit())
    call GroupAddUnit( LoadGroupHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xE00135BF), LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15) )
    // 造成减速
    call SaveUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x089E63E0, CreateUnit(GetOwningPlayer(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB6A6EBAA)), 'e00D', GetUnitX(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB6A6EBAA)), GetUnitY(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB6A6EBAA)), 0))
