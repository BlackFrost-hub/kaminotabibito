//===========================================================================
// Trigger: GameTimeEvent
//===========================================================================
function Trig_GameTimeEventFunc006A takes nothing returns nothing
    call SaveUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7), 0xB3542E15, GetEnumUnit())
    if ((UnitHasBuffBJ(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7), 0xB3542E15), 'B00M') == true)) then
        if ((YDWEUnitHasItemOfTypeBJNull(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7), 0xB3542E15), 'I03J') == true)) then
            call SetUnitState( LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7), 0xB3542E15), UNIT_STATE_MANA, ((GetUnitState(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7), 0xB3542E15), UNIT_STATE_MANA))-( 12.00)) )
        else
            call SetUnitState( LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7), 0xB3542E15), UNIT_STATE_MANA, ((GetUnitState(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7), 0xB3542E15), UNIT_STATE_MANA))-( 24.00)) )
        endif
    else
    endif
endfunction
function Trig_GameTimeEventActions takes nothing returns nothing
    local group ydl_group
    local unit ydl_unit
    local integer ydl_localvar_step = LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xCFDE6C76) 
 set ydl_localvar_step = ydl_localvar_step + 3 
 call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xCFDE6C76, ydl_localvar_step) 
 call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7, ydl_localvar_step)
    // 精灵湖
    if ((IsUnitAliveBJ(LoadUnitHandle(YDHT, StringHash( "植物"), 0xCB31EDE4)) == true)) then
        if ((GetTimeOfDay() >= 8.00) and (GetTimeOfDay() <= 15.00)) then
            call ShowUnit( LoadUnitHandle(YDHT, StringHash( "植物"), 0xCB31EDE4), true )
        else
            call ShowUnit( LoadUnitHandle(YDHT, StringHash( "植物"), 0xCB31EDE4), false )
        endif
    else
    endif
    // 沙漠
    if ((IsQuestCompleted(udg_RW[2]) == false) and (IsQuestDiscovered(udg_RW[2]) == true) and (IsUnitAliveBJ(LoadUnitHandle(YDHT, StringHash( "Boss"), 0x6BDDBD5B)) == true) and ((GetTimeOfDay() >= 19.00) or (GetTimeOfDay() <= 4.00))) then
        if ((LoadBoolean(YDHT, GetHandleId( LoadUnitHandle(YDHT, StringHash( "Boss"), 0x6BDDBD5B)), 0xFE68AB44) == false)) then
            call SaveBoolean(YDHT, GetHandleId( LoadUnitHandle(YDHT, StringHash( "Boss"), 0x6BDDBD5B)), 0xFE68AB44, true)
            call ShowUnitShow( LoadUnitHandle(YDHT, StringHash( "Boss"), 0x6BDDBD5B) )
            call SetUnitInvulnerable( LoadUnitHandle(YDHT, StringHash( "Boss"), 0x6BDDBD5B), false )
            call SaveLocationHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x5B0D7524, GetRandomLocInRect(gg_rct______________055))
            call SetUnitPositionLoc( LoadUnitHandle(YDHT, StringHash( "Boss"), 0x6BDDBD5B), LoadLocationHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x5B0D7524) )
            call RemoveLocation( LoadLocationHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x5B0D7524) )
        else
        endif
    else
        if ((LoadUnitHandle(YDHT, StringHash( "Boss战"), 0x62274AD0) == null)) then
            call SaveBoolean(YDHT, GetHandleId( LoadUnitHandle(YDHT, StringHash( "Boss"), 0x6BDDBD5B)), 0xFE68AB44, false)
            call ShowUnitHide( LoadUnitHandle(YDHT, StringHash( "Boss"), 0x6BDDBD5B) )
            call SetUnitInvulnerable( LoadUnitHandle(YDHT, StringHash( "Boss"), 0x6BDDBD5B), true )
        else
        endif
    endif
    call ForGroupBJ( LoadGroupHandle(YDHT, StringHash( "玩家英雄"), 0x0A4A1F64), function Trig_GameTimeEventFunc006A )
    call FlushChildHashtable(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step)
    set ydl_group = null
    set ydl_unit = null
endfunction
//===========================================================================
function InitTrig_GameTimeEvent takes nothing returns nothing
    set gg_trg_GameTimeEvent = CreateTrigger()
    call TriggerRegisterTimerEventPeriodic( gg_trg_GameTimeEvent, 10.00 )
    call TriggerAddAction(gg_trg_GameTimeEvent, function Trig_GameTimeEventActions)
endfunction
//===========================================================================
// Trigger: 111决斗技-剧情
//===========================================================================
function Trig_111________________uFunc001Func005Func018Func007Func008T takes nothing returns nothing
    if ((IsUnitDeadBJ(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x969219F1)) == true)) then
        call FlushChildHashtable(YDLOC, GetHandleId(GetExpiredTimer()))
        call DestroyTimer(GetExpiredTimer())
    else
        if ((IsUnitSpelling(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x969219F1)) == false) and (IsUnitPausedBJ(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x969219F1)) == false)) then
            call IssueTargetOrder( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x969219F1), "patrol", LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x310EFEF8) )
        else
        endif
    endif
endfunction
function Trig_111________________uFunc001Func005Func018T takes nothing returns nothing
    local timer ydl_timer
    call SaveReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xCEA5D211, ((LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xCEA5D211))+( 1.00)))
    call CreateTextTagUnitBJ( R2S(LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xCEA5D211)), LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x969219F1), 10.00, 30.00, 100, 10.00, 10.00, 0 )
    call YDWETimerDestroyTextTag( 0.98, GetLastCreatedTextTag() )
    call CreateTextTagUnitBJ( R2S(LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xCEA5D211)), LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x310EFEF8), 10.00, 30.00, 100, 10.00, 10.00, 0 )
    call YDWETimerDestroyTextTag( 0.98, GetLastCreatedTextTag() )
    if ((LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xCEA5D211) == 4.00)) then
        call PlaySoundBJ( gg_snd_DJS_4S )
    else
    endif
    if ((LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xCEA5D211) >= 5.00)) then
        // 创建Boss，移动Boss和玩家到决斗场景，设置BGM，删除BGM
        if (((GetUnitTypeId(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xD84480C3)) == 'n01D') or (GetUnitTypeId(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xD84480C3)) == 'hhes'))) then
            call SetStackedSoundBJ( false, gg_snd_battleBgm002, LoadRectHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x6CC68D63) )
            call SetStackedSoundBJ( false, gg_snd_battleBgm003, LoadRectHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x6CC68D63) )
            call SetStackedSoundBJ( false, gg_snd_shengliBgm2, LoadRectHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x6CC68D63) )
            call SetStackedSoundBJ( true, gg_snd_battleBgm002, LoadRectHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x6CC68D63) )
        else
        endif
        call PauseUnit( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x310EFEF8), false )
        call SetUnitInvulnerable( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x310EFEF8), false )
        call PauseUnit( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x969219F1), false )
        call SetUnitInvulnerable( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x969219F1), false )
        call IssueTargetOrder( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x969219F1), "patrol", LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x310EFEF8) )
        set ydl_timer = CreateTimer()
        call SaveUnitHandle(YDLOC, GetHandleId(ydl_timer), 0x969219F1, LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x969219F1))
        call SaveUnitHandle(YDLOC, GetHandleId(ydl_timer), 0x310EFEF8, LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x310EFEF8))
        call TimerStart(ydl_timer, 8.00, true, function Trig_111________________uFunc001Func005Func018Func007Func008T)
        call StopSoundBJ( gg_snd_DJS_4S, false )
        if ((GetUnitTypeId(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xD84480C3)) == 'hhes')) then
            call TransmissionFromUnitWithNameBJ( GetPlayersAll(), null, "TRIGSTR_086", null, "TRIGSTR_087", bj_TIMETYPE_SET, 5.00, false )
        else
        endif
        if ((GetUnitTypeId(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xD84480C3)) == 'n01D')) then
            call SaveUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xCBCCABD2, CreateUnit(Player(PLAYER_NEUTRAL_AGGRESSIVE), 'e02J', GetUnitX(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x969219F1)), GetUnitY(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x969219F1)), 0))
            call TransmissionFromUnitWithNameBJ( GetPlayersAll(), null, GetUnitName(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x969219F1)), null, "TRIGSTR_088", bj_TIMETYPE_SET, 5.00, false )
        else
        endif
        call FlushChildHashtable(YDLOC, GetHandleId(GetExpiredTimer()))
        call DestroyTimer(GetExpiredTimer())
    else
    endif
    set ydl_timer = null
endfunction
function Trig_111________________uFunc001Func005Func019Func010Func003T takes nothing returns nothing
    call SetStackedSoundBJ( false, gg_snd_shengliBgm2, LoadRectHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x6CC68D63) )
    call FlushChildHashtable(YDLOC, GetHandleId(GetExpiredTimer()))
    call DestroyTimer(GetExpiredTimer())
endfunction
function Trig_111________________uFunc001Func005Func019Func010Func010Func002Func004001001 takes nothing returns boolean
    return ((GetFilterPlayer() == GetOwningPlayer(GetKillingUnit())))
endfunction
function Trig_111________________uFunc001Func005Func019Func010Func011T takes nothing returns nothing
    call GS_SetUnitPositionLoc( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xE66F1A12), Location(LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xA99320FA), LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xFDF65382)) )
    call SetUnitFacing( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xE66F1A12), LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xB9A583B8) )
    call SetUnitOwner( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xE66F1A12), Player(6), true )
    call SaveInteger(YDHT, StringHash( "玩家"), 0x0E8974B8, ((LoadInteger(YDHT, StringHash( "玩家"), 0x0E8974B8))+( 3)))
    call QuestMessageBJ( GetPlayersAll(), bj_QUESTMESSAGE_SECRET, "TRIGSTR_095" )
    call FlushChildHashtable(YDLOC, GetHandleId(GetExpiredTimer()))
    call DestroyTimer(GetExpiredTimer())
endfunction
function Trig_111________________uFunc001Func005Func019Conditions takes nothing returns nothing
    local timer ydl_timer
    call SaveUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xE66F1A12, LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xD84480C3))
    call SaveUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xA2C24DE8, GetDyingUnit())
    call SetStackedSoundBJ( false, gg_snd_battleBgm002, LoadRectHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0x6CC68D63) )
    call SetStackedSoundBJ( false, gg_snd_battleBgm003, LoadRectHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0x6CC68D63) )
    call SetStackedSoundBJ( false, gg_snd_shengliBgm2, LoadRectHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0x6CC68D63) )
    call SaveBoolean(YDHT, StringHash( "决斗状态"), 0xEFAD0956, false)
    // 战斗胜利后的动作
    if ((IsUnitInGroup(GetKillingUnit(), LoadGroupHandle(YDHT, StringHash( "玩家英雄"), 0x0A4A1F64)) == true)) then
