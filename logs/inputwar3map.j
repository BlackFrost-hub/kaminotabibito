function Trig_____________ActionEActions takes nothing returns nothing
    local timer ydl_timer
    local integer ydl_localvar_step = LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xCFDE6C76) 
 set ydl_localvar_step = ydl_localvar_step + 3 
 call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xCFDE6C76, ydl_localvar_step) 
 call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7, ydl_localvar_step)
    set ydl_timer = CreateTimer()
    call SaveInteger(YDLOC, GetHandleId(ydl_timer), 0xF5EB0DAA, LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xF5EB0DAA))
    call SaveInteger(YDLOC, GetHandleId(ydl_timer), 0xCAB9D091, LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xCAB9D091))
    call SaveInteger(YDLOC, GetHandleId(ydl_timer), 0x94D2A226, LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x94D2A226))
    call SaveInteger(YDLOC, GetHandleId(ydl_timer), 0x7907AFE3, LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x7907AFE3))
    call SaveUnitHandle(YDLOC, GetHandleId(ydl_timer), 0x76ABBC1D, LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x76ABBC1D))
    call SaveInteger(YDLOC, GetHandleId(ydl_timer), 0x95E55524, LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x95E55524))
    call SaveReal(YDLOC, GetHandleId(ydl_timer), 0xC7EA1948, LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xC7EA1948))
    call SaveReal(YDLOC, GetHandleId(ydl_timer), 0xA99320FA, LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xA99320FA))
    call SaveReal(YDLOC, GetHandleId(ydl_timer), 0xFDF65382, LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xFDF65382))
    call SaveEffectHandle(YDLOC, GetHandleId(ydl_timer), 0x9FD926C2, LoadEffectHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x9FD926C2))
    call TimerStart(ydl_timer, LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x7D5CFDCE), false, function Trig_____________ActionEFunc002Func001T)
    call FlushChildHashtable(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step)
    set ydl_timer = null
endfunction
