library Sound3DII initializer LibInit
/********************************************************
*星星-2020年7月17日19:07:56
//Sound3DII_UnitPlay(string,unit,real)用于在单位位置播放音效
//Sound3DII_CooPlay(string,real,real,real,real)用于在坐标处播放音效//s:音效位置//xyz 为坐标//r:裁断距离
//Sound3DII_LocPlay(string,Location,real)用于在点播放音效
*已知问题：音效无法在视野外被听到
*已知问题：同一文件路径音效文件短时间内只能同时播放四次（该问题在War3重置版中已经修复）
//2021年10月8日20:26:58
改写了以上三个动作的实现,提高效率
使用bj_lastPlayedSound获取最后播放的音效
//Sound3DII_Mp3Play(string,player) 对玩家播放MP3
**********************************************************/
//声音衰减距离
struct SoundDistances
public real minDis
public real maxDis
    public method Set takes real mindis , real maxdis returns nothing
    set this.minDis = mindis
    set this.maxDis = maxdis
    endmethod
    public method GetMin takes nothing returns real
        return this.minDis
    endmethod
    public method GetMax takes nothing returns real
        return this.maxDis
    endmethod
endstruct
//声音投射角
struct SoundConeOrientation 
    public real x
    public real y
    public real z
    public method Set takes real x ,real y , real z returns nothing
        set this.x = x
        set this.y = y
        set this.z = z
    endmethod
    public method GetX takes nothing returns real
        return this.x
    endmethod
    public method GetY takes nothing returns real
        return this.y
    endmethod
    public method GetZ takes nothing returns real
        return this.z
    endmethod
endstruct
//声音速度
struct SoundVelocity
    public real x
    public real y
    public real z
    public method Set takes real x ,real y , real z returns nothing
        set this.x = x
        set this.y = y
        set this.z = z
    endmethod
    public method GetX takes nothing returns real
        return this.x
    endmethod
    public method GetY takes nothing returns real
        return this.y
    endmethod
    public method GetZ takes nothing returns real
        return this.z
    endmethod
endstruct
//
struct ConeAngles
    public real IN
    public real OUT
    public integer Volume
    public method Set takes real inside ,real outside , integer volume returns nothing
        set this.IN = inside
        set this.OUT = outside
        set this.Volume = volume
    endmethod
    public method GetInside takes nothing returns real
        return this.IN
    endmethod
    public method GetOutside takes nothing returns real
        return this.OUT
    endmethod
    public method GetVolume takes nothing returns integer
        return this.Volume
    endmethod
endstruct
//声音模型
struct SoundModel
//
public ConeAngles CA
//声音通道
public integer Channel
//声音播放速率
public real Pitch
//声音移动速度
public SoundVelocity SV
//声音投射角
public SoundConeOrientation SCO
//声音衰减
public SoundDistances SD
public integer Volume
public string SoundType
public integer fadeInRate
public integer fadeOutRate
static method create takes ConeAngles ca ,SoundVelocity sv,SoundConeOrientation sco,SoundDistances sd returns SoundModel
    local SoundModel s 
    set s = SoundModel.allocate()
    set s.CA = ca
    call s.CA.Set(0,0,127)
    set s.SV = sv
    call s.SV.Set(0,0,0)
    set s.SCO = sco
    call s.SCO.Set(0,0,0)
    set s.SD = sd
    call s.SD.Set(2500,2500)
    set s.Pitch = 1.00
    set s.Volume = 127
    set s.Channel = 0
    set s.SoundType = "DefaultEAXON"
    set s.fadeInRate = 10
    set s.fadeOutRate = 10
    return s
endmethod
endstruct
globals
private hashtable HT = InitHashtable()
public SoundModel soundModel
public sound lastCreateSound
private integer key_Count = 0xB7279243
private integer key_Index = 0xA707D18B
private integer Key_Index = 0xA707D18B
private integer Key_Count = 0xA707D18B
endglobals
private function TimeOut takes nothing returns nothing
local sound sou = LoadSoundHandle(HT,GetHandleId(GetExpiredTimer()),0x9B7EB41F)
local integer i = LoadInteger(HT,GetHandleId(sou),0xB7279243) 
call SaveBoolean(HT,StringHash(LoadStr(HT,GetHandleId(sou),0x2D297D87)),i,true)
set sou = null
endfunction
private function Create takes string s , real r , integer i ,real x , real y ,real z,boolean is3d returns sound
    local timer t = CreateTimer()
    
    set bj_lastPlayedSound =CreateSound( s, false, is3d, false, soundModel.fadeInRate, soundModel.fadeOutRate, soundModel.SoundType)
    call SetSoundDistances( bj_lastPlayedSound,soundModel.SD.minDis ,soundModel.SD.maxDis)
    call SetSoundDistanceCutoff( bj_lastPlayedSound, r)
    call SetSoundPosition(bj_lastPlayedSound, x, y, z)
    call SetSoundChannel(bj_lastPlayedSound,soundModel.Channel)
    call SetSoundVolume(bj_lastPlayedSound,soundModel.Volume)
    call SetSoundPitch(bj_lastPlayedSound,soundModel.Pitch)
    call SetSoundConeOrientation(bj_lastPlayedSound,soundModel.SCO.x,soundModel.SCO.y,soundModel.SCO.z)
    call SetSoundConeAngles(bj_lastPlayedSound,soundModel.CA.IN,soundModel.CA.OUT,soundModel.CA.Volume)
    call SetSoundVelocity(bj_lastPlayedSound,soundModel.SV.x,soundModel.SV.y,soundModel.SV.z)
    call SaveSoundHandle(HT,StringHash(s),i,bj_lastPlayedSound)
    call SaveTimerHandle(HT,GetHandleId(bj_lastPlayedSound),0x1CA61CEC,t)
    call SaveSoundHandle(HT,GetHandleId(t),0x9B7EB41F,bj_lastPlayedSound)
    call SaveBoolean(HT,StringHash(s),i,false)
    call SaveInteger(HT,GetHandleId(bj_lastPlayedSound),0xB7279243,i)
    call SaveStr(HT,GetHandleId(bj_lastPlayedSound),0x2D297D87,s)
    call TimerStart(t,GetSoundFileDuration(s)*0.001,false,function TimeOut)
    set t = null
    return bj_lastPlayedSound
endfunction
//获取音效
private function Get takes string s , real r , integer i ,real x , real y ,real z returns sound 
    local timer t = LoadTimerHandle(HT,GetHandleId(LoadSoundHandle(HT,StringHash(s),i)),0x1CA61CEC)
    set bj_lastPlayedSound = LoadSoundHandle(HT,StringHash(s),i)
    call SetSoundDistances( bj_lastPlayedSound,soundModel.SD.minDis ,soundModel.SD.maxDis)
    call SetSoundDistanceCutoff( bj_lastPlayedSound, r)
    call SetSoundPosition(bj_lastPlayedSound, x, y, z)
    call SetSoundChannel(bj_lastPlayedSound,soundModel.Channel)
    call SetSoundVolume(bj_lastPlayedSound,soundModel.Volume)
    call SetSoundPitch(bj_lastPlayedSound,soundModel.Pitch)
    call SetSoundConeOrientation(bj_lastPlayedSound,soundModel.SCO.x,soundModel.SCO.y,soundModel.SCO.z)
    call SetSoundConeAngles(bj_lastPlayedSound,soundModel.CA.IN,soundModel.CA.OUT,soundModel.CA.Volume)
    call SetSoundVelocity(bj_lastPlayedSound,soundModel.SV.x,soundModel.SV.y,soundModel.SV.z)
    call SaveBoolean(HT,StringHash(s),i,false)
    call TimerStart(t,GetSoundFileDuration(s)*0.001,false,function TimeOut)
    set t = null
    return bj_lastPlayedSound
endfunction
private function TimeOut2 takes nothing returns nothing
    local sound sou = LoadSoundHandle(HT,GetHandleId(GetExpiredTimer()),0x9B7EB41F)
    local integer i = LoadInteger(HT,GetHandleId(sou),Key_Index)//当前位置
    local string s = LoadStr(HT,GetHandleId(sou),0x2D297D87)
    local integer sh = StringHash(s)
    local integer index = LoadInteger(HT,sh,key_Index) - 1//数组顶位置 
    //call DisplayTextToPlayer(Player(0),0,0,"结束"+"index="+I2S(index)+"this=:"+I2S(i)+","+s)
    //顶部移动到当前
    call SaveInteger(HT,GetHandleId(LoadSoundHandle(HT,sh,index)),Key_Index,i)
    //当前移动到顶部
    call SaveInteger(HT,GetHandleId(sou),Key_Index,index)
    call SaveInteger(HT,sh,Key_Index,index)
    set sou = null
    endfunction
//获取音效
private function GetRe takes string s , real r , integer i ,real x , real y ,real z returns sound 
    local timer t = LoadTimerHandle(HT,GetHandleId(LoadSoundHandle(HT,StringHash(s),i)),0x1CA61CEC)
    set bj_lastPlayedSound = LoadSoundHandle(HT,StringHash(s),i)
    call SetSoundDistances( bj_lastPlayedSound,soundModel.SD.minDis ,soundModel.SD.maxDis)
    call SetSoundDistanceCutoff( bj_lastPlayedSound, r)
    call SetSoundPosition(bj_lastPlayedSound, x, y, z)
    call SetSoundChannel(bj_lastPlayedSound,soundModel.Channel)
    call SetSoundVolume(bj_lastPlayedSound,soundModel.Volume)
    call SetSoundPitch(bj_lastPlayedSound,soundModel.Pitch)
    call SetSoundConeOrientation(bj_lastPlayedSound,soundModel.SCO.x,soundModel.SCO.y,soundModel.SCO.z)
    call SetSoundConeAngles(bj_lastPlayedSound,soundModel.CA.IN,soundModel.CA.OUT,soundModel.CA.Volume)
    call SetSoundVelocity(bj_lastPlayedSound,soundModel.SV.x,soundModel.SV.y,soundModel.SV.z)
    call TimerStart(t,GetSoundFileDuration(s)*0.001,false,function TimeOut2)
    set t = null
    return bj_lastPlayedSound
endfunction
private function CreateRe takes string s , real r , integer i ,real x , real y ,real z,boolean is3d returns sound
    local timer t = CreateTimer()
    
    set bj_lastPlayedSound =CreateSound( s, false, is3d, false, soundModel.fadeInRate, soundModel.fadeOutRate, soundModel.SoundType)
    call SetSoundDistances( bj_lastPlayedSound,soundModel.SD.minDis ,soundModel.SD.maxDis)
    call SetSoundDistanceCutoff( bj_lastPlayedSound, r)
    call SetSoundPosition(bj_lastPlayedSound, x, y, z)
    call SetSoundChannel(bj_lastPlayedSound,soundModel.Channel)
    call SetSoundVolume(bj_lastPlayedSound,soundModel.Volume)
    call SetSoundPitch(bj_lastPlayedSound,soundModel.Pitch)
    call SetSoundConeOrientation(bj_lastPlayedSound,soundModel.SCO.x,soundModel.SCO.y,soundModel.SCO.z)
    call SetSoundConeAngles(bj_lastPlayedSound,soundModel.CA.IN,soundModel.CA.OUT,soundModel.CA.Volume)
    call SetSoundVelocity(bj_lastPlayedSound,soundModel.SV.x,soundModel.SV.y,soundModel.SV.z)
    call SaveSoundHandle(HT,StringHash(s),i,bj_lastPlayedSound)
    call SaveTimerHandle(HT,GetHandleId(bj_lastPlayedSound),0x1CA61CEC,t)
    call SaveSoundHandle(HT,GetHandleId(t),0x9B7EB41F,bj_lastPlayedSound)
    call SaveInteger(HT,GetHandleId(bj_lastPlayedSound),Key_Index,i)//记录位置
    call SaveStr(HT,GetHandleId(bj_lastPlayedSound),0x2D297D87,s)
    call TimerStart(t,GetSoundFileDuration(s)*0.001,false,function TimeOut2)
    set t = null
    return bj_lastPlayedSound
endfunction
//Sound3DII_CooPlay(string,real,real,real,real)用于在坐标处播放音效
//s:音效位置
//xyz 为坐标
//r:裁断距离
function Sound3DII_CooPlay takes string s , real x,real y , real z, real r returns sound
    local integer sh = StringHash(s)
    local integer count = LoadInteger(HT,sh,key_Count)
    local integer index = LoadInteger(HT,sh,key_Index)
    local boolean Enable 
    local integer loopi = 0
    if index==count then
        set bj_lastPlayedSound = CreateRe(s,r,count,x,y,z,true)
        call StartSound(bj_lastPlayedSound)
        call SaveInteger(HT,sh,0xB7279243,count + 1) 
        call SaveInteger(HT,sh,key_Index,index + 1) 
        //call DisplayTextToPlayer(Player(0),0,0,"新建"+"index="+I2S(index)+"count=:"+I2S(count))
    else
        
        set bj_lastPlayedSound = GetRe(s,r,index,x,y,z)
        call StartSound(bj_lastPlayedSound) 
        call SaveInteger(HT,sh,key_Index,index + 1) 
        //call DisplayTextToPlayer(Player(0),0,0,"读取"+"index="+I2S(index)+"count=:"+I2S(count))     
    endif
    return bj_lastPlayedSound
endfunction 
//Sound3DII_UnitPlay(string,unit,real)用于在单位位置播放音效
function Sound3DII_UnitPlay takes string s , unit u , real r returns sound
    return Sound3DII_CooPlay(s,GetUnitX(u), GetUnitY(u), GetUnitFlyHeight(u),r)
endfunction
//Sound3DII_LocPlay(string,Location,real)用于在点播放音效
function Sound3DII_LocPlay takes string s , location u , real r returns sound
    return Sound3DII_CooPlay(s,GetLocationX(u), GetLocationY(u), GetLocationZ(u),r)
endfunction
//非3D音效播放函数
public function Mp3Play takes string s , player p returns sound 
    local integer count = LoadInteger(HT,StringHash(s),0xB7279243) 
    local boolean Enable 
    local integer loopi = 0
    local real r = 4000
    local sound sou = null
    if count != 0 then
        loop
            set Enable = LoadBoolean(HT,StringHash(s),loopi)
                if Enable then
                    exitwhen true
                    //call DisplayTextToPlayer(Player(0),0,0,"读取到了一个true值，退出了循环" )
                endif
                //call DisplayTextToPlayer(Player(0),0,0,"循环" )
            set loopi = loopi + 1
            exitwhen loopi == count
        endloop
        /*if IsDebug  == true then
            call DisplayTextToPlayer(Player(0),0,0,"loopi的计数值为："+I2S(loopi) )  
        endif */
        if not Enable then
            set sou = Create(s,r,count,0,0,0,false)
            set bj_lastPlayedSound = sou
            if p!=null then
                if GetLocalPlayer() == p then
                    call StartSound(sou)
                endif
            else
                call StartSound(sou)
            endif
            //建立一个新的音效
            //call StartSound(Create(s,r,count,0,0,0,false))
            call SaveInteger(HT,StringHash(s),0xB7279243,count + 1) 
            /*if IsDebug  == true then
                call DisplayTextToPlayer(Player(0),0,0,"Enable为false" )
                call DisplayTextToPlayer(Player(0),0,0,"建立了一个新的音效,Count计数为:"+I2S(LoadInteger(HT,StringHash(s),StringHash("Count"))) )
            endif */
        else
            //取出一个音效播放
            set sou = Get(s,r,loopi,0,0,0)
            set bj_lastPlayedSound = sou
            if p!=null then
                if GetLocalPlayer() == p then
                    call StartSound(sou)
                endif
            else
                call StartSound(sou)
            endif
            /*if IsDebug  == true then
                call DisplayTextToPlayer(Player(0),0,0,"取出了一个新的音效,loopi计数为:"+I2S(loopi) )
            endif */
        endif
    else
    //建立一个新的音效
    set sou = Create(s,r,count,0,0,0,false)
    set bj_lastPlayedSound = sou
    if p!=null then
        if GetLocalPlayer() == p then
            call StartSound(sou)
        endif
    else
        call StartSound(sou)
    endif
    call SaveInteger(HT,StringHash(s),0xB7279243,count + 1) 
    
        /*if IsDebug  == true then
            call DisplayTextToPlayer(Player(0),0,0,"未能获取计数信息" )
            call DisplayTextToPlayer(Player(0),0,0,"建立了一个新的音效,Count计数为:"+I2S(LoadInteger(HT,StringHash(s),StringHash("Count"))) )
        endif */
    
    endif
    set lastCreateSound = sou
    set sou = null
    return lastCreateSound
endfunction
//声音效果：默认、战斗、战鼓、魔法、投射物、英雄语音、装饰物
private function GetSoundTypeByID takes integer id returns string
if id==1 then
    return "CombatSoundsEAX"
elseif id==2 then
    return "KotoDrumsEAX"
elseif id==3 then
    return "SpellsEAX"
elseif id==4 then
    return "MissilesEAX"
elseif id==5 then
    return "HeroAcksEAX"
elseif id==6 then
    return "DoodadsEAX"
endif
    return "DefaultEAXON"
endfunction
//设置声音效果
function Sound3DII_SetSoundTypeByID takes integer id returns nothing
    set soundModel.SoundType = GetSoundTypeByID(id)
endfunction
//设置声音通道
 function Sound3DII_SetChannel takes integer channel returns nothing
if channel >14 then
    set channel = 0
endif 
    set soundModel.Channel = channel
endfunction
//设置音量 范围：0-127
function Sound3DII_SetVolume takes integer v returns nothing
if v >127 then
    set v = 127
elseif v<0 then
    set v = 0
endif
set soundModel.Volume = v
endfunction
//设置淡入淡出距离
function Sound3DII_SetDistances takes real min , real max returns nothing
    call soundModel.SD.Set(min,max)
endfunction
//设置声音方向
function Sound3DII_SetConeOrientation takes real x , real y , real z returns nothing
    call soundModel.SCO.Set(x,y,z)
endfunction
//设置声音速度
function Sound3DII_SetVelocity takes real x , real y , real z returns nothing
    call soundModel.SV.Set(x,y,z)
endfunction
//
function Sound3DII_SetConeAngle takes real inside ,real outside , integer volume returns nothing
    call soundModel.CA.Set(inside,outside,volume)
endfunction
//设置淡入音量
function Sound3DII_SetFadeInRate takes integer i returns nothing
    set soundModel.fadeInRate = i
endfunction
//设置淡出音量
function Sound3DII_SetFadeOutRate takes integer i returns nothing
    set soundModel.fadeOutRate = i
endfunction
//Sound3DII初始化
private function LibInit takes nothing returns nothing
local ConeAngles ca= ConeAngles.create()
local SoundVelocity sv= SoundVelocity.create()
local SoundConeOrientation sco = SoundConeOrientation .create()
local SoundDistances sd = SoundDistances.create()
//初始化声音模型
set soundModel = SoundModel.create(ca,sv,sco,sd)
endfunction
endlibrary
library TerrainPathability initializer Init
globals
    private constant real MAX_RANGE = 10.
    private constant integer DUMMY_ITEM_ID = 'wolg'
endglobals
globals 
    private item Item = null
    private rect Find = null
    private item array Hid
    private integer HidMax = 0
    public real X = 0.
    public real Y = 0.
endglobals
function IsTerrainDeepWater takes real x, real y returns boolean
    return not IsTerrainPathable(x, y, PATHING_TYPE_FLOATABILITY) and IsTerrainPathable(x, y, PATHING_TYPE_WALKABILITY)
endfunction
function IsTerrainShallowWater takes real x, real y returns boolean
    return not IsTerrainPathable(x, y, PATHING_TYPE_FLOATABILITY) and not IsTerrainPathable(x, y, PATHING_TYPE_WALKABILITY) and IsTerrainPathable(x, y, PATHING_TYPE_BUILDABILITY)
endfunction
function IsTerrainLand takes real x, real y returns boolean
    return IsTerrainPathable(x, y, PATHING_TYPE_FLOATABILITY)
endfunction
function IsTerrainPlatform takes real x, real y returns boolean
    return not IsTerrainPathable(x, y, PATHING_TYPE_FLOATABILITY) and not IsTerrainPathable(x, y, PATHING_TYPE_WALKABILITY) and not IsTerrainPathable(x, y, PATHING_TYPE_BUILDABILITY)
endfunction
private function HideItem takes nothing returns nothing
    if IsItemVisible(GetEnumItem()) then
        set Hid[HidMax] = GetEnumItem()
        call SetItemVisible(Hid[HidMax], false)
        set HidMax = HidMax + 1
    endif
endfunction
function IsTerrainWalkable takes real x, real y returns boolean
    call MoveRectTo(Find, x, y)
    call EnumItemsInRect(Find ,null, function HideItem)
    call SetItemPosition(Item, x, y) //Unhides the item
set X = GetItemX(Item)
    set Y = GetItemY(Item)
    call SetItemVisible(Item, false)
    loop
        exitwhen HidMax <= 0
        set HidMax = HidMax - 1
        call SetItemVisible(Hid[HidMax], true)
        set Hid[HidMax] = null
    endloop
    return (X-x)*(X-x)+(Y-y)*(Y-y) <= MAX_RANGE*MAX_RANGE and not IsTerrainPathable(x, y, PATHING_TYPE_WALKABILITY)
endfunction
private function Init takes nothing returns nothing
    set Find = Rect(0., 0., 128., 128.)
    set Item = CreateItem(DUMMY_ITEM_ID , 0, 0)
    call SetItemVisible(Item, false)
endfunction
endlibrary
library MNXT 
    globals
        hashtable csht = InitHashtable()
    endglobals
endlibrary
   
//! zinc
library X2 requires StarBase
{
    private
    {
        group tempg = null;
        unit arrayU[];
        real arrayI[];
        unit ReturnUnit = null;
    }
    //定义Point2f结构体  
    struct Point2f
    {
        real x;
        real y;
        static method create2(real X, real Y) ->Point2f
        {
            Point2f p = Point2f.allocate();
            p.x = X;
            p.y = Y;
            return p;
        }
        public method reset(real X,real Y){
            this.x = X;
            this.y = Y;
        }
        
    }
    // 定义直线参数结构体  
    struct LinePara
    {
        real k;
        real b;
    }
    //单位间距离
    private function DistanceBetweenUnit(unit a , unit b) -> real
    {
        real x1 = GetUnitX(a);
        real y1 = GetUnitY(a);
        real x2 = GetUnitX(b);
        real y2 = GetUnitY(b);
        return SquareRoot((y1-y2)*(y1-y2)+(x1-x2)*(x1-x2));
    }
    // 已知两点求直线
    public function getLinePara(real x1, real y1, real x2, real y2, LinePara LP)
    {
        real m = 0;
        // 计算分子  
        m = x2 - x1;
        if (0 == m)
        {
            LP.k = 10000.0;
            LP.b = y1 - LP.k * x1;
        }
        else
        {
            LP.k = (y2 - y1) / (x2 - x1);
            LP.b = y1 - LP.k * x1;
        }
        // y = kx + b
    }
    public function GAFC2(real x1,real y1,real x2,real y2) ->real
    {
        return Atan2(y2-y1,x2-x1)*bj_RADTODEG ;
    }
    public function GetDistanceUsePoint(Point2f p1 , Point2f p2)-> real
    {
    
        return SquareRoot((p1.y-p2.y)*(p1.y-p2.y)+(p1.x-p2.x)*(p1.x-p2.x));
        
    }
    public function getDistancePointAndLine(Point2f p0, Point2f p1, Point2f p2) ->real 
    {
        real dis12 = GetDistanceUsePoint(p1, p2);
        real dis01 = GetDistanceUsePoint(p0, p1);
        real dis02 = GetDistanceUsePoint(p0, p2);
        real HalfC = (dis12 + dis01 + dis02) / 2;
        real s = SquareRoot(HalfC * (HalfC - dis12) * (HalfC - dis01) * (HalfC - dis02));
        real dis = 2 * s / dis12;
        return dis;
    }
    public function getDistancePointAndLine2(Point2f p0, Point2f p1, Point2f p2,real dis12) ->real 
    {
        real dis01 = GetDistanceUsePoint(p0, p1);
        real dis02 = GetDistanceUsePoint(p0, p2);
        real HalfC = (dis12 + dis01 + dis02) / 2;
        real s = SquareRoot(HalfC * (HalfC - dis12) * (HalfC - dis01) * (HalfC - dis02));
        real dis = 2 * s / dis12;
        return dis;
    }
    public function fabs(real a) -> real
    {
        if (a >= 0)
        {
            return a;
        }
        return -a;
    }
    public function getDistancePointAndLine3(Point2f p0 , Point2f p1 , Point2f p2) ->real
    {
        real x0 = p0.x,x1=p1.x,x2=p2.x,y0=p0.x,y1=p1.x,y2=p2.x;
        return (fabs((y2 - y1) * x0 +(x1 - x2) * y0 + ((x2 * y1) -(x1 * y2)))) / (SquareRoot(Pow(y2 - y1, 2) + Pow(x1 - x2, 2))); 
    }
    public
    {
        group callBackGroup;
        Point2f P0;
        Point2f P1;
        Point2f P2;
        LinePara LP0;
    }
    //获取单位组中里单位最近的单位
    public function X2_GetNearUnitOnGroup(group gg , unit un)->unit
    {
        unit u;
        integer index = 0;integer i = 0 ;real j = 0;
        ReturnUnit = null;
        tempg = CreateGroup();
        GroupAddGroup(gg,tempg);
        u = FirstOfGroup(tempg);
        while(u!=null)
        {
            if(GetUnitState(u, UNIT_STATE_LIFE) > 0.00)
            {
                arrayU[index] = u;
                arrayI[index] = DistanceBetweenUnit(u,un);
                index = index + 1;
            }
            GroupRemoveUnit(tempg, u);
            u = FirstOfGroup(tempg);
        }
        // GroupClear(tempg);
        DestroyGroup(tempg);
        if(index>0){
            j = arrayI[i];
            ReturnUnit = arrayU[i];
            while(i<index)
            {
                if(arrayI[i]<j)//这个值小于当前记录最小值
                {
                    j = arrayI[i];//当前记录最小值 = 这个值
                    ReturnUnit = arrayU[i];//当前记录单位 = 这个单位
                }
                i = i + 1;
            } 
        }
        u = null;
        return ReturnUnit;
    }
    //生命值最少的单位
    public function X2_GetMinHpOfGroup(group gg)->unit
    {
        unit u;
        integer index = 0;integer i = 0 ;real j = 0;
        ReturnUnit = null;
        tempg = CreateGroup();
        GroupAddGroup(gg,tempg);
        u = FirstOfGroup(tempg);
        while(u!=null)
        {
            if(GetUnitState(u, UNIT_STATE_LIFE) > 0.00)
            {
                arrayU[index] = u;
                arrayI[index] =GetUnitState(u, UNIT_STATE_LIFE) ;
                index = index + 1;
            }
            GroupRemoveUnit(tempg, u);
            u = FirstOfGroup(tempg);
        }
        // GroupClear(tempg);
        DestroyGroup(tempg);
        if(index>0){
            j = arrayI[i];
            ReturnUnit = arrayU[i];
            while(i<index)
            {
                if(arrayI[i]<j)//这个值小于当前记录最小值
                {
                    j = arrayI[i];//当前记录最小值 = 这个值
                    ReturnUnit = arrayU[i];//当前记录单位 = 这个单位
                }
                i = i + 1;
            } 
        }
        u = null;
        return ReturnUnit;
    }
    public function X2_GDBC(real x1,real y1,real x2,real y2) -> real
    {
        return SquareRoot((y1-y2)*(y1-y2)+(x1-x2)*(x1-x2));
    }
    
    //获取单位组中离指定坐标最近的单位
    public function X2_GetNearPointOnGroup(group gg , real x,real y)->unit
    {
        unit u;
        integer index = 0;integer i = 0 ;real j = 0;
        ReturnUnit = null;
        tempg = CreateGroup();
        GroupAddGroup(gg,tempg);
        u = FirstOfGroup(tempg);
        while(u!=null)
        {
            if(GetUnitState(u, UNIT_STATE_LIFE) > 0.00)
            {
                arrayU[index] = u;
                arrayI[index] = X2_GDBC(GetUnitX(u),GetUnitY(u),x,y);
                index = index + 1;
            }
            GroupRemoveUnit(tempg, u);
            u = FirstOfGroup(tempg);
            }
            GroupClear(tempg);
            DestroyGroup(tempg);
            if(index>0){
            j = arrayI[i];
            ReturnUnit = arrayU[i];
            while(i<index)
            {
                if(arrayI[i]<j)
                {
                    j = arrayI[i];
                    ReturnUnit = arrayU[i];
                }
                i = i + 1;
            } 
        }
        DestroyGroup(tempg);
        u = null;
        return ReturnUnit;
    }
    public function X2_GetNearUnit(real r , unit un)->unit
    {
        //获取指定单位附近X范围内的最近的非友方单位
        unit u;
        integer index = 0;integer i = 0 ;real j = 0;
        group g = CreateGroup();
        ReturnUnit = null;
        tempg = CreateGroup();
        GroupEnumUnitsInRange(g, GetUnitX(un), GetUnitY(un),r, null);
        u = FirstOfGroup(g);
        while(u!=null)
        {
            if(IsUnitEnemy(u,GetOwningPlayer(un)))
            {
                GroupAddUnit(tempg,u);
            }
            GroupRemoveUnit(g, u);
            u = FirstOfGroup(g);
        }
        GroupClear(g);
        DestroyGroup(g);
        u = FirstOfGroup(tempg);
            while(u!=null)
            {
                arrayU[index] = u;
                arrayI[index] = DistanceBetweenUnit(u,un);
                index = index + 1;
                GroupRemoveUnit(tempg, u);
                u = FirstOfGroup(tempg);
            }
        GroupClear(tempg);
        DestroyGroup(tempg);
        if(index>0){
        j = arrayI[i];
        ReturnUnit = arrayU[i];
            while(i<index)
            {
                if(arrayI[i]<j)
                {
                    j = arrayI[i];
                    ReturnUnit = arrayU[i];
                }
                i = i + 1;
            } 
        }
        g = null;
        u = null;
        return ReturnUnit;
    }
    public function GetUnitOnLine(real x,real y, real a, real b , real r)->group
    {
        unit u;
        group g = CreateGroup();
        real c = 0;
        real d = 0;
        real dis;
        real dd = GAFC2(x,y,a,b);
        P2.x = a;P2.y = b;
        x = x + Cos(dd*bj_DEGTORAD) * 0.5*r;
        y = y + Sin(dd*bj_DEGTORAD) * 0.5*r;
        c = (x+a)/2;d = (y+b)/2;
        P1.x = x;P1.y = y;
        dis = GetDistanceUsePoint(P1,P2);
        callBackGroup = CreateGroup();
        GroupEnumUnitsInRange(g, c, d, (dis+r)/2, null);
        u = FirstOfGroup(g);
        while(u!=null)
        {
            P0.x = GetUnitX(u);
            P0.y = GetUnitY(u);
            if(getDistancePointAndLine2(P0,P1,P2,dis) <r)
            //if(getDistancePointAndLine3(P0,P1,P2) <r)
            {
                GroupAddUnit(callBackGroup,u);
            }
            GroupRemoveUnit(g, u);
            u = FirstOfGroup(g);
        }
        GroupClear(g);
        DestroyGroup(g);
        g = null;
        u = null;
        return callBackGroup;
    }
    //
    public function GetUnitOnRect(real x,real y, real a, real b , real r)->group
    {
        unit u;
        group g = CreateGroup();
        real c = 0;
        real d = 0;
        real dis;
        real dd = GAFC2(x,y,a,b);
        real long = Math.GDBC(x,y,a,b);
        //长 = long 宽 = r
        real hl = long / 2;
        real hr = r / 2;
        P2.x = a;P2.y = b;
        x = x + Cos(dd*bj_DEGTORAD) * 0.5*r;
        y = y + Sin(dd*bj_DEGTORAD) * 0.5*r;
        c = (x+a)/2;d = (y+b)/2;
        P1.x = x;P1.y = y;
        dis = GetDistanceUsePoint(P1,P2);
        callBackGroup = CreateGroup();
        GroupEnumUnitsInRange(g, c, d, (dis+r)/2, null);
        u = FirstOfGroup(g);
        while(u!=null)
        {
            P0.x = GetUnitX(u);
            P0.y = GetUnitY(u);
            if(getDistancePointAndLine2(P0,P1,P2,dis) <r)
            //if(getDistancePointAndLine3(P0,P1,P2) <r)
            {
                if(Math.GDBC(x,y,P0.x,P0.y) * SinBJ(Math.GAFC(x,y,P0.x,P0.y)-dd) < hr)
                {
                    if(Math.GDBC(a,b,P0.x,P0.y) * SinBJ(Math.GAFC(a,b,P0.x,P0.y)-dd-90) < hl)
                    {
                        GroupAddUnit(callBackGroup,u);
                    }
                }
            }
            GroupRemoveUnit(g, u);
            u = FirstOfGroup(g);
        }
        
        GroupClear(g);
        DestroyGroup(g);
        g = null;
        u = null;
        return callBackGroup;
    }
    function onInit()
    {
        P0 = Point2f.create();
        P1 = Point2f.create();
        P2 = Point2f.create();
        LP0 = LinePara.create();
    }
}
