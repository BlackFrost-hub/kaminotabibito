        call ForGroupBJ( LoadGroupHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x28F9922D), function Trig_IzayoiSakuya_SkillFunc004Func011Func002Func011A )
        call DestroyGroup( LoadGroupHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xA95CDEE4) )
