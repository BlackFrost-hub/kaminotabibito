        call GroupRemoveUnit( LoadGroupHandle(YDHT, GetHandleId( LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xE97D6160)), 0xBF671381), GetTriggerUnit() )
        if ((LoadBoolean(YDHT, GetHandleId( LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xE97D6160)), 0x68984D67) == false) and ((CountUnitsInGroup(LoadGroupHandle(YDHT, GetHandleId( LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xE97D6160)), 0xBF671381)) <= 0))) then
