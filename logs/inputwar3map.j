    if (((IsUnitAliveBJ(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xE97D6160)) == false) or (LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xCEA5D211) >= 6.00))) then
        call QuestMessageBJ( GetPlayersAll(), bj_QUESTMESSAGE_UPDATED, "TRIGSTR_1651" )
