            call SaveBoolean(YDHT, GetHandleId( LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0x650A3A3A)), 0x39AFDFD8, true)
        else
        endif
        call FlushChildHashtable(YDLOC, GetHandleId(GetTriggeringTrigger()))
