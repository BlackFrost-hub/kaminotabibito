        endif
    endif
    if ((LoadBoolean(YDHT, GetHandleId( LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xE97D6160)), 0x68984D67) == false) and ((EVENT_GAME_TIMER_EXPIRED == GetTriggerEventId()) == true)) then
        call SaveBoolean(YDHT, GetHandleId( LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xE97D6160)), 0x68984D67, true)
        call ShowUnit( LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xE97D6160), true )
        call SelectUnitForPlayerSingle( LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xE97D6160), GetOwningPlayer(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xE97D6160)) )
        call FlushChildHashtable(YDLOC, GetHandleId(GetTriggeringTrigger()))
        call DestroyTrigger(GetTriggeringTrigger())
