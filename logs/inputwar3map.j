    call SaveUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7), 0xB3542E15, GetEnumUnit())
    if ((GetOwningPlayer(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7), 0xB3542E15)) == GetTriggerPlayer())) then
        call RemoveSavedInteger(YDHT, GetHandleId( LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7), 0xB3542E15)), 0xBFFA0C74)
    else
    endif
endfunction
function Trig___________________ZLFunc008Func001A takes nothing returns nothing
    call SaveUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7), 0xB3542E15, GetEnumUnit())
    if ((GetOwningPlayer(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7), 0xB3542E15)) == GetTriggerPlayer())) then
        call QuestMessageBJ( GetPlayersAll(), bj_QUESTMESSAGE_UPDATED, ((R2S(GetUnitX(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7), 0xB3542E15))))+( "，")+( R2S(GetUnitY(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7), 0xB3542E15))))) )
    else
