    library StarGSS requires YDWEJapiUnit,YDWEAbilityState,StarBase,StarString
{
    private integer key_str = 0x1C0FF63B;
    private integer key_agi = 0x8DDD4FEF;
    private integer key_int = 0xA8711998;
    private integer key_atk = 0x37334223;
    private integer key_amr = 0x5349F28A;
    private integer key_hp = 0x2B780BC8;
    private integer key_mp = 0x1DBA8215;
    private integer key_ms = 0xDBB0350E;
    private integer key_as = 0x7794259D;
    private integer key_rhp =0xA9272EC9;
    private integer key_rmp =0xA12FA975;
    public function SGSS_SetUnitHPRegenerates(unit u,real r)
    {
        real atk;
        integer hd = GetHandleId(u);
        atk = LoadReal(StarBaseHT,hd,key_atk) +r;
        if(GetUnitAbilityLevel(u,'ASG1')==0)
        {
            UnitAddAbility(u,'ASG1');
        }
        YDWESetUnitAbilityDataReal(u,'ASG1',1,108,atk);
        IncUnitAbilityLevel(u,'ASG1');
        DecUnitAbilityLevel(u,'ASG1');
        SaveReal(StarBaseHT,hd,key_atk,atk);
    }
    //���ӵ�λu�Ĺ���������r��
    public function SGSS_SetUnitAttack(unit u,real r)
    {
        real atk;
        integer hd = GetHandleId(u);
        atk = LoadReal(StarBaseHT,hd,key_atk) +r;
        if(GetUnitAbilityLevel(u,'ASG1')==0)
        {
            UnitAddAbility(u,'ASG1');
        }
        YDWESetUnitAbilityDataReal(u,'ASG1',1,108,atk);
        IncUnitAbilityLevel(u,'ASG1');
        DecUnitAbilityLevel(u,'ASG1');
        SaveReal(StarBaseHT,hd,key_atk,atk);
    }
    //���õ�λu�ķ���������r
    public function SGSS_SetUnitAmrror(unit u,real r)
    {
        real atk;
        integer hd = GetHandleId(u);
        atk = LoadReal(StarBaseHT,hd,key_amr) +r;
        if(GetUnitAbilityLevel(u,'ASG2')==0)
        {
            UnitAddAbility(u,'ASG2');
        }
        YDWESetUnitAbilityDataReal(u,'ASG2',1,108,atk);
        IncUnitAbilityLevel(u,'ASG2');
        DecUnitAbilityLevel(u,'ASG2');
        SaveReal(StarBaseHT,hd,key_amr,atk);
    }
    //���ӵ�λu������ֵr��
    public function SGSS_SetUnitHP(unit u,real hp)
    {
        integer hd = GetHandleId(u);real p;
        real ohp;
        real nhp;
        real mhp = GetUnitState(u,UNIT_STATE_MAX_LIFE);
        ohp = LoadReal(StarBaseHT,hd,key_hp) +hp;
        if(GetUnitState(u,UNIT_STATE_LIFE)>0.405)
        {
            p = GetUnitState(u,UNIT_STATE_LIFE) / mhp;
        }
        //����ֵ = hp ����ֵ = ohp ��� ���� ��ֵ 
        nhp =ohp + hp;
        //�������ֵ = �������ֵ - ohp + nmp
        SetUnitState(u,UNIT_STATE_MAX_LIFE,mhp-ohp+nhp);
        if(GetUnitState(u,UNIT_STATE_LIFE)>0.405)
        {
            SetUnitState(u,UNIT_STATE_LIFE,GetUnitState(u,UNIT_STATE_MAX_LIFE)*p);
        } 
        SaveReal(StarBaseHT,hd,key_hp,nhp);
    }
    //���ӵ�λu�ķ���ֵr��
    public function SGSS_SetUnitMP(unit u,real mp)
    {
        // integer hd = GetHandleId(u);real p;
        // p = GetUnitState(u,UNIT_STATE_MANA) / GetUnitState(u,UNIT_STATE_MAX_MANA);
        // SetUnitState(u,UNIT_STATE_MAX_MANA,GetUnitState(u,UNIT_STATE_MAX_MANA)+mp);
        // SetUnitState(u,UNIT_STATE_MANA,GetUnitState(u,UNIT_STATE_MAX_MANA)*p);
        integer hd = GetHandleId(u);real p;
        real ohp;
        real nhp;
        real mhp = GetUnitState(u,UNIT_STATE_MAX_MANA);
        ohp = LoadReal(StarBaseHT,hd,key_mp) +mp;
        p = GetUnitState(u,UNIT_STATE_MANA) / mhp;
        nhp =ohp + mp;
        SetUnitState(u,UNIT_STATE_MAX_MANA,mhp-ohp+nhp);
        SetUnitState(u,UNIT_STATE_MANA,GetUnitState(u,UNIT_STATE_MAX_MANA)*p);
        SaveReal(StarBaseHT,hd,key_mp,nhp);
    }
    // ʹ ��λu ���� ����a ����b ����c ��
    public function SGSS_SetUnitState(unit u,real a,real b,real c)
    {
        real str,agi,int2;
        integer hd = GetHandleId(u);
        str = LoadReal(StarBaseHT,hd,key_str) +a;
        agi = LoadReal(StarBaseHT,hd,key_agi) +b;
        int2 = LoadReal(StarBaseHT,hd,key_int) +c;
        if(GetUnitAbilityLevel(u,'ASG3')==0)
        {
            UnitAddAbility(u,'ASG3');
        }
        // Print("����->"+R2S(a)+",����->"+R2S(b)+",����->"+R2S(c));
        YDWESetUnitAbilityDataReal(u,'ASG3',1,110,str);
        YDWESetUnitAbilityDataReal(u,'ASG3',1,108,agi);
        YDWESetUnitAbilityDataReal(u,'ASG3',1,109,int2);
        IncUnitAbilityLevel(u,'ASG3');
        DecUnitAbilityLevel(u,'ASG3');
        SaveReal(StarBaseHT,hd,key_str,str);
        SaveReal(StarBaseHT,hd,key_agi,agi);
        SaveReal(StarBaseHT,hd,key_int,int2);
        // Print("�ܼƼӳ�����->"+R2S(LoadReal(StarBaseHT,hd,key_str))+",�ܼƼӳ�����->"+R2S(LoadReal(StarBaseHT,hd,key_agi))+",�ܼƼӳ�����->"+R2S(LoadReal(StarBaseHT,hd,key_int)));
    }
    //���ӵ�λ�ƶ��ٶ�
    public function SGSS_SetUnitMoveSpeed(unit u,real r)
    {
        real hp;
        integer hd = GetHandleId(u);
        hp = LoadReal(StarBaseHT,hd,key_ms) +r;
        if(GetUnitAbilityLevel(u,'ASG6')==0)
