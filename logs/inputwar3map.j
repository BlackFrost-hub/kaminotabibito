        as = LoadReal(StarBaseHT,hd,key_as) +r;
        if(GetUnitAbilityLevel(u,'ASG7')==0)
        {
            UnitAddAbility(u,'ASG7');
        }
        YDWESetUnitAbilityDataReal(u,'ASG7',1,108,as);
        IncUnitAbilityLevel(u,'ASG7');
        DecUnitAbilityLevel(u,'ASG7');
        SaveReal(StarBaseHT,hd,key_as,as);
    }
