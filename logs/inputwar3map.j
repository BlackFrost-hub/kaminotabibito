function Trig_IzayoiSakuya_SkillFunc010Func002Conditions takes nothing returns nothing
    if (((EVENT_GAME_TIMER_EXPIRED == GetTriggerEventId()) == true)) then
        call SaveBoolean(YDHT, GetHandleId( LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0x650A3A3A)), 0x39AFDFD8, false)
        call FlushChildHashtable(YDLOC, GetHandleId(GetTriggeringTrigger()))
        call DestroyTrigger(GetTriggeringTrigger())
    else
