function Trig_Boss________________________CFActions takes nothing returns nothing
    local timer ydl_timer
    local integer ydl_localvar_step = LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xCFDE6C76) 
 set ydl_localvar_step = ydl_localvar_step + 3 
 call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xCFDE6C76, ydl_localvar_step) 
 call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7, ydl_localvar_step)
    if ((GetUnitTypeId(GetTriggerUnit()) == 'n02S')) then
        if ((GetUnitState(GetTriggerUnit(), UNIT_STATE_LIFE) < ((GetUnitState(GetTriggerUnit(), UNIT_STATE_MAX_LIFE))*( 0.50)))) then
            if ((GetUnitAbilityLevel(GetTriggerUnit(), 'A04X') >= 1)) then
                call DoNothing( )
            else
                call UnitAddAbility( GetTriggerUnit(), 'A04X' )
            endif
        else
            if ((GetUnitAbilityLevel(GetTriggerUnit(), 'A04X') >= 1)) then
                call UnitRemoveAbility( GetTriggerUnit(), 'A04X' )
            else
                call DoNothing( )
            endif
        endif
    else
    endif
    if ((GetUnitTypeId(GetTriggerUnit()) == 'N05J')) then
        if ((GetUnitLifePercent(GetTriggerUnit()) >= 70.00)) then
            if ((GetUnitAbilityLevel(GetTriggerUnit(), 'A0KZ') >= 1)) then
                call DoNothing( )
            else
                call UnitAddAbility( GetTriggerUnit(), 'A0KZ' )
                set ydl_timer = CreateTimer()
                call SaveUnitHandle(YDLOC, GetHandleId(ydl_timer), 0x458B7DE9, GetTriggerUnit())
                call TimerStart(ydl_timer, 2.00, true, function Trig_Boss________________________CFFunc004Func002Func001Func003T)
            endif
        else
        endif
    else
    endif
    if ((GetUnitAbilityLevel(GetTriggerUnit(), 'A0I9') != 1) and (GetUnitTypeId(GetTriggerUnit()) == 'O008') and (GetEventDamage() >= GetUnitState(GetTriggerUnit(), UNIT_STATE_LIFE))) then
        call YDWESetEventDamage( 0. )
        call SaveUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x76ABBC1D, GetTriggerUnit())
        call SaveUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x5A47F98D, GetEventDamageSource())
        call SetUnitInvulnerable( GetTriggerUnit(), true )
        call PauseUnit( GetTriggerUnit(), true )
        call UnitAddAbility( GetTriggerUnit(), 'A0I9' )
        call SetStackedSoundBJ( false, gg_snd_battlejieluboss01, gg_rct______________1524 )
        call SetUnitScale( GetTriggerUnit(), 2.50, 2.50, 2.50 )
        call SetUnitLifePercentBJ( GetTriggerUnit(), 3.00 )
        call TransmissionFromUnitWithNameBJ( GetPlayersAll(), null, GetUnitName(GetTriggerUnit()), null, "TRIGSTR_1671", bj_TIMETYPE_ADD, 0, true )
        call GS_Suspend( GetTriggerUnit(), 0.00 )
        call PauseUnit( GetTriggerUnit(), false )
        call SetUnitInvulnerable( GetTriggerUnit(), false )
        call UnitRemoveBuffsEx( GetTriggerUnit(), true, false, false, false, false, false, true )
        call IssueImmediateOrder( GetTriggerUnit(), "avatar" )
        call SetUnitLifePercentBJ( GetTriggerUnit(), 100.00 )
        call SetStackedSoundBJ( true, gg_snd_battleBoss3, gg_rct______________1524 )
        set ydl_timer = CreateTimer()
        call SaveUnitHandle(YDLOC, GetHandleId(ydl_timer), 0x76ABBC1D, LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x76ABBC1D))
        call SaveUnitHandle(YDLOC, GetHandleId(ydl_timer), 0x458B7DE9, GetTriggerUnit())
        call SaveUnitHandle(YDLOC, GetHandleId(ydl_timer), 0x5A47F98D, LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x5A47F98D))
        call TimerStart(ydl_timer, 1.00, true, function Trig_Boss________________________CFFunc005Func019T)
    else
    endif
    if ((GetUnitTypeId(GetTriggerUnit()) == 'Nbrn') and (GetUnitLifePercent(GetTriggerUnit()) <= 40.00)) then
        if ((LoadBoolean(YDHT, GetHandleId( GetTriggerUnit()), 0x742C6DB1) == false)) then
            call YDWESetEventDamage( 0. )
            call SaveBoolean(YDHT, GetHandleId( GetTriggerUnit()), 0x742C6DB1, true)
            call SetUnitLifePercentBJ( GetTriggerUnit(), 100.00 )
            call TransmissionFromUnitWithNameBJ( GetPlayersAll(), null, GetUnitName(GetTriggerUnit()), null, "TRIGSTR_1673", bj_TIMETYPE_ADD, 0, true )
            call SaveUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x61989CD8, CreateUnit(GetOwningPlayer(GetTriggerUnit()), LoadInteger(YDHT, StringHash( "技能马甲"), 0x86D47FF3), GetUnitX(GetTriggerUnit()), GetUnitY(GetTriggerUnit()), 0))
            call DzSetUnitModel( LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x61989CD8), "war3mapImported\\dtpink.mdl" )
            call SetUnitScale( LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x61989CD8), 4.00, 4.00, 4.00 )
            call SetUnitVertexColor( LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x61989CD8), 0, 255, 0, 255 )
            call UnitApplyTimedLife( LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x61989CD8), 'BHwe', 1.50 )
            call QuestMessageBJ( GetPlayersAll(), bj_QUESTMESSAGE_WARNING, "TRIGSTR_1674" )
            set ydl_timer = CreateTimer()
            call TimerStart(ydl_timer, 3.00, false, function Trig_Boss________________________CFFunc006Func001Func011T)
        else
        endif
    else
    endif
    call FlushChildHashtable(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step)
    set ydl_timer = null
endfunction
