function Trig______________YXFunc012Func002Func002Func003T takes nothing returns nothing
    call SaveReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xA3932093, ((LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xA3932093))+( 1.00)))
    if ((LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xA3932093) >= 100.00)) then
        call DzFrameShow( LoadInteger(YDLOC, GetHandleId(GetExpiredTimer()), 0x4C45E673), false )
        call FlushChildHashtable(YDLOC, GetHandleId(GetExpiredTimer()))
        call DestroyTimer(GetExpiredTimer())
    else
        call DzFrameSetAlpha( LoadInteger(YDLOC, GetHandleId(GetExpiredTimer()), 0x4C45E673), R2I(((255.00)*( ((1.00)-( ((0.01)*( LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xA3932093)))))))) )
    endif
endfunction
function Trig______________YXFunc012Func002T takes nothing returns nothing
    local timer ydl_timer
    call SaveReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xCEA5D211, ((LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xCEA5D211))+( 1.00)))
    if ((LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xCEA5D211) > 4.00)) then
        call SaveReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xA3932093, 0.00)
        set ydl_timer = CreateTimer()
        call SaveReal(YDLOC, GetHandleId(ydl_timer), 0xA3932093, LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xA3932093))
        call SaveInteger(YDLOC, GetHandleId(ydl_timer), 0x4C45E673, LoadInteger(YDLOC, GetHandleId(GetExpiredTimer()), 0x4C45E673))
        call TimerStart(ydl_timer, 0.03, true, function Trig______________YXFunc012Func002Func002Func003T)
        call FlushChildHashtable(YDLOC, GetHandleId(GetExpiredTimer()))
        call DestroyTimer(GetExpiredTimer())
    else
        if ((LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xCEA5D211) == 1.00)) then
            call DzFrameSetText( LoadInteger(YDLOC, GetHandleId(GetExpiredTimer()), 0x437E2A40), "（未知的声音）来到此处旅者啊.." )
        else
            if ((LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xCEA5D211) == 2.00)) then
                if ((GetRandomInt(1, 2) == 1)) then
                    call DzFrameSetText( LoadInteger(YDLOC, GetHandleId(GetExpiredTimer()), 0xD963A09F), "既然选择接受试炼.." )
                else
                    call DzFrameSetText( LoadInteger(YDLOC, GetHandleId(GetExpiredTimer()), 0xD963A09F), "既然拥有这份勇气" )
                endif
            else
                if ((LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xCEA5D211) == 3.00)) then
                    call DzFrameSetText( LoadInteger(YDLOC, GetHandleId(GetExpiredTimer()), 0xCD1043F3), "准备迎接.." )
                else
                    if ((LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xCEA5D211) == 4.00)) then
                        call DzFrameSetText( LoadInteger(YDLOC, GetHandleId(GetExpiredTimer()), 0xD76E1C1B), "来自异界之人的试炼吧！" )
                    else
                    endif
                endif
            endif
        endif
    endif
    set ydl_timer = null
endfunction
