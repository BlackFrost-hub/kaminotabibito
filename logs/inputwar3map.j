library StarFastBuff requires YDWEJapiUnit,StarBase,SUSPEND
{
    private integer key_rx = 0x3C007FD8;
    private player own;
    private real fac;
    public integer SFB_AblList[];
    public string SFB_AblOrderList[];
    public integer SFB_AblIOrderList[];
    //获取单位间角度 
    private function getAngleBetweenUnits(unit u,unit tu)->real
    {
        return Math.GAFC(GetUnitX(u),GetUnitY(u),GetUnitX(tu),GetUnitY(tu));
    }
    private function onInit(){
        SFB_AblList[0] = 'ASB0';
        SFB_AblOrderList[0] = "thunderbolt";
        SFB_AblList[1] = 'ASB4';
        SFB_AblOrderList[1] = "creepthunderbolt";
        SFB_AblList[2] = 'ASB8';
        SFB_AblOrderList[2] = "silence";
        SFB_AblList[3] = 'ASBy';
        SFB_AblOrderList[3] = "polymorph";
        SFB_AblList[4] = 'ASBX';
        SFB_AblOrderList[4] = "invisibility";
        SFB_AblList[5] = 'ASB8';
        SFB_AblOrderList[5] = "silence";
        SFB_AblList[6] = 'ASB9';
        SFB_AblIOrderList[6] = 852075;
        //TODO嗜血术
        SFB_AblList[7] = 'ASB9';
        SFB_AblIOrderList[7] = 852075;
        //TODO驱散
        SFB_AblList[8] = 'ASB9';
        SFB_AblIOrderList[8] = 852075;
    }
    // //设置自定义buff 目标单位 技能id 持续时间
    // public function SFB_SetSelfBuff(unit u,integer abi,real time)
    // {
    //     integer rx = LoadInteger(YDHT,GetHandleId(u),key_rx);
    //     //读取韧性
    //     if(rx>100)rx=100;
    //     if(rx!=0){
    //         time = time * (100-rx)/100;
    //     }
    //     if(time==0 || IsUnitType(u, UNIT_TYPE_STRUCTURE)||u==SFB_Unit ){ 
    //         return;
    //     }
    //     fac = getAngleBetweenUnits(SFB_Unit, u);
    //     EXSetUnitFacing( SFB_Unit, fac);
    //     SetUnitFacing(SFB_Unit, fac);
    //     UnitAddAbility(SFB_Unit,abi);
    //     YDWESetUnitAbilityDataReal( SFB_Unit, abi, 1, 102, time );
    //     YDWESetUnitAbilityDataReal( SFB_Unit, abi, 1, 103, time );
    //     IssueTargetOrderById(  SFB_Unit, YDWEAbilityId2OrderId(abi, "Order"), u );
    //     //UnitRemoveAbility(SFB_Unit,abi);
    // }
    //设置BUFF 目标 buff类型: 0=击晕 1=冰冻 2=沉默 3 = 变形 4=隐身 5=缴械 持续时间time
    //21 = 
    private timer tempTimer;
    public function SFB_setBuff(unit u,integer id,real time)
    {
        integer rx = LoadInteger(YDHT,GetHandleId(u),key_rx);
        //读取韧性
        if(id!=5){
            if(rx>100){
                rx=100;
            }
            if(rx!=0){
                time = time * (100-rx)/100;
            } 
            
        }
        if(time==0 || IsUnitType(u, UNIT_TYPE_STRUCTURE)||u==SFB_Unit ){ 
            return;
        }
        if(id>=21){
            if(id==21){
                //硬直
                GS_Suspend(u,time);
            }else if(id == 22){
                //暂停
                tempTimer = CreateTimer();
                SaveUnitHandle(YDHT,GetHandleId(tempTimer),0x62274AD0,u);
                PauseUnit(u,true);
                TimerStart(tempTimer,time,false,function(){
                    //解除暂停
                    tempTimer = GetExpiredTimer();
                    PauseUnit(LoadUnitHandle(YDHT,GetHandleId(tempTimer),0x62274AD0),false);
                    RemoveSavedHandle(YDHT,GetHandleId(tempTimer),0x62274AD0);
                    DestroyTimer(tempTimer);
                    tempTimer = null;
                });
                tempTimer = null;
            }else if(id == 23){
                //
                tempTimer = CreateTimer();
                SaveUnitHandle(YDHT,GetHandleId(tempTimer),0x62274AD0,u);
                EXPauseUnit(u,true);
                TimerStart(tempTimer,time,false,function(){
                    //解除眩晕
                    tempTimer = GetExpiredTimer();
                    EXPauseUnit(LoadUnitHandle(YDHT,GetHandleId(tempTimer),0x62274AD0),false);
                    RemoveSavedHandle(YDHT,GetHandleId(tempTimer),0x62274AD0);
                    DestroyTimer(tempTimer);
                    tempTimer = null;
                });
                tempTimer = null;
            }
        }else{
            fac = getAngleBetweenUnits(SFB_Unit, u);
            EXSetUnitFacing( SFB_Unit, fac);
            SetUnitFacing(SFB_Unit, fac);
            if(id==2)
            {
                YDWESetUnitAbilityDataReal( SFB_Unit, SFB_AblList[id], 1, 108, 8 );
            }else if(id==5)
            {
                YDWESetUnitAbilityDataReal( SFB_Unit, SFB_AblList[id], 1, 108, 7 );
            }
            YDWESetUnitAbilityDataReal( SFB_Unit, SFB_AblList[id], 1, 102, time );
            YDWESetUnitAbilityDataReal( SFB_Unit, SFB_AblList[id], 1, 103, time );
            IssueTargetOrder( SFB_Unit, SFB_AblOrderList[id], u );
        }
    }
    //设置单位减速 目标 降低攻速百分比  降低移速百分比  持续时间
    public function SFB_setSlow(unit u,real as,real ms,real time){
        integer rx = LoadInteger(YDHT,GetHandleId(u),key_rx);
        real fac;
        //读取韧性
        if(rx>100)rx=100;
        if(rx!=0){
            time = time * (100-rx)/100;
        }
        if(time==0 || IsUnitType(u, UNIT_TYPE_STRUCTURE)||u==SFB_Unit ){ 
            return;
        }
        fac = getAngleBetweenUnits(SFB_Unit, u);
        EXSetUnitFacing( SFB_Unit, fac);
        SetUnitFacing(SFB_Unit, fac);
        YDWESetUnitAbilityDataReal( SFB_Unit, 'ASB9', 1, 108, ms );
        YDWESetUnitAbilityDataReal( SFB_Unit, 'ASB9', 1, 109, as );
        YDWESetUnitAbilityDataReal( SFB_Unit, 'ASB9', 1, 102, time );
        YDWESetUnitAbilityDataReal( SFB_Unit, 'ASB9', 1, 103, time );
        IssueTargetOrderById(SFB_Unit,852075,u);
        // if(ms<0){
        //     YDWESetUnitAbilityDataString( u, 'Bslo', 1, 213, "该单位被加速了" )
        //     YDWESetUnitAbilityDataString( u, 'Bslo', 1, 212, "加速" )
        // }
    }
}
