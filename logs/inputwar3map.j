    call SaveBoolean(YDHT, GetHandleId( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9)), 0x41B2CEE7, false)
    call RemoveSavedBoolean(YDHT, GetHandleId( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9)), 0x54CF4100)
    call FlushChildHashtable(YDLOC, GetHandleId(GetExpiredTimer()))
    call DestroyTimer(GetExpiredTimer())
endfunction
function Trig_ALLT__________________uActions takes nothing returns nothing
    local timer ydl_timer
    local integer ydl_localvar_step = LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xCFDE6C76) 
 set ydl_localvar_step = ydl_localvar_step + 3 
 call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xCFDE6C76, ydl_localvar_step) 
 call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7, ydl_localvar_step)
    if ((GetIssuedOrderIdBJ() == String2OrderIdBJ("berserk")) and ((EVENT_UNIT_ISSUED_ORDER == GetTriggerEventId()) == true)) then
        // 由于动作是按照顺序运行的，所以在第一个IF动作当A模型切换→B模型时，会按顺序运行第二个IF动作，这第二个IF动作会导致B模型切换→A模型，所以要加跳过剩余动作
        // 这个事件即使是被控制状态下仍能被检测到，因此要加魔法效果判断条件
        if ((UnitHasBuffBJ(GetTriggerUnit(), 'B000') == false) and (UnitHasBuffBJ(GetTriggerUnit(), 'BPSE') == false)) then
            if ((GetUnitTypeId(GetTriggerUnit()) == 'H00F')) then
                call DzSetUnitID( GetTriggerUnit(), 'H00G' )
                call SetUnitState( GetTriggerUnit(), ConvertUnitState(0x12), ((30.00)+( ((I2R(GetHeroStr(GetTriggerUnit(), false)))*( 1.35)))) )
                call YDWESetUnitAbilityDataString( GetTriggerUnit(), 'A0D7', 1, 204, "ReplaceableTextures\\CommandButtons\\BTNALLT-Q2.blp" )
                call YDWESetUnitAbilityDataString( GetTriggerUnit(), 'A0D6', 1, 204, "ReplaceableTextures\\CommandButtons\\BTNSoulGem.blp" )
                call YDWESetUnitAbilityDataString( GetTriggerUnit(), 'A0D4', 1, 204, "ReplaceableTextures\\CommandButtons\\BTNALLT-E2.blp" )
                call YDWESetUnitAbilityDataString( GetTriggerUnit(), 'A0D5', 1, 204, "ReplaceableTextures\\CommandButtons\\BTNALLT-R2.blp" )
                call YDWESetUnitAbilityDataString( GetTriggerUnit(), 'A0D8', 1, 204, "ReplaceableTextures\\CommandButtons\\BTNArthas.blp" )
                call SaveEffectHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x856BAF2A, AddSpecialEffectTarget("war3mapImported\\Metamorphosis.mdl", GetTriggerUnit(), "origin"))
                call SaveEffectHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x50DDE98B, AddSpecialEffectTarget("war3mapImported\\BloodSlam.mdl", GetTriggerUnit(), "origin"))
                call YDWETimerDestroyEffect( 2.00, LoadEffectHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x856BAF2A) )
                call YDWETimerDestroyEffect( 2.00, LoadEffectHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x50DDE98B) )
                // 切换加属性
                call SaveReal(YDHT, GetHandleId( GetTriggerPlayer()), 0x69A9C634, ((LoadReal(YDHT, GetHandleId( GetTriggerPlayer()), 0x69A9C634))+( -0.10)))
                call SaveReal(YDHT, GetHandleId( GetTriggerPlayer()), 0xA9A9783B, ((LoadReal(YDHT, GetHandleId( GetTriggerPlayer()), 0xA9A9783B))+( -0.05)))
                call SaveReal(YDHT, GetHandleId( GetTriggerPlayer()), 0xD7D6B250, ((LoadReal(YDHT, GetHandleId( GetTriggerPlayer()), 0xD7D6B250))+( 0.12)))
                call SaveReal(YDHT, GetHandleId( GetTriggerPlayer()), 0xE0A9DEEE, ((LoadReal(YDHT, GetHandleId( GetTriggerPlayer()), 0xE0A9DEEE))+( 0.12)))
                // 切换治疗
                call SaveReal(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x9EE8AA2E, ((((GetUnitState(GetTriggerUnit(), UNIT_STATE_MAX_LIFE))-( GetUnitState(GetTriggerUnit(), UNIT_STATE_LIFE))))*( 0.15)))
                call SaveUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x089E63E0, CreateUnit(GetOwningPlayer(GetTriggerUnit()), 'e031', GetUnitX(GetTriggerUnit()), GetUnitY(GetTriggerUnit()), 0))
                call UnitAddAbility( LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x089E63E0), 'A0AD' )
                call YDWESetUnitAbilityDataReal( LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x089E63E0), 'A0AD', 1, 108, LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x9EE8AA2E) )
                call IssueTargetOrder( LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x089E63E0), "holybolt", GetTriggerUnit() )
                // 切换加攻
                call SaveReal(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x79A7DFD7, ((GetUnitState(GetTriggerUnit(), ConvertUnitState(0x15)))*( 0.10)))
                call YDWEGeneralBounsSystemUnitSetBonus( GetTriggerUnit(), 3, 0, R2I(LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x79A7DFD7)) )
                call UnitAddAbility( GetTriggerUnit(), 'S008' )
                call SaveReal(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xCEA5D211, 0.00)
                set ydl_timer = CreateTimer()
                call SaveUnitHandle(YDLOC, GetHandleId(ydl_timer), 0x458B7DE9, GetTriggerUnit())
                call SaveReal(YDLOC, GetHandleId(ydl_timer), 0xCEA5D211, LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xCEA5D211))
                call SaveReal(YDLOC, GetHandleId(ydl_timer), 0x79A7DFD7, LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x79A7DFD7))
                call TimerStart(ydl_timer, 0.10, true, function Trig_ALLT__________________uFunc001Func005Func002Func029T)
                call FlushChildHashtable(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step)
                set ydl_timer = null
                return
            else
            endif
        else
        endif
        if ((GetUnitTypeId(GetTriggerUnit()) == 'H00G')) then
            call DzSetUnitID( GetTriggerUnit(), 'H00F' )
            call SetUnitState( GetTriggerUnit(), ConvertUnitState(0x12), ((30.00)+( ((I2R(GetHeroStr(GetTriggerUnit(), false)))*( 1.35)))) )
            call YDWESetUnitAbilityDataString( GetTriggerUnit(), 'A0D7', 1, 204, "ReplaceableTextures\\CommandButtons\\BTNALLT-Q.blp" )
            call YDWESetUnitAbilityDataString( GetTriggerUnit(), 'A0D6', 1, 204, "ReplaceableTextures\\CommandButtons\\BTNALLT-W.blp" )
            call YDWESetUnitAbilityDataString( GetTriggerUnit(), 'A0D4', 1, 204, "ReplaceableTextures\\CommandButtons\\BTNALLT-E.blp" )
            call YDWESetUnitAbilityDataString( GetTriggerUnit(), 'A0D5', 1, 204, "ReplaceableTextures\\CommandButtons\\BTNALLT-R.blp" )
            call YDWESetUnitAbilityDataString( GetTriggerUnit(), 'A0D8', 1, 204, "ReplaceableTextures\\CommandButtons\\BTNHeroDeathKnight.blp" )
            call SaveEffectHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x50DDE98B, AddSpecialEffectTarget("Abilities\\Spells\\Human\\Resurrect\\ResurrectCaster.mdl", GetTriggerUnit(), "origin"))
            call SaveEffectHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x856BAF2A, AddSpecialEffectTarget("Abilities\\Spells\\Human\\Resurrect\\ResurrectTarget.mdl", GetTriggerUnit(), "origin"))
            call YDWETimerDestroyEffect( 2.00, LoadEffectHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x856BAF2A) )
            call YDWETimerDestroyEffect( 2.00, LoadEffectHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x50DDE98B) )
            // 切换加属性
            call SaveReal(YDHT, GetHandleId( GetTriggerPlayer()), 0x69A9C634, ((LoadReal(YDHT, GetHandleId( GetTriggerPlayer()), 0x69A9C634))+( 0.10)))
            call SaveReal(YDHT, GetHandleId( GetTriggerPlayer()), 0xA9A9783B, ((LoadReal(YDHT, GetHandleId( GetTriggerPlayer()), 0xA9A9783B))+( 0.05)))
            call SaveReal(YDHT, GetHandleId( GetTriggerPlayer()), 0xD7D6B250, ((LoadReal(YDHT, GetHandleId( GetTriggerPlayer()), 0xD7D6B250))+( -0.12)))
            call SaveReal(YDHT, GetHandleId( GetTriggerPlayer()), 0xE0A9DEEE, ((LoadReal(YDHT, GetHandleId( GetTriggerPlayer()), 0xE0A9DEEE))+( -0.12)))
            // 切换清不利状态
            call UnitRemoveBuffsEx( GetTriggerUnit(), false, true, false, false, false, false, false )
            // 短暂免疫伤害
            call SaveBoolean(YDHT, GetHandleId( GetTriggerUnit()), 0x41B2CEE7, true)
            set ydl_timer = CreateTimer()
            call SaveUnitHandle(YDLOC, GetHandleId(ydl_timer), 0x458B7DE9, GetTriggerUnit())
            call TimerStart(ydl_timer, 0.50, false, function Trig_ALLT__________________uFunc001Func006Func022T)
        else
        endif
    else
    endif
    call FlushChildHashtable(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step)
    set ydl_timer = null
