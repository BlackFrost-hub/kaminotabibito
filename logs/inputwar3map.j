    //����/������Ʒ�ȼ���������
    public function SGSS_UnitAddItemLevelState(unit u,integer itp,boolean isGet,item wp)
    {
        integer hd = GetHandleId(wp);
        integer i = 0;
        real value ;
        real qv;
        real bv;
        integer itemLevel = LoadInteger(YDHT,hd,0x00E04AE6);
        integer qhlv = LoadInteger(YDHT,hd,0x234284B7);
        // Print("Ʒ��->"+I2S(itemLevel));
        for(1<=i<8){
            value = LoadReal(YDHT,itp,SGSS_TypeStrHash[i])*SGSS_B2I(isGet);//�����ɳ��� vlaue
            bv = value * 25; //����ֵ ����25��������
qv = 0.25*qhlv * (value);//�����ɳ��� *= ǿ��ϵ��
            bv = bv * (0.5+0.5*itemLevel);//����ֵ *= Ʒ��ϵ��
            bv = bv * (1+0.25*qhlv);//����ֵ *= ǿ��ϵ��
            value = (value + qv)* (0.5+0.5*itemLevel);//�����ɳ��� *= Ʒ��ϵ��
            SGSS_AddUnitLevelState(u,i,value);
            SGSS_AddUnitBaseState(u,i,bv);
        }
        //ˢ����
        SGSS_ReSetUnitState(u);
        SGSS_ReSetUnitState2(u);
    }
    public function SGSS_GetItemTitle(unit u,item wp)->string{
        integer itemLevel = LoadInteger(YDHT,GetHandleId(wp),0x00E04AE6);
        if(itemLevel<1)
            itemLevel = 1;
        if(itemLevel>6)
            itemLevel = 6;
        return SGSS_TypeStr[2100+itemLevel]+GetItemName(wp)+"|r"/*+SGSS_TypeStr[2200+itemLevel]*/;
        return "";
    }
    public function SGSS_GetItemTips(unit u,item wp)->string{
        integer hd = GetHandleId(wp);
        integer typ = GetItemTypeId(wp);
        real v;
        integer i = 0;
        real qv;
        integer lv = GetHeroLevel(u);
        integer qhlv = LoadInteger(YDHT,hd,0x234284B7);
        integer itemLevel = LoadInteger(YDHT,GetHandleId(wp),0x00E04AE6);
        StringBufferAdd("|cff00ff00");
        //ǿ���ȼ�������
        for(1<=i<=10){
            if(i<=qhlv){StringBufferAdd("��");}else{StringBufferAdd("��");}
        }
        StringBufferAdd("|r\n\n");
        for(1<=i<8){
            if(HaveSavedReal(YDHT,typ,SGSS_TypeStrHash[i]))//�ж��Ƿ����Ӹ�����
            {
                v = LoadReal(YDHT,typ,SGSS_TypeStrHash[i]) * (25+lv);//��ȡ���еĻ���ֵ
                qv = (v*0.25*qhlv) * (0.5+0.5*itemLevel);//����ֵ * 25% ǿ���ȼ� * Ʒ�ʼӳ�
                //Print("ǿ����ֵ"+R2S(qv));
                v = v * (0.5+0.5*itemLevel);//װ��Ʒ���ӳ��� 50%
                //�����ֵҪ������Ĺ�ʽƥ��
                StringBufferAdd(SGSS_TypeStr[1000+i]);
                if(v>=10){
                    StringBufferAdd(I2S(R2I(v)));
                }
                else{
                    StringBufferAdd(R2SW(v,1,1));
                }
                if(qv>0)
                {
                    StringBufferAdd("|r + |cff00ff00");
                    if(qv>=10){
                        StringBufferAdd(I2S(R2I(qv)));
                    }
                    else{
                        StringBufferAdd(R2SW(qv,1,1));
                    }
                }
                StringBufferAdd("|r\n");
            }
        }
        
        //StringBufferAdd(StarMapItemGetTips(wp));
        StringBufferAdd("|r\n");
        StringBufferAdd(YDWEGetItemDataString( typ, 3));
        return StringBufferLoad();
    }
    public function SGSS_ResetItemModel(item wp){
        integer itemLevel = LoadInteger(YDHT,GetHandleId(wp),0x00E04AE6);
        if(itemLevel<1)
            itemLevel = 1;
        if(itemLevel>6)
            itemLevel = 6;
        //SetItemModel(wp,SGSS_TypeStr[4000+itemLevel]);
    }
