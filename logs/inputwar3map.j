            call SaveUnitHandle(YDLOC, GetHandleId(ydl_timer), 0xDB988C32, LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xDB988C32))
            call TimerStart(ydl_timer, 1.00, false, function Trig_L______ResenFunc002Func008Func006Func004Func005Func006T)
        else
            call SaveLocationHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xC41A8F92, PolarProjectionBJ(LoadLocationHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xA1F2FC21), 300.00, (LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xB9A583B8))))
            call SetUnitPositionLocFacingBJ( LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xDB988C32), LoadLocationHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xC41A8F92), LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger()), 0x4C2AEFA3) )
            call SetUnitFacing( LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xDB988C32), (LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xB9A583B8)) )
            call RemoveLocation( LoadLocationHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xC41A8F92) )
