        {
            EC_steepsMax[effid] = R2I(EC_Distance[effid]/EC_Speed[effid]);
            //BJDebugMsg("Max=" + I2S(EC_steepsMax[effid]));
        }
        else
        {
            EC_steepsMax[effid] = R2I(EC_TimeMax[effid]/0.02); 
        }
        EC_steeps[effid] = 0;
    }
