                call QuestMessageBJ( GetPlayersAll(), bj_QUESTMESSAGE_ALWAYSHINT, "TRIGSTR_813" )
                call RemoveItemFromStockBJ( 'I0CT', GetSellingUnit() )
                call AddItemToStockBJ( 'I0CT', GetSellingUnit(), 1, 1 )
                call FlushChildHashtable(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step)
                set ydl_timer = null
