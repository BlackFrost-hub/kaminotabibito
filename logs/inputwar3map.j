//区块
public struct Block{
    static Block blocks[];
    static integer Count = 0 ;
    rect Rect;//所有区块
    SEffect List[2000];//区块内所有特效
    integer index;//计数
    real minx;
    real miny;
    real maxx;
    real maxy;
    //create 方法 ： 和rect一样
    static method create(real a,real b,real c, real d )->Block
    {
        Block bl = Block.allocate();
        //BJDebugMsg("run");
        bl.Rect = Rect(a,b,c,d);
        bl.index = 0;
        bl.minx = a;
        bl.miny = b;
        bl.maxx = c;
        bl.maxy = d;
        Block.blocks[Block.Count] = bl;
        Block.Count += 1;
        //BJDebugMsg("end");
        return bl;
    }
    //移除特效
    method remove(SEffect e){
        //移除对象
        this.List[this.index].id = e.id; //移动顶部数据的id到当前的id
this.List[e.id] = this.List[index];//移动顶部数据的对象到当前位置
        index -=1;//当前区块内成员数-+1
    }
    //添加特效
    method add(SEffect e){
        this.List[this.index] = e; // 为当前区块的List添加Effect对象
e.id = this.index;//更新Effect对象在当前区块的List中的ID
        this.index +=1;//当前区块内成员数量+1
    }
    //返回i位置的Effect
    method get(integer i)->SEffect
    {
        return this.List[i];
    }
    //返回用
    static Block blocks2[];
    static integer count2;
    //计算
    static method CheckOverlap(real radius, real x_center, real y_center, real x1, real y1, real x2, real y2)->boolean
    {
        real x, y;real dist_sq;
        if (x_center > x2) {
            x = x2;
        } else if (x_center < x1) {
            x = x1;
        } else {
            x = x_center;
        }
        if (y_center > y2) {
            y = y2;
        } else if (y_center < y1) {
            y = y1;
        } else {
            y = y_center;
        }
        dist_sq = (x - x_center) * (x - x_center) + (y - y_center) * (y - y_center);
        if (dist_sq <= radius * radius) {
            return true;
        }
        return false;
    }
    //计算所有在范围内的坐标 返回Block数组blocks2 与计数 count2
    static method GetInLoc(real x,real y,real r)
    {
        integer i = 0;
        Block this;
        count2 = 0;
        while(i>Block.Count)
        {
            this = Block.blocks[i];
            if(Block.CheckOverlap(r,x,y,this.minx,this.miny,this.maxx,this.maxy))
            {
                Block.blocks2[Block.count2] = this;
                Block.count2+=1;
            }
            i+=1;
        }
    }
//count2 !=0 的情况下遍历blocks2[0-count2].List[j] 得到Effect -> i = count2;j = 0- blocks2[0-count2].index 
}
