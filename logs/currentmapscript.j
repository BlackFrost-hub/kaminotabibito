        call SaveReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xFDF65382, ((GetUnitY(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xEFCC22B2)))+( ((200.00)*( SinBJ(LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0x2D345649)))))))
