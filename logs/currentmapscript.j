        call DestroyTimer(GetExpiredTimer())
    else
        call SaveReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xCEA5D211, ((LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xCEA5D211))+( 1.00)))
        call SaveLocationHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x2A829619, GetUnitLoc(LoadUnitHandle(YDHT, StringHash( "克劳德"), 0x8A89ED65)))
        call SaveLocationHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x8FA91502, PolarProjectionBJ(LoadLocationHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x2A829619), 15.00, LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0x8EF2E8DF)))
        if ((IsTerrainPathableBJ(LoadLocationHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x8FA91502), PATHING_TYPE_WALKABILITY) == true)) then
        else
            call SetUnitPositionLoc( LoadUnitHandle(YDHT, StringHash( "克劳德"), 0x8A89ED65), LoadLocationHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x8FA91502) )
        endif
        if ((LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xCEA5D211) >= 0.00) and (LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xCEA5D211) <= 10.00)) then
            call SetUnitFlyHeight( LoadUnitHandle(YDHT, StringHash( "克劳德"), 0x8A89ED65), ((GetUnitFlyHeight(LoadUnitHandle(YDHT, StringHash( "克劳德"), 0x8A89ED65)))+( 20.00)), 0.00 )
        else
            if ((LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xCEA5D211) >= 10.00) and (LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xCEA5D211) <= 20.00)) then
