    local timer ydl_timer
    local integer ydul_a
    // 最多射出6波弹幕
    if ((LoadInteger(YDLOC, GetHandleId(GetExpiredTimer()), 0x5B57EFD4) >= 6)) then
        set ydl_timer = CreateTimer()
        call SaveGroupHandle(YDLOC, GetHandleId(ydl_timer), 0x77A6CE7B, LoadGroupHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x77A6CE7B))
        call SaveGroupHandle(YDLOC, GetHandleId(ydl_timer), 0xB9747249, LoadGroupHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB9747249))
        call SaveUnitHandle(YDLOC, GetHandleId(ydl_timer), 0xE97D6160, LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xE97D6160))
        call TimerStart(ydl_timer, 0.50, false, function Trig_L______ResenFunc003Func002Func016Func002Func001T)
        call FlushChildHashtable(YDLOC, GetHandleId(GetExpiredTimer()))
        call DestroyTimer(GetExpiredTimer())
    else
        call SaveInteger(YDLOC, GetHandleId(GetExpiredTimer()), 0x5B57EFD4, ( LoadInteger(YDLOC, GetHandleId(GetExpiredTimer()), 0x5B57EFD4) + 1 ))
        set ydul_a = 1
        loop
            exitwhen ydul_a > 8
            call SaveUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB256ECE0, CreateUnit(GetOwningPlayer(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xE97D6160)), 'e07O', GetUnitX(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xE97D6160)), GetUnitY(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xE97D6160)), ( GetUnitFacing(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xE97D6160)) + ( 45.00 * I2R(ydul_a) ) )))
            // 设置弹幕的已飞行距离和最远飞行距离
            call SaveReal(YDHT, GetHandleId( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB256ECE0)), 0x6FC38F0F, 0.00)
            call SaveReal(YDHT, GetHandleId( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB256ECE0)), 0x694DB03E, ( 125.00 * I2R(LoadInteger(YDLOC, GetHandleId(GetExpiredTimer()), 0x5B57EFD4)) ))
            call GroupAddUnit( LoadGroupHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x77A6CE7B), LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB256ECE0) )
            set ydul_a = ydul_a + 1
        endloop
    endif
    set ydl_timer = null
endfunction
