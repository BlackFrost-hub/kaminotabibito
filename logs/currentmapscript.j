    function SGSS_SetUnitHPPercentum takes unit u,real r returns nothing
        local integer hd=GetHandleId(u)  //��ȡ�ٷֱȼӳ�ֵ
        local real pv=LoadReal(StarBaseHT,hd,StringHash("����ֵ�ٷֱȼӳ�"))  //0    0.15 //��ȡ�ٷֱ�������
        local real av=LoadReal(StarBaseHT,hd,StringHash("����ֵ�ٷֱȼӳ���ֵ"))  //0   108.75 //��������ֵ�仯 
        local real v=GetUnitState(u,UNIT_STATE_MAX_LIFE)-av  //�õ�ԭʼֵ  //725  833.750 - 108.75 = 725
        local real npv=pv+r  //�µİٷֱ�   //0+0.15=0.15  0.15+0 = 0.15 //�µļӳ�ֵ  //725*0.15 = 108.75 725*0.15 = 108.75
        local real nav=v*npv  // Print(R2S(pv)+","+R2S(npv));
        if (av==nav)then  // Print("�ٷֱ�:"+","+R2S(av)); // Print(R2S(v)+","+R2S(nav)); //ͬ�����򲻱� //������ֵ
            return
        endif
        call SGSS_SetUnitHP(u,-av)  //0.15 0.15 
        call SaveReal(StarBaseHT,hd,StringHash("����ֵ�ٷֱȼӳ�"),npv)  // 108.75 108.75
        call SaveReal(StarBaseHT,hd,StringHash("����ֵ�ٷֱȼӳ���ֵ"),nav)  //������ֵ
        call SGSS_SetUnitHP(u,nav)
    endfunction  //���ӵ�λ����ֵ �ٷֱ� //SUTL_GetHashCode 
