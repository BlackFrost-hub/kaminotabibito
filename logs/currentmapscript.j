//
// 常量字符串需要自己记忆，不确定就来这里对照一下
// 9=null
// 41  43  40  X  40 =『目标：XXXX』
// 59.5
// 59.8
//===========================================================================
function Trig_InitStringCache10_0SActions takes nothing returns nothing
    local integer ydul_I
    local integer ydul_N
    // 这个是最常用字符串，直接设置为0
    set udg_String[0] = "|cFFFFFF00『系统提示』：|r"
    set ydul_I = 0
    loop
        exitwhen ydul_I > 9
        set xgdg_yA[ydul_I] = I2S(ydul_I)
        set ydul_I = ydul_I + 1
    endloop
    set xgdg_CA[10] = "."
    set ydul_N = 0
    loop
        exitwhen ydul_N > 9
        call StringBufferAdd( xgdg_CA[10] )
        call StringBufferAdd( xgdg_yA[ydul_N] )
        set xgdg_CA[ydul_N] = StringBufferLoad()
        set ydul_N = ydul_N + 1
    endloop
    set udg_String[1] = GetPlayerName(Player(0))
    set udg_String[2] = GetPlayerName(Player(1))
