            call TriggerRegisterUnitEvent(gg_trg_______Boss____________TS, LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x944CCEB0), EVENT_UNIT_SPELL_CAST)
            call TriggerRegisterUnitEvent(gg_trg_______Boss002, LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x944CCEB0), EVENT_UNIT_SPELL_FINISH)
        else
        endif
        if ((GetUnitTypeId(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x944CCEB0)) == 'n049')) then
            call TriggerRegisterUnitEvent(gg_trg_______Boss003, LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xD3BB148E), EVENT_UNIT_SPELL_EFFECT)
        else
        endif
        if ((GetUnitTypeId(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x944CCEB0)) == 'O008')) then
            call TransmissionFromUnitWithNameBJ( GetPlayersAll(), null, "TRIGSTR_098", null, "TRIGSTR_099", bj_TIMETYPE_SET, 5.00, true )
            call TransmissionFromUnitWithNameBJ( GetPlayersAll(), null, GetUnitName(GetTriggerUnit()), null, "TRIGSTR_100", bj_TIMETYPE_SET, 2.00, true )
            call TransmissionFromUnitWithNameBJ( GetPlayersAll(), null, GetUnitName(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x944CCEB0)), null, "TRIGSTR_101", bj_TIMETYPE_SET, 2.00, true )
        else
        endif
        if ((GetUnitTypeId(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x944CCEB0)) == 'n011')) then
            call TriggerRegisterUnitEvent(gg_trg_______Boss002, LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x944CCEB0), EVENT_UNIT_SPELL_EFFECT)
            call TransmissionFromUnitWithNameBJ( GetPlayersAll(), LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x944CCEB0), GetUnitName(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x944CCEB0)), null, "TRIGSTR_102", bj_TIMETYPE_SET, 5.00, false )
        else
