//library StarDebugger:

    function StarDebugger___Print takes string text returns nothing
        call LogPut(text)
    endfunction
    function SDR_DebugTimer takes timer t,real time,boolean isloop,string Target,string trig returns nothing
        call SaveTimerHandle(StarDebugger___ht,SDR_Index,0,t)
        call SaveInteger(StarDebugger___ht,GetHandleId(t),0,SDR_Index)
        call SaveReal(StarDebugger___ht,GetHandleId(t),1,time)
        call SaveBoolean(StarDebugger___ht,GetHandleId(t),2,isloop)
        call SaveStr(StarDebugger___ht,GetHandleId(t),3,Target)
        call SaveStr(StarDebugger___ht,GetHandleId(t),4,trig)
        set SDR_Index=SDR_Index+1
    endfunction
    function SDR_ExTimerStart takes timer t,real time,boolean isloop,code c,string str returns nothing
        call TimerStart(t,time,isloop,c)
        call SDR_DebugTimer(t,time,isloop,str,"")
    endfunction  // public function SDR_DebugTimer2(timer t,real time,boolean isloop,string Target,code c){
    function SDR_DebugTimer_Remove takes timer t returns nothing  //     SaveTimerHandle(ht,SDR_Index,0,t); //     SaveInteger(ht,GetHandleId(t),0,SDR_Index); //     SaveReal(ht,GetHandleId(t),1,time); //     SaveBoolean(ht,GetHandleId(t),2,isloop); //     SaveStr(ht,GetHandleId(t),3,Target); //     TimerStart(t,time,isloop,c); //     SDR_Index+=1; // }
        local integer id
        local timer tr
        if (HaveSavedInteger(StarDebugger___ht,GetHandleId(t),0))then
            set id=LoadInteger(StarDebugger___ht,GetHandleId(t),0)
            if (id!=(SDR_Index-1))then
                set tr=LoadTimerHandle(StarDebugger___ht,SDR_Index-1,0)  //交换数据
                call SaveTimerHandle(StarDebugger___ht,id,0,tr)
                call SaveInteger(StarDebugger___ht,GetHandleId(tr),0,id)  //清除旧计时器引用
                call FlushChildHashtable(StarDebugger___ht,GetHandleId(t))
            endif
            set SDR_Index=SDR_Index-1
        endif
        set tr=null
    endfunction
    function StarDebugger___SDR_B2I takes boolean b returns string
        if (b)then
            return "循环"
        else
            return "不循环"
        endif
    endfunction
    function SDR_Print takes nothing returns nothing
        local integer i=0
        local integer j=0
        local timer t
        call StarDebugger___Print("==========逆天计时器引用检查==========")
        loop
        exitwhen (i>=SDR_Index)
            set t=LoadTimerHandle(StarDebugger___ht,i,0)
            if (t!=null)then
                call StarDebugger___Print("计时器句柄:"+I2S(GetHandleId(t))+"，周期:"+R2S(LoadReal(StarDebugger___ht,GetHandleId(t),1))+"，"+StarDebugger___SDR_B2I(LoadBoolean(StarDebugger___ht,GetHandleId(t),2))+"，回调函数:"+LoadStr(StarDebugger___ht,GetHandleId(t),3)+",在触发器:"+LoadStr(StarDebugger___ht,GetHandleId(t),4))
                set j=j+1
            endif
            set i=i+1
        endloop
        call StarDebugger___Print("逆天计时器数量："+I2S(j))
        set t=null
        call StarDebugger___Print("==============The  End===============")
    endfunction
    function StarDebugger___onInit takes nothing returns nothing
        set SDR_HT=StarDebugger___ht
    endfunction

//library StarDebugger ends
//library StarFastBuff:

    function StarFastBuff__getAngleBetweenUnits takes unit u,unit tu returns real
        return Math.GAFC(GetUnitX(u),GetUnitY(u),GetUnitX(tu),GetUnitY(tu))
    endfunction
    function StarFastBuff__onInit takes nothing returns nothing
        set SFB_AblList[0]='ASB0'
        set SFB_AblOrderList[0]="thunderbolt"
        set SFB_AblList[1]='ASB4'
        set SFB_AblOrderList[1]="creepthunderbolt"
        set SFB_AblList[2]='ASB8'
        set SFB_AblOrderList[2]="silence"
        set SFB_AblList[3]='ASBy'
        set SFB_AblOrderList[3]="polymorph"
        set SFB_AblList[4]='ASBX'
        set SFB_AblOrderList[4]="invisibility"
        set SFB_AblList[5]='ASB8'
        set SFB_AblOrderList[5]="silence"
        set SFB_AblList[6]='ASB9'
        set SFB_AblIOrderList[6]=852075  //TODO嗜血术
        set SFB_AblList[7]='ASB9'
        set SFB_AblIOrderList[7]=852075  //TODO驱散
        set SFB_AblList[8]='ASB9'
        set SFB_AblIOrderList[8]=852075
    endfunction  // //设置自定义buff 目标单位 技能id 持续时间
        function StarFastBuff__anon__0 takes nothing returns nothing  //读取韧性 //硬直 //暂停 //解除暂停
            set StarFastBuff__tempTimer=GetExpiredTimer()
            call PauseUnit(LoadUnitHandle(YDHT,GetHandleId(StarFastBuff__tempTimer),0x62274AD0),false)
            call RemoveSavedHandle(YDHT,GetHandleId(StarFastBuff__tempTimer),0x62274AD0)
            call DestroyTimer(StarFastBuff__tempTimer)
            set StarFastBuff__tempTimer=null
        endfunction
        function StarFastBuff__anon__1 takes nothing returns nothing  // //解除眩晕
            set StarFastBuff__tempTimer=GetExpiredTimer()
            call EXPauseUnit(LoadUnitHandle(YDHT,GetHandleId(StarFastBuff__tempTimer),0x62274AD0),false)
            call RemoveSavedHandle(YDHT,GetHandleId(StarFastBuff__tempTimer),0x62274AD0)
            call DestroyTimer(StarFastBuff__tempTimer)
            set StarFastBuff__tempTimer=null
        endfunction
    function SFB_setBuff takes unit u,integer id,real time returns nothing
        local integer rx=LoadInteger(YDHT,GetHandleId(u),StarFastBuff__key_rx)
        if (id!=5)then
            if (rx>100)then
                set rx=100
            endif
            if (rx!=0)then
                set time=time*(100-rx)/100
            endif
        endif
        if (time==0 or IsUnitType(u,UNIT_TYPE_STRUCTURE) or u==SFB_Unit)then
            return
        endif
        if (id>=21)then
            if (id==21)then
                call GS_Suspend(u,time)
            elseif (id==22)then
                set StarFastBuff__tempTimer=CreateTimer()
                call SaveUnitHandle(YDHT,GetHandleId(StarFastBuff__tempTimer),0x62274AD0,u)
                call PauseUnit(u,true)
                call TimerStart(StarFastBuff__tempTimer,time,false,function StarFastBuff__anon__0)
                set StarFastBuff__tempTimer=null
            elseif (id==23)then
                set StarFastBuff__tempTimer=CreateTimer()
                call SaveUnitHandle(YDHT,GetHandleId(StarFastBuff__tempTimer),0x62274AD0,u)
                call EXPauseUnit(u,true)
                call TimerStart(StarFastBuff__tempTimer,time,false,function StarFastBuff__anon__1)
                set StarFastBuff__tempTimer=null
            endif
        else
            set StarFastBuff__fac=StarFastBuff__getAngleBetweenUnits(SFB_Unit,u)
            call EXSetUnitFacing(SFB_Unit,StarFastBuff__fac)
            call SetUnitFacing(SFB_Unit,StarFastBuff__fac)
            if (id==2)then
                call YDWESetUnitAbilityDataReal(SFB_Unit,SFB_AblList[id],1,108,8)
            elseif (id==5)then
                call YDWESetUnitAbilityDataReal(SFB_Unit,SFB_AblList[id],1,108,7)
            endif
            call YDWESetUnitAbilityDataReal(SFB_Unit,SFB_AblList[id],1,102,time)
            call YDWESetUnitAbilityDataReal(SFB_Unit,SFB_AblList[id],1,103,time)
            call IssueTargetOrder(SFB_Unit,SFB_AblOrderList[id],u)
        endif
    endfunction  //设置单位减速 目标 降低攻速百分比  降低移速百分比  持续时间
    function SFB_setSlow takes unit u,real as,real ms,real time returns nothing
        local integer rx=LoadInteger(YDHT,GetHandleId(u),StarFastBuff__key_rx)
        local real StarFastBuff__fac  //读取韧性
        if (rx>100)then
            set rx=100
        endif
        if (rx!=0)then
            set time=time*(100-rx)/100
        endif
        if (time==0 or IsUnitType(u,UNIT_TYPE_STRUCTURE) or u==SFB_Unit)then
            return
        endif
        set StarFastBuff__fac=StarFastBuff__getAngleBetweenUnits(SFB_Unit,u)
        call EXSetUnitFacing(SFB_Unit,StarFastBuff__fac)
        call SetUnitFacing(SFB_Unit,StarFastBuff__fac)
        call YDWESetUnitAbilityDataReal(SFB_Unit,'ASB9',1,108,ms)
        call YDWESetUnitAbilityDataReal(SFB_Unit,'ASB9',1,109,as)
        call YDWESetUnitAbilityDataReal(SFB_Unit,'ASB9',1,102,time)
        call YDWESetUnitAbilityDataReal(SFB_Unit,'ASB9',1,103,time)
        call IssueTargetOrderById(SFB_Unit,852075,u)  // if(ms<0){
    endfunction  //     YDWESetUnitAbilityDataString( u, 'Bslo', 1, 213, "该单位被加速了" ) //     YDWESetUnitAbilityDataString( u, 'Bslo', 1, 212, "加速" ) // }

//library StarFastBuff ends
//library StarFastEffect:
    function SFE_Square2 takes real x,real y,real width,real long,real fac,real time returns nothing  //快速创建一个矩形提示框在x,y 它的宽为w,它的长为l,朝向fac 存在时间 time
        local effect e
        local real sw
        local real sl
        local real s
        local real d
        local real dis
        if (width>1500)then
            set width=1500
        endif
        set sw=width/1000
        if (long>7500)then
            set long=7500
        endif
        set d=fac-0
        set dis=long/2
        set x=x+CosBJ(d)*dis
        set y=y+SinBJ(d)*dis
        if (long/width<=4.00)then
            set e=AddSpecialEffect("Tip\\Abiltip_Square4x.mdx",x,y)
            set sl=long/4000
        elseif (long/width<=5.00)then
            set e=AddSpecialEffect("Tip\\Abiltip_Square2x.mdx",x,y)
            set sl=long/4000
        else
            set sl=long/4000
            set e=AddSpecialEffect("Tip\\Abiltip_Square3x.mdx",x,y)
        endif
        if (time<=0)then
            set s=1
            call YDWETimerDestroyEffect(1,e)
        else
            set s=1/time
            call YDWETimerDestroyEffect(time+0.5,e)
        endif
        call EXEffectMatRotateZ(e,fac+270)
        call EXSetEffectSpeed(e,s)
        call EXEffectMatScale(e,sl,sw,1.00)
        set e=null
    endfunction
    function SFE_Square takes real x,real y,real width,real long,real fac,real time returns nothing
        local effect e
        local real sw
        local real sl
        local real s
        local real d
        local real dis
        if (width>1500)then
            set width=1500
        endif
        set sw=width/1000
        if (long>7500)then  //d = fac - 180;
            set long=7500
        endif
        set dis=long/2
        set x=x+CosBJ(fac)*dis
        set y=y+SinBJ(fac)*dis
        if (long/width<=1.00)then
            set e=AddSpecialEffect("Tip\\Abiltip_Square1x.mdx",x,y)
            set sl=long/1000
        elseif (long/width<=2.00)then
            set e=AddSpecialEffect("Tip\\Abiltip_Square2x.mdx",x,y)
            set sl=long/2000
        elseif (long/width<=3.00)then
            set e=AddSpecialEffect("Tip\\Abiltip_Square3x.mdx",x,y)
            set sl=long/3000
        elseif (long/width<=4.00)then
            set e=AddSpecialEffect("Tip\\Abiltip_Square4x.mdx",x,y)
            set sl=long/4000
        elseif (long/width<=5.00)then
            set e=AddSpecialEffect("Tip\\Abiltip_Square5x.mdx",x,y)
            set sl=long/5000
        elseif (long/width<=6.00)then
            set sl=long/6000
            set e=AddSpecialEffect("Tip\\Abiltip_Square6x.mdx",x,y)
        endif
        if (time<=0)then
            set s=1
            call YDWETimerDestroyEffect(1,e)
        else
            set s=1/time
            call YDWETimerDestroyEffect(time+0.5,e)
        endif
        call EXEffectMatRotateZ(e,fac+270)
        call EXEffectMatScale(e,sl,sw,1.00)
        call EXSetEffectSpeed(e,s)
        set e=null
    endfunction  //快速创建黄色扇形提示圈 在(x,y) 方向fac, 大小size, 持续时间 time
    function SFE_Square3 takes real x,real y,real fac,real size,real time returns nothing
        local effect e
        set x=x+CosBJ(fac)*10
        set y=y+SinBJ(fac)*10
        set e=AddSpecialEffect("Tip\\AbilTipSX.mdx",x,y)
        call DzSetEffectVertexColor(e,DzGetColor2(255,255,255,0))
        if (time<=0)then
            call YDWETimerDestroyEffect(0.5,e)
        else
            call YDWETimerDestroyEffect(time+0.1,e)
        endif
        call EXEffectMatRotateZ(e,fac)
        call EXSetEffectSize(e,size)
        set e=null
    endfunction  //快速创建红色扇形提示圈 在(x,y) 方向fac, 大小size, 持续时间 time
    function SFE_Square4 takes real x,real y,real fac,real size,real time returns nothing
        local effect e
        set x=x+CosBJ(fac)*10
        set y=y+SinBJ(fac)*10
        set e=AddSpecialEffect("Tip\\AbilTipSX.mdx",x,y)
        call DzSetEffectVertexColor(e,DzGetColor2(255,255,0,0))
        if (time<=0)then
            call YDWETimerDestroyEffect(0.5,e)
        else
            call YDWETimerDestroyEffect(time+0.1,e)
        endif
        call EXEffectMatRotateZ(e,fac)
        call EXSetEffectSize(e,size)
        set e=null
    endfunction  //快速创建红色圆形提示圈 在(x,y) 半径r，持续时间 time
    function SFE_Circle takes real x,real y,real r,real time returns nothing
        local effect e
        local real size=r/200
        local real s
        set e=AddSpecialEffect("Tip\\Abiltip_ring.mdx",x,y)
        if (time<=0)then
            set s=1
            call YDWETimerDestroyEffect(1,e)
        else
            set s=1/time
            call YDWETimerDestroyEffect(time+0.5,e)
        endif
        call EXSetEffectSpeed(e,s)
        call EXSetEffectSize(e,size)
        set e=null
    endfunction  //快速创建白色圆形提示圈 在(x,y) 半径r，持续时间 time
    function SFE_Circle2 takes real x,real y,real r,real time returns nothing
        local effect e
        local real size=r/200
        local real s
        set e=AddSpecialEffect("Tip\\Tip_ring_A.mdx",x,y)
        call DzSetEffectAnimation(e,0,0)
        if (time<=0)then
            set s=1
            call YDWETimerDestroyEffect(1,e)
        else
            set s=1/time
            call YDWETimerDestroyEffect(time+0.5,e)
        endif
        call EXSetEffectSpeed(e,s)
        call EXSetEffectSize(e,size)
        call EXSetEffectSpeed(e,1.00)
        set e=null
    endfunction  //快速创建由绿到黄到红的渐变圆形提示圈 在(x,y) 半径r，持续时间 time
    function SFE_Circle3 takes real x,real y,real r,real time returns nothing
        local effect e
        local real size=r/200
        local real s
        set e=AddSpecialEffect("Tip\\Tip_ring_B.mdx",x,y)
        call DzSetEffectAnimation(e,1,0)
        if (time<=0)then
            set s=1
            call YDWETimerDestroyEffect(0.1,e)
        else
            set s=1/time
            call YDWETimerDestroyEffect(time-0.5,e)
        endif
        call EXSetEffectSpeed(e,s)
        call EXSetEffectSize(e,size)
        call EXSetEffectSpeed(e,1.00)
        set e=null
    endfunction

//library StarFastEffect ends
//library StarIntPool:
    //public:
        function SIP_RemovePool takes integer pool returns nothing  //删除整数池
            local StarTable table=pool-StarIntPool__movebase
            call table.destroy()
        endfunction
        function SIP_CreatePool takes nothing returns integer  //新建整数池
            local StarTable table=StarTable.create()  //计数器
            call table.SaveInt(-1024,0)
            return table+StarIntPool__movebase
        endfunction  //检查是否在整数池中 返回ID -1等于不存在
        function SIP_IsInPool takes integer pool,integer str returns integer
            local StarTable table=pool-StarIntPool__movebase
            local integer count=table.LoadInt(-1024)
            local integer i=0
            loop
            exitwhen (i>=count)
                if (table.LoadInt(i)==str)then
                    return i
                endif
                set i=i+1
            endloop
            return -1
        endfunction  //判断整数池是否为空
        function SIP_IsEmpty takes integer pool returns boolean
            local StarTable table=pool-StarIntPool__movebase
            local integer count=table.LoadInt(-1024)
            return count==0
        endfunction  //整数池添加 整数 比重为?
        function SIP_PoolAddInteger takes integer pool,integer str,real v returns nothing
            local StarTable table=pool-StarIntPool__movebase
            local integer count=table.LoadInt(-1024)
            call table.SaveInt(count,str)
            call table.SaveReal(count+10000,v)
            set count=count+1
            call table.SaveInt(-1024,count)
        endfunction  //整数池删除 整数
        function SIP_PoolRemoveInteger takes integer pool,integer str returns nothing
            local StarTable table=pool-StarIntPool__movebase  //顶计数
            local integer count=table.LoadInt(-1024)  //整数所在位置
            local integer i=SIP_IsInPool(pool,str)
            if (i!=-1)then
                set count=count-1  //把顶部数据移动过来 //重新存名字  
                call table.SaveInt(i,table.LoadInt(count))  //重新存ID
                call table.SaveReal(i+10000,table.LoadReal(count+10000))
                call table.SaveInt(-1024,count)
            endif
        endfunction  //整数池 读取 整数
        function SIP_PoolGetInteger takes integer pool returns integer
            local StarTable table=pool-StarIntPool__movebase
            local integer count=table.LoadInt(-1024)
            local integer i=0
            local integer cb=-1
            local real all=0
            local real r
            local real  array ary
            loop
            exitwhen (i>=count)
                set ary[i]=table.LoadReal(i+10000)
                set all=all+ary[i]
                set i=i+1
            endloop
            if (all>0)then
                set r=GetRandomReal(0,all)
                set i=0
                set all=0
                loop
                exitwhen (i>=count)
                    set all=all+ary[i]
                    if (r<=all)then
                        set cb=table.LoadInt(i)
                        return cb
                    endif
                    set i=i+1
                endloop
            endif
            return 0
        endfunction  //从整数池 中 获取整数 并移除 整数
        function SIP_GetIntAndRemove takes integer pool returns integer
            local integer v=SIP_PoolGetInteger(pool)
            call SIP_PoolRemoveInteger(pool,v)
            return v
        endfunction

