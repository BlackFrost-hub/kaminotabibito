function Trig_111________________uActions takes nothing returns nothing
    local timer ydl_timer
    local trigger ydl_trigger
    local integer ydl_localvar_step = LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xCFDE6C76) 
 set ydl_localvar_step = ydl_localvar_step + 3 
 call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xCFDE6C76, ydl_localvar_step) 
 call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7, ydl_localvar_step)
    if ((IsUnitRace(GetSpellTargetUnit(), RACE_HUMAN) == true) and (IsUnitOwnedByPlayer(GetSpellTargetUnit(), Player(PLAYER_NEUTRAL_PASSIVE)) == true) and (GetSpellAbilityId() == 'A0EQ') and (IsUnitInGroup(GetTriggerUnit(), LoadGroupHandle(YDHT, StringHash( "玩家英雄"), 0x0A4A1F64)) == true)) then
        call SaveUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xD84480C3, GetSpellTargetUnit())
        call SaveUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x310EFEF8, GetTriggerUnit())
        if ((GetUnitState(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xD84480C3), UNIT_STATE_MAX_LIFE) == 420.00) and ((GetUnitTypeId(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xD84480C3)) == 'hhes') or (GetUnitTypeId(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xD84480C3)) == 'n01D'))) then
            // 基础设置
            call SaveRectHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x6CC68D63, gg_rct______________056)
            call SaveUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x5F43D115, LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xD84480C3))
            call SaveUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x310EFEF8, GetTriggerUnit())
            call SetUnitState( LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x5F43D115), UNIT_STATE_MAX_LIFE, 9999.00 )
            call SetUnitLifePercentBJ( LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x5F43D115), 100 )
            call SaveBoolean(YDHT, StringHash( "决斗状态"), 0xEFAD0956, true)
            // 剧情对话
            if ((GetUnitTypeId(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xD84480C3)) == 'hhes')) then
