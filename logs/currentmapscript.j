            call DisplayTimedTextToPlayer(GetLocalPlayer(),0,0,60,I2S(i))
        endfunction
        function printr takes real r returns nothing
            call DisplayTimedTextToPlayer(GetLocalPlayer(),0,0,60,R2S(r))
        endfunction
        function printsi takes string s,integer i returns nothing
            call DisplayTimedTextToPlayer(GetLocalPlayer(),0,0,60,s+I2S(i))
        endfunction
        function printsr takes string s,real i returns nothing
            call DisplayTimedTextToPlayer(GetLocalPlayer(),0,0,60,s+R2S(i))
        endfunction
        function printb takes string s,boolean b returns nothing
            if (b)then
                call DisplayTimedTextToPlayer(GetLocalPlayer(),0,0,60,s+"真")
            else
                call DisplayTimedTextToPlayer(GetLocalPlayer(),0,0,60,s+"假")
            endif
        endfunction
    //private:
        function StarCommon___getRandomInt takes integer low,integer high returns integer
            return GetRandomInt(low,high)
        endfunction
        function StarCommon___getRandomReal takes real low,real high returns real
            return GetRandomReal(low,high)
        endfunction
        function StarCommon___sin takes real r returns real
            return Sin(r)
        endfunction
        function StarCommon___cos takes real r returns real
            return Cos(r)
        endfunction
        function StarCommon___tan takes real r returns real
            return Tan(r)
        endfunction
        function StarCommon___asin takes real r returns real
            return Asin(r)
        endfunction
        function StarCommon___acos takes real r returns real
            return Acos(r)
        endfunction
        function StarCommon___atan takes real r returns real
            return Atan(r)
        endfunction
        function StarCommon___atan2 takes real y,real x returns real
            return Atan2(y,x)
        endfunction
    struct Math 
    //! pragma implicitthis
        static constant integer MaxInt=2147483647
        static constant integer MinInt=-2147483648
        static constant real Tolerance=0.000001  //3.14159265358979323846
        static constant real PI=3.1415927  //2.71828182845904523536
        static constant real E=2.7182818
        static method operator Random takes nothing returns real
            return GetRandomReal(0.0,1.0)
        endmethod
        static method GetRandomReal takes real low,real high returns real
            return StarCommon___getRandomReal(low,high)
        endmethod
        static method GetRandomInt takes integer low,integer high returns integer
            return StarCommon___getRandomInt(low,high)
        endmethod
        static method Sign takes real r returns real
            if (r<0)then
                return -1.0
            endif
            if (r>0)then
                return 1.0
            endif
            return 0.0
        endmethod
        static method ISign takes integer r returns integer  //textmacro instance: Common_Math_Template ("real", "")
            if (r<0)then
                return -1
            endif
            if (r>0)then
                return 1
            endif
            return 0
        endmethod
        static method Abs takes real r returns real
            if (r<0)then
                return -r
            endif
            return r
        endmethod
        static method Min takes real a,real b returns real
            if (a>b)then
                return b
            endif
            return a
        endmethod
        static method Max takes real a,real b returns real
            if (a<b)then
                return b
            endif
            return a
        endmethod
        static method Clamp takes real value,real low,real high returns real
            local real temp=high
            if (low>high)then
                set high=low
                set low=temp
            endif
            return Math.Min(Math.Max(value,low),high)
        endmethod  //end of: Common_Math_Template ("real", "")
        static method IAbs takes integer r returns integer  //textmacro instance: Common_Math_Template ("integer", "I")
            if (r<0)then
                return -r
            endif
            return r
        endmethod
        static method IMin takes integer a,integer b returns integer
            if (a>b)then
                return b
            endif
            return a
        endmethod
        static method IMax takes integer a,integer b returns integer
            if (a<b)then
                return b
            endif
            return a
        endmethod
        static method IClamp takes integer value,integer low,integer high returns integer
            local integer temp=high
            if (low>high)then
                set high=low
                set low=temp
            endif
            return Math.IMin(Math.IMax(value,low),high)
        endmethod  //end of: Common_Math_Template ("integer", "I")
        static method Equals takes real a,real b,real tolerance returns boolean  // 0== 0.0009(true), 0== 0.001(false)
            return a+tolerance>=b and a-tolerance<=b
        endmethod
        static method IsZero takes real r returns boolean  // 0!= 0.0009(true), 0!= 0.000...1(true)
            return r>=-Math.Tolerance and r<=Math.Tolerance
        endmethod
        static method ToRadians takes real degrees returns real
            return degrees/180.0*Math.PI
        endmethod
        static method ToDegrees takes real radians returns real
            return radians*180.0/Math.PI
        endmethod
        static method GetRandomRealEx takes real min,real max returns real
            local real r
            if (GetRandomInt(1,100)<50)then
                set r=GetRandomReal(min,max)
            else
                set r=GetRandomReal(min,max)*-1
            endif
            return r
        endmethod  //坐标间距�?
        static method GDBC takes real x1,real y1,real x2,real y2 returns real
            return SquareRoot((y1-y2)*(y1-y2)+(x1-x2)*(x1-x2))
        endmethod
        static method GetDistanceOfXY takes real x1,real y1,real x2,real y2 returns real
            return SquareRoot((y1-y2)*(y1-y2)+(x1-x2)*(x1-x2))
        endmethod  //两坐标相距距离少于r
        static method LocInRange takes real x1,real y1,real x2,real y2,real r returns boolean
            return ((y1-y2)*(y1-y2)+(x1-x2)*(x1-x2))<(r*r)
        endmethod  //两坐标相距距离少于r 省略乘法
        static method LocInRange2 takes real x1,real y1,real x2,real y2,real r returns boolean
            return ((y1-y2)*(y1-y2)+(x1-x2)*(x1-x2))<r
        endmethod  ///坐标间角�?
        static method GAFC takes real x1,real y1,real x2,real y2 returns real
            return Rad2Deg(Atan2(y2-y1,x2-x1))
        endmethod  //单位间角�?
        static method getAngleBetweenUnits takes unit u,unit tu returns real
            return GAFC(GetUnitX(u),GetUnitY(u),GetUnitX(tu),GetUnitY(tu))
        endmethod  //两点间角�?
        static method Bessel2 takes real t,real mid,real st,real tt returns real  // static method getAngleBetweenLoc(location u,location tu)->real // { //     return GAFC(GetUnitX(u),GetUnitY(u),GetUnitX(tu),GetUnitY(tu)); // } //贝塞�?二阶 通用 t 中点 起点 终点
            return (t*t*tt+2*t*(1-t)*mid+(1-t)*(1-t)*st)
        endmethod  //贝塞�?二阶 通用 t 起点 终点 中点
        static method Bessel2_2 takes real t,real a,real b,real c returns real
            return a*(1-t)*(1-t)+c*2*(1-t)*t+b*t*t
        endmethod  //贝塞�?二阶 通用 t 起点 中点 终点 
        static method Bessel2_3 takes real t,real a,real c,real b returns real
            return a*(1-t)*(1-t)+c*2*(1-t)*t+b*t*t
        endmethod  //计算俯仰�?
        static method CalcRotateY takes real a,real b,real c,real x,real y,real z returns real
            return Atan2BJ(c-z,Math.GDBC(a,b,x,y))
        endmethod  //抛物�?t 最大高�?基础高度偏移
        static method Parabola takes real t,real Max,real base returns real
            return (-(2*(t)-1)*(2*(t)-1)+1)*Max+base
        endmethod  //角度处理(any)->[0,360] ------- 在角度差较大的情况下也许可以直接用模运算
        static method AngleConversion takes real a returns real
            loop
            exitwhen ((a>=0 and a<=360))
                if (a>=360)then
                    set a=a-360
                else
                    set a=a+360
                endif
            endloop
            return a
        endmethod  //角度处理(-360~720)->[0,360]
        static method AngleConversion2 takes real a returns real
            if (a>=360)then
                set a=a-360
            else
                set a=a+360
            endif
            return a
        endmethod  //平滑追踪角度公式 (起点x,y 终点dx,dy)
        static method GetTrackAngle takes real x,real y,real dx,real dy returns real
            return bj_RADTODEG*Atan2(dy-y,dx-x)
        endmethod  //平滑从a到b 使用t
        static method SmoothZ2Z takes real t,real a,real b returns real
            return a*(1-t)+b*t
        endmethod
        static method GetRotationAngle takes real d,real d1,real d2 returns real  //获取d向d1方向旋转后的角度(最大旋转角度为d2)
            local real d3=Math.AngleConversion(d1-d)  //Math.Modulo(d1-d,360);
            if (Cos(d3)*bj_RADTODEG>Cos(d2)*bj_RADTODEG)then
                set d=d1
            elseif (d3<=180)then
                set d=d+d3
            else
                set d=d-d3
            endif
            return d
        endmethod  //移动X坐标 方向 距离
        static method MoveX takes real x,real d,real dis returns real
            return x+CosBJ(d)*dis
        endmethod  //移动Y坐标 方向 距离
        static method MoveY takes real y,real d,real dis returns real
            return y+SinBJ(d)*dis
        endmethod  //抛物�?-跳跃--参数
        static method GetJumpHeight takes integer steeps,real steepsMax,real heightMax,real fly returns real
            local real dheig=1.0/steepsMax
            return (-(2*I2R(steeps)*dheig-1)*(2*I2R(steeps)*dheig-1)+1)*heightMax+fly
        endmethod
        static method Sin takes real r returns real
            return StarCommon___sin(r)
        endmethod
        static method Cos takes real r returns real
            return StarCommon___cos(r)
        endmethod
        static method Tan takes real r returns real
            return StarCommon___tan(r)
        endmethod
        static method Asin takes real r returns real
            return StarCommon___asin(r)
        endmethod
        static method Acos takes real r returns real
            return StarCommon___acos(r)
        endmethod
        static method Atan takes real r returns real
            return StarCommon___atan(r)
        endmethod
        static method Atan2 takes real y,real x returns real  //  Hyperbolic sine, cosine, tangent
            return StarCommon___atan2(y,x)
        endmethod
        static method Sinh takes real y returns real
            return (Math.Exp(y)-Math.Exp(-y))/2.0
        endmethod
        static method Cosh takes real x returns real
            return (Math.Exp(x)+Math.Exp(-x))/2.0
        endmethod
        static method Tanh takes real r returns real
            return (Math.Exp(r)-Math.Exp(-r))/(Math.Exp(r)+Math.Exp(-r))
        endmethod
        static method Ceil takes real r returns real
            local real i=I2R(R2I(r))
            if (Math.Modulo(r,1.0)>0.0)then
                return i+1.0
            endif
            return i
        endmethod
        static method Floor takes real r returns real
            return I2R(R2I(r))
        endmethod
        static method Round takes real r returns real
            local real i=I2R(R2I(r))
            if (Math.Modulo(r,1.0)>=0.5)then
                return i+1.0
            endif
            return i
        endmethod
        static method Sqr takes real r returns real
            return r*r
        endmethod
        static method Sqrt takes real r returns real
            return SquareRoot(r)
        endmethod
        static method InvSqrt takes real r returns real
            if ((r==0))then
                return 0.0
            endif
            return 1.0/SquareRoot(r)
        endmethod
        static method Cbr takes real r returns real
            return r*r*r
        endmethod
        static method Cbrt takes real r returns real
            return Math.Power(r,0.333333)
        endmethod
        static method InvCbrt takes real r returns real
            if ((r==0))then
                return 0.0
            endif
            return 1.0/Math.Power(r,0.333333)
        endmethod
        static method Power takes real a,real power returns real
            return Pow(a,power)
        endmethod
        static method Exp takes real power returns real
            return Pow(Math.E,power)
        endmethod
        static method Log takes real r,real a returns real
            return Math.Ln(r)/Math.Ln(a)
        endmethod
        static method Lg takes real r returns real
            return Math.Ln(r)/Math.Ln(10.0)
        endmethod
        static method Hypot takes real x,real y returns real  //  if (the dividend was negative, the below modulus calculation will be negative, but within (-divisor~0).
            return SquareRoot(x*x+y*y)
        endmethod
        static method Modulo takes real dividend,real divisor returns real  //  We can add (divisor) to shift this result into the desired range of (0~divisor).
            local real modulus=dividend-I2R(R2I(dividend/divisor))*divisor
            if (modulus<0)then
                set modulus=modulus+divisor
            endif
            return modulus
        endmethod
        static method IModulo takes integer dividend,integer divisor returns integer
            local integer modulus=dividend-dividend/divisor*divisor
            if (modulus<0)then
                set modulus=modulus+divisor
            endif
            return modulus
        endmethod  // )->the value that is closest in value to the argument &&  is equal to a mathematical integer.
        static method Rint takes real r returns real  //  if (two values that are integers are equally close, the result is the integer value that is even.
            local real i=I2R(R2I(r))
            local real modulo=Math.Modulo(r,1.0)
            if (modulo>0.5 or (modulo==0.5 and Math.Modulo(i,2.0)!=0.0))then
                return i+1.0
            endif
            return i
        endmethod  //  Computes the remainder operation on two arguments as prescribed by the IEEE 754 standard.
        static method IEEERemainder takes real dividend,real divisor returns real  //  The IEEERemainder method is not the same as the modulus operator.
            return dividend-divisor*Math.Round(dividend/divisor)
        endmethod  //  Uses Taylor series
        static method Ln takes real r returns real
            local real sum=0.0  // Math.Sqrt(Math.E)== 1.64872127070012814685;
            local real e=1.648721
            local real b=0.0
            loop
            exitwhen (r<Math.E)
                set r=r/Math.E
                set sum=sum+1.0
            endloop
            if (r>=e)then
                set r=r/e
                set sum=sum+0.5
            endif
            set e=1.0
            set r=r-1.0
            set b=r
            loop
            exitwhen (e>5.0)
                set sum=sum+r/e
                set e=e+1.0
                set r=r*b*(-1.0)
            endloop
            return sum
        endmethod
    endstruct
//! no confliction!
    function StarCommon___subString takes string source,integer start,integer end returns string
        return SubString(source,start,end)
    endfunction
    struct StringUtil 
    //! pragma implicitthis
        static method Render takes string str,Argb color returns string
            return "|c"+color.ToString()+str+"|r"
        endmethod
        static method HashCode takes string str returns integer
            return StringHash(str)
        endmethod
        static method Length takes string str returns integer
            return StringLength(str)
        endmethod
        static method Contains takes string str,string pattern returns boolean
            return StringUtil.IndexOf(str,pattern)!=-1
        endmethod
        static method StartsWith takes string str,string pattern returns boolean
            local integer thisLen=StringLength(str)
            local integer patternLen=StringLength(pattern)
            if (thisLen<patternLen or patternLen==0)then
                return false
            endif
            return StarCommon___subString(str,0,patternLen)==pattern
        endmethod
        static method EndsWith takes string str,string pattern returns boolean
            local integer thisLen=StringLength(str)
            local integer patternLen=StringLength(pattern)
            if (thisLen<patternLen or patternLen==0)then
                return false
            endif
            return StarCommon___subString(str,thisLen-patternLen,thisLen)==pattern
        endmethod
        static method Compare takes string str,string str2 returns integer
            local integer strLen=StringLength(str)
            local integer strLen2=StringLength(str2)
            local integer minLen=IMinBJ(strLen,strLen2)
            local integer i=0
            local integer char=0
            local integer char2=0
            if (str==str2)then
                return 0
            endif
            set i=0
            loop
            exitwhen (i>=minLen)
                set char=Convert.S2Id(StringUtil.CharAt(str,i))
                set char2=Convert.S2Id(StringUtil.CharAt(str2,i))
                if (char!=char2)then
                    return char-char2
                endif
            set i = i+1
            endloop
            return 0
        endmethod
        static method IndexOf takes string str,string sub returns integer
            local integer strLen=StringLength(str)
            local integer subLen=StringLength(sub)
            local integer i=0
            if (strLen>=subLen and subLen>0)then
                set i=0
                loop
                exitwhen i>strLen-subLen
                    if (sub==StringUtil.SubString(str,i,subLen))then
                        return i
                    endif
                set i=i+1
                endloop
            endif
            return -1
        endmethod
        static method LastIndexOf takes string str,string sub returns integer
            local integer strLen=StringLength(str)
            local integer subLen=StringLength(sub)
            local integer i=0
            if (strLen>=subLen and subLen>0)then
                set i=strLen-subLen
                loop
                exitwhen i<0
                    if (sub==StringUtil.SubString(str,i,subLen))then
                        return i
                    endif
                set i=i-1
                endloop
            endif
            return -1
        endmethod
        static method CharAt takes string str,integer index returns string
            if (index<0)then
                set index=StringLength(str)+index
            endif
            return StarCommon___subString(str,index,index+1)
        endmethod
        static method Slice takes string str,integer begin,integer end returns string
            return StarCommon___subString(str,begin,end)
        endmethod
        static method SubString takes string str,integer begin,integer length returns string
            return StarCommon___subString(str,begin,begin+length)
        endmethod
        static method StrCont takes string s1,string s2,string s3 returns string
            local string str  //Print("run");
            call RemoveSavedString(StarBaseHT,1000,0)
            call RemoveSavedString(StarBaseHT,1000,1)
            call RemoveSavedString(StarBaseHT,1000,2)
            call RemoveSavedString(StarBaseHT,1000,4)
            call SaveStr(StarBaseHT,1000,0,s1)
            call SaveStr(StarBaseHT,1000,1,s2)
            call SaveStr(StarBaseHT,1000,2,s3)
            call SaveStr(StarBaseHT,1000,4,"123456")  //SaveStr(StarBaseHT,1000,3,s4);
            call EXExecuteScript("(require'StarStr').concat()")  //99%未执行 need cheak
            set str=LoadStr(StarBaseHT,1000,4)  //if(str==null){return "";}
            return str
        endmethod
        static integer count=0  //为字符串连接池添加字符串
        static method StrPoolAdd takes string str returns nothing
            set SSL_StringBuffer[SSL_StringBufferIndex]=str  // SaveStr(StarBaseHT,1000,count,str); // count+=1;
            set SSL_StringBufferIndex=SSL_StringBufferIndex+1  // Print("SSL_StringBufferIndex:"+I2S(SSL_StringBufferIndex));
        endmethod  //读取连接完成的字符串
        static method StrContLoad takes nothing returns string
            return EXExecuteScript("(require'StarStr').concat3()")  // string str ; // SaveInteger(StarBaseHT,999,0,count); // // Print("运行"); // EXExecuteScript("(require'StarStr').concat2()"); // // Print("运行"); // count = 0; // str = LoadStr(StarBaseHT,999,1); // //Print(str); // return str; //Print("调用输出");
        endmethod
        static method SubStr takes string str,integer length returns string
            local integer strLen=StringLength(str)
            if (length>strLen or length<-strLen)then
                return str
            endif
            if (length>=0)then
                return StringUtil.SubString(str,0,length)
            endif
            return StringUtil.SubString(str,strLen+length,-length)
        endmethod
        static method Replace takes string str,string old,string new returns string
            local integer i=StringUtil.IndexOf(str,old)
            if (i!=-1)then
                return StringUtil.SubStr(str,i)+new+StringUtil.SubStr(str,i+StringLength(old)-StringLength(str))
            endif
            return str
        endmethod
        static method LastReplace takes string str,string old,string new returns string
            local integer i=StringUtil.LastIndexOf(str,old)
            if (i!=-1)then
                return StringUtil.SubStr(str,i)+new+StringUtil.SubStr(str,i+StringLength(old)-StringLength(str))
            endif
            return str
        endmethod
        static method ReplaceAll takes string str,string old,string new returns string
            local integer i=StringUtil.IndexOf(str,old)
            loop
            exitwhen (i==-1)
                set str=StringUtil.SubStr(str,i)+new+StringUtil.SubStr(str,i+StringLength(old)-StringLength(str))
                set i=StringUtil.IndexOf(str,old)
            endloop
            return str
        endmethod
        static method ToLowerCase takes string str returns string
            local string result=""
            local integer strLen=StringLength(str)
            local integer char=0
            local integer i=0
            set i=0
            loop
            exitwhen (i>=strLen)
                set char=Convert.S2Id(StringUtil.CharAt(str,i))
                if (char>64 and char<91)then
                    set char=char+32
                endif
                set result=result+Convert.Id2S(char)
            set i = i+1
            endloop
            return result
        endmethod
        static method ToUpperCase takes string str returns string
            local string result=""
            local integer strLen=StringLength(str)
            local integer char=0
            local integer i=0
            set i=0
            loop
            exitwhen (i>=strLen)
                set char=Convert.S2Id(StringUtil.CharAt(str,i))
                if (char>96 and char<123)then
                    set char=char-32
                endif
                set result=result+Convert.Id2S(char)
            set i = i+1
            endloop
            return result
        endmethod
        static method Reverse takes string str returns string
            local string result=""
            local integer strLen=StringLength(str)
            local integer i=0
            set i=strLen
            loop
            exitwhen (i<=0)
                set result=result+StringUtil.CharAt(str,i-1)
            set i = i-1
            endloop
            return result
        endmethod
        static method Trim takes string str returns string
            local integer begin=0
            local integer end=StringLength(str)
            local string char=""
            if (str=="")then
                return ""
            endif
            set char=StarCommon___subString(str,0,1)
            loop
            exitwhen (not (char==" " or char=="\t" or char=="\n"))
                set begin=begin+1
                set char=StringUtil.CharAt(str,begin)
            endloop
            set char=StarCommon___subString(str,end-1,end)
            loop
            exitwhen (not (char==" " or char=="\t" or char=="\n"))
                set end=end-1
                set char=StringUtil.CharAt(str,end-1)
            endloop
            return StarCommon___subString(str,begin,end)
        endmethod  // Split("a,,b, c", ","); //--["a", "", "b", " c"]
        static method Split takes string str,string delimiters returns StringArray  // Split("ab, c, \nd", ", \n"); //--["ab", "c", "d"]
            local StringArray result=StringArray.create()
            local integer strLen=StringLength(str)
            local integer delimLen=StringLength(delimiters)
            local integer i=0
            local integer j=0
            local integer prev=0
            if (str=="")then
                return result
            endif
            if (delimLen==0)then
                set strLen=R2I(Math.Min(strLen,StringArray.size))
                set i=0
                loop
                exitwhen (i>=strLen)
                    set result[i]=StringUtil.CharAt(str,i)
                set i = i+1
                endloop
                return result
            endif
            set i=0
            loop
            exitwhen not (i<strLen and j<StringArray.size)
                if (StringUtil.Contains(delimiters,StarCommon___subString(str,i,i+1)))then
                    set result[j]=StarCommon___subString(str,prev,i)
                    set j=j+1
                    set prev=i+1
                endif
            set i=i+1
            endloop
            if (j<StringArray.size)then
                set result[j]=StarCommon___subString(str,prev,strLen)
            endif
            return result
        endmethod  // It will cause a bug, if you set @para separator as "|"
        static method Join takes StringArray arr,string separator returns string
            local string result=""
            local integer i
            set i=1
            loop
            exitwhen not (i<StringArray.size and arr[i]!=null)
                set result=result+separator+arr[i]
            set i=i+1
            endloop
            return arr[0]+result
        endmethod
    endstruct
