    function EC_EffectChargeTime2 takes effect e,real h,real r,real s,real d,player p,trigger at,real time,boolean pz,real bruti,boolean brush returns nothing
        local integer index=EC_Index  //
        set EC_DisD[index]=0
        set EC_Distance[index]=999999
        set EC_EffectList[index]=e
        set EC_Height[index]=h
        set EC_Range[index]=r
        set EC_Speed[index]=s
        set EC_D[index]=d
        set EC_DamageTrig[index]=at
        set EC_FinishTrig[index]=at
        set EC_PZTrig[index]=at
        set EC_BrushTrig[index]=at
        set EC_OwnningPlayer[index]=p  //时间模式
        set EC_Mode[index]=1
        set EC_Timed[index]=0
        set EC_TimeMax[index]=time  //是否启用刷新
        set EC_Brush[index]=brush  //是否启用碰撞
        set EC_PZ[index]=pz  //刷新
        set EC_BrushTime[index]=0
        set EC_BrushDis[index]=bruti  //飞行模式
        set EC_FlyMode[index]=0  //移动模式
        set EC_MoveMode[index]=0  //抛物线
        set EC_steepsMax[index]=0
        set EC_steeps[index]=0  //
        set EC_Index=EC_Index+1
    endfunction  //检查坐标在护盾的范围内 如果非null 则表示在护盾范围内
    function EC_IsInShiled takes real x,real y,player p returns unit
        local integer i2=0  //检查护盾
        loop
        exitwhen (i2>=EC_ShiledIndex)
            if (not (IsUnitAlly(EC_ShiledArray[i2],p)))then  //友方护盾则不检查
                if (X_GDBC(x,y,GetUnitX(EC_ShiledArray[i2]),GetUnitY(EC_ShiledArray[i2]))<=EC_ShiledSize[i2])then
                    return EC_ShiledArray[i2]  //返回持有这个护盾的单位
                endif
            endif
            set i2=i2+1
        endloop
        return null
    endfunction  //正在冲锋的特效
    function EC_GetChargingEffect takes nothing returns effect
        return EC_TargetEffect
    endfunction  //设置特效飞行模式
    function EC_SetFlyMode takes integer effid,integer modeid,real maxHeight returns nothing
        if (modeid>1)then
            set modeid=0
        endif
        set EC_FlyMode[effid]=modeid
        set EC_Height[effid]=maxHeight
        if (EC_Mode[effid]==0)then
            set EC_steepsMax[effid]=R2I(EC_Distance[effid]/EC_Speed[effid])  //BJDebugMsg("Max=" + I2S(EC_steepsMax[effid]));
        else
            set EC_steepsMax[effid]=R2I(EC_TimeMax[effid]/0.02)
        endif
        set EC_steeps[effid]=0
    endfunction  //被冲锋到的单位
    function EC_GetChargedUnit takes nothing returns unit
        return EC_TargetUnit
    endfunction  //获取被触碰的护盾  仅在护盾触碰回调事件中可用
    function EC_GetShiledUnit takes nothing returns unit
        if (EC_EventID==4)then
            return EC_TargetUnit
        else
            return null
        endif
    endfunction  //完成冲锋的特效
    function EC_GetFinishingEffect takes nothing returns effect
        return EC_TargetEffect
    endfunction  //是否保护特效 为true则需要手动清除特效
    function EC_KeepEffectALive takes boolean b returns nothing
        set EC_KeepALive=b
    endfunction  //检查是否因为护盾事件结束
    function EC_IsFinishByShiled takes nothing returns boolean
        return EC_ShiledExit
    endfunction  //获得特效在冲锋库中的ID
    function EC_GetEffectId takes nothing returns integer
        return EC__i
    endfunction  //获取正在冲锋的特效所有者
    function EC_GetEffectOwnningPlayer takes nothing returns player
        return EC_EffectOwnningPlayer
    endfunction  //重设结束触发器
    function EC_ReSetEffectFinishTrigger takes integer effid,trigger t returns nothing
        set EC_FinishTrig[effid]=t
    endfunction  //重设刷新触发器
    function EC_ReSetEffectBrushTrigger takes integer effid,trigger t returns nothing
        set EC_BrushTrig[effid]=t
    endfunction  //重设碰撞触发器
    function EC_ReSetEffectDamageTrigger takes integer effid,trigger t returns nothing
        set EC_DamageTrig[effid]=t
    endfunction  //重设撞墙触发器
    function EC_ReSetEffectPZTrigger takes integer effid,trigger t,boolean b returns nothing
        set EC_PZTrig[effid]=t
        set EC_PZ[effid]=b
    endfunction  //重设特效速度
    function EC_ReSetEffectSpeed takes integer effid,real s returns nothing
        set EC_Speed[effid]=s
    endfunction  //重设特效高度
    function EC_ReSetEffectHeight takes integer effid,real s returns nothing
        set EC_Height[effid]=s
    endfunction  //重设特效位移方向
    function EC_ReSetEffectAngle takes integer effid,real s returns nothing
        set EC_D[effid]=s
    endfunction  //重设特效碰撞体积
    function EC_ReSetEffectRange takes integer effid,real s returns nothing
        set EC_Range[effid]=s
    endfunction  //重设特效行程
    function EC_ReSetEffectDistanced takes integer effid,real s returns nothing
        set EC_DisD[effid]=s
    endfunction  //重设特效总行程
    function EC_ReSetEffectMaxDistance takes integer effid,real s returns nothing
        set EC_Distance[effid]=s
    endfunction  //重设特效位移时间
    function EC_ReSetEffectTimed takes integer effid,real s returns nothing
        set EC_Timed[effid]=s
    endfunction  //重设特效位移总时间
    function EC_ReSetEffectMaxTime takes integer effid,real s returns nothing
        set EC_TimeMax[effid]=s
    endfunction  //获取特效的碰撞体积
    function EC_GetEffectRange takes integer effid returns real
        return EC_Range[effid]
    endfunction  //重设特效
    function EC_ReSetEffect takes integer effid,effect e returns nothing
        set EC_EffectList[effid]=e
    endfunction  //获取特效的恒定高度
    function EC_GetEffectHeight takes integer effid returns real
        return EC_Height[effid]
    endfunction  //获取特效的移动速度
    function EC_GetEffectSpeed takes integer effid returns real
        return EC_Speed[effid]
    endfunction  //获取特效的移动方向
    function EC_GetEffectAngle takes integer effid returns real
        return EC_D[effid]
    endfunction  //获取特效的行程
    function EC_GetEffectDisd takes integer effid returns real
        return EC_DisD[effid]
    endfunction  //获取特效的总行程
    function EC_GetEffectMaxDis takes integer effid returns real
        return EC_Distance[effid]
    endfunction  //获取特效的总时间
    function EC_GetEffectMaxTime takes integer effid returns real
        return EC_TimeMax[effid]
    endfunction  //获取特效的位移时间
    function EC_GetEffectTimed takes integer effid returns real
        return EC_Timed[effid]
    endfunction  //获取特效在系统中的ID ， 需要判断非 -1 
    function EC_GetEffectIdOnSystem takes effect e returns integer
        if (HaveSavedInteger(EC_HT,GetHandleId(e),1000))then
            return LoadInteger(EC_HT,GetHandleId(e),1000)
        endif
        return -1
    endfunction  //设置特效启用刷新
    function EC_SetBrush takes integer effid,real dis,boolean b returns nothing
        set EC_Brush[effid]=b
        set EC_BrushDis[effid]=dis
    endfunction  //设置特效移动模式
    function EC_SetMoveMode takes integer effid,integer modeid returns nothing
        if (modeid!=0)then
            set EC_Brush[effid]=true
            set EC_BrushDis[effid]=0.02
        endif
        set EC_MoveMode[effid]=modeid
    endfunction  //获取特效冲锋事件ID
    function EC_GetEVentID takes nothing returns integer
        return EC_EventID
    endfunction  //UI封装 - 转换 特效冲锋事件ID 为 整数
    function EC_I2E takes integer EC__i returns integer
        return EC__i
    endfunction  //UI封装 -空触发器
    function EC_NilTrig takes nothing returns trigger
        return null
    endfunction  //获取顶部计数
    function EC_GetIndex takes nothing returns integer
        return EC_Index-1
    endfunction  //设置一个护盾
    function EC_SetShiled takes unit s,real size,trigger trig returns nothing
        set EC_ShiledArray[EC_ShiledIndex]=s
        set EC_ShiledSize[EC_ShiledIndex]=size
        set EC_ShiledCallbackTrig[EC_ShiledIndex]=trig
        set EC_ShiledIndex=EC_ShiledIndex+1  //Print(GetUnitName(s));
    endfunction  //移除一个护盾
    function EC_RemoveShiled takes unit u returns nothing
        local integer EC__i=0
        local integer index=EC_ShiledIndex-1  //遍历所有护盾单位 ，找到指定单位
        loop
        exitwhen (EC__i>=EC_ShiledIndex)
            if (EC_ShiledArray[EC__i]==u)then
                set EC_ShiledArray[EC__i]=EC_ShiledArray[index]  //移除指定的护盾
                set EC_ShiledSize[EC__i]=EC_ShiledSize[index]
                set EC_ShiledCallbackTrig[EC__i]=EC_ShiledCallbackTrig[index]
                set EC_ShiledIndex=EC_ShiledIndex-1
                exitwhen true
            endif
            set EC__i=EC__i+1
        endloop
    endfunction  //结束本次冲锋
    function EC_FinishCharge takes nothing returns nothing
        set EC_Exit=true
        if (EC_EventID==4)then
            set EC_ShiledExit=true
        endif
    endfunction
    function EC_FinishChargeByShiled takes nothing returns nothing  //设置冲锋由于护盾碰撞而结束
        set EC_Exit=true
        set EC_ShiledExit=true
    endfunction  //使弹幕反弹
    function EC_SetEffectRebound takes integer effid returns nothing
        local real x=EXGetEffectX(EC_EffectList[effid])
        local real y=EXGetEffectY(EC_EffectList[effid])
        local real d
        local real a  //碰撞单位/碰撞护盾反弹
        local real b
        local real d2
        if (EC_EventID==0 or EC_EventID==4)then
            set EC_Hitable=false
            set a=GetUnitX(EC_TargetUnit)
            set b=GetUnitY(EC_TargetUnit)  // d2 = Math.GAFC(a,b,x,y);
            set d2=Math.GAFC(x,y,a,b)
            set d=180-EC_GetEffectAngle(effid)-(d2+d2)  // if(! ( (d2>45&& d2 <135) ||(d2>-135&& d2 <-45)) ){
        else  //     d = 180 - EC_GetEffectAngle(effid); // } //墙体反弹
            set d=360-EC_GetEffectAngle(effid)
            set a=x+CosBJ(d)*31
            set b=y+SinBJ(d)*31
            if ((not (X_IsTerrainWalkable(a,b))))then
                set d=180-EC_GetEffectAngle(effid)
            endif
        endif
        call EC_ReSetEffectAngle(effid,d)
        call EXEffectMatReset(EC_EffectList[effid])
        call EXEffectMatRotateZ(EC_EffectList[effid],d)
    endfunction  //新建闪电效果
    function EC_AddLighting takes string s,boolean bo,real x,real y,real a,real b returns lightning
        return AddLightning(s,bo,x,y,a,b)
    endfunction  //获取单位的range范围内的随机点
    function GetRandomLocNearUnit takes unit u,real range returns location
        local real sd=GetRandomReal(0,range)
        local real d=GetRandomReal(0,360)
        local real x=GetUnitX(u)
        local real y=GetUnitY(u)
        return Location(x+CosBJ(d)*sd,y+SinBJ(d)*sd)
    endfunction  //获取与单位在min~max距离之间的随机点
    function GetRandomLocBetween takes unit u,real min,real max returns location
        local real sd=GetRandomReal(min,max)
        local real d=GetRandomReal(0,360)
        local real x=GetUnitX(u)
        local real y=GetUnitY(u)
        return Location(x+CosBJ(d)*sd,y+SinBJ(d)*sd)
    endfunction  //命令特效e 开始冲锋， 保持相对地面高度为 h 碰撞范围 r 冲锋速度 s 伤害来源单位为 u 伤害值为 damage 冲锋距离 dis 检查碰撞 b 是否穿透单位 b2
    function EC_Charger takes effect e,real h,real r,real s,real d,unit u,real damage,real dis,boolean b,boolean b2 returns nothing
        local integer index=EC_Index  // Print("单位地址->"+I2S(GetHandleId(u)));
        if (e==null)then  // Print("特效地址->"+I2S(GetHandleId(e))); // Print("速度->"+R2S(s));
            return
        endif  //基本数据
        set EC_DisD[index]=0
        set EC_Distance[index]=dis
        set EC_EffectList[index]=e
        set EC_Height[index]=h
        set EC_Range[index]=r
        set EC_Speed[index]=s
        set EC_D[index]=d
        set EC_DamageTrig[index]=EC_TRIG
        set EC_FinishTrig[index]=EC_TRIG
        set EC_PZTrig[index]=EC_TRIG
        set EC_BrushTrig[index]=EC_TRIG
        set EC_PZTrig[index]=EC_TRIG
        set EC_OwnningPlayer[index]=GetOwningPlayer(u)
        set EC_Mode[index]=0
        set EC_Timed[index]=0
        set EC_TimeMax[index]=0
        set EC_PZ[index]=b
        set EC_Brush[index]=false
        set EC_BrushTime[index]=1
        set EC_FlyMode[index]=0
        set EC_steepsMax[index]=0
        set EC_steeps[index]=0
        set EC_MoveMode[index]=0
        set EC_Index=EC_Index+1  //保存附加数据  --伤害来源u 伤害值damage
        call SaveReal(EC_HT,GetHandleId(e),EC_K_Damage,damage)  //--伤害值 //--伤害来源
        call SaveUnitHandle(EC_HT,GetHandleId(e),EC_K_Unit,u)  //--保护组
        call SaveGroupHandle(EC_HT,GetHandleId(e),EC_K_Group,CreateGroup())  //--是否穿透
        call SaveBoolean(EC_HT,GetHandleId(e),EC_K_Penetrate,b2)  //Print("特效->"+I2S(GetHandleId(e)));
    endfunction
    function EC__EC_TRIGEVT takes nothing returns nothing
        local effect e=EC_TargetEffect
        local player p=EC_EffectOwnningPlayer
        local integer id=EC_EventID
        local real a
        local real b
        local unit u
        local real damage
        local string str
        local boolean IsPenetrate=LoadBoolean(EC_HT,GetHandleId(e),EC_K_Penetrate)
        set u=LoadUnitHandle(EC_HT,GetHandleId(e),EC_K_Unit)
        set damage=LoadReal(EC_HT,GetHandleId(e),EC_K_Damage)
        set EC_group=LoadGroupHandle(EC_HT,GetHandleId(e),EC_K_Group)  //Print("特效->"+I2S(GetHandleId(e)));
        if (id==0)then  //固定流程：对被冲锋的敌人造成伤害一次
            if (IsUnitEnemy(EC_GetChargedUnit(),EC_GetEffectOwnningPlayer()))then  //碰撞 //是敌人
                if (IsUnitAliveBJ(EC_GetChargedUnit()))then  //非死亡单位
                    if (not (IsUnitInGroup(EC_GetChargedUnit(),EC_group)))then  //不在单位组中
                        call UnitDamageTarget(u,EC_GetChargedUnit(),damage,true,false,ATTACK_TYPE_MELEE,DAMAGE_TYPE_ENHANCED,WEAPON_TYPE_WHOKNOWS)  //造成伤害,添加到单位组
                        call GroupAddUnit(EC_group,EC_GetChargedUnit())
                        if (not IsPenetrate)then
                            call EC_FinishCharge()  //不穿透就停止冲锋
                        endif
                    endif
                endif
            endif
        elseif (id==1)then
            call FlushChildHashtable(EC_HT,GetHandleId(e))  //结束  //清除单位组，特效，哈希表数据
            call DestroyGroup(EC_group)
            call DestroyEffect(e)
        elseif (id==2)then
            if (HaveSavedString(EC_HT,GetHandleId(e),EC_K_Brush))then
                set a=EXGetEffectX(e)
                set b=EXGetEffectY(e)
                set EC_2_ID=EC_GetEffectIdOnSystem(e)
                if (EC_2_ID!=-1)then
                    set str=LoadStr(EC_HT,GetHandleId(e),EC_K_Brush)
                    call EC_DestroyEffect(e)
                    call FlushChildHashtable(EC_HT,GetHandleId(e))
                    set e=AddSpecialEffect(str,a,b)  //--伤害值
                    call SaveReal(EC_HT,GetHandleId(e),EC_K_Damage,damage)  //--伤害来源
                    call SaveUnitHandle(EC_HT,GetHandleId(e),EC_K_Unit,u)  //--保护组
                    call SaveGroupHandle(EC_HT,GetHandleId(e),EC_K_Group,EC_group)  //--是否穿透
                    call SaveBoolean(EC_HT,GetHandleId(e),EC_K_Penetrate,IsPenetrate)
                    call SaveStr(EC_HT,GetHandleId(e),EC_K_Brush,str)
                    call EC_ReSetEffect(EC_2_ID,e)
                endif
            endif
        elseif (id==3)then
            call EC_SetEffectRebound(EC_GetEffectId())  //撞墙
        endif
        set e=null
        set p=null
        set u=null
        set EC_group=null
    endfunction  //固定流程特效
    //public:
    function EC__EC_TriggerInit takes nothing returns nothing
        set EC_TRIG=CreateTrigger()
        call TriggerAddAction(EC_TRIG,function EC__EC_TRIGEVT)
    endfunction
    //public:
    function EC__EC_SE1 takes nothing returns nothing
        local integer EC__i=0
        local integer lpi=0
        local integer id=0
        local real x
        local real y
        local real a
        local real b
        local real x1
        local real x2
        local real y1
        local real y2
        local real distance
        local real speed
        local real d
        local real estimateTime
        local real s
        local real dis2
        local unit u
        local unit tu
        local trigger trig
        local timer t=GetExpiredTimer()  //读取数据
        set a=LoadReal(EC_HT,GetHandleId(t),1)
        set b=LoadReal(EC_HT,GetHandleId(t),2)
        set speed=LoadReal(EC_HT,GetHandleId(t),3)
        set estimateTime=LoadReal(EC_HT,GetHandleId(t),4)
        set u=LoadUnitHandle(EC_HT,GetHandleId(t),5)
        set tu=LoadUnitHandle(EC_HT,GetHandleId(t),6)
        set trig=LoadTriggerHandle(EC_HT,GetHandleId(t),7)
        set id=LoadInteger(EC_HT,GetHandleId(t),8)  //-------------
        set x1=GetUnitX(u)
        set y1=GetUnitY(u)
        set x=GetUnitX(tu)
        set y=GetUnitY(tu)
        set d=X_GAFC(a,b,x,y)
        set distance=X_GDBC(a,b,x,y)
        set s=distance*estimateTime
        set x2=x+CosBJ(d)*s
        set y2=y+SinBJ(d)*s
        set EC__i=R2I(estimateTime)/100
        set EC__i=EC__i+3
        loop
        exitwhen (EC__i<=lpi)
            set lpi=lpi+1
            set dis2=Math.GDBC(x1,y1,x2,y2)
            set estimateTime=(dis2/speed)*100
            set s=distance*estimateTime
            set x2=x+CosBJ(d)*s
            set y2=y+SinBJ(d)*s
        endloop  //回调
        set EC_CB_X=x2
        set EC_CB_Y=y2
        set EC_CB_angle=X_GAFC(x1,y1,x2,y2)
        set EC_CB_Unit=u
        set EC_CB_TargetUnit=tu
        set EC_CB_ID=id
        if (TriggerEvaluate(trig))then
            call TriggerExecute(trig)
        endif  //清理
        call FlushChildHashtable(EC_HT,GetHandleId(t))
        call DestroyTimer(t)  //
        set t=null
        set u=null
        set tu=null
        set trig=null
    endfunction  //贝塞尔 获取z轴 t, 最高, 起点, 终点 
    function EC_Get2thBesselZ takes real a,real height,real startz,real finz returns real
        return (a*a*startz+2*a*(1-a)*height+(1-a)*(1-a)*finz)
    endfunction  //平滑追踪角度(起点x,y 终点dx,dy)
    function EC_GetTrackAngle_Effect takes real x,real y,real dx,real dy returns real
        set dx=dx-x
        set dy=dy-y
        return bj_RADTODEG*Atan2(dy,dx)
    endfunction  //创建特效->${特效路径},${x},${y},${z},${朝向},${尺寸},${动画速度},${持续时间}
    function EC_CreateEffect takes string path,real x,real y,real z,real fac,real size,real s,real time returns effect
        set bj_lastCreatedEffect=AddSpecialEffect(path,x,y)
        call EXSetEffectSize(bj_lastCreatedEffect,size)
        call EXSetEffectZ(bj_lastCreatedEffect,EC_GetPointZ(x,y)+z)
        if (time>=0)then
            call YDWETimerDestroyEffect(time,bj_lastCreatedEffect)
        elseif (time!=-1)then
            call DestroyEffect(bj_lastCreatedEffect)
        endif
        call EXEffectMatRotateZ(bj_lastCreatedEffect,fac)
        call EXSetEffectSpeed(bj_lastCreatedEffect,s)
        return bj_lastCreatedEffect
    endfunction
    function EC__EC_SE2 takes nothing returns nothing
        local integer EC__i=0
        local integer lpi=0
        local integer id=0
        local real x
        local real y
        local real a
        local real b
        local real x1
        local real x2
        local real y1
        local real y2
        local real dis
        local real speed
        local real d
        local real bbb
        local real s
        local real dis2
        local effect e
        local unit tu
        local trigger trig
        local timer t=GetExpiredTimer()  //读取数据
        set a=LoadReal(EC_HT,GetHandleId(t),1)
        set b=LoadReal(EC_HT,GetHandleId(t),2)
        set speed=LoadReal(EC_HT,GetHandleId(t),3)
        set bbb=LoadReal(EC_HT,GetHandleId(t),4)
        set e=LoadEffectHandle(EC_HT,GetHandleId(t),5)
        set tu=LoadUnitHandle(EC_HT,GetHandleId(t),6)
        set trig=LoadTriggerHandle(EC_HT,GetHandleId(t),7)
        set id=LoadInteger(EC_HT,GetHandleId(t),8)
        if (e!=null)then
            set x1=EXGetEffectX(e)  //-------------
            set y1=EXGetEffectY(e)
            set x=GetUnitX(tu)
            set y=GetUnitY(tu)
            set d=Math.GAFC(a,b,x,y)
            set dis=Math.GDBC(a,b,x,y)
            set s=dis*bbb
            set x2=x+CosBJ(d)*s
            set y2=y+SinBJ(d)*s
            set EC__i=R2I(bbb)/100+3
            loop
            exitwhen (EC__i<=lpi)
                set lpi=lpi+1
                set s=dis*((Math.GDBC(x1,y1,x2,y2)/speed)*100)
                set x2=x+CosBJ(d)*s
                set y2=y+SinBJ(d)*s
            endloop  //回调
            set EC_CB_angle=Math.GAFC(x1,y1,x2,y2)  //EC_CB_degree = EC_GetTrackAngle_Effect(x1,y1,x2,y2);
            set EC_CB_Effect=e
            set EC_CB_TargetUnit=tu
            set EC_CB_ID=id
            if (TriggerEvaluate(trig))then
                call TriggerExecute(trig)
            endif
        endif  //清理
        call FlushChildHashtable(EC_HT,GetHandleId(t))
        call DestroyTimer(t)  //
        set t=null
        set e=null
        set tu=null
        set trig=null
    endfunction  //xy为原点 扇形方向为d 范围为j 半径为r
    function EC_GetGroup takes real x,real y,real j,real d,real r returns group
        local group EC__g=CreateGroup()
        local unit u
        local real x1
        local real y1
        local real d1
        local real a1
        local real a2
        set bj_lastCreatedGroup=CreateGroup()
        call GroupEnumUnitsInRange(EC__g,x,y,r,null)
        set u=FirstOfGroup(EC__g)
        if (d<0)then
            set d=360+d
        elseif (d>360)then
            set d=d-360
        endif
        set a1=d-j/2
        set a2=d+j/2
        loop
        exitwhen (u==null)
            set x1=GetUnitX(u)
            set y1=GetUnitY(u)
            set d1=Atan2(y1-y,x1-x)*180/bj_PI
            if (d1<0)then
                set d1=360+d1
            elseif (d1>360)then
                set d1=d1-360
            endif
            if (d1>a1 and d1<a2)then
                call GroupAddUnit(bj_lastCreatedGroup,u)
            endif
            call GroupRemoveUnit(EC__g,u)
            set u=FirstOfGroup(EC__g)
        endloop
        call DestroyGroup(EC__g)
        set EC__g=null
        set u=null
        return bj_lastCreatedGroup
    endfunction
    function EC_ShootReady takes unit u,real speed,unit tu,trigger callBack,integer id returns nothing
        local real x
        local real y
        local real a
        local real b
        local real x1
        local real x2
        local real dis
        local real d
        local real bbb
        local timer t=CreateTimer()
        set x=GetUnitX(u)
        set y=GetUnitY(u)
        set a=GetUnitX(tu)
        set b=GetUnitY(tu)
        set dis=X_GDBC(x,y,a,b)
        set bbb=(dis/speed)*100  //保存单位当前位置
        call SaveReal(EC_HT,GetHandleId(t),1,a)
        call SaveReal(EC_HT,GetHandleId(t),2,b)
        call SaveReal(EC_HT,GetHandleId(t),3,speed)
        call SaveReal(EC_HT,GetHandleId(t),4,bbb)
        call SaveUnitHandle(EC_HT,GetHandleId(t),5,u)
        call SaveUnitHandle(EC_HT,GetHandleId(t),6,tu)
        call SaveTriggerHandle(EC_HT,GetHandleId(t),7,callBack)
        call SaveInteger(EC_HT,GetHandleId(t),8,id)  //运行计算
        call TimerStart(t,0.01,false,function EC__EC_SE1)
        set t=null
    endfunction  //弹道计算回调-StarWE版本
    function EC__EC_SE1EX takes nothing returns nothing
        local integer EC__i=0
        local integer lpi=0
        local integer id=0
        local real x
        local real y
        local real a
        local real b
        local real x1
        local real x2
        local real y1
        local real y2
        local real dis  //读取数据
        local real speed
        local real d
        local real bbb
        local real s
        local real dis2
        local unit u
        local unit tu
        local trigger trig
        local timer t=GetExpiredTimer()
        set a=LoadReal(EC_HT,GetHandleId(t),1)
        set b=LoadReal(EC_HT,GetHandleId(t),2)
        set speed=LoadReal(EC_HT,GetHandleId(t),3)
        set bbb=LoadReal(EC_HT,GetHandleId(t),4)
        set u=LoadUnitHandle(EC_HT,GetHandleId(t),5)
        set tu=LoadUnitHandle(EC_HT,GetHandleId(t),6)
        set trig=LoadTriggerHandle(EC_HT,GetHandleId(t),7)  //-------------
        set x1=GetUnitX(u)
        set y1=GetUnitY(u)
        set x=GetUnitX(tu)
        set y=GetUnitY(tu)
        set d=X_GAFC(a,b,x,y)  // printsr("当前速度:",dis*100);
        set dis=X_GDBC(a,b,x,y)
        set s=dis*bbb  //初步计算预瞄点 //精度控制
        set EC__i=R2I(bbb)/100+4  //重算——推演出着弹点
        loop
        exitwhen (EC__i<=lpi)
            set lpi=lpi+1
            set x2=x+CosBJ(d)*s
            set y2=y+SinBJ(d)*s
            set dis2=Math.GDBC(x1,y1,x2,y2)
            set bbb=(dis2/speed)*100
            set s=dis*bbb
        endloop  //预计命中位置
        set EC_CB_X=x2
        set EC_CB_Y=y2  //回调
        set EC_CB_angle=X_GAFC(x1,y1,x2,y2)
        set EC_CB_Unit=u
        set EC_CB_TargetUnit=tu
        call TriggerEvaluate(trig)  // if(TriggerEvaluate(trig)){}
        call FlushChildHashtable(EC_HT,GetHandleId(t))  //清理 //
        call DestroyTimer(t)
        call DestroyTrigger(trig)
        set t=null
        set u=null
        set tu=null
        set trig=null
    endfunction  //弹道计算-StarWE版本
    function EC_ShootReadyEx takes unit u,real speed,unit tu,trigger trig returns nothing
        local real x
        local real y
        local real a
        local real b
        local real x1
        local real x2
        local real dis
        local real d
        local real bbb
        local timer t
        if ((speed<=0))then
            return
        endif
        set t=CreateTimer()
        set x=GetUnitX(u)
        set y=GetUnitY(u)
        set a=GetUnitX(tu)
        set b=GetUnitY(tu)
        set dis=X_GDBC(x,y,a,b)
        set bbb=(dis/speed)*100  //保存单位当前位置
        call SaveReal(EC_HT,GetHandleId(t),1,a)
        call SaveReal(EC_HT,GetHandleId(t),2,b)
        call SaveReal(EC_HT,GetHandleId(t),3,speed)
        call SaveReal(EC_HT,GetHandleId(t),4,bbb)
        call SaveUnitHandle(EC_HT,GetHandleId(t),5,u)
        call SaveUnitHandle(EC_HT,GetHandleId(t),6,tu)
        call SaveTriggerHandle(EC_HT,GetHandleId(t),7,trig)  //运行计算
        call TimerStart(t,0.01,false,function EC__EC_SE1EX)
        set t=null
    endfunction
    function EC__EC_SE2EX takes nothing returns nothing
        local integer EC__i=0
        local integer lpi=0
        local integer id=0
        local real x
        local real y
        local real a
        local real b
        local real x1
        local real x2
        local real y1
        local real y2
        local real dis
        local real speed
        local real d
        local real bbb
        local real s
        local real dis2
        local effect e
        local unit tu
        local trigger trig
        local timer t=GetExpiredTimer()  //读取数据
        set a=LoadReal(EC_HT,GetHandleId(t),1)
        set b=LoadReal(EC_HT,GetHandleId(t),2)
        set speed=LoadReal(EC_HT,GetHandleId(t),3)
        set bbb=LoadReal(EC_HT,GetHandleId(t),4)
        set e=LoadEffectHandle(EC_HT,GetHandleId(t),5)
        set tu=LoadUnitHandle(EC_HT,GetHandleId(t),6)
        set trig=LoadTriggerHandle(EC_HT,GetHandleId(t),7)
        if (e!=null)then
            set x1=EXGetEffectX(e)  //------------- //发射位置 //目标位置
            set y1=EXGetEffectY(e)
            set x=GetUnitX(tu)  //目标移动方向
            set y=GetUnitY(tu)
            set d=X_GAFC(a,b,x,y)  //目标移动距离
            set dis=X_GDBC(a,b,x,y)  //
            set EC__i=R2I(bbb)/100+4
            loop
            exitwhen (EC__i<=lpi)
                set lpi=lpi+1
                set s=dis*bbb  //猜测可能出现位置
                set x2=x+CosBJ(d)*s  //重推算
                set y2=y+SinBJ(d)*s
                set dis2=Math.GDBC(x1,y1,x2,y2)
                set bbb=(dis2/speed)*100
            endloop
            set EC_CB_X=x2
            set EC_CB_Y=y2
            set EC_CB_angle=Math.GAFC(x1,y1,x2,y2)  //EC_CB_degree = EC_GetTrackAngle_Effect(x1,y1,x2,y2);
            set EC_CB_Effect=e
            set EC_CB_TargetUnit=tu
            call TriggerEvaluate(trig)  // if(TriggerEvaluate(trig)){}
        endif  //清理
        call FlushChildHashtable(EC_HT,GetHandleId(t))
        call DestroyTimer(t)  //
        set t=null
        set e=null
        set tu=null
        set trig=null
    endfunction  //弹道计算 特效版
    function EC_ShootReady_EffectEX takes effect e,real speed,unit tu,trigger callBack returns nothing
        local real x
        local real y
        local real a
        local real b
        local real x1
        local real x2
        local real dis
        local real d
        local real bbb
        local timer t
        if ((speed<=0))then
            return
        endif
        set t=CreateTimer()
        set x=EXGetEffectX(e)
        set y=EXGetEffectY(e)
        set a=GetUnitX(tu)
        set b=GetUnitY(tu)
        set dis=X_GDBC(x,y,a,b)
        set bbb=(dis/speed)*100  //保存单位当前位置
        call SaveReal(EC_HT,GetHandleId(t),1,a)
        call SaveReal(EC_HT,GetHandleId(t),2,b)
        call SaveReal(EC_HT,GetHandleId(t),3,speed)
        call SaveReal(EC_HT,GetHandleId(t),4,bbb)
        call SaveEffectHandle(EC_HT,GetHandleId(t),5,e)
        call SaveUnitHandle(EC_HT,GetHandleId(t),6,tu)
        call SaveTriggerHandle(EC_HT,GetHandleId(t),7,callBack)  //运行计算
        call TimerStart(t,0.01,false,function EC__EC_SE2EX)
        set t=null
    endfunction
    function EC_ShootReady_Effect takes effect e,real speed,unit tu,trigger callBack,integer id returns nothing
        local real x
        local real y
        local real a
        local real b
        local real x1
        local real x2
        local real dis
        local real d
        local real bbb
        local timer t=CreateTimer()
        set x=EXGetEffectX(e)
        set y=EXGetEffectY(e)
        set a=GetUnitX(tu)
        set b=GetUnitY(tu)
        set dis=X_GDBC(x,y,a,b)
        set bbb=(dis/speed)*100  //保存单位当前位置
        call SaveReal(EC_HT,GetHandleId(t),1,a)
        call SaveReal(EC_HT,GetHandleId(t),2,b)
        call SaveReal(EC_HT,GetHandleId(t),3,speed)
        call SaveReal(EC_HT,GetHandleId(t),4,bbb)
        call SaveEffectHandle(EC_HT,GetHandleId(t),5,e)
        call SaveUnitHandle(EC_HT,GetHandleId(t),6,tu)
        call SaveTriggerHandle(EC_HT,GetHandleId(t),7,callBack)
        call SaveInteger(EC_HT,GetHandleId(t),8,id)  //运行计算
        call TimerStart(t,0.01,false,function EC__EC_SE2)
        set t=null
    endfunction  //获取回调事件ID
    function GetCallBackID takes nothing returns integer
        return EC_CB_ID
    endfunction  //获取回调发射角度
    function GetCallBackAngle takes nothing returns real
        return EC_CB_angle
    endfunction  //获取回调源单位
    function GetCallBackUnit takes nothing returns unit
        return EC_CB_Unit
    endfunction  //获取回调源特效
    function GetCallBackEffect takes nothing returns effect
        return EC_CB_Effect
    endfunction  //获取回调目标单位
    function GetCallBackTargetUnit takes nothing returns unit
        return EC_CB_TargetUnit
    endfunction
    function EC__onInit takes nothing returns nothing
        set EC_Timer=CreateTimer()
        set EC_HT=InitHashtable()
        call EC__EC_TriggerInit()
        call TimerStart(EC_Timer,0.02,true,function EC__EC_TimerEvent)
    endfunction

//library EC ends
//library ItmeProperty:
//获取单位属性
function GS_LoadUintProperty takes unit u,integer i returns real
    if(i == 0)then //生命
return GetUnitState(u, UNIT_STATE_LIFE)
    endif
    if(i == 1)then //魔法
return GetUnitState(u, UNIT_STATE_MAX_MANA)
    endif
    if(i == 2)then //攻击
return GetUnitState(u, ConvertUnitState(0x12))
    endif
    if(i == 3)then //护甲
return GetUnitState(u, ConvertUnitState(0x20))
    endif
    if(i == 4)then //攻速
return GetUnitState(u,ConvertUnitState(0x51))
    endif
    if(i == 5)then //移动
return GetUnitMoveSpeed(u)
    endif
    return LoadReal(ItmeProperty__HS,GetHandleId(u),i)
endfunction
function GS_LoadUintProperty_B takes unit u,integer i returns real
    return GS_LoadUintProperty(u,i)
endfunction
//修改单位属性
function GS_Unit_Pry_change takes unit u,integer i, real r returns nothing
    local real HP
    if(u == null or r == 0)then
        return
    endif
    if(i == 0)then //生命
set HP = GetUnitLifePercent(u)
        call SetUnitState( u, UNIT_STATE_MAX_LIFE, GetUnitState(u, UNIT_STATE_MAX_LIFE) + (r * (1 + LoadReal(ItmeProperty__HS,GetHandleId(u),15))))
        call SetUnitLifePercentBJ( u, HP )
        return
    endif
    if(i == 1)then //魔法
set HP = GetUnitManaPercent(u)
        call SetUnitState( u, UNIT_STATE_MAX_MANA, GetUnitState(u, UNIT_STATE_MAX_MANA) + r)
        call SetUnitManaPercentBJ( u, HP )
        return
    endif
    if(i == 2)then //攻击
call SetUnitState( u, ConvertUnitState(0x12), GetUnitState(u, ConvertUnitState(0x12)) + (r * (1 + LoadReal(ItmeProperty__HS,GetHandleId(u),16)))) 
        return
    endif
    if(i == 3)then //护甲
call SetUnitState( u, ConvertUnitState(0x20), GetUnitState(u, ConvertUnitState(0x20)) + (r * (1 + LoadReal(ItmeProperty__HS,GetHandleId(u),17)))) 
        return
    endif
    if(i == 4)then //攻速
call SetUnitState( u, ConvertUnitState(0x51), GetUnitState(u, ConvertUnitState(0x51)) + r)
        return
    endif
    if(i == 5)then //移动
call SaveReal(ItmeProperty__HS,GetHandleId(u),i,LoadReal(ItmeProperty__HS,GetHandleId(u),i) + r)
        call SetUnitMoveSpeed( u, GetUnitDefaultMoveSpeed(u) * (1 + LoadReal(ItmeProperty__HS,GetHandleId(u),i)))
        return
    endif
    if(i == 13)then //百分比生命
set HP = GetUnitLifePercent(u)
        call SetUnitState( u, UNIT_STATE_MAX_LIFE, GetUnitState(u, UNIT_STATE_MAX_LIFE) / (1 + LoadReal(ItmeProperty__HS,GetHandleId(u),i)) * (1 + LoadReal(ItmeProperty__HS,GetHandleId(u),i) + r))
        call SetUnitLifePercentBJ( u, HP )
        call SaveReal(ItmeProperty__HS,GetHandleId(u),i,LoadReal(ItmeProperty__HS,GetHandleId(u),i) + r)
        return
    endif
    if(i == 14)then //百分比攻击
if r < 0 then
            call SetUnitState( u, ConvertUnitState(0x12), GetUnitState(u, ConvertUnitState(0x12)) / (1 + LoadReal(ItmeProperty__HS,GetHandleId(u),i)) * (1 + LoadReal(ItmeProperty__HS,GetHandleId(u),i) + r))
        else
            call SetUnitState( u, ConvertUnitState(0x12), GetUnitState(u, ConvertUnitState(0x12)) / (1 + LoadReal(ItmeProperty__HS,GetHandleId(u),i)) * (1 + LoadReal(ItmeProperty__HS,GetHandleId(u),i) + r) + 1)
        endif
        call SaveReal(ItmeProperty__HS,GetHandleId(u),i,LoadReal(ItmeProperty__HS,GetHandleId(u),i) + r)
        return
    endif
    if(i == 15)then //百分比护甲
call SetUnitState( u, ConvertUnitState(0x20), GetUnitState(u, ConvertUnitState(0x20)) / (1 + LoadReal(ItmeProperty__HS,GetHandleId(u),i)) * (1 + LoadReal(ItmeProperty__HS,GetHandleId(u),i) + r))
        call SaveReal(ItmeProperty__HS,GetHandleId(u),i,LoadReal(ItmeProperty__HS,GetHandleId(u),i) + r)
        return
    endif
    if(i == 16)then
        call ModifyHeroStat(bj_HEROSTAT_STR , u, bj_MODIFYMETHOD_ADD, R2I(r))
        call GS_Unit_Pry_change(u, 0, r * 5)
        return
    endif
    if(i == 17)then
        call ModifyHeroStat(bj_HEROSTAT_AGI , u, bj_MODIFYMETHOD_ADD, R2I(r))
        call GS_Unit_Pry_change(u, 2, r * 0.3)
        call GS_Unit_Pry_change(u, 3, r)
        return
    endif
    if(i == 18)then
        call ModifyHeroStat(bj_HEROSTAT_INT , u, bj_MODIFYMETHOD_ADD, R2I(r))
        call GS_Unit_Pry_change(u, 5, r * 0.5)
        return
    endif
    call SaveReal(ItmeProperty__HS,GetHandleId(u),i,LoadReal(ItmeProperty__HS,GetHandleId(u),i) + r)
endfunction
function GS_UnitPry takes unit u,integer change,integer ptytype, real r returns nothing
    if change == 1 then
        set r = 0 - r
    endif
    call GS_Unit_Pry_change(u,ptytype,r)
endfunction
function GS_UnitPryB takes unit u,integer change,integer ptytype, real r returns nothing
    call GS_UnitPry(u,change,ptytype,r)
endfunction
//初始化增加属性
function GS_UintPty_ini2 takes unit u returns nothing
    if (IsUnitType(u, UNIT_TYPE_HERO) == false) then
        return
    endif
    call GS_UnitPry(u,0,0, I2R(GetHeroStr(u, true)) * 5)
    call GS_UnitPry(u,0,2, I2R(GetHeroAgi(u, true)) * 1)
    call GS_UnitPry(u,0,3, I2R(GetHeroAgi(u, true)) * 0.3)
    call GS_UnitPry(u,0,1, I2R(GetHeroInt(u, true)) * 5)
endfunction
//物品单项属性
function GS_item_Property takes item itm, integer ptytype, integer change ,real r returns nothing
    local unit u = LoadUnitHandle(ItmeProperty__HS,0,GetHandleId(itm))
    if(change == 0 )then
        call SaveReal(ItmeProperty__HS,GetHandleId(itm),ptytype,LoadReal(ItmeProperty__HS,GetHandleId(itm),ptytype) + r)
    endif
    if(change == 1 )then
        call SaveReal(ItmeProperty__HS,GetHandleId(itm),ptytype,LoadReal(ItmeProperty__HS,GetHandleId(itm),ptytype) - r) 
    endif
    if(change == 2 )then
        call SaveReal(ItmeProperty__HS,GetHandleId(itm),ptytype,r)
    endif
    call GS_UnitPry(u, change, ptytype, LoadReal(ItmeProperty__HS,GetHandleId(itm),ptytype))
    set u = null
endfunction 
function GS_item_Property_B takes item itm,integer i1 ,integer i2,real r returns nothing
    call GS_item_Property(itm,i1,i2,r)
endfunction
//*获得物品
function item_eve takes nothing returns nothing
    local item itm = GetManipulatedItem()
    local unit u = GetTriggerUnit()
    local integer a = 0
    local integer change = 0
    local real data
    if ((IsItemPowerup(GetManipulatedItem()) == true)) then
        call RemoveItem(GetManipulatedItem())
        return
    endif
    if ((EVENT_PLAYER_UNIT_PICKUP_ITEM == GetTriggerEventId()) == true) then
        set change = 0 
        call SaveUnitHandle(ItmeProperty__HS,0,GetHandleId(itm),GetTriggerUnit())
    else
        set change = 1
        call FlushChildHashtableBJ(0, ItmeProperty__HS)
    endif
    
    set u = null
    set itm = null
endfunction
//初始化
function item_init takes nothing returns nothing
    local trigger t1 = CreateTrigger()
    local trigger t2 = CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(t1, EVENT_PLAYER_UNIT_PICKUP_ITEM )
    call TriggerAddAction(t1, function item_eve)
    call TriggerRegisterAnyUnitEventBJ(t2, EVENT_PLAYER_UNIT_DROP_ITEM )
    call TriggerAddAction(t2, function item_eve)
endfunction

//library ItmeProperty ends
//library STES:

    //public:
        function STES_GetTable takes nothing returns hashtable
            return STES___HT
        endfunction  //为触发器注册自定义事件 事件名 = name
        function STES_Register takes trigger t,string name returns nothing
            local integer hash=StringHash(name)
            local integer hd=GetHandleId(t)  //获取计数
            local integer index=LoadInteger(STES___HT,hash,skey_index)  //触发器上的事件计数
            local integer index2=LoadInteger(STES___HT,hd,skey_index)  //事件绑定触发器队列
            call SaveTriggerHandle(STES___HT,hash,index,t)  //保存触发器//index += 1; //保存计数
            call SaveInteger(STES___HT,hash,skey_index,index+1)  //触发器上绑定对应事件
            call SaveStr(STES___HT,hd,index2,name)  //保存事件 //保存事件计数
            call SaveInteger(STES___HT,hd,skey_index,index2+1)  //SaveInteger(HT,hd,skey_count,index)//保存事件计数
        endfunction  ///注册事件Ex
        function STES_RegisterEx takes string funcName,string eventName returns nothing
            local integer hash=StringHash(eventName)
            local integer hd=StringHash(funcName)  //获取计数
            local integer index=LoadInteger(STES___HT,hash,skey_indexEx)  //触发器上的事件计数
            local integer index2=LoadInteger(STES___HT,hd,skey_indexEx)  //事件绑定触发器队列
            call SaveStr(STES___HT,hash,index,funcName)  //保存函数名//index += 1; //保存计数
            call SaveInteger(STES___HT,hash,skey_indexEx,index+1)  //函数上绑定对应事件
            call SaveStr(STES___HT,hd,index2,eventName)  //保存事件 //保存事件计数
            call SaveInteger(STES___HT,hd,skey_indexEx,index2+1)
        endfunction  //无参版本 有参版本写在dll里面
        function STES_Execute takes string name returns nothing
            local integer hash=StringHash(name)  //获取计数
            local integer index=LoadInteger(STES___HT,hash,skey_index)
            local integer i=0
            local trigger t
            loop
            exitwhen (i>=index)
                set t=LoadTriggerHandle(STES___HT,hash,i)  //运行触发器t
                if (TriggerEvaluate(t))then
                    call TriggerExecute(t)
                endif
                set i=i+1
            endloop
            set t=null
        endfunction  //注册单位自定义事件
        function STES_GetUnitEvent takes unit u,string name returns string
            return I2S(GetHandleId(u))+name
        endfunction  //清除触发器上的指定事件
        function STES_RemoveEvent takes trigger t,string Targetname returns nothing
            local integer hd=GetHandleId(t)  //获取触发器上事件计数
            local integer index=LoadInteger(STES___HT,hd,skey_index)
            local integer i=0
            local integer a=0
            local integer b=0
            local string name
            local integer hash
            local trigger t1
            loop
            exitwhen (i>=index)
                set name=LoadStr(STES___HT,hd,i)  //如果事件名称 相同 那么清除它
                if (name==Targetname)then
                    set hash=StringHash(name)  //获取计数
                    set a=LoadInteger(STES___HT,hash,skey_index)
                    loop
                    exitwhen (b>=a)
                        set t1=LoadTriggerHandle(STES___HT,hash,b)
                        if (t1==t)then
                            set a=a-1
                            set t1=LoadTriggerHandle(STES___HT,hash,a)
                            call SaveTriggerHandle(STES___HT,hash,b,t1)
                            call SaveInteger(STES___HT,hash,skey_index,a)
                            if (a>=b)then
                                exitwhen true
                            endif
                        endif
                        set b=b+1
                    endloop
                    call SaveStr(STES___HT,hd,i,LoadStr(STES___HT,hd,index))
                    set index=index-1
                    call SaveInteger(STES___HT,hash,skey_index,index)
                    if (i>=index)then
                        exitwhen true
                    endif
                endif
                set i=i+1
            endloop  //FlushChildHashtable(HT,hd);
            set t1=null
        endfunction  //清除触发器上的所有自定义事件
        function STES_Remove takes trigger t returns nothing
            local integer hd=GetHandleId(t)  //获取触发器上事件计数
            local integer index=LoadInteger(STES___HT,hd,skey_index)
            local integer i=0
            local integer a=0
            local integer b=0
            local string name
            local integer hash
            local trigger t1  //遍历触发器上所有事件
            loop
            exitwhen (i>=index)
                set name=LoadStr(STES___HT,hd,i)  //事件名称 //事件hash
                set hash=StringHash(name)  //获取计数
                set a=LoadInteger(STES___HT,hash,skey_index)
                loop
                exitwhen (b>=a)
                    set t1=LoadTriggerHandle(STES___HT,hash,b)  //遍历事件 //找到事件对应的触发器
                    if (t1==t)then
                        set a=a-1  //触发器数量-1 //将顶部的触发器拉过来)
                        set t1=LoadTriggerHandle(STES___HT,hash,a)  //save
                        call SaveTriggerHandle(STES___HT,hash,b,t1)  //save index
                        call SaveInteger(STES___HT,hash,skey_index,a)
                        if (a>=b)then
                            exitwhen true
                        endif
                    endif
                    set b=b+1
                endloop
                set i=i+1
            endloop
            call FlushChildHashtable(STES___HT,hd)
            set t1=null
        endfunction
        function STES___onInit takes nothing returns nothing
            set STES_HT=STES___HT
        endfunction

//library STES ends
//library StarCharge:

    function CheakLoc takes real x,real y returns boolean
        return (x>=GetRectMinX(bj_mapInitialPlayableArea)) and (y>=GetRectMinY(bj_mapInitialPlayableArea)) and (x<=GetRectMaxX(bj_mapInitialPlayableArea)) and (y<=GetRectMaxY(bj_mapInitialPlayableArea))
    endfunction  //排除死亡的单位
    function SCD1Filter takes nothing returns boolean
        return (GetUnitState(GetFilterUnit(),UNIT_STATE_LIFE)>0.405)
    endfunction  //排除死亡的单位/友军
    function SCD1Filter2 takes nothing returns boolean
        return (GetUnitState(GetFilterUnit(),UNIT_STATE_LIFE)>0.405 and ((not (IsUnitInGroup(GetFilterUnit(),SC_tempg2)))))
    endfunction  //停止单位所有冲锋
    function StarCharge_StopCharge takes unit u returns nothing
        local integer i=0
        loop
        exitwhen (i>=StarCharge__SCData1.index)
            if (SCData1List[i].u==u)then
                set SCData1List[i].disd=SCData1List[i].disd+999999
            endif
            set i=i+1
        endloop
    endfunction  //结束本次冲锋
    function SCD_StopCharge takes nothing returns nothing
        set SCD_Exit=true  //Print("stop");
    endfunction
    function SCD1ForGroupFunc takes nothing returns nothing
        local StarCharge__SCData1 scd=StarCharge__SCData1.tempSCData1
        if (not SCD_Exit)then
            set Star_TargetUnit=GetEnumUnit()  //Print("call"); // Print("Star_TriggerUnit->"+GetUnitName(Star_TriggerUnit));
            if (IsUnitEnemy(Star_TargetUnit,GetOwningPlayer(Star_TriggerUnit)))then  // Print("Star_TargetUnit->"+GetUnitName(Star_TargetUnit));
                if (scd.onlyOne)then  // Print("GetEnumUnit->"+GetUnitName(Star_TargetUnit));
                    call GroupAddUnit(SC_tempg2,GetEnumUnit())
                endif
                if (TriggerEvaluate(scd.callback))then
                    call TriggerExecute(scd.callback)
                endif
            endif
            set Star_TargetUnit=null
        else
        endif  //Print("skip");
    endfunction
    struct StarCharge__SCData1 
    //! pragma implicitthis
        static integer index=0
        static timer STimer
        static boolean Paused=false
        static group tempg=CreateGroup()
        static StarCharge__SCData1 tempSCData1
        unit u
        real speed
        group pg
        real d
        real range
        real dis
        real disd
        boolean b
        boolean onlyOne
        trigger callback
        static method create takes unit u,real s,real d,real dis,real r,boolean b,trigger t returns StarCharge__SCData1
            local StarCharge__SCData1 scd=StarCharge__SCData1.allocate()
            set scd.dis=dis
            set scd.disd=0
            set scd.u=u
            set scd.speed=s
            set scd.d=d
            set scd.range=r
            set scd.b=b
            set scd.onlyOne=false
            set scd.pg=null  //BJDebugMsg("d="+R2S(scd.d));
            set scd.callback=t
            set StarCharge__SCData1.index=StarCharge__SCData1.index+1
            return scd
        endmethod
        method enum takes real x,real y returns nothing
            set tempSCData1=this  //选取单位
            set SC_tempg2=null
            if (this.onlyOne)then
                set SC_tempg2=this.pg  //LoadGroupHandle(StarBaseHT,GetHandleId(this.u),Key_One);
                call GroupEnumUnitsInRange(tempg,x,y,this.range,function SCD1Filter2)
            else
                call GroupEnumUnitsInRange(tempg,x,y,this.range,function SCD1Filter)
            endif
            set SCD1EventID=1
            set Star_TriggerUnit=this.u
            call ForGroup(tempg,function SCD1ForGroupFunc)
            call GroupClear(tempg)
            if (SCD_Exit)then
                set this.disd=this.disd+999999
                set SCD_Exit=false
            endif
        endmethod
        method move takes nothing returns nothing
            local real x
            local real y
            set x=GetUnitX(this.u)+CosBJ(this.d)*this.speed
            set y=GetUnitY(this.u)+SinBJ(this.d)*this.speed
            call SetUnitFacing(u,this.d)
            if (CheakLoc(x,y))then
                set Star_TriggerUnit=this.u  // //调用回调 //SCD1EventID = 4;//在移动时发生
                if (TriggerEvaluate(this.callback))then
                    call TriggerExecute(this.callback)
                endif
                call SetUnitX(this.u,x)
                call SetUnitY(this.u,y)
                set this.disd=this.disd+this.speed
                if (this.callback!=null)then
                    call this.enum(x,y)
                endif
            else
                set this.disd=this.disd+999999
            endif  //BJDebugMsg(R2S(this.dis)+"||"+R2S(this.disd));
        endmethod  //检查墙体碰撞
        method move_b takes nothing returns nothing
            local real x=0
            local real y=0
            local real s1=0
            local integer i=0
            local integer max=0
            if (this.speed>31)then
                set max=R2I(this.speed/31)
                loop
                exitwhen (i>=max)
                    set x=GetUnitX(this.u)+CosBJ(this.d)*31
                    set y=GetUnitY(this.u)+SinBJ(this.d)*31
                    if (X_IsTerrainWalkable(x,y))then
                        if (TriggerEvaluate(this.callback))then  //SCD1EventID = 4;//在移动时发生
                            call TriggerExecute(this.callback)
                        endif
                        call SetUnitX(this.u,x)
                        call SetUnitY(this.u,y)
                        set this.disd=this.disd+31
                        if (this.callback!=null)then
                            call this.enum(x,y)
                        endif
                    else
                        set this.disd=this.disd+999999
                        exitwhen true
                    endif
                    set i=i+1
                endloop
                if (this.dis<this.disd)then
                    set s1=Math.Modulo(this.speed,31)
                    set x=GetUnitX(this.u)+CosBJ(this.d)*s1
                    set y=GetUnitY(this.u)+SinBJ(this.d)*s1
                    if (X_IsTerrainWalkable(x,y))then
                        if (TriggerEvaluate(this.callback))then  //SCD1EventID = 4;//在移动时发生
                            call TriggerExecute(this.callback)
                        endif
                        call SetUnitX(this.u,x)
                        call SetUnitY(this.u,y)
                        set this.disd=this.disd+s1
                        if (this.callback!=null)then
                            call this.enum(x,y)
                        endif
                    else
                        set this.disd=this.disd+999999
                    endif
                endif
            else
                set x=GetUnitX(this.u)+CosBJ(this.d)*this.speed
                set y=GetUnitY(this.u)+SinBJ(this.d)*this.speed
                if (X_IsTerrainWalkable(x,y))then
                    if (TriggerEvaluate(this.callback))then  //SCD1EventID = 4;//在移动时发生
                        call TriggerExecute(this.callback)
                    endif
                    call SetUnitX(this.u,x)
                    call SetUnitY(this.u,y)
                    set this.disd=this.disd+this.speed
                    if (this.callback!=null)then
                        call this.enum(x,y)
                    endif
                else
                    set this.disd=this.disd+999999
                endif
            endif
        endmethod
        method onDestroy takes nothing returns nothing
            call DestroyGroup(this.pg)  // DestroyGroup(LoadGroupHandle(StarBaseHT,GetHandleId(this.u),Key_One)); // RemoveSavedHandle(StarBaseHT,GetHandleId(this.u),Key_One);
            set this.u=null
            set this.callback=null
        endmethod
    endstruct
    function SCD1TE takes nothing returns nothing
        local integer i=0
        local StarCharge__SCData1 scd
        if (StarCharge__SCData1.index==0)then
            set StarCharge__SCData1.Paused=true
            call PauseTimer(GetExpiredTimer())
        endif
        loop
        exitwhen (i>=StarCharge__SCData1.index)
            set scd_now_id=i
            set scd=SCData1List[i]
            if (scd.b)then
                call scd.move_b()  //BJDebugMsg("2");
            else
                call scd.move()  //BJDebugMsg("3");
            endif
            if (scd.disd>=scd.dis)then
                set SCData1List[i]=SCData1List[StarCharge__SCData1.index]  //BJDebugMsg("4");
                if (scd.callback!=null)then
                    set Star_TriggerUnit=scd.u
                    set Star_TargetUnit=null
                    if (scd.disd>99999)then
                        set SCD1EventID=2
                    else
                        set SCD1EventID=3
                    endif
                    if (TriggerEvaluate(scd.callback))then
                        call TriggerExecute(scd.callback)
                    endif
                endif  //BJDebugMsg("摧毁了一个成员");
                set StarCharge__SCData1.index=StarCharge__SCData1.index-1
                call scd.destroy()
                set i=i-1
            endif
            set i=i+1
        endloop
    endfunction
    function StarChargeBase takes unit u,real d,real dis,real time,real r,boolean b,trigger t returns nothing  //命令单位向目标点发起冲锋，冲锋角度为，冲锋距离为，冲锋时间为，碰撞体积 ,检查墙体碰撞->,回调触发器为->
        local StarCharge__SCData1 scd
        local real s
        set s=dis/(time/0.02)
        set scd=StarCharge__SCData1.create(u,s,d,dis,r,b,t)
        set SCData1List[StarCharge__SCData1.index-1]=scd
        set scd.onlyOne=true
        if (StarCharge__SCData1.Paused)then
            call TimerStart(StarCharge__SCData1.STimer,0.02,true,function SCD1TE)
        endif
    endfunction  //命令单位向目标点发起冲锋，冲锋角度为，冲锋距离为，冲锋时间为，碰撞体积 ,检查墙体碰撞->,禁止重复伤害->,回调触发器为->
    function StarChargeII takes unit u,real d,real dis,real time,real r,boolean b,boolean b2,trigger t returns nothing
        local StarCharge__SCData1 scd
        local real s
        set s=dis/(time/0.02)
        set scd=StarCharge__SCData1.create(u,s,d,dis,r,b,t)
        if (b2)then
            set scd.pg=CreateGroup()  // if(!HaveSavedHandle(StarBaseHT,GetHandleId(u),Key_One){SaveGroupHandle(StarBaseHT,GetHandleId(u),Key_One,CreateGroup());}
            set scd.onlyOne=true
        endif
        set SCData1List[StarCharge__SCData1.index-1]=scd
        if (StarCharge__SCData1.Paused)then
            call TimerStart(StarCharge__SCData1.STimer,0.02,true,function SCD1TE)
        endif
    endfunction  //命令单位向目标点发起冲锋，冲锋角度为，冲锋距离为，冲锋时间为，碰撞体积 ,检查墙体碰撞->,禁止重复伤害->,回调触发器为->
    function StarChargeEX takes unit u,real d,real dis,real time,real r,boolean b,boolean b2,trigger t returns nothing
        local StarCharge__SCData1 scd
        local real s
        set s=dis/(time/0.02)  // scd = SCData1List[SCData1.index].create(u,s,d,dis,r,b,t);
        set scd=StarCharge__SCData1.create(u,s,d,dis,r,b,t)
        if (b2)then
            set scd.pg=CreateGroup()  // if(!HaveSavedHandle(StarBaseHT,GetHandleId(u),Key_One){SaveGroupHandle(StarBaseHT,GetHandleId(u),Key_One,CreateGroup());}
            set scd.onlyOne=true
        endif
        set SCData1List[StarCharge__SCData1.index-1]=scd
        if (StarCharge__SCData1.Paused)then
            call TimerStart(StarCharge__SCData1.STimer,0.02,true,function SCD1TE)
        endif
    endfunction  //命令单位向目标点发起冲锋，冲锋角度为，冲锋距离为，冲锋时间为，碰撞体积 ,伤害值 , 检查墙体碰撞-> 
    function StarChargeI takes unit u,real d,real dis,real time,real r,real value,boolean b returns nothing
        local StarCharge__SCData1 scd
        local real s
        set s=dis/(time/0.02)
        set scd=StarCharge__SCData1.create(u,s,d,dis,r,b,StarCharge__basetrig)
        set scd.pg=CreateGroup()  // if(!HaveSavedHandle(StarBaseHT,GetHandleId(u),Key_One))
        if (not (HaveSavedReal(StarBaseHT,GetHandleId(u),StarCharge__K_Value)))then  // { //     SaveGroupHandle(StarBaseHT,GetHandleId(u),Key_One,CreateGroup()); // }
            call SaveReal(StarBaseHT,GetHandleId(u),StarCharge__K_Value,value)
        endif
        set scd.onlyOne=true
        set SCData1List[StarCharge__SCData1.index-1]=scd
        if (StarCharge__SCData1.Paused)then
            call TimerStart(StarCharge__SCData1.STimer,0.02,true,function SCD1TE)
        endif
    endfunction  //获取触发的事件ID
    function StarCharge_GetEventId takes nothing returns integer
        return SCD1EventID
    endfunction
        function StarCharge__anon__0 takes nothing returns nothing
            local real v=LoadReal(StarBaseHT,GetHandleId(Star_GetTriggerUnit()),StarCharge__K_Value)
            if (IsUnitEnemy(Star_GetTargetUnit(),GetOwningPlayer(Star_GetTriggerUnit())))then
                call UnitDamageTarget(Star_GetTriggerUnit(),Star_GetTargetUnit(),v,false,false,ATTACK_TYPE_MELEE,DAMAGE_TYPE_UNIVERSAL,WEAPON_TYPE_WHOKNOWS)
            endif
        endfunction
    function StarCharge__onInit takes nothing returns nothing
        set StarCharge__SCData1.STimer=CreateTimer()
        call TimerStart(StarCharge__SCData1.STimer,0.02,true,function SCD1TE)
        call TriggerAddAction(StarCharge__basetrig,function StarCharge__anon__0)
    endfunction
    function StarCharerEX takes nothing returns nothing
    endfunction

