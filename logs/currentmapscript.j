            call TimerStart(ydl_timer, 0.01, false, function Trig_DMboss____________02Func004Func014Func003T)
        else
        endif
        // 暗黑闪光
        if ((YDWEGetUnitAbilityDataString(GetTriggerUnit(), GetSpellAbilityId(), 1, 216) == "3")) then
