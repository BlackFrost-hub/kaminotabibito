        call TimerStart(ydl_timer, 0.50, false, function Trig_Hero____________ZHFunc003Func013T)
    else
    endif
    if ((GetUnitTypeId(GetTriggerUnit()) == 'H013')) then
        if ((GetEventDamage() >= GetUnitState(GetTriggerUnit(), UNIT_STATE_LIFE)) and (LoadBoolean(YDHT, GetHandleId( GetTriggerUnit()), 0x07498467) == false)) then
