function Trig_world_________uFunc003Func003T takes nothing returns nothing
    call DisplayCineFilter( false )
    call FlushChildHashtable(YDLOC, GetHandleId(GetExpiredTimer()))
    call DestroyTimer(GetExpiredTimer())
endfunction
function Trig_world_________uActions takes nothing returns nothing
    local timer ydl_timer
    local integer ydl_localvar_step = LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xCFDE6C76) 
 set ydl_localvar_step = ydl_localvar_step + 3 
 call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xCFDE6C76, ydl_localvar_step) 
 call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7, ydl_localvar_step)
    call SavePlayerHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x48E3E75F, DzGetTriggerUIEventPlayer())
    call SaveUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xB06AB615, LoadUnitHandle(YDHT, GetHandleId( LoadPlayerHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x48E3E75F)), 0xB06AB615))
    if ((LoadInteger(YDHT, StringHash( "剧情进度"), 0x87DDA352) != 16) and (UnitHasBuffBJ(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xB06AB615), 'B001') == true)) then
        if ((LoadPlayerHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x48E3E75F) == GetLocalPlayer())) then
            call DzFrameShow( LoadInteger(YDHT, StringHash( "worldmap"), 0x7D515EF5), false )
            call CinematicFilterGenericBJ( 0.50, BLEND_MODE_BLEND, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 15.00, 15.00, 15.00, 15.00, 0, 0, 0, 0 )
        else
        endif
        set ydl_timer = CreateTimer()
        call TimerStart(ydl_timer, 2.50, false, function Trig_world_________uFunc003Func003T)
        call Sound3DII_Mp3Play( "XT\\YX-CS.mp3", LoadPlayerHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x48E3E75F) )
        call SetUnitPosition( LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xB06AB615), -25675.10, -27139.60 )
        call StarOther_PanCameraToTimedForPlayer( LoadPlayerHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x48E3E75F), -25675.10, -27139.60, 0.03 )
    else
    endif
    call FlushChildHashtable(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step)
    set ydl_timer = null
endfunction
