//library SP0002:
    function SetUnitDisplayState takes unit u,real a,real b,real c,real d,integer e,integer f,integer g,integer h,real i,real j returns nothing
        call SetUnitScalePercent(u,a,b,c)
        call SetUnitTimeScalePercent(u,d)
        call SetUnitVertexColor(u,e,f,g,h)
        call SetUnitFlyHeight(u,i,j)
    endfunction

//library SP0002 ends
//library SUSPEND:
function SUSPEND__SuspendTwo takes nothing returns nothing
    local timer T = GetExpiredTimer()
    local unit u = LoadUnitHandle(SUSPEND__HS_S,GetHandleId(T),1)
    call EXPauseUnit(u, false)
    call FlushChildHashtable(SUSPEND__HS_S,GetHandleId(T))
    call FlushChildHashtable(SUSPEND__HS_S,GetHandleId(u))
    call DestroyTimer(T)
    set T = null
    set u = null
endfunction
 
function GS_Suspend takes unit u , real time returns nothing 
    local timer T = LoadTimerHandle(SUSPEND__HS_S,GetHandleId(u),1)
    if (TimerGetRemaining(T) == 0) then
        set T = CreateTimer()
        call EXPauseUnit(u, true)
        call SaveUnitHandle(SUSPEND__HS_S,GetHandleId(T),1,u)
        call SaveTimerHandle(SUSPEND__HS_S,GetHandleId(u),1,T)
    endif
    call TimerStart(T,time,false,function SUSPEND__SuspendTwo)
    set T = null
endfunction
function GS_IsUnitSuspending takes unit u returns boolean
    local timer T = LoadTimerHandle(SUSPEND__HS_S,GetHandleId(u),1)
    local boolean b = not (TimerGetRemaining(T) == 0)
    set T = null
    return b
endfunction
function GS_LoadSuspend takes unit u returns real
    return TimerGetRemaining(LoadTimerHandle(SUSPEND__HS_S,GetHandleId(u),1))
endfunction
function GS_UnitSuspend takes unit u ,integer i, real r returns nothing
    if i == 0 then
        call GS_Suspend(u,TimerGetRemaining(LoadTimerHandle(SUSPEND__HS_S,GetHandleId(u),1)) + r)
    endif
    if i == 1 then
        call GS_Suspend(u,RMaxBJ(TimerGetRemaining(LoadTimerHandle(SUSPEND__HS_S,GetHandleId(u),1)) - r,0))
    endif
    if i == 2 then
        call GS_Suspend(u,RMaxBJ(TimerGetRemaining(LoadTimerHandle(SUSPEND__HS_S,GetHandleId(u),1)),r))
    endif
endfunction

//library SUSPEND ends
