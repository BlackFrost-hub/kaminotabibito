        call SetPlayerAbilityAvailable( GetOwningPlayer(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xE5449640)), 'A0CK', true )
        call UnitRemoveAbility( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xE5449640), 'A0DK' )
        call FlushChildHashtable(YDLOC, GetHandleId(GetExpiredTimer()))
        call DestroyTimer(GetExpiredTimer())
