    //private:  //回城读条 //
    function SUI2_GetPlayer takes nothing returns player  //获取触发玩家
        return StarUI2__cbplayer
    endfunction  //获取触发的事件ID
    function SUI2_GetEventID takes nothing returns integer
        return StarUI2__cbeid
    endfunction  //获取已经吟唱时间
    function SUI2_GetTimedOnStop takes nothing returns real
        return StarUI2__timed
    endfunction  //被打断
    function SUI2_GetIsStopd takes nothing returns boolean
        return StarUI2__cbeid==2
    endfunction  //初始化玩家数量
    function SUI2_SetPlayers takes integer count returns nothing
        set StarUI2__counts=count
    endfunction  //是否隐藏血条
    function SUI2_HideHpbar takes integer id,boolean b returns nothing
        if (b)then  //显示血条
            set StarUI2__targetunit[id]=null  //Print("隐藏Player("+I2S(id)+")的血条显示！"); //为玩家:id 隐藏UI
            if (GetLocalPlayer()==Player(id))then
                call DzFrameShow(StarUI2__frames[4],false)
                call DzFrameShow(StarUI2__frames[5],false)
                call DzFrameShow(StarUI2__frames[6],false)
                call DzFrameShow(StarUI2__frames[7],false)
                call DzFrameShow(StarUI2__frames[8],false)
            endif
        elseif (GetLocalPlayer()==Player(id))then  //显示UI
            call DzFrameShow(StarUI2__frames[4],true)
            call DzFrameShow(StarUI2__frames[5],true)
            call DzFrameShow(StarUI2__frames[6],true)
            call DzFrameShow(StarUI2__frames[7],true)
            call DzFrameShow(StarUI2__frames[8],true)
        endif
    endfunction  //设置血条模型
    function SUI2_SetHpBarModel takes integer pid,string s1,string s2 returns nothing
        if (GetLocalPlayer()==Player(pid))then
            call DzFrameSetModel(StarUI2__frames[4],s1,0,0)
            call DzFrameSetModel(StarUI2__frames[5],s2,0,0)
            call DzFrameSetAnimate(StarUI2__frames[4],0,false)
            call DzFrameSetAnimateOffset(StarUI2__frames[4],0.90)
            call DzFrameSetAbsolutePoint(StarUI2__frames[4],7,0.4-StarUI2__hpbarx,0.525-StarUI2__hpbary)
            call DzFrameSetSize(StarUI2__frames[4],0.01,0.01)
            call DzFrameSetPoint(StarUI2__frames[5],4,StarUI2__frames[4],4,0,0.0)
        endif
    endfunction  //设置血条风格
    function SUI2_SetHpBarStyle takes integer pid,integer id returns nothing
        if (id==1)then
            call SUI2_SetHpBarModel(pid,"UI_shengmingzhi_g2.mdl","UI_shengmingzhi-beijing_g2.mdl")
        elseif (id==2)then
            call SUI2_SetHpBarModel(pid,"UI_shengmingzhi_gb2.mdl","UI_shengmingzhi-beijing_gb2.mdl")
        elseif (id==3)then
            call SUI2_SetHpBarModel(pid,"UI_shengmingzhi_o2.mdl","UI_shengmingzhi-beijing_o2.mdl")
        elseif (id==4)then
            call SUI2_SetHpBarModel(pid,"UI_shengmingzhi_r2.mdl","UI_shengmingzhi-beijing_r2.mdl")
        elseif (id==5)then
            call SUI2_SetHpBarModel(pid,"UI_shengmingzhi_p2.mdl","UI_shengmingzhi-beijing_p2.mdl")
        endif
    endfunction  //隐藏UI
    function SUI2_HideUI takes integer id,boolean b returns nothing
        if (b)then
            if (GetLocalPlayer()==Player(id))then  //为玩家:id 隐藏UI
                call DzFrameShow(StarUI2__frames[0],false)
                call DzFrameShow(StarUI2__frames[1],false)
                call DzFrameShow(StarUI2__frames[2],false)
                call DzFrameShow(StarUI2__frames[3],false)
            endif
        elseif (GetLocalPlayer()==Player(id))then  //显示UI
            call DzFrameShow(StarUI2__frames[0],true)
            call DzFrameShow(StarUI2__frames[1],true)
            call DzFrameShow(StarUI2__frames[2],true)
            call DzFrameShow(StarUI2__frames[3],true)
        endif
    endfunction  //刷新血条显示
    function SUI2_BrushHpbar takes integer id returns nothing
        local real hp=GetUnitState(StarUI2__targetunit[id],UNIT_STATE_LIFE)
        local real hpmax=GetUnitState(StarUI2__targetunit[id],UNIT_STATE_MAX_LIFE)
        local real s=hp/hpmax  // string str = R2SW(hp,1,1);
        local string str="|c0074fa27["+R2SW(s*100,1,1)+"%]|r"  // str = str + "/"; // str = str + R2SW(hpmax,1,1);
        if (GetLocalPlayer()==Player(id))then
            call DzFrameSetAnimateOffset(StarUI2__frames[4],s)  //设置血条进度
            call DzFrameSetText(StarUI2__frames[6],str)
        endif
        if (hp<0)then
            call SUI2_HideHpbar(id,true)
        endif
    endfunction  //刷新UI
    function SUI2_BrushUI takes integer id returns nothing
        local real s=StarUI2__time[id]/StarUI2__timemax[id]
        local string str=R2SW(StarUI2__timemax[id]-StarUI2__time[id],1,1)
        if (StarUI2__uistyle!=7)then
            set str=str+"/"
            set str=str+R2SW(StarUI2__timemax[id],1,1)
        else
            set str="|c00cefafa"+str+"|r"
        endif
        if (GetLocalPlayer()==Player(id))then
            call DzFrameSetAnimateOffset(StarUI2__frames[0],1-s)
            call DzFrameSetText(StarUI2__frames[2],str)
        endif
    endfunction  //显示/隐藏BOSS施法条
    function SUI2_HideUI_Boss takes boolean b returns nothing
        if (b)then
            call DzFrameShow(StarUI2__frames[100],false)
            call DzFrameShow(StarUI2__frames[101],false)
            call DzFrameShow(StarUI2__frames[102],false)
            call DzFrameShow(StarUI2__frames[103],false)
        else
            call DzFrameShow(StarUI2__frames[100],true)
            call DzFrameShow(StarUI2__frames[101],true)
            call DzFrameShow(StarUI2__frames[102],true)
            call DzFrameShow(StarUI2__frames[103],true)
        endif
    endfunction  //BOSS的施法条刷新
    function SUI2_BrushUI_Boss takes nothing returns nothing
        local integer nid=100
        local real s=StarUI2__time[nid]/StarUI2__timemax[nid]
        local string str=R2SW(StarUI2__timemax[nid]-StarUI2__time[nid],1,1)
        if (StarUI2__uistyle!=7)then
            set str=str+"/"
            set str=str+R2SW(StarUI2__timemax[nid],1,1)
        else
            set str="|c00cefafa"+str+"|r"
        endif
        call DzFrameSetAnimateOffset(StarUI2__frames[100],1-s)
        call DzFrameSetText(StarUI2__frames[102],str)
    endfunction  //计时器事件
    function StarUI2__te takes nothing returns nothing
        local integer i=0
        local boolean b=true  //BOSS施法条部分
        if (StarUI2__time[100]<StarUI2__timemax[100])then
            set StarUI2__time[100]=StarUI2__time[100]+StarUI2__dealtTime
            call SUI2_BrushUI_Boss()
            set b=false
            if (StarUI2__time[100]>=StarUI2__timemax[100])then
                call SUI2_HideUI_Boss(true)
            endif
        endif
        loop
        exitwhen (i>=StarUI2__counts)
            if (StarUI2__time[i]<StarUI2__timemax[i])then
                set b=false  //BJDebugMsg("123"); //施法条部分
                set StarUI2__time[i]=StarUI2__time[i]+StarUI2__dealtTime
                call SUI2_BrushUI(i)
                if (StarUI2__time[i]>=StarUI2__timemax[i])then
                    set StarUI2__cbplayer=Player(i)  //结束读条 //调用触发回调
                    set StarUI2__cbeid=1
                    set StarUI2__timed=StarUI2__timemax[i]
                    if (TriggerEvaluate(StarUI2__cbtrig[i]))then
                        call TriggerExecute(StarUI2__cbtrig[i])
                    endif
                    set StarUI2__timemax[i]=0
                    set StarUI2__time[i]=0
                    call SUI2_HideUI(i,true)
                endif
            endif  //BJDebugMsg(GetUnitName(targetunit[i]));
            if (StarUI2__targetunit[i]!=null)then
                if (not (SU_IsUnitDie(StarUI2__targetunit[i])))then
                    set b=false  //BJDebugMsg("brush"); //血条部分
                    call SUI2_BrushHpbar(i)
                else  //Print("隐藏血条");
                    call SUI2_HideHpbar(i,true)
                endif
            endif
            set i=i+1
        endloop
        if (b)then
            set StarUI2__TimerIsRun=false  //BJDebugMsg("stopd");
            call PauseTimer(StarUI2__maintimer)
        endif
    endfunction  //显示BOSS施法条 时间 颜色
    function SUI2_SetTime_Boss takes real t,string text returns nothing
        local integer id=100
        if (t>0)then
            set StarUI2__time[id]=0
            set StarUI2__timemax[id]=t
            call SUI2_HideUI_Boss(false)
            if (not StarUI2__TimerIsRun)then
                set StarUI2__TimerIsRun=true
                call TimerStart(StarUI2__maintimer,StarUI2__dealtTime,true,function StarUI2__te)
            endif
            call DzFrameSetText(StarUI2__frames[103],text)
        endif
    endfunction
    function SUI2_Stop takes integer id returns real  //中断读条
        local real cbreal=StarUI2__time[id]
        if (StarUI2__timemax[id]>0)then
            set StarUI2__cbplayer=Player(id)
            set StarUI2__cbeid=2
            set StarUI2__timed=cbreal
            if (TriggerEvaluate(StarUI2__cbtrig[id]))then
                call TriggerExecute(StarUI2__cbtrig[id])
            endif
            call SUI2_HideUI(id,true)
            set StarUI2__time[id]=0
            set StarUI2__timemax[id]=0
        endif
        return cbreal
    endfunction  //unui 设置自定义模型
    function SUI2_SetModel takes integer id,string s1,string s2 returns nothing
        if (GetLocalPlayer()==Player(id))then
            call DzFrameSetModel(StarUI2__frames[0],s1,0,0)
            call DzFrameSetModel(StarUI2__frames[1],s2,0,0)
            call DzFrameSetAnimate(StarUI2__frames[0],0,false)
            call DzFrameSetAnimateOffset(StarUI2__frames[0],0.90)
        endif
    endfunction  //设置样式（颜色）
    function SUI2_SetColor takes integer id,integer color returns nothing
        set StarUI2__uistyle=color
        if (color==1)then
            if (GetLocalPlayer()==Player(id))then
