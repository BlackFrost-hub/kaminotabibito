            if ((IsUnitType(ydl_unit, UNIT_TYPE_ANCIENT) == false) and (IsUnitEnemy(ydl_unit, GetOwningPlayer(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x76ABBC1D))) == true) and (IsUnitAliveBJ(ydl_unit) == true) and (SU_IsUnitInvincible(ydl_unit) == false)) then
