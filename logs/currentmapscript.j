function InitTrig___________________________DMPS takes nothing returns nothing
    set gg_trg___________________________DMPS = CreateTrigger()
    call TriggerRegisterPlayerUnitEventSimple( gg_trg___________________________DMPS, Player(0), EVENT_PLAYER_UNIT_DEATH )
    call TriggerRegisterPlayerUnitEventSimple( gg_trg___________________________DMPS, Player(1), EVENT_PLAYER_UNIT_DEATH )
    call TriggerRegisterPlayerUnitEventSimple( gg_trg___________________________DMPS, Player(2), EVENT_PLAYER_UNIT_DEATH )
    call TriggerRegisterPlayerUnitEventSimple( gg_trg___________________________DMPS, Player(3), EVENT_PLAYER_UNIT_DEATH )
    call TriggerRegisterPlayerUnitEventSimple( gg_trg___________________________DMPS, Player(5), EVENT_PLAYER_UNIT_DEATH )
    call TriggerRegisterPlayerUnitEventSimple( gg_trg___________________________DMPS, Player(7), EVENT_PLAYER_UNIT_DEATH )
    call TriggerRegisterPlayerUnitEventSimple( gg_trg___________________________DMPS, Player(PLAYER_NEUTRAL_AGGRESSIVE), EVENT_PLAYER_UNIT_DEATH )
    call TriggerRegisterPlayerUnitEventSimple( gg_trg___________________________DMPS, Player(PLAYER_NEUTRAL_PASSIVE), EVENT_PLAYER_UNIT_DEATH )
    call TriggerAddAction(gg_trg___________________________DMPS, function Trig___________________________DMPSActions)
endfunction
//===========================================================================
// Trigger: 1冲锋系统CFXT
//===========================================================================
function Trig_1____________CFXTActions takes nothing returns nothing
    local integer ydl_localvar_step = LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xCFDE6C76) 
 set ydl_localvar_step = ydl_localvar_step + 3 
 call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xCFDE6C76, ydl_localvar_step) 
 call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7, ydl_localvar_step)
    call SaveUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x911D5DC2, Star_GetTriggerUnit())
    if ((HaveSavedReal(YDHT, GetHandleId( LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x911D5DC2)), 0x383F71B9) == true)) then
        call SaveReal(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x0050BBB8, LoadReal(YDHT, GetHandleId( LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x911D5DC2)), 0x383F71B9))
        call SaveReal(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xA9F50110, LoadReal(YDHT, GetHandleId( LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x911D5DC2)), 0xA9F50110))
        call RemoveSavedReal(YDHT, GetHandleId( LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x911D5DC2)), 0xA9F50110)
        call RemoveSavedReal(YDHT, GetHandleId( LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x911D5DC2)), 0x383F71B9)
        call SaveReal(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xA99320FA, ((GetUnitX(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x911D5DC2)))+( ((32.00)*( CosBJ(LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xA9F50110)))))))
        call SaveReal(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xFDF65382, ((GetUnitY(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x911D5DC2)))+( ((32.00)*( SinBJ(LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xA9F50110)))))))
        if ((X_IsTerrainWalkable(LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xA99320FA), LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xFDF65382)) == false)) then
            call SFB_setBuff( LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x911D5DC2), 0, LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x0050BBB8) )
        else
        endif
    else
    endif
    call FlushChildHashtable(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step)
endfunction
//===========================================================================
function InitTrig_1____________CFXT takes nothing returns nothing
    set gg_trg_1____________CFXT = CreateTrigger()
    call TriggerAddAction(gg_trg_1____________CFXT, function Trig_1____________CFXTActions)
endfunction
//===========================================================================
// Trigger: 各种游戏小技能整合ZH
//===========================================================================
function Trig____________________________ZHFunc002Func002003003 takes nothing returns boolean
    return (((IsUnitAlly(GetFilterUnit(), GetTriggerPlayer()) == true) and ((IsUnitOwnedByPlayer(GetFilterUnit(), Player(PLAYER_NEUTRAL_PASSIVE)) == false) and (GetUnitTypeId(GetFilterUnit()) != 'ewsp'))))
endfunction
function Trig____________________________ZHFunc002Func007Func001A takes nothing returns nothing
    call SaveUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7), 0xB3542E15, GetEnumUnit())
endfunction
function Trig____________________________ZHFunc002Func008Func002Func005Func004A takes nothing returns nothing
    call SaveUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15, GetEnumUnit())
    if ((GetUnitTypeId(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15)) == 'n025')) then
        call SaveUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xFE88D7FF, CreateUnitAtLoc(Player(PLAYER_NEUTRAL_PASSIVE), 'e071', LoadLocationHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x2A829619), 0))
