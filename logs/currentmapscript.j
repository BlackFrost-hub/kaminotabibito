function config takes nothing returns nothing
    call SetMapName( "神隐の世界" )
    call smd( "" )
    call SetPlayers( 7 )
    call SetTeams( 7 )
    call SetGamePlacement( MAP_PLACEMENT_TEAMS_TOGETHER )
    call DefineStartLocation( 0, -384.0, -256.0 )
    call DefineStartLocation( 1, -25280.0, 18688.0 )
    call DefineStartLocation( 2, -25216.0, 18752.0 )
    call DefineStartLocation( 3, -25152.0, 18688.0 )
    call DefineStartLocation( 4, -25152.0, 18752.0 )
    call DefineStartLocation( 5, -25216.0, 18752.0 )
    call DefineStartLocation( 6, -25152.0, 18752.0 )
    // Player setup
    call InitCustomPlayerSlots( )
    call InitCustomTeams( )
    call InitAllyPriorities( )
endfunction
 
