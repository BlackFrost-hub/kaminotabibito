            endif
        endif
        // 这里是弹幕的音效
        if ((GetUnitTypeId(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7), 0x2289B0A7)) == 'E001')) then
