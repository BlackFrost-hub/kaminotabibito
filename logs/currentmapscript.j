    struct Argb extends array
    //! pragma implicitthis
        static Argb Red=0xFFFF0303
        static Argb Orange=0xFFFE8A0E
        static Argb Yellow=0xFFFFFC01
        static Argb Green=0xFF20C000
        static Argb Cyan=0xFF1CE6B9
        static Argb Blue=0xFF0042FF
        static Argb Purple=0xFF540081
        static Argb White=0xFFFFFFFF
        static Argb Black=0xFF000000
        static method create takes integer a,integer r,integer g,integer b returns Argb
            return b+g*0x100+r*0x10000+a*0x1000000
        endmethod  // Alpha
        method operator A takes nothing returns integer
            if (integer(this)<0)then
                return 0x80+(-(-integer(this)+0x80000000))/0x1000000
            endif
            return (integer(this))/0x1000000
        endmethod
        method operator A= takes integer alpha returns Argb
            local integer a=0
            local integer r=0
            local integer g=0
            local integer b=0
            local integer col=integer(this)
            if (col<0)then
                set col=-(-col+0x80000000)
                set a=0x80+col/0x1000000
                set col=col-(a-0x80)*0x1000000
            else
                set a=col/0x1000000
                set col=col-a*0x1000000
            endif
            set r=col/0x10000
            set col=col-r*0x10000
            set g=col/0x100
            set b=col-g*0x100
            return Argb(b+g*0x100+r*0x10000+alpha*0x1000000)
        endmethod  // Red
        method operator R takes nothing returns integer
            local integer c=integer(this)*0x100
            if (c<0)then
                return 0x80+(-(-c+0x80000000))/0x1000000
            endif
            return c/0x1000000
        endmethod
        method operator R= takes integer red returns Argb
            local integer a=0
            local integer r=0
            local integer g=0
            local integer b=0
            local integer col=integer(this)
            if (col<0)then
                set col=-(-col+0x80000000)
                set a=0x80+col/0x1000000
                set col=col-(a-0x80)*0x1000000
            else
                set a=col/0x1000000
                set col=col-a*0x1000000
            endif
            set r=col/0x10000
            set col=col-r*0x10000
            set g=col/0x100
            set b=col-g*0x100
            return Argb(b+g*0x100+red*0x10000+a*0x1000000)
        endmethod  // Green
        method operator G takes nothing returns integer
            local integer c=integer(this)*0x10000
            if (c<0)then
                return 0x80+(-(-c+0x80000000))/0x1000000
            endif
            return c/0x1000000
        endmethod
        method operator G= takes integer green returns Argb
            local integer a=0
            local integer r=0
            local integer g=0
            local integer b=0
            local integer col=integer(this)
            if (col<0)then
                set col=-(-col+0x80000000)
                set a=0x80+col/0x1000000
                set col=col-(a-0x80)*0x1000000
            else
                set a=col/0x1000000
                set col=col-a*0x1000000
            endif
            set r=col/0x10000
            set col=col-r*0x10000
            set g=col/0x100
            set b=col-g*0x100
            return Argb(b+green*0x100+r*0x10000+a*0x1000000)
        endmethod  // Blue
        method operator B takes nothing returns integer
            local integer c=integer(this)*0x1000000
            if (c<0)then
                return 0x80+(-(-c+0x80000000))/0x1000000
            endif
            return c/0x1000000
        endmethod
        method operator B= takes integer blue returns Argb
            local integer a=0
            local integer r=0
            local integer g=0
            local integer b=0
            local integer col=integer(this)
            if (col<0)then
                set col=-(-col+0x80000000)
                set a=0x80+col/0x1000000
                set col=col-(a-0x80)*0x1000000
            else
                set a=col/0x1000000
                set col=col-a*0x1000000
            endif
            set r=col/0x10000
            set col=col-r*0x10000
            set g=col/0x100
            set b=col-g*0x100
            return Argb(blue+g*0x100+r*0x10000+a*0x1000000)
        endmethod  //  Mixes two colors, s would be a number 0<=s<=1 that determines
        static method Mix takes Argb one,Argb other,real ratio returns Argb  //  the weight given to color c2. // //  Mix(c1,c2,0)   = c1 //  Mix(c1,c2,1)   = c2 //  Mix(c1,c2,0.5) = Mixing the colors c1 &&  c2 in equal proportions.
            return Argb(R2I(other.B*ratio+one.B*(1-ratio)+0.5)+R2I(other.G*ratio+one.G*(1-ratio)+0.5)*0x100+R2I(other.R*ratio+one.R*(1-ratio)+0.5)*0x10000+R2I(other.A*ratio+one.A*(1-ratio)+0.5)*0x1000000)
        endmethod
        method ToString takes nothing returns string
            local string result=""
            local integer  array arr
            local integer i
            set arr[0]=this.A
            set arr[1]=this.R
            set arr[2]=this.G
            set arr[3]=this.B
            set i=0
            loop
            exitwhen (i>=4)
                if (arr[i]<16)then
                    set result=result+"0"
                endif
                set result=result+Convert.Int2S(arr[i],16)
            set i = i+1
            endloop
            return result
        endmethod
    endstruct
    struct Vector2 
    //! pragma implicitthis
        static Vector2 Zero
        static Vector2 UnitX
        static Vector2 UnitY
        static Vector2 UnitScale
        static Vector2 NegativeUnitX
        static Vector2 NegativeUnitY
        static Vector2 Temp
        real X=0.0
        real Y=0.0
        method operator< takes Vector2 that returns boolean
            return this.X<that.X and this.Y<that.Y
        endmethod
        method operator SquaredLength takes nothing returns real
            return this.X*this.X+this.Y*this.Y
        endmethod
        method operator Length takes nothing returns real
            return Math.Sqrt(this.X*this.X+this.Y*this.Y)
        endmethod
        method operator Length= takes real value returns nothing
            call this.Scale(value*Math.InvSqrt(this.SquaredLength))
        endmethod
        method operator Angle takes nothing returns real
            return Atan2(this.Y,this.X)
        endmethod
        method operator Angle= takes real value returns nothing
            local real length=this.Length
            set this.X=length*Cos(value)
            set this.Y=length*Sin(value)
        endmethod
        method Equals takes Vector2 that returns boolean
            return Math.IsZero(this.X-that.X) and Math.IsZero(this.Y-that.Y)
        endmethod
        method IsZero takes nothing returns boolean
            return Math.IsZero(this.X) and Math.IsZero(this.Y)
        endmethod
        method Reset takes real x,real y returns Vector2
            set this.X=x
            set this.Y=y
            return this
        endmethod
        method ResetXY takes real x,real y returns Vector2
            set this.X=x
            set this.Y=y
            return this
        endmethod
        method Copy takes Vector2 that returns Vector2
            return this.Reset(that.X,that.Y)
        endmethod
        method GetCopy takes nothing returns Vector2
            return Vector2.create().Reset(this.X,this.Y)
        endmethod
        method Normalize takes nothing returns real
            local real length=this.Length  // Will also work for zero-sized vectors, but will change nothing
            if (length!=0)then
                call this.Scale(1/length)
            endif
            return length
        endmethod
        method GetNormalizedCopy takes nothing returns Vector2  // Generates a vector perpendicular to this vector (eg an 'up' vector).
            local Vector2 n=this.GetCopy()
            call n.Normalize()
            return n
        endmethod
        method GetNormal takes nothing returns Vector2
            return Vector2.create().Reset(-this.Y,this.X)
        endmethod
        method GetRandomDeviant takes real angle returns Vector2
            local real cosa
            local real sina
            set angle=angle*Math.Random
            set cosa=Cos(angle)
            set sina=Sin(angle)
            return Vector2.create().Reset(this.X*cosa-this.Y*sina,this.X*sina+this.Y*cosa)
        endmethod
        method Swap takes Vector2 that returns nothing
            local real temp
            set temp=this.X
            set this.X=that.X
            set that.X=temp
            set temp=this.Y
            set this.Y=that.Y
            set that.Y=temp
        endmethod
        method GetSquaredDistanceWith takes Vector2 that returns real
            return (this.X-that.X)*(this.X-that.X)+(this.Y-that.Y)*(this.Y-that.Y)
        endmethod
        method GetDistanceWith takes Vector2 that returns real
            return Math.Sqrt((this.X-that.X)*(this.X-that.X)+(this.Y-that.Y)*(this.Y-that.Y))
        endmethod
        method GetAngleWith takes Vector2 that returns real
            local real mul=this.Length*that.Length
            if ((mul==0))then
                return 0.0
            endif
            return Acos((this.X*that.X+this.Y*that.Y)/mul)
        endmethod
        method GetMiddle takes Vector2 that returns Vector2
            return Vector2.create().Reset((this.X+that.X)/2,(this.Y+that.Y)/2)
        endmethod
        method MakeFloor takes Vector2 that returns Vector2
            if (that.X<this.X)then
                set this.X=that.X
            endif
            if (that.Y<this.Y)then
                set this.Y=that.Y
            endif
            return this
        endmethod
        method MakeCeil takes Vector2 that returns Vector2
            if (that.X>this.X)then
                set this.X=that.X
            endif
            if (that.Y>this.Y)then
                set this.Y=that.Y
            endif
            return this
        endmethod
        method Add takes Vector2 that returns Vector2
            set this.X=this.X+that.X
            set this.Y=this.Y+that.Y
            return this
        endmethod
        method Subtract takes Vector2 that returns Vector2
            set this.X=this.X-that.X
            set this.Y=this.Y-that.Y
            return this
        endmethod
        method Scale takes real factor returns Vector2
            set this.X=this.X*factor
            set this.Y=this.Y*factor
            return this
        endmethod
        method DotProduct takes Vector2 that returns real
            return this.X*that.X+this.Y*that.Y
        endmethod
        method CrossProduct takes Vector2 that returns real
            return this.X*that.Y-this.Y*that.X
        endmethod
        method Project takes Vector2 direction returns Vector2
            local real len2=direction.X*direction.X+direction.Y*direction.Y
            if ((len2==0.0))then
                return 0
            endif
            set len2=(this.X*direction.X+this.Y*direction.Y)/len2
            return this.Reset(direction.X*len2,direction.Y*len2)
        endmethod  //  Creates an interpolated vector between this vector && that vector.
        method Interpolate takes Vector2 that,real k returns Vector2  //      that @param: The that vector to interpolate with. //      k @param: Interpolation value between 0.0 (all the that vector) &&  1.0 (all this vector). //      @return: An interpolated vector. This vector is not modified.
            local Vector2 result=Vector2.allocate()
            local real d=1.0-k
            set result.X=that.X*d+this.X*k
            set result.Y=that.Y*d+this.X*k
            return result
        endmethod
        method IsBetween takes Vector2 begin,Vector2 end returns boolean
            if (begin.X!=end.X)then
                return (begin.X<=this.X and this.X<=end.X) or (begin.X>=this.X and this.X>=end.X)
            endif
            return (begin.Y<=this.Y and this.Y<=end.Y) or (begin.Y>=this.Y and this.Y>=end.Y)
        endmethod
        method IsInCircle takes Vector2 circleOrigin,real circleRadius returns boolean
            return circleRadius>=this.GetDistanceWith(circleOrigin)
        endmethod
        method ToString takes nothing returns string
            return "("+Convert.Real2S(this.X,6)+","+Convert.Real2S(this.Y,6)+")"
        endmethod
        private static method onInit takes nothing returns nothing
            set Vector2.Zero=Vector2.create().Reset(0,0)
            set Vector2.UnitX=Vector2.create().Reset(1,0)
            set Vector2.UnitY=Vector2.create().Reset(0,1)
            set Vector2.UnitScale=Vector2.create().Reset(1,1)
            set Vector2.NegativeUnitX=Vector2.create().Reset(-1,0)
            set Vector2.NegativeUnitY=Vector2.create().Reset(0,-1)
            set Vector2.Temp=Vector2(0).Reset(0,0)
        endmethod
    endstruct
    struct Vector3 
    //! pragma implicitthis
        static Vector3 Zero
        static Vector3 UnitX
        static Vector3 UnitY
        static Vector3 UnitZ
        static Vector3 UnitScale
        static Vector3 NegativeUnitX
        static Vector3 NegativeUnitY
        static Vector3 NegativeUnitZ
        static Vector3 Temp
        private delegate Vector2 Vector2=0
        real Z=0.0
        static method create takes nothing returns Vector3
            local Vector3 this=Vector2.create()
            set this.Vector2=this
            return this
        endmethod
        method destroy takes nothing returns nothing
            call this.Vector2.destroy()
        endmethod
        method operator< takes Vector3 that returns boolean
            return this.X<that.X and this.Y<that.Y and this.Z<that.Z
        endmethod
        method operator SquaredLength takes nothing returns real
            return this.X*this.X+this.Y*this.Y+this.Z*this.Z
        endmethod
        method operator Length takes nothing returns real
            return Math.Sqrt(this.X*this.X+this.Y*this.Y+this.Z*this.Z)
        endmethod
        method operator Length= takes real value returns nothing
            call this.Scale(value*Math.InvSqrt(this.SquaredLength))
        endmethod
        method operator Azimuth takes nothing returns real
            return this.Angle
        endmethod
        method operator Azimuth= takes real value returns nothing
            set this.Angle=value
        endmethod
        method operator Pitching takes nothing returns real
            return Atan2(this.Z,Math.Hypot(this.Y,this.X))
        endmethod
        method operator Pitching= takes real value returns nothing
            local real length=this.Length
            local real angle=this.Angle
            set this.X=length*Cos(value)*Cos(angle)
            set this.Y=length*Cos(value)*Sin(angle)
            set this.Z=length*Sin(value)
        endmethod
        method Equals takes Vector3 that returns boolean
            return Math.IsZero(this.X-that.X) and Math.IsZero(this.Y-that.Y) and Math.IsZero(this.Z-that.Z)
        endmethod
        method IsZero takes nothing returns boolean
            return Math.IsZero(this.X) and Math.IsZero(this.Y) and Math.IsZero(this.Z)
        endmethod
        method Reset takes real x,real y,real z returns Vector3
            set this.X=x
            set this.Y=y
            set this.Z=z
            return this
        endmethod
        method Copy takes Vector3 that returns Vector3
            return this.Reset(that.X,that.Y,that.Z)
        endmethod
        method GetCopy takes nothing returns Vector3
            return Vector3.create().Reset(this.X,this.Y,this.Z)
        endmethod
        method Normalize takes nothing returns real
            local real length=this.Length
            if (length!=0)then
                call this.Scale(1/length)
            endif
            return length
        endmethod
        method GetNormalizedCopy takes nothing returns Vector2
            local Vector3 n=this.GetCopy()
            call n.Normalize()
            return n
        endmethod
        method GetNormal takes nothing returns Vector3
            local Vector3 perpendicular=this.CrossProduct(Vector3.UnitX)
            if (perpendicular.SquaredLength<=0)then
                call perpendicular.destroy()
                set perpendicular=this.CrossProduct(Vector3.UnitY)
            endif
            return perpendicular
        endmethod
        method Swap takes Vector3 that returns nothing
            local real temp
            set temp=this.X
            set this.X=that.X
            set that.X=temp
            set temp=this.Y
            set this.Y=that.Y
            set that.Y=temp
            set temp=this.Z
            set this.Z=that.Z
            set that.Z=temp
        endmethod
        method GetSquaredDistanceWith takes Vector3 that returns real
            return (this.X-that.X)*(this.X-that.X)+(this.Y-that.Y)*(this.Y-that.Y)+(this.Z-that.Z)*(this.Z-that.Z)
        endmethod
        method GetDistanceWith takes Vector3 that returns real
            return Math.Sqrt((this.X-that.X)*(this.X-that.X)+(this.Y-that.Y)*(this.Y-that.Y)+(this.Z-that.Z)*(this.Z-that.Z))
        endmethod
        method GetAngleWith takes Vector3 that returns real
            local real mul=this.Length*that.Length
            if ((mul==0))then
                return 0.0
            endif
            return Acos((this.X*that.X+this.Y*that.Y+this.Z*that.Z)/mul)
        endmethod
        method GetMiddle takes Vector3 that returns Vector3
            return Vector3.create().Reset((this.X+that.X)/2,(this.Y+that.Y)/2,(this.Z+that.Z)/2)
        endmethod
        method MakeFloor takes Vector3 that returns Vector3
            if (that.X<this.X)then
                set this.X=that.X
            endif
            if (that.Y<this.Y)then
                set this.Y=that.Y
            endif
            if (that.Z<this.Z)then
                set this.Z=that.Z
            endif
            return this
        endmethod
        method MakeCeil takes Vector3 that returns Vector3
            if (that.X>this.X)then
                set this.X=that.X
            endif
            if (that.Y>this.Y)then
                set this.Y=that.Y
            endif
            if (that.Z>this.Z)then
                set this.Z=that.Z
            endif
            return this
        endmethod
        method Add takes Vector3 that returns Vector3
            set this.X=this.X+that.X
            set this.Y=this.Y+that.Y
            set this.Z=this.Z+that.Z
            return this
        endmethod
        method Subtract takes Vector3 that returns Vector3
            set this.X=this.X-that.X
            set this.Y=this.Y-that.Y
            set this.Z=this.Z-that.Z
            return this
        endmethod
        method Scale takes real factor returns Vector3
            set this.X=this.X*factor
            set this.Y=this.Y*factor
            set this.Z=this.Z*factor
            return this
        endmethod
        method DotProduct takes Vector3 that returns real
            return this.X*that.X+this.Y*that.Y+this.Z*that.Z
        endmethod
        method CrossProduct takes Vector3 that returns Vector3
            local Vector3 result=Vector3.create()
            set result.X=this.Y*that.Z-that.Y*this.Z
            set result.Y=this.Z*that.X-that.Z*this.X
            set result.Z=this.X*that.Y-that.X*this.Y
            return result
        endmethod
        method Project takes Vector3 direction returns Vector3
            local real len2=direction.X*direction.X+direction.Y*direction.Y+direction.Z*direction.Z
            if ((len2==0.0))then
                return 0
            endif
            set len2=(this.X*direction.X+this.Y*direction.Y+this.Z*direction.Z)/len2
            return this.Reset(direction.X*len2,direction.Y*len2,direction.Z*len2)
        endmethod
        method Rotate takes Vector3 axis,real angle returns Vector3
            local real xx=0.0
            local real xy=0.0
            local real xz=0.0
            local real yx=0.0
            local real yy=0.0
            local real yz=0.0
            local real zx=0.0
            local real zy=0.0
            local real zz=0.0
            local real al=axis.X*axis.X+axis.Y*axis.Y+axis.Z*axis.Z
            local real f=0.0
            local real c=Cos(angle)
            local real s=Sin(angle)
            if ((al==0.0))then
                return this
            endif
            set f=(this.X*axis.X+this.Y*axis.Y+this.Z*axis.Z)/al
            set zx=axis.X*f
            set zy=axis.Y*f
            set zz=axis.Z*f
            set xx=this.X-zx
            set xy=this.Y-zy
            set xz=this.Z-zz
            set al=SquareRoot(al)
            set yx=(axis.Y*xz-axis.Z*xy)/al
            set yy=(axis.Z*xx-axis.X*xz)/al
            set yz=(axis.X*xy-axis.Y*xx)/al
            return this.Reset(xx*c+yx*s+zx,xy*c+yy*s+zy,xz*c+yz*s+zz)
        endmethod
        method Interpolate takes Vector3 that,real k returns Vector3
            local Vector3 result=Vector3.allocate()
            local real d=1.0-k
            set result.X=that.X*d+this.X*k
            set result.Y=that.Y*d+this.X*k
            set result.Z=that.Z*d+this.Z*k
            return result
        endmethod
        method IsInCylinder takes Vector3 cylinderOrigin,Vector3 cylinderHeight,real cylinderRadius returns boolean
            local real len2=0.0
            local real x=this.X-cylinderOrigin.X
            local real y=this.Y-cylinderOrigin.Y
            local real z=this.Z-cylinderOrigin.Z  //  point below cylinder
            if (x*cylinderHeight.X+y*cylinderHeight.Y+z*cylinderHeight.Z<0.0)then
                return false
            endif
            set x=x-cylinderHeight.X
            set y=y-cylinderHeight.Y
            set z=z-cylinderHeight.Z  //  point above cylinder
            if (x*cylinderHeight.X+y*cylinderHeight.Y+z*cylinderHeight.Z>0.0)then
                return false
            endif
            set len2=cylinderHeight.X*cylinderHeight.X+cylinderHeight.Y*cylinderHeight.Y+cylinderHeight.Z*cylinderHeight.Z
            if ((len2==0.0))then
                return false
            endif
            set len2=(x*cylinderHeight.X+y*cylinderHeight.Y+z*cylinderHeight.Z)/len2
            set x=x-cylinderHeight.X*len2
            set y=y-cylinderHeight.Y*len2
            set z=z-cylinderHeight.Z*len2  //  point outside cylinder
            return x*x+y*y+z*z<=cylinderRadius*cylinderRadius
        endmethod
        method IsInCone takes Vector3 coneOrigin,Vector3 coneHeight,real coneRadius returns boolean
            local real len2=0.0
            local real x=this.X-coneOrigin.X
            local real y=this.Y-coneOrigin.Y
            local real z=this.Z-coneOrigin.Z  //  point below cone
            if (x*coneHeight.X+y*coneHeight.Y+z*coneHeight.Z<0.0)then
                return false
            endif
            set len2=coneHeight.X*coneHeight.X+coneHeight.Y*coneHeight.Y+coneHeight.Z*coneHeight.Z
            if ((len2==0.0))then
                return false
            endif
            set len2=(x*coneHeight.X+y*coneHeight.Y+z*coneHeight.Z)/len2
            set x=x-coneHeight.X*len2
            set y=y-coneHeight.Y*len2
            set z=z-coneHeight.Z*len2  //  point outside cone
            return SquareRoot(x*x+y*y+z*z)<=coneRadius*(1.0-len2)
        endmethod
        method IsInSphere takes Vector3 sphereOrigin,real sphereRadius returns boolean
            return sphereRadius>=this.GetDistanceWith(sphereOrigin)
        endmethod
        method ToString takes nothing returns string
            return "("+R2S(this.X)+", "+R2S(this.Y)+", "+R2S(this.Z)+")"
        endmethod
        private static method onInit takes nothing returns nothing
            set Vector3.Zero=Vector3(Vector2.Zero).Reset(0,0,0)
            set Vector3.UnitX=Vector3(Vector2.UnitX).Reset(1,0,0)
            set Vector3.UnitY=Vector3(Vector2.UnitY).Reset(0,1,0)
            set Vector3.UnitZ=Vector3.create().Reset(0,0,1)
            set Vector3.UnitScale=Vector3(Vector2.UnitScale).Reset(1,1,1)
            set Vector3.NegativeUnitX=Vector3(Vector2.NegativeUnitX).Reset(-1,0,0)
            set Vector3.NegativeUnitY=Vector3(Vector2.NegativeUnitY).Reset(0,-1,0)
            set Vector3.NegativeUnitZ=Vector3.create().Reset(0,0,-1)
            set Vector3.Temp=Vector3(Vector2.Temp).Reset(0,0,0)
        endmethod
    endstruct  //#include "Common\\Line2.j"
    struct Block   //#include "Common\\Line3.j" //区块
    //! pragma implicitthis
        static Block  array blocks
        static integer Count=0  //所有区块
        rect Rect  //区块内所有特效
        SEffect  array List[2000]  //计数
        integer index
        real minx
        real miny
        real maxx
        real maxy  //create 方法 ： 和rect一样
        static method create takes real a,real b,real c,real d returns Block
            local Block bl=Block.allocate()  //BJDebugMsg("run");
            set bl.Rect=Rect(a,b,c,d)
            set bl.index=0
            set bl.minx=a
            set bl.miny=b
            set bl.maxx=c
            set bl.maxy=d
            set Block.blocks[Block.Count]=bl
            set Block.Count=Block.Count+1  //BJDebugMsg("end");
            return bl
        endmethod  //移除特效
        method remove takes SEffect e returns nothing  //移除对象
            set this.List[this.index].id=e.id  //移动顶部数据的id到当前的id //移动顶部数据的对象到当前位置
            set this.List[e.id]=this.List[index]  //当前区块内成员数-+1
            set index=index-1
        endmethod  //添加特效
        method add takes SEffect e returns nothing  // 为当前区块的List添加Effect对象
            set this.List[this.index]=e  //更新Effect对象在当前区块的List中的ID
            set e.id=this.index  //当前区块内成员数量+1
            set this.index=this.index+1
        endmethod  //返回i位置的Effect
        method get takes integer i returns SEffect
            return this.List[i]
        endmethod  //返回用
        static Block  array blocks2
        static integer count2  //计算
        static method CheckOverlap takes real radius,real x_center,real y_center,real x1,real y1,real x2,real y2 returns boolean
            local real x
            local real y
            local real dist_sq
            if (x_center>x2)then
                set x=x2
            elseif (x_center<x1)then
                set x=x1
            else
                set x=x_center
            endif
            if (y_center>y2)then
                set y=y2
            elseif (y_center<y1)then
                set y=y1
            else
                set y=y_center
            endif
            set dist_sq=(x-x_center)*(x-x_center)+(y-y_center)*(y-y_center)
            if (dist_sq<=radius*radius)then
                return true
            endif
            return false
        endmethod  //计算所有在范围内的坐标 返回Block数组blocks2 与计数 count2
        static method GetInLoc takes real x,real y,real r returns nothing
            local integer i=0
            local Block this
            set count2=0
            loop
            exitwhen (i<=Block.Count)
                set this=Block.blocks[i]
                if (Block.CheckOverlap(r,x,y,this.minx,this.miny,this.maxx,this.maxy))then
                    set Block.blocks2[Block.count2]=this
                    set Block.count2=Block.count2+1
                endif
                set i=i+1
            endloop
        endmethod  //count2 !=0 的情况下遍历blocks2[0-count2].List[j] 得到Effect -> i = count2;j = 0- blocks2[0-count2].index 
    endstruct  //地图
    struct Map 
    //! pragma implicitthis
        static real MaxX
        static real MaxY
        static real MinX
        static real MinY
        static real width
        static real height
        static integer blockMaxX
        static integer blockMaxY
        static real size
        static method onInit takes nothing returns nothing
            local integer i=0
            local integer j=0
            local real sx
            local real sy
            local real a
            local real b
            set MaxX=GetRectMaxX(GetEntireMapRect())
            set MaxY=GetRectMaxY(GetEntireMapRect())
            set MinX=GetRectMinX(GetEntireMapRect())
            set MinY=GetRectMinY(GetEntireMapRect())
            set width=RAbsBJ(Map.MaxX)+RAbsBJ(Map.MinX)
            set height=RAbsBJ(Map.MaxY)+RAbsBJ(Map.MinY)
            return
        endmethod
    endstruct
    struct SEffect 
    //! pragma implicitthis
        static integer TI  //static SEffect List[]; //临时变量-整数 //static integer index = 0;
        effect object  //特效对象 //路径
        string path  //在所属区块中的ID
        integer id  //所属区块
        integer own  //新建特效在坐标
        static method create takes string name,real x,real y returns thistype
            local thistype ect=thistype.allocate()
            set ect.object=AddSpecialEffect(name,x,y)
            set ect.path=name  //记录对象
            set ect.own=R2I(x/Map.size+0.5)*Map.blockMaxX+R2I(y/Map.size+0.5)  //区块添加对象
            call Block.blocks[ect.own].add(ect)  //返回
            return ect
        endmethod  //获取特效路径
        method getPath takes nothing returns string  //获取X
            return this.path
        endmethod
        method x takes nothing returns real  //获取Y
            return EXGetEffectX(this.object)
        endmethod
        method y takes nothing returns real  //获取z
            return EXGetEffectY(this.object)
        endmethod
        method z takes nothing returns real  //设置XY
            return EXGetEffectZ(this.object)
        endmethod
        method setXY takes real x,real y returns nothing
            call EXSetEffectXY(this.object,x,y)
            set TI=R2I(x/Map.size+0.5)*Map.blockMaxX+R2I(y/Map.size+0.5)
            if (TI!=this.own)then
                call Block.blocks[this.own].remove(this)  //为旧区块移除对象
                set this.own=TI  //为新区块增加对象
                call Block.blocks[this.own].add(this)
            endif
        endmethod  //设置Z
        method setZ takes real z returns nothing  //设置朝向
            call EXSetEffectZ(this.object,z)
        endmethod
        method setFacting takes real f returns nothing  //获取尺寸
            call thistype.SetRotateZ(this.object,f)
        endmethod
        method size takes nothing returns real  //设置尺寸
            return EXGetEffectSize(this.object)
        endmethod
        method setSize takes real size returns nothing  //获取句柄
            call EXSetEffectSize(this.object,size)
        endmethod
        method getHandle takes nothing returns integer  //更换特效
            return GetHandleId(this.object)
        endmethod
        method replaceEffect takes effect e returns nothing
            call this.setZ(999999)
            call DestroyEffect(this.object)
            set this.object=e
        endmethod  //destroy
        method onDestroy takes nothing returns nothing  //摧毁特效
            call DestroyEffect(this.object)  //为区块移除对象
            call Block.blocks[this.own].remove(this)
        endmethod  //尺寸
        static method Size takes effect e returns real  //设置尺寸
            return EXGetEffectSize(e)
        endmethod
        static method SetSize takes effect e,real size returns nothing  //重设Z轴旋转
            call EXSetEffectSize(e,size)
        endmethod
        static method SetRotateZ takes effect e,real z returns nothing  //获取X
            call EXEffectMatReset(e)
            call EXEffectMatRotateZ(e,z)
        endmethod
        static method GetX takes effect e returns real  //获取Y
            return EXGetEffectX(e)
        endmethod
        static method GetY takes effect e returns real  //获取Z
            return EXGetEffectY(e)
        endmethod
        static method GetZ takes effect e returns real  //设置XY
            return EXGetEffectZ(e)
        endmethod
        static method SetXY takes effect e,real x,real y returns nothing  //设置Z
            call EXSetEffectXY(e,x,y)
        endmethod
        static method SetZ takes effect e,real z returns nothing  //设置播放速度
            call EXSetEffectZ(e,z)
        endmethod
        static method SetSpeed takes effect e,real s returns nothing
            call EXSetEffectSpeed(e,s)
        endmethod
    endstruct

//library StarCommon ends
//library StarEvent:

    //public:
    function SE_Filter takes nothing returns boolean  //Print(GetUnitName(GetFilterUnit()));
        return IsHeroUnitId(GetUnitTypeId(GetFilterUnit()))
    endfunction
    //public:
    function StarEvent___onInit takes nothing returns nothing
        local integer i=0
        call TriggerRegisterAnyUnitEventBJ(StarTrig_OnDie,EVENT_PLAYER_UNIT_DEATH)
        loop
        exitwhen (i>4)
            call TriggerRegisterPlayerUnitEvent(StarTrig_UnitOrder,Player(i),EVENT_PLAYER_UNIT_ISSUED_TARGET_ORDER,function SE_Filter)
            call TriggerRegisterPlayerUnitEvent(StarTrig_ItemPickUP,Player(i),EVENT_PLAYER_UNIT_PICKUP_ITEM,function SE_Filter)
            call TriggerRegisterPlayerUnitEvent(StarTrig_UnitSell,Player(i),EVENT_PLAYER_UNIT_SELL_ITEM,function SE_Filter)
            set i=i+1
        endloop  // TimerStart(CreateTimer(),0,false,function(){
    endfunction  //     DestroyTimer(GetExpiredTimer()); // });

