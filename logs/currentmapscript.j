function Trig_L______ResenFunc004Func002Func006Func011Func012T takes nothing returns nothing
    local group ydl_group
    local unit ydl_unit
    local timer ydl_timer
    if ((IsUnitPausedBJ(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x27AA7F5B)) == false) and (IsUnitAliveBJ(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x27AA7F5B)) == true)) then
        call SaveLocationHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x5E86E850, GetUnitLoc(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x27AA7F5B)))
        call SaveLocationHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x1AF7BCBB, PolarProjectionBJ(LoadLocationHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x5E86E850), 60.00, GetUnitFacing(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x27AA7F5B))))
        if ((IsUnitPausedBJ(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x27AA7F5B)) == true)) then
        else
            call SetUnitPositionLoc( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x27AA7F5B), LoadLocationHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x1AF7BCBB) )
        endif
        call RemoveLocation( LoadLocationHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x5E86E850) )
        call RemoveLocation( LoadLocationHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x1AF7BCBB) )
        set ydl_group = CreateGroup()
        call GroupEnumUnitsInRange(ydl_group, GetUnitX(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x27AA7F5B)), GetUnitY(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x27AA7F5B)), 140.00, null)
        loop
            set ydl_unit = FirstOfGroup(ydl_group)
            exitwhen ydl_unit == null
            call GroupRemoveUnit(ydl_group, ydl_unit)
            call SaveUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15, ydl_unit)
            if ((IsUnitType(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15), UNIT_TYPE_ANCIENT) == false) and (IsUnitAliveBJ(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15)) == true) and (IsUnitType(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15), UNIT_TYPE_STRUCTURE) == false) and (IsUnitEnemy(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15), GetOwningPlayer(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xE97D6160))) == true) and (IsUnitInGroup(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15), LoadGroupHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x56E86570)) == false)) then
                call GroupAddUnit( LoadGroupHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x56E86570), LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15) )
                call UnitDamageTarget( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xE97D6160), LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15), LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0x21C08A18), true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, WEAPON_TYPE_WHOKNOWS )
            else
            endif
        endloop
        call DestroyGroup(ydl_group)
    else
        call DoNothing( )
