function Trig___________________ZLFunc011Func001A takes nothing returns nothing
    call SaveUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7), 0xB3542E15, GetEnumUnit())
    if ((GetOwningPlayer(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7), 0xB3542E15)) == GetTriggerPlayer())) then
        call KillUnit( LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7), 0xB3542E15) )
