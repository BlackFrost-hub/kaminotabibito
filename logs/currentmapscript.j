    endfunction  //���ӵ�λ������ �ٷֱ� //SUTL_GetHashCode 
    function SGSS_SetUnitAttackPercentum takes unit u,real r returns nothing
        local integer hd=GetHandleId(u)  //��ȡ�ٷֱȼӳ�ֵ
        local real pv=LoadReal(StarBaseHT,hd,StringHash("�������ٷֱȼӳ�"))  //��ȡ�ٷֱ�������
        local real av=LoadReal(StarBaseHT,hd,StringHash("�������ٷֱȼӳ���ֵ"))  //��������ֵ�仯
        local real v=GetUnitState(u,ConvertUnitState(0x12))+(GetUnitState(u,ConvertUnitState(0x10))*(GetUnitState(u,ConvertUnitState(0x11))+1)/2)  //��ȡ��λ������
        local real npv=pv+r  //�µİٷֱ� //�µļӳ�ֵ
        local real nav=v*npv  //ͬ�����򲻱�
