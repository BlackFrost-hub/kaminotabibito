            call SetUnitPositionLocFacingBJ( LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xDB988C32), LoadLocationHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xC41A8F92), LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger()), 0x4C2AEFA3) )
            call SetUnitFacing( LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xDB988C32), (LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xB9A583B8)) )
            call RemoveLocation( LoadLocationHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xC41A8F92) )
