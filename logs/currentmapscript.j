function Trig_111________________uFunc001Func005Func019Conditions takes nothing returns nothing
    local timer ydl_timer
    call SaveUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xE66F1A12, LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xD84480C3))
    call SaveUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xA2C24DE8, GetDyingUnit())
    call SetStackedSoundBJ( false, gg_snd_battleBgm002, LoadRectHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0x6CC68D63) )
    call SetStackedSoundBJ( false, gg_snd_battleBgm003, LoadRectHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0x6CC68D63) )
    call SetStackedSoundBJ( false, gg_snd_shengliBgm2, LoadRectHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0x6CC68D63) )
    call SaveBoolean(YDHT, StringHash( "决斗状态"), 0xEFAD0956, false)
    // 战斗胜利后的动作
    if ((IsUnitInGroup(GetKillingUnit(), LoadGroupHandle(YDHT, StringHash( "玩家英雄"), 0x0A4A1F64)) == true)) then
        call SetStackedSoundBJ( true, gg_snd_shengliBgm2, LoadRectHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0x6CC68D63) )
        set ydl_timer = CreateTimer()
        call SaveRectHandle(YDLOC, GetHandleId(ydl_timer), 0x6CC68D63, LoadRectHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0x6CC68D63))
        call TimerStart(ydl_timer, 50.00, false, function Trig_111________________uFunc001Func005Func019Func010Func003T)
        call SaveReal(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xA99320FA, GetUnitX(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xE66F1A12)))
        call SaveReal(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xFDF65382, GetUnitY(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xE66F1A12)))
        call SaveReal(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xB9A583B8, GetUnitFacing(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xE66F1A12)))
        call GS_SetUnitPositionLoc( LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xE66F1A12), Location(GetUnitX(GetTriggerUnit()), GetUnitY(GetTriggerUnit())) )
        call SetUnitFacing( LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xE66F1A12), YDWEAngleBetweenUnits(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xE66F1A12), GetKillingUnit()) )
        if ((GetUnitTypeId(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xA2C24DE8)) == 'h00N')) then
            call TransmissionFromUnitWithNameBJ( GetPlayersAll(), null, GetUnitName(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xE66F1A12)), null, "TRIGSTR_090", bj_TIMETYPE_SET, 2.50, false )
            call TransmissionFromUnitWithNameBJ( GetPlayersAll(), null, GetUnitName(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xE66F1A12)), null, "TRIGSTR_091", bj_TIMETYPE_SET, 2.50, false )
        else
        endif
        if ((GetUnitTypeId(GetDyingUnit()) == 'n033')) then
            call TransmissionFromUnitWithNameBJ( GetPlayersAll(), null, GetUnitName(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xE66F1A12)), null, "TRIGSTR_092", bj_TIMETYPE_SET, 2.50, false )
            call TransmissionFromUnitWithNameBJ( GetPlayersAll(), null, GetUnitName(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xE66F1A12)), null, "TRIGSTR_093", bj_TIMETYPE_SET, 2.50, false )
            call UnitAddItemByIdSwapped( 'I09Y', GetKillingUnit() )
            call QuestMessageBJ( YDWEGetPlayersMatchingNull(Condition(function Trig_111________________uFunc001Func005Func019Func010Func010Func002Func004001001)), bj_QUESTMESSAGE_HINT, "TRIGSTR_094" )
            call RemoveSavedHandle(YDHT, StringHash( "支线NPC"), 0x00EE63AD)
        else
        endif
        set ydl_timer = CreateTimer()
        call SaveUnitHandle(YDLOC, GetHandleId(ydl_timer), 0xE66F1A12, LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xE66F1A12))
        call SaveReal(YDLOC, GetHandleId(ydl_timer), 0xA99320FA, LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xA99320FA))
        call SaveReal(YDLOC, GetHandleId(ydl_timer), 0xFDF65382, LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xFDF65382))
        call SaveReal(YDLOC, GetHandleId(ydl_timer), 0xB9A583B8, LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xB9A583B8))
        call TimerStart(ydl_timer, 5.00, false, function Trig_111________________uFunc001Func005Func019Func010Func011T)
        call FlushChildHashtable(YDLOC, GetHandleId(GetTriggeringTrigger()))
        call DestroyTrigger(GetTriggeringTrigger())
    else
        if ((IsUnitInGroup(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xA2C24DE8), LoadGroupHandle(YDHT, StringHash( "玩家英雄"), 0x0A4A1F64)) == true)) then
            call TransmissionFromUnitWithNameBJ( GetPlayersAll(), null, GetUnitName(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0x969219F1)), null, ( "你输了，" + GetUnitName(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0x310EFEF8)) ), bj_TIMETYPE_SET, 2.50, false )
            call RemoveUnit( LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0x969219F1) )
            call SaveInteger(YDHT, StringHash( "玩家"), 0x0E8974B8, ((LoadInteger(YDHT, StringHash( "玩家"), 0x0E8974B8))+( -3)))
            call QuestMessageBJ( GetPlayersAll(), bj_QUESTMESSAGE_WARNING, "TRIGSTR_089" )
