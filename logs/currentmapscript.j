﻿	
	//坐标间距 
	function SoSpacing takes real x1,real y1,real x2,real y2 returns real
    	local real fx = x2 - x1
    	local real fy = y2 - y1
    	return SquareRoot(fx * fx + fy * fy)
	endfunction
	//坐标间方向
	function SoC2A takes real x1,real y1,real x2,real y2 returns real
    	return bj_RADTODEG * Atan2(y2 - y1,x2 - x1)
	endfunction
    function SoBaseL__SRabs takes real a returns real
        if (a<0) then
            return -a
        else
            return a
        endif
    endfunction
    //三点所在的矩形面积
    function SoGetRectAera takes real xa,real ya,real xb,real yb,real xc,real yc returns real
        return SoBaseL__SRabs( xa*yb - xa*yc + xb*yc - xb*ya + xc*ya - xc*yb )
    endfunction
	//设置单位坐标
	function SoSetUnitXY takes unit u,real Howx,real Howy returns nothing
		local real x = Howx
		local real y = Howy
    	if IsTerrainPathable(x,y,PATHING_TYPE_ANY) == true then
    		if x < GetRectMinX(GetWorldBounds()) then
    			set x = GetRectMinX(GetWorldBounds())
    		elseif x > GetRectMaxX(GetWorldBounds()) then
    			set x = GetRectMaxX(GetWorldBounds())
    		endif
    		if y < GetRectMinY(GetWorldBounds()) then
    			set y = GetRectMinY(GetWorldBounds())
    		elseif y > GetRectMaxY(GetWorldBounds()) then
    			set y = GetRectMaxY(GetWorldBounds())
    		endif
        	call SetUnitX(u,x)
        	call SetUnitY(u,y)
    	endif
	endfunction
	//位移单位(角度)
	function SoMoveUnitForAngle takes unit WhichUnit,real an,real skpu returns nothing
    	local unit u = WhichUnit
    	local real x = GetUnitX(u) + CosBJ(an)*skpu
    	local real y = GetUnitY(u) + SinBJ(an)*skpu
    	if (x > GetRectMaxX(GetWorldBounds())) then
        	set x = GetRectMaxX(GetWorldBounds())
    	endif
    	if (x < GetRectMinX(GetWorldBounds())) then
        	set x = GetRectMinX(GetWorldBounds())
    	endif
    	if (y > GetRectMaxY(GetWorldBounds())) then
        	set y = GetRectMaxY(GetWorldBounds())
    	endif
   		if (y < GetRectMinY(GetWorldBounds())) then
        	set y = GetRectMinY(GetWorldBounds())
    	endif
    	call SetUnitX(u,x)
    	call SetUnitY(u,y)
    	set u = null
	endfunction
	//位移点(角度)
	function SoMoveLocForAngle takes location WhichLoc,real skpu,real an returns nothing
    	local location l = WhichLoc
    	local real x = GetLocationX(l) + CosBJ(an)*skpu
    	local real y = GetLocationY(l) + SinBJ(an)*skpu
    	if (x > GetRectMaxX(GetWorldBounds())) then
        	set x = GetRectMaxX(GetWorldBounds())
    	endif
    	if (x < GetRectMinX(GetWorldBounds())) then
        	set x = GetRectMinX(GetWorldBounds())
    	endif
    	if (y > GetRectMaxY(GetWorldBounds())) then
        	set y = GetRectMaxY(GetWorldBounds())
    	endif
    	if (y < GetRectMinY(GetWorldBounds())) then
        	set y = GetRectMinY(GetWorldBounds())
    	endif
    	call MoveLocation(l,x,y)
    	set l = null
	endfunction
	//显示特效
	//不能显示延时特效
	function SoShowEffect takes string tx,real x,real y returns nothing
    	call DestroyEffect(AddSpecialEffect(tx,x,y))
	endfunction
	//物品分类转换表
	function SoGetItemTypeForVal takes integer nve returns itemtype
    	if (nve == SoBaseL__Itemtype_SouL_RenHe) then
        	set SoBaseL__ITEM_TYPE_CBACK = ITEM_TYPE_ANY
    	elseif (nve == SoBaseL__Itemtype_SouL_YongJiu) then
        	set SoBaseL__ITEM_TYPE_CBACK = ITEM_TYPE_PERMANENT
   	 	elseif (nve == SoBaseL__Itemtype_SouL_KeChong) then
        	set SoBaseL__ITEM_TYPE_CBACK = ITEM_TYPE_CHARGED
    	elseif (nve == SoBaseL__Itemtype_SouL_NengLiangTiSheng) then
        	set SoBaseL__ITEM_TYPE_CBACK = ITEM_TYPE_POWERUP
    	elseif (nve == SoBaseL__Itemtype_SouL_RenZao) then
        	set SoBaseL__ITEM_TYPE_CBACK = ITEM_TYPE_ARTIFACT
    	elseif (nve == SoBaseL__Itemtype_SouL_KeGouMai) then
        	set SoBaseL__ITEM_TYPE_CBACK = ITEM_TYPE_PURCHASABLE
    	elseif (nve == SoBaseL__Itemtype_SouL_ZhanYi) then
        	set SoBaseL__ITEM_TYPE_CBACK = ITEM_TYPE_CAMPAIGN
    	elseif (nve == SoBaseL__Itemtype_SouL_HunZa) then
        	set SoBaseL__ITEM_TYPE_CBACK = ITEM_TYPE_MISCELLANEOUS
    	endif
    	return SoBaseL__ITEM_TYPE_CBACK
	endfunction
	function SoGetValForItemType takes itemtype nve returns integer
    	if (nve == ITEM_TYPE_ANY) then
        	set SoBaseL__ITEM_TYPE_VBACK = SoBaseL__Itemtype_SouL_RenHe
    	elseif (nve == ITEM_TYPE_PERMANENT) then
        	set SoBaseL__ITEM_TYPE_VBACK = SoBaseL__Itemtype_SouL_YongJiu
    	elseif (nve == ITEM_TYPE_CHARGED) then
        	set SoBaseL__ITEM_TYPE_VBACK = SoBaseL__Itemtype_SouL_KeChong
    	elseif (nve == ITEM_TYPE_POWERUP) then
        	set SoBaseL__ITEM_TYPE_VBACK = SoBaseL__Itemtype_SouL_NengLiangTiSheng
    	elseif (nve == ITEM_TYPE_ARTIFACT) then
        	set SoBaseL__ITEM_TYPE_VBACK = SoBaseL__Itemtype_SouL_RenZao
    	elseif (nve == ITEM_TYPE_PURCHASABLE) then
        	set SoBaseL__ITEM_TYPE_VBACK = SoBaseL__Itemtype_SouL_KeGouMai
    	elseif (nve == ITEM_TYPE_CAMPAIGN) then
        	set SoBaseL__ITEM_TYPE_VBACK = SoBaseL__Itemtype_SouL_ZhanYi
    	elseif (nve == ITEM_TYPE_MISCELLANEOUS) then
        	set SoBaseL__ITEM_TYPE_VBACK = SoBaseL__Itemtype_SouL_HunZa
    	endif
    	return SoBaseL__ITEM_TYPE_VBACK
	endfunction
    function EnumUnits takes real r,real x,real y, boolexpr f returns group
        set SO_GROUP_SELCR = CreateGroup()
        call GroupEnumUnitsInRange(SO_GROUP_SELCR,x,y,r,f)
        call DestroyBoolExpr(f)
        return SO_GROUP_SELCR
    endfunction
    function SoBaseL__BuildSoL takes nothing returns nothing
        call TriggerRegisterAnyUnitEventBJ(SOTRI_UNIT_DIE,EVENT_PLAYER_UNIT_DEATH)
        call TriggerRegisterAnyUnitEventBJ(SOTRI_UNIT_CASTER,EVENT_PLAYER_UNIT_SPELL_EFFECT)
        call TriggerRegisterAnyUnitEventBJ(SOTRI_UNIT_GETITEM,EVENT_PLAYER_UNIT_PICKUP_ITEM)
    endfunction

//library SoBaseL ends
//library Sound3DII:

//声音衰减距离
struct SoundDistances
public real minDis
public real maxDis
    public method Set takes real mindis , real maxdis returns nothing
    set this.minDis = mindis
    set this.maxDis = maxdis
    endmethod
    public method GetMin takes nothing returns real
        return this.minDis
    endmethod
    public method GetMax takes nothing returns real
        return this.maxDis
    endmethod
endstruct
//声音投射角
struct SoundConeOrientation 
    public real x
    public real y
    public real z
    public method Set takes real x ,real y , real z returns nothing
        set this.x = x
        set this.y = y
        set this.z = z
    endmethod
    public method GetX takes nothing returns real
        return this.x
    endmethod
    public method GetY takes nothing returns real
        return this.y
    endmethod
    public method GetZ takes nothing returns real
        return this.z
    endmethod
endstruct
//声音速度
struct SoundVelocity
    public real x
    public real y
    public real z
    public method Set takes real x ,real y , real z returns nothing
        set this.x = x
        set this.y = y
        set this.z = z
    endmethod
    public method GetX takes nothing returns real
        return this.x
    endmethod
    public method GetY takes nothing returns real
        return this.y
    endmethod
    public method GetZ takes nothing returns real
        return this.z
    endmethod
endstruct
//
struct ConeAngles
    public real IN
    public real OUT
    public integer Volume
    public method Set takes real inside ,real outside , integer volume returns nothing
        set this.IN = inside
        set this.OUT = outside
        set this.Volume = volume
    endmethod
    public method GetInside takes nothing returns real
        return this.IN
    endmethod
    public method GetOutside takes nothing returns real
        return this.OUT
    endmethod
    public method GetVolume takes nothing returns integer
        return this.Volume
    endmethod
endstruct
//声音模型
struct SoundModel
//
public ConeAngles CA
//声音通道
public integer Channel
//声音播放速率
public real Pitch
//声音移动速度
public SoundVelocity SV
//声音投射角
public SoundConeOrientation SCO
//声音衰减
public SoundDistances SD
public integer Volume
public string SoundType
public integer fadeInRate
public integer fadeOutRate
static method create takes ConeAngles ca ,SoundVelocity sv,SoundConeOrientation sco,SoundDistances sd returns SoundModel
    local SoundModel s 
    set s = SoundModel.allocate()
    set s.CA = ca
    call s.CA.Set(0,0,127)
    set s.SV = sv
    call s.SV.Set(0,0,0)
    set s.SCO = sco
    call s.SCO.Set(0,0,0)
    set s.SD = sd
    call s.SD.Set(2500,2500)
    set s.Pitch = 1.00
    set s.Volume = 127
    set s.Channel = 0
    set s.SoundType = "DefaultEAXON"
    set s.fadeInRate = 10
    set s.fadeOutRate = 10
    return s
endmethod
endstruct
function Sound3DII__TimeOut takes nothing returns nothing
local sound sou = LoadSoundHandle(Sound3DII__HT,GetHandleId(GetExpiredTimer()),0x9B7EB41F)
local integer i = LoadInteger(Sound3DII__HT,GetHandleId(sou),0xB7279243) 
call SaveBoolean(Sound3DII__HT,StringHash(LoadStr(Sound3DII__HT,GetHandleId(sou),0x2D297D87)),i,true)
set sou = null
endfunction
function Sound3DII__Create takes string s , real r , integer i ,real x , real y ,real z,boolean is3d returns sound
    local timer t = CreateTimer()
    
    set bj_lastPlayedSound =CreateSound( s, false, is3d, false, Sound3DII_soundModel.fadeInRate, Sound3DII_soundModel.fadeOutRate, Sound3DII_soundModel.SoundType)
    call SetSoundDistances( bj_lastPlayedSound,Sound3DII_soundModel.SD.minDis ,Sound3DII_soundModel.SD.maxDis)
    call SetSoundDistanceCutoff( bj_lastPlayedSound, r)
    call SetSoundPosition(bj_lastPlayedSound, x, y, z)
    call SetSoundChannel(bj_lastPlayedSound,Sound3DII_soundModel.Channel)
    call SetSoundVolume(bj_lastPlayedSound,Sound3DII_soundModel.Volume)
    call SetSoundPitch(bj_lastPlayedSound,Sound3DII_soundModel.Pitch)
    call SetSoundConeOrientation(bj_lastPlayedSound,Sound3DII_soundModel.SCO.x,Sound3DII_soundModel.SCO.y,Sound3DII_soundModel.SCO.z)
    call SetSoundConeAngles(bj_lastPlayedSound,Sound3DII_soundModel.CA.IN,Sound3DII_soundModel.CA.OUT,Sound3DII_soundModel.CA.Volume)
    call SetSoundVelocity(bj_lastPlayedSound,Sound3DII_soundModel.SV.x,Sound3DII_soundModel.SV.y,Sound3DII_soundModel.SV.z)
    call SaveSoundHandle(Sound3DII__HT,StringHash(s),i,bj_lastPlayedSound)
    call SaveTimerHandle(Sound3DII__HT,GetHandleId(bj_lastPlayedSound),0x1CA61CEC,t)
    call SaveSoundHandle(Sound3DII__HT,GetHandleId(t),0x9B7EB41F,bj_lastPlayedSound)
    call SaveBoolean(Sound3DII__HT,StringHash(s),i,false)
    call SaveInteger(Sound3DII__HT,GetHandleId(bj_lastPlayedSound),0xB7279243,i)
    call SaveStr(Sound3DII__HT,GetHandleId(bj_lastPlayedSound),0x2D297D87,s)
    call TimerStart(t,GetSoundFileDuration(s)*0.001,false,function Sound3DII__TimeOut)
    set t = null
    return bj_lastPlayedSound
endfunction
//获取音效
function Sound3DII__Get takes string s , real r , integer i ,real x , real y ,real z returns sound 
    local timer t = LoadTimerHandle(Sound3DII__HT,GetHandleId(LoadSoundHandle(Sound3DII__HT,StringHash(s),i)),0x1CA61CEC)
    set bj_lastPlayedSound = LoadSoundHandle(Sound3DII__HT,StringHash(s),i)
    call SetSoundDistances( bj_lastPlayedSound,Sound3DII_soundModel.SD.minDis ,Sound3DII_soundModel.SD.maxDis)
    call SetSoundDistanceCutoff( bj_lastPlayedSound, r)
    call SetSoundPosition(bj_lastPlayedSound, x, y, z)
    call SetSoundChannel(bj_lastPlayedSound,Sound3DII_soundModel.Channel)
    call SetSoundVolume(bj_lastPlayedSound,Sound3DII_soundModel.Volume)
    call SetSoundPitch(bj_lastPlayedSound,Sound3DII_soundModel.Pitch)
    call SetSoundConeOrientation(bj_lastPlayedSound,Sound3DII_soundModel.SCO.x,Sound3DII_soundModel.SCO.y,Sound3DII_soundModel.SCO.z)
    call SetSoundConeAngles(bj_lastPlayedSound,Sound3DII_soundModel.CA.IN,Sound3DII_soundModel.CA.OUT,Sound3DII_soundModel.CA.Volume)
    call SetSoundVelocity(bj_lastPlayedSound,Sound3DII_soundModel.SV.x,Sound3DII_soundModel.SV.y,Sound3DII_soundModel.SV.z)
    call SaveBoolean(Sound3DII__HT,StringHash(s),i,false)
    call TimerStart(t,GetSoundFileDuration(s)*0.001,false,function Sound3DII__TimeOut)
    set t = null
    return bj_lastPlayedSound
endfunction
function Sound3DII__TimeOut2 takes nothing returns nothing
    local sound sou = LoadSoundHandle(Sound3DII__HT,GetHandleId(GetExpiredTimer()),0x9B7EB41F)
    local integer i = LoadInteger(Sound3DII__HT,GetHandleId(sou),Sound3DII__Key_Index)//当前位置
    local string s = LoadStr(Sound3DII__HT,GetHandleId(sou),0x2D297D87)
    local integer sh = StringHash(s)
    local integer index = LoadInteger(Sound3DII__HT,sh,Sound3DII__key_Index) - 1//数组顶位置 
    //call DisplayTextToPlayer(Player(0),0,0,"结束"+"index="+I2S(index)+"this=:"+I2S(i)+","+s)
    //顶部移动到当前
    call SaveInteger(Sound3DII__HT,GetHandleId(LoadSoundHandle(Sound3DII__HT,sh,index)),Sound3DII__Key_Index,i)
    //当前移动到顶部
    call SaveInteger(Sound3DII__HT,GetHandleId(sou),Sound3DII__Key_Index,index)
    call SaveInteger(Sound3DII__HT,sh,Sound3DII__Key_Index,index)
    set sou = null
    endfunction
//获取音效
function Sound3DII__GetRe takes string s , real r , integer i ,real x , real y ,real z returns sound 
    local timer t = LoadTimerHandle(Sound3DII__HT,GetHandleId(LoadSoundHandle(Sound3DII__HT,StringHash(s),i)),0x1CA61CEC)
    set bj_lastPlayedSound = LoadSoundHandle(Sound3DII__HT,StringHash(s),i)
    call SetSoundDistances( bj_lastPlayedSound,Sound3DII_soundModel.SD.minDis ,Sound3DII_soundModel.SD.maxDis)
    call SetSoundDistanceCutoff( bj_lastPlayedSound, r)
    call SetSoundPosition(bj_lastPlayedSound, x, y, z)
    call SetSoundChannel(bj_lastPlayedSound,Sound3DII_soundModel.Channel)
    call SetSoundVolume(bj_lastPlayedSound,Sound3DII_soundModel.Volume)
    call SetSoundPitch(bj_lastPlayedSound,Sound3DII_soundModel.Pitch)
    call SetSoundConeOrientation(bj_lastPlayedSound,Sound3DII_soundModel.SCO.x,Sound3DII_soundModel.SCO.y,Sound3DII_soundModel.SCO.z)
    call SetSoundConeAngles(bj_lastPlayedSound,Sound3DII_soundModel.CA.IN,Sound3DII_soundModel.CA.OUT,Sound3DII_soundModel.CA.Volume)
    call SetSoundVelocity(bj_lastPlayedSound,Sound3DII_soundModel.SV.x,Sound3DII_soundModel.SV.y,Sound3DII_soundModel.SV.z)
    call TimerStart(t,GetSoundFileDuration(s)*0.001,false,function Sound3DII__TimeOut2)
    set t = null
    return bj_lastPlayedSound
endfunction
function Sound3DII__CreateRe takes string s , real r , integer i ,real x , real y ,real z,boolean is3d returns sound
    local timer t = CreateTimer()
    
    set bj_lastPlayedSound =CreateSound( s, false, is3d, false, Sound3DII_soundModel.fadeInRate, Sound3DII_soundModel.fadeOutRate, Sound3DII_soundModel.SoundType)
    call SetSoundDistances( bj_lastPlayedSound,Sound3DII_soundModel.SD.minDis ,Sound3DII_soundModel.SD.maxDis)
    call SetSoundDistanceCutoff( bj_lastPlayedSound, r)
    call SetSoundPosition(bj_lastPlayedSound, x, y, z)
    call SetSoundChannel(bj_lastPlayedSound,Sound3DII_soundModel.Channel)
    call SetSoundVolume(bj_lastPlayedSound,Sound3DII_soundModel.Volume)
    call SetSoundPitch(bj_lastPlayedSound,Sound3DII_soundModel.Pitch)
    call SetSoundConeOrientation(bj_lastPlayedSound,Sound3DII_soundModel.SCO.x,Sound3DII_soundModel.SCO.y,Sound3DII_soundModel.SCO.z)
    call SetSoundConeAngles(bj_lastPlayedSound,Sound3DII_soundModel.CA.IN,Sound3DII_soundModel.CA.OUT,Sound3DII_soundModel.CA.Volume)
    call SetSoundVelocity(bj_lastPlayedSound,Sound3DII_soundModel.SV.x,Sound3DII_soundModel.SV.y,Sound3DII_soundModel.SV.z)
    call SaveSoundHandle(Sound3DII__HT,StringHash(s),i,bj_lastPlayedSound)
    call SaveTimerHandle(Sound3DII__HT,GetHandleId(bj_lastPlayedSound),0x1CA61CEC,t)
    call SaveSoundHandle(Sound3DII__HT,GetHandleId(t),0x9B7EB41F,bj_lastPlayedSound)
    call SaveInteger(Sound3DII__HT,GetHandleId(bj_lastPlayedSound),Sound3DII__Key_Index,i)//记录位置
    call SaveStr(Sound3DII__HT,GetHandleId(bj_lastPlayedSound),0x2D297D87,s)
    call TimerStart(t,GetSoundFileDuration(s)*0.001,false,function Sound3DII__TimeOut2)
    set t = null
    return bj_lastPlayedSound
endfunction
//Sound3DII_CooPlay(string,real,real,real,real)用于在坐标处播放音效
//s:音效位置
//xyz 为坐标
//r:裁断距离
function Sound3DII_CooPlay takes string s , real x,real y , real z, real r returns sound
    local integer sh = StringHash(s)
    local integer count = LoadInteger(Sound3DII__HT,sh,Sound3DII__key_Count)
    local integer index = LoadInteger(Sound3DII__HT,sh,Sound3DII__key_Index)
    local boolean Enable 
    local integer loopi = 0
    if index==count then
        set bj_lastPlayedSound = Sound3DII__CreateRe(s,r,count,x,y,z,true)
        call StartSound(bj_lastPlayedSound)
        call SaveInteger(Sound3DII__HT,sh,0xB7279243,count + 1) 
        call SaveInteger(Sound3DII__HT,sh,Sound3DII__key_Index,index + 1) 
        //call DisplayTextToPlayer(Player(0),0,0,"新建"+"index="+I2S(index)+"count=:"+I2S(count))
    else
        
        set bj_lastPlayedSound = Sound3DII__GetRe(s,r,index,x,y,z)
        call StartSound(bj_lastPlayedSound) 
        call SaveInteger(Sound3DII__HT,sh,Sound3DII__key_Index,index + 1) 
        //call DisplayTextToPlayer(Player(0),0,0,"读取"+"index="+I2S(index)+"count=:"+I2S(count))     
    endif
    return bj_lastPlayedSound
endfunction 
//Sound3DII_UnitPlay(string,unit,real)用于在单位位置播放音效
function Sound3DII_UnitPlay takes string s , unit u , real r returns sound
    return Sound3DII_CooPlay(s,GetUnitX(u), GetUnitY(u), GetUnitFlyHeight(u),r)
endfunction
//Sound3DII_LocPlay(string,Location,real)用于在点播放音效
function Sound3DII_LocPlay takes string s , location u , real r returns sound
    return Sound3DII_CooPlay(s,GetLocationX(u), GetLocationY(u), GetLocationZ(u),r)
endfunction
//非3D音效播放函数
function Sound3DII_Mp3Play takes string s , player p returns sound 
    local integer count = LoadInteger(Sound3DII__HT,StringHash(s),0xB7279243) 
    local boolean Enable 
    local integer loopi = 0
    local real r = 4000
    local sound sou = null
    if count != 0 then
        loop
            set Enable = LoadBoolean(Sound3DII__HT,StringHash(s),loopi)
                if Enable then
                    exitwhen true
                    //call DisplayTextToPlayer(Player(0),0,0,"读取到了一个true值，退出了循环" )
                endif
                //call DisplayTextToPlayer(Player(0),0,0,"循环" )
            set loopi = loopi + 1
            exitwhen loopi == count
        endloop
        
        if not Enable then
            set sou = Sound3DII__Create(s,r,count,0,0,0,false)
            set bj_lastPlayedSound = sou
            if p!=null then
                if GetLocalPlayer() == p then
                    call StartSound(sou)
                endif
            else
                call StartSound(sou)
            endif
            //建立一个新的音效
            //call StartSound(Create(s,r,count,0,0,0,false))
            call SaveInteger(Sound3DII__HT,StringHash(s),0xB7279243,count + 1) 
            
        else
            //取出一个音效播放
            set sou = Sound3DII__Get(s,r,loopi,0,0,0)
            set bj_lastPlayedSound = sou
            if p!=null then
                if GetLocalPlayer() == p then
                    call StartSound(sou)
                endif
            else
                call StartSound(sou)
            endif
            
        endif
    else
    //建立一个新的音效
    set sou = Sound3DII__Create(s,r,count,0,0,0,false)
    set bj_lastPlayedSound = sou
    if p!=null then
        if GetLocalPlayer() == p then
            call StartSound(sou)
        endif
    else
        call StartSound(sou)
    endif
    call SaveInteger(Sound3DII__HT,StringHash(s),0xB7279243,count + 1) 
    
        
    
    endif
    set Sound3DII_lastCreateSound = sou
    set sou = null
    return Sound3DII_lastCreateSound
endfunction
//声音效果：默认、战斗、战鼓、魔法、投射物、英雄语音、装饰物
function Sound3DII__GetSoundTypeByID takes integer id returns string
if id==1 then
    return "CombatSoundsEAX"
elseif id==2 then
    return "KotoDrumsEAX"
elseif id==3 then
    return "SpellsEAX"
elseif id==4 then
    return "MissilesEAX"
elseif id==5 then
    return "HeroAcksEAX"
elseif id==6 then
    return "DoodadsEAX"
endif
    return "DefaultEAXON"
endfunction
//设置声音效果
function Sound3DII_SetSoundTypeByID takes integer id returns nothing
    set Sound3DII_soundModel.SoundType = Sound3DII__GetSoundTypeByID(id)
endfunction
//设置声音通道
 function Sound3DII_SetChannel takes integer channel returns nothing
if channel >14 then
    set channel = 0
endif 
    set Sound3DII_soundModel.Channel = channel
endfunction
//设置音量 范围：0-127
function Sound3DII_SetVolume takes integer v returns nothing
if v >127 then
    set v = 127
elseif v<0 then
    set v = 0
endif
set Sound3DII_soundModel.Volume = v
endfunction
//设置淡入淡出距离
function Sound3DII_SetDistances takes real min , real max returns nothing
    call Sound3DII_soundModel.SD.Set(min,max)
endfunction
//设置声音方向
function Sound3DII_SetConeOrientation takes real x , real y , real z returns nothing
    call Sound3DII_soundModel.SCO.Set(x,y,z)
endfunction
//设置声音速度
function Sound3DII_SetVelocity takes real x , real y , real z returns nothing
    call Sound3DII_soundModel.SV.Set(x,y,z)
endfunction
//
function Sound3DII_SetConeAngle takes real inside ,real outside , integer volume returns nothing
    call Sound3DII_soundModel.CA.Set(inside,outside,volume)
endfunction
//设置淡入音量
function Sound3DII_SetFadeInRate takes integer i returns nothing
    set Sound3DII_soundModel.fadeInRate = i
endfunction
//设置淡出音量
function Sound3DII_SetFadeOutRate takes integer i returns nothing
    set Sound3DII_soundModel.fadeOutRate = i
endfunction
//Sound3DII初始化
function Sound3DII__LibInit takes nothing returns nothing
local ConeAngles ca= ConeAngles.create()
local SoundVelocity sv= SoundVelocity.create()
local SoundConeOrientation sco = SoundConeOrientation .create()
local SoundDistances sd = SoundDistances.create()
//初始化声音模型
set Sound3DII_soundModel = SoundModel.create(ca,sv,sco,sd)
endfunction

