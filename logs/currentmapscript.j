function Trig____________________RR___uFunc002Func006Func010Func003Func005A takes nothing returns nothing
    call SaveUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15, GetEnumUnit())
    call PauseUnit( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15), false )
    call SetUnitTimeScale( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15), 1.00 )
    call SetUnitVertexColor( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15), 255, 255, 255, 255 )
    if ((IsUnitType(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15), UNIT_TYPE_MECHANICAL) == true)) then
        call RemoveSavedReal(YDHT, GetHandleId( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15)), 0x6FE77C3A)
        call RemoveSavedReal(YDHT, GetHandleId( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15)), 0x1C8173B7)
    else
        call RemoveSavedReal(YDHT, GetHandleId( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15)), 0xB16AE35F)
        call RemoveSavedReal(YDHT, GetHandleId( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15)), 0x3C1EB460)
    endif
endfunction
function Trig____________________RR___uFunc002Func006Func010Func003Func010003003 takes nothing returns boolean
    return (((GetFilterUnit() != LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x650A3A3A)) and (((IsUnitType(GetFilterUnit(), UNIT_TYPE_TAUREN) == false) and (IsUnitAliveBJ(GetFilterUnit()) == true)) and (IsUnitInGroup(GetFilterUnit(), LoadGroupHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x28F9922D)) == false))))
endfunction
function Trig____________________RR___uFunc002Func006Func010Func003Func011A takes nothing returns nothing
    call SaveUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15, GetEnumUnit())
    call SaveUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x089E63E0, CreateUnit(GetOwningPlayer(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x650A3A3A)), LoadInteger(YDHT, StringHash( "辅助马甲"), 0x86D47FF3), GetUnitX(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15)), GetUnitY(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15)), 0))
    // 真值判断是否为双击，根据条件施法不同控制效果
    if ((LoadBoolean(YDHT, GetHandleId( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x650A3A3A)), 0xAAA10FA3) == true)) then
        call UnitAddAbility( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x089E63E0), 'A0CP' )
        call IssueTargetOrder( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x089E63E0), "thunderbolt", LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15) )
    else
        call UnitAddAbility( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x089E63E0), 'A0CO' )
        call IssueTargetOrder( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x089E63E0), "slow", LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15) )
    endif
    if ((IsUnitType(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15), UNIT_TYPE_TAUREN) == false) and (IsUnitType(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15), UNIT_TYPE_MECHANICAL) == true)) then
        // 提前记录一次弹道位置
        call SaveReal(YDHT, GetHandleId( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15)), 0x6FE77C3A, GetUnitX(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15)))
        call SaveReal(YDHT, GetHandleId( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15)), 0x1C8173B7, GetUnitY(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15)))
    else
        // 提前记录一次非弹道单位状态
        call SaveReal(YDHT, GetHandleId( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15)), 0xB16AE35F, GetUnitState(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15), UNIT_STATE_LIFE))
        call SaveReal(YDHT, GetHandleId( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15)), 0x3C1EB460, GetUnitState(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15), UNIT_STATE_MANA))
    endif
    call GroupAddUnit( LoadGroupHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x28F9922D), GetEnumUnit() )
endfunction
function Trig____________________RR___uFunc002Func006Func010Func003Func012A takes nothing returns nothing
    call SaveUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15, GetEnumUnit())
    // 暂停所有单位，并且不断检测暂停状态
    if ((LoadBoolean(YDHT, GetHandleId( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x650A3A3A)), 0xAAA10FA3) == true)) then
        if ((IsUnitType(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15), UNIT_TYPE_TAUREN) == false) and (IsUnitPausedBJ(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15)) == true)) then
        else
            call PauseUnit( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15), true )
            call SetUnitTimeScale( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15), 0.00 )
            call SetUnitVertexColor( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15), 255, 255, 255, 122 )
        endif
    else
    endif
    if ((IsUnitType(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15), UNIT_TYPE_MECHANICAL) == true)) then
        // 真值判断是否为双击
        if ((LoadBoolean(YDHT, GetHandleId( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x650A3A3A)), 0xAAA10FA3) == true)) then
            // 使弹道一直瞬移到此技能施法时所记录的位置
            call SetUnitX( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15), LoadReal(YDHT, GetHandleId( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15)), 0x6FE77C3A) )
            call SetUnitY( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15), LoadReal(YDHT, GetHandleId( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15)), 0x1C8173B7) )
            // 不会降低已方弹幕的生命流逝
            if ((IsUnitEnemy(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15), GetOwningPlayer(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x650A3A3A))) == true)) then
            else
                call SetUnitLifePercentBJ( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15), 100 )
            endif
        else
            // 记录点则为上次移动前记录的位置
            call SaveLocationHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x30800883, Location(LoadReal(YDHT, GetHandleId( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15)), 0x6FE77C3A), LoadReal(YDHT, GetHandleId( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15)), 0x1C8173B7)))
            call SaveReal(YDHT, GetHandleId( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15)), 0x6FE77C3A, GetUnitX(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15)))
            call SaveReal(YDHT, GetHandleId( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15)), 0x1C8173B7, GetUnitY(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15)))
            // 弹道点则为当前位置
            call SaveLocationHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x13FB2F81, GetUnitLoc(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15)))
            call SaveReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xE978590C, DistanceBetweenPoints(LoadLocationHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x30800883), LoadLocationHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x13FB2F81)))
            // 大于8则判断为移动，倒退60%移动距离
            if ((LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xE978590C) >= 8.00)) then
                call SaveReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xB9A583B8, ((GetUnitFacing(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15)))+( 180.00)))
                call SaveLocationHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xA6FE8D59, PolarProjectionBJ(LoadLocationHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x13FB2F81), ((LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xE978590C))*( 0.60)), LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xB9A583B8)))
                call SetUnitPositionLoc( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15), LoadLocationHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xA6FE8D59) )
                call SaveReal(YDHT, GetHandleId( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15)), 0x6FE77C3A, GetUnitX(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15)))
                call SaveReal(YDHT, GetHandleId( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15)), 0x1C8173B7, GetUnitY(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15)))
                call RemoveLocation( LoadLocationHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xA6FE8D59) )
                call RemoveLocation( LoadLocationHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x13FB2F81) )
            else
                call RemoveLocation( LoadLocationHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x13FB2F81) )
            endif
            call RemoveLocation( LoadLocationHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x30800883) )
        endif
    else
        // 下面动作为当前单位状态
        call SaveReal(YDLOC, GetHandleId(GetExpiredTimer()), 0x634C8CDF, GetUnitState(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15), UNIT_STATE_MANA))
        call SaveReal(YDLOC, GetHandleId(GetExpiredTimer()), 0x9890BA1B, GetUnitState(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15), UNIT_STATE_LIFE))
        call SaveReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xE2ED5BB0, ((LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0x9890BA1B))-( LoadReal(YDHT, GetHandleId( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15)), 0xB16AE35F))))
        call SaveReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xFA38F165, ((LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0x9890BA1B))-( LoadReal(YDHT, GetHandleId( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15)), 0x3C1EB460))))
        // 大于2则为恢复,下面真值判断是否为双击，设置实数为1
        // 此判断单位状态方法较低效，若以后能改进则改进
        if ((LoadBoolean(YDHT, GetHandleId( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x650A3A3A)), 0xAAA10FA3) == true)) then
            call SaveReal(YDLOC, GetHandleId(GetExpiredTimer()), 0x946E23A1, 1.00)
        else
            call SaveReal(YDLOC, GetHandleId(GetExpiredTimer()), 0x946E23A1, 0.50)
        endif
        if ((LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xE2ED5BB0) > 2.00)) then
            call SetUnitState( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15), UNIT_STATE_LIFE, ((GetUnitState(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15), UNIT_STATE_LIFE))-( ((LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xE2ED5BB0))*( LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0x946E23A1))))) )
        else
        endif
        if ((LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xFA38F165) > 2.00)) then
            call SetUnitState( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15), UNIT_STATE_MANA, ((GetUnitState(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15), UNIT_STATE_MANA))-( ((LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xFA38F165))*( LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0x946E23A1))))) )
        else
        endif
        // 下面动作为记录上一次的单位状态
        call SaveReal(YDHT, GetHandleId( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15)), 0x9890BA1B, GetUnitState(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15), UNIT_STATE_LIFE))
        call SaveReal(YDHT, GetHandleId( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15)), 0x634C8CDF, GetUnitState(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15), UNIT_STATE_MANA))
    endif
    // 单位离开这个范围则取消对其的时停
    if ((IsUnitInRangeLoc(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15), LoadLocationHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x4A2A66A1), 800.00) == false)) then
        call PauseUnit( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15), false )
        call SetUnitTimeScale( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15), 1.00 )
        call GroupRemoveUnit( LoadGroupHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x28F9922D), LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15) )
    else
    endif
endfunction
function Trig____________________RR___uFunc002Func006Func010T takes nothing returns nothing
    local group ydl_group
    local unit ydl_unit
    // 技能持续时间为5秒，设循环实数大于等于某一个数为X，则X×计时器循环时间不能大于持续时间
    if ((LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xCEA5D211) >= 62.50)) then
        call SaveBoolean(YDHT, GetHandleId( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x650A3A3A)), 0x8BE5946B, false)
        call PlaySoundAtPointBJ( gg_snd_PossessionMissileLaunch1, 100, LoadLocationHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x4A2A66A1), 0 )
        call RemoveLocation( LoadLocationHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x4A2A66A1) )
        call RemoveUnit( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x732B2EDA) )
        call ForGroupBJ( LoadGroupHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x28F9922D), function Trig____________________RR___uFunc002Func006Func010Func003Func005A )
        call DestroyGroup( LoadGroupHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x28F9922D) )
        call FlushChildHashtable(YDLOC, GetHandleId(GetExpiredTimer()))
        call DestroyTimer(GetExpiredTimer())
    else
        call SaveReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xCEA5D211, ((LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xCEA5D211))+( 1.00)))
        call SaveGroupHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xA95CDEE4, YDWEGetUnitsInRangeOfLocMatchingNull(800.00, LoadLocationHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x4A2A66A1), Condition(function Trig____________________RR___uFunc002Func006Func010Func003Func010003003)))
        call ForGroupBJ( LoadGroupHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xA95CDEE4), function Trig____________________RR___uFunc002Func006Func010Func003Func011A )
        call ForGroupBJ( LoadGroupHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x28F9922D), function Trig____________________RR___uFunc002Func006Func010Func003Func012A )
        call DestroyGroup( LoadGroupHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xA95CDEE4) )
    endif
    set ydl_group = null
    set ydl_unit = null
endfunction
function Trig____________________RR___uFunc002Func006T takes nothing returns nothing
    local timer ydl_timer
    call UnitRemoveAbility( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9), 'A00S' )
    call SaveLocationHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x4A2A66A1, GetUnitLoc(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x650A3A3A)))
    call SaveUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x732B2EDA, CreateUnitAtLoc(GetOwningPlayer(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x650A3A3A)), LoadInteger(YDHT, StringHash( "十六夜咲夜的世界"), 0x86D47FF3), LoadLocationHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x4A2A66A1), 0))
    call SetUnitFlyHeight( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x732B2EDA), ((GetUnitDefaultFlyHeight(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x732B2EDA)))+( GetUnitFlyHeight(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x650A3A3A)))), 0.00 )
    // 设置CD
    if ((LoadBoolean(YDHT, GetHandleId( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9)), 0xAAA10FA3) == true)) then
        call SaveBoolean(YDHT, GetHandleId( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x650A3A3A)), 0x8BE5946B, true)
