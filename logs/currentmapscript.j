function Trig_______Boss______QD01Func001Func017Func007Func007T takes nothing returns nothing
    local group ydl_group
    local unit ydl_unit
    set ydl_group = CreateGroup()
    call GroupEnumUnitsInRange(ydl_group, GetUnitX(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x76ABBC1D)), GetUnitY(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x76ABBC1D)), 1500.00, null)
    loop
        set ydl_unit = FirstOfGroup(ydl_group)
        exitwhen ydl_unit == null
        call GroupRemoveUnit(ydl_group, ydl_unit)
        if ((IsUnitAliveBJ(ydl_unit) == true) and (IsUnitType(ydl_unit, UNIT_TYPE_ANCIENT) == false) and (IsUnitType(ydl_unit, UNIT_TYPE_MECHANICAL) == false) and (IsUnitType(ydl_unit, UNIT_TYPE_STRUCTURE) == false) and (IsUnitEnemy(ydl_unit, GetOwningPlayer(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x76ABBC1D))) == true)) then
            call SaveUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x48E3E75F, ydl_unit)
            if ((Xcallg(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x76ABBC1D), LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x48E3E75F)) == true)) then
                call UnitDamageTarget( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x76ABBC1D), LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x48E3E75F), ((GetUnitState(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x76ABBC1D), ConvertUnitState(0x15)))*( 3.33)), false, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MIND, WEAPON_TYPE_WHOKNOWS )
                call YDWETimerDestroyEffect( 1.00, AddSpecialEffectTarget("Abilities\\Spells\\Other\\SoulBurn\\SoulBurnbuff.mdl", LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x48E3E75F), "origin") )
            else
            endif
        else
        endif
    endloop
    call DestroyGroup(ydl_group)
    call SaveInteger(YDLOC, GetHandleId(GetExpiredTimer()), 0xAF616D00, GetRandomInt(1, 3))
    if ((LoadInteger(YDLOC, GetHandleId(GetExpiredTimer()), 0xAF616D00) == 1)) then
        call TransmissionFromUnitWithNameBJ( GetPlayersAll(), null, "TRIGSTR_109", null, "TRIGSTR_110", bj_TIMETYPE_SET, 2.00, false )
    else
        if ((LoadInteger(YDLOC, GetHandleId(GetExpiredTimer()), 0xAF616D00) == 2)) then
            call TransmissionFromUnitWithNameBJ( GetPlayersAll(), null, "TRIGSTR_107", null, "TRIGSTR_108", bj_TIMETYPE_SET, 2.00, false )
        else
            if ((LoadInteger(YDLOC, GetHandleId(GetExpiredTimer()), 0xAF616D00) == 3)) then
                call TransmissionFromUnitWithNameBJ( GetPlayersAll(), null, "TRIGSTR_105", null, "TRIGSTR_106", bj_TIMETYPE_SET, 2.00, false )
            else
            endif
        endif
    endif
    if (((IsUnitAliveBJ(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x76ABBC1D)) == false) or (IsUnitDeadBJ(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x76ABBC1D)) == true))) then
        call FlushChildHashtable(YDLOC, GetHandleId(GetExpiredTimer()))
        call DestroyTimer(GetExpiredTimer())
    else
    endif
    set ydl_group = null
    set ydl_unit = null
endfunction
function Trig_______Boss______QD01Actions takes nothing returns nothing
    local timer ydl_timer
    local integer ydl_localvar_step = LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xCFDE6C76) 
 set ydl_localvar_step = ydl_localvar_step + 3 
 call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xCFDE6C76, ydl_localvar_step) 
 call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7, ydl_localvar_step)
    if ((GetSpellAbilityId() == 'A0I0') and (IsUnitOwnedByPlayer(GetSpellTargetUnit(), Player(PLAYER_NEUTRAL_PASSIVE)) == true) and ((GetUnitTypeId(GetSpellTargetUnit()) == 'n049') or (GetUnitTypeId(GetSpellTargetUnit()) == 'n01G') or ((GetUnitTypeId(GetSpellTargetUnit()) == 'ogru') and (GetSpellTargetUnit() == LoadUnitHandle(YDHT, StringHash( "支线敌人"), 0x3410E4F6))) or (GetUnitTypeId(GetSpellTargetUnit()) == 'n02U') or (GetUnitTypeId(GetSpellTargetUnit()) == 'n02S') or (GetUnitTypeId(GetSpellTargetUnit()) == 'n02Q') or (GetUnitTypeId(GetSpellTargetUnit()) == 'N01T') or (GetUnitTypeId(GetSpellTargetUnit()) == 'n02V') or (GetUnitTypeId(GetSpellTargetUnit()) == 'n011') or (GetUnitTypeId(GetSpellTargetUnit()) == 'nbdo') or (GetUnitTypeId(GetSpellTargetUnit()) == 'o000') or (GetUnitTypeId(GetSpellTargetUnit()) == 'O002') or (GetUnitTypeId(GetSpellTargetUnit()) == 'N03O') or (GetUnitTypeId(GetSpellTargetUnit()) == 'n03S'))) then
        call SaveUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x944CCEB0, GetSpellTargetUnit())
