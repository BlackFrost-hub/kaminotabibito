    if ((GetUnitTypeId(GetTriggerUnit()) != 'nsea') and (GetUnitTypeId(GetTriggerUnit()) != 'nfbr') and (GetUnitTypeId(GetTriggerUnit()) != 'e06Y') and (GetUnitTypeId(GetTriggerUnit()) != 'ndwm') and ((GetOwningPlayer(GetTriggerUnit()) == Player(PLAYER_NEUTRAL_PASSIVE)) or (IsUnitAlly(GetTriggerUnit(), GetOwningPlayer(GetEventDamageSource())) == true))) then
        call YDWESetEventDamage( 0. )
    else
    endif
