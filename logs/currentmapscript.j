        call SetUnitTimeScale( LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xE88322CC), 3.00 )
        call SetUnitAnimationByIndex( LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xE88322CC), 3 )
        call SaveBoolean(YDHT, GetHandleId( LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xD84480C3)), 0x41B2CEE7, true)
        set ydl_timer = CreateTimer()
