        //英雄属性标签 带参数
        function GetFrameHeroStateLabel takes integer index returns integer
        if index == 1 then
        return GetFrameHeroStrLabel()
        elseif index == 2 then
        return GetFrameHeroAgiLabel()
        elseif index == 3 then
        return GetFrameHeroIntLabel()
        endif
        return 0
