function Trig_Kaname_MadokaActions takes nothing returns nothing
    local timer ydl_timer
    local integer ydl_localvar_step = LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xCFDE6C76) 
 set ydl_localvar_step = ydl_localvar_step + 3 
 call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xCFDE6C76, ydl_localvar_step) 
 call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7, ydl_localvar_step)
    if ((GetSpellAbilityId() == 'A01U')) then
        call SaveLocationHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xD2072F0A, GetUnitLoc(GetSpellTargetUnit()))
        call IssueImmediateOrder( GetTriggerUnit(), "stop" )
        // 重置单位动作动画
        call SaveGroupHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x39B00380, YDWEGetUnitsInRangeOfLocMatchingNull(500.00, LoadLocationHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xD2072F0A), Condition(function Trig_Kaname_MadokaFunc001Func004003003)))
        call SaveUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x176963D4, GetTriggerUnit())
        call SaveLocationHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xE09878A7, GetUnitLoc(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x176963D4)))
        call SavePlayerHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x5A47F98D, GetOwningPlayer(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x176963D4)))
        // 添加施法状态
        call GS_Suspend( GetTriggerUnit(), 0.90 )
        call SaveReal(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xCEA5D211, 0.00)
        call SaveUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x7E52F89B, CreateUnitAtLoc(LoadPlayerHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x5A47F98D), LoadInteger(YDHT, StringHash( "圆环射击攻击马甲"), 0x86D47FF3), LoadLocationHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xE09878A7), LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xB9A583B8)))
        call IssueTargetOrder( LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x7E52F89B), "attackonce", GroupPickRandomUnit(LoadGroupHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x39B00380)) )
        call StopSoundBJ( gg_snd_ArrowAttack1, false )
        call PlaySoundAtPointBJ( gg_snd_ArrowAttack1, 100, LoadLocationHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xE09878A7), 0 )
        set ydl_timer = CreateTimer()
        call SaveGroupHandle(YDLOC, GetHandleId(ydl_timer), 0x39B00380, LoadGroupHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x39B00380))
