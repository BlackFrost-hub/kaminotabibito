        call SetStackedSoundBJ( false, gg_snd_battleBoss3, LoadRectHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x6CC68D63) )
        call SetStackedSoundBJ( false, gg_snd_battle002, LoadRectHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x6CC68D63) )
        call SetStackedSoundBJ( false, gg_snd_battl03, LoadRectHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x6CC68D63) )
        if ((IsUnitAliveBJ(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x944CCEB0)) == true) and (IsUnitDeadBJ(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x944CCEB0)) == false)) then
