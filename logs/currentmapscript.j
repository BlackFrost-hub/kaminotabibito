    call TriggerRegisterUnitEvent(gg_trg_______Boss001, LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x76ABBC1D), EVENT_UNIT_SPELL_FINISH)
