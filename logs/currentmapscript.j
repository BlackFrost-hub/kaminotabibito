function Trig_YakumoYukari_________uFunc003Func013T takes nothing returns nothing
    if ((LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xCEA5D211) >= LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xABCB1BDB))) then
        call FlushChildHashtable(YDLOC, GetHandleId(GetExpiredTimer()))
        call DestroyTimer(GetExpiredTimer())
    else
        call SaveReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xCEA5D211, ((LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xCEA5D211))+( 1.00)))
        call GS_moveunit( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x204879EA), LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0x48DE6A7F), 25.00, PATHING_TYPE_WALKABILITY )
        if ((IsTerrainPathable(GetUnitX(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x204879EA)), GetUnitY(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x204879EA)), PATHING_TYPE_WALKABILITY) == true)) then
            call FlushChildHashtable(YDLOC, GetHandleId(GetExpiredTimer()))
            call DestroyTimer(GetExpiredTimer())
        else
        endif
    endif
endfunction
function Trig_YakumoYukari_________uFunc003Func014Func001Func004Func013T takes nothing returns nothing
    local group ydl_group
    local unit ydl_unit
    if ((LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xCEA5D211) >= 50.00)) then
        call RemoveUnit( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xCE56AC81) )
        call SetUnitScale( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xCE56AC81), 0.00, 0.00, 0.00 )
