function InitSounds takes nothing returns nothing
    set gg_snd_baiyihu_yueya = CreateSound( "war3mapImported\\baiyihu_yueya.mp3", false, true, true, 10, 10, "DefaultEAXON" )
    call SetSoundDuration( gg_snd_baiyihu_yueya, 1985 )
    call SetSoundChannel( gg_snd_baiyihu_yueya, 0 )
    call SetSoundVolume( gg_snd_baiyihu_yueya, 127 )
    call SetSoundPitch( gg_snd_baiyihu_yueya, 1.0 )
    call SetSoundDistances( gg_snd_baiyihu_yueya, 600.0, 10000.0 )
    call SetSoundDistanceCutoff( gg_snd_baiyihu_yueya, 3000.0 )
    call SetSoundConeAngles( gg_snd_baiyihu_yueya, 0.0, 0.0, 127 )
    call SetSoundConeOrientation( gg_snd_baiyihu_yueya, 0.0, 0.0, 0.0 )
    set gg_snd_BGM001 = CreateSound( "war3mapImported\\BGM001.mp3", false, false, false, 10, 10, "DefaultEAXON" )
    call SetSoundDuration( gg_snd_BGM001, 77087 )
    call SetSoundChannel( gg_snd_BGM001, 0 )
    call SetSoundVolume( gg_snd_BGM001, 127 )
    call SetSoundPitch( gg_snd_BGM001, 1.0 )
    set gg_snd_BGM002 = CreateSound( "war3mapImported\\BGM002.mp3", false, false, false, 10, 10, "DefaultEAXON" )
    call SetSoundDuration( gg_snd_BGM002, 56088 )
    call SetSoundChannel( gg_snd_BGM002, 0 )
    call SetSoundVolume( gg_snd_BGM002, 127 )
    call SetSoundPitch( gg_snd_BGM002, 1.0 )
    set gg_snd_bgm003 = CreateSound( "war3mapImported\\bgm003.mp3", false, false, false, 10, 10, "DefaultEAXON" )
    call SetSoundDuration( gg_snd_bgm003, 120906 )
    call SetSoundChannel( gg_snd_bgm003, 0 )
    call SetSoundVolume( gg_snd_bgm003, 127 )
    call SetSoundPitch( gg_snd_bgm003, 1.0 )
    set gg_snd_CharmTarget1 = CreateSound( "Abilities\\Spells\\Items\\AIco\\CharmTarget1.wav", false, true, true, 10, 10, "SpellsEAX" )
    call SetSoundParamsFromLabel( gg_snd_CharmTarget1, "Charm" )
    call SetSoundDuration( gg_snd_CharmTarget1, 2682 )
    call SetSoundVolume( gg_snd_CharmTarget1, 100 )
    call SetSoundPitch( gg_snd_CharmTarget1, 2.0 )
