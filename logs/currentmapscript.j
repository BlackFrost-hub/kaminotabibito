function Trig_______WFunc010Func001Func009Func001Func005Func003Func006Func001Func008Func003Func001Func007Func001Func002Func003T takes nothing returns nothing
    if ((LoadInteger(YDHT, GetHandleId( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xE5449640)), 0x9CF9EEB3) >= 10)) then
    else
        call DisplayTextToPlayer( GetOwningPlayer(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xE5449640)), 0, 0, "TRIGSTR_1641" )
