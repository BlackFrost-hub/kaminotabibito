function Trig____________________djcsActions takes nothing returns nothing
    local group ydl_group
    local unit ydl_unit
    call CreateItem( 'I00N', -25943.10, -11126.40 )
    call CreateItem( 'desc', -25943.10, -11126.40 )
    call CreateItem( 'crys', -25943.10, -11126.40 )
    set bj_forLoopAIndex = 1
    set bj_forLoopAIndexEnd = 8
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call ForGroupBJ( LoadGroupHandle(YDHT, StringHash( "玩家英雄"), 0x0A4A1F64), function Trig____________________djcsFunc004Func001A )
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
    if ((10 >= 10) and (GetEventPlayerChatString() == "开启全图")) then
        call FogEnable( true )
        call CreateFogModifierRectBJ( true, Player(0), FOG_OF_WAR_VISIBLE, gg_rct_____________u )
        call ForGroupBJ( LoadGroupHandle(YDHT, StringHash( "玩家英雄"), 0x0A4A1F64), function Trig____________________djcsFunc005Func004A )
    else
    endif
    call DisableTrigger( GetTriggeringTrigger() )
    set ydl_group = null
    set ydl_unit = null
endfunction
