    if ((GetEventDamage() >= ((GetUnitState(GetTriggerUnit(), UNIT_STATE_MAX_LIFE))*( 0.10))) and (LoadBoolean(YDHT, GetHandleId( GetTriggerUnit()), 0x3A78E0E5) == true)) then
        call YDWESetEventDamage( 0. )
