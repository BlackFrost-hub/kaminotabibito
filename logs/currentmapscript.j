function Trig_IzayoiSakuya_SkillFunc004Func011Func002Func011A takes nothing returns nothing
    call SaveUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15, GetEnumUnit())
    // 暂停所有单位，并且不断检测暂停状态
    if ((IsUnitType(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15), UNIT_TYPE_TAUREN) == false) and (IsUnitPausedBJ(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15)) == true)) then
    else
        call PauseUnit( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15), true )
        call SetUnitTimeScale( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15), 0.00 )
        call SetUnitVertexColor( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15), 255, 255, 255, 122 )
    endif
    if ((IsUnitType(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15), UNIT_TYPE_MECHANICAL) == true)) then
        // 使弹道一直瞬移到此技能施法时所记录的位置
        call SetUnitX( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15), LoadReal(YDHT, GetHandleId( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15)), 0x6FE77C3A) )
        call SetUnitY( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15), LoadReal(YDHT, GetHandleId( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15)), 0x1C8173B7) )
        // 不会降低已方弹幕的生命流逝
        if ((IsUnitEnemy(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15), GetOwningPlayer(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x650A3A3A))) == true)) then
        else
            call SetUnitLifePercentBJ( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15), 100 )
        endif
    else
    endif
    // 单位离开这个范围则取消对其的时停
    if ((IsUnitInRange(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15), LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x732B2EDA), 300.00) == false)) then
        call PauseUnit( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15), false )
        call SetUnitTimeScale( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15), 1.00 )
        call GroupRemoveUnit( LoadGroupHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x28F9922D), LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB3542E15) )
    else
    endif
endfunction
