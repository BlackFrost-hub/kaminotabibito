function Trig_L______ResenFunc004Func002Func006Func011Func012Func003Func002Func003A takes nothing returns nothing
    call SaveUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xCC26DF84, GetEnumUnit())
    // 单位如果在重复单位组说明受到过路径伤害，补充伤害差值
    if ((IsUnitInGroup(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xCC26DF84), LoadGroupHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x56E86570)) == true)) then
        call SaveReal(YDLOC, GetHandleId(GetExpiredTimer()), 0x9375D887, ( LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0x3DF3CA9E) - LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0x21C08A18) ))
    else
        call SaveReal(YDLOC, GetHandleId(GetExpiredTimer()), 0x9375D887, LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0x3DF3CA9E))
    endif
    // 在中心范围200内则必定暴击
    if ((IsUnitInRangeLoc(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xCC26DF84), LoadLocationHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x2A829619), 200.00) == true)) then
        call SaveUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x089E63E0, CreateUnit(GetOwningPlayer(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x458B7DE9)), LoadInteger(YDHT, StringHash( "辅助马甲"), 0x86D47FF3), GetUnitX(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xCC26DF84)), GetUnitY(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xCC26DF84)), 0))
        call UnitAddAbility( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x089E63E0), LoadInteger(YDHT, StringHash( "眩晕"), 0x2AAC512D) )
        call YDWESetUnitAbilityDataReal( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x089E63E0), LoadInteger(YDHT, StringHash( "眩晕"), 0x2AAC512D), 1, 102, 1.00 )
        call YDWESetUnitAbilityDataReal( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x089E63E0), LoadInteger(YDHT, StringHash( "眩晕"), 0x2AAC512D), 1, 103, 1.00 )
        call IssueTargetOrder( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0x089E63E0), "thunderbolt", GetEnumUnit() )
        call DestroyEffect( AddSpecialEffect("war3mapImported\\bloodex-special-2 (4).mdx", GetUnitX(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xCC26DF84)), GetUnitY(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xCC26DF84))) )
        call UnitDamageTarget( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xE97D6160), LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xCC26DF84), LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0x9375D887), true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, WEAPON_TYPE_WHOKNOWS )
    else
        call UnitDamageTarget( LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xE97D6160), LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xCC26DF84), LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0x9375D887), true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, WEAPON_TYPE_WHOKNOWS )
    endif
endfunction
