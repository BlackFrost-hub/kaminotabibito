    struct Convert   // Valid chars: 32~126 (Total 95) 128 €
    //! pragma implicitthis
        private static constant string charSet=" !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"  // !"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\]^_`abcdefghijklmnopqrstuvwxyz{|}~ // // Valid escaped character: \\  \"  \b  \t  \n  \f  \r
        private static constant string charSet64="0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz+/"
        static method S2Id takes string s returns integer
            local string charSet=Convert.charSet
            local integer strLength=StringLength(s)
            local integer result=0
            local integer char=0
            local integer i=0
            set i=0
            loop
            exitwhen (i>=strLength)
                set char=StringUtil.IndexOf(charSet,SubString(s,i,i+1))  //debug Print(char>= 0, "[Convert.S2Id] The converted char is not between 32 &&  126!");
                set result=result+(char+32)*R2I(Math.Power(256.0,strLength-i-1))
            set i = i+1
            endloop
            return result
        endmethod
        static method S2ID takes string s returns integer
            call RemoveSavedInteger(StarBaseHT,1000,1)  //RemoveSavedString(StarBaseHT,1000,0);
            call SaveStr(StarBaseHT,1000,0,s)
            call EXExecuteScript("(require'Id').string2id()")
            return LoadInteger(StarBaseHT,1000,1)
        endmethod
        static method ID2S takes integer i returns string
            local string s
            if (i==0)then
                return ""
            endif
            call RemoveSavedInteger(StarBaseHT,1000,0)  //RemoveSavedString(StarBaseHT,1000,1);
            call SaveInteger(StarBaseHT,1000,0,i)
            call EXExecuteScript("(require'Id').id2string()")
            set s=LoadStr(StarBaseHT,1000,1)
            if (s==null)then
                return ""
            endif
            return s
        endmethod
        static method ToMD5 takes string s returns string
            set StarVarStr=s
            return EXExecuteScript("(require'md5').sumhexa()")
        endmethod
        static method Id2S takes integer id returns string
            local string charSet=Convert.charSet
            local string result=""
            local integer modulo=0
            loop
            exitwhen (id<=0)
                set modulo=R2I(Math.Modulo(id,256.0))
                if (modulo<32 or modulo>126)then
                    set result=result+"€"
                endif
                set result=result+SubString(charSet,modulo-32,modulo-31)
                set id=id/256
            endloop
            return result
        endmethod
        static method S2Int takes string s,integer base returns integer
            local string charSet=SubString(Convert.charSet64,0,base)
            local integer strLength=StringLength(s)
            local integer result=0
            local integer sign=1
            local integer begin=0
            local integer char=0
            if (SubString(s,0,1)=="-")then
                set sign=-1
                set begin=1
            endif
            loop
            exitwhen (begin>=strLength)
                set char=StringUtil.IndexOf(charSet,SubString(s,begin,begin+1))
                set begin=begin+1
                set result=result+char*R2I(Math.Power(base,strLength-begin))
            endloop
            return result*sign
        endmethod
        static method Int2S takes integer i,integer base returns string
            local string charSet=SubString(Convert.charSet64,0,base)
            local string result=""
            local integer modulo=0
            if (i<0)then
                set result="-"
                set i=-i
            elseif (i==0)then
                return "0"
            endif
            loop
            exitwhen (i<=0)
                set modulo=R2I(Math.Modulo(i,base))
                set result=result+SubString(charSet,modulo,modulo+1)
                set i=i/base
            endloop
            return result
        endmethod  // Don't set the @para count too large beacause of the Jass Decimal precision of less than 6 digits
        static method Real2S takes real r,integer count returns string
            local string result=""
            local string str
            local integer strLen
            local integer i
            if (count>3)then
                set count=count-3
                set result=R2S(Math.Floor(r*1000)/1000)
                set str=StringUtil.Replace(R2S(r*Math.Power(10,count)),".","")
                set strLen=StringLength(str)
                set i=strLen
                loop
                exitwhen (i>=count)
                    set str="0"+str
                set i = i+1
                endloop
                return result+StringUtil.SubStr(str,-count)
            elseif (count>=0)then
                set result=R2S(r)
                return StringUtil.SubStr(result,StringLength(result)+count-3)
            endif
            return ""
        endmethod
        static method I2B takes integer i returns boolean
            return i!=0
        endmethod
        static method R2B takes real r returns boolean
            return r!=0.0
        endmethod
        static method S2B takes string s returns boolean
            return s!=""
        endmethod
        static method B2I takes boolean b returns integer
            if (b)then
                return 1
            endif
            return 0
        endmethod
        static method B2R takes boolean b returns real
            if (b)then
                return 1.0
            endif
            return 0.0
        endmethod
        static method B2S takes boolean b returns string
            if (b)then
                return "true"
            endif
            return "false"
        endmethod
        static method I2R takes integer i returns real
            return StarCommon___i2R(i)
        endmethod
        static method I2S takes integer i returns string
            return StarCommon___i2S(i)
        endmethod
        static method R2I takes real r returns integer
            return StarCommon___r2I(r)
        endmethod
        static method R2S takes real r returns string
            return StarCommon___r2S(r)
        endmethod
        static method S2I takes string s returns integer
            return StarCommon___s2I(s)
        endmethod
        static method S2R takes string s returns real
            return StarCommon___s2R(s)
        endmethod
        static method R2I2 takes real r returns integer
            return R2I(r+0.5)
        endmethod
    endstruct  //#include "Common\\Node.j"
    //private:  //#include "Common\\List.j" //#include "Common\\Tree.j"
        function StarCommon___Savereal takes hashtable ht,integer pk,integer ck,real value returns nothing
            call SaveReal(ht,pk,ck,value)
        endfunction
        function StarCommon___Loadreal takes hashtable ht,integer pk,integer ck returns real
            return LoadReal(ht,pk,ck)
        endfunction
    struct StarTable 
    //! pragma implicitthis
        private static hashtable ht  //通过Table table = StarTable.create() 使用
        method destroy takes nothing returns nothing  //整数(其他结构体对象)存/取的快速操作
            call FlushChildHashtable(StarTable.ht,this)
            call this.deallocate()
        endmethod
        method operator[] takes integer id returns StarTable
            return LoadInteger(StarTable.ht,this,id)
        endmethod
        method operator[]= takes integer id,StarTable value returns nothing  //判断table是否存在
            call SaveInteger(StarTable.ht,this,id,value)
        endmethod
        method Exists takes integer id returns boolean  //清除table
            return HaveSavedInteger(StarTable.ht,this,id)
        endmethod
        method Flush takes integer id returns StarTable
            local integer value=LoadInteger(StarTable.ht,this,id)
            call RemoveSavedInteger(StarTable.ht,this,id)
            return value
        endmethod  //判断是否存有指定类型/任意类型数据
        method ExistsInt takes integer id returns boolean
            return HaveSavedInteger(StarTable.ht,this,id)
        endmethod
        method ExistsBool takes integer id returns boolean
            return HaveSavedBoolean(StarTable.ht,this,id)
        endmethod
        method ExistsReal takes integer id returns boolean
            return HaveSavedReal(StarTable.ht,this,id)
        endmethod
        method ExistsString takes integer id returns boolean
            return HaveSavedString(StarTable.ht,this,id)
        endmethod
        method ExistsHandle takes integer id returns boolean
            return HaveSavedHandle(StarTable.ht,this,id)
        endmethod
        method ExistsAny takes integer id returns boolean
            return HaveSavedInteger(StarTable.ht,this,id) or HaveSavedHandle(StarTable.ht,this,id) or HaveSavedString(StarTable.ht,this,id) or HaveSavedReal(StarTable.ht,this,id) or HaveSavedBoolean(StarTable.ht,this,id)
        endmethod  //清除指定类型/任意类型数据
        method FlushInt takes integer id returns nothing
            call RemoveSavedInteger(StarTable.ht,this,id)
        endmethod
        method FlushBool takes integer id returns nothing
            call RemoveSavedBoolean(StarTable.ht,this,id)
        endmethod
        method FlushReal takes integer id returns nothing
            call RemoveSavedReal(StarTable.ht,this,id)
        endmethod
        method FlushString takes integer id returns nothing
            call RemoveSavedString(StarTable.ht,this,id)
        endmethod
        method FlushHandle takes integer id returns nothing
            call RemoveSavedHandle(StarTable.ht,this,id)
        endmethod
        method FlushAll takes integer id returns nothing
            call RemoveSavedInteger(StarTable.ht,this,id)
            call RemoveSavedBoolean(StarTable.ht,this,id)
            call RemoveSavedReal(StarTable.ht,this,id)
            call RemoveSavedString(StarTable.ht,this,id)
            call RemoveSavedHandle(StarTable.ht,this,id)
        endmethod  //textmacro instance: Common_Table ("Int", "Integer", "integer")
        method SaveInt takes integer id,integer i returns nothing
            call SaveInteger(StarTable.ht,this,id,i)
        endmethod
