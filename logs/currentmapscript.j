function Trig_____________JD01Func001Conditions takes nothing returns nothing
    local integer ydul_i
    local integer ydul_a
    call ShowUnit( LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0x2C9A4D28), false )
    if ((udg_T >= 2.00)) then
        call SaveGroupHandle(YDHT, GetHandleId( LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0x2C9A4D28)), 0x8B8D2CE6, CreateGroup())
    else
    endif
    call StarExecuteEvent( "注册吟唱条", false )
    call YDTRIGGER_lightningtype(SET)(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xCAB9D091, SIP_CreatePool())
    set ydul_i = 1
    loop
        exitwhen ydul_i > 9
        call SIP_PoolAddInteger( LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xCAB9D091), ydul_i, 1.0 )
        set ydul_i = ydul_i + 1
    endloop
    // Create腐败之源
    set ydul_a = 1
    loop
        exitwhen ydul_a > 3
        call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0x57259F3B, SIP_GetIntAndRemove(LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xCAB9D091)))
