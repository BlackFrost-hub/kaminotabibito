            call DisableTrigger( GetTriggeringTrigger() )
            call UnitDamageTarget( GetEventDamageSource(), LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xD84480C3), ((LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x6DD3A3AB))*( ((0.02)*( I2R(GetUnitAbilityLevel(GetTriggerUnit(), 'A0K2')))))), false, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_DIVINE, WEAPON_TYPE_WHOKNOWS )
