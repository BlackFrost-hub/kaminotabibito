function Trig___________D______uFunc004T takes nothing returns nothing
    if ((LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xCEA5D211) >= 20.00)) then
        call PauseUnit( LoadUnitHandle(YDHT, StringHash( "克劳德"), 0x8A89ED65), false )
        call SetUnitFlyHeight( LoadUnitHandle(YDHT, StringHash( "克劳德"), 0x8A89ED65), ((GetUnitDefaultFlyHeight(LoadUnitHandle(YDHT, StringHash( "克劳德"), 0x8A89ED65)))+( 0.00)), 0.00 )
