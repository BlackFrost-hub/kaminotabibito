function Trig_________________________CSActions takes nothing returns nothing
    local integer ydl_localvar_step = LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xCFDE6C76) 
 set ydl_localvar_step = ydl_localvar_step + 3 
 call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xCFDE6C76, ydl_localvar_step) 
 call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7, ydl_localvar_step)
    if ((IsUnitHiddenBJ(gg_unit_e03D_0491) == false)) then
        call SetUnitPosition( GetTriggerUnit(), 29562.10, -25623.90 )
        call StarOther_PanCameraToTimedUnitForPlayer( GetOwningPlayer(GetTriggerUnit()), GetTriggerUnit(), 0.10 )
    else
    endif
    if ((IsUnitInRangeXY(GetTriggerUnit(), -22144.90, -29871.90, 450.00) == true)) then
        call SetUnitPosition( GetTriggerUnit(), -24150.50, -17284.60 )
        call StarOther_PanCameraToTimedUnitForPlayer( GetOwningPlayer(GetTriggerUnit()), GetTriggerUnit(), 0.10 )
        if ((GetHeroLevel(GetTriggerUnit()) >= 18)) then
            if ((LoadBoolean(YDHT, StringHash( "csdh"), 0xD963A09F) == false)) then
                call SaveBoolean(YDHT, StringHash( "csdh"), 0xD963A09F, true)
                call SaveUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xCB31EDE4, CreateUnit(Player(PLAYER_NEUTRAL_AGGRESSIVE), 'nsea', -26368.60, -16911.50, GetRandomDirectionDeg()))
            else
            endif
            call TransmissionFromUnitWithNameBJ( GetPlayersAll(), GetTriggerUnit(), GetUnitName(GetTriggerUnit()), null, "TRIGSTR_1623", bj_TIMETYPE_SET, 5.00, true )
        else
        endif
    else
    endif
    if ((GetOwningPlayer(LoadUnitHandle(YDHT, StringHash( "沙漠绿洲篝火"), 0x62274AD0)) == Player(PLAYER_NEUTRAL_PASSIVE)) and (IsUnitInRangeXY(GetTriggerUnit(), -6223.50, -23389.50, 300.00) == true)) then
        call SetUnitOwner( LoadUnitHandle(YDHT, StringHash( "沙漠绿洲篝火"), 0x62274AD0), GetOwningPlayer(GetTriggerUnit()), true )
        call ForForce( LoadForceHandle(YDHT, StringHash( "玩家"), 0x7C23C9D2), function Trig_________________________CSFunc004Func004A )
        call QuestMessageBJ( GetPlayersAll(), bj_QUESTMESSAGE_HINT, "TRIGSTR_1624" )
        call PingMinimap( -5029.40, -24528.70, 5.00 )
        call RemoveLocation( udg_FHD )
        set udg_FHD = Location(-5029.40, -24528.70)
        call FlushChildHashtable(YDHT, StringHash( "沙漠绿洲篝火"))
    else
    endif
    call FlushChildHashtable(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step)
endfunction
