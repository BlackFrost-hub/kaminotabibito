    call SaveUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x76ABBC1D, LoadUnitHandle(YDHT, StringHash( "Boss战"), 0x4F42CF89))
    call SaveUnitHandle(YDHT, StringHash( "Boss战"), 0x62274AD0, LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x76ABBC1D))
    call StarExecuteEvent( "Boss战启动", false )
