//***************************************************************************
//*
//*  Custom Script Code
//*
//***************************************************************************
//TESH.scrollpos=0
//TESH.alwaysfold=0
﻿// ============================================
// YDWE 扩展函数声明
// ============================================
native DzUnitDisableAttack takes unit whichUnit, boolean flag returns nothing
native DzUnitEnableAttack takes unit whichUnit returns nothing
native DzSetEffectAnimation takes effect e, integer animIndex, integer animMode returns nothing;
//==============================================
//StarWE的文件声明
//==============================================
//Base.j require
//基础�?
//List�?
//在自定义代码区顶部输入 #include "Star\\StarList.j" 来引用List
//new List 例如 integer list = SCreateList(location)
//List.Count 例如 integer count = SGetCount(location,1) 读取ID为1的List<location>
//List.Remove 例如 SRemoveAny(location,l,1) 把点 l 从 ID为1 的 List<location> 中移除
//List.Add  例如 SAddAny(location,l,1) 把点 l 从 添加至 ID为1 的 List<location> 中
//List.Destroy 例如 SRemoveList(location,1) 摧毁 ID为1 的List<location>
//List.Clear 例如 SClearList(location,1) 清空 ID为1 的List<location>
//List.First 例如 location p = SFirstOfList(location,1) 获取 ID为1 的List<location>中第一个location
//forlist t = Trigger  
//forlist t = function name
//在ForList中用于获取选取的成员
//事件监听�?
//事件.j
native RemoveSavedBoolean takes hashtable table, integer parentKey, integer childKey returns nothing
native RemoveSavedHandle takes hashtable table, integer parentKey, integer childKey returns nothing
native RemoveSavedInteger takes hashtable table, integer parentKey, integer childKey returns nothing
native RemoveSavedReal takes hashtable table, integer parentKey, integer childKey returns nothing
native RemoveSavedString takes hashtable table, integer parentKey, integer childKey returns nothing
//为单位注册添加事件响�?参数 单位 事件�?触发�?禁止重复添加
//为单位移除事件响�?参数 单位 事件�?触发�?禁止重复添加
//StarUI加载资源文件



    

    

    

    

    
//#include"XG_LUA_item.lua"
//#include"XG_LUA_unit_normal.lua"
function smd takes string s returns nothing
call SetMapDescription(s)
call PlayMusic("Music\\bgm0110.mp3")
endfunction

//***************************************************************************
//*
//*  Triggers
//*
//***************************************************************************
//===========================================================================
// Trigger: 初始initial
//
// 是否已选择英雄条件要改
//===========================================================================
function Trig_______initialFunc023A takes nothing returns nothing
    call GS_PanCameraToTimedLocForPlayer( GetEnumPlayer(), GetRectCenter(gg_rct___________________YXXZ), 0.10 )
    call SetCameraFieldForPlayer( GetEnumPlayer(), CAMERA_FIELD_TARGET_DISTANCE, 2800.00, 0 )
    call SetPlayerHandicapXP( GetEnumPlayer(), ((0.35)+( ((0.65)*( udg_T)))) )
endfunction
function Trig_______initialFunc026A takes nothing returns nothing
    call SetPlayerStateBJ( GetEnumPlayer(), PLAYER_STATE_RESOURCE_GOLD, 666 )
endfunction
function Trig_______initialFunc028Func002T takes nothing returns nothing
    call EC_CreateEffect( "Abilities\\Spells\\Human\\Resurrect\\ResurrectTarget.mdl", -27818.50, 28435.60, 40.00, 270.0, 8.00, 0.75, 2.00 )
    call FlushChildHashtable(YDLOC, GetHandleId(GetExpiredTimer()))
    call DestroyTimer(GetExpiredTimer())
endfunction
function Trig_______initialFunc028T takes nothing returns nothing
    local timer ydl_timer
    call EC_CreateEffect( "war3mapImported\\TX25.mdl", -27818.50, 28435.60, 40.00, 270.0, 4.00, 1.0, 5.00 )
    set ydl_timer = CreateTimer()
    call TimerStart(ydl_timer, 1.50, false, function Trig_______initialFunc028Func002T)
    call FlushChildHashtable(YDLOC, GetHandleId(GetExpiredTimer()))
    call DestroyTimer(GetExpiredTimer())
    set ydl_timer = null
endfunction
function Trig_______initialFunc029Conditions takes nothing returns nothing
    call YDWETimerDestroyEffect( 2, AddSpecialEffect("Abilities\\Spells\\Human\\Polymorph\\PolyMorphDoneGround.mdl", GetUnitX(GetTriggerUnit()), GetUnitY(GetTriggerUnit())) )
endfunction
function Trig_______initialFunc030Func005T takes nothing returns nothing
    call SaveBoolean(YDHT, StringHash( "主线剧情"), 0xC5D7720F, false)
    call FlushChildHashtable(YDLOC, GetHandleId(GetExpiredTimer()))
    call DestroyTimer(GetExpiredTimer())
endfunction
function Trig_______initialFunc030Conditions takes nothing returns nothing
    local timer ydl_timer
    call SaveBoolean(YDHT, StringHash( "主线剧情"), 0xC5D7720F, true)
    call SaveBoolean(YDHT, GetHandleId( GetTriggerPlayer()), 0x8C4697CF, false)
    call SetCameraFieldForPlayer( GetTriggerPlayer(), CAMERA_FIELD_TARGET_DISTANCE, 3000.00, 0 )
    call StopMusic( false )
    set ydl_timer = CreateTimer()
    call TimerStart(ydl_timer, 7.00, false, function Trig_______initialFunc030Func005T)
    set ydl_timer = null
endfunction
function Trig_______initialFunc032Conditions takes nothing returns nothing
    local integer ydul_A
    call SaveUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0x3D91B70E, LoadUnitHandle(YDHT, GetHandleId( GetTriggerPlayer()), 0xB06AB615))
    call SaveUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0x4368DDEF, LoadUnitHandle(YDHT, GetHandleId( GetTriggerPlayer()), 0x4368DDEF))
    call SaveUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xD9FDA690, LoadUnitHandle(YDHT, GetHandleId( GetTriggerPlayer()), 0x3BD4963D))
    call SaveReal(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xA99320FA, GetUnitX(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()), 0x3D91B70E)))
