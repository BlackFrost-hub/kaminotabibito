        call Number2Int(1)  // StarRunCode(c);
    endfunction

//library StarBase ends
//library StarJump:
    struct StarJump__SJumper   //跳跃系统 //系统中心计时器
    //! pragma implicitthis
        static timer Timer  //运行指示符
        static boolean IsRun=false  //栈顶计数
        static integer count=0  //临时参数
        static integer now=0  //临时参数
        static boolean skip=false  //子成员列表
        static StarJump__SJumper  array sjlist  //跳跃者
        unit u  //已经跳跃距离
        real disd  //需要跳跃距离
        real dis  //速度
        real speed  //最大跳跃高度
        real maxheight  //跳跃方向
        real d  //
        real lz  //回调
        trigger callback  //命令单位u朝d开始跳跃,最大高度,跳跃距离,所需时间,结束回调
        static method create takes unit u,real d,real mz,real dis,real time,trigger cb returns thistype
            local thistype this=thistype.allocate()  //unit
            set this.u=u  //fac
            set this.d=d  //MaxHeight
            set this.maxheight=mz  //s=v/t
            set this.speed=dis/(time/0.02)  //callback
            set this.callback=cb  //disd
            set this.dis=dis  //清除路程记录
            set this.disd=0
            set this.lz=0  //使单位可以设置高度
            call UnitAddAbility(u,'Amrf')
            call UnitRemoveAbility(u,'Amrf')  //压栈
            set StarJump__SJumper.sjlist[thistype.count]=this
            set thistype.count=thistype.count+1  //运行计时器;
            call thistype.Start()  //Print("Created");
            return this
        endmethod
        method move takes integer i returns nothing  //移动方法 //
            local real t=disd/dis
            local real x  //Print("Moved");
            local real y
            local real z
            set thistype.now=i
            set x=Star_CoordinateX(GetUnitX(this.u)+CosBJ(this.d)*this.speed)
            set y=Star_CoordinateY(GetUnitY(this.u)+SinBJ(this.d)*this.speed)
            set z=Math.Parabola(t,this.maxheight,0)
            if (GetTerrainType(x,y)!='cOc1')then  //非深渊即可跳跃
                call SetUnitX(u,x)
                call SetUnitY(u,y)
                call SetUnitFlyHeight(u,GetUnitFlyHeight(u)-lz,0)
                call SetUnitFlyHeight(u,GetUnitFlyHeight(u)+z,0)
                set lz=z
            endif  //到距离移除
            set this.disd=this.disd+this.speed
            if (this.disd>=this.dis)then
                set Star_TriggerUnit=this.u  //Print("disd = "+R2S(this.disd) + "dis = " + R2S(dis)); //调用回调
                if (TriggerEvaluate(this.callback))then
                    call TriggerExecute(this.callback)
                endif  //退栈
                call this.destroy()
            endif
        endmethod  //
        method onDestroy takes nothing returns nothing  //Print("Destroyed");
            call SetUnitFlyHeight(this.u,GetUnitFlyHeight(this.u)-this.lz,0)  //出栈
            if (thistype.now!=thistype.count-1)then
                set thistype.skip=true
                set thistype.sjlist[thistype.now]=thistype.sjlist[thistype.count-1]
            endif
            set thistype.count=thistype.count-1
        endmethod  //开启中心计时器
            private static method anon__0 takes nothing returns nothing  //遍历子成员
                local integer i=0
                local StarJump__SJumper sj
                loop
                exitwhen (i>=StarJump__SJumper.count)
                    set thistype.now=i
                    set sj=StarJump__SJumper.sjlist[i]
                    call sj.move(i)
                    if (thistype.skip)then
                        set thistype.skip=false
                        set i=i-1
                    endif
                    set i=i+1
                endloop  //没有子成员,停止计时器
                if (StarJump__SJumper.count==0)then
                    call StarJump__SJumper.Stop()
                endif
            endmethod
        static method Start takes nothing returns nothing
            if (not (thistype.IsRun))then
                call TimerStart(Timer,0.02,true,function thistype.anon__0)
                set thistype.IsRun=true
            endif
        endmethod  //停止中心计时器
        static method Stop takes nothing returns nothing
            if (thistype.IsRun)then
                call PauseTimer(thistype.Timer)  //Print("Stoped");
                set thistype.IsRun=false
            endif
        endmethod
        static method onInit takes nothing returns nothing  //Print("Inited");
            set thistype.Timer=CreateTimer()
        endmethod
    endstruct
    function SJ_JumpBase takes unit u,real d,real mz,real dis,real time,trigger cb returns nothing
        if (GetUnitDefaultMoveSpeed(u)>0.1)then
            call StarJump__SJumper.create(u,d,mz,dis,time,cb)
        endif
    endfunction

//library StarJump ends
//library StarOverSpeed:
    struct StarOverSpeed___StarOverSpeedGenerator   //系统中心计时器
    //! pragma implicitthis
        static timer Timer  //运行指示符
        static boolean IsRun=false  //栈顶计数
        static integer count=0  //临时参数
        static integer now=0  //临时参数
        static boolean skip=false  //子成员列表
        static thistype  array list  //回调事件类型
        static integer EventID=0
        static integer hashkey=0x02C93F13  //移动速度 
        real speed  //突破移动速度的单位
        unit u  //监视触发器
        trigger t  //回调触发器?
        trigger cb  //命令发布目标点X
        real tx  //命令发布目标点Y
        real ty
        real lx
        real ly
        real lf  //TODO  动作同步
        boolean movementsync  //TODO  动作同步
        boolean b
            private static method anon__0 takes nothing returns nothing  //保存当前对象 //设置变量开始
                local integer i=LoadInteger(StarBaseHT,GetHandleId(GetTriggeringTrigger()),hashkey)
                local StarOverSpeed___StarOverSpeedGenerator this=i
                set this.tx=GetOrderPointX()
                set this.ty=GetOrderPointY()
            endmethod
        static method create takes unit u,real s,boolean b returns thistype
            local thistype this
            if (not (HaveSavedInteger(StarBaseHT,GetHandleId(u),hashkey)))then
                set this=thistype.allocate()
                call SaveInteger(StarBaseHT,GetHandleId(u),hashkey,this)
                set this.u=u
                set this.speed=s
                set this.t=CreateTrigger()
                call SaveInteger(StarBaseHT,GetHandleId(this.t),hashkey,this)
                call TriggerAddAction(this.t,function thistype.anon__0)
                call TriggerRegisterUnitEvent(this.t,u,EVENT_UNIT_ISSUED_POINT_ORDER)  //设置变量结束
                set thistype.list[thistype.count]=this  //--------------压栈-------------- 无需改动
                set thistype.count=thistype.count+1  //检查中心计时器运行状态
                call thistype.Start()
                return this
            else
                return LoadInteger(StarBaseHT,GetHandleId(u),hashkey)
            endif
        endmethod  //
        method doEvent takes integer i returns nothing
            local real x  //TODO for 动作同步
            local real y
            local real f
            local real d
            local real dis
            local real dis2
            local real s
            local real s2
            set x=GetUnitX(u)
            set y=GetUnitY(u)
            if (GetUnitCurrentOrder(u)==851971 or GetUnitCurrentOrder(u)==851986)then
                set s=speed-GetUnitMoveSpeed(u)
                set s2=s/50
                set dis=Math.GDBC(x,y,lx,ly)
                set dis2=Math.GDBC(x,y,tx,ty)
                set f=GetUnitFacing(u)
                if (dis>(GetUnitMoveSpeed(u)/60))then
                    if (RAbsBJ(f)-RAbsBJ(lf)<2)then
                        if (dis2>s2)then
                            set d=Math.GAFC(lx,ly,x,y)
                            set lx=x+CosBJ(d)*s2
                            set ly=y+SinBJ(d)*s2
                            if (not (X_IsTerrainWalkable(lx,ly)))then
                                set lx=X_GetAbleX()
                                set ly=X_GetAbleY()
                            endif
                            call SetUnitX(u,lx)
                            call SetUnitY(u,ly)
                        else
                            set lx=tx
                            set ly=ty
                            if (not (X_IsTerrainWalkable(lx,ly)))then
                                set lx=X_GetAbleX()
                                set ly=X_GetAbleY()
                            endif
                            call SetUnitX(u,lx)
                            call SetUnitY(u,ly)
                        endif
                    else
                        set lx=x
                        set ly=y
                    endif
                else
                    set lx=x
                    set ly=y
                endif
                set lf=f
            else
                set lx=x
                set ly=y
            endif
        endmethod
        method onDestroy takes nothing returns nothing
            call RemoveSavedInteger(StarBaseHT,GetHandleId(this.t),hashkey)
            call RemoveSavedInteger(StarBaseHT,GetHandleId(this.u),hashkey)
            call DestroyTrigger(this.t)
            set this.u=null  //------------------出栈--------------
            if (thistype.now!=thistype.count-1)then
                set thistype.skip=true
                set thistype.list[thistype.now]=thistype.list[thistype.count-1]
            endif
            set thistype.count=thistype.count-1
        endmethod  //-------------- 无需改动--------------------
            private static method anon__1 takes nothing returns nothing  //开启中心计时器 //遍历子成员
                local integer i=0
                loop
                exitwhen (i>=thistype.count)
                    set thistype.now=i
                    call thistype.list[i].doEvent(i)
                    if (thistype.skip)then
                        set thistype.skip=false
                        set i=i-1
                    endif
                    set i=i+1
                endloop  //没有子成员,停止计时器
                if (thistype.count==0)then
                    call thistype.Stop()
                endif
            endmethod
        static method Start takes nothing returns nothing
            if (not (thistype.IsRun))then
                call TimerStart(Timer,0.02,true,function thistype.anon__1)
                set thistype.IsRun=true
            endif
        endmethod  //-------------- 无需改动--------------------
        static method Stop takes nothing returns nothing  //停止中心计时器
            if (thistype.IsRun)then
                call PauseTimer(thistype.Timer)
                set thistype.IsRun=false
            endif
        endmethod  //-------------- 无需改动--------------------
        static method onInit takes nothing returns nothing
            set thistype.Timer=CreateTimer()
        endmethod
    endstruct  //移动速度突破 单位 u  速度 s (是否动作同步 b 暂无)
    function SOS_SetUnitSpeed takes unit u,real s,boolean b returns integer
        local StarOverSpeed___StarOverSpeedGenerator this
        if (HaveSavedInteger(StarBaseHT,GetHandleId(u),StarOverSpeed___StarOverSpeedGenerator.hashkey))then
            set this=LoadInteger(StarBaseHT,GetHandleId(u),StarOverSpeed___StarOverSpeedGenerator.hashkey)
            set this.speed=s
            set this.b=b
        else
            set this=StarOverSpeed___StarOverSpeedGenerator.create(u,s,b)
        endif  //debug if(this==0){Print("an error at function SOS_SetUnitSpeed overflow of struct");}
        return this
    endfunction  //获取单位当前移动速度 若不在系统中 则返回当前移动速度
    function SOS_GetUnitSpeed takes unit u returns real
        local StarOverSpeed___StarOverSpeedGenerator this
        local real s
        if (HaveSavedInteger(StarBaseHT,GetHandleId(u),StarOverSpeed___StarOverSpeedGenerator.hashkey))then
            set this=LoadInteger(StarBaseHT,GetHandleId(u),StarOverSpeed___StarOverSpeedGenerator.hashkey)
            set s=this.speed
        else
            set s=GetUnitMoveSpeed(u)
        endif
        return s
    endfunction  //取消移动速度突破 单位u
    function SOS_UnSetUnitSpeed takes unit u returns nothing
        local StarOverSpeed___StarOverSpeedGenerator this
        if (HaveSavedInteger(StarBaseHT,GetHandleId(u),StarOverSpeed___StarOverSpeedGenerator.hashkey))then
            set this=LoadInteger(StarBaseHT,GetHandleId(u),StarOverSpeed___StarOverSpeedGenerator.hashkey)
            call this.destroy()
        endif
    endfunction

//library StarOverSpeed ends
//library StarPushback:
    struct StarPushback__StarPushbacker   //击退 //系统中心计时器
    //! pragma implicitthis
        static timer Timer  //运行指示符
        static boolean IsRun=false  //栈顶计数
        static integer count=0  //临时参数
        static integer now=0  //临时参数
        static boolean skip=false  //子成员列表
        static StarPushback__StarPushbacker  array sjlist
        boolean useEffect=false
        string EffectPath=SP_EffectPath  //被击退者
        unit u  //初始速度
        real speed  //减速度
        real sl  //击退方向
        real d  //回调
        trigger callback  //命令单位u朝d开始击退,单位 方向 距离 时间 回调
        static method create takes unit u,real d,real dis,real time,trigger cb returns thistype
            local thistype this
            local real s2=0
            local real x
            local real y
            if (time>0)then
                set this=thistype.allocate()
                set this.u=u
                set this.d=d
                set this.useEffect=SP_UseEffect
                set this.speed=2*dis*0.02/time
                set this.sl=speed*0.02/time
                set this.callback=cb
                set thistype.sjlist[thistype.count]=this
                set thistype.count=thistype.count+1
                call thistype.Start()
                return this
            else
                set x=Star_CoordinateX(GetUnitX(u)+CosBJ(d)*dis)
                set y=Star_CoordinateY(GetUnitY(u)+SinBJ(d)*dis)
                if (X_IsTerrainWalkable(x,y))then
                    call SetUnitX(u,x)
                    call SetUnitY(u,y)
                else
                    call SetUnitX(u,X_X)
                    call SetUnitY(u,X_Y)
                endif
            endif
            return 0
        endmethod
        method move takes integer i returns nothing  //移动方法
            local real x
            local real y
            local real z
            set thistype.now=i
            set x=Star_CoordinateX(GetUnitX(this.u)+CosBJ(this.d)*this.speed)
            set y=Star_CoordinateY(GetUnitY(this.u)+SinBJ(this.d)*this.speed)  //匀减速
            set this.speed=this.speed-this.sl
            if (X_IsTerrainWalkable(x,y))then
                call SetUnitX(u,x)
                call SetUnitY(u,y)
                if (this.useEffect)then
                    call DestroyEffect(AddSpecialEffect(this.EffectPath,x,y))
                endif
            else
                set StarPushbackEventId=2  //撞墙结束
                set Star_TriggerUnit=this.u
                if (TriggerEvaluate(this.callback))then
                    call TriggerExecute(this.callback)
                endif  //退栈
                call this.destroy()
            endif
            if (this.speed<=0)then
                set StarPushbackEventId=3  //调用回调 //正常结束
                set Star_TriggerUnit=this.u
                if (TriggerEvaluate(this.callback))then
                    call TriggerExecute(this.callback)
                endif  //退栈
                call this.destroy()
            endif
        endmethod  //自毁
        method onDestroy takes nothing returns nothing  //出栈
            if (thistype.now!=thistype.count-1)then
                set thistype.skip=true
                set thistype.sjlist[thistype.now]=thistype.sjlist[thistype.count-1]
            endif
            set thistype.count=thistype.count-1
        endmethod  //开启中心计时器
            private static method anon__0 takes nothing returns nothing
                local integer i=0
                local StarPushback__StarPushbacker sj
                loop
                exitwhen (i>=StarPushback__StarPushbacker.count)
                    set thistype.now=i
                    set sj=StarPushback__StarPushbacker.sjlist[i]
                    call sj.move(i)
                    if (thistype.skip)then
                        set thistype.skip=false
                        set i=i-1
                    endif
                    set i=i+1
                endloop
                if (StarPushback__StarPushbacker.count==0)then
                    call StarPushback__StarPushbacker.Stop()
                endif
            endmethod
        static method Start takes nothing returns nothing
            if (not (thistype.IsRun))then
                call TimerStart(Timer,0.02,true,function thistype.anon__0)
                set thistype.IsRun=true
            endif
        endmethod  //停止中心计时器
        static method Stop takes nothing returns nothing
            if (thistype.IsRun)then
                call PauseTimer(thistype.Timer)  //Print("Stoped");
                set thistype.IsRun=false
            endif
        endmethod
        static method onInit takes nothing returns nothing  //Print("Inited");
            set thistype.Timer=CreateTimer()
        endmethod
    endstruct
    function SP_PBBase takes unit u,real d,real dis,real time,trigger cb returns nothing
        if (time<0.02)then
            set time=0.02
        endif
        if (GetUnitDefaultMoveSpeed(u)>0.1 and GetUnitMoveSpeed(u)>0.1)then
            call StarPushback__StarPushbacker.create(u,d,dis,time,cb)
        endif
    endfunction

//library StarPushback ends
//library StarSound:

    //public:
    function StarSound__TimerEvent takes nothing returns nothing
        local integer id=LoadInteger(HT,GetHandleId(GetExpiredTimer()),10)
        call Sound3DII_Mp3Play(NowSound[id],Player(id))
    endfunction
    function StarSound__inittimer takes nothing returns nothing
        local integer i=0
        set i=0
        loop
        exitwhen (i>=12)
            set Sounds[i]=null  //BJDebugMsg(I2S(i));
            set timers[i]=CreateTimer()
        set i = i+1
        endloop
    endfunction  //暂无
    function StarSound_StopSound takes player p returns nothing
        local integer id=GetPlayerId(p)
    endfunction  //停止音效循环对指定玩家 不会停止音效播放
    function StarSound_StopLoop takes player p returns nothing
        local integer id=GetPlayerId(p)
        call PauseTimer(timers[id])
    endfunction  //播放音效对玩家，是否循环->bool
    function StarSound_PlayMp3 takes string s,player p,boolean b returns nothing
        local integer id=0
        local integer i=0
        local timer t=null
        if (p!=null)then
            if (not b)then
                call Sound3DII_Mp3Play(s,p)  //Sounds[id] = bj_lastPlayedSound;
            else
                set id=GetPlayerId(p)
                set t=timers[id]
                set NowSound[id]=s
                call SaveInteger(HT,GetHandleId(t),10,id)
                call TimerStart(t,I2R(GetSoundFileDuration(s))*0.001+0.1,true,function StarSound__TimerEvent)
            endif
        else
            set i=0
            loop
            exitwhen (i>=15)
                set p=Player(i)
                if (not b)then
                    call Sound3DII_Mp3Play(s,p)
                else
                    set id=i
                    set t=timers[id]
                    set NowSound[id]=s
                    call SaveInteger(HT,GetHandleId(t),10,id)
                    call TimerStart(t,I2R(GetSoundFileDuration(s))*0.001+0.1,true,function StarSound__TimerEvent)
                endif
            set i = i+1
            endloop
        endif
        set t=null
    endfunction
    function StarSound__onInit takes nothing returns nothing
        call StarSound__inittimer()
    endfunction

//library StarSound ends
//library StarUnit:

    //private:
    function SU_IsUnitInvincible takes unit u returns boolean  //�жϵ�λ���޵еģ���λ�޵��򷵻�true ���򷵻�false
        if (GetUnitAbilityLevel(u,'Avul')!=0)then
            return true
        elseif (GetUnitAbilityLevel(u,'Bvul')!=0)then
            return true
        elseif (GetUnitAbilityLevel(u,'BHds')!=0)then
            return true
        endif
        return false
    endfunction
    //public:
        function SU_SetUnitFlyHeight takes unit whichUnit,real newHeight,real rate returns nothing
            call UnitAddAbility(whichUnit,'Amrf')
            call UnitRemoveAbility(whichUnit,'Amrf')
            call SetUnitFlyHeight(whichUnit,newHeight,rate)
        endfunction
    function SU_GetHeroAllState takes unit u,boolean b returns real
        return I2R(GetHeroStr(u,b)+GetHeroAgi(u,b)+GetHeroInt(u,b))
    endfunction  //��ȡ��λ�Ѿ���ʧ������ֵ�ٷֱ�
    function SU_GetUnitLostHPPercent takes unit u returns real
        return (GetUnitState(u,UNIT_STATE_MAX_LIFE)-GetUnitState(u,UNIT_STATE_LIFE))/GetUnitState(u,UNIT_STATE_MAX_LIFE)
    endfunction  //��ȡ��λ�Ѿ���ʧ������ֵ
    function SU_GetUnitLostHP takes unit u returns real
        return GetUnitState(u,UNIT_STATE_MAX_LIFE)-GetUnitState(u,UNIT_STATE_LIFE)
    endfunction  //Ϊ��λu��������ֵ ֵΪ value �Ƿ�ٷֱ�->bool
    function UnitAddHp takes unit u,real value,boolean b returns nothing
        local real hp=GetUnitState(u,UNIT_STATE_LIFE)
        local real maxhp=GetUnitState(u,UNIT_STATE_MAX_LIFE)
        local real bfb=hp/maxhp
        local real t
        if (b)then
            set t=maxhp*value  //�ٷֱ�
        else
            set t=value
        endif  //��������
        call SetUnitState(u,UNIT_STATE_MAX_LIFE,t+maxhp)  //��������ֵ
        call SetUnitState(u,UNIT_STATE_LIFE,(GetUnitState(u,UNIT_STATE_MAX_LIFE)*bfb))
    endfunction  //��λ�����������ͼ��-��ˮԪ�� �����ˮԪ�� �򷵻�true
    function IsWaterElement takes unit u returns boolean
        return GetUnitAbilityLevel(u,'BHwe')!=0
    endfunction  //��ȡ��λ��������ID        
    function GetUnitTimedLifeID takes unit u returns integer
        if (GetUnitAbilityLevel(u,'BUan')!=0)then  //������ʬ
            return 1
        endif  //��������
        if (GetUnitAbilityLevel(u,'Bapl')!=0)then
            return 2
        endif  //��Ȼ֮��
        if (GetUnitAbilityLevel(u,'BEfn')!=0)then
            return 3
        endif  //��������
        if (GetUnitAbilityLevel(u,'Bhwd')!=0)then
            return 4
        endif  //������ʬ
        if (GetUnitAbilityLevel(u,'Brai')!=0)then
            return 5
        endif  //ˮԪ��
        if (GetUnitAbilityLevel(u,'BHwe')!=0)then
            return 6
        endif  //��ʱ������
        if (GetUnitAbilityLevel(u,'BTLF')!=0)then
            return 7
        endif  //ʲôҲ����
        return 0
    endfunction  //ת������Ϊ��������ö��ID -> GUI��װ
    function I2TimedLifeID takes integer i returns integer
        return i
    endfunction  //ת��������ַΪ��λ
