//library StarUI2 ends
//library X2:

    //private:
    struct X2__Point2f   //定义Point2f结构体  
    //! pragma implicitthis
        real x
        real y
        static method create2 takes real X,real Y returns X2__Point2f
            local X2__Point2f p=X2__Point2f.allocate()
            set p.x=X
            set p.y=Y
            return p
        endmethod
        method reset takes real X,real Y returns nothing
            set this.x=X
            set this.y=Y
        endmethod
    endstruct  // 定义直线参数结构体  
    struct X2__LinePara 
    //! pragma implicitthis
        real k
        real b
    endstruct  //单位间距离
    function X2__DistanceBetweenUnit takes unit a,unit b returns real
        local real x1=GetUnitX(a)
        local real y1=GetUnitY(a)
        local real x2=GetUnitX(b)
        local real y2=GetUnitY(b)
        return SquareRoot((y1-y2)*(y1-y2)+(x1-x2)*(x1-x2))
    endfunction  // 已知两点求直线
    function getLinePara takes real x1,real y1,real x2,real y2,X2__LinePara LP returns nothing
        local real m=0  // 计算分子  
        set m=x2-x1
        if (0==m)then
            set LP.k=10000.0
            set LP.b=y1-LP.k*x1
        else
            set LP.k=(y2-y1)/(x2-x1)
            set LP.b=y1-LP.k*x1
        endif  // y = kx + b
    endfunction
    function GAFC2 takes real x1,real y1,real x2,real y2 returns real
        return Atan2(y2-y1,x2-x1)*bj_RADTODEG
    endfunction
    function GetDistanceUsePoint takes X2__Point2f p1,X2__Point2f p2 returns real
        return SquareRoot((p1.y-p2.y)*(p1.y-p2.y)+(p1.x-p2.x)*(p1.x-p2.x))
    endfunction
    function getDistancePointAndLine takes X2__Point2f p0,X2__Point2f p1,X2__Point2f p2 returns real
        local real dis12=GetDistanceUsePoint(p1,p2)
        local real dis01=GetDistanceUsePoint(p0,p1)
        local real dis02=GetDistanceUsePoint(p0,p2)
        local real HalfC=(dis12+dis01+dis02)/2
        local real s=SquareRoot(HalfC*(HalfC-dis12)*(HalfC-dis01)*(HalfC-dis02))
        local real dis=2*s/dis12
        return dis
    endfunction
    function getDistancePointAndLine2 takes X2__Point2f p0,X2__Point2f p1,X2__Point2f p2,real dis12 returns real
        local real dis01=GetDistanceUsePoint(p0,p1)
        local real dis02=GetDistanceUsePoint(p0,p2)
        local real HalfC=(dis12+dis01+dis02)/2
        local real s=SquareRoot(HalfC*(HalfC-dis12)*(HalfC-dis01)*(HalfC-dis02))
        local real dis=2*s/dis12
        return dis
    endfunction
    function fabs takes real a returns real
        if (a>=0)then
            return a
        endif
        return -a
    endfunction
    function getDistancePointAndLine3 takes X2__Point2f p0,X2__Point2f p1,X2__Point2f p2 returns real
        local real x0=p0.x
        local real x1=p1.x
        local real x2=p2.x
        local real y0=p0.x
        local real y1=p1.x
        local real y2=p2.x
        return (fabs((y2-y1)*x0+(x1-x2)*y0+((x2*y1)-(x1*y2))))/(SquareRoot(Pow(y2-y1,2)+Pow(x1-x2,2)))
    endfunction
    //public:
    function X2_GetNearUnitOnGroup takes group gg,unit un returns unit  //获取单位组中里单位最近的单位
        local unit u
        local integer index=0
        local integer i=0
        local real j=0
        set X2__ReturnUnit=null
        set X2__tempg=CreateGroup()
        call GroupAddGroup(gg,X2__tempg)
        set u=FirstOfGroup(X2__tempg)
        loop
        exitwhen (u==null)
            if (GetUnitState(u,UNIT_STATE_LIFE)>0.00)then
                set X2__arrayU[index]=u
                set X2__arrayI[index]=X2__DistanceBetweenUnit(u,un)
                set index=index+1
            endif
            call GroupRemoveUnit(X2__tempg,u)
            set u=FirstOfGroup(X2__tempg)
        endloop  // GroupClear(tempg);
        call DestroyGroup(X2__tempg)
        if (index>0)then
            set j=X2__arrayI[i]
            set X2__ReturnUnit=X2__arrayU[i]
            loop
            exitwhen (i>=index)
                if (X2__arrayI[i]<j)then  //这个值小于当前记录最小值
                    set j=X2__arrayI[i]  //当前记录最小值 = 这个值 //当前记录单位 = 这个单位
                    set X2__ReturnUnit=X2__arrayU[i]
                endif
                set i=i+1
            endloop
        endif
        set u=null
        return X2__ReturnUnit
    endfunction  //生命值最少的单位
    function X2_GetMinHpOfGroup takes group gg returns unit
        local unit u
        local integer index=0
        local integer i=0
        local real j=0
        set X2__ReturnUnit=null
        set X2__tempg=CreateGroup()
        call GroupAddGroup(gg,X2__tempg)
        set u=FirstOfGroup(X2__tempg)
        loop
        exitwhen (u==null)
            if (GetUnitState(u,UNIT_STATE_LIFE)>0.00)then
                set X2__arrayU[index]=u
                set X2__arrayI[index]=GetUnitState(u,UNIT_STATE_LIFE)
                set index=index+1
            endif
            call GroupRemoveUnit(X2__tempg,u)
            set u=FirstOfGroup(X2__tempg)
        endloop  // GroupClear(tempg);
        call DestroyGroup(X2__tempg)
        if (index>0)then
            set j=X2__arrayI[i]
            set X2__ReturnUnit=X2__arrayU[i]
            loop
            exitwhen (i>=index)
                if (X2__arrayI[i]<j)then  //这个值小于当前记录最小值
                    set j=X2__arrayI[i]  //当前记录最小值 = 这个值 //当前记录单位 = 这个单位
                    set X2__ReturnUnit=X2__arrayU[i]
                endif
                set i=i+1
            endloop
        endif
        set u=null
        return X2__ReturnUnit
    endfunction
    function X2_GDBC takes real x1,real y1,real x2,real y2 returns real
        return SquareRoot((y1-y2)*(y1-y2)+(x1-x2)*(x1-x2))
    endfunction
    function X2_GetNearPointOnGroup takes group gg,real x,real y returns unit  //获取单位组中离指定坐标最近的单位
        local unit u
        local integer index=0
        local integer i=0
        local real j=0
        set X2__ReturnUnit=null
        set X2__tempg=CreateGroup()
        call GroupAddGroup(gg,X2__tempg)
        set u=FirstOfGroup(X2__tempg)
        loop
        exitwhen (u==null)
            if (GetUnitState(u,UNIT_STATE_LIFE)>0.00)then
                set X2__arrayU[index]=u
                set X2__arrayI[index]=X2_GDBC(GetUnitX(u),GetUnitY(u),x,y)
                set index=index+1
            endif
            call GroupRemoveUnit(X2__tempg,u)
            set u=FirstOfGroup(X2__tempg)
        endloop
        call GroupClear(X2__tempg)
        call DestroyGroup(X2__tempg)
        if (index>0)then
            set j=X2__arrayI[i]
            set X2__ReturnUnit=X2__arrayU[i]
            loop
            exitwhen (i>=index)
                if (X2__arrayI[i]<j)then
                    set j=X2__arrayI[i]
                    set X2__ReturnUnit=X2__arrayU[i]
                endif
                set i=i+1
            endloop
        endif
        call DestroyGroup(X2__tempg)
        set u=null
        return X2__ReturnUnit
    endfunction
    function X2_GetNearUnit takes real r,unit un returns unit
        local unit u  //获取指定单位附近X范围内的最近的非友方单位
        local integer index=0
        local integer i=0
        local real j=0
        local group g=CreateGroup()
        set X2__ReturnUnit=null
        set X2__tempg=CreateGroup()
        call GroupEnumUnitsInRange(g,GetUnitX(un),GetUnitY(un),r,null)
        set u=FirstOfGroup(g)
        loop
        exitwhen (u==null)
            if (IsUnitEnemy(u,GetOwningPlayer(un)))then
                call GroupAddUnit(X2__tempg,u)
            endif
            call GroupRemoveUnit(g,u)
            set u=FirstOfGroup(g)
        endloop
        call GroupClear(g)
        call DestroyGroup(g)
        set u=FirstOfGroup(X2__tempg)
        loop
        exitwhen (u==null)
            set X2__arrayU[index]=u
            set X2__arrayI[index]=X2__DistanceBetweenUnit(u,un)
            set index=index+1
            call GroupRemoveUnit(X2__tempg,u)
            set u=FirstOfGroup(X2__tempg)
        endloop
        call GroupClear(X2__tempg)
        call DestroyGroup(X2__tempg)
        if (index>0)then
            set j=X2__arrayI[i]
            set X2__ReturnUnit=X2__arrayU[i]
            loop
            exitwhen (i>=index)
                if (X2__arrayI[i]<j)then
                    set j=X2__arrayI[i]
                    set X2__ReturnUnit=X2__arrayU[i]
                endif
                set i=i+1
            endloop
        endif
        set g=null
        set u=null
        return X2__ReturnUnit
    endfunction
    function GetUnitOnLine takes real x,real y,real a,real b,real r returns group
        local unit u
        local group g=CreateGroup()
        local real c=0
        local real d=0
        local real dis
        local real dd=GAFC2(x,y,a,b)
        set P2.x=a
        set P2.y=b
        set x=x+Cos(dd*bj_DEGTORAD)*0.5*r
        set y=y+Sin(dd*bj_DEGTORAD)*0.5*r
        set c=(x+a)/2
        set d=(y+b)/2
        set P1.x=x
        set P1.y=y
        set dis=GetDistanceUsePoint(P1,P2)
        set callBackGroup=CreateGroup()
        call GroupEnumUnitsInRange(g,c,d,(dis+r)/2,null)
        set u=FirstOfGroup(g)
        loop
        exitwhen (u==null)
            set P0.x=GetUnitX(u)
            set P0.y=GetUnitY(u)
            if (getDistancePointAndLine2(P0,P1,P2,dis)<r)then  //if(getDistancePointAndLine3(P0,P1,P2) <r)
                call GroupAddUnit(callBackGroup,u)
            endif
            call GroupRemoveUnit(g,u)
            set u=FirstOfGroup(g)
        endloop
        call GroupClear(g)
        call DestroyGroup(g)
        set g=null
        set u=null
        return callBackGroup
    endfunction  //
    function GetUnitOnRect takes real x,real y,real a,real b,real r returns group
        local unit u
        local group g=CreateGroup()
        local real c=0
        local real d=0
        local real dis
        local real dd=GAFC2(x,y,a,b)
        local real long=Math.GDBC(x,y,a,b)  //长 = long 宽 = r
        local real hl=long/2
        local real hr=r/2
        set P2.x=a
        set P2.y=b
        set x=x+Cos(dd*bj_DEGTORAD)*0.5*r
        set y=y+Sin(dd*bj_DEGTORAD)*0.5*r
        set c=(x+a)/2
        set d=(y+b)/2
        set P1.x=x
        set P1.y=y
        set dis=GetDistanceUsePoint(P1,P2)
        set callBackGroup=CreateGroup()
        call GroupEnumUnitsInRange(g,c,d,(dis+r)/2,null)
        set u=FirstOfGroup(g)
        loop
        exitwhen (u==null)
            set P0.x=GetUnitX(u)
            set P0.y=GetUnitY(u)
            if (getDistancePointAndLine2(P0,P1,P2,dis)<r)then  //if(getDistancePointAndLine3(P0,P1,P2) <r)
                if (Math.GDBC(x,y,P0.x,P0.y)*SinBJ(Math.GAFC(x,y,P0.x,P0.y)-dd)<hr)then
                    if (Math.GDBC(a,b,P0.x,P0.y)*SinBJ(Math.GAFC(a,b,P0.x,P0.y)-dd-90)<hl)then
                        call GroupAddUnit(callBackGroup,u)
                    endif
                endif
            endif
            call GroupRemoveUnit(g,u)
            set u=FirstOfGroup(g)
        endloop
        call GroupClear(g)
        call DestroyGroup(g)
        set g=null
        set u=null
        return callBackGroup
    endfunction
    function X2__onInit takes nothing returns nothing
        set P0=X2__Point2f.create()
        set P1=X2__Point2f.create()
        set P2=X2__Point2f.create()
        set LP0=X2__LinePara.create()
    endfunction

//library X2 ends
//library handySD:
//漂浮文字
function GS_TextTag takes string S,location L,real G, real D, real Red,real Green,real Blue,real Transparency,real Speed,real Angle,real R1,real R2,force F returns texttag
    set bj_lastCreatedTextTag = CreateTextTag()
    call SetTextTagPos( bj_lastCreatedTextTag, GetLocationX(L), GetLocationY(L), G )
    call SetTextTagVelocityBJ( bj_lastCreatedTextTag, Speed, Angle )
    call SetTextTagTextBJ( bj_lastCreatedTextTag, S, D )
    call SetTextTagColorBJ( bj_lastCreatedTextTag, Red, Green, Blue, Transparency )
    call SetTextTagFadepoint( bj_lastCreatedTextTag, R1)
    call SetTextTagLifespan( bj_lastCreatedTextTag, R2 )
    call SetTextTagPermanent( bj_lastCreatedTextTag, false )
    call ShowTextTagForceBJ( true, bj_lastCreatedTextTag, GetPlayersAll() )
    call RemoveLocation(L)
    return bj_lastCreatedTextTag
endfunction
//移动单位（判定通行）
function GS_moveunit takes unit u, real angle, real dist , pathingtype phe returns nothing
    local real x = GetUnitX(u) + dist * Cos(angle * bj_DEGTORAD)
    local real y = GetUnitY(u) + dist * Sin(angle * bj_DEGTORAD)
    if ((IsTerrainPathable(x, y, phe) == false)) then
        call SetUnitX( u, x)
        call SetUnitY( u, y)
    endif
endfunction
//移动单位
function GS_moveunitT takes unit u, real angle, real dist returns nothing
    local real x = GetUnitX(u) + dist * Cos(angle * bj_DEGTORAD)
    local real y = GetUnitY(u) + dist * Sin(angle * bj_DEGTORAD)
    call SetUnitX( u, YDWECoordinateX(x))
    call SetUnitY( u, YDWECoordinateY(y))
endfunction
//两点间角度
function GS_AngleBetweenPoints takes location locA, location locB returns real
    local real d = bj_RADTODEG * Atan2(GetLocationY(locB) - GetLocationY(locA), GetLocationX(locB) - GetLocationX(locA))
    call RemoveLocation(locA)
    call RemoveLocation(locB)
    return d
endfunction
//两点间距离
function GS_DistanceBetweenPoints takes location locA, location locB returns real
    local real dx = GetLocationX(locB) - GetLocationX(locA)
    local real dy = GetLocationY(locB) - GetLocationY(locA)
    call RemoveLocation(locA)
    call RemoveLocation(locB)
    return SquareRoot(dx * dx + dy * dy)
endfunction
//极坐标转移
function GS_PolarProjectionBJ takes location source, real dist, real angle returns location
    local real x = GetLocationX(source) + dist * Cos(angle * bj_DEGTORAD)
    local real y = GetLocationY(source) + dist * Sin(angle * bj_DEGTORAD)
    call RemoveLocation(source)
    return Location(x, y)
endfunction
//新建单位点
function GS_CreateUnitAtLoct takes player id, integer unitid, location loc, real face returns unit
    if (unitid == 'ugol') then
        set bj_lastCreatedUnit = CreateBlightedGoldmine(id, GetLocationX(loc), GetLocationY(loc), face)
    else
        set bj_lastCreatedUnit = CreateUnitAtLoc(id, unitid, loc, face)
    endif
    call RemoveLocation(loc)
    return bj_lastCreatedUnit
endfunction
//特效点
function GS_AddSpecialEffectLoc takes string modelName, location where returns effect
    set bj_lastCreatedEffect = AddSpecialEffectLoc(modelName, where)
    call RemoveLocation(where)
    return bj_lastCreatedEffect
endfunction
//移动单位
function GS_SetUnitPositionLoc takes unit u, location loc returns nothing
    call SetUnitPositionLoc( u,loc )
    call RemoveLocation(loc)
endfunction
//平移镜头
function GS_PanCameraToTimedLocForPlayer takes player p, location loc ,real r returns nothing
    call PanCameraToTimedLocForPlayer(p, loc, r)
    call RemoveLocation(loc)
endfunction
//条件合集
function GS_IsUnitAliveBJ takes unit whichUnit,unit whichUnittow returns boolean
    return ((IsUnitAlly(whichUnit,GetOwningPlayer(whichUnittow)) == false) and (IsUnitDeadBJ(whichUnit) == false) and (IsUnitType(whichUnit, UNIT_TYPE_STRUCTURE) == false) and (IsUnitType(whichUnit, UNIT_TYPE_ANCIENT) == false))
endfunction
//移动闪电链
function GS_MoveLightningEx takes lightning whichBolt,boolean B,location l1,real R1,location l2,real R2 returns nothing
    call MoveLightningEx(whichBolt, B, GetLocationX(l1), GetLocationY(l1), R1, GetLocationX(l2), GetLocationY(l2), R2 )
    call RemoveLocation(l1)
    call RemoveLocation(l2)
endfunction
//屏幕震动
function handySD__GS_VibrationB takes nothing returns nothing
    local timer T = GetExpiredTimer()
    local player P = LoadPlayerHandle(handySD__HS_H,GetHandleId(T),1)
    call CameraClearNoiseForPlayer(P)
    call SaveReal(handySD__HS_H,GetHandleId(P),1,0)
    call DestroyTimer(T)
    set T = null
endfunction
function GS_VibrationA takes player ply,real R,real time returns nothing
    local timer T
    if ( LoadReal(handySD__HS_H,GetHandleId(ply),1) == 0.00) then
        set T = CreateTimer()
        call SaveTimerHandle(handySD__HS_H,GetHandleId(ply),1,T)
        call SavePlayerHandle(handySD__HS_H,GetHandleId(T),1,ply)
    else
        set T = LoadTimerHandle(handySD__HS_H,GetHandleId(ply),1)
    endif
    call SaveReal(handySD__HS_H,GetHandleId(ply),1,time)
    call CameraSetEQNoiseForPlayer(ply,R)
    call TimerStart(T,time,false,function handySD__GS_VibrationB)
    set T = null
endfunction
//发送消息
function GS_news takes player P, string S returns nothing
    local force F = CreateForce()
    call ForceAddPlayer(F,P)
    call QuestMessageBJ(F, bj_QUESTMESSAGE_UPDATED, S)
    call DestroyForce(F)
    set F = null
endfunction
function GS_DisplayTimedTextToForcetakes takes player ply,real r,string str returns nothing
    local force fre = CreateForce()
    call ForceAddPlayer( fre, ply )
    call DisplayTimedTextToForce( fre, r, str)
    call DestroyForce(fre)
    set fre = null
endfunction
function GS_UnitSector takes unit u1, unit u2 , real r returns boolean
    local real angle1 = GetUnitFacing(u1)
    local real angle2 = bj_RADTODEG * Atan2(GetUnitY(u1) - GetUnitY(u2), GetUnitX(u1) - GetUnitX(u2))
    return (RAbsBJ(RAbsBJ((angle1-angle2)-180)-180) > r)
endfunction
function GS_Sector takes real angle1, real angle2 returns real
    return RAbsBJ(RAbsBJ((angle1-angle2)-180)-180)
endfunction
//传送单位
function GS_Delivery takes unit u, location loc returns nothing
    call DestroyEffect(AddSpecialEffectLoc("Abilities\\Spells\\Human\\MassTeleport\\MassTeleportCaster.mdl", loc))
    call SetUnitPositionLoc( u,loc )
    call DestroyEffect(AddSpecialEffectLoc("Abilities\\Spells\\Human\\MassTeleport\\MassTeleportCaster.mdl", loc))
    call PanCameraToTimedLocForPlayer(GetOwningPlayer(u),loc, 0.00 )
    call RemoveLocation(loc)
endfunction
//简易伤害
function GS_DataHurt takes real co ,integer pty,integer lv ,real r returns real
    return co + I2R(pty) * I2R(lv) * r
endfunction
function GS_UnitRangeHurt takes unit u1, location loc, real range, real hurt returns nothing
    local unit u2
    local group g = CreateGroup()
    call GroupEnumUnitsInRange(g,GetLocationX(loc),GetLocationY(loc),range,null) 
    loop 
        exitwhen CountUnitsInGroup(g) == 0
        set u2 = FirstOfGroup(g)
        if (GS_IsUnitAliveBJ(u2, u1) == true) then
            call UnitDamageTarget( u1,u2,hurt, false, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, WEAPON_TYPE_WHOKNOWS )
        endif
        call GroupRemoveUnit(g,u2)
    endloop
    call RemoveLocation(loc)
    call DestroyGroup(g)
    set u2 = null
    set g = null
endfunction
//在线玩家
function GS_PlayerNum takes nothing returns integer
    local integer a = 1
    local integer b = 7
    local integer c = 0
    loop 
        exitwhen a > b
        if ((GetPlayerController(ConvertedPlayer(a)) == MAP_CONTROL_USER) and (GetPlayerSlotState(ConvertedPlayer(a)) == PLAYER_SLOT_STATE_PLAYING)) then
            set c = c + 1
        endif
        set a = a + 1
    endloop
    return c
endfunction
//位数转换
function GS_N2S takes real i returns string
    local integer strnum = StringLength(R2S(i))
    if strnum <= 8 then
        return R2SW(i,1,1)
    elseif strnum <= 12 then
        return R2SW(i/10000,1,1) + "万"
    else
        return R2SW(i/100000000,1,1) + "亿"
    endif
endfunction
//获取地址
function GS_GetPlayerID takes player ply returns string
    return I2S(YDWEH2I(ply))
endfunction
function GS_GetUnitID takes unit u returns string
    return I2S(YDWEH2I(u))
endfunction
function GS_Str2Abil takes string str returns integer
    return YDWES2Id(str)
endfunction
function GS_addZero takes integer num, integer i returns string
    local string str = I2S(num)
    local integer n = StringLength(str)
        loop 
            exitwhen n >= i 
            set str = "0" + str
            set n = n + 1
        endloop
    return str
endfunction

//library handySD ends
//library SUTriggerList:

    function SUTL_GetHashCode takes string name returns integer  //@u  绑定的目标对�? //@c  事件的整数ID //@t  响应事件的触发器
        return StringHash(name)
    endfunction
    function SUTL_UnitAddEventCallBack takes integer abc,handle u,integer c,trigger t returns nothing  //单位句柄
        local integer uhd=GetHandleId(u)  //触发器句�?
        local integer thd=GetHandleId(t)  //单位的事件索�?单位句柄+事件ID)
        local integer uCode=uhd+c  //读取绑定在该事件下的触发器数�?
        local integer index=LoadInteger(SUTriggerList___ht,uCode,skey_index)  //绑定在单位上的该触发器数�?+ 1
        call SaveInteger(SUTriggerList___ht,uhd,thd+SUTriggerList___key_Count,LoadInteger(SUTriggerList___ht,uhd,thd+SUTriggerList___key_Count)+1)  //如果没有注册
        if (not (HaveSavedInteger(SUTriggerList___ht,GetHandleId(t),uCode)))then
            call SaveTriggerHandle(SUTriggerList___ht,uCode,index,t)  //绑定触发器到单位事件队列�? //记录索引在触发器t的uCode�?
            call SaveInteger(SUTriggerList___ht,GetHandleId(t),uCode,index)  //绑定在该事件下的触发器数�?+ 1
            call SaveInteger(SUTriggerList___ht,uCode,skey_index,index+1)
        endif
    endfunction
    function SUTL_GetUnitEventCount takes unit u,integer c returns integer
        return LoadInteger(SUTriggerList___ht,GetHandleId(u),c+SUTriggerList___key_Count)
    endfunction
    function SUTL_GetObjectEventCount takes integer abc,handle u,trigger t returns integer
        local integer thd=GetHandleId(t)  // Print(I2S(thd)+"||"+I2S(LoadInteger(ht,GetHandleId(u),thd+key_Count)));
        return LoadInteger(SUTriggerList___ht,GetHandleId(u),thd+SUTriggerList___key_Count)
    endfunction
    function SUTL_ClearObejctAllEvent takes integer abc,handle u returns nothing
        local integer uhd=GetHandleId(u)  //怎么写呢 怎么写呢 怎么写呢
    endfunction  //StarExecuteUnitEvent
    function SUTL_UnitRemoveEventCallBack takes integer abc,handle u,integer c,trigger t returns nothing  //如何获取这些触发�? //循环 i < (GetHandleId(0)+StringHash(1) 为索�?0xA707D18B 为子�? do  //运行触发�?
        local integer uhd=GetHandleId(u)
        local integer thd=GetHandleId(t)
        local integer uCode=uhd+c  //读取index
        local integer index=LoadInteger(SUTriggerList___ht,uCode,skey_index)-1
        local integer i=0
        local trigger trig
        call SaveInteger(SUTriggerList___ht,uhd,thd+SUTriggerList___key_Count,LoadInteger(SUTriggerList___ht,uhd,thd+SUTriggerList___key_Count)-1)  //Print(I2S(thd)+"的计�?>"+I2S(LoadInteger(ht,GetHandleId(u),thd+key_Count)));
        if (LoadInteger(SUTriggerList___ht,uhd,thd+SUTriggerList___key_Count)>0)then
            return
        endif  //Print("卸载");
        set i=LoadInteger(SUTriggerList___ht,GetHandleId(t),uCode)  //printsi("index =",index); //读取索引//索引�? 得到真实数组顶部 //printsi("index =",LoadInteger(ht, uCode,skey_index));
        call RemoveSavedInteger(SUTriggerList___ht,GetHandleId(t),uCode)  //删除索引从t的uCode�?
        if (i!=index)then  //printsi(" in index =",LoadInteger(ht, uCode,skey_index));
            set trig=LoadTriggerHandle(SUTriggerList___ht,uCode,index)  //读取顶部触发�? //用顶部覆盖当前位�?
            call SaveTriggerHandle(SUTriggerList___ht,uCode,i,trig)  //更新索引
            call SaveInteger(SUTriggerList___ht,GetHandleId(trig),uCode,index)
        endif  //printsi("index =",LoadInteger(ht, uCode,skey_index));
        call SaveInteger(SUTriggerList___ht,uCode,skey_index,index)  //更新�?
        set trig=null  //printsi("index =",LoadInteger(ht, uCode,skey_index));
    endfunction  // while(i<index){ //     trig = LoadTrigger(ht, uCode,i); //     if(trig == t){ //         //doEvent //     } //     i+=1; // }
    function SUTL_UnitAddEventCallBackEx takes handle a,integer b,trigger c,boolean d returns nothing
        if (d)then
            call SUTL_UnitAddEventCallBack(0,a,b,c)
        else
            call SUTL_UnitRemoveEventCallBack(0,a,b,c)
        endif
    endfunction
    function SUTriggerList___onInit takes nothing returns nothing
        set SUTL_HT=SUTriggerList___ht
    endfunction  //

//library SUTriggerList ends
//library StarES:

    struct Soul 
    //! pragma implicitthis
        static integer count=0
        real x0
        real y0
        real x1
        real y1
        real angle
        real speed
        real upspeed
        effect efc
        unit u
        unit target
        real x2
        real y2
        real timed
        real height
        real baseh
        trigger callback
        real maxtime
        real targethieght
        boolean UsedZ
        method GetZ takes real steeps,real t,real heightMax,real fly returns real
            return (-(2*(steeps)*t-1)*(2*(steeps)-1)*t+1)*heightMax+fly
        endmethod
        method GetZ3 takes real steeps,real Max,real base returns real
            return (-(2*(steeps)-1)*(2*(steeps)-1)+1)*Max+base
        endmethod
        static method GetZ2 takes real steeps,real t,real heightMax,real fly returns real
            return (-(2*(steeps)*t-1)*(2*(steeps)-1)*t+1)*heightMax+fly
        endmethod  //获取顶部计数
        static method GetIndex takes nothing returns integer
            return Soul.count-1
        endmethod  //贝塞尔 二阶 通用 t ,中点 起点 终点
        method Bessel takes real t,real mid,real st,real tt returns real
            return (t*t*tt+2*t*(1-t)*mid+(1-t)*(1-t)*st)
        endmethod  //移动
        method Move takes real StarES__dealtatime returns nothing
            local real fac
            local real x5
            local real y5
            local real ry
            local real time
            local real z
            local real r
            local real x6
            local real y6
            local real z6
            if (this.target!=null)then  //速度
                set this.x1=GetUnitX(this.target)
                set this.y1=GetUnitY(this.target)
            endif
            set this.speed=this.speed+this.upspeed*StarES__dealtatime  //时间
            set time=Math.GDBC(this.x1,this.y1,this.x2,this.y2)/this.speed  //t = s / v
            set r=Math.Min(this.timed+(StarES__dealtatime*(1/time)),this.maxtime)
            set this.timed=r  //当前帧的X.Y
            set time=r+0.01
            set x5=Bessel(r,x2,x0,x1)  //下一帧的X.Y
            set y5=Bessel(r,y2,y0,y1)
            set x6=Bessel(time,x2,x0,x1)  //计算Z轴
            set y6=Bessel(time,y2,y0,y1)
            set z6=Star_GetLocZ(x6,y6)+Math.Parabola(time,this.height,this.baseh)+(time)*(GetUnitFlyHeight(this.target)+this.targethieght)  //计算偏航轴
            set fac=Math.GAFC(x5,y5,x6,y6)  //计算Z轴
            set z=Star_GetLocZ(x5,y5)+Math.Parabola(r,this.height,this.baseh)+r*(GetUnitFlyHeight(this.target)+this.targethieght)  //计算俯仰轴
            set ry=Atan2BJ(z6-z,Math.GDBC(x5,y5,x6,y6))
            if ((fac<0 and fac>=-90) or (fac>0) and (fac<=90))then  //设置xyz
                set ry=ry*-1
            endif
            call EXSetEffectXY(this.efc,x5,y5)  //设置xyz
            call EXSetEffectZ(this.efc,z)  //归零姿态角
            call EXEffectMatReset(this.efc)  //设置姿态角
            call EXEffectMatRotateZ(this.efc,fac)  //设置姿态角
            call EXEffectMatRotateY(this.efc,ry)
        endmethod
        static method create takes real x,real y,real a,real dis,real h,unit u,unit tu,effect e,real x6,real y6 returns Soul
            local Soul this=Soul.allocate()
            set this.x0=x
            set this.y0=y
            set this.speed=300
            set this.upspeed=1200
            set this.timed=0
            set this.u=u
            set this.target=tu
            set this.efc=e  //初始化偏移点(二阶中点)
            set this.x2=this.x0+CosBJ(a)*dis
            set this.y2=this.y0+SinBJ(a)*dis  //Math.GAFC(x,y,this.x2,this.y2);    
            set this.angle=a
            set this.height=h
            set this.baseh=EXGetEffectZ(e)
            set this.maxtime=1
            set this.x1=x6
            set this.y1=y6
            set this.targethieght=0
            set this.UsedZ=false
            set Soul.count=Soul.count+1
            return this
        endmethod  //重新设置速度/加速度
        method ResetSpeed takes real a,real b returns nothing
            set this.speed=a
            set this.upspeed=b
        endmethod  //Debug function
        static method DisplayCount takes nothing returns nothing
            call Print(I2S(Soul.count))
        endmethod  //
        method onDestroy takes nothing returns nothing
            set this.callback=null
            set Soul.count=Soul.count-1
            call DestroyEffect(this.efc)
        endmethod
    endstruct
    //private:
    function StarES__TimerEvent takes nothing returns nothing
        local integer i=0
        local Soul soul
        loop
        exitwhen (i>=Soul.count)
            set soul=StarES__table[i]
            if (soul.timed<1)then
                call soul.Move(StarES__dealtatime)
            else
                set Star_TriggerUnit=soul.target  //触发单位 = 弹幕目标单位; //目标单位 = 弹幕起始单位;
                set Star_TargetUnit=soul.u  //触发的特效
                set Star_TriggerEffect=soul.efc  //printi(GetHandleId(Star_TriggerEffect));
                if (soul.callback!=null)then  //触发回调
                    if (TriggerEvaluate(soul.callback))then
                        call TriggerExecute(soul.callback)
                    endif
                endif  //printi(GetHandleId(Star_TriggerEffect));
                set StarES__table[i]=StarES__table[Soul.GetIndex()]
                call soul.destroy()
                set i=i-1
            endif
            set i=i+1
        endloop
    endfunction  //创建一个弹幕在x,y,中点->(从x,y开始,偏移角度为a,距离为dis),最大高度h,到达时间,速度,加速度,来源单位 目标单位 弹幕特效 回调触发器
    function StarES_Add takes real x,real y,real a,real dis,real h,real time,real spd,real upspd,unit u,unit tu,effect e,trigger t returns nothing
        local Soul soul=Soul.create(x,y,a,dis,h,u,tu,e,0,0)
        set soul.maxtime=time
        call soul.ResetSpeed(spd,upspd)
        set StarES__table[Soul.GetIndex()]=soul
        set soul.callback=t
    endfunction  //创建一个弹幕在x,y,中点->(从x,y开始,偏移角度为a,距离为dis),最大高度h,到达时间,速度,加速度,来源单位 目标单位 弹幕特效 回调触发器
    function StarES_AddZ takes real x,real y,real a,real dis,real h,real time,real spd,real upspd,real hm,unit u,unit tu,effect e,trigger t returns nothing
        local Soul soul=Soul.create(x,y,a,dis,h,u,tu,e,0,0)
        set soul.maxtime=time
        set soul.UsedZ=true
        set soul.targethieght=hm
        call soul.ResetSpeed(spd,upspd)
        set StarES__table[Soul.GetIndex()]=soul
        set soul.callback=t
    endfunction  //创建一个弹幕在x,y,终点{x2,y2} 中点->(从x,y开始,偏移角度为a,距离为dis),最大高度h,到达时间,速度,加速度,来源单位 弹幕特效 回调触发器
    function StarES_AddForLoc takes real x,real y,real x2,real y2,real a,real dis,real h,real time,real spd,real upspd,unit u,unit tu,effect e,trigger t returns nothing
        local Soul soul=Soul.create(x,y,a,dis,h,u,null,e,x2,y2)
        set soul.maxtime=time
        call soul.ResetSpeed(spd,upspd)
        set StarES__table[Soul.GetIndex()]=soul
        set soul.callback=t
    endfunction  //带高度
    function StarES_AddForLocZ takes real x,real y,real x2,real y2,real a,real dis,real h,real time,real spd,real upspd,real hm,unit u,unit tu,effect e,trigger t returns nothing  //创建一个弹幕在x,y,终点{x2,y2} 中点->(从x,y开始,偏移角度为a,距离为dis),最大高度h,到达时间,速度,加速度,来源单位 弹幕特效 回调触发器
        local Soul soul=Soul.create(x,y,a,dis,h,u,null,e,x2,y2)
        set soul.maxtime=time
        call soul.ResetSpeed(spd,upspd)
        set soul.UsedZ=true
        set soul.targethieght=hm
        set StarES__table[Soul.GetIndex()]=soul
        set soul.callback=t
    endfunction  //自适应
    function StarES_EX takes real x,real y,real x2,real y2,real a,real dis,real h,real time,real spd,real upspd,real hm,unit u,unit tu,effect e,trigger t returns nothing
        local Soul soul=Soul.create(x,y,a,dis,h,u,tu,e,x2,y2)
        set soul.maxtime=time
        call soul.ResetSpeed(spd,upspd)
        set soul.UsedZ=true
        set soul.targethieght=hm
        set StarES__table[Soul.GetIndex()]=soul
        set soul.callback=t
    endfunction  //Init
    function StarES__onInit takes nothing returns nothing
        call TimerStart(SES_TIMER,StarES__dealtatime,true,function StarES__TimerEvent)
    endfunction

//library StarES ends
