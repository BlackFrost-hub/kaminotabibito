        call EC_CreateEffect( "Abilities\\Spells\\Human\\Resurrect\\ResurrectTarget.mdl", GetUnitX(GetTriggerUnit()), GetUnitY(GetTriggerUnit()), 25.00, 270.0, 1.0, 1.0, 1.00 )
