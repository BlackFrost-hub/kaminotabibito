    endfunction  //让玩家[i]显示吟唱条并开始读条 会打断
    function SUI2_SetTime takes integer id,real t,string text,trigger callback returns nothing
        if (StarUI2__timemax[id]!=0)then
            call SUI2_Stop(id)
        endif
        if (t>0)then
            set StarUI2__time[id]=0
            set StarUI2__timemax[id]=t
            set StarUI2__cbtrig[id]=callback
            call SUI2_HideUI(id,false)
            if (not StarUI2__TimerIsRun)then
                set StarUI2__TimerIsRun=true
                call TimerStart(StarUI2__maintimer,StarUI2__dealtTime,true,function StarUI2__te)
            endif
            if (GetLocalPlayer()==Player(id))then
                call DzFrameSetText(StarUI2__frames[3],text)
            endif
        else
            call SUI2_Stop(id)
        endif
    endfunction  //使玩家显示读条
    function SUI2_ShowHpbar takes integer id,unit u returns nothing
        set StarUI2__targetunit[id]=u
        if (StarUI2__targetunit[id]!=null)then
            call SUI2_HideHpbar(id,false)
            call DzFrameSetText(StarUI2__frames[7],GetUnitName(u))
        else
            call SUI2_HideHpbar(id,true)
        endif
        if (StarUI2__TimerIsRun!=true)then
            set StarUI2__TimerIsRun=true  //BJDebugMsg("rund");
            call TimerStart(StarUI2__maintimer,StarUI2__dealtTime,true,function StarUI2__te)
        endif
    endfunction  //设置相对于顶部的位置
    function SUI2_SetLoc takes real x,real y returns nothing
        call DzFrameSetPoint(StarUI2__frames[0],1,StarUI2__frames[4],7,x,y*-1)  //DzFrameSetPoint( frames[0], 1, DzFrameGetTopMessage(), 7, x, y*-1 );
        call DzFrameSetSize(StarUI2__frames[1],0.01,0.01)
        call DzFrameSetPoint(StarUI2__frames[2],4,StarUI2__frames[0],4,0,0.015)
        call DzFrameSetPoint(StarUI2__frames[3],4,StarUI2__frames[0],4,0,0.03)
        set StarUI2__uix=x
        set StarUI2__uiy=y
    endfunction  //设置血条的相对位置
    function SUI2_SetHpbarLoc takes real x,real y returns nothing
        call DzFrameSetAbsolutePoint(StarUI2__frames[4],7,0.4-x,0.525+y*-1)  //DzFrameSetPoint( frames[3], 1, DzFrameGetTopMessage(), 7, , y*-1 );
        call DzFrameSetSize(StarUI2__frames[4],0.01,0.01)  // if(false)
        set StarUI2__hpbarx=x  // { //     DzFrameSetPoint( frames[5], 4, frames[0], 4, 0, 0.015 ); //     DzFrameSetPoint( frames[6], 4, frames[0], 4, 0, 0.03 ); // }
        set StarUI2__hpbary=y
    endfunction
    function SUI2_E2I takes integer i returns integer
        return i
    endfunction  //系统初始化
    function StarUI2__onInit takes nothing returns nothing
        call DzLoadToc("Starcustom.toc")  //加载文件列表 //初始化UI栏  - 血条
        set StarUI2__frames[4]=DzCreateFrameByTagName("SPRITE","name",DzGetGameUI(),"template",0)  //血条遮罩 // DzFrameSetModel( frames[4], "UI_shengmingzhi_r2.mdl", 0, 0 );
        call DzFrameSetModel(StarUI2__frames[4],"UI_HpBar_new.mdx",0,0)  //DzFrameSetPoint( frames[4], 1, DzFrameGetTopMessage(), 7, 0, -0.0 );
        call DzFrameSetAbsolutePoint(StarUI2__frames[4],7,0.4,0.525)
        call DzFrameSetSize(StarUI2__frames[4],0.01,0.01)
        call DzFrameSetAnimate(StarUI2__frames[4],0,false)
        call DzFrameSetAnimateOffset(StarUI2__frames[4],0.90)
        call DzFrameShow(StarUI2__frames[4],false)  //血条底框
        set StarUI2__frames[5]=DzCreateFrameByTagName("SPRITE","name",DzGetGameUI(),"template",0)  // DzFrameSetModel( frames[5], "UI_shengmingzhi-beijing_r2.mdl", 0, 0 );
        call DzFrameSetModel(StarUI2__frames[5],"UI_HpBar_BG_new.mdx",0,0)
        call DzFrameSetPoint(StarUI2__frames[5],4,StarUI2__frames[4],4,0,0)
        call DzFrameSetSize(StarUI2__frames[5],0.01,0.01)
        call DzFrameShow(StarUI2__frames[5],false)  //生命值
        set StarUI2__frames[6]=DzCreateFrame("GameTextBG",DzGetGameUI(),12347)  //frames[2] = DzCreateFrameByTagName("GameTextBGs", "name", DzGetGameUI(), "template", 0);
        call DzFrameSetPoint(StarUI2__frames[6],4,StarUI2__frames[4],4,0.0,0.015)
        call DzFrameShow(StarUI2__frames[6],false)  //DzFrameSetFont(frames[2],"宋体",0.08,0);
        set StarUI2__frames[7]=DzCreateFrameByTagName("TEXT","name",DzGetGameUI(),"template",0)  //单位名字 //frames[3] = DzCreateFrame("GameText", DzGetGameUI(), 12348);
        call DzFrameSetPoint(StarUI2__frames[7],3,StarUI2__frames[4],4,-0.13,0.015)  //DzFrameSetFont(frames[3],"宋体",0.04,0);
        call DzFrameShow(StarUI2__frames[7],false)
        set StarUI2__frames[8]=DzCreateFrame("GameUI",DzGetGameUI(),12349)  //血条左框
        call DzFrameSetPoint(StarUI2__frames[8],5,StarUI2__frames[4],3,-0.117,0.0056)
        call DzFrameSetTexture(StarUI2__frames[8],"boss_logo.blp",0)
        call DzFrameSetSize(StarUI2__frames[8],0.07,0.07)
