function Trig_worldmapbuttonActions takes nothing returns nothing
    local integer ydul_A
    local group ydl_group
    local unit ydl_unit
    local timer ydl_timer
    local integer ydl_localvar_step = LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xCFDE6C76) 
 set ydl_localvar_step = ydl_localvar_step + 3 
 call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xCFDE6C76, ydl_localvar_step) 
 call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7, ydl_localvar_step)
    call SavePlayerHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x48E3E75F, DzGetTriggerKeyPlayer())
    if (((LoadPlayerHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x48E3E75F) == GetLocalPlayer()))) then
        set ydul_A = 1
        loop
            exitwhen ydul_A > 28
            call DzFrameShow( LoadInteger(YDHT, StringHash( ( "map" + I2S(ydul_A) )), 0xD76E1C1B), false )
            set ydul_A = ydul_A + 1
        endloop
    else
    endif
    call ForGroupBJ( LoadGroupHandle(YDHT, StringHash( "玩家英雄"), 0x0A4A1F64), function Trig_worldmapbuttonFunc003A )
    set ydl_timer = CreateTimer()
    call SaveUnitHandle(YDLOC, GetHandleId(ydl_timer), 0xB06AB615, LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xB06AB615))
    call TimerStart(ydl_timer, 0.00, false, function Trig_worldmapbuttonFunc004T)
    call Sound3DII_Mp3Play( "XT\\YX-FY.mp3", LoadPlayerHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x48E3E75F) )
    if ((LoadBoolean(YDHT, GetHandleId( LoadPlayerHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x48E3E75F)), 0x2DCB9348) == false)) then
        call SaveBoolean(YDHT, GetHandleId( LoadPlayerHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x48E3E75F)), 0x2DCB9348, true)
        if ((LoadPlayerHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x48E3E75F) == GetLocalPlayer())) then
            call DzFrameShow( LoadInteger(YDHT, StringHash( "worldmap"), 0x2186940F), true )
        else
        endif
        set ydl_timer = CreateTimer()
        call SavePlayerHandle(YDLOC, GetHandleId(ydl_timer), 0x48E3E75F, LoadPlayerHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x48E3E75F))
        call TimerStart(ydl_timer, 0.30, false, function Trig_worldmapbuttonFunc005Func002Func006T)
    else
        call SaveBoolean(YDHT, GetHandleId( LoadPlayerHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x48E3E75F)), 0x2DCB9348, false)
        if ((LoadPlayerHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x48E3E75F) == GetLocalPlayer())) then
            call DzFrameShow( LoadInteger(YDHT, StringHash( "worldmap"), 0x7D515EF5), false )
        else
        endif
    endif
    call FlushChildHashtable(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step)
    set ydl_group = null
    set ydl_unit = null
    set ydl_timer = null
endfunction
