        call SaveReal(YDHT, GetHandleId( LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x944CCEB0)), 0xF1003A49, 0.10)
        call SetUnitOwner( LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x944CCEB0), Player(PLAYER_NEUTRAL_AGGRESSIVE), true )
        call SetUnitInvulnerable( LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x944CCEB0), true )
        call PauseUnit( LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x944CCEB0), true )
        call SaveUnitHandle(YDHT, StringHash( "Boss战"), 0x4F42CF89, LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x944CCEB0))
        call SaveUnitHandle(YDHT, StringHash( "Boss战"), 0x5A47F98D, GetTriggerUnit())
