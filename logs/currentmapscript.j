function Trig_________________________SWCFActions takes nothing returns nothing
    local timer ydl_timer
    local group ydl_group
    local unit ydl_unit
    local integer ydl_localvar_step = LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xCFDE6C76) 
 set ydl_localvar_step = ydl_localvar_step + 3 
 call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xCFDE6C76, ydl_localvar_step) 
 call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7, ydl_localvar_step)
    // 玩家单位死亡时
    if ((GetUnitTypeId(GetTriggerUnit()) == 'N05N') and (IsUnitIllusionBJ(GetTriggerUnit()) == true)) then
        call PlaySoundOnUnitBJ( gg_snd_MirrorImageDeath, 100, GetTriggerUnit() )
        call SaveUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x76ABBC1D, LoadUnitHandle(YDHT, StringHash( "Boss"), 0xC5B1FC95))
        call SaveUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x7D47750E, GetTriggerUnit())
        call SaveReal(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xA99320FA, GetUnitX(GetDyingUnit()))
        call SaveUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x48E3E75F, GetKillingUnit())
        call SaveReal(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xFDF65382, GetUnitY(GetDyingUnit()))
        call EC_CreateEffect( "war3mapImported\\ShadesSouMissile.mdl", GetUnitX(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x7D47750E)), GetUnitY(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x7D47750E)), 0.0, 270.0, 2.00, 1.00, 0.00 )
        // 玩家击杀则不造成伤害
        if ((IsPlayerInForce(GetOwningPlayer(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x48E3E75F)), LoadForceHandle(YDHT, StringHash( "玩家"), 0x7C23C9D2)) == true)) then
            call GroupRemoveUnit( LoadGroupHandle(YDHT, GetHandleId( LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x76ABBC1D)), 0xBF671381), GetTriggerUnit() )
            if ((IsUnitGroupDeadBJ(LoadGroupHandle(YDHT, GetHandleId( LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x76ABBC1D)), 0xBF671381)) == true)) then
                call SetUnitTimeScale( LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x76ABBC1D), 0.00 )
                call GS_Suspend( LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x76ABBC1D), 2.50 )
                set ydl_timer = CreateTimer()
                call SaveUnitHandle(YDLOC, GetHandleId(ydl_timer), 0x76ABBC1D, LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x76ABBC1D))
                call TimerStart(ydl_timer, 0.10, true, function Trig_________________________SWCFFunc002Func009Func004Func003T)
                call QuestMessageBJ( GetPlayersAll(), bj_QUESTMESSAGE_ITEMACQUIRED, (("|cffff0000")+( GetUnitName(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x48E3E75F)))+( "|r成功|cffff0000提前击杀所有分身|r！（Boss会进入短暂硬直）")) )
            else
            endif
        else
            call EC_CreateEffect( "war3mapImported\\mr.war3_ring.mdl", LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xA99320FA), LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xFDF65382), 0.0, 270.0, 1.25, 2.00, 0.10 )
            set ydl_timer = CreateTimer()
            call SaveUnitHandle(YDLOC, GetHandleId(ydl_timer), 0x76ABBC1D, LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x76ABBC1D))
            call SaveUnitHandle(YDLOC, GetHandleId(ydl_timer), 0xF047C7C9, GetEventDamageSource())
            call SaveReal(YDLOC, GetHandleId(ydl_timer), 0xA99320FA, LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xA99320FA))
            call SaveReal(YDLOC, GetHandleId(ydl_timer), 0xFDF65382, LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0xFDF65382))
            call TimerStart(ydl_timer, 0.70, false, function Trig_________________________SWCFFunc002Func009Func002T)
        endif
        if (((IsUnitGroupDeadBJ(LoadGroupHandle(YDHT, GetHandleId( LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x76ABBC1D)), 0xBF671381)) == true) or (IsUnitGroupEmptyBJ(LoadGroupHandle(YDHT, GetHandleId( LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger())*ydl_localvar_step, 0x76ABBC1D)), 0xBF671381)) == true))) then
