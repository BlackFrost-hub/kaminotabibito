function YDWEGetForceOfPlayerNull takes player whichPlayer returns force
    local force f = CreateForce()
    call ForceAddPlayer(f, whichPlayer)
    set yd_NullTempForce = f
    set f = null
    return yd_NullTempForce
endfunction

