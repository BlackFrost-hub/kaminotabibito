{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "strict": true,
    "rootDir": "TS",
    "outDir": "src",
    "skipLibCheck": true
  },
  "include": ["TS/**/*.ts", "TS/**/*.d.ts"],
  "exclude": ["TS/**/99．迁移资料/**/*.ts"],
  "tstl": {
    "luaTarget": "5.4",
    "noResolvePaths": [
      "jass.*",
      "lib.*",
      "系统.*",
      "平台扩展API",
      "平台扩展API动作",
      "平台扩展API取值",
      "平台扩展API条件",
      "平台扩展API事件",
      "平台扩展API条件桥接"
    ]
  }
}
