{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "strict": true,
    "rootDir": "TS",
    "outDir": "src",
    "skipLibCheck": true
  },
  "include": ["TS/**/*.ts", "TS/**/*.d.ts"],
  "tstl": {
    "luaTarget": "5.4",
    "noResolvePaths": ["jass.*", "lib.*", "系统.*", "平台扩展API.*"]
  }
}



